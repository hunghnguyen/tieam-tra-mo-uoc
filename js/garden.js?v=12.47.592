  function addHarvestStock(k, q) {
    if (!window.S) return;
    if (!S.stock) S.stock = {};
    if (!Array.isArray(S.stock[k])) S.stock[k] = [];
    S.stock[k] = S.stock[k].filter(item => item && typeof item === 'object' && typeof item.q === 'number');
    if (typeof window.addStock === 'function') {
      window.addStock(k, q, S, true);
    } else {
      const l = typeof window.getIngLife === 'function' ? window.getIngLife(k) : ((window.ITEMS && window.ITEMS[k] && window.ITEMS[k].life) || 3);
      const exp = l ? (S.day || 1) + l - 1 : 99999;
      const b = S.stock[k].find(x => x.exp === exp);
      if (b) b.q += q;
      else S.stock[k].push({ q, exp });
    }
    if (window.ITEMS && window.ITEMS[k] && window.ITEMS[k].type === 'flav') {
      if (typeof window.syncFlav === 'function') window.syncFlav();
      else if (S.unlocked) S.unlocked[k] = true;
    }
  }

  const SPROUT_IMG = 'farm/mầm cây.png?v=12.47.302';
  const YOUNG_IMG = 'farm/cây non.png?v=12.47.302';

  // Biến trạng thái thú cưng đi dạo trong vườn cây
  let gardenPetTimer = null;
  let gardenPetBubbleTimer = null;
