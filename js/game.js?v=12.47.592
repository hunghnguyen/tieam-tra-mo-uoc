  // Mốc 22:00: nếu có nhân viên SV cuối tháng thì chuyển sang ca đêm bán đến sáng, ngược lại đóng cửa
  if(!R.isNightShift && R.t<=0 && !R.closing){
    if(isStaffActive('staffSv')){
      R.isNightShift = true;
      R.nightTot = Math.max(80, Math.round(dayLen() * 60 * (8 / 11)));
      R.nightT = R.nightTot;
      R.spawnT = 0.5;
      R.nightRushTriggered = false;
      // Gen Z hết ca đi về, nhường chỗ cho SV ca đêm
      R.gzWork = null;
      R.gzSulking = false;
      renderGzWidget();
      renderSvWidget();
      const pName = (S.staffNames && S.staffNames.staffSv) || 'Sinh viên cuối tháng';
      const s2Count = (typeof getStaff2Count === 'function') ? getStaff2Count() : 0;
      const s2OtMsg = (isStaffActive('staff2') && s2Count > 0) ? ` cùng ${s2Count} thợ pha chế tăng ca đêm (+40k/h)` : '';
      const dayStaffName = (isStaffActive('staffGz') && isStaffActive('staff3')) ? 'Gen Z & Quản lý tập sự' : (isStaffActive('staffGz') ? 'Gen Z' : (isStaffActive('staff3') ? 'Quản lý tập sự' : 'Ca ngày'));
      toast(`🌙 22:00: ${dayStaffName} hết ca đi về! ${pName} vào ca đêm${s2OtMsg}, quán bán xuyên đêm đến sáng! 🧑‍🎓🍹✨`, 6000, 1);
      if(isStaffActive('staffShipper') && onlineActive()){
        R.onT = 1.0;
        toast('🌙 22:00: Shipper Thần Tốc mở tuyến giao hàng online xuyên đêm 24/7! Đơn online ca đêm bắt đầu nổ! 🛵💨📱', 6000, 1);
      }

      // 🏮 Khi mở ca đêm: Cú đêm, sinh viên, người làm ca đêm xếp hàng đợi sẵn tương ứng quy mô quầy!
      const maxSlots = getMaxSlots();
      const emptySlots = R.slots ? R.slots.filter(s => !s).length : 0;
      const initialNightSpawn = maxSlots >= 10 ? rnd([4, 5, 6]) : (maxSlots >= 6 ? rnd([2, 3, 4]) : (Math.random() < 0.6 ? 1 : 2));
      const spawnTarget = Math.min(emptySlots, initialNightSpawn);
      for(let i = 0; i < spawnTarget; i++){
        spawn();
      }
    } else {
      R.closing=true;
      R.otT=0;
      R.spawnT=999999;
      toast('🌙 22:00 đóng cửa! Quán ngưng nhận khách mới, hãy hoàn thành nốt cho các khách đang chờ rồi mới kết ca nhé! 🧋✨',5000,1);
      renderLane();
    }
  }

  // Mốc 6:00 sáng ca đêm kết thúc
  if(R.isNightShift && R.nightT<=0){
    if(!R.closing){
      R.closing = true;
      R.otT = 0;
      R.spawnT = 999999;
      R.closingTimer = 0;
      toast('🌅 06:00 SÁNG RỒI! Hết ca đêm, không nhận thêm khách. Quán chuẩn bị đóng cửa tổng kết...', 4000, 1);
      renderLane();
    }
  }

  const hasWaitingCust = (R.slots && R.slots.some(Boolean)) || (R.online && R.online.length > 0);
  const isShiftTimeUp = (R.isNightShift ? R.nightT <= 0 : R.t <= 0);

  // 1. Khi quầy đã sạch bóng khách và hết giờ (hoặc đang đóng cửa): KẾT THÚC CA NGAY LẬP TỨC (không chờ 1s)
  if((R.closing || isShiftTimeUp) && !hasWaitingCust){
    R.closing = true;
    R.closingTimer = 0;
    R.gzWork = null;
    R.svWork = null;
    R.st2 = null;
    R.st2Workers = [];
    R.sto = null;
    R.stoWorkers = [];
    R.helping = false;
    R.buyerTrip = null;
    endDay();
    return;
  }

  // 2. Nếu đã đến giờ đóng cửa (22:00 hoặc 06:00 sáng) mà vẫn còn khách:
  // Cho nhân viên hoàn thành nốt các đơn khách đang chờ ở quầy và online!
  if((R.closing || isShiftTimeUp) && hasWaitingCust){
    R.closing = true;
    R.closingTimer = (R.closingTimer || 0) + dt;

    // Tự động giải phóng khách nếu quán thiếu nguyên liệu món đó sau 3s (không để khách chờ vô tận)
    if(R.slots){
      R.slots.forEach((c, idx) => {
        if(c && c.cups && c.cups.some(o => (typeof missing === 'function' ? missing(o).length > 0 : false))){
          c._missingClosingTimer = (c._missingClosingTimer || 0) + dt;
          if(c._missingClosingTimer >= 3.0){
            decline(idx);
          }
        }
      });
    }
    if(R.online){
      R.online.forEach((c, idx) => {
        if(c && c.cups && c.cups.some(o => (typeof missing === 'function' ? missing(o).length > 0 : false))){
          c._missingClosingTimer = (c._missingClosingTimer || 0) + dt;
          if(c._missingClosingTimer >= 3.0){
            declineOnline(idx);
          }
        }
      });
    }

    // Bảo vệ an toàn chống treo kết ca: Tối đa 12s lúc hết ca đêm 6:00 sáng (hoặc 30s ca ngày)
    // Tự động hoàn tất giải phóng khách tồn đọng và kết ca dứt điểm
    const maxWaitSec = (R.isNightShift || R.nightT <= 0) ? 12.0 : 30.0;
    if(R.closingTimer >= maxWaitSec){
      R.closingTimer = 0;
      R.gzWork = null;
      R.svWork = null;
      R.st2 = null;
      R.st2Workers = [];
      R.sto = null;
      R.stoWorkers = [];
      R.helping = false;
      R.buyerTrip = null;
      if(R.slots) R.slots.forEach((c, idx) => { if(c) decline(idx); });
      if(R.online) R.online.forEach((_, idx) => declineOnline(idx));
      endDay();
      return;
    }
  }
  if(R.mode==='sell'){const c=gameClock();if(_hd.clk!==c){_hd.clk=c;const el=$('hClk');if(el)el.textContent=c}}
  if(upd1s) head();
  } catch(err) {
    console.error('Error in tick():', err);
  }
}
function togglePauseGame(){
  if(!R || !R.running) return;
  if(R.paused){
    resumeGame();
  } else {
    pauseGame();
  }
}
function pauseGame(){
  if(!R || !R.running || R.paused) return;
  R.paused = true;
  clearInterval(timer);
  const left = Math.ceil(R.t), waiting = (R.slots || []).filter(Boolean).length + (R.online || []).length;
  ask(`<div class="pbig">${ico('pause')}</div><h2>Tạm dừng ca bán</h2>
    <div style="font-size:0.84rem;color:var(--soft);margin-bottom:8px;">Còn ${left}s · ${waiting} khách đang chờ</div>
    ${getVolumeControlHTML('pvol')}`,
    [
      ['▶ Chơi tiếp', resumeGame, 1],
      ['Đóng cửa hôm nay', askClose, 1]
    ]);
  bindVolumeControls('pvol');
}
function askClose(){
  const waiting = (R && R.slots ? R.slots.filter(Boolean).length : 0) + (R && R.online ? R.online.length : 0);
  ask(`<div class="pbig">${ico('moon')}</div><h2>Đóng cửa hôm nay?</h2><p>Quán nghỉ sớm và chuyển sang tổng kết ngày.${waiting ? ` ${waiting} khách đang chờ sẽ ra về.` : ''}</p>`,
    [['Quay lại', pauseAgain], ['Đóng cửa', closeEarly, 1]]);
}
function pauseAgain(){
  if(R) R.paused = false;
  pauseGame();
}
function closeEarly(){
  if(!R) return;
  try {
    R.paused = false;
    R.closing = false;
    R.t = 0;
    if(R.isNightShift) R.nightT = 0;
    if(R.today && R.slots){
      R.slots.forEach(c => { if(c && R.today) R.today.lost++; });
    }
    if(R.slots) R.slots = R.slots.map(() => null);
    R.online = [];
    R.gzWork = null;
    R.svWork = null;
    R.buyerTrip = null;
    R.st2 = null;
    R.st2Workers = [];
    R.sto = null;
    R.stoWorkers = [];
    R.helping = false;
    R.fakeCase = null; // Đảm bảo không bị chặn bởi modal công an khi đóng ca khẩn cấp
    if(typeof cup !== 'undefined' && cup && cup.staff) cup = newCup();
    clearStaffPouring();
    pourSnd(false);
    hideAllPoliceButtons();
    clearInterval(timer);
    endDay();
  } catch(err) {
    console.error('Error in closeEarly:', err);
    try {
      R.running = false;
      R.paused = false;
      finishEndDay();
    } catch(err2) {
      console.error('Fatal error in closeEarly fallback:', err2);
      if(typeof renderPrep === 'function') renderPrep();
      if($('modal')) $('modal').hidden = true;
    }
  }
}
window.forceEndDayNow = function(){
  try {
    finishEndDay._running = false;
    if(S && S._lastFinishedDay != null) delete S._lastFinishedDay;
    if(R) R._sulkingIgnored = true;
    closeEarly();
  } catch(e) {
    console.error('Error in forceEndDayNow:', e);
    try { finishEndDay(); } catch(e2){}
  }
};

// Bảo toàn 100% doanh thu & tiến trình ngày bán nếu người chơi thoát trang hoặc F5 tải lại giữa ca bán:
function handleAppUnload(){
  if(R && R.running){
    try {
      closeEarly();
    } catch(e) {
      try { finishEndDay(); } catch(e2){}
    }
  }
}
window.addEventListener('beforeunload', handleAppUnload);
window.addEventListener('pagehide', handleAppUnload);
function resumeGame(){if(!R||!R.running)return;R.paused=false;clearInterval(timer);timer=setInterval(tick,100);head();if(R.mode==='sell'){if(typeof scheduleCounterPetNextAction==='function')scheduleCounterPetNextAction();if(typeof scheduleCounterCapbiNextAction==='function')scheduleCounterCapbiNextAction();}if($('modal'))$('modal').hidden=true;}
document.addEventListener('gesturestart',e=>e.preventDefault());
document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseGame()});
const cropBg=(x,y,w,h,dw)=>{const k=dw/w;return `<div class="crop" style="width:${dw}px;height:${Math.round(h*k)}px;background:url(img/bg.jpg) ${-x*k}px ${-y*k}px/${768*k}px ${1376*k}px no-repeat"></div>`};
function lvIntro(lv){
  if(lv===2)return `<h2>Từ hôm nay: đường và đá</h2><p>Khách sẽ chọn mức đường và đá. Làm sau khi rót trà và thêm topping.</p>${cropBg(511,955,248,178,230)}
    <div class="lvs"><div><b>Nước đường</b> bấm 1 lần = 30%, 2 lần = 50%, 3 lần = 70%, 4 lần = 100%</div><div><b>Đá viên</b> xúc 1 lần = ít đá, 2 lần = đá bình thường. Không xúc = không đá</div><div><b>Lỡ bấm dư</b> chạm xô inox để đổ ly, làm lại từ đầu</div></div>`;
  return `<h2>Từ hôm nay: đơn nhiều ly, ly tới 4 topping</h2><p>Khách có thể gọi tới 4 loại topping trong một ly (chỉ 1 loại kem), chạm lần lượt từng khay khách gọi. Một khách có thể mua 2–5 ly. Bấm Ly 1, Ly 2… trên bóng thoại để xem từng ly. Pha xong ly nào thì dán nắp giao ly đó, khách chờ lâu hơn cho đơn nhiều ly. Đơn từ 3 ly thì khách khác chờ bạn làm xong mới ghé.</p>`}

/* ===== HÀM HỖ TRỢ ĐƠN TIỆC TRONG CA ===== */
function renderPartyWidget(){
  const w = $('q3partyWrap');
  if(!w) return;
  if(!R.running || !R.party || !S.partyContract || !S.partyContract.accepted){
    w.style.display = 'none';
    return;
  }
  w.style.display = 'block';
  const cur = R.party.served || 0;
  const tot = R.party.cups || 1;
  const pct = Math.min(100, Math.round((cur / tot) * 100));
  const isDone = cur >= tot;

  const fill = $('q3partyFill');
  if(fill){
    fill.style.width = pct + '%';
    if(isDone) fill.style.background = 'linear-gradient(90deg, #22c55e, #16a34a)';
    else fill.style.background = 'linear-gradient(90deg, #f97316, #eab308)';
  }
  const cnt = $('q3partyCount');
  if(cnt){
    cnt.innerHTML = isDone ? `✅ <b>${cur}/${tot} ly (Đã đủ!)</b>` : `<b>${cur}/${tot} ly</b> (${pct}%)`;
    cnt.style.color = isDone ? '#15803d' : '#92400e';
  }
  const title = $('q3partyTitle');
  if(title && S.partyContract){
    title.textContent = isDone ? `🎉 Đã đủ ${tot} ly cho ${S.partyContract.typeLabel}!` : `🎉 ${S.partyContract.title}`;
  }
}

function packCupForParty(){
  if(!R.running || !R.party || !S.partyContract) return;
  if(R.party.served >= R.party.cups){
    toast('🎉 Đơn tiệc đã đủ số lượng ly yêu cầu rồi! Rất xuất sắc!');
    return;
  }
  if(!ready()){
    toast('👉 Hãy làm một ly trà trên thớt (chọn ly, rót trà, đường đá...) rồi bấm đóng gói nhé!');
    return;
  }
  sfx('coin');
  let p = price(cup);
  const taxX2Rate = isTaxActive() ? (S.tax && S.tax.rate ? S.tax.rate * 0.20 : 0.03) : 0;
  if(taxX2Rate > 0 && Math.random() < taxX2Rate){
    p *= 2;
    toast(`🏛️ Hợp đồng tiệc nhận bảo trợ thuế: x2 tiền ly tiệc! (+${fmt(p)}) 🎉`, 3000);
  }
  recSale(cup, p);
  S.money += p;
  R.today.rev += p;
  S.totalRev += p;
  R.today.served++;
  S.served++;

  R.party.served++;
  S.partyContract.served = R.party.served;

  fl($('lane'), `📦 Đóng gói +1 ly tiệc! (+${fmt(p)})`, false);

  if(R.party.served >= R.party.cups && !R.party.done){
    R.party.done = true;
    sfx('lvup');
    toast(`🎉 CHÚC MỪNG! Đã hoàn thành đủ ${R.party.cups} ly cho hợp đồng tiệc! Kết ca sẽ nhận thưởng lớn! 🌟`, 5000, 1);
  }

  cup = newCup();
  renderCup();
  renderPartyWidget();
}

function onCupServedProgress(){
  if(S && R && R.today){
    S.bestDayServed = Math.max(S.bestDayServed || 0, R.today.served || 0);
    S.bestDayRev = Math.max(S.bestDayRev || 0, R.today.rev || 0);
  }
  if(R.party && S.partyContract && S.partyContract.accepted && R.party.served < R.party.cups){
    R.party.served++;
    S.partyContract.served = R.party.served;
    renderPartyWidget();
    if(R.party.served >= R.party.cups && !R.party.done){
      R.party.done = true;
      sfx('lvup');
      toast(`🎉 CHÚC MỪNG! Đã hoàn thành đủ ${R.party.cups} ly cho tiệc! Kết ca nhận thưởng lớn! 🌟`, 5000, 1);
    }
  }
  if(window.Collection && typeof window.Collection.checkMilestones === 'function'){
    window.Collection.checkMilestones();
  }
}

function startDay(){
  finishEndDay._running = false;
  if(S && S._lastFinishedDay != null) delete S._lastFinishedDay;
  if(S && S.cur && (S.cur.startCash == null || S.cur.startCash === 0)) S.cur.startCash = S.money;
  cup=newCup();
  const maxSlots = getMaxSlots();
  const initSlots = Array.from({ length: maxSlots }, () => null);
  Object.assign(R,{s1n:0,s1bad:(()=>{const n=rnd([0,1,2]),a=[];while(a.length<n){const x=2+Math.floor(Math.random()*15);if(!a.includes(x))a.push(x)}return a})(),dayLen:S.dayLen||CFG.dayMin,running:true,paused:false,t:(S.dayLen||CFG.dayMin)*60,spawnT:.8,onT:2,slots:initSlots,online:[],
    _finishedDay:null,_sulkingIgnored:false,st2:null,staffPouring:false,closing:false,otT:0,nightOtMin:0,otNightCloseT:0,helping:false,coachDone:false,firstDone:false,burstDone:false,vipDone:false,vipPending:false,
    combo:0,maxCombo:0,rushHourActive:false,rushHourTimer:0,rushHourTriggeredToday:false,
    isNightShift:false,nightT:0,nightTot:Math.max(80, Math.round((S.dayLen||CFG.dayMin)*60*(8/11))),nightRushTriggered:false,svWork:null,svMsg:'',svStealIntent:false,svStealTriggered:false,svStealCount:0,svStealClicksNeeded:0,svStealClicksDone:0,svStealTimer:0,
    gzSulking:false,gzCheers:0,gzCheeredToday:false,gzWork:null,gzSupervised:0,gzStolenRecent:false,gzMsg:'',gzCaughtCount:0,
    buyerTrip:null,buyerTripsToday:0,buyerQueue:[],buyerScanT:0,
    today:{used:{},rev:0,onl:0,fee:0,tips:0,cogs:0,served:0,lost:0,wrong:0,priceLost:0,stars:[],gzStolen:0,gzTipToShop:false,gzStealAttempts:0,gzStealSuccess:false,buyerStolen:0,buyerTrips:0}});
  R.sto=null; R.stoWorkers=[]; planBig();
  if(typeof mktAutoRescueAllFlops === 'function') mktAutoRescueAllFlops(true);
  R.tiktokerTodayDone = false;

  // 🎁 5★ Pet Decor Morning Treasure:
  try {
    if(S && S.decor && Object.keys(S.decor).some(k => typeof getDecorStar === 'function' && getDecorStar(k) >= 5)){
      if(Math.random() < 0.60 && !R._petDecorGiftShownToday){
        R._petDecorGiftShownToday = true;
        const giftMoney = 25000000;
        const giftStar = 15;
        S.money += giftMoney;
        const maxFeasibleStar5 = Math.min(80000, 200 + (S.day || 1) * 250);
        S.star5Count = Math.min(maxFeasibleStar5, (S.star5Count || 0) + giftStar);
        save(); head();
        setTimeout(() => {
          if(typeof toast === 'function') toast(`🎁 Bé cưng với Decor 5★ Thần Thoại đã tha về Rương May Mắn: +${fmt(giftMoney)} & +${giftStar}⭐ Tích lũy! 🐾✨`, 6000, 1);
        }, 800);
      }
    }
  } catch(e){}

  if(window.WeatherSystem && typeof window.WeatherSystem.renderSellingFx === 'function'){
    window.WeatherSystem.renderSellingFx($('view') || document.body);
  }
  if(S.partyContract && S.partyContract.day === S.day && S.partyContract.accepted){
    R.party = {
      cups: S.partyContract.cups,
      served: S.partyContract.served || 0,
      done: (S.partyContract.served || 0) >= S.partyContract.cups
    };
  } else {
    R.party = null;
  }
  {R.starAt=0;if(S.day>=3){let x=S.starSch;if(!x||S.day>x.end)x=S.starSch={end:S.day+29,day:S.day+Math.floor(Math.random()*30)};if(x.day===S.day&&!x.done)R.starAt=(S.dayLen||CFG.dayMin)*60*(.35+Math.random()*.35)}}
  // Milk Tea Crush Buff: Buff doanh thu vĩnh viễn (mỗi cấp +1%)
  const crushBonus = (S && S.crushBuffRate) || 0;
  R.todayCrushBuffRate = crushBonus;
  // 🏮 Khi mở cửa ca bán: Quầy rộng hoặc quán nâng tầng có khách xếp hàng đợi sẵn!
  const initialSpawnCount = maxSlots >= 10 ? rnd([5, 6, 7]) : (maxSlots >= 6 ? rnd([3, 4, 5]) : (Math.random() < 0.6 ? 1 : 2));
  for(let i = 0; i < initialSpawnCount; i++){
    spawn();
  }
  R.paused=false;renderSell();window.scrollTo(0,0);musSync();
  clearInterval(timer);timer=setInterval(tick,100);
  if(isStaffActive('staffButler')){
    try { staffButlerPerformDuties(true); } catch(e) { console.error('Butler duties on startDay error:', e); }
  }
  const e0=ev();if(e0)setTimeout(()=>toast(EVS[e0.id].n+': '+evText(e0)),600);
  if(S.upg.staffGz&&(evIs('rain')||evIs('hot'))){setTimeout(()=>{if(R.running)gzWeatherComplain()},700)}
  const lv=level();if(lv>1&&(S.seenLv||1)<lv){S.seenLv=lv;save();R.paused=true;clearInterval(timer);sfx('lvup');ask(lvIntro(lv),[['Đã hiểu, mở cửa',resumeGame,1]])}
  coach();
}
function endDay(){
  clearInterval(timer);clearTimeout(R._gzCatchTimer);if(R._fakeIntervalTimer){clearInterval(R._fakeIntervalTimer);R._fakeIntervalTimer=null;}R.running=false;pourSnd(false);clearStaffPouring();
  if(R){ R.combo = 0; R.rushHourActive = false; R.todayCrushBuffRate = 0; }
  renderRushHourBanner();
  updateComboWidget(0, false);
  if(typeof stopCounterPet === 'function') stopCounterPet();
  hideAllPoliceButtons();

  // Kiểm tra cảnh báo Lích Đờ đang dỗi trước khi đóng sổ chuyển ngày
  if(typeof mktAutoRescueAllFlops === 'function') mktAutoRescueAllFlops(true);
  const sulkingList = [];
  if(S && S.branches){
    BRANCH_LOCATIONS.forEach(b => {
      const bData = S.branches[b.id];
      if(bData && bData.bought && !bData.closed && bData.leader && bData.leader.mood === 'sulking'){
        sulkingList.push({ name: b.name, leaderName: bData.leader.name, isFranchise: false, id: b.id });
      }
    });
  }
  if(S && S.franchise && Array.isArray(S.franchise.partners)){
    S.franchise.partners.forEach(p => {
      if(p && !p.closed && p.leader && p.leader.mood === 'sulking'){
        sulkingList.push({ name: p.name, leaderName: p.leader.name, isFranchise: true, id: p.id });
      }
    });
  }
  if(sulkingList.length > 0 && !R._sulkingIgnored){
    ask(`
      <div class="pbig">💔😭</div>
      <h2 style="color:#e11d48;margin:4px 0 8px;font-size:1.25rem;font-weight:800;">CẢNH BÁO: LÍCH ĐỜ ĐANG DỖI SẮP NGHỈ VIỆC!</h2>
      <p style="font-size:0.92rem;line-height:1.55;color:var(--ink);">
        Có <b>${sulkingList.length} Lích Đờ</b> (${sulkingList.map(s => `<b>${esc(s.leaderName)}</b> · ${esc(s.name)}`).join(', ')}) đang <b>DỖI</b> vì video MXH bị flop và chưa được dỗ!<br>
        ⚠️ <b>HẬU QUẢ:</b> Nếu đóng sổ ngày ngay bây giờ, các Lích Đờ này sẽ <b>chính thức nghỉ việc</b>, chi nhánh sẽ bị <b>đóng cửa</b> và mất trắng toàn bộ doanh thu chi nhánh ngày mai!
      </p>
    `, [
      ['💖 Dỗ & Thưởng nóng cứu Lích Đờ (-50k/người)', ()=>{
        const fee = sulkingList.length * 50000;
        if(S.money >= fee) S.money -= fee;
        sulkingList.forEach(s => {
          if(!s.isFranchise && S.branches && S.branches[s.id] && S.branches[s.id].leader){
            S.branches[s.id].leader.mood = 'happy';
          } else if(s.isFranchise && S.franchise && Array.isArray(S.franchise.partners)){
            const fp = S.franchise.partners.find(x => x && x.id === s.id);
            if(fp && fp.leader) fp.leader.mood = 'happy';
          }
        });
        if(typeof sfx === 'function') sfx('win');
        toast(`💖 Đã dỗ thành công ${sulkingList.length} Lích Đờ! Các bạn đã vui vẻ xé đơn nghỉ việc và tiếp tục quản lý chi nhánh! 🎉`, 4000);
        R._sulkingIgnored = true;
        finishEndDay();
      }, 1],
      ['Bỏ qua & Đóng sổ ngày (Chấp nhận mất Lích Đờ)', ()=>{
        R._sulkingIgnored = true;
        finishEndDay();
      }]
    ]);
    return;
  }

  if(R.fakeCase && R.fakeCase.suspect){
    const pendingCase = R.fakeCase;
    R.fakeCase = null;
    hideAllPoliceButtons();
    ask(`
      <div class="pbig">🚨👮‍♂️</div>
      <h2 style="color:#dc2626;margin:4px 0 8px;font-size:1.3rem;font-weight:800;">CÔNG AN PHƯỜNG ĐẾN ĐIỀU TRA</h2>
      <p style="font-size:0.92rem;line-height:1.55;color:var(--ink);">
        Trước khi đóng sổ kết toán ngày hôm nay, Công an phường đã trích xuất camera vụ khách dùng <b>TIỀN GIẢ</b> (đơn: <b>${esc(pendingCase.suspect.order)}</b>, thiệt hại: <b style="color:#ef4444;">-${fmt(pendingCase.suspect.loss)}</b>)!<br>Bạn có muốn cùng Công An nhận diện nghi phạm để thu hồi tiền và nhận thưởng <b>+500.000đ</b> không?
      </p>
    `, [
      ['🚨 Nhận diện & Báo Công An ngay', ()=>{
        R.fakeCase = pendingCase;
        reportFakeMoneyPolice(true);
      }, 1],
      ['Bỏ qua & Đóng sổ ngày', ()=>{
        finishEndDay();
      }]
    ]);
    return;
  }
  finishEndDay();
}
function finishEndDay(){
  if(finishEndDay._running){
    console.warn('finishEndDay already running, ignoring concurrent call');
    return;
  }
  if(R && R._finishedDay === S.day){
    if($('modal') && $('modal').hidden){
      $('modal').hidden = false;
    }
    return;
  }
  finishEndDay._running = true;
  if(R) R._finishedDay = S.day;
  if(S && S._lastFinishedDay != null) delete S._lastFinishedDay;
  let broke = false;
  let guardRestAlert = false;
  let dayIncremented = false;
  let r = (typeof S !== 'undefined' && S && S.cur) ? S.cur : null;
  let T = (typeof R !== 'undefined' && R && R.today) ? R.today : null;
  try {
    if(!T){ T = (R && R.today) ? R.today : { stars: [], served: 0, lost: 0, priceLost: 0, rev: 0, bad: 0, used: {} }; if(R) R.today = T; }
    if(!r){ r = (S && S.cur) ? S.cur : newRec(S ? S.day : 1); if(S) S.cur = r; }
    r.waste = r.waste || {};
    r.sales = r.sales || {};
    r.ing = r.ing || {};
    r.equip = Array.isArray(r.equip) ? r.equip : [];
    T.stars = Array.isArray(T.stars) ? T.stars : [];
    if(typeof closeLobbyView === 'function') closeLobbyView();
    sfx('lvup');
    const fc = fixed();
    if(S && S.startupLocation === 'hoangsa'){
      const bMulIsland = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
      const islandGrant = Math.round(300000 * bMulIsland);
      S.money += islandGrant;
      r.islandGrant = islandGrant;
      toast(`🏝️ Nhận trợ cấp phụng sự huyện đảo Hoàng Sa - Trường Sa: +${fmt(islandGrant)} vào két! 🇻🇳`, 5000);
    }
  if(window.WeatherSystem && typeof window.WeatherSystem.cleanupSellingFx === 'function'){
    window.WeatherSystem.cleanupSellingFx();
  }
  if(window.Garden && typeof window.Garden.advanceDay === 'function'){
    window.Garden.advanceDay();
  }
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler') && typeof staffButlerPerformDuties === 'function'){
    try { staffButlerPerformDuties(false); } catch(e) { console.error('finishEndDay butler duties:', e); }
  }
  if(S && S.tiktokerViralDays && S.tiktokerViralDays > 0){
    S.tiktokerViralDays--;
  }
  R.fakeCase=null;R.gzStolenRecent=false;R.gzLastStolenBill=0;R.gzStolenCustId=null;
  R.gzBuyerMsg = null; R.gzBuyerMsgUntil = 0; R.svBuyerMsg = null; R.svBuyerMsgUntil = 0;
  R.staffDayOff = null; R.staffLate = null;
  R.staffOnTempCover = false; R.onlineTempClosed = false;
  if(S.pet && S.pet.unlocked) {
    if(isStaffActive('staffButler')){
      const maxS = typeof getPetMaxStat === 'function' ? getPetMaxStat(S.pet.level) : 100;
      S.pet.hunger = maxS;
      S.pet.clean = maxS;
      S.pet.happiness = maxS;
      S.pet.energy = maxS;
      if(typeof addPetExp === 'function') addPetExp(20);
      r.butlerPetCare = true;
      if(S.capbi && S.capbi.unlocked && S.capbi.active){
        const maxCb = 100 + ((S.capbi.level || 1) - 1) * 10;
        S.capbi.hunger = maxCb;
        S.capbi.clean = maxCb;
        S.capbi.happiness = maxCb;
        S.capbi.energy = maxCb;
        if(typeof addCapbiExp === 'function') addCapbiExp(20);
      }
    } else {
      const isCat = S.pet.type === 'cat';
      if(isCat) {
        // Mèo: Vui vẻ và Độ no giảm nhanh hơn
        S.pet.happiness = Math.max(0, (S.pet.happiness || 90) - 35);
        S.pet.hunger = Math.max(0, (S.pet.hunger || 85) - 35);
        S.pet.clean = Math.max(0, (S.pet.clean || 90) - 20);
        S.pet.energy = Math.max(0, (S.pet.energy || 100) - 20);
      } else {
        // Chó: Sạch sẽ và Năng lượng giảm nhanh hơn
        S.pet.clean = Math.max(0, (S.pet.clean || 90) - 35);
        S.pet.energy = Math.max(0, (S.pet.energy || 100) - 35);
        S.pet.hunger = Math.max(0, (S.pet.hunger || 85) - 20);
        S.pet.happiness = Math.max(0, (S.pet.happiness || 95) - 20);
      }
    }
    S.pet.currentAction = null;

    // Nếu 2/4 thanh giảm về 0 thì thú cưng sẽ bỏ nhà đi, bạn phải cày lại thú cưng
    let zeroCount = 0;
    if((S.pet.hunger || 0) <= 0) zeroCount++;
    if((S.pet.clean || 0) <= 0) zeroCount++;
    if((S.pet.happiness || 0) <= 0) zeroCount++;
    if((S.pet.energy || 0) <= 0) zeroCount++;

    if(zeroCount >= 2) {
      const speciesName = isCat ? 'Mèo Chiêu Tài' : 'Tó Shiba';
      S.pet.unlocked = false;
      S.pet.paid10m = false;
      S.pet.level = 1;
      S.pet.exp = 0;
      S.pet.ranAway = true;
      S.pet.ranAwaySpecies = speciesName;
      r.petRanAway = speciesName;
    } else if(zeroCount === 1) {
      const speciesName = isCat ? 'Mèo Chiêu Tài' : 'Tó Shiba';
      r.petDangerNotice = speciesName;
    }
  }

  // Giảm nhẹ chỉ số của Cáp Bi sau mỗi ca bán nếu không có Quản gia
  if(S.capbi && S.capbi.unlocked && S.capbi.active) {
    if(!isStaffActive('staffButler')){
      S.capbi.hunger = Math.max(0, (S.capbi.hunger || 90) - 25);
      S.capbi.clean = Math.max(0, (S.capbi.clean || 90) - 25);
      S.capbi.happiness = Math.max(0, (S.capbi.happiness || 100) - 20);
      S.capbi.energy = Math.max(0, (S.capbi.energy || 100) - 25);
    }
    S.capbi.currentAction = null;
  }
  let gzQuitNotice = false;
  if(R.gzSulking && S.upg.staffGz){
    // Qua đêm ngủ đủ giấc là tự hết dỗi, không đuổi việc nhân viên
    R.gzSulking = false;
    R.gzCheers = 0;
  }
  if(R && R.slots && Array.isArray(R.slots)){
    R.slots.forEach(c => { if(c && T) T.lost = (T.lost || 0) + 1; });
  }
  const waste = (typeof expireStock === 'function' ? expireStock() : []) || [];
  const endDayCashTiers = typeof getSafeCashTiers === 'function' ? getSafeCashTiers(S && S.day) : { lowCap: 3000000000, midCap: 6000000000, highCap: 12000000000, megaCap: 30000000000 };
  const preShiftStartCash = (r && r.startCash != null) ? Math.max(0, Number(r.startCash) || 0) : Math.max(0, Number(S && S.money) || 0);
  const peakHoardCashEarly = Math.min(Math.max(0, Number(S && S.money) || 0), preShiftStartCash);
  const verdictEarly = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(peakHoardCashEarly, true) : { isCheater: false, tier: 0, status: 'CLEAN', score: 0 };
  const isHoardCheatEarly = !!(verdictEarly.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(peakHoardCashEarly)));
  const earlyCheatTier = isHoardCheatEarly ? Math.max(1, verdictEarly.tier || 0, peakHoardCashEarly >= endDayCashTiers.megaCap ? 4 : (peakHoardCashEarly >= endDayCashTiers.highCap ? 3 : (peakHoardCashEarly >= endDayCashTiers.midCap ? 2 : 1))) : 0;
  let endDayHoardStockLostQty = Number(T && T.hoardStockLostQty) || 0;
  let endDayHoardStockLostVal = Number(T && T.hoardStockLostVal) || 0;
  // Chỉ tịch thu/tổn thất kho hàng loạt cuối ca khi có căn cứ gian lận (Ngưỡng Phán Quyết WARN/FLAG/SHADOWBAN/BAN hoặc Vượt Két), tránh mất kho hàng loạt cho người chơi hợp lệ
  if(isHoardCheatEarly && earlyCheatTier >= 1 && typeof raidHoardStock === 'function'){
    const minP = earlyCheatTier >= 4 ? 0.75 : (earlyCheatTier === 3 ? 0.50 : (earlyCheatTier === 2 ? 0.25 : 0.10));
    const maxP = earlyCheatTier >= 4 ? 0.92 : (earlyCheatTier === 3 ? 0.70 : (earlyCheatTier === 2 ? 0.42 : 0.20));
    const raidedStock = raidHoardStock(minP, maxP);
    if(Array.isArray(raidedStock) && raidedStock.length){
      raidedStock.forEach(item => {
        if(!item || !item.k) return;
        endDayHoardStockLostQty += (item.q || 0);
        endDayHoardStockLostVal += (item.v || 0);
        const ex = waste.find(w => w && w.k === item.k);
        if(ex){
          ex.q += item.q;
          ex.v += item.v;
        } else {
          waste.push({ k: item.k, q: item.q, v: item.v });
        }
      });
    }
  }
  r.hoardStockLostQty = endDayHoardStockLostQty;
  r.hoardStockLostVal = endDayHoardStockLostVal;
  if(typeof syncFlav === 'function') syncFlav();
  if(Array.isArray(waste)){
    waste.forEach(x => { if(x && x.k) r.waste[x.k] = { q: x.q, v: x.v }; });
  }
  if(T) S.used = T.used;
  r.rent=fc.rent;r.util=fc.util;r.served=T.served;r.lost=T.lost+T.priceLost;r.starSum=T.stars.reduce((a,b)=>a+b,0);r.starN=T.stars.length;
  r.gzStolen=T.gzStolen||0;
  r.fakeLoss=T.fakeLoss||0;
  r.buyerStolen=T.buyerStolen||0;
  r.buyerTrips=T.buyerTrips||0;
  r.snatchLoss = (T && T.snatchLoss) || (r.snatchLoss || 0);
  r.snatchCount = (T && T.snatchCount) || (r.snatchCount || 0);
  r.svPawnedLoss = (S.cur && S.cur.svPawnedLoss) || (r.svPawnedLoss || 0);
  const staffTipTotal = (S.cur && S.cur.staffTip) ? S.cur.staffTip : (r.staffTip || 0);
  r.staffTip = staffTipTotal;
  if(staffTipTotal > 0){
    // Thuế TNCN trên tip 4.5% (trừ vào tip nhân sự, KHÔNG trừ két quán)
    const tipTax = Math.round(staffTipTotal * 0.045);
    r.tipTaxDeducted = tipTax;
    r.tipNetToStaff = staffTipTotal - tipTax;
  }
  /* bảo vệ thu lại tiền của khách quỵt trước khi tổng kết (không đòi khách trả thiếu) */
  const gMac=0, gRun=T.gRun||0;
  r.guard=gRun;
  S.money+=r.guard;

  // 1. Doanh thu & Chi phí thuê mặt bằng, Lương NV, Nguyên liệu Chi nhánh trực thuộc
  let branchRevTotal = 0;
  let branchRentTotal = 0;
  let branchWageTotal = 0;
  let branchIngTotal = 0;
  let branchNetTotal = 0;
  const bankruptBranches = [];
  const bankruptFranchises = [];
  // Chỉ tính số tiền mặt tồn từ đầu ca (preShiftStartCash), KHÔNG tính doanh thu vừa kiếm được trong ca hôm nay
  const peakHoardCash = Math.min(Math.max(0, Number(S && S.money) || 0), preShiftStartCash);
  if(S) S._lastPeakHoardCash = peakHoardCash;
  const verdictEndDay = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(peakHoardCash, true) : { isCheater: false, tier: 0, status: 'CLEAN', score: 0 };
  const isHoardCheatEndDay = !!(verdictEndDay.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(peakHoardCash)));
  const cheatTierEndDay = isHoardCheatEndDay ? Math.max(1, verdictEndDay.tier || 0, peakHoardCash >= endDayCashTiers.megaCap ? 4 : (peakHoardCash >= endDayCashTiers.highCap ? 3 : (peakHoardCash >= endDayCashTiers.midCap ? 2 : 1))) : 0;
  // Đồng bộ 100% Ngưỡng Phán Quyết theo Điểm chống hack (WARN=1, FLAG=2, SHADOWBAN=3, BAN=4) với Vượt Két cho phá sản Chi nhánh & Nhượng quyền ("phá quyến")
  const hoardBranchBankruptRate = isHoardCheatEndDay ? (cheatTierEndDay >= 4 ? 0.60 : (cheatTierEndDay === 3 ? 0.35 : (cheatTierEndDay === 2 ? 0.15 : (cheatTierEndDay >= 1 ? 0.05 : 0)))) : 0;
  const hoardFranBankruptRate = isHoardCheatEndDay ? (cheatTierEndDay >= 4 ? 0.55 : (cheatTierEndDay === 3 ? 0.30 : (cheatTierEndDay === 2 ? 0.12 : (cheatTierEndDay >= 1 ? 0.04 : 0)))) : 0;

  if(S.branches) {
    BRANCH_LOCATIONS.forEach(b => {
      if(S.branches[b.id] && S.branches[b.id].bought) {
        const bData = S.branches[b.id];
        if(bData.closed) return; // Chi nhánh đóng cửa: không sinh doanh thu & không trừ chi phí
        const lv = bData.level || 1;
        const recipeCount = Object.keys((S.collection && S.collection.craftedRecipes) || {}).length;
        const star5Count = (S.collection && S.collection.recipeStars) ? Object.values(S.collection.recipeStars).filter(v => v >= 5).length : 0;
        const star5Bonus = star5Count * 0.03;
        const thienHaBonus = (S.collection && S.collection.craftedRecipes && S.collection.craftedRecipes['rec_vutru_thienha']) ? 0.15 : 0;
        const recipeMultiplier = Math.min(2.5, (1 + (recipeCount * 0.03)) * (1 + star5Bonus + thienHaBonus));
        let curMin = Math.round(b.minRev * (1 + (lv - 1) * 0.2) * recipeMultiplier);
        let curMax = Math.round(b.maxRev * (1 + (lv - 1) * 0.2) * recipeMultiplier);
        const hasLeader = !!(bData.leader && bData.leader.mood !== 'sulking');
        if(hasLeader){
          curMin = Math.round(curMin * 1.25);
          curMax = Math.round(curMax * 1.25);
        }
        const adBranchBoost = Math.min(0.50, getActiveAdsBranchBoost());
        let catBranchBoost = 0;
        if(S.pet && S.pet.unlocked && S.pet.type === 'cat' && (S.pet.happiness || 0) >= 50){
          const catBuff = typeof getPetBuffValues === 'function' ? getPetBuffValues('cat', S.pet.level) : null;
          const catBonus = catBuff && catBuff.branchBonusRate != null ? catBuff.branchBonusRate : Math.min(0.45, 0.20 + ((S.pet.level || 1) - 1) * 0.025);
          catBranchBoost += catBonus;
        }
        if(S.capbi && S.capbi.unlocked && S.capbi.active && (S.capbi.happiness || 0) >= 50){
          const capbiBuff = typeof getCapbiBuffValues === 'function' ? getCapbiBuffValues(S.capbi.level) : { branchBonusRate: 0.10 };
          catBranchBoost += (capbiBuff.branchBonusRate || 0.10);
        }
        const totalBranchBoost = adBranchBoost + catBranchBoost;
        if(totalBranchBoost > 0){
          curMin = Math.round(curMin * (1 + totalBranchBoost));
          curMax = Math.round(curMax * (1 + totalBranchBoost));
        }
        const bRev = Math.floor(curMin + Math.random() * (curMax - curMin));
        if(adBranchBoost > 0){
          const adGain = Math.round(bRev * (adBranchBoost / (1 + totalBranchBoost)));
          r.branchAdBonus = (r.branchAdBonus || 0) + adGain;
        }
        if(catBranchBoost > 0){
          const catGain = Math.round(bRev * (catBranchBoost / (1 + totalBranchBoost)));
          r.branchPetBonus = (r.branchPetBonus || 0) + catGain;
        }
        // Lích đờ tự tuyển nhân viên & nhập nguyên liệu
        const staffCount = hasLeader ? Math.min(6, lv + 1) : 0;
        bData.staffCount = staffCount;
        const isOwnedGround = S && S.realEstate && S.realEstate.branches && S.realEstate.branches[b.id];
        const bRent = isOwnedGround ? 0 : b.dailyRent;
        const bWage = (staffCount * 160000) + (hasLeader ? 200000 : 0);
        const bIng = Math.round(bRev * (hasLeader ? 0.28 : 0.30));
        const bProfit = bRev - bRent - bWage - bIng;

        bData.lastDay = { rev: bRev, rent: bRent, wage: bWage, ing: bIng, profit: bProfit, staff: staffCount, staffCount: staffCount };
        bData.totalRev = (Number(bData.totalRev) || 0) + bRev;
        bData.totalNet = (Number(bData.totalNet) || 0) + bProfit;

        branchRevTotal += bRev;
        branchRentTotal += bRent;
        branchWageTotal += bWage;
        branchIngTotal += bIng;
        branchNetTotal += bProfit;

        // Tỉ lệ phá sản chi nhánh: Bình thường chỉ khi thua lỗ, nhưng khi ôm >= 2 Tỷ - 30 Tỷ+ tiền mặt trong két thì khủng hoảng an ninh & thanh tra làm chi nhánh vỡ nợ hàng loạt!
        if(hoardBranchBankruptRate > 0 && Math.random() < hoardBranchBankruptRate){
          bData.closed = true;
          bData.bankrupt = true;
          bData.leader = null;
          bData.staffCount = 0;
          bankruptBranches.push({ name: b.name, loss: Math.max(5000000, Math.abs(bProfit)), staff: staffCount });
        } else if(bProfit < 0){
          let bankruptChance = (bProfit < -1000000) ? 0.06 : 0.02;
          let reduceFactor = 1.0;
          if(S.pet && S.pet.unlocked && S.pet.type === 'cat' && (S.pet.happiness || 0) >= 50) reduceFactor *= 0.5;
          if(S.capbi && S.capbi.unlocked && S.capbi.active && (S.capbi.happiness || 0) >= 50){
            const capbiBuff = typeof getCapbiBuffValues === 'function' ? getCapbiBuffValues(S.capbi.level) : { branchLossReduceRate: 0.30 };
            reduceFactor *= (1 - (capbiBuff.branchLossReduceRate != null ? capbiBuff.branchLossReduceRate : 0.30));
          }
          bankruptChance *= reduceFactor;
          if(Math.random() < bankruptChance){
            bData.closed = true;
            bData.bankrupt = true;
            bData.leader = null;
            bData.staffCount = 0;
            bankruptBranches.push({ name: b.name, loss: Math.abs(bProfit), staff: staffCount });
          }
        }
      }
    });
  }
  const branchNet = branchNetTotal;
  if(!r._branchNetCredited){
    r._branchNetCredited = true;
    S.money += branchNet;
    S.totalBranchRev = (Number(S.totalBranchRev) || 0) + branchRevTotal;
    S.totalBranchNet = (Number(S.totalBranchNet) || 0) + branchNetTotal;
  }
  r.branchRev = branchRevTotal;
  r.branchRent = branchRentTotal;
  r.branchWage = branchWageTotal;
  r.branchIng = branchIngTotal;
  r.branchNet = branchNetTotal;

  // 2. Thu phí bản quyền Royalty nhượng quyền, Lợi nhuận cung ứng sỉ độc quyền & Phí phần mềm POS
  let royaltyTotal = 0;
  let franchiseSupplyProfitTotal = 0;
  let franchisePosFeeTotal = 0;
  let franchiseRevTotal = 0;
  let franchiseRentTotal = 0;
  let franchiseWageTotal = 0;
  let franchiseIngTotal = 0;
  let franchiseNetTotal = 0;
  let franchiseStaffTotal = 0;

  if(S.franchise && S.franchise.partners && S.franchise.partners.length) {
    const curTier = (S.franchise && S.franchise.contractTier) || 1;
    const tierConfig = (typeof FRANCHISE_TIERS !== 'undefined' ? FRANCHISE_TIERS.find(t => t.tier === curTier) : null) || {
      tier: 1, name: 'Hợp Đồng Tiêu Chuẩn', royRate: 0.10, posFee: 0, supplyMargin: 0.40
    };
    const royRate = tierConfig.royRate; // 10%, 12%, 14%, 16%
    const posFeePerBranch = tierConfig.posFee || 0; // 0, 1.5M, 3M, 5M
    const supplyMargin = tierConfig.supplyMargin || 0.40; // 40%, 45%, 48%, 50%

    // 1. Sức Mạnh Thương Hiệu Chuỗi Chuẩn F&B Thực Tế:
    // Một chi nhánh nhượng quyền sầm uất (Landmark 81, Cầu Giấy, Q1...) bán 400 - 800 ly/ngày (18tr - 42tr/ngày)
    const mainShopRev = Math.max(30000000, (typeof recRev === 'function' ? recRev(r) : 0) || (R && R.today && R.today.rev) || 40000000);
    const followers = (S.mxh && S.mxh.followers) || 120;
    const brandReputationBonus = Math.min(0.35, Math.max(0, (followers - 50000) / 1000000));

    S.franchise.partners.forEach(p => {
      if(!p || p.closed) return;
      const cand = FRANCHISE_CANDIDATES.find(c => c && c.id === p.id);
      const baseMin = (cand && cand.baseRevMin) || 16000000;
      const baseMax = (cand && cand.baseRevMax) || 28000000;
      const baseRev = baseMin + Math.random() * (baseMax - baseMin);
      const recipeCount = Object.keys((S.collection && S.collection.craftedRecipes) || {}).length;
      const star5Count = (S.collection && S.collection.recipeStars) ? Object.values(S.collection.recipeStars).filter(v => v >= 5).length : 0;
      const star5Bonus = star5Count * 0.03;
      const thienHaBonus = (S.collection && S.collection.craftedRecipes && S.collection.craftedRecipes['rec_vutru_thienha']) ? 0.15 : 0;
      // Cộng hưởng từ công thức độc quyền, cấp sao 5★ & danh tiếng quán chính (tối đa +50%)
      const recipeBonus = Math.min(0.50, (recipeCount * 0.010) + star5Bonus + thienHaBonus);
      const mainShopEcho = Math.min(5000000, mainShopRev * 0.01);
      const pLevel = Math.max(1, p.level || 1);
      const levelMul = pLevel === 3 ? 1.50 : (pLevel === 2 ? 1.25 : 1.0);
      let partnerRev = Math.round((baseRev + mainShopEcho) * (1 + brandReputationBonus + recipeBonus) * levelMul);

      const hasLeader = !!(p.leader && p.leader.mood !== 'sulking');
      if(hasLeader){
        partnerRev = Math.round(partnerRev * 1.20);
      }
      const adFranchiseBoost = Math.min(0.50, getActiveAdsBranchBoost());
      let catFranBoost = 0;
      if(S.pet && S.pet.unlocked && S.pet.type === 'cat' && (S.pet.happiness || 0) >= 50){
        const catBuff = typeof getPetBuffValues === 'function' ? getPetBuffValues('cat', S.pet.level) : null;
        catFranBoost += (catBuff && catBuff.franBonusRate != null) ? catBuff.franBonusRate : Math.min(0.35, 0.15 + ((S.pet.level || 1) - 1) * 0.015);
      }
      if(S.capbi && S.capbi.unlocked && S.capbi.active && (S.capbi.happiness || 0) >= 50){
        const capbiBuff = typeof getCapbiBuffValues === 'function' ? getCapbiBuffValues(S.capbi.level) : { branchBonusRate: 0.08 };
        catFranBoost += (capbiBuff.branchBonusRate || 0.08);
      }
      // Giới hạn trần doanh thu thực tế cho 1 cơ sở nhượng quyền F&B (chuẩn 350-700 ly/ngày, tối đa 35tr-55tr/ngày tùy Cấp quy mô)
      const maxCap = pLevel === 3 ? 55000000 : (pLevel === 2 ? 45000000 : 35000000);
      partnerRev = Math.min(maxCap, Math.max(14000000, partnerRev));

      // 1. Phí bản quyền Royalty (8% - 18% theo cấp bậc hợp đồng)
      // ✅ BƯỚC 5B: Buff Ads/Pet cấp trên KHÔNG áp lên doanh thu đối tác nhượng quyền, chỉ áp lên Royalty thu về quán mẹ
      let roy = Math.round(partnerRev * royRate);
      const totalFranBoost = adFranchiseBoost + catFranBoost;
      if(totalFranBoost > 0){
        const baseRoy = roy;
        const adPetBuff = 1 + Math.min(0.45, totalFranBoost);
        roy = Math.round(roy * adPetBuff);
        const extraRoy = roy - baseRoy;
        if(adFranchiseBoost > 0){
          const adFranGain = Math.round(extraRoy * (adFranchiseBoost / totalFranBoost));
          r.franchiseAdBonus = (r.franchiseAdBonus || 0) + adFranGain;
        }
        if(catFranBoost > 0){
          const catFranGain = Math.round(extraRoy * (catFranBoost / totalFranBoost));
          r.franchisePetBonus = (r.franchisePetBonus || 0) + catFranGain;
        }
      }

      // Chi phí vận hành tự chủ của đối tác (đối tác tự chi trả)
      const pStaffCount = hasLeader ? 4 : 2;
      p.staffCount = pStaffCount;
      const pRent = Math.max(2500000, Math.round(partnerRev * 0.08));
      const pWage = (pStaffCount * 180000) + (hasLeader ? 250000 : 0);
      const pIng = Math.round(partnerRev * (hasLeader ? 0.28 : 0.30));

      // 2. Độc Quyền Cung Ứng Chuỗi (Supply Chain):
      // Lãi ròng bán sỉ của Tổng Kho Mẹ sau khi trừ giá vốn hàng bán & chi phí vận chuyển xe lạnh (biên 20% - 30%)
      const supplyProfit = Math.round(pIng * supplyMargin);

      // 3. Phí phần mềm POS & bản quyền công thức (0đ - 3tr/ngày theo cấp bậc hợp đồng)
      const posFee = posFeePerBranch || 0;

      // Lợi nhuận của đối tác (sau khi trừ toàn bộ chi phí)
      const partnerProfit = partnerRev - pRent - pWage - pIng - roy - posFee;

      p.lastDay = {
        level: pLevel,
        rev: partnerRev,
        rent: pRent,
        wage: pWage,
        ing: pIng,
        roy: roy,
        posFee: posFee,
        supplyProfit: supplyProfit,
        profit: partnerProfit,
        staff: pStaffCount,
        staffCount: pStaffCount
      };

      franchiseRevTotal += partnerRev;
      franchiseRentTotal += pRent;
      franchiseWageTotal += pWage;
      franchiseIngTotal += pIng;
      franchiseNetTotal += partnerProfit;
      franchiseStaffTotal += pStaffCount;

      royaltyTotal += roy;
      franchiseSupplyProfitTotal += supplyProfit;
      franchisePosFeeTotal += posFee;

      p.totalRoyalty = (p.totalRoyalty || 0) + roy;
      p.totalSupplyProfit = (p.totalSupplyProfit || 0) + supplyProfit;
      p.totalPosFee = (p.totalPosFee || 0) + posFee;

      // Nguy cơ vỡ nợ đối tác nhượng quyền: Tăng vọt lên 30% - 55% khi két quán mẹ tích trữ hàng chục tỷ tiền mặt gây khủng hoảng chuỗi!
      if((hoardFranBankruptRate > 0 && Math.random() < hoardFranBankruptRate) || (partnerProfit < -1000000 && Math.random() < 0.02)){
        p.closed = true;
        p.bankrupt = true;
        p.leader = null;
        p.staffCount = 0;
        bankruptFranchises.push({ name: p.name, city: p.city, loss: Math.max(5000000, Math.abs(partnerProfit)) });
      }
    });

    // Tổng tiền nhượng quyền đổ về két chủ tiệm: Royalty + Lãi bán sỉ nguyên liệu + Phí POS
    const totalFranchisePayout = royaltyTotal + franchiseSupplyProfitTotal + franchisePosFeeTotal;
    if(!r._franchisePayoutCredited){
      r._franchisePayoutCredited = true;
      S.franchise.totalRoyaltyEarned = (S.franchise.totalRoyaltyEarned || 0) + royaltyTotal;
      S.franchise.totalSupplyProfit = (S.franchise.totalSupplyProfit || 0) + franchiseSupplyProfitTotal;
      S.franchise.totalPosFeeEarned = (S.franchise.totalPosFeeEarned || 0) + franchisePosFeeTotal;
      S.money += totalFranchisePayout;
    }

    r.franchiseRev = franchiseRevTotal;
    r.franchiseRent = franchiseRentTotal;
    r.franchiseWage = franchiseWageTotal;
    r.franchiseIng = franchiseIngTotal;
    r.franchiseRoyalty = royaltyTotal;
    r.franchiseSupplyProfit = franchiseSupplyProfitTotal;
    r.franchisePosFee = franchisePosFeeTotal;
    r.franchiseTotalIncome = totalFranchisePayout;
    r.franchiseNet = franchiseNetTotal;
    r.franchiseStaff = franchiseStaffTotal;
  }

  const isDogPartyLobbyActive = !!(S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50);
  const dogPartyBuffObj = isDogPartyLobbyActive && typeof getPetBuffValues === 'function' ? getPetBuffValues('dog', S.pet.level) : null;
  const dogPartyLobbyRate = isDogPartyLobbyActive ? ((dogPartyBuffObj && dogPartyBuffObj.partyLobbyBonusRate) || Math.min(0.35, 0.15 + ((S.pet.level || 1) - 1) * 0.010)) : 0;

  if(dogPartyLobbyRate > 0 && r.lobbyRev > 0 && !r._dogLobbyBonusCredited){
    r._dogLobbyBonusCredited = true;
    const dogLobbyBonus = Math.round(r.lobbyRev * dogPartyLobbyRate);
    if(dogLobbyBonus > 0){
      S.money += dogLobbyBonus;
      S.totalRev = (S.totalRev || 0) + dogLobbyBonus;
      r.lobbyRev += dogLobbyBonus;
      r.dogBonus = (r.dogBonus || 0) + dogLobbyBonus;
      if(T) T.rev = (T.rev || 0) + dogLobbyBonus;
    }
  }

  let partyResultHtml = '';
  if(S.partyContract && S.partyContract.day === S.day && S.partyContract.accepted){
    const pc = S.partyContract;
    const served = (R.party && R.party.served != null) ? R.party.served : (pc.served || 0);
    pc.served = served;
    if(served >= pc.cups){
      pc.completed = true;
      const dogPartyBonus = dogPartyLobbyRate > 0 ? Math.round((pc.payout + pc.bonus) * dogPartyLobbyRate) : 0;
      const finalBonus = pc.payout + pc.bonus + dogPartyBonus;
      S.money += finalBonus;
      S.totalRev = (S.totalRev || 0) + finalBonus;
      const totalPartyVal = (Number(pc.deposit) || 0) + finalBonus;
      r.partyPayout = totalPartyVal;
      if(dogPartyBonus > 0) r.dogBonus = (r.dogBonus || 0) + dogPartyBonus;
      T.rev = (T.rev || 0) + totalPartyVal;
      addReview(5, 'party', false, null, { name: pc.client, partyTitle: pc.title, cups: pc.cups });
      partyResultHtml = `<div style="background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #22c55e;border-radius:12px;padding:8px 12px;margin:8px 0;text-align:left;">
        <div style="font-weight:800;color:#15803d;font-size:0.92rem;">🎉 HOÀN THÀNH HỢP ĐỒNG: ${esc(pc.title)}</div>
        <div style="font-size:0.82rem;color:#166534;margin-top:2px;">
          Giao đủ <b>${served}/${pc.cups} ly trà</b>. Cọc <b>+${fmt(pc.deposit || 0)}</b> + Thanh toán nốt <b>+${fmt(pc.payout)}</b> + Thưởng hợp đồng <b>+${fmt(pc.bonus)}</b>${dogPartyBonus > 0 ? ` + 🐕 Shiba đại sứ <b>+${fmt(dogPartyBonus)}</b>` : ''} = <b style="color:#15803d;font-size:0.98rem;">+${fmt(totalPartyVal)}</b>! Nhận đánh giá 5★ VIP! ⭐⭐⭐⭐⭐
        </div>
      </div>`;
    } else {
      pc.completed = false;
      const penalty = Math.round(pc.deposit * 0.5);
      S.money = Math.max(0, S.money - penalty);
      r.partyPenalty = penalty;
      r.partyPayout = Number(pc.deposit) || 0;
      addReview(1, 'party_fail', false, null, { name: pc.client, partyTitle: pc.title, served, cups: pc.cups });
      partyResultHtml = `<div style="background:linear-gradient(135deg,#fef2f2,#fee2e2);border:2px solid #ef4444;border-radius:12px;padding:8px 12px;margin:8px 0;text-align:left;">
        <div style="font-weight:800;color:#b91c1c;font-size:0.92rem;">⚠️ GIAO THIẾU HỢP ĐỒNG: ${esc(pc.title)}</div>
        <div style="font-size:0.82rem;color:#991b1b;margin-top:2px;">
          Chỉ giao được <b>${served}/${pc.cups} ly</b>. Bị trừ phạt vi phạm hợp đồng <b style="color:#b91c1c;">-${fmt(penalty)}</b> (Tiền cọc giữ lại: +${fmt(pc.deposit || 0)}) và nhận đánh giá 1★! 😢
        </div>
      </div>`;
    }
  }

  const yi=Math.floor((S.day-1)/360);if(S.taxYear!==yi){S.taxYear=yi;S.yearRev=0}
  const rev=recRev(r),before=S.yearRev;S.yearRev+=rev;
  S.bestDayRev = Math.max(S.bestDayRev || 0, rev);
  S.bestDayServed = Math.max(S.bestDayServed || 0, r.served || 0, getRecServedCount(r));
  if(window.BanBe && window.BanBe.checkChallengeEnd) window.BanBe.checkChallengeEnd(rev);
  S.giftsReceivedToday = 0;
  S.giftsDay = S.day;
  S.friendBuff = null;
  const taxable = Math.max(0, S.yearRev - Math.max(CFG.taxThreshold, before));
  r.tax = Math.round(taxable * (CFG.vat + CFG.pit) / 100);
  r.ev=ev()?{id:ev().id,k:ev().k}:null;

  // 1. Mặt bằng & Điện nước vận hành quy mô lớn (Rent & Utilities Scale: 6% - 8% doanh thu)
  const baseFixed = (typeof fixed === 'function') ? fixed() : { rent: r.rent || 0, util: r.util || 0 };
  let scaleRent = Math.min(50000000, Math.round(rev * 0.045));
  let scaleUtil = Math.min(30000000, Math.round(rev * 0.025));

  const isMainOwned = !!(S && S.realEstate && S.realEstate.main);
  const ownedBranchCount = (S && S.realEstate && S.realEstate.branches) ? Object.values(S.realEstate.branches).filter(Boolean).length : 0;
  const branchDiscount = Math.min(1.0, ownedBranchCount * 0.25);

  if(isMainOwned){
    // ĐÃ MUA ĐỨT TRỤ SỞ QUÁN CHÍNH FLAGSHIP (SỔ ĐỎ CHÍNH CHỦ):
    // Miễn phí 100% tiền thuê nhà và tiền điện nước vận hành vĩnh viễn!
    r.rent = 0;
    r.util = 0;
  } else {
    // Nếu chưa mua đứt trụ sở chính nhưng đã mua đứt chi nhánh: giảm trừ tương ứng số chi nhánh sở hữu
    scaleRent = Math.round(scaleRent * (1 - branchDiscount));
    scaleUtil = Math.round(scaleUtil * (1 - branchDiscount));
    r.rent = (baseFixed.rent || 0) + scaleRent;
    r.util = (baseFixed.util || 0) + scaleUtil;
  }

  // ✅ BƯỚC 7: G&A VĂN PHÒNG CHUỖI & HỖ TRỢ VẬN HÀNH (Chỉ tính trên doanh thu thuộc về mẹ)
  const ownChainRev = (typeof recRev === 'function' ? recRev(r) : rev)
                    + branchRevTotal
                    + (r.franchiseTotalIncome != null ? r.franchiseTotalIncome : (royaltyTotal + (r.franchiseSupplyProfit || 0) + (r.franchisePosFee || 0)));
  const activePartners = ((S.franchise && S.franchise.partners) || []).filter(p => !p.closed).length;
  const activeBranches = BRANCH_LOCATIONS.filter(b => 
    S.branches && S.branches[b.id] && S.branches[b.id].bought && !S.branches[b.id].closed
  ).length;
  const facilitiesCount = activePartners + activeBranches;

  let gaCost = 0;
  const shouldEnableGA = (facilitiesCount >= 3) && (ownChainRev > 50000000 || S.day > 60);
  if(shouldEnableGA){
    let gaRate = 0;
    if(facilitiesCount >= 12)      gaRate = 0.10;  // 10% chuẩn quy mô chuỗi lớn
    else if(facilitiesCount >= 8)  gaRate = 0.08;  // 8%
    else if(facilitiesCount >= 5)  gaRate = 0.06;  // 6%
    else if(facilitiesCount >= 3)  gaRate = 0.03;  // 3%

    gaCost = Math.round(ownChainRev * gaRate);

    if(!S.gaNotified){
      S.gaNotified = true;
      setTimeout(() => {
        toast(`🏢 Văn phòng điều hành: Chuỗi quy mô lớn đã kích hoạt chi phí vận hành G&A văn phòng chuỗi chuẩn hóa F&B (${(gaRate * 100).toFixed(0)}% doanh thu mẹ)! 📊`, 7000);
      }, 1000);
    }
  }
  r.ga = gaCost;
  r.franchiseSupport = 0;
  r.cloud = 0;

  // ✅ Thuế thu nhập chuỗi nhượng quyền 5% (Franchise Corporate Income Tax)
  const curFranchiseIncome = (r.franchiseTotalIncome != null ? r.franchiseTotalIncome : (royaltyTotal + (r.franchiseSupplyProfit || 0) + (r.franchisePosFee || 0)));
  const franchiseIncomeTax = Math.round(curFranchiseIncome * 0.05);
  r.franchiseTax = franchiseIncomeTax;

  // 2. Nguyên liệu và bao bì: Đã được khấu trừ thực tế và ghi nhận minh bạch khi nhập kho/pha chế trong ca
  const servedCups = r.served || 0;
  r.ing = r.ing || {};

  // 3. Lương cứng & Thưởng KPI sản lượng nhân viên lũy tiến (Labor Cost: 15% - 18% doanh thu)
  {
    const dayOtMin = R.otT < 0 ? -R.otT / (dayLen() * 60) * 660 : 0;
    const nightCloseOtMin = (R.otNightCloseT && R.otNightCloseT < 0) ? -R.otNightCloseT / (R.nightTot || 80) * 480 : 0;
    const nightShiftOtMin = R.nightOtMin || 0;
    const totalOtMin = dayOtMin + nightCloseOtMin + nightShiftOtMin;
    const s2Count = (typeof getStaff2Count === 'function') ? getStaff2Count() : 1;
    r.ot = (S.upg && S.upg.staff2 && totalOtMin > 0) ? Math.ceil(totalOtMin / 30 - 1e-9) * 20000 * s2Count : 0;
  }
  const baseWageTotal = wageDay() + r.ot;
  let staffKpiBonus = 0;
  if(servedCups > 200){
    staffKpiBonus += (servedCups - 200) * 3800; // Thưởng 3.800đ/ly từ ly thứ 201
  }
  if(servedCups > 1000){
    const extraRev = Math.max(0, rev - (1000 * 35000));
    staffKpiBonus += Math.round(extraRev * 0.065); // Thưởng 6.5% doanh thu vượt chỉ tiêu 1.000 ly
  }
  // ✅ BƯỚC 2A: Cap thưởng KPI chuẩn F&B tối đa 8% doanh thu (cân bằng quỹ lương 13-15%)
  const maxKpiBonus = Math.round(rev * 0.08);
  if(staffKpiBonus > maxKpiBonus){
    r.kpiCapped = staffKpiBonus - maxKpiBonus;
    staffKpiBonus = maxKpiBonus;
  }
  r.wageBonus = staffKpiBonus;
  r.wage = baseWageTotal + staffKpiBonus;

  let hoardBankruptFreeze = false;
  if(!r._fixedCostsDeducted){
    r._fixedCostsDeducted = true;
    debts().forEach(L=>{const x=S[L.id];r.loanInt=(r.loanInt||0)+x.int;r.loanOut=(r.loanOut||0)+x.pay;S.money-=x.pay+x.int;x.left--;if(!x.left)S[L.id]=null});
    S.money -= ((r.rent || 0) + (r.util || 0) + (r.tax || 0) + (r.wage || 0) + (r.ga || 0) + (r.franchiseTax || 0) + (r.franchiseSupport || 0) + (r.cloud || 0));/* Vẫn trừ chi phí cố định, lương, thuế chuỗi & G&A vào bill mỗi ngày */
    // Rủi ro trộm két & Phong tỏa tài chính cuối ca theo Ngưỡng Phán Quyết Chống Hack (WARN=1, FLAG=2, SHADOWBAN=3, BAN=4) & các mốc trần két tiền mặt động:
    const endShiftCash = Math.min(Math.max(0, Number(S && S.money) || 0), preShiftStartCash);
    const verdictShiftEnd = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(endShiftCash) : verdictEndDay;
    const isHoardCheatShiftEnd = !!(isHoardCheatEndDay || verdictShiftEnd.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(endShiftCash)));
    const shiftEndCheatTier = isHoardCheatShiftEnd ? Math.max(cheatTierEndDay, verdictShiftEnd.tier || 0, endShiftCash >= endDayCashTiers.megaCap ? 4 : (endShiftCash >= endDayCashTiers.highCap ? 3 : (endShiftCash >= endDayCashTiers.midCap ? 2 : 1))) : 0;
    if(endShiftCash >= endDayCashTiers.midCap || (isHoardCheatShiftEnd && shiftEndCheatTier >= 2)){
      S._lastBillionNightCrimeDay = (Number(S.day) || 1) + 1;
      const bankruptStrikeProb = isHoardCheatShiftEnd ? (shiftEndCheatTier >= 4 ? 0.35 : (shiftEndCheatTier === 3 ? 0.20 : 0)) : 0;
      const totalLiquidEnd = Math.max(0, Number(S && S.money) || 0) + (isHoardCheatShiftEnd && S && S.bank ? Math.max(0, Number(S.bank.balance) || 0) : 0);
      if(bankruptStrikeProb > 0 && Math.random() < bankruptStrikeProb){
        const totalWiped = Math.max(endShiftCash, totalLiquidEnd) + 50000000;
        if(isHoardCheatShiftEnd && S && S.bank){
          S.bank.balance = 0;
          S.bank.principal = 0;
          S.bank.daysPassed = 0;
        }
        S.money = -50000000;
        hoardBankruptFreeze = true;
        r.snatchLoss = (r.snatchLoss || 0) + totalWiped;
        if(R && R.today){
          R.today.snatchLoss = (R.today.snatchLoss || 0) + totalWiped;
          R.today.snatchCount = (R.today.snatchCount || 0) + 1;
        }
        setTimeout(() => {
          toast(`💥 VỠ NỢ PHÁ SẢN: Phát hiện chỉ số/tài sản bất thường (Ngưỡng Phán Quyết ${verdictShiftEnd.status || 'BAN'} — ${fmt(Math.max(endShiftCash, totalLiquidEnd))}) dẫn đến Phong Tỏa Tài Chính, quán chính thức PHÁ SẢN! 🚨💸`, 9500, 1);
        }, 900);
      } else if(isHoardCheatShiftEnd){
        const raidPct = shiftEndCheatTier >= 4
          ? (0.72 + Math.random() * 0.16)
          : (shiftEndCheatTier === 3 ? (0.55 + Math.random() * 0.20) : (0.25 + Math.random() * 0.15));
        const basePoolRaid = Math.max(endShiftCash, totalLiquidEnd);
        const raidLoss = Math.round((basePoolRaid * raidPct) / 100000) * 100000;
        if(raidLoss > 0 && totalLiquidEnd > 0){
          const deductCashEnd = Math.min(Math.max(0, Number(S.money) || 0), raidLoss);
          S.money = Math.max(0, (Number(S.money) || 0) - deductCashEnd);
          const remBankRaid = raidLoss - deductCashEnd;
          if(remBankRaid > 0 && S.bank && (Number(S.bank.balance) || 0) > 0){
            S.bank.balance = Math.max(0, (Number(S.bank.balance) || 0) - remBankRaid);
            S.bank.principal = Math.max(0, Math.min(Number(S.bank.principal) || 0, S.bank.balance));
          }
          const actualRaidLost = deductCashEnd + Math.min(remBankRaid, Math.max(0, totalLiquidEnd - deductCashEnd));
          r.snatchLoss = (r.snatchLoss || 0) + actualRaidLost;
          if(R && R.today){
            R.today.snatchLoss = (R.today.snatchLoss || 0) + actualRaidLost;
            R.today.snatchCount = (R.today.snatchCount || 0) + 1;
          }
          setTimeout(() => {
            toast(`🚨 PHÁN QUYẾT & ĐỘT KÍCH KÉT CUỐI CA [${verdictShiftEnd.status || 'FLAG'}]: Quán bị thu hồi/vét sạch ${fmt(actualRaidLost)} lúc đóng cửa! 💸`, 8500, 1);
          }, 900);
        }
      } else {
        // Người chơi hợp lệ để quên vượt mốc cao qua đêm: Có xác suất bị trộm lẻn vào ban đêm (Bảo vệ, Chó giữ nhà & Thiết bị an ninh đều giảm thiểu rủi ro/thiệt hại)
        const hasGuardEnd = isStaffActive('staffGuard');
        const hasDogEnd = !!(S && S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50);
        const equipRedEnd = Math.min(0.35, ((S && S.upgLv && S.upgLv.equip) || 0) * 0.005);
        const baseNightProb = endShiftCash >= endDayCashTiers.megaCap ? 0.35 : (endShiftCash >= endDayCashTiers.highCap ? 0.25 : 0.15);
        const nightProb = baseNightProb * (hasGuardEnd ? 0.40 : 1.0) * (hasDogEnd ? 0.60 : 1.0);
        if(Math.random() < nightProb){
          const nightPct = endShiftCash >= endDayCashTiers.megaCap
            ? (0.04 + Math.random() * 0.04)
            : (endShiftCash >= endDayCashTiers.highCap ? (0.025 + Math.random() * 0.025) : (0.015 + Math.random() * 0.015));
          const maxNightCap = endShiftCash >= endDayCashTiers.megaCap ? 1500000000 : (endShiftCash >= endDayCashTiers.highCap ? 600000000 : 250000000);
          let nightLoss = Math.round((endShiftCash * nightPct) / 100000) * 100000;
          if(equipRedEnd > 0) nightLoss = Math.round(nightLoss * (1 - equipRedEnd));
          nightLoss = Math.max(5000000, Math.min(maxNightCap, nightLoss));
          if(nightLoss > 0 && S.money > nightLoss){
            S.money -= nightLoss;
            r.snatchLoss = (r.snatchLoss || 0) + nightLoss;
            if(R && R.today){
              R.today.snatchLoss = (R.today.snatchLoss || 0) + nightLoss;
              R.today.snatchCount = (R.today.snatchCount || 0) + 1;
            }
            setTimeout(() => {
              toast(`⚠️ CẢNH BÁO TRỘM ĐÊM (${fmt(endShiftCash)}): Để nhiều tiền mặt tại quầy qua đêm khiến kẻ gian cạy két lấy mất ${fmt(nightLoss)}! Hãy gửi tiền vào Tà Tưa Bank! 🏦`, 7500, 1);
            }, 900);
          }
        }
      }
    }
  }
