  const ingTot=Object.values(r.ing||{}).reduce((a,x)=>a+(x.v||0),0);
  const eqTot=Array.isArray(r.equip)?r.equip.reduce((a,x)=>a+(x&&x.v?Number(x.v)||0:0),0):0;
  S.history.push(r);if(S.history.length>400)S.history.shift();
  S.historyLengthTotal = Math.max(Number(S.historyLengthTotal) || 0, Number(S.day) || 1, S.history.length);
  S.totalProfit = calcTotalProfit();
  const dayOpCost = (r.rent||0) + (r.util||0) + (r.wage||0) + (r.bad||0) + (r.loanInt||0) + (r.fee||0) + (r.tax||0) + (r.ga||0) + (r.franchiseTax||0) + (r.franchiseSupport||0) + (r.cloud||0) + (r.gzStolen||0) + (r.fakeLoss||0) + (r.snatchLoss||0) + (r.svPawnedLoss||0) + (r.buyerStolen||0) + (r.partyPenalty||0) + branchRentTotal + branchWageTotal + branchIngTotal + ingTot + eqTot;
  broke = S.money < 0;
  if(broke && !hoardBankruptFreeze && S.bank && (S.bank.balance || 0) > 0){
    const needed = Math.abs(S.money);
    const withdrawAmt = Math.min(S.bank.balance, needed);
    S.money += withdrawAmt;
    S.bank.balance -= withdrawAmt;
    S.bank.principal = Math.max(0, Math.min(S.bank.principal || 0, S.bank.balance));
    if(S.bank.balance <= 0){
      S.bank.balance = 0;
      S.bank.principal = 0;
      S.bank.daysPassed = 0;
      toast(`🏦 Tà Tưa Bank: Két âm tiền! Đã tự động giải ngân ${fmt(withdrawAmt)} tiền gửi tiết kiệm để cứu tiệm thoát khỏi phá sản! 🛡️`, 6000, 1);
    } else {
      toast(`🏦 Tà Tưa Bank: Két âm tiền! Đã trích ${fmt(withdrawAmt)} từ tiền tiết kiệm cứu nguy két (Số dư tiết kiệm còn ${fmt(S.bank.balance)}, tiến độ ${S.bank.daysPassed || 0}/${S.bank.termDays || 7} ngày vẫn được bảo lưu)! 🛡️`, 6000, 1);
    }
    broke = S.money < 0;
  }
