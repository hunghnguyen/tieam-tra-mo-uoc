window.initSafeRecovery = function() {
  try {
    if (typeof fresh === 'function' && (!window.S || !window.S.day)) window.S = fresh();
    if (typeof renderPrep === 'function') renderPrep();
    if (typeof head === 'function') head();
    const sp = document.getElementById('splash');
