const GAME_VERSION = '12.47.592';
const IMG = 'img/';
function ico(n,c){if(n==='trend'||n==='radar')return `<span class="ico${c?' '+c:''}" style="display:inline-grid;place-items:center;font-size:18px;line-height:1;">🔥</span>`;if(n==='crush'||n==='candy')return `<span class="ico${c?' '+c:''}" style="display:inline-grid;place-items:center;font-size:18px;line-height:1;">🍬</span>`;if(n==='shop')return `<span class="ico${c?' '+c:''}" style="display:inline-grid;place-items:center;font-size:18px;line-height:1;">🏢</span>`;if(n==='sanhtra'||n==='lobby')return `<span class="ico${c?' '+c:''}" style="display:inline-grid;place-items:center;font-size:18px;line-height:1;">🏮</span>`;if(n==='cat')return `<img class="ico${c?' '+c:''}" src="img/ic_cat.png?v=${GAME_VERSION}" alt="🐱" decoding="async">`;if(n==='dog'||n==='pet')return `<img class="ico${c?' '+c:''}" src="img/ic_dog.png?v=${GAME_VERSION}" alt="🐕" decoding="async">`;if(n==='kpi')return `<img class="ico${c?' '+c:''}" src="img/ic_trophy.png?v=${GAME_VERSION}" alt="🏆" decoding="async">`;if(n==='vuon'||n==='garden'||n==='plant')return `<span class="ico${c?' '+c:''}" style="display:inline-grid;place-items:center;font-size:18px;line-height:1;">🪴</span>`;if(n==='map'||n==='globe'||n==='khoinghiep')return `<span class="ico${c?' '+c:''}" style="display:inline-grid;place-items:center;font-size:18px;line-height:1;">🗺️</span>`;return `<img class="ico${c?' '+c:''}" src="img/ic_${n}.png?v=${GAME_VERSION}" alt="" decoding="async">`}

/* Trợ thủ xử lý Emoji & Regex an toàn tuyệt đối cho iOS WebKit & Safari cũ (tránh lỗi cú pháp Parse-time) */
function safeStripEmoji(t){
  if(!t) return '';
  try {
    return t.replace(new RegExp('\\p{Extended_Pictographic}|\\uFE0F', 'gu'), '').trim();
  } catch(e) {
    return t.replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\uFE0F]/gu, '').trim();
  }
}
function safeHasEmoji(t){
  if(!t) return false;
  try {
    return new RegExp('\\p{Extended_Pictographic}', 'u').test(t);
  } catch(e) {
    return /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/u.test(t);
  }
}
function safeMatchTrailingEmoji(t){
  if(!t) return '';
  try {
    const m = t.match(new RegExp('\\p{Extended_Pictographic}+$', 'u'));
    return m ? m[0] : '';
  } catch(e) {
    const m = t.match(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]+$/u);
    return m ? m[0] : '';
  }
}


