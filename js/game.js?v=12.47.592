      <div style="background:#f0fdf4;border:1px solid #bbf7d0;padding:10px 12px;border-radius:8px;margin:8px 0;font-size:0.84rem;color:#166534;line-height:1.55;text-align:left;">
        📅 <b>Thời hạn nộp đơn báo trước: ${noticeDays} ngày</b><br>
        • Nhân viên <b>vẫn đi làm bình thường và hoàn thành hết ca</b> trong <b>${noticeDays} ngày</b> tới để sếp có thời gian sắp xếp nhân sự.<br>
        • Ngày chính thức rời tiệm: <b>Ngày ${quitDay}</b> (kết thúc ca Ngày ${quitDay - 1}).
      </div>
      <p style="font-size:0.82rem;color:#64748b;margin-top:6px;">
        💡 Chủ tiệm hãy tranh thủ tuyển nhân viên mới tại mục <b>Nâng cấp</b> hoặc <b>KPI</b> trước Ngày ${quitDay}.
      </p>
    `, [['Tiếp nhận đơn & Mở quán bán', onProceed, 1]]);
    return;
  }

  if(excuse.type === 'demand_wage' || excuse.type === 'borrow'){
    const amt = excuse.amt || 100000;
    const canPay = S.money >= amt;
    const isDemand = excuse.type === 'demand_wage';
    const title = isDemand ? 'NHÂN VIÊN ĐÒI TĂNG LƯƠNG / THƯỞNG!' : 'NHÂN VIÊN VÒI TIỀN TẠM ỨNG!';
    const icon = isDemand ? '💸' : '🤲';

    ask(`
      <div class="pbig">${icon}</div>
      <h2 style="color:#d97706;margin:4px 0 8px;">${title}</h2>
      <div style="background:#fffbeb;border-left:4px solid #f59e0b;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        👤 <b>${staffName}</b> (${st.n}):<br>
        <i>"${excuse.txt}"</i>
      </div>
      <div style="font-size:0.84rem;color:#64748b;margin-bottom:8px;">
        Số tiền yêu cầu: <b style="color:#dc2626;">-${fmt(amt)}</b> (Két quán hiện có: <b>${fmt(S.money)}</b>)
      </div>
    `, [
      [canPay ? `Duyệt chi (-${fmt(amt)})` : 'Két không đủ tiền', () => {
        if(!canPay){
          toast('Két quán không đủ tiền chi!');
          R.staffDramaBuff[st.id] = -0.20;
          toast(excuse.rejectMsg, 4000);
          return onProceed();
        }
        S.money -= amt;
        S.cur.wage = (S.cur.wage || 0) + amt;
        R.staffDramaBuff[st.id] = 0.25;
        save();
        head();
        toast(excuse.acceptMsg, 4000);
        onProceed();
      }, canPay ? 1 : 0],
      ['Từ chối thẳng thừng', () => {
        if(excuse.reason === 'Đóng tiền trọ gấp kẻo bị đuổi'){
          if(st.id !== 'staffOn'){
            R.staffLate[st.id] = excuse;
          } else {
            R.staffDramaBuff[st.id] = -0.20;
          }
        } else {
          R.staffDramaBuff[st.id] = -0.25;
        }
        toast(excuse.rejectMsg, 4000);
        onProceed();
      }]
    ]);
    return;
  }

  if(excuse.type === 'off' || (st.id === 'staffOn' && excuse.type === 'late')){
    // ĐẶC BIỆT: VỚI NHÂN VIÊN ONLINE, NGHỈ PHẢI BÁO TRƯỚC 1 NGÀY VÀ LÀM HẾT CA HÔM ĐÓ!
    if(st.id === 'staffOn'){
      S.staffOnLeaveNotice = {
        submittedDay: S.day,
        leaveDay: S.day + 1,
        reason: excuse.reason || excuse.txt,
        txt: excuse.txt,
        icon: excuse.icon || '📱'
      };
      save();
      ask(`
        <div class="pbig">${excuse.icon || '📱'}</div>
        <h2 style="color:#0284c7;margin:4px 0 8px;">ĐƠN XIN NGHỈ PHÉP BÁO TRƯỚC 1 NGÀY!</h2>
        <div style="background:#f0f9ff;border-left:4px solid #0284c7;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
          👤 <b>${staffName}</b> (Nhân viên đơn online):<br>
          <i>"Sếp ơi, ngày mai em có việc bận riêng (${excuse.txt}), theo nội quy tiệm em xin nộp đơn báo trước 1 ngày ạ! <b>Hôm nay em vẫn đi làm và xử lý hết ca làm trọn vẹn toàn bộ các đơn online</b>, không để sót đơn nào. Ngày mai sếp duyệt cho em nghỉ 1 ca nhé!"</i>
        </div>
        <div style="background:#f0fdf4;border:1px solid #bbf7d0;padding:10px 12px;border-radius:8px;margin:8px 0;font-size:0.84rem;color:#166534;line-height:1.55;text-align:left;">
          • <b>Ca hôm nay (Ngày ${S.day}):</b> Nhân viên online <b>vẫn làm việc đến hết ca hôm nay</b>, xử lý đầy đủ toàn bộ đơn online Soppi, Táp Táp, Biiiii, Gờ Ráp.<br>
          • <b>Ca ngày mai (Ngày ${S.day + 1}):</b> Nhân viên online sẽ được nghỉ phép 1 ca theo đúng đơn báo trước.
        </div>
        <p style="font-size:0.82rem;color:#64748b;margin-top:6px;">
          💡 Chủ tiệm yên tâm mở bán, ca hôm nay mọi đơn online đều được xử lý mượt mà!
        </p>
      `, [['Duyệt đơn & Mở quán bán', onProceed, 1]]);
      return;
    }

    // Các nhân viên khác: nghỉ phép đột xuất trong ngày
    R.staffDayOff[st.id] = excuse;
    S.staffOffDay = S.staffOffDay || {};
    S.staffOffDay[st.id] = S.day;
    if(st.id === 'staffGz'){
      R.gzWork = null;
      R.gzSulking = false;
      clearStaffPouring();
      if(cup && cup.used && cup.staff) cup = newCup();
    }
    save();
    ask(`
      <div class="pbig">${excuse.icon}</div>
      <h2 style="color:#c2410c;margin:4px 0 8px;">ĐƠN XIN NGHỈ PHÉP ĐỘT XUẤT!</h2>
      <div style="background:#fff7ed;border-left:4px solid #ea580c;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        👤 <b>${staffName}</b> (${st.n}):<br>
        <i>"Sếp ơi cho em xin nghỉ phép hôm nay vì ${excuse.txt}"</i>
      </div>
      <p style="font-size:0.82rem;color:#64748b;">
        💡 Hôm nay bạn này nghỉ (không tính lương ca này). Chủ tiệm tự tay làm thay nhé!
      </p>
    `, [['Duyệt đơn & Mở quán bán', onProceed, 1]]);
    return;
  }

  if(excuse.type === 'late'){
    R.staffLate[st.id] = excuse;
    ask(`
      <div class="pbig">${excuse.icon}</div>
      <h2 style="color:#d97706;margin:4px 0 8px;">TIN NHẮN XIN ĐẾN TRỄ NỬA CA!</h2>
      <div style="background:#fffbeb;border-left:4px solid #f59e0b;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        👤 <b>${staffName}</b> (${st.n}):<br>
        <i>"Sếp ơi em xin đến trễ nửa ca vì ${excuse.txt}"</i>
      </div>
      <p style="font-size:0.82rem;color:#64748b;">
        💡 Nửa ca đầu chủ tiệm tự làm nhé, đến giữa ca nhân viên sẽ chạy đến quầy hỗ trợ!
      </p>
    `, [['Duyệt đơn & Bắt đầu bán', onProceed, 1]]);
    return;
  }

  return onProceed();
  } catch(err) {
    console.error('Lỗi checkStaffExcuses:', err);
    return onProceed();
  }
}

function tryOpen(){
  try {
    const miss=missingPrep();
    if(miss.length){R.tab='kho';R.sub=R.sub||{};R.sub.kho=miss[0][1];renderPrep();toast(ico('warn')+' Chưa nấu: '+miss.map(m=>m[0]).join(', '));return}
    checkMktAutoPayTax();

    // Quản gia tự động quyết toán & trả thưởng KPI chu đáo nếu đến hạn kỳ 7 ngày
    if(typeof isStaffActive === 'function' && isStaffActive('staffButler') && (S.staffSalesDays || 0) >= 7){
      try { staffButlerAutoPayMaxKpi(); } catch(e) { console.error('Butler auto kpi pay error:', e); }
    }

    // Cảnh báo dự báo sức khỏe thú cưng trước khi mở bán
    if (S && S.pet && S.pet.unlocked) {
      if(typeof isStaffActive === 'function' && isStaffActive('staffButler') && typeof staffButlerAutoPetCare === 'function'){
        try { staffButlerAutoPetCare(); } catch(e) { console.error('Butler auto pet care error:', e); }
      }
      if(typeof getPetHealthForecast === 'function'){
        const fc = getPetHealthForecast();
        if (fc && fc.isCritical) {
          if(typeof isStaffActive === 'function' && isStaffActive('staffButler')){
            // Quản gia đã tự động chăm sóc thú cưng đầy đủ
          } else {
            ask(`
              <div class="pbig">🚨</div>
              <h2 style="color:#dc2626;margin:4px 0 8px;">CẢNH BÁO NGUY HIỂM: THÚ CƯNG SẮP BỎ ĐI!</h2>
              <div style="background:#fef2f2;border:1.5px solid #fecaca;padding:12px 14px;border-radius:10px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#991b1b;text-align:left;">
                ⚠️ <b>${esc(fc.petName || (S && S.pet && (S.pet.name || S.pet.dogName || S.pet.catName)) || 'Bé Cưng')}</b> đang ở mức <b>BÁO ĐỘNG ĐỎ</b>!<br>
                Nếu mở ca bán ngay bây giờ, <b>ít nhất 2 chỉ số sẽ giảm về 0%</b> sau ca làm việc này và bé sẽ <b>bỏ nhà đi mất tích</b>!
                <div style="margin-top:8px;padding:8px 10px;background:#fee2e2;border-radius:8px;font-size:0.84rem;color:#7f1d1d;line-height:1.5;">
                  ${fc.stats.filter(s => s.runsOutNextShift).map(s => `• <b>${s.name}</b>: Hiện còn <b>${s.cur != null ? s.cur : s.val}%</b> / ${s.max || fc.maxS || 100}% (Sụt <b>−${s.decay}%/ca</b> → Về <b>0%</b> sau ca này!)`).join('<br>')}
                </div>
              </div>
              <p style="font-size:0.84rem;color:#475569;margin-top:6px;">
                Hãy vào phòng Thú Cưng để chăm sóc bé (cho ăn, tắm rửa, chơi đùa hoặc ngủ) trước khi mở quán để giữ chân bé nhé!
              </p>
            `, [
              ['Vào chăm thú cưng ngay (Khuyên dùng)', () => { switchTab('thucung'); }, 1],
              ['Vẫn bất chấp mở bán', () => {
                checkStaffExcuses(() => {
                  startDay();
                });
              }]
            ]);
            return;
          }
        } else if (fc && fc.isEmergency) {
          toast('⚠️ Cảnh báo: Chỉ số thú cưng sắp cạn! Hãy chú ý chăm sóc bé.', 4000);
        }
      }
    }

    checkStaffExcuses(() => {
      startDay();
    });
  } catch(err) {
    console.error('Lỗi tryOpen, cưỡng chế bắt đầu ngày mới:', err);
    try {
      startDay();
    } catch(e) {
      console.error('Lỗi startDay fallback:', e);
    }
  }
}

/* ---------- TAB ĐÓNG THUẾ TRỰC TUYẾN 72H THEO THỜI GIAN THỰC ---------- */
function paneThue(){
  initTaxState();
  initBankState();
  checkMktAutoPayTax();
  checkTaxBankPenalty();
  const p = $('pane');
  if(!p) return;

  const isActive = isTaxActive();
  const isOverdue = isTaxOverdue();
  const money = S.money || 0;

  if(!window._selectedTaxPct || window._selectedTaxPct < 5 || window._selectedTaxPct > 15) window._selectedTaxPct = 15;
  const pct = Math.max(5, Math.min(15, window._selectedTaxPct));
  const taxAmount = Math.round(money * (pct / 100));

  const hasMkt = !!(S.upg && S.upg.staffMkt);
  let statusHTML = '';
  if(hasMkt){
    if(isActive){
      const rem = S.tax.expiresAt - Date.now();
      statusHTML = `
        <div class="tax-status-box active" style="border-left:5px solid #10b981;background:linear-gradient(135deg,rgba(16,185,129,0.1),rgba(5,150,105,0.05));">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
            <div style="font-weight:900;font-size:1.02rem;color:#065f46;">🟢 BUFF THUẾ ME KÉT TINH (ĐANG HOẠT ĐỘNG)</div>
            <div id="taxCountdownLive" class="tax-timer-badge active">⏳ Thời gian tồn tại buff thuế: ${formatTaxTime(rem)}</div>
          </div>
          <div style="margin-top:6px;font-size:0.86rem;line-height:1.45;color:#047857;">
            Đã thuê nhân viên <b>Me Két Tinh</b>: Quán không bị giảm thời gian đóng thuế hay bị tính nợ thuế, chuyển thành <b>thời gian tồn tại buff thuế là 72h</b> (+${Math.round((S.tax.rate || 0.15) * 100)}% toàn diện) và tự động trích két duy trì liên tục!
          </div>
          <div class="tax-buff-grid">
            <div class="tax-buff-item">📈 <b>+${Math.round((S.tax.rate || 0.15) * 100)}% Khách ghé quán</b><br><small style="color:#64748b;">Uy tín thương hiệu minh bạch</small></div>
            <div class="tax-buff-item">⚡ <b>+${Math.round((S.tax.rate || 0.15) * 100)}% Tốc độ làm việc</b><br><small style="color:#64748b;">Nhân viên an tâm, hăng say</small></div>
            <div class="tax-buff-item">🛡️ <b>Giảm ${Math.round((S.tax.rate || 0.15) * 100)}% Trộm &amp; lừa đảo</b><br><small style="color:#64748b;">Hạn chế bùng tiền &amp; tiền giả</small></div>
            <div class="tax-buff-item">💎 <b>+${Math.round((S.tax.rate || 0.15) * 100)}% Tỉ lệ x2 bill</b><br><small style="color:#64748b;">Khách sộp nhân đôi tiền nước</small></div>
          </div>
        </div>
      `;
    } else {
      statusHTML = `
        <div class="tax-status-box grace" style="border-left:5px solid #f59e0b;">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
            <div style="font-weight:900;font-size:1.02rem;color:#b45309;">🟡 BUFF THUẾ 72H CHƯA KÍCH HOẠT</div>
            <div id="taxCountdownLive" class="tax-timer-badge grace">⏳ Thời gian tồn tại buff thuế: 00:00:00</div>
          </div>
          <div style="margin-top:6px;font-size:0.86rem;line-height:1.45;color:#78350f;">
            Đã có Me Két Tinh bảo lãnh thuế (quán không bao giờ bị phạt nợ thuế). Đóng thuế để kích hoạt <b>72h thời gian tồn tại buff thuế</b>, Me Két Tinh sẽ tự động trích 15% duy trì liên tục cho các chu kỳ tiếp theo!
          </div>
        </div>
      `;
    }
  } else if(isActive){
    const rem = S.tax.expiresAt - Date.now();
    statusHTML = `
      <div class="tax-status-box active">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
          <div style="font-weight:900;font-size:1.02rem;">🟢 ĐÃ ĐÓNG THUẾ HỢP LỆ — ĐANG ĐƯỢC BẢO HỘ 72H (3 NGÀY THỰC)</div>
          <div id="taxCountdownLive" class="tax-timer-badge active">⏳ Hiệu lực bảo hộ còn: ${formatTaxTime(rem)}</div>
        </div>
        <div style="margin-top:6px;font-size:0.86rem;line-height:1.45;">
          Quán đã đóng thuế đầy đủ mức <b>${Math.round((S.tax.rate || 0.15) * 100)}%</b> (${fmt(S.tax.amount || 0)}). Quán đang nhận được các đặc quyền bảo trợ:
        </div>
        <div class="tax-buff-grid">
          <div class="tax-buff-item">📈 <b>+${Math.round((S.tax.rate || 0.15) * 100)}% Khách ghé quán</b><br><small style="color:#64748b;">Uy tín thương hiệu minh bạch</small></div>
          <div class="tax-buff-item">⚡ <b>+${Math.round((S.tax.rate || 0.15) * 100)}% Tốc độ làm việc</b><br><small style="color:#64748b;">Nhân viên an tâm, hăng say</small></div>
          <div class="tax-buff-item">🛡️ <b>Giảm ${Math.round((S.tax.rate || 0.15) * 100)}% Trộm &amp; lừa đảo</b><br><small style="color:#64748b;">Hạn chế bùng tiền &amp; tiền giả</small></div>
          <div class="tax-buff-item">💎 <b>+${Math.round((S.tax.rate || 0.15) * 100)}% Tỉ lệ x2 bill</b><br><small style="color:#64748b;">Khách sộp nhân đôi tiền nước</small></div>
        </div>
      </div>
    `;
  } else if(isOverdue){
    const over = Date.now() - S.tax.expiresAt;
    statusHTML = `
      <div class="tax-status-box overdue">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
          <div style="font-weight:900;font-size:1.02rem;color:#991b1b;">🔴 ⚠️ ĐÃ QUÁ HẠN 72H CHƯA ĐÓNG THUẾ (NỢ THUẾ)</div>
          <div id="taxCountdownLive" class="tax-timer-badge overdue">⚠️ ĐÃ QUÁ HẠN: ${formatTaxTime(over)}</div>
        </div>
        <div style="margin-top:6px;font-size:0.86rem;line-height:1.45;">
          Quán đã quá hạn 72h (3 ngày thực) đóng thuế trực tuyến! Đang chịu hình thức xử phạt cảnh cáo và giám sát nghiêm ngặt:
        </div>
        <div class="tax-buff-grid">
          <div class="tax-buff-item" style="color:#991b1b;">🚨 <b>Tăng 150% Tiền giả &amp; Trộm cắp</b><br><small>Dễ bị bùng tiền, lừa đảo két</small></div>
          <div class="tax-buff-item" style="color:#991b1b;">😤 <b>Khách hàng khó chịu</b><br><small>Khách khó tính, dễ mất kiên nhẫn</small></div>
          <div class="tax-buff-item" style="color:#991b1b;">💔 <b>Nhân viên bất mãn</b><br><small>Giảm 20% tốc độ, dễ đình công</small></div>
        </div>
      </div>
    `;
  } else {
    statusHTML = `
      <div class="tax-status-box grace">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
          <div style="font-weight:900;font-size:1.02rem;">🟡 ĐANG TRONG THỜI GIAN ÂN HẠN 72H (3 NGÀY THỰC)</div>
          <div id="taxCountdownLive" class="tax-timer-badge grace">⏳ Hạn chót: ${formatTaxTime(S.tax.expiresAt - Date.now())}</div>
        </div>
        <div style="margin-top:6px;font-size:0.86rem;line-height:1.45;">
          Hãy hoàn thành đóng thuế trực tuyến để nhận ngay Buff phát triển và bảo vệ an ninh quán!
        </div>
      </div>
    `;
  }

  const quickPills = [5, 8, 10, 12, 15].map(val => `
    <button type="button" class="tax-pct-pill ${pct === val ? 'on' : ''}" data-tax-pct="${val}">
      ${val}% ${val === 5 ? '(Tối thiểu)' : val === 15 ? '(Tối đa)' : ''}
    </button>
  `).join('');

  const bankBal = (S.bank && S.bank.balance) || 0;
  const bankPrin = (S.bank && S.bank.principal) || 0;
  const bankCap = (S.bank && S.bank.cap) || 10000000;
  const bankTerm = (S.bank && S.bank.termDays) || 7;
  const bankDays = (S.bank && S.bank.daysPassed) || 0;
  const bankGain = Math.max(0, bankBal - bankPrin);

  p.innerHTML = `
    <div class="tax-pane-wrap">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:24px;">🏛️</span>
        <div>
          <h2 style="font-weight:900;font-size:1.15rem;margin:0;color:var(--ink);">ĐÓNG THUẾ TRỰC TUYẾN 72H (3 NGÀY THỰC)</h2>
          <div style="font-size:0.82rem;color:var(--soft);">Đóng thuế mỗi 3 ngày thực tế (72 giờ) để nhận Buff toàn diện &amp; phòng ngừa trộm cắp</div>
        </div>
      </div>

      ${statusHTML}

      <div class="tax-slider-card">
        <div style="font-weight:800;font-size:0.95rem;color:var(--ink);margin-bottom:4px;">
          💰 Chọn mức đóng thuế theo số tiền két hiện có
        </div>
        <div style="font-size:0.85rem;color:var(--soft);margin-bottom:10px;">
          Két hiện có: <b style="color:#059669;font-size:0.95rem;">${fmt(money)}</b> · Mức thuế quy định từ <b>5% đến 15%</b>.
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
          <span style="font-size:0.88rem;font-weight:700;">Tỉ lệ đóng thuế:</span>
          <span id="taxSelectedPct" style="font-size:1.1rem;font-weight:900;color:var(--pink);">${pct}%</span>
        </div>

        <input type="range" id="taxRangeIn" class="tax-range-input" min="5" max="15" step="1" value="${pct}" ${isActive ? 'disabled style="opacity:0.5;cursor:not-allowed;"' : ''}>

        <div class="tax-pills">${quickPills}</div>

        <div style="background:var(--bg);border-radius:12px;padding:12px;margin:10px 0;display:flex;justify-content:space-between;align-items:center;">
          <div>
            <div style="font-size:0.82rem;color:var(--soft);">Số tiền thuế cần nộp:</div>
            <div id="taxSelectedAmt" style="font-size:1.35rem;font-weight:900;color:#d97706;">${fmt(taxAmount)}</div>
          </div>
          <div style="text-align:right;">
            <div style="font-size:0.82rem;color:var(--soft);">Quyền lợi nhận được:</div>
            <div style="font-size:1.05rem;font-weight:800;color:#16a34a;">Buff +<span id="taxBuffVal">${pct}</span>% / 72h</div>
          </div>
        </div>

        <button type="button" id="btnPayTax" class="big pri" ${isActive ? 'disabled style="width:100%;padding:12px;font-size:0.92rem;font-weight:800;border-radius:12px;cursor:not-allowed;opacity:0.85;background:#15803d;color:#fff;"' : 'style="width:100%;padding:12px;font-size:1rem;font-weight:800;border-radius:12px;cursor:pointer;"'}>
          ${isActive 
            ? (hasMkt 
                ? `⚡ THỜI GIAN TỒN TẠI BUFF THUẾ CÒN: ${formatTaxTime(Math.max(0, S.tax.expiresAt - Date.now()))} (TỰ ĐỘNG GIA HẠN)`
                : `✅ ĐÃ ĐÓNG THUẾ HỢP LỆ (${formatTaxTime(Math.max(0, S.tax.expiresAt - Date.now()))}) — HẾT 72H ĐÓNG CHU KỲ MỚI`)
            : isOverdue 
            ? `⚠️ NỘP THUẾ CHU KỲ MỚI NGAY (${fmt(taxAmount)} · Buff +${pct}%)` 
            : (hasMkt 
                ? `⚡ KÍCH HOẠT THỜI GIAN TỒN TẠI BUFF THUẾ 72H (${fmt(taxAmount)} · Buff +${pct}%)`
                : `🏛️ Nộp thuế ngay (${fmt(taxAmount)} · Buff +${pct}%)`)
          }
        </button>
      </div>

      <!-- TÀ TƯA BANK (PRIVATE BANKING AN TOÀN, TỐI ĐA 1.000 TỶ) -->
      ${(() => {
        const tierInfo = getBankTierInfo(S.star5Count);
        return `
        <div class="tatua-bank-card" style="background:linear-gradient(135deg,${tierInfo.color} 0%,#047857 100%);color:#fff;border-radius:14px;padding:14px;margin-top:12px;box-shadow:0 6px 18px rgba(4,120,87,0.22);border:1px solid rgba(255,255,255,0.15);">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;border-bottom:1px solid rgba(255,255,255,0.18);padding-bottom:10px;margin-bottom:10px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:28px;">🏦</span>
              <div>
                <div style="font-size:0.75rem;letter-spacing:0.5px;text-transform:uppercase;color:${tierInfo.badgeColor};font-weight:800;">${tierInfo.icon} ${tierInfo.name.toUpperCase()}</div>
                <h3 style="margin:0;font-size:1.15rem;font-weight:900;color:#fff;">NGÂN HÀNG TÀ TƯA BANK</h3>
              </div>
            </div>
            <div style="background:rgba(255,255,255,0.18);padding:4px 10px;border-radius:20px;font-size:0.78rem;font-weight:800;color:#ecfdf5;display:flex;align-items:center;gap:5px;">
              <span>🛡️ LÃI KÉP ${(getBankDailyRate(bankTerm)*100).toFixed(1)}% / NGÀY</span>
            </div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
            <div style="background:rgba(0,0,0,0.18);border-radius:10px;padding:10px;">
              <div style="font-size:0.75rem;color:#a7f3d0;margin-bottom:2px;">💰 Tiền gửi hiện tại:</div>
              <div style="font-size:1.25rem;font-weight:900;color:#fef08a;">${fmt(bankBal)}</div>
              <div style="font-size:0.72rem;color:#d1fae5;margin-top:2px;">(Gốc: ${fmt(bankPrin)}${bankGain>0?` · Lãi: +${fmt(bankGain)}`:''})</div>
            </div>
            <div style="background:rgba(0,0,0,0.18);border-radius:10px;padding:10px;">
              <div style="font-size:0.75rem;color:#a7f3d0;margin-bottom:2px;">📈 Hạn mức gửi tối đa:</div>
              <div style="font-size:1.1rem;font-weight:900;color:#fff;">${fmt(bankCap)}</div>
              <div style="font-size:0.72rem;color:#a7f3d0;margin-top:2px;">(${tierInfo.desc})</div>
            </div>
          </div>

          <div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:9px 12px;font-size:0.8rem;line-height:1.45;margin-bottom:12px;color:#f0fdf4;">
            <div style="display:flex;justify-content:space-between;margin-bottom:3px;">
              <span>⏳ Kỳ hạn cam kết: <b>${bankTerm} ngày bán nước</b> (${(getBankDailyRate(bankTerm)*100).toFixed(1)}%/ngày)</span>
              <span>Tiến độ: <b style="color:#fef08a;">${bankDays}/${bankTerm} ngày</b></span>
            </div>
            <div style="font-size:0.74rem;color:#cbd5e1;">
              🔒 <b>Đặc quyền:</b> Tiền gửi tuyệt đối không bị trộm cắp, bùng tiền hay lừa đảo két.<br>
              ⚠️ <b>Cảnh báo:</b> Rút trước hạn mất sạch lãi suất. Quá hạn đóng thuế 72h sẽ tạm ngưng tính lãi kép cho đến khi nộp thuế (tiền gửi vẫn được bảo toàn nguyên vẹn 100%).
            </div>
          </div>

          <div style="display:flex;gap:8px;">
            <button type="button" id="btnBankDeposit" class="sbtn" style="flex:1;background:#f59e0b;color:#78350f;padding:10px;font-weight:900;font-size:0.9rem;border-radius:10px;border:none;cursor:pointer;">
              ➕ Gửi tiết kiệm
            </button>
            <button type="button" id="btnBankWithdraw" class="sbtn" style="flex:1;background:rgba(255,255,255,0.22);color:#fff;padding:10px;font-weight:900;font-size:0.9rem;border-radius:10px;border:1px solid rgba(255,255,255,0.3);cursor:pointer;">
              💸 Rút tiền
            </button>
          </div>
        </div>
        `;
      })()}

      <!-- BẤT ĐỘNG SẢN: MUA ĐỨT TRỤ SỞ QUÁN CHÍNH FLAGSHIP -->
      ${(S.realEstate && S.realEstate.main) ? `
        <div class="real-estate-flagship-card" style="background:linear-gradient(135deg,#78350f 0%,#b45309 100%);color:#fff;border-radius:14px;padding:14px;margin-top:12px;box-shadow:0 6px 18px rgba(180,83,9,0.25);border:1px solid rgba(255,255,255,0.2);">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:28px;">🏰</span>
              <div>
                <div style="font-size:0.75rem;letter-spacing:0.5px;text-transform:uppercase;color:#fef08a;font-weight:800;">BẤT ĐỘNG SẢN CHÍNH CHỦ · SỔ ĐỎ VĨNH VIỄN</div>
                <h3 style="margin:0;font-size:1.12rem;font-weight:900;color:#fff;">TRỤ SỞ QUÁN CHÍNH FLAGSHIP (ĐÃ MUA ĐỨT)</h3>
              </div>
            </div>
            <span style="background:#22c55e;color:#fff;padding:4px 10px;border-radius:20px;font-size:0.78rem;font-weight:800;">✓ SỔ ĐỎ HOÀN TẤT</span>
          </div>
          <div style="margin-top:8px;font-size:0.82rem;line-height:1.45;color:#fef3c7;">
            🎉 <b>Đặc quyền tối thượng:</b> Triệt tiêu vĩnh viễn 100% tiền thuê mặt bằng và tiền điện nước cố định mỗi ngày (0đ/ngày). Bảo đảm an ninh két tối đa!
          </div>
        </div>
      ` : `
        <div class="real-estate-flagship-card" style="background:#fff;border:1.5px solid #d97706;border-radius:14px;padding:14px;margin-top:12px;box-shadow:0 4px 14px rgba(217,119,6,0.12);">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="font-size:28px;">🏰</span>
              <div>
                <div style="font-size:0.75rem;letter-spacing:0.5px;text-transform:uppercase;color:#d97706;font-weight:800;">KÊNH ĐẦU TƯ BẤT ĐỘNG SẢN LATE-GAME</div>
                <h3 style="margin:0;font-size:1.12rem;font-weight:900;color:#78350f;">MUA ĐỨT TRỤ SỞ QUÁN CHÍNH (FLAGSHIP)</h3>
              </div>
            </div>
            <span style="background:#fef3c7;color:#92400e;padding:4px 10px;border-radius:20px;font-size:0.78rem;font-weight:800;">50 TỈ + 200⭐</span>
          </div>
          <div style="margin:8px 0;font-size:0.82rem;line-height:1.45;color:#475569;">
            Bỏ ra <b>50 Tỉ VNĐ</b> và <b>200 ⭐ Tích lũy</b> để mua đứt toàn bộ tòa nhà trụ sở quán chính: <b>Triệt tiêu vĩnh viễn 100% chi phí thuê nhà và điện nước</b> mỗi ca bán, giải phóng tiền mặt dư thừa!
          </div>
          <button type="button" id="btnBuyMainGround" class="sbtn pri" style="width:100%;padding:10px;font-weight:800;font-size:0.92rem;background:linear-gradient(135deg,#d97706,#b45309);border:none;border-radius:10px;cursor:pointer;" ${S.money < 50000000000 || (S.star5Count || 0) < 200 ? 'disabled style="opacity:0.6;cursor:not-allowed;"' : ''}>
            🏰 Mua đứt trụ sở chính (50 Tỉ VNĐ + 200⭐)
          </button>
        </div>
      `}

      <div style="background:var(--panel);border:1px dashed var(--line);border-radius:12px;padding:12px;font-size:0.84rem;color:var(--soft);line-height:1.5;margin-top:12px;">
        📜 <b>Chính sách thuế &amp; Thống kê tiệm:</b><br>
        • <b>Chu kỳ 72 giờ (3 ngày thực):</b> Thuế có hiệu lực trong đúng 72 giờ (3 ngày) thực tế. Hết 72h cần đóng chu kỳ mới (tối đa 72h, không cộng dồn).<br>
        • <b>Tỉ lệ Buff:</b> Đóng bao nhiêu % két thì nhận đúng bấy nhiêu % tăng khách, tăng tốc độ và giảm trộm cắp (tối đa 15%).<br>
        • <b>Nhân viên Me Két Tinh:</b> Khi đã thuê, quán không bị giảm thời gian đóng thuế 72h (không bao giờ bị phạt nợ thuế), chuyển thành thời gian tồn tại buff thuế là 72h và tự động trích 15% duy trì liên tục.<br>
        • <b>Tổng thuế đã nộp:</b> <b style="color:#059669;">${fmt(S.tax.totalPaid || 0)}</b> (đã nộp ${S.tax.payCount || 0} lần).
      </div>
    </div>
  `;

  // Start live timer
  if(window._taxLiveInterval) clearInterval(window._taxLiveInterval);
  window._taxLiveInterval = setInterval(() => {
    const el = $('taxCountdownLive');
    if(!el){ clearInterval(window._taxLiveInterval); return; }
    if(isTaxActive()){
      const rem = S.tax.expiresAt - Date.now();
      if(rem > 0){
        el.textContent = hasMkt 
          ? `⏳ Thời gian tồn tại buff thuế: ${formatTaxTime(rem)}` 
          : `⏳ Hiệu lực bảo hộ còn: ${formatTaxTime(rem)}`;
        const btn = $('btnPayTax');
        if(btn && btn.disabled){
          btn.textContent = hasMkt
            ? `⚡ THỜI GIAN TỒN TẠI BUFF THUẾ CÒN: ${formatTaxTime(rem)} (TỰ ĐỘNG GIA HẠN)`
            : `✅ ĐÃ ĐÓNG THUẾ HỢP LỆ (${formatTaxTime(rem)}) — HẾT 72H ĐÓNG CHU KỲ MỚI`;
        }
      } else {
        paneThue();
      }
    } else if(isTaxOverdue()){
      const over = Date.now() - S.tax.expiresAt;
      el.textContent = `⚠️ ĐÃ QUÁ HẠN: ${formatTaxTime(over)}`;
    }
  }, 1000);

  // Bind slider
  const rng = $('taxRangeIn');
  if(rng && !isActive){
    rng.oninput = () => onTaxSliderChange(+rng.value);
  }

  // Bind quick pills
  p.querySelectorAll('.tax-pct-pill').forEach(btn => {
    if(isActive){
      btn.style.opacity = '0.6';
      btn.style.cursor = 'not-allowed';
      btn.onclick = () => toast('Thuế đang có hiệu lực bảo hộ 72h! Hết 72h mới cần chọn lại mức đóng.');
    } else {
      btn.onclick = () => {
        const v = +btn.dataset.taxPct;
        if(rng) rng.value = v;
        onTaxSliderChange(v);
      };
    }
  });

  // Bind Pay button
  const payBtn = $('btnPayTax');
  if(payBtn && !isActive){
    payBtn.onclick = executePayTax;
  } else if(payBtn && isActive){
    payBtn.onclick = () => toast(`Thuế đang có hiệu lực bảo hộ (còn ${formatTaxTime(Math.max(0, S.tax.expiresAt - Date.now()))})! Hết 72h mới cần đóng chu kỳ mới (tối đa 72h).`);
  }

  // Bind Bank buttons
  const depBtn = $('btnBankDeposit');
  if(depBtn) depBtn.onclick = openBankDepositDlg;
  const withBtn = $('btnBankWithdraw');
  if(withBtn) withBtn.onclick = openBankWithdrawDlg;

  // Bind Real Estate button
  const buyMainBtn = $('btnBuyMainGround');
  if(buyMainBtn) buyMainBtn.onclick = buyMainGround;
}

function buyMainGround(){
  if(!S) return;
  if(!S.realEstate) S.realEstate = { main: false, branches: {} };
  if(S.realEstate.main){
    toast('Tiệm đã sở hữu sổ đỏ trụ sở Flagship này rồi!');
    return;
  }
  const costMoney = 50000000000;
  const costStar = 200;
  if(S.money < costMoney){
    toast(`Két không đủ 50 Tỉ VNĐ (Hiện có: ${fmt(S.money)})!`);
    return;
  }
  if((S.star5Count || 0) < costStar){
    toast(`Cần ít nhất 200 ⭐ Tích lũy (Hiện có: ${S.star5Count || 0}⭐)!`);
    return;
  }
  ask(`
    <div style="text-align:left;">
      <h3 style="margin:0 0 8px 0;color:#78350f;">🏰 MUA ĐỨT TRỤ SỞ QUÁN CHÍNH FLAGSHIP</h3>
      <p style="font-size:0.86rem;color:#334155;line-height:1.5;">
        Bạn có chắc chắn muốn bỏ ra <b>50 Tỉ VNĐ</b> và <b>200 ⭐ Tích lũy</b> để mua đứt quyền sở hữu vĩnh viễn tòa nhà trụ sở không?<br><br>
        ✅ <b>Quyền lợi vĩnh viễn:</b><br>
        • Miễn phí 100% tiền thuê mặt bằng quán chính (0đ/ngày).<br>
        • Miễn phí 100% tiền điện nước cố định mỗi ca bán.<br>
        • Nhận huy hiệu độc quyền <b>Chủ Tòa Nhà Flagship</b>.
      </p>
    </div>
  `, [
    ['Xác nhận mua đứt (50 Tỉ + 200⭐)', () => {
      if(S.money < costMoney || (S.star5Count || 0) < costStar) return toast('Không đủ điều kiện!');
      S.money -= costMoney;
      S.star5Count = Math.max(0, (S.star5Count || 0) - costStar);
      S.realEstate.main = true;
      S.cur.equip = S.cur.equip || [];
      S.cur.equip.push({ n: 'Mua đứt trụ sở Flagship quán chính', v: costMoney });
      save();
      try { sfx('lvup'); } catch(e){}
      toast('🎉 CHÚC MỪNG! Bạn đã chính thức sở hữu SỔ ĐỎ tòa nhà Flagship! Miễn phí mặt bằng & điện nước vĩnh viễn! 🏰✨', 6000, 1);
      head();
      paneThue();
    }, 1],
    ['Để sau', () => {}]
  ]);
}

function onTaxSliderChange(newPct){
  if(isTaxActive()) return;
  window._selectedTaxPct = newPct;
  const pctEl = $('taxSelectedPct');
  const amtEl = $('taxSelectedAmt');
  const buffEl = $('taxBuffVal');
  const btn = $('btnPayTax');
  const taxAmt = Math.round((S.money || 0) * (newPct / 100));
  if(pctEl) pctEl.textContent = newPct + '%';
  if(amtEl) amtEl.textContent = fmt(taxAmt);
  if(buffEl) buffEl.textContent = newPct;
  if(btn && !isTaxActive()) btn.innerHTML = `🏛️ Nộp thuế ngay (${fmt(taxAmt)} · Buff +${newPct}%)`;
  document.querySelectorAll('.tax-pct-pill').forEach(b => {
    b.classList.toggle('on', +b.dataset.taxPct === newPct);
  });
}

function executePayTax(){
  initTaxState();
  if(isTaxActive()){
    const rem = Math.max(0, S.tax.expiresAt - Date.now());
    return toast(`Thuế đang có hiệu lực bảo hộ (còn ${formatTaxTime(rem)})! Hết 72h mới cần đóng chu kỳ mới (tối đa 72h).`);
  }

  const pct = Math.max(5, Math.min(15, window._selectedTaxPct || 15));
  const taxAmount = Math.round((S.money || 0) * (pct / 100));

  if((S.money || 0) <= 0){
    return toast('Két quán hiện không có tiền để đóng thuế!');
  }
  if(taxAmount <= 0){
    return toast('Số tiền nộp thuế tối thiểu chưa đủ!');
  }

  S.money -= taxAmount;
  S.cur.tax = (S.cur.tax || 0) + taxAmount;
  S.tax.paidAt = Date.now();
  // Khóa cứng thời hạn bảo hộ tối đa đúng 72 giờ thực tế từ thời điểm đóng, không cộng dồn vượt 72h
  S.tax.expiresAt = Date.now() + TAX_CYCLE_MS;
  S.tax.rate = pct / 100;
  S.tax.amount = taxAmount;
  S.tax.totalPaid = (S.tax.totalPaid || 0) + taxAmount;
  S.tax.payCount = (S.tax.payCount || 0) + 1;

  save();
  head();
  sfx('coin');
  sfx('lvup');

  ask(`
    <div style="text-align:center;">
      <div style="font-size:42px;margin-bottom:6px;">🏛️📜</div>
      <h2 style="color:#059669;font-weight:900;font-size:1.25rem;margin:2px 0 6px;">BIÊN LAI ĐÓNG THUẾ TRỰC TUYẾN 72H</h2>
      <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:12px;padding:12px;margin:10px 0;text-align:left;font-size:0.88rem;line-height:1.5;color:#14532d;">
        ✅ <b>Trạng thái:</b> ĐÃ NỘP THUẾ THÀNH CÔNG<br>
        💰 <b>Số tiền nộp:</b> <b style="color:#d97706;font-size:1rem;">${fmt(taxAmount)}</b> (${pct}% két)<br>
        ⏱️ <b>Thời hạn bảo hộ:</b> 72 Giờ Thực Tế (3 ngày) (đến ${new Date(S.tax.expiresAt).toLocaleTimeString('vi-VN')} ngày ${new Date(S.tax.expiresAt).toLocaleDateString('vi-VN')})<br>
        ✨ <b>Hiệu ứng kích hoạt:</b><br>
        • Tăng <b>+${pct}%</b> khách hàng ghé quán.<br>
        • Tăng <b>+${pct}%</b> tốc độ làm việc của toàn bộ nhân viên.<br>
        • Giảm <b>${pct}%</b> nguy cơ trộm cắp, tiền giả và bùng tiền!<br>
        • Tăng <b>+${pct}%</b> tỉ lệ may mắn x2 tiền bill mỗi ly nước!
      </div>
    </div>
  `, [
    ['Đã hiểu & Xác nhận', () => {
      paneThue();
      renderPrep();
      toast(`Đã nộp thuế ${fmt(taxAmount)}! Nhận Buff +${pct}% trong 72h thực tế! 🎉`, 4000);
    }, 1]
  ]);
}

/* ---------- HỆ THỐNG NÂNG CẤP CẤP ĐỘ LEVEL BẰNG TIỀN (Nx3: 10k, 30k, 90k, 270k...) ---------- */
const UPG_LV_CFG = {
  tra: {
    name: 'Trà',
    desc: 'Tăng 0.5% tỉ lệ khách ghé quán mỗi cấp',
    pct: 0.5,
    unit: '%',
    curBonus: lv => `+${(lv * 0.5).toFixed(1)}% khách ghé quán`
  },
  huong: {
    name: 'Hương',
    desc: 'Tăng 0.5% thời gian kiên nhẫn chờ mỗi cấp',
    pct: 0.5,
    unit: '%',
    curBonus: lv => `+${(lv * 0.5).toFixed(1)}% thời gian chờ`
  },
  top: {
    name: 'Topping',
    desc: 'Giảm 0.5% tỉ lệ đánh giá xấu/kém mỗi cấp',
    pct: 0.5,
    unit: '%',
    curBonus: lv => `Giảm ${(lv * 0.5).toFixed(1)}% đánh giá kém`
  },
  equip: {
    name: 'Trang bị',
    desc: 'Tăng 1% tốc độ thao tác máy & giảm 1% thiệt hại sự cố mỗi cấp',
    pct: 1.0,
    unit: '%',
    curBonus: lv => `+${(lv * 1.0).toFixed(1)}% tốc độ máy · Giảm ${(lv * 1.0).toFixed(1)}% sự cố`
  },
  staff: {
    name: 'Nhân viên',
    desc: 'Tăng 0.5% tỉ lệ x2 lợi nhuận đơn mỗi cấp · Mỗi 10 cấp tuyển thêm 1 pha chế, 1 đi chợ và 1 đơn online',
    pct: 0.5,
    unit: '%',
    curBonus: lv => `+${(lv * 0.5).toFixed(1)}% x2 bill · Tối đa ${1 + Math.floor(lv / 10)} pha chế, ${1 + Math.floor(lv / 10)} đi chợ, ${1 + Math.floor(lv / 10)} đơn online`
  },
  onl: {
    name: 'Online',
    desc: 'Tăng 1% tần suất nổ đơn online mỗi cấp',
    pct: 1.0,
    unit: '%',
    curBonus: lv => `+${(lv * 1.0).toFixed(1)}% tần suất đơn online`
  }
};

function getUpgLvCost(lv){
  const l = Math.max(0, lv || 0);
  const m = (typeof S !== 'undefined' && S && typeof S.money === 'number') ? S.money : 0;
  if(l >= 100){
    // Bậc Thầy Vô Cực (>100): (l - 90) Tỉ + 10% két
    return ((l - 90) * 1000000000) + Math.floor(Math.max(0, m) * 0.10);
  }
  if(l >= 50){
    return 1000000000 + Math.floor(Math.max(0, m) * 0.10);
  }
  // Max 500tr ở cấp 20, từ cấp 20 đến 49 chỉ cần 500tr 1 cấp
  if(l >= 19) return 500000000;
  return Math.min(500000000, 1000 * Math.pow(2, l));
}

function upgLvBanner(cat){
  const cfg = UPG_LV_CFG[cat];
  if(!cfg) return '';
  S.upgLv = S.upgLv || { tra:0, huong:0, top:0, equip:0, staff:0, onl:0 };

  // Chuẩn hóa một lần duy nhất: Reset các cấp độ hack > 50 về mốc Cấp 50 để bắt đầu đột phá công bằng
  if(!S._upgLvResetTo50Done_v12_47_538){
    S._upgLvResetTo50Done_v12_47_538 = true;
    let resetCount = 0;
    ['tra','huong','top','equip','staff','onl'].forEach(k=>{
      if(typeof S.upgLv[k] === 'number' && S.upgLv[k] > 50){
        S.upgLv[k] = 50;
        resetCount++;
      }
    });
    if(resetCount > 0){
      save();
      setTimeout(() => {
        if(typeof toast === 'function') toast(`🛡️ Đã chuẩn hóa ${resetCount} hạng mục nâng cấp về Cấp 50 để mở màn đột phá công bằng!`, 6000, 1);
      }, 300);
    }
  }

  let lv = S.upgLv[cat] || 0;
  const cost = getUpgLvCost(lv);
  const isPost100 = lv >= 100;
  const isPost50 = lv >= 50;
  const pctMoney = isPost50 ? Math.floor(Math.max(0, S.money || 0) * 0.10) : 0;
  const costStar = isPost100 ? Math.min(500, 100 + (lv - 100) * 5) : (isPost50 ? Math.max(50, Math.floor((S.star5Count || 0) * 0.10)) : 0);
  const canAffordMoney = S.money >= cost;
  const canAffordStar = !isPost50 || ((S.star5Count || 0) >= costStar);
  const canAfford = canAffordMoney && canAffordStar;

  const baseBillion = isPost100 ? (lv - 90) : 1;
  const costDisplay = isPost50 
    ? `${baseBillion} Tỉ + 10% két (${fmt(pctMoney)}) + ${costStar}⭐` 
    : fmt(cost);

  const titleExtra = isPost100 ? ` (Cấp ${lv} · 👑 Bậc Thầy Vô Cực)` : ` (Cấp ${lv})`;

  return `
    <div class="upg-lv-banner">
      <div class="ulv-info">
        <div class="ulv-head-row">
          <span class="ulv-tag">${isPost100 ? '👑 BẬC THẦY VÔ CỰC' : '⭐ NÂNG CẤP LEVEL'}</span>
          <div class="ulv-title">${cfg.name}${titleExtra}</div>
        </div>
        <div class="ulv-desc">${cfg.desc}</div>
        <div class="ulv-current">Hiệu quả: <b>${cfg.curBonus(lv)}</b></div>
        ${isPost100 
          ? `<div class="ulv-breakthrough-note">👑 Cấp Vô Cực (&gt;100): Cần ${baseBillion} Tỉ + 10% két (${fmt(pctMoney)}) = <b>${fmt(cost)}</b> &amp; <b>${costStar}⭐</b> (Đang có: ${(S.star5Count || 0)}⭐)</div>`
          : (isPost50 ? `<div class="ulv-breakthrough-note">⭐ Đột phá (&gt;50): Cần 1 Tỉ + 10% két (${fmt(pctMoney)}) = <b>${fmt(cost)}</b> &amp; <b>${costStar}⭐</b> (Đang có: ${(S.star5Count || 0)}⭐)</div>` : '')}
      </div>
      <button type="button" class="sbtn pri ulv-btn" data-upglv="${cat}" ${!canAfford ? 'disabled' : ''}>
        <span class="ulv-next">🔼 Nâng lên Cấp ${lv + 1}</span>
        <span class="ulv-cost">${costDisplay}</span>
      </button>
    </div>
  `;
}

function handleUpgLv(cat){
  if(inDebt()){ toast('Đang nợ, trả xong mới nâng cấp được'); return; }
  const cfg = UPG_LV_CFG[cat];
  if(!cfg) return;
  S.upgLv = S.upgLv || { tra:0, huong:0, top:0, equip:0, staff:0, onl:0 };
  let curLv = S.upgLv[cat] || 0;

  const isPost100 = curLv >= 100;
  const isPost50 = curLv >= 50;
  const costMoney = getUpgLvCost(curLv);
  const costStar = isPost100 ? Math.min(500, 100 + (curLv - 100) * 5) : (isPost50 ? Math.max(50, Math.floor((S.star5Count || 0) * 0.10)) : 0);

  if(isPost50 && (S.star5Count || 0) < costStar){
    toast(`⭐ Cần ít nhất ${costStar} Sao tích lũy để nâng cấp cấp độ này! (Bạn có: ${(S.star5Count || 0)}⭐)`);
    return;
  }
  if(S.money < costMoney){
    const pctVal = Math.floor(Math.max(0, S.money || 0) * 0.10);
    const baseBillion = isPost100 ? (curLv - 90) : 1;
    toast(isPost50 ? `Két không đủ tiền để nâng cấp (Cần ${baseBillion} Tỉ + 10% két (${fmt(pctVal)}) = Tổng: ${fmt(costMoney)})!` : 'Két không đủ tiền để nâng cấp cấp độ!');
    return;
  }

  S.money -= costMoney;
  if(costStar > 0){
    S.star5Count = Math.max(0, (S.star5Count || 0) - costStar);
  }
  S.upgLv[cat] = curLv + 1;
  S.cur.equip = S.cur.equip || [];
  S.cur.equip.push({ n: `Nâng cấp Level ${cfg.name} (Cấp ${curLv + 1})`, v: costMoney });
  save();
  sfx('lvup');
  toast(`🎉 Đã nâng cấp ${cfg.name} lên Cấp ${curLv + 1}! (${cfg.curBonus(curLv + 1)})`);
  refreshPrep();
}

