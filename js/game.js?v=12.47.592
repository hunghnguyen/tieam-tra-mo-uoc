function hideAllPoliceButtons(){
  try {
    if(R && R._fakeIntervalTimer){
      clearInterval(R._fakeIntervalTimer);
      R._fakeIntervalTimer = null;
    }
    document.querySelectorAll('.fake-police-bottom-btn, #btnFakePolice, .fake-police-header-btn').forEach(b => {
      b.hidden = true;
      b.style.setProperty('display', 'none', 'important');
      b.classList.add('hidden');
    });
    const sv = $('svWidget');
    if(sv){
      sv.classList.remove('gz-fakemoney');
      const pBtn = sv.querySelector('#svPoliceBtn, .police-btn, [data-sv-act="police"]');
      if(pBtn){ try { if(pBtn.remove) pBtn.remove(); else if(pBtn.parentNode) pBtn.parentNode.removeChild(pBtn); } catch(e){} }
    }
    const gz = $('gzWidget');
    if(gz){
      gz.classList.remove('gz-fakemoney');
      const pBtn = gz.querySelector('.police-btn, [data-gz-act="police"]');
      if(pBtn){
        try { pBtn.style.display = 'none'; } catch(e){}
        try { pBtn.classList.remove('police-btn'); } catch(e){}
        try { if(pBtn.removeAttribute) pBtn.removeAttribute('data-gz-act'); } catch(e){}
        pBtn.onclick = null;
      }
    }
    document.querySelectorAll('.police-btn, [data-sv-act="police"], [data-gz-act="police"]').forEach(b => {
      try { b.style.display = 'none'; } catch(e){}
      if(b.id === 'svPoliceBtn') {
        try { if(b.remove) b.remove(); else if(b.parentNode) b.parentNode.removeChild(b); } catch(e){}
      }
    });
  } catch(e){}
}

function renderFakeAlertBtn(){
  let btn = $('btnFakePolice');
  const isShiftEnded = !R || !R.running || R.closing || (R.isNightShift ? R.nightT <= 0 : R.t <= 0);
  if(isShiftEnded || !R.fakeCase || !R.fakeCase.suspect || R.fakeCase.expired || R.fakeCase.reported){
    hideAllPoliceButtons();
    if(isStaffActive('staffGz') && !R.isNightShift) renderGzWidget();
    if(isStaffActive('staffSv') && R.isNightShift) renderSvWidget();
    return;
  }
  const elapsed = Math.floor((Date.now() - (R.fakeCase.time || Date.now())) / 1000);
  const left = Math.max(0, 10 - elapsed);
  if(left <= 0){
    R.fakeCase.expired = true;
    hideAllPoliceButtons();
    if(isStaffActive('staffGz') && !R.isNightShift) renderGzWidget();
    if(isStaffActive('staffSv') && R.isNightShift) renderSvWidget();
    const effCashAlert = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S.money) : S.money;
    if(effCashAlert >= getSafeCashCeiling(S.day)){
      toast('💸 Kẻ gian dùng tiền giả đã tẩu thoát! Hãy gửi bớt tiền vào Tà Tưa Bank để giảm nguy cơ bị nhắm tới!', 3500);
    }
    return;
  }

  // Luôn dọn dẹp sạch mọi toast đang hiển thị để nút Báo Công An hiển thị rõ ràng 100%
  const curToast = $('toast');
  if(curToast && curToast.classList.contains('show')){
    curToast.classList.remove('show');
    tPri = 0;
  }

  // Nếu có nhân viên Gen Z hoặc SV ca đêm: Tích hợp thẳng vào tab nhân viên, ẩn nút riêng để không đè nhau
  const hasStaffActive = (isStaffActive('staffGz') && !R.isNightShift) || (isStaffActive('staffSv') && R.isNightShift);
  if(hasStaffActive){
    if(btn){
      btn.hidden = true;
      btn.style.setProperty('display', 'none', 'important');
      btn.classList.add('hidden');
    }
    if(isStaffActive('staffGz') && !R.isNightShift) renderGzWidget();
    if(isStaffActive('staffSv') && R.isNightShift) renderSvWidget();
    return;
  }

  // Trường hợp đứng quầy 1 mình: Hiển thị nút Báo C.An duy nhất ở đáy
  if(!btn){
    const wrap = $('staffBarWrap');
    btn = document.createElement('button');
    btn.type = 'button';
    btn.id = 'btnFakePolice';
    btn.className = 'fake-police-bottom-btn';
    btn.title = 'Tố cáo khách đưa tiền giả để nhận đền bù 500k (trong 10s)!';
    if(wrap){
      wrap.appendChild(btn);
    } else {
      document.body.appendChild(btn);
    }
  }
  btn.onclick = () => reportFakeMoneyPolice();
  btn.hidden = false;
  btn.classList.remove('hidden');
  btn.style.setProperty('display', 'flex', 'important');
  const sName = R.fakeCase.suspect ? R.fakeCase.suspect.name : 'Khách';
  btn.innerHTML = `🚨 TIỀN GIẢ (${esc(sName)})! Báo C.An ngay <small style="background:#fff;color:#dc2626;border-radius:6px;padding:1px 5px;font-size:10px;font-weight:900;margin-left:4px;">${left}s (+500k)</small>`;
}

/* ===== GỢI Ý PHÂN TÍCH AI TUNG HINT ẨN DỤ CỦA TRỢ LÝ ME KÉT TINH (CHUẨN 100%) ===== */
function getMktCameraAiMetaphorHint(guiltySus){
  if(!guiltySus) return { aiBehaviorHint: '', aiMetaphorHint: '' };
  const desc = (guiltySus.desc || '').toLowerCase();
  let aiBehaviorHint = '';
  let aiMetaphorHint = '';

  if(desc.includes('nhìn quanh') || desc.includes('mắt')){
    aiBehaviorHint = 'Thuật toán theo dõi đồng tử AI ghi nhận nhịp mắt đảo lia lịa quét 360 độ quanh quầy như sợ ai theo dõi; vừa cầm tiền thối xong là chân bước thoăn thoắt biến mất tăm!';
    aiMetaphorHint = 'Người đàng hoàng thì thong thả thưởng trà, chỉ có kẻ mang tâm lý "có tật giật mình" mới lấm lét dòm trước ngó sau tìm lối thoát!';
  } else if(desc.includes('gấp mép') || desc.includes('túi áo') || desc.includes('giục')){
    aiBehaviorHint = 'Cảm biến âm thanh & thân nhiệt AI bắt trọn tần số giọng nói hối hả giục giã thu ngân làm nhanh tay, tay rút vội tờ tiền bị gấp mép giấu sâu trong túi áo khoác hòng phân tán chú ý!';
    aiMetaphorHint = 'Khách mua nước lương thiện ai lại cuống cuồng giục giã và giấu tiền tận đáy túi áo khoác chứ không để trong ví đàng hoàng!';
  } else if(desc.includes('nón bảo hiểm') || desc.includes('trùm kín') || desc.includes('né tránh')){
    aiBehaviorHint = 'Hệ thống đối chiếu nhân trắc học AI báo động: Đối tượng đội nón bảo hiểm trùm kín mít, góc đầu luôn cúi gập né tránh trực diện góc quay của camera an ninh quầy!';
    aiMetaphorHint = 'Cây ngay không sợ chết đứng! Người mua đàng hoàng luôn để lộ gương mặt tự tin, chỉ có kẻ làm chuyện mờ ám mới sợ camera an ninh soi mặt!';
  } else if(desc.includes('che chắn') || desc.includes('mới cứng') || desc.includes('ví tay')){
    aiBehaviorHint = 'Mô hình phân tích cử chỉ không gian AI nhận thấy: Đối tượng cố tình nghiêng thân người tạo điểm mù che chắn tầm mắt của thu ngân trong lúc đưa tờ tiền mới cứng phẳng lì!';
    aiMetaphorHint = 'Mua một ly nước mà đứng che chắn như giấu bài tây, hành vi che đậy lén lút tạo góc khuất thì không thể lẫn vào đâu được!';
  } else if(desc.includes('tay hơi run') || desc.includes('ra xe') || desc.includes('quay lưng')){
    aiBehaviorHint = 'Cảm biến vi chuyển động AI bắt trọn tần số rung nhẹ bất an ở các đầu ngón tay; vừa chạm tay vào ly nước là lập tức quay ngoắt lưng rảo bước thẳng ra xe như kẻ đang đào tẩu!';
    aiMetaphorHint = 'Người yêu trà thì nán lại cầm ly nước, còn kẻ này vừa nhận ly là tay run rẩy quay lưng phóng vội ra xe tẩu thoát!';
  } else {
    aiBehaviorHint = 'AI phân tích hành vi khoanh vùng: Trong khi 3 vị khách kia đều có biểu cảm thư thái, thong thả uống trà và nguồn tiền minh bạch; duy nhất một đối tượng có cử chỉ lén lút, vội vã và bất minh!';
    aiMetaphorHint = 'Sếp tìm người có hành vi cuống cuồng, giao dịch lén lút và vội vã muốn rời khỏi hiện trường nhất trong các lời khai!';
  }

  return { aiBehaviorHint, aiMetaphorHint };
}

function reportFakeMoneyPolice(fromEndDay){
  hideAllPoliceButtons();
  if(!R || !R.fakeCase || !R.fakeCase.suspect || R.fakeCase.reported){
    hideAllPoliceButtons();
    if(isStaffActive('staffGz') && !R.isNightShift) renderGzWidget();
    if(isStaffActive('staffSv') && R.isNightShift) renderSvWidget();
    return toast('Hiện tại không có vụ việc tiền giả nào cần thụ lý!');
  }
  const fc = R.fakeCase;
  const real = fc.suspect;

  // Đánh dấu đã tiếp nhận án và đóng nút ngay tức thì
  R.fakeCase.expired = true;
  R.fakeCase.reported = true;
  hideAllPoliceButtons();
  if(isStaffActive('staffGz') && !R.isNightShift) renderGzWidget();
  if(isStaffActive('staffSv') && R.isNightShift) renderSvWidget();
  renderFakeAlertBtn();

  const innoPool = INNOCENT_POOL.filter(x => x.name !== real.name).sort(() => Math.random() - 0.5);
  const inno1 = innoPool[0] || { name: 'Người qua đường A', face: '🧑', desc: 'Thanh toán tiền mặt, kiểm tra kỹ tiền thối rồi cất vào ví trước khi đi.' };
  const inno2 = innoPool[1] || { name: 'Người qua đường B', face: '👩', desc: 'Trả tiền mặt lấy từ cọc tiền lẻ ăn sáng, thong thả uống trà tại quầy.' };
  const inno3 = innoPool[2] || { name: 'Người qua đường C', face: '🧔', desc: 'Thanh toán tiền mặt phẳng phiu vừa rút ở cây ATM, còn cầm biên lai.' };

  const suspects = [
    { isGuilty: true, ...real },
    { isGuilty: false, ...inno1 },
    { isGuilty: false, ...inno2 },
    { isGuilty: false, ...inno3 }
  ].sort(() => Math.random() - 0.5);

  let mktClueHtml = '';
  if(S.upg && S.upg.staffMkt){
    const mktName = staffPersonName('staffMkt') || 'Me két tinh';
    const guiltyIdx = suspects.findIndex(s => s.isGuilty);
    const guiltySus = suspects[guiltyIdx];
    const hint = getMktCameraAiMetaphorHint(guiltySus);
    mktClueHtml = `
      <div style="background:linear-gradient(135deg,rgba(236,72,153,0.1),rgba(244,114,182,0.18));border:1.5px solid #f472b6;border-radius:12px;padding:9px 12px;margin-bottom:10px;display:flex;align-items:flex-start;gap:10px;text-align:left;">
        <span style="font-size:26px;line-height:1;margin-top:2px;">🐱</span>
        <div style="font-size:0.81rem;line-height:1.45;color:#831843;flex:1;">
          <div style="font-weight:900;color:#db2777;font-size:0.88rem;margin-bottom:3px;">
            Trợ lý Me két tinh (${esc(mktName)}) soi camera (Chuẩn 100%):
          </div>
          <div style="background:rgba(255,255,255,0.75);border-left:3px solid #ec4899;border-radius:6px;padding:6px 10px;margin:4px 0;color:#701a75;font-weight:600;">
            🔍 <b>Sự thật chỉ có 1:</b> ${hint.aiBehaviorHint}
          </div>
        </div>
      </div>
    `;
  } else {
    mktClueHtml = `
      <div style="background:rgba(255,255,255,0.6);border:1px dashed #cbd5e1;border-radius:10px;padding:6px 10px;margin-bottom:8px;font-size:0.75rem;color:#64748b;text-align:center;">
        💡 <i>Chưa thuê Trợ lý Me két tinh để soi camera tìm ra sự thật chuẩn xác 100%. Hãy tự quan sát kỹ lời khai của 4 đối tượng!</i>
      </div>
    `;
  }

  let wasRunning = R.running && !R.paused;
  if(wasRunning){
    R.paused = true;
    clearInterval(timer);
  }

  const cardsHtml = suspects.map((s, idx) => `
    <div class="suspect-card" data-sus-idx="${idx}">
      <div class="suspect-header">
        <div class="suspect-avatar">${s.face}</div>
        <div class="suspect-name">#${idx + 1}: <b>${esc(s.name)}</b></div>
      </div>
      <div class="suspect-desc">${esc(s.desc || ('Ghé mua ' + (s.order || 'nước')))}</div>
      <button type="button" class="sbtn pri suspect-choose-btn" data-choose-sus="${idx}">👉 Chỉ điểm</button>
    </div>
  `).join('');

  ask(`
    <div class="police-report-wrap">
      <div class="police-report-badge">🚨 CÔNG AN PHƯỜNG TRÍCH XUẤT CAMERA</div>
      <h2 class="police-report-title">HỒ SƠ ĐIỀU TRA: VỤ ÁN TIỀN GIẢ</h2>
      <p class="police-report-desc">
        Quán vừa bị lừa đưa <b>TIỀN GIẢ</b> (đơn hàng: <b>${esc(real.order)}</b>, thiệt hại: <b style="color:#ef4444;font-weight:800;">-${fmt(real.loss)}</b>).
        Công an đã khoanh vùng được <b>4 nghi phạm</b> dưới đây. Hãy nhận diện đúng người đã đưa tiền giả!
      </p>
      <div class="police-legal-warning">
        ⚖️ <b>Quy định xử lý theo pháp luật:</b><br>
        ✅ <b>Chỉ điểm ĐÚNG:</b> Thu hồi tiền đơn hàng, nhận thưởng <b style="color:#059669;">+500.000đ (500k)</b> &amp; <b style="color:#059669;">Tăng điểm sao quán ⭐</b>!<br>
        ❌ <b>Chỉ điểm SAI:</b> Bị phạt hành vi vu khống <b style="color:#dc2626;">−7.000.000đ (7tr)</b> &amp; <b style="color:#dc2626;">Giảm điểm sao quán vì thiếu minh bạch 📉</b>!
      </div>
      ${mktClueHtml}
      <div class="suspect-list">
        ${cardsHtml}
      </div>
    </div>
  `, [
    ['Để sau (quay lại bán hàng)', ()=>{
      hideAllPoliceButtons();
      if($('modal')) $('modal').hidden = true;
      const isShiftEnded = !R || R.closing || (R.isNightShift ? (R.nightT <= 0) : (R.t <= 0));
      if(fromEndDay || isShiftEnded) finishEndDay();
      else if(wasRunning && R && R.running) resumeGame();
      else resumeGame();
    }]
  ]);

  const cardEl = $('card');
  if(cardEl){
    cardEl.onclick = (e) => {
      const b = e.target.closest('[data-choose-sus]');
      if(b){
        const chosen = suspects[+b.dataset.chooseSus];
        handleSuspectVerdict(chosen, real, wasRunning, fromEndDay);
      }
    };
  }
}

function handleSuspectVerdict(chosen, real, wasRunning, fromEndDay){
  const originalLoss = real.loss || 0;
  R.fakeCase = null;
  hideAllPoliceButtons();
  if($('card')) $('card').onclick = null;
  if(isStaffActive('staffGz') && !R.isNightShift) renderGzWidget();
  if(isStaffActive('staffSv') && R.isNightShift) renderSvWidget();
  renderFakeAlertBtn();

  if(chosen.isGuilty){
    const reward = 500000;
    const totalGet = reward + originalLoss;
    S.money += totalGet;
    R.today.rev += originalLoss;
    S.totalRev += originalLoss;

    // Thu hồi tổn thất tiền giả trong ngày
    if(R.today){
      R.today.fakeLoss = Math.max(0, (R.today.fakeLoss || 0) - originalLoss);
      R.today.fakeCount = Math.max(0, (R.today.fakeCount || 0) - 1);
    }

    // Tăng điểm sao của quán
    const goodReviews = [
      { s: 5, t: 'Công an phường biểu dương quán có tinh thần cảnh giác, trung thực, hỗ trợ bắt đối tượng lưu hành tiền giả! ⭐⭐⭐⭐⭐', n: 'Công An Phường', f: '👮‍♂️' },
      { s: 5, t: 'Quán làm ăn rất đàng hoàng, minh bạch và chính trực! Rất an tâm khi ghé mua, 5 sao xứng đáng! 👍✨', n: 'Khách Hàng Khu Phố', f: '🌟' }
    ];
    goodReviews.forEach(gr => {
      S.reviews.unshift({
        s: gr.s,
        t: gr.t,
        k: 'police_win_' + Date.now() + '_' + Math.random(),
        d: S.day,
        o: false,
        n: gr.n,
        f: gr.f,
        b: null, fl: null, tp: [], ch: false, sz: 'M'
      });
      if(R.today && Array.isArray(R.today.stars)) R.today.stars.push(gr.s);
    });
    S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
    if(S.reviews.length > 2500) S.reviews.length = 2500;

    if(isStaffActive('staffGz') && !R.isNightShift){
      R.gzMsg = `Chỉ điểm chính xác! Bắt trọn đối tượng đưa tiền giả, thưởng nóng +500k! 🚔✨`;
      renderGzWidget();
    }
    if(isStaffActive('staffSv') && R.isNightShift){
      R.svMsg = `Chỉ điểm chính xác! Bắt trọn đối tượng đưa tiền giả, thưởng nóng +500k! 🚔✨`;
      renderSvWidget();
    }

    save(); head(); sfx('lvup');

    ask(`
      <div class="pbig">👮‍♂️🎉</div>
      <h2 class="verdict-title success">PHÁ ÁN THÀNH CÔNG!</h2>
      <p class="verdict-desc">
        Công an phường đã bắt giữ đúng đối tượng <b class="highlight-success">${esc(chosen.name)}</b> cùng xấp tiền giả mang theo người!
      </p>
      <div class="verdict-box success">
        <div>💵 Hoàn tiền đơn hàng: <b>+${fmt(originalLoss)}</b></div>
        <div>🏆 Thưởng nóng &amp; đền bù thiệt hại: <b class="amt-gain">+500.000đ (500k)</b></div>
        <div>⭐ Đánh giá uy tín quán: <b class="amt-gain">Tăng điểm sao (+2 đánh giá 5 sao từ Công An &amp; Khách)</b></div>
        <div class="verdict-box-footer">
          💰 Tổng tiền két quán nhận được: <b class="amt-total">+${fmt(totalGet)}</b>
        </div>
      </div>
    `, [
      ['Nhận thưởng & Tiếp tục 🧋', ()=>{
        hideAllPoliceButtons();
        if($('modal')) $('modal').hidden = true;
        const isShiftEnded = !R || R.closing || (R.isNightShift ? (R.nightT <= 0) : (R.t <= 0));
        if(fromEndDay || isShiftEnded) finishEndDay();
        else if(wasRunning && R && R.running) resumeGame();
        else resumeGame();
      }, 1]
    ]);
  } else {
    const fine = Math.min(7000000, Math.max(200000, S.money));
    S.money = Math.max(0, S.money - fine);
    S.cur.bad = (S.cur.bad || 0) + fine;
    R.today.bad = (R.today.bad || 0) + fine;

    // Giảm điểm sao của quán vì thiếu minh bạch, vu khống
    const badReviews = [
      { s: 1, t: `Quán làm ăn tắc trách, thiếu minh bạch! Vu oan cho tôi (${esc(chosen.name)}) đưa tiền giả làm mất hết danh dự! 😡`, n: chosen.name, f: chosen.face || '😠' },
      { s: 1, t: 'Chứng kiến quán chụp mũ, vu khống khách vô tội mà bức xúc! Quán làm việc thiếu minh bạch, trừ 1 sao cảnh cáo! 👎', n: 'Khách chứng kiến', f: '😤' }
    ];
    badReviews.forEach(br => {
      S.reviews.unshift({
        s: br.s,
        t: br.t,
        k: 'police_fail_' + Date.now() + '_' + Math.random(),
        d: S.day,
        o: false,
        n: br.n,
        f: br.f,
        b: null, fl: null, tp: [], ch: false, sz: 'M'
      });
      if(R.today && Array.isArray(R.today.stars)) R.today.stars.push(br.s);
    });
    S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
    if(S.reviews.length > 2500) S.reviews.length = 2500;

    if(isStaffActive('staffGz') && !R.isNightShift){
      R.gzMsg = `Chỉ điểm nhầm người vô tội rồi sếp ơi! Bị phạt vu khống -${fmt(fine)}! 😢`;
      renderGzWidget();
    }
    if(isStaffActive('staffSv') && R.isNightShift){
      R.svMsg = `Chỉ điểm nhầm người vô tội rồi sếp ơi! Bị phạt vu khống -${fmt(fine)}! 😢`;
      renderSvWidget();
    }

    save(); head(); sfx('bad');

    ask(`
      <div class="pbig">⚖️❌</div>
      <h2 class="verdict-title fail">VU KHỐNG - TỐ CÁO SAI SỰ THẬT!</h2>
      <p class="verdict-desc">
        Người bạn chỉ điểm là <b class="highlight-fail">${esc(chosen.name)}</b> hoàn toàn vô tội và có chứng cứ ngoại phạm xác thực!
      </p>
      <div class="verdict-box fail">
        <div>⚠️ Hành vi: <b class="act-name">Tố cáo oan người vô tội, vu khống</b></div>
        <div>💸 Phạt vi phạm hành chính: <b class="amt-penalty">−${fmt(fine)}</b></div>
        <div>📉 Đánh giá uy tín quán: <b class="star-penalty">Bị giảm điểm sao (-2 đánh giá 1 sao vì thiếu minh bạch)</b></div>
        <div class="verdict-box-note">(Tiền phạt đã trừ trực tiếp vào két tiền quán và ghi vào chi phí sự cố)</div>
      </div>
    `, [
      ['Chấp hành & Tiếp tục', ()=>{
        hideAllPoliceButtons();
        if($('modal')) $('modal').hidden = true;
        const isShiftEnded = !R || R.closing || (R.isNightShift ? (R.nightT <= 0) : (R.t <= 0));
        if(fromEndDay || isShiftEnded) finishEndDay();
        else if(wasRunning && R && R.running) resumeGame();
        else resumeGame();
      }, 1]
    ]);
  }
}

function serve(i, customCup){
  const c=R.slots[i];if(!c||!R.running)return;const el=document.querySelector(`[data-slot="${i}"]`);
  const activeCup = customCup || cup;
  if(level()>=2&&!activeCup.ice)activeCup.ice='Không đá';
  if(level()>=2&&activeCup.sugar==null)activeCup.sugar=50;
  if(!ready(true, activeCup))return;
  const j=c.cups.findIndex((x,k)=>!c.done[k]&&matches(activeCup,x));
  if(j>=0){
    sfx('coin');if(!R.coachDone&&S.coach!==true){R.coachDone=true;setTimeout(coach,50)}const o=c.cups[j];
    // BƯỚC 1: Tính giá gốc
    let p=price(o);
    if(c.star!=null) p = Math.round(p * 3);
    if(c.specialRecipe && c.specialRecipe.id){
      const recStar = (S.collection && S.collection.recipeStars && S.collection.recipeStars[c.specialRecipe.id]) || 1;
      if(recStar >= 2){
        const starPriceMul = 1 + (recStar - 1) * 0.25;
        p = Math.round(p * starPriceMul);
      }
    }

    // BƯỚC 2: Thu thập TOÀN BỘ buff vào 1 biến additive
    let additiveBuff = 0;
    if(S && S.garden && S.garden.organicBuffDays > 0 && (o.base === 'hong' || o.base === 'luc' || o.base === 'olong' || o.flav)){
      additiveBuff += (S.garden.organicBuffBoost ? 0.30 : 0.20);
    }
    const crushBonus = (R && R.todayCrushBuffRate) || (S && S.crushBuffRate) || 0;
    if(crushBonus > 0) additiveBuff += Math.min(0.30, crushBonus);
    const staffBillBonus = typeof getStaffBillBonusTotal === 'function' ? getStaffBillBonusTotal() : 0;
    if(staffBillBonus > 0) additiveBuff += Math.min(0.25, staffBillBonus);
    if(o.isTrendDrink && o.trendMultiplier){
      additiveBuff += Math.min(0.50, (o.trendMultiplier || 1.5) - 1);
      if(typeof window.TrendSystem !== 'undefined' && window.TrendSystem.onDrinkServed){
        window.TrendSystem.onDrinkServed(o);
      }
    }
    const bMul = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
    const dMul = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
    const isAfter20h = R.isNightShift || (R.t != null && R.t <= dayLen() * 60 * (2 / 11));
    if(S && S.startupLocation === 'sapa'){
      const isSapaFav = (o.base === 'hong' || o.base === 'luc' || o.ice === 'Ít đá' || o.ice === 'Không đá' || o.ice === 'Nóng');
      if(isSapaFav) additiveBuff += 0.20 * bMul;
    } else if(S && S.startupLocation === 'hue'){
      if(o.base === 'olong' || o.base === 'hong' || o.base === 'lai' || o.flav === 'f_nhai') additiveBuff += 0.22 * bMul;
    } else if(S && S.startupLocation === 'buonmethuot'){
      if(o.base === 'tra' || o.base === 'thai' || o.cheese || (o.tops && (o.tops.includes('cheese') || o.tops.includes('tcden') || o.tops.includes('tran')))) additiveBuff += 0.22 * bMul;
    } else if(S && S.startupLocation === 'halong' && c && c.cups && c.cups.length >= 2){
      additiveBuff += 0.12 * bMul;
    } else if(S && S.startupLocation === 'vungtau' && o && (o.ice === 'Đá thường' || o.ice === 'Bình thường' || o.flav)){
      additiveBuff += 0.15 * bMul;
    }
    if(isAfter20h && S && S.startupLocation === 'hcm') additiveBuff += 0.25 * bMul;
    if(S && S.startupLocation === 'camau' && c && c.cups && c.cups.length >= 2) additiveBuff += 0.12 * bMul;
    if(S && S.startupLocation === 'dalat' && o && (!o.ice || o.ice === 'Không đá' || o.ice === 'Nóng')) additiveBuff += 0.20 * bMul;
    if(S && S.startupLocation === 'phuquoc' && c && (c.vip || c.isSpecialCust || c.isTiktoker || (c.cups && c.cups.length >= 2))) additiveBuff += 0.20 * bMul;
    if(S && S.startupLocation === 'hanoi') additiveBuff += 0.12 * bMul;
    if(c.app && S && S.collection && S.collection.craftedRecipes && S.collection.craftedRecipes['rec_vutru_khonggian']) additiveBuff += 0.50;

    // BƯỚC 3: Cap additive ở +95% (cho phép Đế Chế Khởi Nghiệp Cấp 5 phát huy tối đa)
    const synergies = typeof getStaffTeamSynergies === 'function' ? getStaffTeamSynergies() : null;
    if(R.isNightShift && synergies && synergies.hasNightPair){
      additiveBuff += 0.25; // Bộ Đôi Ca Đêm Lv.5: +25% doanh thu ca đêm
    }
    if(isStaffActive('staff3') && getStaffTrainLv('staff3') >= 5){
      additiveBuff += 0.10; // Quản Lý Toàn Năng Lv.5: +10% giá trị hóa đơn khách quầy
    }
    if(isStaffActive('staffCleaner') && getStaffTrainLv('staffCleaner') >= 5 && !c.app){
      additiveBuff += 0.15; // Nghệ Nhân Không Gian Thượng Lưu Lv.5: +15% giá trị hóa đơn bàn quầy
    }
    const activeCupBuff = (typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
    if(activeCupBuff && activeCupBuff.billBonus > 0){
      additiveBuff += activeCupBuff.billBonus; // Ly Tết Sum Vầy (Top 1 DT Ngày): +18% giá bán ly
    }
    additiveBuff = Math.min(0.95, Math.max(-0.40, additiveBuff));
    p = Math.round(p * (1 + additiveBuff));

    // BƯỚC 4: X2 bill & Cáp Bi bộc phát (nhân độc lập có trần)
    let capbiMult = 1;
    if(typeof isCapbiActive === 'function' && isCapbiActive() && !c.isFake && p > 0){
      const capbiBuff = typeof getCapbiBuffValues === 'function' ? getCapbiBuffValues(S.capbi.level) : { cupCritRate: 0.02, cupMultMin: 2, cupMultMax: 5 };
      if(Math.random() < (capbiBuff.cupCritRate || 0.02)){
        const minM = capbiBuff.cupMultMin || 2;
        const maxM = capbiBuff.cupMultMax || 5;
        capbiMult = Math.floor(Math.random() * (maxM - minM + 1)) + minM;
        p = Math.round(p * capbiMult);
        c._capbiMult = capbiMult;
        setTimeout(() => {
          toast(`🦫 Bé Cáp Bi điềm đạm ban phúc: BỘC PHÁT ×${capbiMult} GIÁ TRỊ LY TRÀ (+${fmt(p)})! ✨🎉`, 3800);
          try { sfx('win'); } catch(_) {}
        }, 150);
      }
    }
    const staffLv=(S.upgLv&&S.upgLv.staff)||0;
    const taxX2Rate = isTaxActive() ? (S.tax && S.tax.rate ? S.tax.rate * 0.20 : 0.03) : 0;
    const cupX2Rate = (activeCupBuff && activeCupBuff.x2BillChance > 0) ? activeCupBuff.x2BillChance : 0;
    const x2Chance = (staffLv * 0.005) + taxX2Rate + cupX2Rate;
    if(x2Chance > 0 && Math.random() < x2Chance){
      p *= 2;
      const rollX2 = Math.random() * x2Chance;
      if(cupX2Rate > 0 && rollX2 < cupX2Rate){
        toast(`🥮 Ly Trung Thu Trăng Tròn ban phúc: NỔ X2 BILL (+${fmt(p)})! 🌕✨`, 2800);
      } else {
        const isTaxBonus = taxX2Rate > 0 && Math.random() < (taxX2Rate / Math.max(0.001, x2Chance - cupX2Rate));
        toast(isTaxBonus ? `🏛️ Đóng thuế uy tín: x2 bill (+${fmt(p)})! 🎉` : `✨ Nhân viên khéo léo x2 bill (+${fmt(p)})! 🎉`, 2500);
      }
    }

    // BƯỚC 5: Cho phép giá ly phản ánh đúng giá trị công thức + topping + buff thực tế của quán
    p = Math.min(500000, p);

    // BƯỚC 6: Buff thụ động (Pet Dog/Cat, Capbi passive, Scarf, Rush Hour) — Mở rộng trần lên +75% để Tó Shiba cấp cao phát huy trọn vẹn!
    const petType = S.pet && S.pet.type;
    const isDogGuardActive = !!(S.pet && S.pet.unlocked && petType === 'dog' && (S.pet.happiness || 0) >= 50);
    const petBuffRate = (S.pet && S.pet.unlocked && (S.pet.happiness || 0) >= 50)
      ? (typeof getPetBuffValues === 'function' ? (getPetBuffValues(petType, S.pet.level).revBonusRate || 0.10) : 0.10)
      : 0;
    const capbiRevBuff = (typeof isCapbiActive === 'function' && isCapbiActive() && (S.capbi.happiness || 0) >= 50)
      ? (typeof getCapbiBuffValues === 'function' ? getCapbiBuffValues(S.capbi.level).revBonusRate : 0.07)
      : 0;
    const scarfBuff = (S && S.activeDecor && S.activeDecor.scarf && S.decor && S.decor.scarf) ? 0.08 : 0;
    const rushBuff = (R && R.rushHourActive) ? 0.50 : 0;

    const passiveBuff = Math.min(0.75, petBuffRate + capbiRevBuff + scarfBuff + rushBuff);
    if(passiveBuff > 0){
      const extraPassive = Math.round(p * passiveBuff);
      p += extraPassive;
      if(petBuffRate > 0 && S.cur){
        const petShare = Math.round(extraPassive * (petBuffRate / passiveBuff));
        if(petType === 'cat'){
          S.cur.catBonus = (S.cur.catBonus || 0) + petShare;
        } else {
          S.cur.dogBonus = (S.cur.dogBonus || 0) + petShare;
        }
      }
    }

    p = Math.min(500000, p);
    const full=p;const gd=guardLv(),T=R.today;
    const hasWinterShield = !!(activeCupBuff && activeCupBuff.antiFakeBargain);
    let isFake = hasWinterShield ? false : !!c.isFake;
    // Giảm mạnh tỉ lệ lừa đảo tiền giả thông thường, nhưng khi tiền tồn đầu ca vượt trần an toàn động thì tỉ lệ tăng vọt
    const safeCashFake = getSafeCashCeiling(S.day);
    const effCashFake = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S.money) : S.money;
    let fakeChance = effCashFake >= safeCashFake ? 0.085 : (effCashFake >= 50000000 ? 0.01 : 0.003);
    if(effCashFake >= safeCashFake){
      fakeChance += Math.min(0.065, Math.floor((effCashFake - safeCashFake) / 1000000000) * 0.02);
    }
    if(isTaxActive()){
      fakeChance *= 0.5;
    } else if(isTaxOverdue()){
      fakeChance = Math.min(0.05, fakeChance * 1.3);
    }
    if(isStaffActive('staffGuard')){
      const guardTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffGuard') : 0;
      if(guardTrainLv >= 4){
        fakeChance = 0; // Cấp 4-5 (Đặc Vụ An Ninh Thép): Chặn 100% tiền giả
      } else {
        fakeChance *= Math.max(0, 0.10 - guardTrainLv * 0.025);
      }
    } else if(isGuardResting()){
      fakeChance = effCashFake >= safeCashFake ? Math.min(0.22, fakeChance * 2.5) : Math.min(0.08, fakeChance * 2.5); // Chú bảo vệ nghỉ ngủ lấy sức: nguy cơ tiền giả tăng cao
    }
    // 🐕 ĐẶC QUYỀN TÓ SHIBA: Khuyển Vệ Thần đánh hơi và dọa kẻ gian (-60% nguy cơ tiền giả)
    if(isDogGuardActive){
      fakeChance *= 0.40;
    }
    if(S && (S.startupLocation === 'danang' || S.startupLocation === 'hoangsa')){
      fakeChance = 0; // Đà Nẵng & Hoàng Sa: Tuyệt đối 0% tiền giả
    }
    if(hasWinterShield){
      fakeChance = 0; // ❄️ Ly Đông Ấm Áp (Top 1 1 Sao): Kháng 100% tiền giả, mặc cả & quỵt tiền
      c.isFake = false;
    }
    // Khách đặc biệt (Thẩm định công thức kết hợp, Food Reviewer, Bạn bè, Khách nhận free, Khách ngoại quốc, Khách đặc biệt) tuyệt đối không đưa tiền giả
    const isSpecialImmune = !!(c.isSpecialCust || c.isSpecialRecipeGuest || c.vip || c.isFriend || c.isFreeDrink || c.star != null || hasWinterShield);
    if(S.day >= 2 && !isSpecialImmune && c.brat !== 'bung' && !c.fakeChecked && Math.random() < fakeChance){
      c.fakeChecked = true;
      c.isFake = true;
      isFake = true;
