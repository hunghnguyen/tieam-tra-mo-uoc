function getActiveAdsBranchBoost(){
  let boost = 0;
  if(S && S.mxh && Array.isArray(S.mxh.activeAds) && S.mxh.activeAds.length > 0){
    S.mxh.activeAds.forEach(a => {
      if(!a || !a.id) return;
      const def = ADS_CAMPAIGNS.find(x => x && x.id === a.id);
      if(def && def.branchBoost != null){
        boost += def.branchBoost;
      } else if(a.branchBoost != null){
        boost += a.branchBoost * 0.8;
      } else {
        boost += ((a.boost || 0) * 0.48);
      }
    });
  }
  return boost;
}

