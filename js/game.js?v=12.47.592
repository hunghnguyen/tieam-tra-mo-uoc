function getPlayerRankTitle(p){
  const stars = Number(p && p.star5Count) || 0;
  const prof = Number(p && p.profit) || 0;
  if(stars >= 1000 || prof >= 30000000000) return 'Huyền Thoại Trà Quán 👑';
  if(stars >= 600 || prof >= 15000000000) return 'Đại Phú Hào Trà Sữa 🧋';
  if(stars >= 300 || prof >= 5000000000) return 'Bậc Thầy Pha Chế ✨';
  if(stars >= 100 || prof >= 1000000000) return 'Nghệ Nhân Hương Vị 🌸';
  if(stars >= 30 || prof >= 200000000) return 'Chủ Tiệm Triển Vọng 🍵';
  return 'Tập Sự Khởi Nghiệp 🌱';
}

function getPlayerLocationName(){
  if(S && S.startupLocation && typeof STARTUP_LOCATIONS !== 'undefined'){
    const loc = STARTUP_LOCATIONS.find(x => x.id === S.startupLocation);
    if(loc && loc.name) return loc.name.replace(/^[^\s]+\s*/, '');
  }
  return 'Việt Nam';
}

function ensurePlayerCloudKey(){
  S.cloud = S.cloud || {};
  if(!S.cloud.key){
    const a = new Uint8Array(12);
    crypto.getRandomValues(a);
    S.cloud.key = [...a].map(x=>x.toString(36).padStart(2,'0')).join('').slice(0,24);
    save();
  }
  return S.cloud.key;
}

const LB_AUTH_SECRET = 'ts_sec_tea_2026_mouoc#9981';

async function calcLeaderboardSignature(entryObj){
  try {
    const id = String(entryObj.id || '').trim();
    const name = String(entryObj.name || 'Tiệm Trà Mơ Ước').trim().slice(0, 32) || 'Tiệm Trà Mơ Ước';
    const validDay = Math.max(1, parseInt(entryObj.day, 10) || 1);
    const validDayRev = Math.max(0, parseInt(entryObj.dayRev, 10) || 0);
    const validDayServed = Math.max(0, parseInt(entryObj.dayServed, 10) || 0);
    const profit = Math.max(0, parseInt(entryObj.profit, 10) || 0);
    const rev = Math.max(0, parseInt(entryObj.rev, 10) || 0);
    const served = Math.max(0, parseInt(entryObj.served, 10) || 0);
    const staffTip7d = Math.max(0, parseInt(entryObj.staffTip7d, 10) || 0);
    const avgUpg = Math.min(80.0, Math.max(0, parseFloat(entryObj.avgUpg) || 0));
    const crushLevel = Math.min(280, Math.max(1, parseInt(entryObj.crushLevel, 10) || 1));
    const capbiLevel = Math.min(80, Math.max(0, parseInt(entryObj.capbiLevel, 10) || 0));
    const star1Count = Math.min(5000, Math.max(0, parseInt(entryObj.star1Count, 10) || 0));
    const star5Count = Math.min(80000, Math.max(0, parseInt(entryObj.star5Count, 10) || 0));
    const money = Math.max(0, parseInt(entryObj.money, 10) || 0);
    const bankBalance = Math.max(0, parseInt(entryObj.bankBalance, 10) || 0);
    const branchCount = Math.max(0, parseInt(entryObj.branchCount, 10) || 0);
    const franchiseCount = Math.max(0, parseInt(entryObj.franchiseCount, 10) || 0);
    const craftedRecipes = Math.max(0, parseInt(entryObj.craftedRecipes, 10) || 0);
    const petLevel = Math.max(0, parseInt(entryObj.petLevel, 10) || 0);
    const gardenLevel = Math.max(0, parseInt(entryObj.gardenLevel, 10) || 0);
    const decorCount = Math.max(0, parseInt(entryObj.decorCount, 10) || 0);
    const historyLength = Math.max(0, parseInt(entryObj.historyLength, 10) || 0);
    const reviewsLength = Math.max(0, parseInt(entryObj.reviewsLength, 10) || 0);

    const raw = [
      id, name, validDay, validDayRev, validDayServed,
      profit, rev, served,
      staffTip7d, avgUpg,
      crushLevel, capbiLevel,
      star1Count, star5Count,
      money, bankBalance,
      branchCount, franchiseCount,
      craftedRecipes, petLevel,
      gardenLevel, decorCount,
      historyLength, reviewsLength,
      LB_AUTH_SECRET
    ].join('|');
    if(typeof crypto !== 'undefined' && crypto.subtle && typeof TextEncoder !== 'undefined'){
      const enc = new TextEncoder();
      const buf = await crypto.subtle.digest('SHA-256', enc.encode(raw));
      return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
    }
  } catch(e){}
  return '';
}

async function syncMyDailyTopCupSkinFromServer(payloadObj, silent = true){
  try {
    if(!payloadObj) return;
    const checks = [
      { tab: 'staff_tip', col: 'staff_tip7d', val: Number(payloadObj.staffTip7d) || 0, min: 100000 },
      { tab: 'day_rev', col: 'day_rev', val: Number(payloadObj.dayRev) || 0, min: 300000 },
      { tab: 'day_served', col: 'day_served', val: Number(payloadObj.dayServed) || 0, min: 10 },
      { tab: 'crush', col: 'crush_level', val: Number(payloadObj.crushLevel) || 1, min: 5 },
      { tab: 'capbi', col: 'capbi_level', val: Number(payloadObj.capbiLevel) || 0, min: 2 },
      { tab: 'avg_upg', col: 'avg_upg', val: Number(payloadObj.avgUpg) || 0, min: 5 },
      { tab: 'star', col: 'star1_count', val: Number(payloadObj.star1Count) || 0, min: 10 },
      { tab: 'served', col: 'served', val: Number(payloadObj.served) || 0, min: 100 }
    ].filter(c => c.val >= c.min);
    if(checks.length === 0) return;
    const results = await Promise.all(checks.map(async c => {
      try {
        const r = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/leaderboard?select=id&${c.col}=gt.${c.val}&limit=1`, {
          method: 'GET',
          headers: { 'apikey': SUPABASE_CONFIG.anonKey, 'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`, 'Prefer': 'count=exact' }
        });
        if(!r || !r.headers) return null;
        const rng = r.headers.get('content-range');
        if(rng && rng.includes('/')){
          const higher = parseInt(rng.split('/')[1], 10);
          if(!isNaN(higher)) return { tab: c.tab, rank: higher + 1 };
        }
      } catch(_){}
      return null;
    }));
    // Chỉ duy nhất Quán Quân Top 1 (#1) của mỗi bảng mới nhận được 1 Ly Quán Quân (chốt 1 lần/ngày theo chu kỳ reset server)
    const validTop1s = results.filter(x => x && x.rank === 1);
    if(validTop1s.length > 0){
      for(let i = 0; i < validTop1s.length; i++){
        unlockTop1CupSkin(validTop1s[i].tab, i === 0 ? silent : true, 1);
      }
    }
  } catch(_){}
}
window.syncMyDailyTopCupSkinFromServer = syncMyDailyTopCupSkinFromServer;

// Hệ thống Anti-Cheat Trust Score 10 Tầng & Cross-Validation dùng chung đồng nhất 100% giữa:
// (1) Chiều gửi điểm (submitMyLeaderboardScore), (2) Chiều tải BXH (isCheatedClientPlayer), và (3) Trigger SQL trên Supabase (calc_leaderboard_cheat_score).
// Ngưỡng hành động: >= 100 (BAN vĩnh viễn), >= 50 (SHADOWBAN - ẩn khỏi BXH), >= 30 (FLAG), >= 10 (WARN).
function evaluateLeaderboardPlayerCheatScore(p, isLocalSelf = false){
  if(!p || !p.id) return { score: 100, status: 'BAN', reasons: ['missing_id'], triggers: {}, snapshot: {} };
  if(p.owner === 'BANNED' || p.badge === 'BANNED' || String(p.name || '').startsWith('[BANNED]')){
    return { score: 100, status: 'BAN', reasons: ['already_banned'], triggers: {}, snapshot: {} };
  }

  const d = Math.max(1, parseInt(p.day, 10) || 1);
  const prof = Math.max(0, parseInt(p.profit, 10) || 0);
  const rv = Math.max(0, parseInt(p.rev, 10) || 0);
  const sv = Math.max(0, parseInt(p.served, 10) || 0);
  const dRev = Math.max(0, parseInt(p.dayRev != null ? p.dayRev : p.day_rev, 10) || 0);
  const dSv = Math.max(0, parseInt(p.dayServed != null ? p.dayServed : p.day_served, 10) || 0);
  const tip7 = Math.max(0, parseInt(p.staffTip7d != null ? p.staffTip7d : p.staff_tip7d, 10) || 0);
  const upg = Math.max(0, parseFloat(p.avgUpg != null ? p.avgUpg : p.avg_upg) || 0);
  const crush = Math.max(1, parseInt(p.crushLevel != null ? p.crushLevel : p.crush_level, 10) || 1);
  const capbi = Math.max(0, parseInt(p.capbiLevel != null ? p.capbiLevel : p.capbi_level, 10) || 0);
  const s1 = Math.max(0, parseInt(p.star1Count != null ? p.star1Count : p.star1_count, 10) || 0);
  const s5 = Math.max(0, parseInt(p.star5Count != null ? p.star5Count : p.star5_count, 10) || 0);

  const franchiseCount = isLocalSelf && typeof S !== 'undefined' && S && S.franchise && Array.isArray(S.franchise.partners)
    ? S.franchise.partners.length
    : Math.max(0, parseInt(p.franchiseCount != null ? p.franchiseCount : p.franchise_count, 10) || 0);
  const branchCount = isLocalSelf && typeof S !== 'undefined' && S && S.branches
    ? Object.values(S.branches).filter(b => b && (b.bought || b.owned)).length
    : Math.max(0, parseInt(p.branchCount != null ? p.branchCount : p.branch_count, 10) || 0);
  const hasFranchise = franchiseCount > 0 || branchCount > 0;
  const isVeteran = (d >= 60 && s5 >= 20) || (d >= 150);
  const chainCount = franchiseCount + branchCount;
  const effRev = rv + Math.max(hasFranchise ? chainCount * d * 50000000 : 0, isVeteran ? d * 400000000 : 0);
  const effServed = sv + Math.max(hasFranchise ? chainCount * d * 50 : 0, isVeteran ? d * 400 : 0);

  let cheatScore = 0;
  const reasons = [];
  const triggers = {};

  // 1. Trần Lợi nhuận ngày (+15..+100) & Cross-check profit/effRev > 0.75 (0.85 nếu có nhượng quyền / veteran): chấm điểm bất thường (+15..+25), không BAN/Shadowban riêng lẻ
  const profitRatioThreshold = (hasFranchise || isVeteran) ? 0.85 : 0.75;
  const maxAllowedDailyProfit = Math.min(200000000000, 100000000 + d * 80000000);
  if(prof > maxAllowedDailyProfit){
    const w = prof > maxAllowedDailyProfit * 2.5 ? 100 : 25;
    cheatScore += w;
    reasons.push('rule1_profit_cap');
    triggers.rule1_profitCap = { value: prof, cap: maxAllowedDailyProfit, weight: w };
  }
  if(prof > 2000000000 && effRev < prof){
    cheatScore += 100;
    reasons.push('rule1_profit_gt_rev');
    triggers.rule1_profitGtRev = { profit: prof, rev: effRev, weight: 100 };
  } else if(prof > 100000000 && effRev > 0 && (prof / effRev) > profitRatioThreshold){
    const w = (prof > 2000000000 || d >= 5) ? 25 : 15;
    cheatScore += w;
    reasons.push('rule1_profit_rev_ratio');
    triggers.rule1_profitRevRatio = { value: +(prof / effRev).toFixed(3), cap: profitRatioThreshold, weight: w };
  }

  // 2. Trần Doanh thu tích lũy & Đơn giá trung bình cả đời (+20..+100)
  if(rv > 10000000000000){
    cheatScore += 100;
    reasons.push('rule2_rev_cap_10T');
    triggers.rule2_revCap = { value: rv, cap: 10000000000000, weight: 100 };
  }
  if(effServed > 0 && rv > 20000000000 && (rv / effServed) > 1500000){
    const w = (rv / effServed) > 3000000 ? 100 : 50;
    cheatScore += w;
    reasons.push('rule2_avg_price_gt_1.5M');
    triggers.rule2_revRatio = { value: Math.round(rv / effServed), cap: 1500000, weight: w };
  } else if(effServed > 0 && rv > 20000000000 && (rv / effServed) > 950000){
    cheatScore += 20;
    reasons.push('rule2_avg_price_warn');
    triggers.rule2_revRatioWarn = { value: Math.round(rv / effServed), cap: 950000, weight: 20 };
  }
  if(effServed === 0 && rv > 50000000){
    cheatScore += 50;
    reasons.push('rule2_rev_without_served');
    triggers.rule2_revNoServed = { value: rv, served: 0, weight: 50 };
  }

  // 3. Trần vật lý số ly & đơn giá ngày (đánh giá trên số liệu thô chưa bị cắt ngưỡng, trần đơn giá ngày tăng động theo ngày chơi từ 300k lên 420k/ly):
  const maxAllowedServed = Math.min(7000, Math.round(500 + d * 2.5));
  if(dSv > maxAllowedServed){
    const w = dSv > maxAllowedServed * 1.15 ? 100 : 35;
    cheatScore += w;
    reasons.push('rule3_day_served_ceiling');
    triggers.rule3_dayServed = { value: dSv, cap: maxAllowedServed, weight: w };
  }
  const dynamicDayCupCap = typeof getDynamicDayCupRevCap === 'function' ? getDynamicDayCupRevCap(d) : Math.min(420000, Math.round(300000 + Math.max(0, d - 1) * 60));
  const dayAvgCupPrice = dSv > 0 ? (dRev / dSv) : 0;
  if(dSv > 0 && dayAvgCupPrice > 420000){
    const w = dayAvgCupPrice > 600000 ? 100 : 50;
    cheatScore += w;
    reasons.push('rule3_day_avg_price_verified_cap');
    triggers.rule3_dayAvgPrice = { value: Math.round(dayAvgCupPrice), cap: 420000, weight: w };
  } else if(dSv > 0 && dayAvgCupPrice > Math.max(360000, dynamicDayCupCap + 30000)){
    cheatScore += 25;
    reasons.push('rule3_day_avg_price_check');
    triggers.rule3_dayAvgPrice = { value: Math.round(dayAvgCupPrice), cap: Math.max(360000, dynamicDayCupCap + 30000), weight: 25 };
  } else if(dSv > 0 && dayAvgCupPrice > dynamicDayCupCap){
    cheatScore += 15;
    reasons.push('rule3_day_avg_price_warn');
    triggers.rule3_dayAvgPriceWarn = { value: Math.round(dayAvgCupPrice), cap: dynamicDayCupCap, weight: 15 };
  }
  if(dSv === 0 && dRev > 0){
    cheatScore += 25;
    reasons.push('rule3_day_rev_zero_served');
    triggers.rule3_dayRevZeroServed = { value: dRev, weight: 25 };
  }
  if(d >= 3 && effServed >= 100 && dSv > effServed){
    cheatScore += 50;
    reasons.push('rule3_day_served_gt_total');
    triggers.rule3_dayServedGtTotal = { dayServed: dSv, served: effServed, weight: 50 };
  }

  // 4. Tiền Bo Nhân Viên 7 Ngày (Ngưỡng động theo sản lượng ly maxAllowedServed <= 7000 -> tối đa hiệu dụng 7000 * 7 * 55000 = 2.695.000.000đ, sàn 1.500.000.000đ):
  const dynamicTip7dCap = Math.max(1500000000, Math.min(2695000000, Math.round(maxAllowedServed * 7 * 55000)));
  if(tip7 > dynamicTip7dCap){
    const w = (tip7 > dynamicTip7dCap * 2 || tip7 > 5000000000) ? 100 : 35;
    cheatScore += w;
    reasons.push('rule4_tip7d_dynamic_cap');
    triggers.rule4_tipCap = { value: tip7, cap: dynamicTip7dCap, weight: w };
  } else if(tip7 > 1200000000 && d < 30){
    cheatScore += 25;
    reasons.push('rule4_tip7d_early_high');
    triggers.rule4_tipEarlyWarn = { value: tip7, day: d, weight: 25 };
  }
  const avgHistoricalTip7d = (effRev / Math.max(1, d)) * 7 * 0.18;
  if(tip7 > 150000000 && effRev < tip7 * 1.5 && d > 30 && tip7 > avgHistoricalTip7d * 6){
    cheatScore += 35;
    reasons.push('rule4_tip7d_ratio');
    triggers.rule4_tipRatio = { tip7d: tip7, rev: effRev, minRevRequired: Math.round(tip7 * 1.5), weight: 35 };
  } else if(tip7 > 100000000 && effRev < tip7 * 2.5 && d > 30 && tip7 > avgHistoricalTip7d * 5){
    cheatScore += 15;
    reasons.push('rule4_tip7d_ratio_warn');
    triggers.rule4_tipRatioWarn = { tip7d: tip7, rev: effRev, weight: 15 };
  }
  const est7dCups = Math.max(dSv * 7, Math.min(effServed, maxAllowedServed * 7), 1);
  const tipPerCupEst = tip7 / est7dCups;
  if(tip7 > 150000000 && effServed > 0 && tipPerCupEst > 65000 && (tip7 / effServed) > 55000){
    const w = (tipPerCupEst > 120000 && (tip7 / effServed) > 90000) ? 35 : 20;
    cheatScore += w;
    reasons.push('rule4_tip7d_per_cup_check');
    triggers.rule4_tipPerCup = { value: Math.round(tipPerCupEst), cap: 65000, weight: w };
  }

  // 5. Đột Phá Cấp Cao (Hybrid Approach: Trần tuyệt đối 80 + Trần động log10 * 12 theo effRev & effServed)
  const revCap = 40 + Math.log10(Math.max(1, effRev / 1e9)) * 12;
  const servedCap = 40 + Math.log10(Math.max(1, effServed / 1e4)) * 12;
  const dynamicCap = Math.min(80, Math.ceil(Math.min(revCap, servedCap)));
  const minRev55 = (hasFranchise || isVeteran) ? 50000000000 : 150000000000;
  const minRev50 = (hasFranchise || isVeteran) ? 15000000000 : 50000000000;
  const minRev35 = (hasFranchise || isVeteran) ? 500000000 : 2000000000;
  const minServed55 = (hasFranchise || isVeteran) ? 120000 : 250000;
  const minServed50 = (hasFranchise || isVeteran) ? 50000 : 100000;
  const minServed35 = (hasFranchise || isVeteran) ? 5000 : 10000;
  if(upg > 80){
    cheatScore += 100;
    reasons.push('rule5_upg_hard_cap_80');
    triggers.rule5_hardCap = { value: upg, cap: 80, weight: 100 };
  }
  if(upg > dynamicCap){
    cheatScore += 100;
    reasons.push('rule5_upg_dynamic_cap');
    triggers.rule5_avgUpg = { value: upg, cap: dynamicCap, revCap: +revCap.toFixed(1), servedCap: +servedCap.toFixed(1), weight: 100 };
  }
  if(upg > 55 && (effRev < minRev55 || effServed < minServed55)){
    cheatScore += 100;
    reasons.push('rule5_upg_gt_55');
    triggers.rule5_tier55 = { value: upg, rev: effRev, served: effServed, minRev55, minServed55, weight: 100 };
  }
  if(upg > 50 && (effRev < minRev50 || effServed < minServed50)){
    cheatScore += 100;
    reasons.push('rule5_upg_gt_50');
    triggers.rule5_tier50 = { value: upg, rev: effRev, served: effServed, minRev50, minServed50, weight: 100 };
  }
  if(upg >= 35 && (effRev < minRev35 || effServed < minServed35)){
    cheatScore += 100;
    reasons.push('rule5_upg_gt_35');
    triggers.rule5_tier35 = { value: upg, rev: effRev, served: effServed, minRev35, minServed35, weight: 100 };
  }
  if(isVeteran && !hasFranchise && upg > 50 && (effRev < 50000000000 || effServed < 100000) && s5 < 20){
    cheatScore += 100;
    reasons.push('rule5_veteran_no_star5');
    triggers.rule5_veteranNoStar5 = { avgUpg: upg, day: d, star5Count: s5, weight: 100 };
  }

  // 6. Rèn Luyện Cáp Pi & Milk Tea Crush (+30..+100)
  const maxAllowedCapbi = Math.min(80, Math.round(12 + d * 0.22));
  if(capbi > maxAllowedCapbi){
    const w = capbi > 80 ? 100 : (capbi > maxAllowedCapbi + 3 ? 50 : 30);
    cheatScore += w;
    reasons.push('rule6_capbi_day_cap');
    triggers.rule6_capbiCap = { value: capbi, cap: maxAllowedCapbi, weight: w };
  }
  if(capbi >= 25 && d < 90 && (effServed < capbi * 800 || effRev < capbi * 150000000)){
    cheatScore += 50;
    reasons.push('rule6_capbi_econ');
    triggers.rule6_capbiEcon = { value: capbi, served: effServed, rev: effRev, day: d, weight: 50 };
  }
  const maxAllowedCrush = Math.min(280, Math.round(30 + d * 1.1));
  if(crush > maxAllowedCrush){
    const w = crush > 280 ? 100 : (crush > maxAllowedCrush + 10 ? 50 : 30);
    cheatScore += w;
    reasons.push('rule6_crush_day_cap');
    triggers.rule6_crushCap = { value: crush, cap: maxAllowedCrush, weight: w };
  }
  if(crush > 50 && effServed < crush * 30){
    cheatScore += 30;
    reasons.push('rule6_crush_served');
    triggers.rule6_crushServed = { value: crush, served: effServed, weight: 30 };
  }

  // 7. Tua Ngày Ảo (Skip Day -> +50..+100; trần ngày 10000 hỗ trợ người chơi kỳ cựu)
  if(d > 10000){
    cheatScore += 100;
    reasons.push('rule7_day_gt_10000');
    triggers.rule7_dayCap = { value: d, cap: 10000, weight: 100 };
  }
  if(d > 300 && effServed < d * 150 && (upg > 30 || dSv > 1200)){
    cheatScore += 50;
    reasons.push('rule7_skip_day_300');
    triggers.rule7_skipDay300 = { day: d, served: effServed, minServed: d * 150, weight: 50 };
  }
  if(d > 400 && (effServed < d * 350 || effRev < d * 80000000) && (upg > 30 || dSv > 1400)){
    cheatScore += 50;
    reasons.push('rule7_skip_day_400');
    triggers.rule7_skipDay400 = { day: d, served: effServed, rev: effRev, weight: 50 };
  }

  // 8. Tỷ Lệ Đánh Giá 1★ / 5★ (+20..+100)
  const maxAllowed1Stars = Math.min(5000, 50 + d * 10);
  if(s1 > maxAllowed1Stars){
    const w = s1 > 5000 ? 100 : 50;
    cheatScore += w;
    reasons.push('rule8_star1_cap');
    triggers.rule8_star1Cap = { value: s1, cap: maxAllowed1Stars, weight: w };
  }
  if(s5 > Math.min(80000, 200 + d * 500) && s5 > d * 500){
    cheatScore += 20;
    reasons.push('rule8_star5_cap');
    triggers.rule8_star5Cap = { value: s5, cap: Math.min(80000, 200 + d * 500), weight: 20 };
  }
  if(effServed > 200000 && s5 < 50){
    cheatScore += 20;
    reasons.push('rule8_star5_corrupted');
    triggers.rule8_star5Corrupted = { served: effServed, star5: s5, weight: 20 };
  }
  if((s1 + s5) > 500 && effServed > 0 && (s1 + s5) > effServed * 0.95 && s5 > (200 + d * 500)){
    cheatScore += 50;
    reasons.push('rule8_reviews_gt_served');
    triggers.rule8_reviewsGtServed = { reviews: s1 + s5, served: effServed, weight: 50 };
  }

  // 9. Kiểm tra Tài sản Két + Ngân hàng & Tiến trình Chuỗi / Công thức (đồng bộ 100% Client - Server SQL)
  const money = isLocalSelf && typeof S !== 'undefined' && S ? Math.max(0, parseInt(S.money, 10) || 0) : Math.max(0, parseInt(p.money, 10) || 0);
  const bank = isLocalSelf && typeof S !== 'undefined' && S && S.bank ? Math.max(0, parseInt(S.bank.balance, 10) || 0) : Math.max(0, parseInt(p.bankBalance != null ? p.bankBalance : p.bank_balance, 10) || 0);
  const craftedCount = isLocalSelf && typeof S !== 'undefined' && S && S.collection && S.collection.craftedRecipes
    ? Object.keys(S.collection.craftedRecipes).filter(k => S.collection.craftedRecipes[k]).length
    : Math.max(0, parseInt(p.craftedRecipes != null ? p.craftedRecipes : p.crafted_recipes, 10) || 0);

  const maxWealth = Math.min(50000000000000, 2000000000 + d * 2000000000);
  if((money + bank) > maxWealth){
    cheatScore += 40;
    reasons.push('rule9_wealth_cap');
    triggers.rule9_wealthCap = { value: money + bank, cap: maxWealth, weight: 40 };
  }
  if(d >= 3 && (money + bank) > Math.max(500000000000, effRev * 12)){
    cheatScore += 40;
    reasons.push('rule9_wealth_ratio');
    triggers.rule9_wealthRatio = { value: money + bank, money, bank, rev: effRev, weight: 40 };
  }
  if(d < 5 && branchCount > 0){
    cheatScore += 40;
    reasons.push('rule9_branch_early');
    triggers.rule9_branchEarly = { value: branchCount, day: d, weight: 40 };
  }
  if(d < 10 && franchiseCount > 0){
    cheatScore += 40;
    reasons.push('rule9_franchise_early');
    triggers.rule9_franchiseEarly = { value: franchiseCount, day: d, weight: 40 };
  }
  if(d < 5 && effServed < 200 && craftedCount > 10){
    cheatScore += 40;
    reasons.push('rule9_recipes_early');
    triggers.rule9_recipesEarly = { value: craftedCount, day: d, weight: 40 };
  }

  // 10. Kiểm tra Trạng thái Mở rộng: Pet, Vườn Trà, Decor, Lịch sử & Đánh giá (đồng bộ 100% Client - Server SQL)
  const petLv = isLocalSelf && typeof S !== 'undefined' && S && S.pet ? Math.max(0, parseInt(S.pet.level, 10) || 0) : Math.max(0, parseInt(p.petLevel != null ? p.petLevel : p.pet_level, 10) || 0);
  const gardenLv = isLocalSelf && typeof S !== 'undefined' && S && S.garden ? Math.max(0, parseInt(S.garden.level, 10) || 0) : Math.max(0, parseInt(p.gardenLevel != null ? p.gardenLevel : p.garden_level, 10) || 0);
  const decorCount = isLocalSelf && typeof S !== 'undefined' && S && S.decor
    ? Object.keys(S.decor).filter(k => S.decor[k]).length
    : Math.max(0, parseInt(p.decorCount != null ? p.decorCount : p.decor_count, 10) || 0);
  const historyLength = isLocalSelf && typeof S !== 'undefined' && S && Array.isArray(S.history)
    ? S.history.length
    : Math.max(0, parseInt(p.historyLength != null ? p.historyLength : p.history_length, 10) || 0);
  const reviewsLength = isLocalSelf && typeof S !== 'undefined' && S && Array.isArray(S.reviews)
    ? S.reviews.length
    : Math.max(0, parseInt(p.reviewsLength != null ? p.reviewsLength : p.reviews_length, 10) || 0);

  const petMaxLv = Math.min(100, Math.round(5 + d * 0.3));
  if(petLv > petMaxLv){
    const w = petLv > 100 ? 50 : 20;
    cheatScore += w;
    reasons.push('rule10_pet_level');
    triggers.rule10_petLevel = { value: petLv, cap: petMaxLv, weight: w };
  }
  const gardenMaxLv = Math.min(50, Math.round(3 + d * 0.15));
  if(gardenLv > gardenMaxLv){
    const w = gardenLv > 50 ? 50 : 20;
    cheatScore += w;
    reasons.push('rule10_garden_level');
    triggers.rule10_gardenLevel = { value: gardenLv, cap: gardenMaxLv, weight: w };
  }
  const decorMaxCount = Math.min(30, Math.round(d / 3) + 5);
  if(decorCount > decorMaxCount){
    cheatScore += 20;
    reasons.push('rule10_decor_count');
    triggers.rule10_decorCount = { value: decorCount, cap: decorMaxCount, weight: 20 };
  }
  if(decorCount > 0 && effRev < decorCount * 2500000 && d < 10){
    cheatScore += 20;
    reasons.push('rule10_decor_no_rev');
    triggers.rule10_decorNoRev = { decorCount, rev: effRev, day: d, weight: 20 };
  }
  if(historyLength > d + 30){
    const w = historyLength > d + 100 ? 50 : 20;
    cheatScore += w;
    reasons.push('rule10_history_overflow');
    triggers.rule10_historyLength = { value: historyLength, cap: d + 30, weight: w };
  }
  if(effServed > 0 && reviewsLength > effServed * 1.8 && reviewsLength > 100){
    const w = reviewsLength > effServed * 3 ? 50 : 20;
    cheatScore += w;
    reasons.push('rule10_reviews_overflow');
    triggers.rule10_reviewsLength = { value: reviewsLength, cap: Math.round(effServed * 1.8), weight: w };
  }

  // Cheat Score Decay: Nếu player đã CLEAN trong >= 30 ngày liên tiếp, giảm nhẹ (-5 điểm / 30 ngày) nếu chưa tới mức BAN
  const cleanStreak = p.lastCheatFlagAt ? Math.floor((Date.now() - Number(p.lastCheatFlagAt)) / (86400 * 1000)) : 0;
  if(cleanStreak >= 30 && cheatScore > 0 && cheatScore < 100){
    cheatScore = Math.max(0, cheatScore - Math.floor(cleanStreak / 30) * 5);
  }

  const status = cheatScore >= 100 ? 'BAN' : (cheatScore >= 50 ? 'SHADOWBAN' : (cheatScore >= 30 ? 'FLAG' : (cheatScore >= 10 ? 'WARN' : 'CLEAN')));
  const snapshot = { rev: rv, effRev, served: sv, effServed, profit: prof, dayRev: dRev, dayServed: dSv, staffTip7d: tip7, avgUpg: upg, crushLevel: crush, capbiLevel: capbi, star1Count: s1, star5Count: s5, money, bankBalance: bank, branchCount, franchiseCount, craftedRecipes: craftedCount, petLevel: petLv, gardenLevel: gardenLv, decorCount, historyLength, reviewsLength };

  if(isLocalSelf && typeof S !== 'undefined' && S){
    S._shadowbanned = (cheatScore >= 50);
    S._banned = (cheatScore >= 100);
  }

  // if(cheatScore >= 10){
  //   console.warn('[ANTI-CHEAT]', {
  //     playerId: p.id,
  //     playerName: p.name,
  //     day: d,
  //     status: status,
  //     cheatScore: cheatScore,
  //     reasons: reasons,
  //     triggers: triggers,
  //     snapshot: snapshot
  //   });
  // }
  return { score: cheatScore, status, reasons, triggers, snapshot };
}

async function submitMyLeaderboardScore(silent = false){
  const now = Date.now();
  if(!silent){
    const lastManual = Number(localStorage.getItem('ts_last_manual_lb_sync')) || 0;
    const cooldownLeft = Math.ceil((3 * 1000 - (now - lastManual)) / 1000);
    if(cooldownLeft > 0){
      toast(`⏳ Vui lòng chờ ${cooldownLeft}s để gửi lại điểm! Đang làm mới danh sách...`);
      return null;
    }
  }

  try {
    try { S.totalProfit = calcTotalProfit(); } catch(e){}
    const key = String(ensurePlayerCloudKey() || '').trim();
    const servedCups = Math.max(0, parseInt(S.served != null ? S.served : (S.best || 0), 10) || 0);
    const validDay = Math.max(1, parseInt(S.day, 10) || 1);
    const avg7Profit = Math.max(0, parseInt(calc7DayAvgProfit(), 10) || 0);
    // Lấy số liệu THÔ (chưa bị cắt ngưỡng) để chấm điểm Anti-Cheat chính xác trước khi chuẩn hóa gửi lên Supabase
    const rawOneStarReviews = Math.max(0, parseInt(getOneStarReviewCount(), 10) || 0);
    const rawStar5Count = Math.max(0, parseInt(S.star5Count, 10) || 0);
    const staffTip7dVal = Math.max(0, parseInt(calc7DayStaffTips(), 10) || 0);
    const rawAvgUpgVal = Math.max(0, parseFloat(calcAvgUpgLevel()) || 0);
    const rawShopTitle = (typeof shopName === 'function' ? shopName() : (S.shopName || 'Tiệm Trà Mơ Ước'));
    const shopTitle = String(rawShopTitle || 'Tiệm Trà Mơ Ước').trim().slice(0, 32) || 'Tiệm Trà Mơ Ước';

    const curDayRev = (typeof recRev === 'function' ? recRev(S.cur) : 0) || (R && R.today && Number(R.today.rev)) || 0;
    const bestDayStats = (typeof calcEffectiveBestDayStats === 'function') ? calcEffectiveBestDayStats() : { dayServed: S.bestDayServed || 0, dayRev: S.bestDayRev || 0 };
    const rawDayRev = Math.max(0, parseInt(Number(bestDayStats.dayRev) || Number(S.bestDayRev) || curDayRev || 0, 10) || 0);
    const rawDayServed = Math.max(0, parseInt(Number(bestDayStats.dayServed) || Number(S.bestDayServed) || (R && R.today && Number(R.today.served)) || 0, 10) || 0);
    const rawCrushLevel = Math.max(1, parseInt(S.crushLevel || localStorage.getItem('tsCrushLevel') || '1', 10) || 1);
    const rawCapbiLevel = Math.max(0, parseInt(S.capbi && S.capbi.unlocked ? (S.capbi.level || 1) : 0, 10) || 0);

    const curMoney = Math.max(0, parseInt(S.money, 10) || 0);
    const curBankBal = Math.max(0, parseInt(S.bank && S.bank.balance, 10) || 0);
    const curBranchCount = Math.max(0, parseInt(S.branches ? Object.values(S.branches).filter(b => b && (b.bought || b.owned)).length : 0, 10) || 0);
    const curFranchiseCount = Math.max(0, parseInt((S.franchise && Array.isArray(S.franchise.partners)) ? S.franchise.partners.length : 0, 10) || 0);
    const curCraftedRecipes = Math.max(0, parseInt((S.collection && S.collection.craftedRecipes) ? Object.keys(S.collection.craftedRecipes).filter(k => S.collection.craftedRecipes[k]).length : 0, 10) || 0);
    const curPetLevel = Math.max(0, parseInt(S.pet && S.pet.level, 10) || 0);
    const curGardenLevel = Math.max(0, parseInt(S.garden && S.garden.level, 10) || 0);
    const curDecorCount = Math.max(0, parseInt(Object.keys(S.decor || {}).filter(k => S.decor[k]).length, 10) || 0);
    const curHistoryLength = Math.max(0, parseInt(S.history && Array.isArray(S.history) && S.history.length, 10) || 0);
    const curReviewsLength = Math.max(0, parseInt(S.reviews && Array.isArray(S.reviews) && S.reviews.length, 10) || 0);

    const payload = {
      id: key,
      name: shopTitle,
      owner: String(S.ownerName || 'Chủ tiệm').trim().slice(0, 20),
      day: validDay,
      star1Count: rawOneStarReviews,
      star5Count: rawStar5Count,
      staffTip7d: staffTip7dVal,
      avgUpg: rawAvgUpgVal,
      profit: avg7Profit,
      rev: Math.max(0, parseInt(S.totalRev, 10) || 0),
      served: servedCups,
      dayRev: rawDayRev,
      dayServed: rawDayServed,
      crushLevel: rawCrushLevel,
      capbiLevel: rawCapbiLevel,
      followers: Math.max(0, parseInt((S.mxh && S.mxh.followers) || 120, 10) || 120),
      avatar: String(typeof getPlayerLeaderboardAvatar === 'function' ? getPlayerLeaderboardAvatar() : 'img/imnv/b00.png').slice(0, 48),
      badge: String(getPlayerRankTitle({ star5Count: rawStar5Count, profit: avg7Profit })).slice(0, 30),
      location: String(getPlayerLocationName()).slice(0, 25),
      money: curMoney,
      bankBalance: curBankBal,
      branchCount: curBranchCount,
      franchiseCount: curFranchiseCount,
      craftedRecipes: curCraftedRecipes,
      petLevel: curPetLevel,
      gardenLevel: curGardenLevel,
      decorCount: curDecorCount,
      historyLength: curHistoryLength,
      reviewsLength: curReviewsLength
    };

    payload.sig = await calcLeaderboardSignature(payload);

    // 1. Chấm điểm trên dữ liệu THÔ chưa bị cắt trước khi quyết định gửi lên Supabase
    const checkCheatedBeforeSubmit = (p) => {
      const res = evaluateLeaderboardPlayerCheatScore(p, true);
      if(res.score >= 50){
        p._shadowbanned = true;
        if(typeof S !== 'undefined' && S){
          S._shadowbanned = true;
          S._banned = (res.score >= 100);
        }
      }
      return res.score >= 50 || !!(typeof S !== 'undefined' && S && S._banned);
    };
    if(checkCheatedBeforeSubmit(payload)){
      return payload;
    }

    // 2. Sau khi vượt qua kiểm tra Anti-Cheat (score < 50), chuẩn hóa dữ liệu trong giới hạn hợp lệ theo ngày chơi (300.000đ -> 420.000đ/ly) và gửi đầy đủ 23 trường lên Supabase
    const sbSafeDay = Math.min(10000, validDay);
    const sbMaxServed = Math.min(7000, Math.round(500 + sbSafeDay * 2.5));
    const sbDayServed = Math.min(rawDayServed, sbMaxServed);
    const sbDayCupCap = typeof getDynamicDayCupRevCap === 'function' ? getDynamicDayCupRevCap(sbSafeDay) : Math.min(420000, Math.round(300000 + Math.max(0, sbSafeDay - 1) * 60));
    const sbDayRev = sbDayServed > 0 ? Math.min(rawDayRev, Math.round(sbDayServed * sbDayCupCap)) : 0;
    const sbOneStar = Math.min(5000, rawOneStarReviews);
    const sbStar5 = Math.min(80000, rawStar5Count);
    const sbAvgUpg = Math.min(80.0, rawAvgUpgVal);
    const sbCrush = Math.min(Math.min(280, Math.round(30 + sbSafeDay * 1.1)), rawCrushLevel);
    const sbCapbi = Math.min(Math.min(80, Math.round(12 + sbSafeDay * 0.22)), rawCapbiLevel);

    const payloadSBCore = {
      id: key,
      name: shopTitle,
      owner: (S.ownerName || 'Chủ tiệm').slice(0, 20),
      day: sbSafeDay,
      profit: avg7Profit,
      rev: Math.max(0, parseInt(S.totalRev, 10) || 0),
      served: Math.max(0, servedCups),
      day_rev: sbDayRev,
      day_served: sbDayServed,
      star5_count: sbStar5,
      star1_count: sbOneStar,
      staff_tip7d: staffTip7dVal,
      avg_upg: sbAvgUpg,
      crush_level: sbCrush,
      capbi_level: sbCapbi,
      followers: ((S.mxh && S.mxh.followers) || 120),
      avatar: (typeof getPlayerLeaderboardAvatar === 'function' ? getPlayerLeaderboardAvatar() : 'img/imnv/b00.png'),
      badge: getPlayerRankTitle({ star5Count: sbStar5, profit: avg7Profit }),
      location: getPlayerLocationName(),
      updated_at: new Date().toISOString()
    };

    const payloadSB = {
      ...payloadSBCore,
      money: curMoney,
      bank_balance: curBankBal,
      branch_count: curBranchCount,
      franchise_count: curFranchiseCount,
      crafted_recipes: curCraftedRecipes,
      pet_level: curPetLevel,
      garden_level: curGardenLevel,
      decor_count: curDecorCount,
      history_length: curHistoryLength,
      reviews_length: curReviewsLength
    };

    let sbRes = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/leaderboard`, {
      method: 'POST',
      headers: {
        'apikey': SUPABASE_CONFIG.anonKey,
        'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`,
        'Content-Type': 'application/json',
        'Prefer': 'resolution=merge-duplicates'
      },
      body: JSON.stringify(payloadSB)
    });

    // Tương thích quá độ nếu DB chưa chạy ALTER TABLE thêm 10 cột mở rộng (HTTP 400 PGRST204)
    if(sbRes.status === 400){
      const errBody = await sbRes.json().catch(() => ({}));
      const errMsg = String(errBody.message || errBody.error || '');
      if(errMsg.includes('column') || errBody.code === 'PGRST204' || errBody.code === '42703'){
        sbRes = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/leaderboard`, {
          method: 'POST',
          headers: {
            'apikey': SUPABASE_CONFIG.anonKey,
            'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`,
            'Content-Type': 'application/json',
            'Prefer': 'resolution=merge-duplicates'
          },
          body: JSON.stringify(payloadSBCore)
        });
      } else {
        throw new Error(errMsg || `Lỗi máy chủ Supabase (${sbRes.status})`);
      }
    }

    if(!sbRes.ok && sbRes.status !== 201 && sbRes.status !== 204){
      const errJson = await sbRes.json().catch(() => ({}));
      throw new Error(errJson.message || errJson.error || `Lỗi máy chủ Supabase (${sbRes.status})`);
    }

    window._lbMemoryCache = {};
    window._lbMemoryCacheTime = {};
    if(!silent){
      localStorage.setItem('ts_last_manual_lb_sync', String(Date.now()));
      toast('🚀 Đã đồng bộ điểm số & chốt thứ hạng lên BXH Online thành công! 🎉');
    }
    try {
      const normalizedLocal = {
        ...payload,
        day: sbSafeDay,
        dayServed: sbDayServed,
        dayRev: sbDayRev,
        star1Count: sbOneStar,
        star5Count: sbStar5,
        avgUpg: sbAvgUpg,
        crushLevel: sbCrush,
        capbiLevel: sbCapbi
      };
      const rawComm = localStorage.getItem('ts_real_players_v1');
      let commList = rawComm ? JSON.parse(rawComm) : [];
      if(!Array.isArray(commList)) commList = [];
      commList = commList.filter(p => p && p.id && !String(p.id).startsWith('bot_') && !p.isBot);
      const idx = commList.findIndex(p => p.id === key);
      if(idx >= 0){
        commList[idx] = { ...commList[idx], ...normalizedLocal };
      } else {
        commList.push(normalizedLocal);
      }
      localStorage.setItem('ts_real_players_v1', JSON.stringify(commList));
    } catch(e){}
    // Chốt Top mỗi ngày vào mỗi lần đồng bộ toàn server và áp dụng Skin Ly tương ứng
    syncMyDailyTopCupSkinFromServer(payload, silent);
    return { success: true };
  } catch(e) {
    console.warn('Lỗi gửi điểm BXH Supabase:', e);
    if(!silent){
      const msg = String(e && e.message ? e.message : e);
      toast((msg.length < 100 && !msg.includes('Failed to fetch') && !msg.includes('NetworkError')) ? `⚠️ ${msg}` : '⚠️ Không thể kết nối máy chủ Bảng Xếp Hạng Supabase, vui lòng kiểm tra mạng!');
    }
    return null;
  }
}

const SERVER_COMMUNITY_PLAYERS = [];

let _lbCurrentTab = 'staff_tip';

async function renderLeaderboardComponent(container, selectedTab = 'staff_tip', isModal = false){
  if(!container) return;
  const myId = ensurePlayerCloudKey();

  container.innerHTML = `
    <div class="lb-wrap">
      <div class="lb-fixed-top">
        <div class="lb-header">
          <div class="lb-header-title-row">
            <div>
              <h2>🏆 BẢNG XẾP HẠNG TOÀN SERVER</h2>
              <div style="font-size:0.75rem;color:#059669;display:flex;align-items:center;gap:4px;margin-top:2px;font-weight:600;"><span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#10b981;box-shadow:0 0 6px #10b981;"></span> Trực tuyến · 100% người chơi thật</div>
            </div>
            ${isModal ? '<button id="lbCloseX" type="button" class="lb-close-x" title="Đóng">✕</button>' : ''}
          </div>
        </div>

        <div class="lb-tabs">
          <button type="button" class="lb-tab-btn ${selectedTab === 'staff_tip' ? 'active' : ''}" id="lbTabStaffTip">
            <span>💵 Tip NV (7N)</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'day_rev' ? 'active' : ''}" id="lbTabDayRev">
            <span>💵 DT Ngày</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'day_served' ? 'active' : ''}" id="lbTabDayServed">
            <span>🥤 Ly Ngày</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'crush' ? 'active' : ''}" id="lbTabCrush">
            <span>🍬 Crush</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'capbi' ? 'active' : ''}" id="lbTabCapbi">
            <span>🦫 Cáp Pi</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'avg_upg' ? 'active' : ''}" id="lbTabAvgUpg">
            <span>⚡ TB Nâng Cấp</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'star' ? 'active' : ''}" id="lbTabStar">
            <span>⭐ 1 Sao</span>
          </button>
          <button type="button" class="lb-tab-btn ${selectedTab === 'served' ? 'active' : ''}" id="lbTabServed">
            <span>🧋 Tổng Ly</span>
          </button>
        </div>

        <!-- Vị trí ghim thứ hạng của bạn & Nút Đồng bộ điểm LÊN TRÊN ĐẦU -->
        <div class="lb-top-me" id="lb-top-me-area">
          <div style="text-align:center;padding:6px;font-size:0.8rem;color:#92400e;">⏳ Đang tính thứ hạng của bạn...</div>
        </div>
      </div>

      <div class="lb-scroll-content" id="lb-content-area">
        <div style="text-align:center;padding:45px 10px;color:#64748b;">
          <div style="font-size:2rem;margin-bottom:8px;animation:spin 1s linear infinite;">⏳</div>
          <p style="font-size:0.88rem;margin:0;">Đang kết nối &amp; tải dữ liệu người chơi thật...</p>
        </div>
      </div>

      <div class="lb-fixed-bottom" id="lb-footer-area">
        ${isModal ? '<button class="big lb-close-btn" id="lbClose">Đóng</button>' : ''}
      </div>
    </div>
  `;

  const wireTabs = () => {
    const bindTab = (id, tabName) => {
      const btn = container.querySelector(id);
      if(btn) btn.onclick = () => isModal ? openLeaderboard(tabName) : paneBxh(tabName);
    };
    bindTab('#lbTabStaffTip', 'staff_tip');
    bindTab('#lbTabDayRev', 'day_rev');
    bindTab('#lbTabDayServed', 'day_served');
    bindTab('#lbTabCrush', 'crush');
    bindTab('#lbTabCapbi', 'capbi');
    bindTab('#lbTabAvgUpg', 'avg_upg');
    bindTab('#lbTabStar', 'star');
    bindTab('#lbTabServed', 'served');

    const closeModal = () => {
      $('card').className = 'card';
      $('modal').hidden = true;
      if(R && R.running && R._pausedByLeaderboard){
        delete R._pausedByLeaderboard;
        resumeGame();
      }
    };
    const closeBtn = container.querySelector('#lbClose');
    if(closeBtn) closeBtn.onclick = closeModal;
    const closeX = container.querySelector('#lbCloseX');
    if(closeX) closeX.onclick = closeModal;
  };
  wireTabs();

  let remoteData = null;
  const now = Date.now();
  window._lbMemoryCache = window._lbMemoryCache || {};
  window._lbMemoryCacheTime = window._lbMemoryCacheTime || {};
  if(window._lbMemoryCache[selectedTab] && (now - (window._lbMemoryCacheTime[selectedTab] || 0) < 60000)){
    remoteData = window._lbMemoryCache[selectedTab];
  } else {
    // Tải trực tiếp từ Supabase PostgreSQL (Máy chủ BXH chính thức duy nhất)
    try {
      const sbOrderMap = {
        'staff_tip': 'staff_tip7d.desc',
        'day_rev': 'day_rev.desc',
        'day_served': 'day_served.desc',
        'crush': 'crush_level.desc',
        'capbi': 'capbi_level.desc',
        'avg_upg': 'avg_upg.desc',
        'star': 'star1_count.desc',
        'served': 'served.desc'
      };
      const orderCol = sbOrderMap[selectedTab] || 'staff_tip7d.desc';
      const sbRes = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/leaderboard?select=*&order=${orderCol}&limit=150`, {
        method: 'GET',
        headers: {
          'apikey': SUPABASE_CONFIG.anonKey,
          'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`
        }
      });
      if(sbRes.ok){
        const rows = await sbRes.json();
        if(Array.isArray(rows) && rows.length > 0){
          remoteData = rows.map(r => ({
            id: r.id,
            name: r.name,
            owner: r.owner,
            day: Number(r.day) || 1,
            profit: Number(r.profit) || 0,
            rev: Number(r.rev) || 0,
            served: Number(r.served) || 0,
            dayRev: Number(r.day_rev) || 0,
            dayServed: Number(r.day_served) || 0,
            star5Count: Number(r.star5_count) || 0,
            star1Count: Number(r.star1_count) || 0,
            staffTip7d: Number(r.staff_tip7d) || 0,
            avgUpg: Number(r.avg_upg) || 0,
            crushLevel: Number(r.crush_level) || 1,
            capbiLevel: Number(r.capbi_level) || 0,
            followers: Number(r.followers) || 120,
            money: Number(r.money) || 0,
            bankBalance: Number(r.bank_balance) || 0,
            branchCount: Number(r.branch_count) || 0,
            franchiseCount: Number(r.franchise_count) || 0,
            craftedRecipes: Number(r.crafted_recipes) || 0,
            petLevel: Number(r.pet_level) || 0,
            gardenLevel: Number(r.garden_level) || 0,
            decorCount: Number(r.decor_count) || 0,
            historyLength: Number(r.history_length) || 0,
            reviewsLength: Number(r.reviews_length) || 0,
            avatar: r.avatar || '🧋',
            badge: r.badge || '',
            location: r.location || ''
          }));
          window._lbMemoryCache[selectedTab] = remoteData;
          window._lbMemoryCacheTime[selectedTab] = now;
        }
      }
    } catch(sbErr) {
      console.warn('Không tải được Leaderboard từ Supabase:', sbErr);
    }

    // Fallback vào bộ nhớ cache phiên nếu mất mạng tạm thời
    if(!remoteData && window._lbMemoryCache[selectedTab]){
      remoteData = window._lbMemoryCache[selectedTab];
    }
  }

  // Bộ lọc BXH phía Client dùng chung chính xác hàm evaluateLeaderboardPlayerCheatScore (đồng bộ 100% giữa Submit, Load và Server SQL)
  const isCheatedClientPlayer = (p) => {
    if(!p || !p.id) return true;
    const isSelf = (String(p.id) === String(myId));
    const res = evaluateLeaderboardPlayerCheatScore(p, isSelf);
    if(res.score >= 50) p._shadowbanned = true;
    return res.score >= 50 || !!p._shadowbanned;
  };

  const playerMap = new Map();

  // Đồng bộ 100% cùng một danh sách giữa mọi máy:
  // Nếu tải thành công dữ liệu từ Server (remoteData), CHỈ sử dụng dữ liệu trực tiếp của Tab đó từ Server,
  // TUYỆT ĐỐI KHÔNG trộn lẫn cache localStorage cũ (ts_real_players_v1) làm lệch BXH giữa các máy!
  if(Array.isArray(remoteData) && remoteData.length > 0){
    remoteData.filter(p => p && p.id && !String(p.id).startsWith('top_') && !String(p.id).startsWith('bot_') && !isCheatedClientPlayer(p)).forEach(p => {
      playerMap.set(p.id, { ...p });
    });
  } else {
    // Chỉ dùng dữ liệu hạt giống dự phòng khi mất kết nối mạng hoàn toàn (Offline Fallback)
    if(Array.isArray(SEED_LEADERBOARD)){
      SEED_LEADERBOARD.filter(p => p && p.id && !String(p.id).startsWith('top_') && !String(p.id).startsWith('bot_') && !isCheatedClientPlayer(p)).forEach(p => {
        playerMap.set(p.id, { ...p });
      });
    }
  }

  // Đảm bảo dữ liệu người chơi hiện tại luôn được chấm điểm trên số liệu thô trước, sau đó mới chuẩn hóa hiển thị nếu hợp lệ
  const myServed = Math.max(0, parseInt(S.served != null ? S.served : (S.best || 0), 10) || 0);
  const myValidDay = Math.max(1, parseInt(S.day, 10) || 1);
  const myOneStar = Math.max(0, parseInt(getOneStarReviewCount(), 10) || 0);
  const myAvg7Profit = Math.max(0, parseInt(calc7DayAvgProfit(), 10) || 0);
  const myStaffTip7d = Math.max(0, parseInt(calc7DayStaffTips(), 10) || 0);
  const myAvgUpg = Math.max(0, parseFloat(calcAvgUpgLevel()) || 0);
  const curSalesTot = (typeof recRev === 'function' ? recRev(S.cur) : 0) || (R && R.today && Number(R.today.rev)) || 0;
  const myBestDayStats = (typeof calcEffectiveBestDayStats === 'function') ? calcEffectiveBestDayStats() : { dayServed: S.bestDayServed || 0, dayRev: S.bestDayRev || 0 };
  let myRawDayServed = Math.max(0, parseInt(Number(myBestDayStats.dayServed) || Number(S.bestDayServed) || (R && R.today && Number(R.today.served)) || 0, 10) || 0);
  let myRawDayRev = Math.max(0, parseInt(Number(myBestDayStats.dayRev) || Number(S.bestDayRev) || curSalesTot || 0, 10) || 0);
  const myMaxAllowedServed = Math.min(7000, Math.round(500 + myValidDay * 2.5));

  const myBranchCount = Math.max(0, parseInt(S.branches ? Object.values(S.branches).filter(b => b && (b.bought || b.owned)).length : 0, 10) || 0);
  const myFranchiseCount = Math.max(0, parseInt((S.franchise && Array.isArray(S.franchise.partners)) ? S.franchise.partners.length : 0, 10) || 0);

  const myEntry = {
    id: myId,
    name: (typeof shopName === 'function' ? shopName() : (S.shopName || 'Tiệm Trà Mơ Ước')),
    owner: `Ngày ${myValidDay}`,
    day: myValidDay,
    star1Count: myOneStar,
    star5Count: Math.max(0, parseInt(S.star5Count, 10) || 0),
    staffTip7d: myStaffTip7d,
    avgUpg: myAvgUpg,
    profit: myAvg7Profit,
    rev: Math.max(0, parseInt(S.totalRev, 10) || 0),
    served: myServed,
    dayRev: myRawDayRev,
    dayServed: myRawDayServed,
    crushLevel: Math.max(1, parseInt(S.crushLevel || localStorage.getItem('tsCrushLevel') || '1', 10) || 1),
    capbiLevel: Math.max(0, parseInt(S.capbi && S.capbi.unlocked ? (S.capbi.level || 1) : 0, 10) || 0),
    followers: ((S.mxh && S.mxh.followers) || 120),
    branchCount: myBranchCount,
    franchiseCount: myFranchiseCount,
    avatar: (typeof getPlayerLeaderboardAvatar === 'function' ? getPlayerLeaderboardAvatar() : 'img/imnv/b00.png'),
    badge: getPlayerRankTitle({ star5Count: (S.star5Count || 0), profit: myAvg7Profit }),
    location: getPlayerLocationName()
  };

  if(!isCheatedClientPlayer(myEntry)){
    const myDayCupCap = typeof getDynamicDayCupRevCap === 'function' ? getDynamicDayCupRevCap(myValidDay) : Math.min(420000, Math.round(300000 + Math.max(0, myValidDay - 1) * 60));
    const existingRemoteMe = playerMap.get(myId);
    if(existingRemoteMe){
      if((existingRemoteMe.dayServed || 0) > myEntry.dayServed){
        myEntry.dayServed = Math.min(myMaxAllowedServed, existingRemoteMe.dayServed || 0);
        S.bestDayServed = Math.max(S.bestDayServed || 0, myEntry.dayServed);
      }
      if((existingRemoteMe.dayRev || 0) > myEntry.dayRev && myEntry.dayServed > 0){
        myEntry.dayRev = Math.min(Math.round(myEntry.dayServed * myDayCupCap), existingRemoteMe.dayRev || 0);
        S.bestDayRev = Math.max(S.bestDayRev || 0, myEntry.dayRev);
      }
    } else if(Array.isArray(remoteData) && remoteData.length > 0 && (Date.now() - (window._lastAutoLbMissingSync || 0) > 15000)){
      // Tự động đẩy ngầm bản ghi hợp lệ lên Supabase nếu mở BXH mà thấy tài khoản chưa có trên Server
      window._lastAutoLbMissingSync = Date.now();
      setTimeout(() => { try { submitMyLeaderboardScore(true); } catch(e){} }, 200);
    }
    if(myEntry.dayServed > myMaxAllowedServed) myEntry.dayServed = myMaxAllowedServed;
    if(myEntry.dayServed > 0 && myEntry.dayRev > myEntry.dayServed * myDayCupCap) myEntry.dayRev = Math.round(myEntry.dayServed * myDayCupCap);
    else if(myEntry.dayServed === 0 && myEntry.dayRev > 0) myEntry.dayRev = 0;
    playerMap.set(myEntry.id, myEntry);
  }

  let list = Array.from(playerMap.values()).filter(p => p && p.id && !String(p.id).startsWith('top_') && !String(p.id).startsWith('bot_'));

  // Lọc và làm sạch dữ liệu bảng xếp hạng: tự động kẹp trần công bằng cho các tài khoản bất thường (nới star5Count = 200 + day * 500 cho Me Két Tinh)
  list.forEach(item => {
    if(item && item.day && item.star5Count != null){
      const maxItemStars = Math.min(80000, 200 + (item.day || 1) * 500);
      if(item.star5Count > maxItemStars){
        item.star5Count = Math.floor(maxItemStars);
      }
    }
    if(item && item.day && item.star1Count != null){
      const maxItem1Stars = Math.min(5000, 50 + (item.day || 1) * 10);
      if(item.star1Count > maxItem1Stars){
        item.star1Count = Math.floor(maxItem1Stars);
      }
    }
  });

  // Sắp xếp danh sách theo từng Tab (kèm tie-breaker id cố định để đồng bộ thứ tự 100% giữa mọi thiết bị)
  list.sort((a, b) => {
    if(selectedTab === 'day_rev'){
      if((b.dayRev || 0) !== (a.dayRev || 0)) return (b.dayRev || 0) - (a.dayRev || 0);
      if((b.served || 0) !== (a.served || 0)) return (b.served || 0) - (a.served || 0);
    } else if(selectedTab === 'day_served'){
      if((b.dayServed || 0) !== (a.dayServed || 0)) return (b.dayServed || 0) - (a.dayServed || 0);
      if((b.served || 0) !== (a.served || 0)) return (b.served || 0) - (a.served || 0);
    } else if(selectedTab === 'crush'){
      if((b.crushLevel || 1) !== (a.crushLevel || 1)) return (b.crushLevel || 1) - (a.crushLevel || 1);
      if((b.served || 0) !== (a.served || 0)) return (b.served || 0) - (a.served || 0);
    } else if(selectedTab === 'capbi'){
      if((b.capbiLevel || 0) !== (a.capbiLevel || 0)) return (b.capbiLevel || 0) - (a.capbiLevel || 0);
      if((b.served || 0) !== (a.served || 0)) return (b.served || 0) - (a.served || 0);
    } else if(selectedTab === 'avg_upg'){
      if((b.avgUpg || 0) !== (a.avgUpg || 0)) return (b.avgUpg || 0) - (a.avgUpg || 0);
      if((b.served || 0) !== (a.served || 0)) return (b.served || 0) - (a.served || 0);
    } else if(selectedTab === 'star'){
      const aStars = (a.star1Count != null ? a.star1Count : 0);
      const bStars = (b.star1Count != null ? b.star1Count : 0);
      if(bStars !== aStars) return bStars - aStars;
      if((b.day || 0) !== (a.day || 0)) return (b.day || 0) - (a.day || 0);
    } else if(selectedTab === 'served'){
      if((b.served || 0) !== (a.served || 0)) return (b.served || 0) - (a.served || 0);
    } else { // 'staff_tip' or default
      if((b.staffTip7d || 0) !== (a.staffTip7d || 0)) return (b.staffTip7d || 0) - (a.staffTip7d || 0);
      if((b.rev || 0) !== (a.rev || 0)) return (b.rev || 0) - (a.rev || 0);
    }
    return String(a.id || '').localeCompare(String(b.id || ''));
  });

  const top50 = list.slice(0, 50);
  let myRank = list.findIndex(x => x.id === myId) + 1;

  // Nếu người chơi nằm ngoài Top 50, tính chính xác thứ hạng toàn server từ Supabase
  if(myRank === 0 || myRank > 50){
    try {
      const sbColMap = {
        'staff_tip': ['staff_tip7d', myEntry.staffTip7d || 0],
        'day_rev': ['day_rev', myEntry.dayRev || 0],
        'day_served': ['day_served', myEntry.dayServed || 0],
        'crush': ['crush_level', myEntry.crushLevel || 1],
        'capbi': ['capbi_level', myEntry.capbiLevel || 0],
        'avg_upg': ['avg_upg', myEntry.avgUpg || 0],
        'star': ['star1_count', myEntry.star1Count || 0],
        'served': ['served', myEntry.served || 0]
      };
      const [colName, myScoreVal] = sbColMap[selectedTab] || ['staff_tip7d', myEntry.staffTip7d || 0];
      const cntRes = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/leaderboard?select=id&${colName}=gt.${myScoreVal}&limit=1`, {
        method: 'GET',
        headers: {
          'apikey': SUPABASE_CONFIG.anonKey,
          'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`,
          'Prefer': 'count=exact'
        }
      });
      const rangeHeader = cntRes.headers && cntRes.headers.get('content-range');
      if(rangeHeader && rangeHeader.includes('/')){
        const higherCount = parseInt(rangeHeader.split('/')[1], 10);
        if(!isNaN(higherCount)){
          myRank = Math.max(myRank, higherCount + 1);
        }
      }
    } catch(e){}
  }

  const top1 = top50[0] || null;
  const top2 = top50[1] || null;
  const top3 = top50[2] || null;

  // Chốt Top 1 (#1) mỗi ngày 1 lần theo chu kỳ reset tự động BXH toàn server (00:00 UTC = 07:00 sáng giờ VN)
  const isMyTop1Here = (myRank === 1 && top1 && top1.id === myId);
  const isMyTop1DayRev = (myEntry.dayRev >= 300000 && list.length > 0 && list.every(x => (x.dayRev || 0) <= myEntry.dayRev));
  const isMyTop1DayServed = (myEntry.dayServed >= 10 && list.length > 0 && list.every(x => (x.dayServed || 0) <= myEntry.dayServed));
  if(isMyTop1Here){
    unlockTop1CupSkin(selectedTab, true, 1);
  } else if(isMyTop1DayRev || isMyTop1DayServed){
    unlockTop1CupSkin(isMyTop1DayRev ? 'day_rev' : 'day_served', true, 1);
  }

  window.renderLbCupSkinBarHtml = () => {
    const unlockedList = getUnlockedTop1CupSkins();
    const unlockedAny = unlockedList.length > 0;
    const curSkin = unlockedAny ? ((typeof S !== 'undefined' && S && S.cupSkin) ? S.cupSkin : 'auto') : 'locked';
    const activeAutoObj = getResolvedCupSkinObj('auto') || TOP1_CUP_SKIN_LIST[0];
    const activeResolved = getResolvedCupSkinObj();
    const items = [
      {
        id: 'auto',
        isAuto: true,
        rankLabel: 'Tự động',
        name: 'Theo Top 1',
        icon: '✨',
        svg: activeAutoObj ? activeAutoObj.svg : 'cups/tet.svg',
        buffShort: activeAutoObj ? activeAutoObj.buffShort : 'Tự động Buff',
        desc: 'Tự động trang bị Ly Quán Quân Top 1 mới nhất bạn đã chốt'
      },
      ...TOP1_CUP_SKIN_LIST,
      {
        id: 'default',
        isDefault: true,
        rankLabel: 'Cơ bản',
        name: 'Ly Mặc Định',
        icon: '🥤',
        svg: null,
        buffShort: 'Không Buff',
        desc: 'Ly nhựa trong suốt tiêu chuẩn (không áp dụng Buff)'
      }
    ];
    return `
      <div class="lb-cup-skin-bar" id="lbCupSkinBar">
        <div class="lb-cup-skin-head">
          <div class="lb-cup-skin-title">
            <span>👑 LY QUÁN QUÂN TOP 1 &amp; BUFF ĐỘC QUYỀN (CHỐT 07:00 SÁNG)</span>
          </div>
          <span class="lb-cup-skin-badge ${unlockedAny ? 'unlocked' : 'locked'}">
            ${unlockedAny
              ? `✅ Đã mở ${unlockedList.length}/7 ly · Đang dùng: ${activeResolved ? activeResolved.icon + ' ' + esc(activeResolved.name) + ' (' + esc(activeResolved.buffShort) + ')' : '🥤 Ly Mặc Định'}`
              : '🔒 Chỉ Top 1 (#1) mỗi bảng nhận 1 Ly + Buff riêng · Top 1 Tip NV nhận Ly Random'}
          </span>
        </div>
        <div class="lb-cup-skin-scroll">
          ${items.map(it => {
            const itemUnlocked = isCupSkinItemUnlocked(it.id);
            const isSel = itemUnlocked && curSkin === it.id;
            const pillText = it.isAuto ? 'Tự động' : (it.isDefault ? 'Mặc định' : (it.rankLabel || 'Top 1'));
            const rankTag = `<span class="lb-cup-rank-pill ${it.isDefault ? 'rank-4' : 'rank-1'}">${esc(pillText)}</span>`;
            const tooltip = it.buffDesc ? `${it.rankLabel} — ${it.name}: ${it.buffDesc} (Top 1 Tip NV có cơ hội quay trúng)` : (it.desc || it.name);
            return `
              <button type="button" class="lb-cup-skin-item ${isSel ? 'active' : ''} ${!itemUnlocked ? 'is-locked' : ''}" onclick="window.selectTop1CupSkin('${it.id}')" title="${esc(tooltip)}">
                <div class="lb-cup-mini-thumb">
                  ${rankTag}
                  <img src="${IMG}cup.png" alt="" class="lb-cup-base-img">
                  ${it.svg ? `<img src="${it.svg}?v=${GAME_VERSION}" alt="" class="lb-cup-art-img" onerror="if(!this.dataset.fb){this.dataset.fb='1';this.src='img/'+this.getAttribute('src');}">` : ''}
                  ${isSel ? `<span class="lb-cup-check">✓</span>` : (!itemUnlocked ? `<span class="lb-cup-lock-ic">🔒</span>` : '')}
                </div>
                <span class="lb-cup-skin-name">${it.icon} ${esc(it.name)}</span>
                <span class="lb-cup-skin-buff">${esc(it.buffShort || '')}</span>
              </button>
            `;
          }).join('')}
        </div>
      </div>
    `;
  };

  const getRankCupBadgeHtml = (rank) => {
    if(rank !== 1) return ''; // Chỉ Top 1 (#1) mỗi bảng mới nhận được 1 Ly Quán Quân
    const sk = getCupSkinByTab(selectedTab);
    if(!sk) return '';
    if(selectedTab === 'staff_tip'){
      return `<span class="lb-top1-cup-tag rank-1" title="Top 1 Tip NV (7N) nhận 1 Ly Quán Quân Random mỗi ngày vào lúc reset BXH! Hôm nay: ${esc(sk.name)} (${esc(sk.buffShort)})"><img src="${sk.svg}?v=${GAME_VERSION}" alt="" onerror="this.src='img/${sk.svg}'"> 🎲 Ly Random · ${esc(sk.buffShort)}</span>`;
    }
    return `<span class="lb-top1-cup-tag rank-1" title="${esc(sk.buffDesc || sk.desc)}"><img src="${sk.svg}?v=${GAME_VERSION}" alt="" onerror="this.src='img/${sk.svg}'"> ${sk.icon} ${esc(sk.name)} · ${esc(sk.buffShort)}</span>`;
  };

  const formatValue = (item) => {
    if(!item) return '0';
    if(selectedTab === 'day_rev') return fmt(item.dayRev || 0) + ' / ngày';
    if(selectedTab === 'day_served') return (item.dayServed || 0).toLocaleString('vi-VN') + ' ly / ngày';
    if(selectedTab === 'crush') return 'Màn ' + (item.crushLevel || 1) + ' 🍬';
    if(selectedTab === 'capbi') return (item.capbiLevel ? 'Cấp ' + item.capbiLevel + ' 🦫' : 'Chưa mở 💤');
    if(selectedTab === 'avg_upg') return (item.avgUpg != null ? Number(item.avgUpg).toFixed(1) : '0.0') + ' cấp ⚡';
    if(selectedTab === 'star') {
      const cnt = (item.star1Count != null ? item.star1Count : 0);
      return cnt.toLocaleString('vi-VN') + ' lượt (1★)';
    }
    if(selectedTab === 'served') return (item.served || 0).toLocaleString('vi-VN') + ' ly';
    if(selectedTab === 'profit') return (item.profit || 0).toLocaleString('vi-VN') + 'đ / ngày';
    return fmt(item.staffTip7d || 0) + ' / 7N';
  };

  const formatDayLabel = (item) => {
    if(!item) return 'Ngày 1';
    return `Ngày ${(item.day || 1).toLocaleString('vi-VN')}`;
  };

  const formatSub = (item) => {
    if(!item) return '';
    return `${formatDayLabel(item)} · ${esc(item.location || 'Việt Nam')}`;
  };

  const getLeaderboardFrameUrl = (tab, rank) => {
    if(rank === 1 || rank === 2 || rank === 3){
      if(tab === 'profit') return `img/frames/top-revenue-${rank}.webp`;
      if(tab === 'star') return `img/frames/top-days-${rank}.webp`;
      return `img/frames/top-store-${rank}.webp`;
    }
    if(rank >= 4 && rank <= 10){
      const padRank = String(rank).padStart(2, '0');
      return `img/frames/vip-${padRank}.webp`;
    }
    return null;
  };

  const renderRankAvatar = (item, rank, isPodium = false) => {
    if(!item) return '';
    const frameUrl = getLeaderboardFrameUrl(selectedTab, rank);
    const avaUrl = (typeof getLeaderboardAvatarUrl === 'function') ? getLeaderboardAvatarUrl(item, rank) : (item.avatar || 'img/imnv/b00.png');
    const imgTag = `<img src="${avaUrl}" alt="" loading="lazy">`;
    const wrapClass = isPodium ? `lb-frame-avatar-wrap podium-rank-${rank} podium rank-${rank}` : `lb-frame-avatar-wrap list rank-${rank}`;
    if(frameUrl){
      return `
        <div class="${wrapClass}">
          <span class="lb-frame-inner-ava">${imgTag}</span>
          <img class="lb-frame-overlay" src="${frameUrl}" alt="" loading="lazy">
        </div>
      `;
    }
    return isPodium 
      ? `<span class="lb-podium-ava"><span class="lb-podium-ava-imgwrap">${imgTag}</span></span>` 
      : `<span class="lb-list-ava-imgwrap">${imgTag}</span>`;
  };

  // Bục vinh danh linh hoạt theo số người chơi thật (Dynamic Podium)
  let podiumHtml = '';
  let listItems = [];

  if(top1 && top2 && top3){
    podiumHtml = `
      <div class="lb-podium">
        <div class="lb-podium-item rank-2" style="${top2.id === myId ? 'border-color:#f59e0b !important;box-shadow:0 0 10px rgba(245,158,11,0.4) !important;' : ''}">
          <span class="lb-podium-rank">🥈</span>
          ${renderRankAvatar(top2, 2, true)}
          <span class="lb-podium-name">${esc(top2.name)}</span>
          <span class="lb-podium-owner">${formatDayLabel(top2)}${top2.id === myId ? ' <b style="color:#d97706;">(Bạn)</b>' : ''}</span>
          <span class="lb-podium-val">${formatValue(top2)}</span>
          ${getRankCupBadgeHtml(2)}
        </div>
        <div class="lb-podium-item rank-1" style="${top1.id === myId ? 'box-shadow:0 0 14px rgba(245,158,11,0.6) !important;' : ''}">
          <span class="lb-podium-rank">👑</span>
          ${renderRankAvatar(top1, 1, true)}
          <span class="lb-podium-name" style="color:#b45309;">${esc(top1.name)}</span>
          <span class="lb-podium-owner">${formatDayLabel(top1)}${top1.id === myId ? ' <b style="color:#d97706;">(Bạn)</b>' : ''}</span>
          <span class="lb-podium-val">${formatValue(top1)}</span>
          ${getRankCupBadgeHtml(1)}
        </div>
        <div class="lb-podium-item rank-3" style="${top3.id === myId ? 'border-color:#f59e0b !important;box-shadow:0 0 10px rgba(245,158,11,0.4) !important;' : ''}">
          <span class="lb-podium-rank">🥉</span>
          ${renderRankAvatar(top3, 3, true)}
          <span class="lb-podium-name">${esc(top3.name)}</span>
          <span class="lb-podium-owner">${formatDayLabel(top3)}${top3.id === myId ? ' <b style="color:#d97706;">(Bạn)</b>' : ''}</span>
          <span class="lb-podium-val">${formatValue(top3)}</span>
          ${getRankCupBadgeHtml(3)}
        </div>
      </div>
    `;
    listItems = top50.slice(3);
  } else if(top1 && top2){
    podiumHtml = `
      <div class="lb-podium" style="justify-content:center;gap:8px;">
        <div class="lb-podium-item rank-2" style="${top2.id === myId ? 'border-color:#f59e0b !important;box-shadow:0 0 10px rgba(245,158,11,0.4) !important;' : ''}">
          <span class="lb-podium-rank">🥈 HẠNG 2</span>
          ${renderRankAvatar(top2, 2, true)}
          <span class="lb-podium-name">${esc(top2.name)}</span>
          <span class="lb-podium-owner">${formatDayLabel(top2)}${top2.id === myId ? ' <b style="color:#d97706;">(Bạn)</b>' : ''}</span>
          <span class="lb-podium-val">${formatValue(top2)}</span>
          ${getRankCupBadgeHtml(2)}
        </div>
        <div class="lb-podium-item rank-1" style="${top1.id === myId ? 'box-shadow:0 0 14px rgba(245,158,11,0.6) !important;' : ''}">
          <span class="lb-podium-rank">👑 QUÁN QUÂN</span>
          ${renderRankAvatar(top1, 1, true)}
          <span class="lb-podium-name" style="color:#b45309;">${esc(top1.name)}</span>
          <span class="lb-podium-owner">${formatDayLabel(top1)}${top1.id === myId ? ' <b style="color:#d97706;">(Bạn)</b>' : ''}</span>
          <span class="lb-podium-val">${formatValue(top1)}</span>
          ${getRankCupBadgeHtml(1)}
        </div>
      </div>
    `;
    listItems = top50.slice(2);
  } else if(top1){
    podiumHtml = `
      <div class="lb-podium" style="justify-content:center;">
        <div class="lb-podium-item rank-1" style="max-width:270px;width:100%;${top1.id === myId ? 'box-shadow:0 0 16px rgba(245,158,11,0.7) !important;' : ''}">
          <span class="lb-podium-rank">👑 QUÁN QUÂN TIỆM TRÀ</span>
          ${renderRankAvatar(top1, 1, true)}
          <span class="lb-podium-name" style="color:#b45309;font-size:1.02rem;">${esc(top1.name)}</span>
          <span class="lb-podium-owner" style="font-size:0.85rem;">${formatDayLabel(top1)}${top1.id === myId ? ' <b style="color:#d97706;">(Tiệm của bạn)</b>' : ''}</span>
          <span class="lb-podium-val" style="font-size:1.05rem;">${formatValue(top1)}</span>
          ${getRankCupBadgeHtml(1)}
        </div>
      </div>
    `;
    listItems = top50.slice(1);
  }

  const listRowsHtml = listItems.map((item, idx) => {
    let rank = idx + 1;
    if(top1 && top2 && top3) rank = idx + 4;
    else if(top1 && top2) rank = idx + 3;
    else if(top1) rank = idx + 2;

    const isMe = item.id === myId;
    return `
      <div class="lb-row ${isMe ? 'is-me' : ''}">
        <div class="lb-row-left">
          <span class="lb-rank-num">#${rank}</span>
          ${renderRankAvatar(item, rank, false)}
          <div class="lb-row-info">
            <span class="lb-row-name">${esc(item.name)}${isMe ? ' <b style="color:#d97706;font-size:0.75rem;">(Tiệm của bạn)</b>' : ''}</span>
            <span class="lb-row-sub">${formatSub(item)}</span>
          </div>
        </div>
        <div class="lb-row-right">
          <span class="lb-row-val">${formatValue(item)}</span>
        </div>
      </div>
    `;
  }).join('');

  const contentArea = container.querySelector('#lb-content-area');
  if(!contentArea) return;

  contentArea.style.textAlign = 'left';
  contentArea.innerHTML = `
    ${window.renderLbCupSkinBarHtml()}
    ${podiumHtml}

    <div class="lb-list">
      ${listRowsHtml}
    </div>
  `;

  const topMeArea = container.querySelector('#lb-top-me-area');
  if(topMeArea){
    const activeSkinObj = getResolvedCupSkinObj();
    topMeArea.innerHTML = `
      <div class="lb-sticky-me">
        <div class="lb-sticky-me-left">
          ${renderRankAvatar(myEntry, myRank, false)}
          <div class="lb-sticky-me-info">
            <div class="lb-sticky-me-top">
              <span class="lb-sticky-me-rank-txt">Hạng của bạn: <b>${myRank > 0 ? '#' + myRank : 'Chưa xếp hạng'}</b></span>
              ${isTop1CupUnlocked() ? `<span class="lb-sticky-me-skin-pill">${activeSkinObj ? activeSkinObj.icon + ' ' + esc(activeSkinObj.name) + ' · ' + esc(activeSkinObj.buffShort) : '🥤 Ly Mặc Định'}</span>` : ''}
            </div>
            <div class="lb-sticky-me-sub">
              <span>${formatDayLabel(myEntry)}</span>
              <span class="lb-dot-sep">·</span>
              <span>${esc(myEntry.badge)}</span>
              <span class="lb-dot-sep">·</span>
              <b class="lb-sticky-me-score">${formatValue(myEntry)}</b>
            </div>
          </div>
        </div>
        <button id="lbSyncBtn" type="button" class="lb-sync-btn" title="Đồng bộ điểm lên toàn server, chốt Top 1 ngày & làm mới BXH">
          🔄 Đồng bộ
        </button>
      </div>
    `;

    const syncBtn = topMeArea.querySelector('#lbSyncBtn');
    if(syncBtn){
      syncBtn.onclick = async () => {
        syncBtn.innerText = '⏳ Đang chốt...';
        syncBtn.disabled = true;
        // Xoá cache bộ nhớ của toàn bộ các Tab để đảm bảo tải mới 100% từ Server
        window._lbMemoryCache = {};
        window._lbMemoryCacheTime = {};
        const submitRes = await submitMyLeaderboardScore(false);
        if(submitRes){
          await syncMyDailyTopCupSkinFromServer(myEntry, false);
          if(myRank === 1 && top1 && top1.id === myId){
            unlockTop1CupSkin(selectedTab, false, 1);
          }
          if(typeof renderCup === 'function' && $('q3cup')) renderCup();
          toast('🚀 Đã đồng bộ toàn server & kiểm tra chốt Top 1 xếp hạng ngày! 🎉');
        }
        if(isModal){
          openLeaderboard(selectedTab);
        } else {
          paneBxh(selectedTab);
        }
      };
    }
  }

  const footerArea = container.querySelector('#lb-footer-area');
  if(footerArea){
    footerArea.innerHTML = `
      ${isModal ? '<button class="big lb-close-btn" id="lbClose">Đóng</button>' : ''}
    `;

    const closeModal = () => {
      $('card').className = 'card';
      $('modal').hidden = true;
      if(typeof renderCup === 'function' && $('q3cup')) renderCup();
      if(R && R.running && R._pausedByLeaderboard){
        delete R._pausedByLeaderboard;
        resumeGame();
      }
    };
    const closeBtn = footerArea.querySelector('#lbClose');
    if(closeBtn) closeBtn.onclick = closeModal;
  }
}

async function paneBxh(selectedTab = _lbCurrentTab){
  _lbCurrentTab = selectedTab;
  const p = $('pane');
  if(!p) return;
  await renderLeaderboardComponent(p, selectedTab, false);
}
window.paneBxh = paneBxh;

async function openLeaderboard(selectedTab = 'staff_tip'){
  if(R && R.mode === 'prep'){
    _lbCurrentTab = selectedTab;
    switchTab('bxh');
    return;
  }
  if(R && R.running && !R.paused && R._pausedByLeaderboard !== false){
    R._pausedByLeaderboard = true;
    R.paused = true;
    clearInterval(timer);
  }
  $('card').className = 'card card-leaderboard';
  $('card').onchange = null;
  $('modal').hidden = false;
  await renderLeaderboardComponent($('card'), selectedTab, true);
}
window.openLeaderboard = openLeaderboard;


async function backupDlg(){
  $('card').onchange=null;
  S.bakDay=S.day;
  save();
  $('card').innerHTML=`<h2>Sao lưu tiến trình</h2><p>Đang tạo mã sao lưu…</p>`;
  $('modal').hidden=false;

  S.cloud=S.cloud||{};
  if(!S.cloud.key){
    const a=new Uint8Array(12);
    crypto.getRandomValues(a);
    S.cloud.key=[...a].map(x=>x.toString(36).padStart(2,'0')).join('').slice(0,24);
  }
  save();

  let fullCode = '';
  try {
    fullCode = await makeBackup();
  } catch(e) {
    $('card').innerHTML=`<h2>Không tạo được mã</h2><p>${esc(e && e.message || 'Lỗi xử lý')}</p><button class="big" id="bkClose">Đóng</button>`;
    $('bkClose').onclick=showSettings;
    return;
  }

  $('card').innerHTML=`<h2>Sao lưu tiến trình</h2><p>Đang đồng bộ dữ liệu…</p>`;
  let c8=null, cErr='';
  try {
    c8 = await cloudSave(fullCode);
  } catch(e) {
    cErr = e;
  }

  $('card').innerHTML=`<h2>Mã sao lưu quán</h2>
    ${c8 ? `
      <div style="background:#fef3c7;border:1.5px solid #f59e0b;border-radius:12px;padding:10px 14px;margin-bottom:12px;text-align:center;">
        <p style="margin:0 0 4px 0;font-size:12.5px;color:#92400e;font-weight:700;">🔑 Mã máy chủ 8 số (Tiện khôi phục khi có mạng):</p>
        <div class="c8" id="c8" style="font-size:24px;font-weight:900;letter-spacing:2px;color:#b45309;margin-bottom:6px;">${fmtCode(c8)}</div>
        <button type="button" class="sbtn pri" id="c8Copy" style="padding:5px 16px;font-size:12.5px;">Chép 8 số</button>
      </div>
    ` : `
      <div style="background:#fff7ed;border:1px solid #fdba74;border-radius:10px;padding:8px 12px;margin-bottom:12px;font-size:12px;color:#9a3412;line-height:1.4;">
        ⚠️ Không kết nối được máy chủ đám mây. Bạn hãy dùng <b>Dạng 1 (Lưu file)</b> hoặc <b>Dạng 2 (Mã đầy đủ)</b> bên dưới để giữ an toàn 100% tiến trình!
      </div>
    `}
    <p class="lvup" style="margin:0 0 12px 0;text-align:center;font-weight:800;font-size:13.5px;">${esc(shopName())} · Ngày ${S.day} · ${fmt(S.money)}</p>

    <!-- DẠNG 1: LƯU THÀNH FILE (Bản đầy đủ) -->
    <div style="background:#f0fdf4;border:1.5px solid #22c55e;border-radius:12px;padding:11px 13px;margin-bottom:11px;text-align:left;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;">
        <b style="color:#15803d;font-size:13px;">📁 Dạng 1: Tệp sao lưu đầy đủ (.txt)</b>
        <span style="font-size:11px;background:#dcfce7;color:#166534;padding:2px 7px;border-radius:6px;font-weight:700;">Khuyên dùng · Đầy đủ 100%</span>
      </div>
      <p style="font-size:12px;color:#166534;margin:0 0 8px 0;line-height:1.4;">
        Chứa trọn vẹn toàn bộ lịch sử ngày bán, đánh giá và tài sản tiệm trà. Tải file về máy để khôi phục bất cứ lúc nào.
      </p>
      <div style="display:flex;gap:8px;">
        <button type="button" class="sbtn pri" id="bkFile" style="flex:1;padding:9px 12px;display:flex;align-items:center;justify-content:center;gap:6px;font-weight:800;font-size:13px;">
          <span>💾 Lưu tệp về máy (.txt)</span>
        </button>
        <button type="button" class="sbtn ghost" id="bkShare" style="white-space:nowrap;padding:9px 12px;display:flex;align-items:center;justify-content:center;gap:5px;font-size:12px;" title="Chia sẻ file qua các ứng dụng">
          <span>📤 Chia sẻ</span>
        </button>
      </div>
    </div>

    <!-- DẠNG 2: MÃ SAO LƯU VĂN BẢN (ĐẦY ĐỦ 100%) -->
    <div style="background:#f0f9ff;border:1.5px solid #0ea5e9;border-radius:12px;padding:11px 13px;margin-bottom:12px;text-align:left;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;">
        <b style="color:#0369a1;font-size:13px;">📋 Dạng 2: Mã sao lưu văn bản (Đầy đủ 100%)</b>
        <span style="font-size:11px;background:#e0f2fe;color:#0284c7;padding:2px 7px;border-radius:6px;font-weight:700;">Đầy đủ 100%</span>
      </div>
      <p style="font-size:12px;color:#0369a1;margin:0 0 6px 0;line-height:1.4;">
        Bản mã chi tiết đầy đủ 100% dữ liệu gốc của tiệm (đã loại bỏ mã rút gọn để tránh mất mát dữ liệu). Bấm nút bên dưới để sao chép vào bộ nhớ tạm:
      </p>
      <textarea id="bkCode" class="rpin" readonly style="width:100%;min-height:60px;font-size:10.5px!important;word-break:break-all;margin-bottom:6px;background:#ffffff;border:1px solid #7dd3fc;border-radius:8px;box-sizing:border-box;padding:6px 8px;">${fullCode}</textarea>
      <button type="button" class="sbtn pri" id="bkCopy" style="width:100%;padding:9px 12px;display:flex;align-items:center;justify-content:center;gap:6px;font-weight:800;font-size:13px;background:#0284c7;border-color:#0284c7;">
        <span>📋 Chép mã sao lưu đầy đủ 100%</span>
      </button>
    </div>

    <button class="big" id="bkClose">Xong</button>`;

  if($('c8Copy')){
    $('c8Copy').onclick=async()=>{
      let ok=false;
      try{ await navigator.clipboard.writeText(c8); ok=true; }catch(e){}
      toast(ok ? 'Đã chép ' + fmtCode(c8) : 'Ghi lại 8 số: ' + fmtCode(c8), 4000, 1);
    };
  }

  $('bkCopy').onclick=async()=>{
    const t=$('bkCode');
    let ok=false;
    try{ await navigator.clipboard.writeText(fullCode); ok=true; }catch(e){}
    if(!ok){
      t.focus(); t.select();
      try{ ok=document.execCommand('copy'); }catch(e){}
      t.blur();
    }
    toast(ok ? '✅ Đã chép mã sao lưu đầy đủ 100%!' : 'Giữ vào ô mã để chép');
  };

  $('bkFile').onclick=()=>{
    const name='tiemtranho-ngay-'+S.day+'.txt';
    try {
      const blob = new Blob([fullCode], {type:'text/plain;charset=utf-8'});
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = name;
      a.style.display = 'none';
      document.body.appendChild(a);
      a.click();
      setTimeout(()=>{
        try{ URL.revokeObjectURL(url); if(a.parentNode) a.parentNode.removeChild(a); }catch(e){}
      }, 1500);
      toast('💾 Đã lưu tệp vào máy (Downloads): ' + name, 4500, 1);
    } catch(err){
      try {
        const a = document.createElement('a');
        a.href = 'data:text/plain;charset=utf-8,' + encodeURIComponent(fullCode);
        a.download = name;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        setTimeout(()=>{ if(a.parentNode) a.parentNode.removeChild(a); }, 1500);
        toast('💾 Đã lưu tệp vào máy (Downloads): ' + name, 4500, 1);
      } catch(e2){
        toast('⚠️ Lỗi lưu tệp, vui lòng dùng Dạng 2 (Mã sao lưu rút gọn)!');
      }
    }
  };

  if($('bkShare')){
    $('bkShare').onclick=async()=>{
      const name='tiemtranho-ngay-'+S.day+'.txt';
      const f=new File([fullCode], name, {type:'text/plain'});
      try{
        if(navigator.canShare && navigator.canShare({files:[f]})){
          await navigator.share({files:[f], title:'Sao lưu Tiệm Trà Mơ Ước'});
          return;
        } else if(navigator.share){
          await navigator.share({title:'Sao lưu Tiệm Trà Mơ Ước', text: shortCode});
          return;
        }
      }catch(e){
        if(e && e.name==='AbortError') return;
      }
      toast('Thiết bị không hỗ trợ tính năng chia sẻ!');
    };
  }

  $('bkClose').onclick=showSettings;
}
function restoreDlg(msg){
  $('card').onchange=null;
  $('card').innerHTML=`<h2>Khôi phục tiến trình</h2>
    <p style="font-size:13px;line-height:1.45;color:var(--t2,#64748b);margin-bottom:10px;">
      Chọn file sao lưu (<b>.txt</b> hoặc <b>.json</b>), dán mã dài hoặc nhập mã 8 số (nếu có mạng).
    </p>
    ${msg?`<p class="warnline" style="margin-bottom:10px;"><b>${esc(msg)}</b></p>`:''}
    <div id="rsFileInfo" style="display:none;margin-bottom:10px;padding:8px 12px;border-radius:10px;background:rgba(16,185,129,0.12);border:1.5px solid #10b981;font-size:12.5px;color:#065f46;line-height:1.4;"></div>
    <textarea id="rsCode" class="rpin" placeholder="Dán mã sao lưu dài TTN1..., dán dữ liệu JSON hoặc nhập 8 số..." style="min-height:90px;font-size:12px!important;word-break:break-all"></textarea>
    <div class="sndrow" style="display:flex;gap:8px;align-items:center;margin-top:8px;">
      <label class="sbtn pri" style="flex:1;display:flex;align-items:center;justify-content:center;gap:6px;cursor:pointer;padding:9px 12px;font-weight:700;">
        <span>📂 Chọn file sao lưu</span>
        <input type="file" id="rsFile" accept=".txt,.json,text/plain,application/json,*/*" hidden>
      </label>
      <button type="button" class="sbtn ghost" id="rsAutoBtn" style="white-space:nowrap;font-size:12px;">🕒 Bản tự lưu</button>
    </div>
    <div class="askbtns" style="margin-top:14px;">
      <button class="big" id="rsGo">Khôi phục ngay</button>
      <button class="sbtn ghost" id="rsBack">Quay lại</button>
    </div>`;
  $('modal').hidden=false;

  $('rsAutoBtn').onclick=()=>{ autoRestoreDlg(); };

  $('rsFile').onchange=e=>{
    const f=e.target.files && e.target.files[0];
    if(!f) return;
    const handleText = async (text) => {
      const clean = String(text || '').trim().replace(/^\uFEFF/, '');
      $('rsCode').value = clean;
      try {
        const preview = await readBackup(clean);
        toast(`✅ Đã nạp file: ${preview.shopName || 'Tiệm Trà'} · Ngày ${preview.day} · ${fmt(preview.money || 0)}`, 4000, 1);
        const infoEl = document.getElementById('rsFileInfo');
        if(infoEl) {
          infoEl.innerHTML = `<span style="font-weight:800;color:#047857;">✅ Sẵn sàng khôi phục:</span> <b>${esc(preview.shopName||'Tiệm Trà')}</b> · Ngày ${preview.day} · ${fmt(preview.money||0)}`;
          infoEl.style.display = 'block';
        }
      } catch(parseErr) {
        toast('Đã đọc nội dung file, bấm Khôi phục để tiến hành', 3000);
      }
    };

    if(typeof FileReader !== 'undefined'){
      const reader = new FileReader();
      reader.onload = evt => handleText(evt.target.result);
      reader.onerror = () => {
        if(typeof f.text === 'function'){
          f.text().then(handleText).catch(err => toast('Không thể đọc file: ' + err.message));
        } else {
          toast('Không thể đọc file đã chọn');
        }
      };
      reader.readAsText(f, 'UTF-8');
    } else if(typeof f.text === 'function'){
      f.text().then(handleText).catch(err => toast('Không thể đọc file: ' + err.message));
    }
  };

  $('rsBack').onclick=()=>{if(!$('splash').hidden)$('modal').hidden=true;else showSettings()};
  
  $('rsGo').onclick=async()=>{
    const code=$('rsCode').value.trim();
    if(!code){
      toast('Vui lòng chọn file sao lưu hoặc dán mã vào ô');
      return;
    }
    if(isField(document.activeElement))document.activeElement.blur();
    let d;
    const c8=String(code||'').replace(/[\s.-]/g,'');
    try{
      if(/^\d{8}$/.test(c8)){
        $('rsGo').disabled=true;
        $('rsGo').textContent='Đang tải…';
        d=await cloudLoad(c8);
      }else{
        d=await readBackup(code);
      }
    }catch(e){
      restoreDlg(typeof e==='string'?e:'Mã hoặc file không đọc được');
      return;
    }
    ask(`<div class="pbig">${ico('reload')}</div><h2>Khôi phục tiến trình?</h2><p>Bản sao lưu: <b>${esc(d.shopName||'Tiệm Trà Mơ Ước')}</b> · Ngày ${d.day} · ${fmt(d.money||0)}</p><p>Tiến trình hiện tại sẽ được lưu dự phòng vào bộ nhớ máy trước khi thay thế.</p>`,
      [['Huỷ',()=>restoreDlg()],['Khôi phục',()=>{closeSplash();applyRestore(d);},1]]);
  };
}
function showSettings(){
  if(R && R.running && !R.paused && R._pausedBySettings !== false){
    R._pausedBySettings = true;
    R.paused = true;
    clearInterval(timer);
  }
  $('card').onchange=null;
  $('card').innerHTML=`<h2>${ico('set')} Cài đặt</h2><div class="setl">
    <button class="setb" id="sGuide"><span>${ico('book')}</span>Hướng dẫn</button>
    <button class="setb" id="sNews"><span>${ico('gift')}</span>Có gì mới<small>v${GAME_VERSION}</small></button>
    <button class="setb" id="sClassicGame" style="background:linear-gradient(135deg,#ffeedb,#ffe0e6);border-color:#f8b4c4"><span>🍵</span><div class="setb-text"><b class="setb-title" style="color:#83253b;">Tiệm Trà Nhỏ (Bản gốc)</b><small class="setb-sub" style="color:#9f3c55;">Hoài niệm Dư vị của cơn say · Trải nghiệm kinh doanh gốc</small></div></button>
    <button class="setb" id="sUpdate" style="background:linear-gradient(135deg,#e3f7ed,#d1f2e1);border-color:#5aae86"><span>🔄</span><div class="setb-text"><b class="setb-title" style="color:#065f46;">Cập nhật bản mới</b><small class="setb-sub" style="color:#047857;">Tải lại web & Xoá bộ nhớ đệm (Cache)</small></div></button>
    <button class="setb" id="sRank" style="background:linear-gradient(135deg,#fff8e7,#ffeedb);border-color:#f59e0b"><span>🏆</span><div class="setb-text"><b class="setb-title" style="color:#b45309;">Bảng Xếp Hạng Trực Tuyến</b><small class="setb-sub" style="color:#d97706;">Top 50 Chủ tiệm tài ba toàn server</small></div></button>
    <button class="setb" id="sZalo"><span>🧵</span><div class="setb-text"><b class="setb-title">Kênh Threads & Lời nhắn Dev</b><small class="setb-sub">Mã Threads & Góp ý trực tiếp</small></div></button>
    <button class="setb" id="sCoach"><span>${ico('book')}</span>Chỉ dẫn từng bước<small>${S.coach===true?'Luôn bật':S.coach===false?'Tắt':'Tự động'}</small></button>
    <button class="setb" id="sLen"><span>${ico('clock')}</span>Thời gian bán mỗi ngày<small>${S.dayLen||CFG.dayMin} phút${R.running?' · áp dụng từ ngày sau':''}</small></button>
    <button class="setb" id="sTheme"><span>${ico('pen')}</span>Màu giao diện<small>${(THEMES.find(x=>x.id===THEME)||THEMES[0]).n}</small></button>
    ${getVolumeControlHTML('setvol')}
    <button class="setb" id="sSea"><span>${ico('calendar')}</span>Nhạc nền & Mùa<small>${AU.bgmTrack==='lofi'?'☕ Lofi Chill Quán Cafe':(AU.season?SEASONS[AU.season].n:'Tự động · '+SEASONS[seasonNow()].n)}</small></button>
    <button class="setb" id="sBak"><span>${ico('box')}</span>Sao lưu tiến trình<small>${S.bakDay?'Lần cuối: ngày '+S.bakDay:'Chưa sao lưu'}</small></button>
    <button class="setb" id="sAuto"><span>${ico('calendar')}</span>Khôi phục bản tự lưu<small>Game tự lưu 3 cuối ngày gần nhất</small></button>
    <button class="setb" id="sRes"><span>${ico('reload')}</span>Khôi phục từ mã</button>
    <button class="setb warnb" id="sReset"><span>${ico('reload')}</span>Chơi lại từ đầu</button></div>
    <button class="big" id="sClose" style="margin-top:12px">Đóng</button>`;
  $('modal').hidden=false;
  bindVolumeControls('setvol');
  $('sClose').onclick=()=>{
    $('modal').hidden=true;
    if(R && R.running && R._pausedBySettings){
      delete R._pausedBySettings;
      resumeGame();
    }
  };
  $('sClassicGame').onclick=()=>{if($('modal'))$('modal').hidden=true;openClassicGame();};
  $('sGuide').onclick=()=>{
    $('modal').hidden=true;
    showTour(false,true,()=>{
      if(R && R.running && R._pausedBySettings){
        delete R._pausedBySettings;
        resumeGame();
      }
    });
  };
  $('sNews').onclick=()=>showNews(false);

  if($('sUpdate')) $('sUpdate').onclick = forceGlobalAppUpdate;
  if($('sRank')) $('sRank').onclick = () => { openLeaderboard(); };
  $('sZalo').onclick=()=>{if($('modal'))$('modal').hidden=true;showZaloBanner()};
  $('sTheme').onclick=themeDlg;
  $('sLen').onclick=()=>{
    const L=[4,5,6];
    const cur = parseInt(String(S.dayLen || CFG.dayMin || 4), 10);
    const idx = L.indexOf(cur);
    const nextVal = (idx >= 0) ? L[(idx + 1) % L.length] : 4;
    S.dayLen = nextVal;
    CFG.dayMin = nextVal;
    save();
    try { saveCfg(); } catch(e){}
    toast('Mỗi ngày bán ' + nextVal + ' phút, khách tới nhiều hơn theo thời gian');
    showSettings();
  };
  if($('sMus')) $('sMus').onclick=()=>{AU.mus=!AU.mus;saveAu();musSync();showSettings()};
  $('sSea').onclick=()=>{
    if(AU.bgmTrack==='lofi'){
      AU.bgmTrack='season';
      AU.season=null;
      toast('🎵 Chuyển sang: Nhạc Tự Động Theo Mùa ('+SEASONS[seasonNow()].n+')');
    }else if(AU.season===null){
      AU.season='thu';
      toast('🍁 Chuyển sang: Nhạc Mùa Thu');
    }else if(AU.season==='thu'){
      AU.season='dong';
      toast('❄️ Chuyển sang: Nhạc Mùa Đông');
    }else if(AU.season==='dong'){
      AU.season='xuan';
      toast('🌸 Chuyển sang: Nhạc Mùa Xuân');
    }else if(AU.season==='xuan'){
      AU.season='he';
      toast('☀️ Chuyển sang: Nhạc Mùa Hè');
    }else{
      AU.bgmTrack='lofi';
      AU.season=null;
      toast('☕ Chuyển sang: Nhạc Lofi Chill Quán Cafe 2026');
    }
    saveAu();
    currentBgmKey=null;
    if(loopSrc&&AU.ctx){try{loopSrc.s.stop()}catch(e){}loopSrc=null}
    if(bgmAudio){try{bgmAudio.pause();bgmAudio.currentTime=0}catch(e){}}
    musSync();
    showSettings();
  };
  if($('sSnd')) $('sSnd').onclick=()=>{AU.on=!AU.on;saveAu();showSettings()};
  $('sCoach').onclick=()=>{S.coach=S.coach==null?true:S.coach===true?false:undefined;if(S.coach===undefined)delete S.coach;save();showSettings()};
  $('sBak').onclick=backupDlg;$('sAuto').onclick=autoRestoreDlg;$('sRes').onclick=()=>restoreDlg();
  $('sReset').onclick=()=>ask('<div class="pbig">'+ico('reload')+'</div><h2>Chơi lại từ đầu?</h2>',[['Huỷ',showSettings],['Xoá và chơi lại',()=>{stopShift(true);const n=S.shopName;S=fresh();S.shopName=n;save();R.tab='kho';renderPrep()},1]]);
}

