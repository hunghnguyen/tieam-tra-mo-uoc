/* ---------- STATE ---------- */
const $=id=>document.getElementById(id);
const fmt=n=>{
  if(n == null || isNaN(n)) return '0đ';
  const a=Math.abs(n),sign=n<0?'−':'';
  if(a>=1e12){
    const v=a/1e12;
    return sign+(Math.round(v*100)/100).toLocaleString('vi-VN',{maximumFractionDigits:2})+'k tỉ';
  }
  if(a>=1e9){
    const v=a/1e9;
    const rounded=Math.round(v*100)/100;
    if(rounded>=1000) return sign+(rounded/1000).toLocaleString('vi-VN',{maximumFractionDigits:2})+'k tỉ';
    return sign+rounded.toLocaleString('vi-VN',{maximumFractionDigits:2})+' tỉ';
  }
  if(a>=1e6){
    const v=a/1e6;
    const rounded=Math.round(v*100)/100;
    if(rounded>=1000) return sign+(rounded/1000).toLocaleString('vi-VN',{maximumFractionDigits:2})+' tỉ';
    return sign+rounded.toLocaleString('vi-VN',{maximumFractionDigits:2})+'tr';
  }
  if(a>=1e3){
    const v=a/1e3;
    const rounded=Math.round(v*10)/10;
    if(rounded>=1000) return sign+(rounded/1000).toLocaleString('vi-VN',{maximumFractionDigits:2})+'tr';
    return sign+rounded.toLocaleString('vi-VN',{maximumFractionDigits:1})+'k';
  }
  const rounded=Math.round(a);
  if(rounded>=1000) return sign+'1k';
  return sign+rounded+'đ';
};
window.fmt=fmt;
const fmtBig=fmt;
const rnd=a=>a[Math.floor(Math.random()*a.length)];
const wpick=(arr,w)=>{let r=Math.random()*w.reduce((a,b)=>a+b,0);for(let i=0;i<arr.length;i++){r-=w[i];if(r<=0)return arr[i]}return arr[0]};
