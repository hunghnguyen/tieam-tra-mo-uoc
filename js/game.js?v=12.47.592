function initExtraState(){
  if(!S) return;
  if(!S.branches) S.branches = {};
  if(!S.franchise) S.franchise = { partners: [], totalRoyaltyEarned: 0, feeEarned: 0, contractTier: 1, totalSupplyProfit: 0, totalPosFeeEarned: 0 };
  if(!Array.isArray(S.franchise.partners)) S.franchise.partners = [];
  else S.franchise.partners = S.franchise.partners.filter(p => p && typeof p === 'object' && p.id);
  S.franchise.contractTier = S.franchise.contractTier || 1;
  S.franchise.totalSupplyProfit = S.franchise.totalSupplyProfit || 0;
  S.franchise.totalPosFeeEarned = S.franchise.totalPosFeeEarned || 0;
  if(!S.mxh) S.mxh = { followers: 120, posts: [], activeAds: [], totalAdsSpent: 0 };
  if(!Array.isArray(S.mxh.activeAds)) S.mxh.activeAds = [];
  else S.mxh.activeAds = S.mxh.activeAds.filter(a => a && typeof a === 'object' && a.id);
  if(!Array.isArray(S.mxh.posts)) S.mxh.posts = [];
  else S.mxh.posts = S.mxh.posts.filter(p => p && typeof p === 'object');
  if(S.mxh.activeAds && S.mxh.activeAds.length > 1){
    S.mxh.activeAds = [S.mxh.activeAds[0]];
  }
  if(!S.collection) S.collection = { unopenedPacks: 0, claimedPacks: 0, milestonesClaimed: [], unlockedIngs: {}, craftedRecipes: {}, recipeStars: {}, lastRevealed: [] };
  if(S.collection && !S.collection.recipeStars) S.collection.recipeStars = {};
  if(S.garden && Array.isArray(S.garden.plots)){
    S.garden.plots = S.garden.plots.filter(p => p && typeof p === 'object' && p.id != null);
  }
  if(!S.pet){
    S.pet = { unlocked: false, paid10m: false, type: 'dog', name: 'Shiba Vàng', dogName: 'Shiba Vàng', catName: 'Mèo Chiêu Tài', level: 1, exp: 0, hunger: 85, clean: 90, happiness: 95, energy: 100, currentAction: null };
  } else {
    if(S.pet.type !== 'cat' && S.pet.type !== 'dog') S.pet.type = 'dog';
    if(!S.pet.dogName) S.pet.dogName = S.pet.name || 'Shiba Vàng';
    if(!S.pet.catName) S.pet.catName = 'Mèo Chiêu Tài';
    if(S.pet.paid10m !== true) S.pet.unlocked = false;
  }
  if(!S.capbi){
    S.capbi = { unlocked: false, name: 'Cáp Bi Điềm Đạm', level: 1, exp: 0, hunger: 90, clean: 90, happiness: 100, energy: 100, active: false, currentAction: null };
  } else {
    if(!S.capbi.name) S.capbi.name = 'Cáp Bi Điềm Đạm';
    if(typeof S.capbi.level !== 'number') S.capbi.level = 1;
    if(typeof S.capbi.exp !== 'number') S.capbi.exp = 0;
    if(typeof S.capbi.active !== 'boolean') S.capbi.active = false;
    if(typeof S.capbi.hunger !== 'number') S.capbi.hunger = 90;
    if(typeof S.capbi.clean !== 'number') S.capbi.clean = 90;
    if(typeof S.capbi.happiness !== 'number') S.capbi.happiness = 100;
    if(typeof S.capbi.energy !== 'number') S.capbi.energy = 100;
  }
  if(!S.crushPackClaimed) S.crushPackClaimed = {};
  if(!S.crushBoosters) S.crushBoosters = { hammer: 1, bomb: 1, rainbow: 1, moves: 1, shuffle: 1 };
  if(!S.startupLocation) S.startupLocation = 'default';
  if(typeof S.startupLocLevel !== 'number' || isNaN(S.startupLocLevel) || S.startupLocLevel < 1) S.startupLocLevel = 1;
  if(S.startupLocLevel > 5) S.startupLocLevel = 5;
  if(typeof S.startupLocDays !== 'number' || isNaN(S.startupLocDays) || S.startupLocDays < 0) S.startupLocDays = 0;
  if(S.startupLocation === 'default'){
    S.startupLocLevel = 1;
    S.startupLocDays = 0;
  }
  if(window.MilkTeaCrush && typeof window.MilkTeaCrush.checkAndAwardCrushMilestones === 'function') {
    const curCrushLvl = S.crushLevel || 1;
    if(curCrushLvl > 1) window.MilkTeaCrush.checkAndAwardCrushMilestones(curCrushLvl - 1);
  }
  const curCrushLvl = S.crushLevel || 1;
  const targetCrushBuff = Math.max(0, curCrushLvl - 1) * 0.01;
  if((S.crushBuffRate || 0) < targetCrushBuff) {
    S.crushBuffRate = Math.round(targetCrushBuff * 100) / 100;
  }
  if(!S.equipBroken) S.equipBroken = {};
  if(S.upg && S.upg.sealer === false){
    S.equipBroken.sealer = true;
  }
  if(window.Garden && typeof window.Garden.init === 'function') window.Garden.init();
}
