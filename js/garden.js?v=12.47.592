(function(){
  'use strict';

  // 16 Tọa độ chuẩn xác của 16 mảnh đất trên farm.jpg (952 x 550)
  const PLOT_COORDS = [
    { id: 0,  left: 51.05, top: 23.64, cost: 0 },
