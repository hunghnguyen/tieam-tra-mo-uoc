function generateAdsDailyPosts(adId, count){
  if(!S || !S.mxh || !adId) return;
  S.mxh.posts = S.mxh.posts || [];
  const curShop = (typeof shopName === 'function' ? shopName() : (S && S.shopName) || 'Tiệm Trà Mơ Ước');
  const scenarios = ADS_DAILY_POST_SCENARIOS[adId];
  if(!scenarios || !scenarios.length) return;

  const numPosts = count || 1;
  for(let i = 0; i < numPosts; i++){
    const picked = scenarios[i % scenarios.length] || rnd(scenarios);
    const views = Math.floor(picked.viewsMin + Math.random() * (picked.viewsMax - picked.viewsMin));
    const likes = Math.floor(picked.likesMin + Math.random() * (picked.likesMax - picked.likesMin));

    const newPost = {
      id: 'ad_daily_' + Date.now() + '_' + i + '_' + Math.floor(Math.random() * 1000),
      author: picked.author,
      avt: picked.avt,
      badge: picked.badge,
      time: 'Hôm nay (Tự động từ Ads)',
      isTiktok: true,
      topic: picked.topic.replace(/\{shop\}/g, curShop),
      dialogue: picked.dialogue.map(d => ({
        speaker: d.speaker.replace(/\{shop\}/g, curShop),
        text: d.text.replace(/\{shop\}/g, curShop)
      })),
      sound: picked.sound,
      tags: picked.tags,
      content: (typeof formatDialogueContent === 'function')
        ? formatDialogueContent(picked.topic.replace(/\{shop\}/g, curShop), picked.dialogue, picked.sound, picked.tags)
        : picked.topic.replace(/\{shop\}/g, curShop),
      views: views,
      likes: likes,
      liked: false,
      replies: picked.replies ? [...picked.replies] : []
    };

    S.mxh.posts.unshift(newPost);
  }

  if(S.mxh.posts.length > 50) S.mxh.posts.length = 50;
}


