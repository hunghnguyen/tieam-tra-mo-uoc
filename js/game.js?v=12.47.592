const BASE_KEYS=Object.keys(ITEMS).filter(k=>ITEMS[k].type==='base');
const FLAV_KEYS=Object.keys(ITEMS).filter(k=>ITEMS[k].type==='flav');
const TOP_KEYS=Object.keys(ITEMS).filter(k=>ITEMS[k].type==='top');
const TGROUPS=[{g:'tc',n:'Trân châu',i:ico('pearlbowl')},{g:'thach',n:'Thạch',i:'🟫'},{g:'foam',n:'Kem',i:'☁️'},{g:'pm',n:'Phô mai',i:'🧀'}];
const SLOW_G=['thach','foam','pm'];
const slowN=o=>o.tops.filter(t=>ITEMS[t]&&SLOW_G.includes(ITEMS[t].g)).length;
const DEF_SELL={L:7000};[...BASE_KEYS,...FLAV_KEYS,...TOP_KEYS].forEach(k=>DEF_SELL[k]=ITEMS[k].sell);
const OLD_NAMES={khoaimon:'Khoai môn',dau:'Sữa dâu',dao:'Trà đào',tctrang:'Trân châu trắng',pudding:'Pudding',kemtrung:'Kem trứng',L:'Phụ thu size L',packaging_wastage:'Ly nắp, ống hút & bao bì',raw_ingredient_cogs:'Nguyên liệu xuất kho (trà, sữa, topping)'};
const ING_ALIASES = {
  pudding: 'pmvien',
  tchoangkim: 'tcvang',
  thach3q: 'thach',
  tcpopping: 'popping',
  thachphomai: 'thachpm',
  thachsuongsao: 'suongsao',
  tccunang: 'cunang',
  thachnhadam: 'cunang',
  thachduatho: 'thach',
  kemtrung: 'cheese',
  duanuong: 'pmvien',
  f_khoaimon: null
};
function normIngKey(k){
  if(!k) return null;
  return ING_ALIASES[k] !== undefined ? ING_ALIASES[k] : k;
}
function fixOrder(o){
  if(!o) return o;
  if(o.base) o.base = normIngKey(o.base) || o.base;
  if(o.flav) o.flav = normIngKey(o.flav);
  if(Array.isArray(o.tops)){
    o.tops = o.tops.map(normIngKey).filter(Boolean);
  }
  if(typeof o.sugar === 'string'){
    const n = parseInt(o.sugar, 10);
    o.sugar = isNaN(n) ? 70 : n;
  }
  if(o.ice === 'Bình thường') o.ice = 'Đá thường';
  return o;
}
function canMakeRecipe(rec, requireCrafted=true){
  if(!rec || !rec.gameOrder) return false;
  // 1. Phải là công thức ĐÃ MỞ KHÓA / CHẾ TẠO THÀNH CÔNG trong Sổ Tay Công Thức
  if(requireCrafted){
    if(!window.S || !window.S.collection || !window.S.collection.craftedRecipes || !window.S.collection.craftedRecipes[rec.id]){
      return false;
    }
  }
  const o = fixOrder(rec.gameOrder);
  // Nếu là size L mà quán chưa mở size L (mở từ cấp 2)
  if(o.size === 'L' && typeof level === 'function' && level() < 2) return false;

  const reqs = [o.base, ...(o.flav ? [o.flav] : []), ...(o.tops || []), ...(o.cheese ? ['cheese'] : []), 'cup'];
  for(const k of reqs){
    if(!k) continue;
    // Bắt buộc nguyên liệu phải ĐÃ ĐƯỢC MỞ KHÓA trong quán (S.unlocked[k] === true)
    if(k !== 'cup' && (!window.S || !window.S.unlocked || !window.S.unlocked[k])) return false;
    // Bắt buộc không bị chủ quán gạt tắt bán khỏi menu
    if(window.S && window.S.off && window.S.off[k]) return false;
    // Bắt buộc phải còn tồn kho trong quầy
    if(typeof qty === 'function' && qty(k) <= 0) return false;
  }
  // Bắt buộc đường & đá còn tồn kho nếu cấp quán >= 2
  if(typeof level === 'function' && level() >= 2){
    if(o.sugar > 0 && typeof qty === 'function' && qty('sugar') <= 0) return false;
    if(o.ice && o.ice !== 'Không đá' && typeof qty === 'function' && qty('ice') <= 0) return false;
  }
  return true;
}
const iname=k=>ITEMS[normIngKey(k)||k]?ITEMS[normIngKey(k)||k].n:(OLD_NAMES[k]||k);
window.ITEMS=ITEMS;window.BASE_KEYS=BASE_KEYS;window.FLAV_KEYS=FLAV_KEYS;window.TOP_KEYS=TOP_KEYS;window.iname=iname;window.TGROUPS=TGROUPS;
window.normIngKey=normIngKey;window.fixOrder=fixOrder;window.canMakeRecipe=canMakeRecipe;
const low=n=>n.toLowerCase().replace('3q','3Q').replace('thái','Thái');
const dname=o=>(o&&o.trendName)?o.trendName:(ITEMS[o.base].n+(o.flav&&ITEMS[o.flav]?' '+low(ITEMS[o.flav].n):''));
window.dname=dname;
const PIECE={thachtc:['#ffffff','#e34b4b','#f39a3a'],thachpm:['radial-gradient(circle,#fffaf0 0 34%,#8a5a3b 40%)']};
const pieceBg=(t,i)=>PIECE[t]?PIECE[t][i%PIECE[t].length]:ITEMS[t].c;
/* ---------- HÌNH TRÁI CÂY + FOAM ---------- */
