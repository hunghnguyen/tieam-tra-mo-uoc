/* ===== HỆ THỐNG NÂNG CẤP ĐẾ CHẾ KHỞI NGHIỆP ĐỊA PHƯƠNG (CẤP 1 ➔ CẤP 5) ===== */
const STARTUP_EMPIRE_TIERS = [
  { lv: 1, name: 'Tiệm Mới Mở', title: 'Tiệm Mới Mở', icon: '🌱', reqDays: 0, cost: 0, stars: 0, reqStar5: 0, buffMul: 1.00, debuffMul: 1.00, perk: 'Hiệu ứng vùng nguyên bản (×1.00 Buff · ×1.00 Thử thách)' },
  { lv: 2, name: 'Quán Quen Phố Thị', title: 'Quán Quen Phố Thị', icon: '🏪', reqDays: 3, cost: 15000000, stars: 20, reqStar5: 20, buffMul: 1.25, debuffMul: 1.20, perk: 'Khuếch đại +25% Lợi thế vùng & +20% Thử thách vùng' },
  { lv: 3, name: 'Đặc Sản Địa Phương', title: 'Đặc Sản Địa Phương', icon: '🌟', reqDays: 7, cost: 80000000, stars: 60, reqStar5: 60, buffMul: 1.50, debuffMul: 1.40, perk: 'Khuếch đại +50% Lợi thế vùng & +40% Thử thách vùng' },
  { lv: 4, name: 'Biểu Tượng Tỉnh Thành', title: 'Biểu Tượng Tỉnh Thành', icon: '🏆', reqDays: 14, cost: 350000000, stars: 150, reqStar5: 150, buffMul: 1.80, debuffMul: 1.65, perk: 'Khuếch đại +80% Lợi thế vùng & +65% Thử thách vùng' },
  { lv: 5, name: 'Độc Tôn Vùng Miền', title: 'Độc Tôn Vùng Miền', icon: '👑', reqDays: 25, cost: 1500000000, stars: 400, reqStar5: 400, buffMul: 2.20, debuffMul: 2.00, perk: 'Đỉnh cao Đế Chế: +120% Lợi thế vùng & +100% Thử thách vùng' }
];
window.STARTUP_EMPIRE_TIERS = STARTUP_EMPIRE_TIERS;

function getStartupLocTier(lvArg){
  if(lvArg != null){
    const lvNum = Math.max(1, Math.min(5, parseInt(lvArg, 10) || 1));
    return STARTUP_EMPIRE_TIERS[lvNum - 1] || STARTUP_EMPIRE_TIERS[0];
  }
  if(typeof S === 'undefined' || !S || !S.startupLocation || S.startupLocation === 'default'){
    return STARTUP_EMPIRE_TIERS[0];
  }
  const lv = Math.max(1, Math.min(5, parseInt(S.startupLocLevel, 10) || 1));
  return STARTUP_EMPIRE_TIERS[lv - 1] || STARTUP_EMPIRE_TIERS[0];
}
function getStartupBuffMul(){
  return getStartupLocTier().buffMul || 1.0;
}
function getStartupDebuffMul(){
  return getStartupLocTier().debuffMul || 1.0;
}
function scaleStartupTraitText(txt, mul){
  if(!txt || !mul || mul === 1) return txt;
  return String(txt).replace(/([+\-]?\d+(?:[.,]\d+)?)(%|k\/ngày)/g, (match, numStr, unit) => {
    const cleanNum = parseFloat(numStr.replace(',', '.'));
    if(isNaN(cleanNum) || cleanNum === 0 || Math.abs(cleanNum) === 100) return match;
    const prefix = numStr.startsWith('+') ? '+' : (numStr.startsWith('-') ? '-' : '');
    const absVal = Math.abs(cleanNum) * mul;
    const formatted = Number.isInteger(Math.round(absVal * 10) / 10) ? String(Math.round(absVal)) : (Math.round(absVal * 10) / 10).toFixed(1).replace('.', ',');
    return `${prefix}${formatted}${unit}`;
  });
}
function upgradeStartupLocationEmpire(){
  if(typeof S === 'undefined' || !S) return;
  if(R && R.running){
    toast('⚠️ Hãy kết thúc ca bán hiện tại trước khi nâng cấp Đế Chế Địa Phương!');
    return;
  }
  if(typeof inDebt === 'function' && inDebt()){
    toast('⚠️ Đang nợ ngân hàng, hãy trả hết nợ trước khi nâng cấp Đế Chế Địa Phương!');
    return;
  }
  const curLoc = getStartupLocation();
  if(!curLoc || curLoc.isDefault || curLoc.id === 'default'){
    toast('⚠️ Tiệm Trà Ban Đầu không áp dụng nâng cấp Đế Chế Vùng Miền!');
    return;
  }
  const curLv = Math.max(1, Math.min(5, parseInt(S.startupLocLevel, 10) || 1));
  if(curLv >= 5){
    toast('👑 Bạn đã đạt đỉnh cao Cấp 5 (Độc Tôn Vùng Miền) tại ' + curLoc.name + '!');
    return;
  }
  const nextTier = STARTUP_EMPIRE_TIERS[curLv];
  const curDays = Math.max(0, parseInt(S.startupLocDays, 10) || 0);
  if(curDays < nextTier.reqDays){
    toast(`⏳ Cần trụ vững kinh doanh tại ${curLoc.name} đủ ${nextTier.reqDays} ngày để nâng lên Cấp ${nextTier.lv}! (Hiện tại: ${curDays}/${nextTier.reqDays} ngày)`, 4500);
    return;
  }
  if((S.money || 0) < nextTier.cost){
    toast(`⚠️ Két không đủ ${fmt(nextTier.cost)} để nâng cấp Đế Chế tại ${curLoc.name}!`, 4000);
    return;
  }
  if((S.star5Count || 0) < nextTier.stars){
    toast(`⭐ Cần tối thiểu ${nextTier.stars} Sao 5★ tích lũy để nâng lên Cấp ${nextTier.lv}! (Hiện có: ${S.star5Count || 0}⭐)`, 4000);
    return;
  }
  S.money -= nextTier.cost;
  S.star5Count = Math.max(0, (S.star5Count || 0) - nextTier.stars);
  S.startupLocLevel = nextTier.lv;
  if(S.cur && Array.isArray(S.cur.equip)){
    S.cur.equip.push({ n: `Nâng cấp Đế Chế ${curLoc.name} lên Cấp ${nextTier.lv} (${nextTier.title})`, v: nextTier.cost });
  }
  save();
  if(typeof head === 'function') head();
  try { sfx('lvup'); } catch(_){}
  toast(`🎉 Đã nâng cấp Đế Chế tại ${curLoc.name} lên Cấp ${nextTier.lv}: ${nextTier.icon} ${nextTier.title}! (🟢 Buff ×${nextTier.buffMul.toFixed(2)} · 🔴 Thử thách ×${nextTier.debuffMul.toFixed(2)})`, 5500, 1);
  if(typeof paneKhoiNghiep === 'function') paneKhoiNghiep();
}
window.upgradeStartupLocationEmpire = upgradeStartupLocationEmpire;

function applyStageBackground(st, locBg){
  if(!st) return;
  const defBg = `img/bg2.jpg?v=${GAME_VERSION}`;
  st.style.backgroundSize = '768px 1376px';
  st.style.backgroundRepeat = 'no-repeat';
  st.style.backgroundPosition = 'center top';

  if(!locBg || locBg === 'img/bg2.jpg' || locBg === 'default'){
    st.style.backgroundImage = `url('${defBg}')`;
    if($('q3sprs') && !$('q3sprs').innerHTML.trim() && st._defSpr){
      $('q3sprs').innerHTML = st._defSpr;
    }
    return;
  }

  const fullLocBg = locBg.includes('?') ? (locBg + `&v=${GAME_VERSION}`) : (locBg + `?v=${GAME_VERSION}`);
  st.style.backgroundImage = `url('${encodeURI(fullLocBg)}')`;

  const testImg = new Image();
  testImg.onload = () => {
    if(st) st.style.backgroundImage = `url('${encodeURI(fullLocBg)}')`;
  };
  testImg.onerror = () => {
    console.warn('Không tải được ảnh nền địa phương:', fullLocBg, '-> Tự động fallback về quầy gốc img/bg2.jpg');
    if(st) {
      st.style.backgroundImage = `url('${defBg}')`;
      if($('q3sprs') && !$('q3sprs').innerHTML.trim() && st._defSpr){
        $('q3sprs').innerHTML = st._defSpr;
      }
    }
  };
  testImg.src = fullLocBg;
}

function getStartupLocation(){
  let curId = (window.S && window.S.startupLocation) ? String(window.S.startupLocation).trim().toLowerCase() : 'default';
  const aliasMap = { saigon: 'hcm', tphcm: 'hcm', tp_hcm: 'hcm', bmt: 'buonmethuot', truongsa: 'hoangsa' };
  if(aliasMap[curId]) curId = aliasMap[curId];
  return STARTUP_LOCATIONS.find(l => l.id === curId) || STARTUP_LOCATIONS[0];
}

function setStartupLocation(id){
  const loc = STARTUP_LOCATIONS.find(l => l.id === id);
  if(!loc) return;
  if(S.startupLocation === id){
    toast('Tiệm đang đặt tại ' + loc.name + ' rồi!');
    return;
  }
  const isBackToDefault = (id === 'default' || loc.isDefault);
  const moveCost = isBackToDefault ? 0 : 1000000;
  if(moveCost > 0){
    if(S.money < moveCost){
      toast(`⚠️ Bạn không đủ ${fmt(moveCost)} (1tr) để chuyển điểm khởi nghiệp!`);
      return;
    }
    S.money -= moveCost;
  }
  const prevLv = S.startupLocLevel || 1;
  S.startupLocation = id;
  // Reset cấp độ Đế Chế Địa Phương và số ngày trụ vững về Cấp 1 (0 ngày) khi chuyển địa điểm
  S.startupLocLevel = 1;
  S.startupLocDays = 0;
  save();
  sfx('win');
  if(isBackToDefault){
    toast(`🏡 Đã trở về Tiệm Trà Ban Đầu!${prevLv > 1 ? ' (Đã reset cấp độ Đế Chế Địa Phương về Cấp 1)' : ''} Không gian quen thuộc, kinh doanh bình yên!`, 5000);
  } else {
    toast(`🎉 Khởi nghiệp thành công! Tiệm Trà đã dọn đến ${loc.name} (${loc.region}) — Bắt đầu xây dựng Đế Chế Cấp 1! (-${fmt(moveCost)}) 🗺️`, 5000);
  }
  
  // Cập nhật ngay hình nền quầy pha chế nếu đang trong ca bán
  const st = $('q3stage');
  if(st){
    const bgUrl = (isBackToDefault || !loc.bg) ? 'img/bg2.jpg' : loc.bg;
    applyStageBackground(st, bgUrl);
  }
  const tag = $('q3LocTag');
  if(tag){
    tag.innerHTML = `<span>${loc.icon} ${esc(loc.name)}</span>`;
    tag.onclick = () => { toast(`${loc.icon} ${loc.name}: 🟢 ${loc.pros[0]} | 🔴 ${loc.cons[0]}`, 4500); };
  }
  const signBadge = $('signLocBadge');
  if(signBadge){
    signBadge.innerHTML = `<span>${loc.icon} ${esc(loc.name)}</span>`;
    signBadge.title = `Địa điểm: ${esc(loc.name)} (${esc(loc.region)}) - Nhấn để đổi địa điểm khởi nghiệp`;
  }
  
  if(typeof switchTab === 'function') switchTab('khoinghiep');
}

function getStartupMenuRequirements(){
  return {
    isFull: true,
    missingBases: [],
    missingFlavs: [],
    missingTops: [],
    unlockedBases: BASE_KEYS.length,
    totalBases: BASE_KEYS.length,
    unlockedFlavs: FLAV_KEYS.length,
    totalFlavs: FLAV_KEYS.length,
    unlockedTops: TOP_KEYS.length,
    totalTops: TOP_KEYS.length
  };
}

function confirmRelocateShop(locId){
  if(R && R.running){
    toast('⚠️ Quán đang trong ca bán Ngày ' + (S && S.day ? S.day : '') + '! Hãy hoàn thành ca bán trước khi chuyển địa điểm mới nhé!', 4000);
    return;
  }
  const loc = STARTUP_LOCATIONS.find(l => l.id === locId);
  if(!loc) return;
  const curLoc = getStartupLocation();
  const curLv = Math.max(1, parseInt(S.startupLocLevel, 10) || 1);
  const curDays = Math.max(0, parseInt(S.startupLocDays, 10) || 0);
  const resetWarnHtml = (!curLoc.isDefault && (curLv > 1 || curDays > 0))
    ? `<div style="background:#fef2f2;border:1.5px solid #ef4444;border-radius:10px;padding:8px 12px;text-align:left;font-size:0.81rem;color:#991b1b;margin-bottom:10px;">
         ⚠️ <b>Cảnh báo Reset Đế Chế:</b> Bạn đang ở <b>Cấp ${curLv}/5 (${curDays} ngày trụ vững)</b> tại <b>${esc(curLoc.name)}</b>. Nếu rời đi nơi khác, cấp độ nâng cấp vùng và thâm niên tại đây sẽ <b>Reset về Cấp 1 (0 ngày)</b>!
       </div>`
    : '';

  if(locId === 'default' || loc.isDefault){
    ask(`
      <div style="font-size:2.4rem;margin-bottom:6px;">🏡</div>
      <h2 style="margin:0 0 6px;font-size:1.25rem;">Trở Về Tiệm Trà Ban Đầu?</h2>
      <div style="font-size:0.86rem;color:var(--soft);line-height:1.45;margin-bottom:12px;">
        Bạn muốn kết thúc chuyến khởi nghiệp và đưa quán về lại <b>Tiệm Trà Ban Đầu (Tiệm Trà Cũ)</b>?<br>
        <b style="color:#16a34a;">Miễn phí dọn quán 100%!</b><br>
        Quầy pha chế sẽ đổi lại nền gỗ kinh điển, gỡ bỏ toàn bộ thử thách & phụ phí vùng miền.
      </div>
      ${resetWarnHtml}
      <div style="background:var(--bg);border:1.5px solid var(--line);border-radius:10px;padding:8px 12px;text-align:left;font-size:0.82rem;margin-bottom:14px;">
        <b style="color:#16a34a;">Lợi ích:</b> Trở về nhịp buôn bán thư thái, an tâm tích luỹ doanh thu.<br>
        <b style="color:#d97706;">Lưu ý:</b> Bất cứ lúc nào bạn cũng có thể chọn khởi nghiệp lại tại 12 tỉnh thành!
      </div>
    `, [
      ['Ở lại khởi nghiệp', () => {}],
      ['Trở về tiệm cũ ngay 🏡', () => {
        setStartupLocation('default');
      }, 1]
    ]);
    return;
  }

  const moveCost = 1000000;
  if(S.money < moveCost){
    toast(`⚠️ Bạn cần ít nhất ${fmt(moveCost)} (1tr) để di chuyển điểm khởi nghiệp đến ${loc.name}! (Hiện có: ${fmt(S.money)})`, 4500);
    return;
  }
  const costTxt = `Chi phí dọn quán & xe tải chở đồ nghề: <b style="color:#e11d48;">${fmt(moveCost)} (1tr)</b>.`;
  
  ask(`
    <div style="font-size:2.4rem;margin-bottom:6px;">${loc.icon}</div>
    <h2 style="margin:0 0 6px;font-size:1.25rem;">Chuyển Khởi Nghiệp Đến ${esc(loc.name)}?</h2>
    <div style="font-size:0.86rem;color:var(--soft);line-height:1.45;margin-bottom:12px;">
      Bạn có muốn di dời quầy trà sữa đến <b>${esc(loc.name)} (${esc(loc.region)})</b> không?<br>
      ${costTxt}<br>
      Toàn bộ lợi thế và thử thách của vùng đất mới sẽ kích hoạt ngay lập tức (Bắt đầu từ Cấp 1)!
    </div>
    ${resetWarnHtml}
    <div style="background:var(--bg);border:1.5px solid var(--line);border-radius:10px;padding:8px 12px;text-align:left;font-size:0.82rem;margin-bottom:14px;">
      <b style="color:#16a34a;">Lợi thế:</b> ${loc.pros[0]}<br>
      <b style="color:#dc2626;">Thử thách:</b> ${loc.cons[0]}
    </div>
  `, [
    ['Huỷ bỏ', () => {}],
    ['Chuyển quán ngay (1tr) 🚀', () => {
      setStartupLocation(locId);
    }, 1]
  ]);
}


