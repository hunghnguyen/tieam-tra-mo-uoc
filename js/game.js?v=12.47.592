function fatalCopyrightTheft(detail){
  const crashNotice = `
    <div id="copyright-theft-fatal" style="position:fixed;inset:0;background:#450a0a;color:#fef2f2;z-index:99999999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:24px;text-align:center;font-family:system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased;">
      <div style="font-size:64px;line-height:1;margin-bottom:16px;">🚨</div>
      <h1 style="font-size:22px;font-weight:900;color:#fca5a5;margin:0 0 14px 0;letter-spacing:0.5px;">CẢNH BÁO BẢN QUYỀN MÃ NGUỒN TIỆM TRÀ MƠ ƯỚC</h1>
      <div style="max-width:540px;background:rgba(0,0,0,0.45);border:1.5px solid #ef4444;border-radius:14px;padding:18px 20px;margin-bottom:18px;text-align:left;line-height:1.65;font-size:13.5px;color:#fecaca;box-shadow:0 8px 30px rgba(0,0,0,0.5);">
        <p style="margin:0 0 10px 0;font-weight:700;color:#fef08a;">⛔ PHÁT HIỆN HÀNH VI XÓA HOẶC SỬA ĐỔI MÃ NGUỒN TRÁI PHÉP:</p>
        <p style="margin:0 0 12px 0;font-size:13px;color:#cbd5e1;background:#1e293b;padding:8px 12px;border-radius:8px;border-left:3px solid #ef4444;">${detail || 'Mã nguồn "Lời nhắn từ DEV" đã bị xoá bỏ khỏi hệ thống'}</p>
        <p style="margin:0;font-size:13px;line-height:1.6;color:#fee2e2;">
          "Mọi tính năng được cập nhật từ bản gốc Tiệm Trà Nhỏ của <b>duvicuaconsay</b> và bản bổ sung Tiệm Trà Mơ Ước của <b>kisutai_</b> . Mọi phiên bản mà có nội dung này đều chưa được sự đồng ý cho phép kể từ phiên bản Gen Z!!!<br>Đặc biệt Android đã có thể tải game về chơi rồi nhé ^^"
        </p>
      </div>
      <p style="font-size:12.5px;color:#fca5a5;margin:0;max-width:480px;line-height:1.5;">Hệ thống chống đánh cắp mã nguồn đã kích hoạt dừng vận hành. Toàn bộ tính năng web bị khóa vĩnh viễn.</p>
    </div>
  `;
  try {
    document.title = "⛔ LỖI BẢN QUYỀN MÃ NGUỒN";
    if (document.body) {
      document.body.innerHTML = crashNotice;
    } else {
      document.write(crashNotice);
    }
  } catch(e){}
  throw new Error("⛔ LỖI MÃ NGUỒN: Mã nguồn 'Lời nhắn từ DEV' (duvicuaconsay & kisutai_) đã bị xoá hoặc can thiệp trái phép! Web game bị vô hiệu hóa.");
}

function verifyDevNoticeIntegrity(){
  try {
    if (typeof DEV_MESSAGE_STATEMENT === 'undefined' || typeof DEV_MESSAGE_HTML === 'undefined') {
      return fatalCopyrightTheft("Thiếu hằng số bản quyền DEV_MESSAGE_STATEMENT");
    }
    const _dec = arr => arr.map(c => String.fromCharCode(c)).join('');
    const reqSignatures = [
      _dec([100,117,118,105,99,117,97,99,111,110,115,97,121]), // duvicuaconsay
      _dec([107,105,115,117,116,97,105,95]), // kisutai_
      _dec([84,105,7879,109,32,84,114,224,32,78,104,7887]), // Tiệm Trà Nhỏ
      _dec([84,105,7879,109,32,84,114,224,32,77,417,32,431,7899,99]), // Tiệm Trà Mơ Ước
      _dec([71,101,110,32,90]), // Gen Z
      _dec([65,110,100,114,111,105,100]) // Android
    ];
    for (const sig of reqSignatures) {
      if (!DEV_MESSAGE_STATEMENT.includes(sig) || !DEV_MESSAGE_HTML.includes(sig)) {
        return fatalCopyrightTheft(`Mã nguồn thiếu chữ ký xác thực quyền tác giả: "${sig}"`);
      }
    }
    return true;
  } catch(err) {
    fatalCopyrightTheft("Lỗi kiểm tra toàn vẹn mã nguồn: " + (err && err.message));
    throw err;
  }
}

