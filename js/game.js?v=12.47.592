function enterDreamShopFromNotice() {
  try {
    if (typeof sfx === 'function') sfx('tap');
    const b = typeof $ === 'function' ? $('spBanner') : document.getElementById('spBanner');
    if (b) b.style.display = 'none';
    const sp = typeof $ === 'function' ? $('splash') : document.getElementById('splash');
    if (sp && !sp.hidden) {
      const go = typeof $ === 'function' ? $('spGo') : document.getElementById('spGo');
      if (go && !go.hidden) {
        go.click();
      } else if (typeof closeSplash === 'function') {
        closeSplash();
        if (typeof renderPrep === 'function') renderPrep();
      }
    }
  } catch(e) {
    console.error('Lỗi khi vào Tiệm Trà Mơ Ước:', e);
  }
}
window.enterDreamShopFromNotice = enterDreamShopFromNotice;

