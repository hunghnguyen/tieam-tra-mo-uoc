const STAFF=[
  {id:'staff0',n:'Thử việc 0 lương',d:'Nhân viên rót trà và xúc đá. Bạn lấy ly, hương, đường, topping và dán nắp. Lương: Tiền tip của quán (0đ lương cứng, không xét KPI). 10% sai bill, 8% trốn việc. Tốc độ: 300ms.',cost:0,wage:'wage0',from:1},
  {id:'staff1',n:'Thử việc chính thức',d:'Nhân viên rót trà, hương, đường, đá. Bạn lấy ly, bỏ topping và dán nắp. 10% sai bill, hỏng thì đổ bỏ làm lại. Không thể thuê cùng Quản lý tập sự, Gen Z và SV ca đêm. Lương 165k/ngày. Tốc độ: 280ms.',cost:500000,wage:'wage1',from:1},
  {id:'staff2',n:'Nhân viên pha chế',d:'Nhận trọn đơn của khách chờ lâu nhất và pha hết các ly khi quầy có từ 2 khách trở lên. Nhận 20% tiền tip chia cùng chủ quán (chủ hưởng 80%, NV nhận 20%). Lương 200k/ngày + 40k/h sau 22h. Tốc độ: 1500ms/ly.',cost:1000000,wage:'wage2',from:30},
  {id:'staffOn',n:'Nhân viên đơn online',d:'Chỉ làm đơn online: nhận trọn đơn và pha hết các ly. Đôi khi làm hỏng ly 1%, hỏng thì đổ bỏ làm lại. Lương 250k/ngày. Tốc độ: 1000ms/ly.',cost:2000000,wage:'wageOn',from:1},
  {id:'staff3',n:'Quản lý tập sự',d:'Nhân viên rót trà, hương, đường, đá, múc topping. Bạn chỉ lấy ly và dán nắp. 5% sai bill hỏng đổ bỏ. Đôi khi rót trà không đầy, chủ tiệm phải rót bù. Có thể thuê làm ca ngày cùng Sinh viên ca đêm (22h–6h) và Gen Z (hỗ trợ quầy khi Gen Z dỗi hoặc nghỉ việc). Không thể thuê cùng Thử việc chính thức. Lương 200k/ngày. Tốc độ: 280ms.',cost:750000,wage:'wage3',from:1},
  {id:'staffGz',n:'Nhân viên Gen Z',d:'Pha chế siêu tốc từ A-Z. Mỗi khi làm 100 ly sẽ dỗi 10s, chủ tiệm phải dỗ dành nếu không sẽ nghỉ việc. Mỗi ngày đá bill 1 lần, nếu bắt được sẽ trả lại tiền bill. Có thể thuê cùng Quản lý tập sự để quán luôn có người làm khi Gen Z nghỉ. Không thể thuê cùng Thử việc chính thức. Lương 300k/ngày. Tốc độ: 200ms.',cost:1000000,wage:'wageGz',from:1},
  {id:'staffBuyer',n:'Nhân viên đi chợ',d:'Khi hết nguyên liệu (trà sữa, topping, ly, đá...), tự chạy đi chợ mua về bán ngay trong ca. Nếu đi chợ nhiều lần trong ngày có thể khai gian hóa đơn đút túi riêng, hoặc mua trúng đồ hết hạn gây ngộ độc. Không thể thuê cùng Chiến thần xa lộ. Lương 180k/ngày. Tốc độ: 2-5s/lần.',cost:500000,wage:'wageBuyer',from:1},
  {id:'staffSv',n:'Sinh viên cuối tháng',d:'Chỉ làm ca đêm 22h–6h: nhận trọn đơn và pha hết các ly đang chờ. Có thể nhầm size. Sau 2h sáng túng tiền muốn bán trang bị cần chủ tiệm ngăn cản. Đôi khi nhận thiếu tiền của khách vì buồn ngủ. Có thể thuê làm ca đêm cùng Quản lý tập sự ca ngày. Không thể thuê cùng Thử việc chính thức. Lương 300k/ca đêm. Tốc độ: 250ms.',cost:800000,wage:'wageSv',from:1,},
  {id:'staffMkt',n:'Nhân viên Me két tinh',d:'Tự động cứu 100% video TikTok của Lích Đờ khỏi bị flop (chạy seeding & bơm tương tác tức thì, ngăn Lích Đờ dỗi nộp đơn nghỉ việc). Tự động quay & đăng video TikTok viral liên tục cho quán thay vì chủ quán phải tự quay, thu hút followers và buff mạnh lượng khách ghé quán (+45%). Giảm 20% thời gian pha của toàn bộ nhân viên (Gen Z 200ms còn 160ms). Tự động phản hồi mọi đánh giá & nâng sao. Tự động đóng thuế duy trì buff 72h liên tục. Lương 350k/ngày.',cost:1500000,wage:'wageMkt',from:1},
  {id:'staffGuard',n:'Chú bảo vệ',d:'Bảo vệ tiệm khi bán hàng: Chặn 90% nguy cơ tiền giả, bùng tiền, trộm cắp quầy trong ca bán; 90% ngăn khách ăn quỵt 0đ ly sai món; giảm 50% tỉ lệ sai sót của nhân viên. Lưu ý: Tiền két vượt mức quy định vẫn bị trộm cắp như thường. Lương: 300k/ngày + 1% doanh thu. Có thể nộp đơn xin nghỉ việc; thuê / thuê lại bằng tiền lương ngày + 1% doanh thu quán. Chú ý: Thuê 3 ngày liên tục thì chú phải nghỉ ngơi 1 ngày bán hàng để ngủ lấy sức.',cost:300000,wage:'wageGuard',from:1},
  {id:'staffRacer',n:'Chiến thần xa lộ',d:'Đi chợ siêu tốc tức thì (0s chờ), 100% không bao giờ mua đồ bị hỏng hay khai gian. Tăng % đơn online & khách online, tăng mạnh tiền tip đơn online. Không thể thuê cùng Nhân viên đi chợ. Lương: 1tr/ngày + 0.5% doanh thu ngày. Có thể nộp đơn xin nghỉ việc; thuê / thuê lại bằng tiền lương ngày + 0.5% doanh thu quán.',cost:1000000,wage:'wageRacer',from:1},
  {id:'staffButler',n:'Quản gia',d:'Tự động mua hạt giống trồng cây, chu đáo chăm sóc thú cưng, sửa chữa các trang bị hỏng tức thì. Quản gia bảo chứng: Tối ưu giá kịt trần (+30% cho 3 món Best Seller & 3 món ngẫu nhiên mỗi ngày) mà khách 100% không bao giờ chê đắt, các món thông thường giữ giá chuẩn. Bạn có thể tự do điều chỉnh giá mà không lo bị reset. Khi có Quản gia, nhân viên có 35% tỉ lệ tự giác không nhận tiền bo và nhường trọn 100% vào két cho chủ tiệm. Lương 500k/ngày + 2% doanh thu. Có thể nộp đơn xin nghỉ việc; thuê / thuê lại bằng tiền lương ngày + 2% doanh thu quán.',cost:500000,wage:'wageButler',from:1},
  {id:'staffCleaner',n:'Nhân Diên Zọn Zẹp',d:'Tự động dọn dẹp sảnh tiệm sạch bóng toàn bộ 4 phòng bàn ghế, tăng mạnh tỉ lệ khách bo (+20% Tip toàn quán, +35% Tip sảnh), thu hút nhiều nhóm khách ghé thăm sảnh trà (+30% khách sảnh & nhóm đông). Lương: 400k/ngày + 1.5% doanh thu. Có thể nộp đơn xin nghỉ việc; thuê / thuê lại bằng tiền lương ngày + 1.5% doanh thu quán.',cost:1000000,wage:'wageCleaner',from:1},
  {id:'staffShipper',n:'Shipper Thần Tốc',d:'Mở khóa nhận & giao đơn online xuyên suốt ca đêm (22h–6h). Tăng sức chứa hàng đợi đơn online lên 10 đơn, tăng mạnh tỉ lệ đơn online giao về tiệm (+80%), mở rộng cơ hội bùng nổ doanh số giao tận nơi. Lương: 600k/ngày + 1% doanh thu. Có thể nộp đơn xin nghỉ việc; thuê / thuê lại bằng tiền lương ngày + 1% doanh thu quán.',cost:1200000,wage:'wageShipper',from:1}
];
