    ${stk('pearl',70,120,74,4.2,0)}${stk('star',300,40,62,3.6,1)}${stk('cup',600,60,96,5,2)}${stk('heart',684,300,56,3.8,.5)}
    ${stk('berry',80,1228,64,4.6,1.5)}${stk('leaf',626,1228,66,5.2,3)}
    <img class="sp4-head" src="${IMG}cathead.png" alt="">
    <span class="sp4-z" style="animation-delay:0s">z</span><span class="sp4-z" style="animation-delay:1s">z</span><span class="sp4-z" style="animation-delay:2s">z</span>
    <h1 class="sp4-t">Tiệm Trà Mơ Ước</h1>
    <p class="sp4-tag">Pha trà, đón khách, mở tiệm nhỏ của riêng bạn</p>
    ${had?`<p class="sp4-me">${esc(shopName())} · Ngày ${S.day} · ${fmt(S.money)}</p>`:''}
    <div class="sp4-foot"><div class="sp4-msg" id="spMsg">${SP_MSG[0]}</div>
      <div class="sp4-bar" id="spBarW"><i id="spBar"></i><span id="spPct">0%</span></div>
      <button class="sp4-go" id="spGo" hidden>${had?'Chơi tiếp':'Bắt đầu'}</button>
      ${(had && S && (S.day > 1 || (S.served || 0) > 0))?'<button class="sp4-help" id="spHelp" hidden>Hướng dẫn</button>':'<button class="sp4-help" id="spHelp" hidden>Có mã sao lưu? Khôi phục</button>'}</div>
    <!--<div class="sp4-ver">${GAME_VERSION}</div></div>
    <div class="sp-banner-overlay" id="spBanner">
      <div class="sp-banner-card">
        <button class="sp-banner-close" id="spBannerClose" aria-label="Đóng">✕</button>
        <div class="sp-banner-badge">📢 Lời nhắn từ Dev</div>
        <h2 class="sp-banner-title">Tiệm Trà Mơ Ước</h2>
        <p class="sp-banner-text">${DEV_MESSAGE_HTML}</p>
        <div class="sp-banner-qr-wrap">
          <img src="img/threads.png" alt="Mã Threads" class="sp-banner-qr">
          <span class="sp-banner-qr-caption">Quét mã QR để theo dõi kênh Threads cập nhật mới!</span>
        </div>
        <!-- Đã chuyển nút Vào chơi ngay thành thẻ Highlight ở trên -->
        <!--<button type="button" class="sp-banner-btn sp-banner-update-btn" id="spBannerUpdateBtn" style="background:linear-gradient(135deg,#0284c7,#0369a1);margin-top:8px;box-shadow:0 6px 16px rgba(2,132,199,.35);">🔄 Cập nhật bản mới</button>-->
      </div>
    </div>-->
  </div>`;
  sp.hidden=false;spFit();
  if ($('spBannerUpdateBtn')) $('spBannerUpdateBtn').onclick = forceGlobalAppUpdate;
  const onEnterDreamShop = () => {
    try { if (typeof sfx === 'function') sfx('tap'); } catch(e) {}
    const b = $('spBanner');
    if (b) b.style.display = 'none';
    if ($('splash') && !$('splash').hidden) {
      if ($('spGo') && !$('spGo').hidden) {
        $('spGo').click();
      } else {
        if (had) {
          closeSplash();
          if (after) after();
        } else {
          showTour(true);
        }
      }
    }
  };
  window.enterDreamShopFromNotice = onEnterDreamShop;
  if ($('btnEnterDreamShop')) $('btnEnterDreamShop').onclick = onEnterDreamShop;
  if ($('spBannerBtn')) $('spBannerBtn').onclick = onEnterDreamShop;
  if ($('spBannerClose')) $('spBannerClose').onclick = () => { const b = $('spBanner'); if (b) b.style.display = 'none'; };
  const fitTag=()=>{const t=document.querySelector('.sp4-tag');if(!t)return;let f=26;t.style.fontSize=f+'px';while(t.scrollWidth>t.clientWidth+1&&f>16){f--;t.style.fontSize=f+'px'}};fitTag();if(document.fonts)document.fonts.ready.then(fitTag);
  $('spGo').onclick=()=>{if(had){closeSplash();after&&after()}else showTour(true)};
  $('spHelp').onclick=(had && S && (S.day > 1 || (S.served || 0) > 0))?()=>showTour(false,false,after):()=>restoreDlg();
  const files=['splash2.jpg','cathead.png','bg2.jpg','bg.jpg','faces.webp','faces2.webp','ship.webp','ship2.webp','star.webp','cup.png','lid.png','kho.jpg','ic_box.png','ic_tools.png','ic_price.png','ic_star.png','ic_chart.png','lanL.png','lanR.png'];let done=0,shown=0;const t0=performance.now();
  files.forEach(f=>{const im=new Image();im.onload=im.onerror=()=>done++;im.src=IMG+f});
  const step=()=>{if(!$('spBar'))return;const want=Math.min(done/files.length,(performance.now()-t0)/1600);shown+=(want-shown)*.16;if(want>=1&&shown>.985)shown=1;
    const pc_=Math.round(shown*100);$('spBar').style.width=pc_+'%';$('spPct').textContent=pc_+'%';$('spMsg').textContent=SP_MSG[Math.min(SP_MSG.length-1,Math.floor(shown*SP_MSG.length))];
    if(shown>=1){$('spBarW').hidden=true;$('spMsg').hidden=true;$('spGo').hidden=false;if($('spHelp'))$('spHelp').hidden=false;$('spGo').focus();return}
    requestAnimationFrame(step)};
  requestAnimationFrame(step);
}
function spFit(){const st=$('spStage');if(!st)return;const W=vpW(),H=vpH(),s=H/1376;st.style.transform=`scale(${s})`;st.style.left=((W-768*s)/2)+'px'}
addEventListener('resize',spFit);
function tourSlides(){
  const row=(k,q)=>`<div class="trw">${itemIcon(k)}<b>${ITEMS[k].n}</b>${lifeTag(k)}<span class="chip2">+${q}</span></div>`;
  return [
    ['Nấu hàng buổi sáng','Vào Kho, bấm + chọn số phần, bấm Nấu & nhập rồi Mở cửa. Mỗi món có hạn dùng, hết hạn là phải đổ bỏ',`<div class="till">${row('tra',15)}${row('tcden',10)}${row('thach',10)}<div class="tnote">${ico('trash')} Hết hạn = mất tiền</div></div>`],
    ['Đọc đơn của khách','Khách nói món trong bóng thoại, ly nhỏ bên cạnh là hình món khách muốn. Vòng tròn quanh mặt khách là thời gian chờ, hết vòng là khách bỏ về',`<div class="till"><div class="say tsay"><i class="tfc" style="${faceBg(0,0,40,39)}"></i><span>1 ly <b>trà sữa</b> size <b>L</b>, trân châu đen nha!</span></div>
      <div class="tcup">${cupHTML({base:'tra',tops:['tcden'],size:'L',ice:null},false)}<span class="tarrow"><svg width="30" height="20" viewBox="0 0 30 20"><path d="M2 10h22M17 3l8 7-8 7" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg><i class="tfc big" style="${faceBg(0,1,60,59)}"></i></span></div></div>`],
    ['Bước 1: lấy ly','Chạm chồng ly M hoặc L đúng size khách gọi. Ly sẽ nằm trên thớt gỗ',`<div class="till">${cropBg(8,355,146,236,150)}</div>`],
    ['Bước 2: rót trà','Nhấn giữ hũ trà khách gọi. Nước dâng dần, thả tay khi tới vạch xanh đứt nét trên ly. Giữ quá lâu là tràn ly',`<div class="till">${cropBg(158,352,470,176,290)}</div>`],
    ['Bước 3: topping và hương','Chạm khay topping để múc 1 phần vào ly. Khách gọi vị trái cây (dâu, xoài…) thì chạm chai siro ở kệ dưới',`<div class="till">${cropBg(280,608,482,334,290)}</div>`],
    ['Đường và đá','Từ ngày '+CFG.levels.l2+' khách chọn mức đường và đá. Bấm bình nước đường và xô đá đúng số lần, rồi mới dán nắp. Bấm dư thì phải đổ ly làm lại',`<div class="till"><table class="gtab"><tr><th>Khách gọi</th><th>Bấm bình nước đường</th></tr>${SUGAR.map((v,i)=>`<tr><td>${v}% đường</td><td>${i+1} lần</td></tr>`).join('')}</table>
      <table class="gtab"><tr><th>Khách gọi</th><th>Xúc đá</th></tr><tr><td>Không đá</td><td>Không xúc</td></tr><tr><td>Ít đá</td><td>1 lần</td></tr><tr><td>Đá bình thường</td><td>2 lần</td></tr></table>
      <div class="tnote">Thứ tự không quan trọng: trà, hương, topping, đường, đá xong là dán nắp</div></div>`],
    ['Bước 4: dán nắp và giao','Chạm máy dán nắp, ly tự đưa cho khách. Lỡ làm sai thì chạm xô inox để đổ ly, làm lại',`<div class="till"><div style="display:flex;gap:14px;justify-content:center;align-items:flex-end">${cropBg(632,322,134,246,110)}${cropBg(182,574,98,112,80)}</div></div>`],
    ['Khách chấm sao','Càng nhiều sao càng đông khách. Dưới 4 sao là quán vắng hẳn',`<div class="till"><div class="trev"><i class="tfc rf" style="${faceBg(3,1,44,43)}"></i><div><div class="stars" style="font-size:1.5rem">★★★★★</div><div class="say">Làm nhanh, đúng vị</div></div></div>
      <div class="trev"><i class="tfc rf" style="${faceBg(5,2,44,43)}"></i><div><div class="stars" style="font-size:1.5rem">★★☆☆☆</div><div class="say">Chờ lâu quá</div></div></div></div>`],
    ['Lời thì mở món mới','Trà, hương vị, topping, trang bị, đơn online',`<div class="till"><div class="pg4">
      <div class="lock unl">${baseCup('thai')}<b>Trà</b></div><div class="lock unl">${flavIcon('f_dau',24)}<b>Hương</b></div>
      <div class="lock unl">${topIcon('fube',1)}<b>Kem</b></div><div class="lock unl">${topIcon('pmvien',1)}<b>Phô mai</b></div></div>
      <div class="trw"><span class="icon">${ico('phone')}</span><b>Đơn online</b><span class="chip2">Ngày ${CFG.online.fromDay}</span></div></div>`]
  ];
}
function showTour(isNew,fromGame,after){
  const sp=$('splash'),sl=tourSlides();
  if(isNew)sl.push(['Đặt tên quán','',`<div class="till"><div style="text-align:center"><img class="ico" src="img/ic_cupfull.png" alt="" style="width:64px;height:64px"></div><input id="nameIn" class="pinbox nm" maxlength="30" placeholder="Ví dụ: Trà Sữa Nhà Mèo" aria-label="Tên quán"></div>`,1]);
  const n=sl.length;
  sp.innerHTML=`<div class="awning"></div><div class="tour">
    <button class="sp-link skip" id="tSkip">${isNew?'Bỏ qua ›':'Đóng ✕'}</button>
    <div class="tourw" id="tw">${sl.map(([h,p,ill,top])=>top?`<div class="tpage"><h2>${h}</h2>${p?`<p>${p}</p>`:''}${ill}</div>`:`<div class="tpage">${ill}<h2>${h}</h2>${p?`<p>${p}</p>`:''}</div>`).join('')}</div>
    <div class="dots" id="tDots">${sl.map((x,i)=>`<i class="${i?'':'on'}"></i>`).join('')}</div>
    <button class="big" id="tNext">Tiếp ➜</button></div>`;
  sp.hidden=false;
  const tw=$('tw'),dots=[...$('tDots').children];let cur=0;
  const finish=()=>{if(isNew){setName(($('nameIn')||{}).value);closeSplash();renderPrep()}else{closeSplash();if(!fromGame&&after)after()}};
  const upd=()=>{cur=Math.round(tw.scrollLeft/tw.clientWidth);dots.forEach((d,i)=>d.classList.toggle('on',i===cur));
    $('tNext').innerHTML=cur===n-1?(isNew?'Khai trương':'Vào quán'):'Tiếp ➜';
    if(isNew&&cur===n-1)setTimeout(()=>{const i=$('nameIn');if(i&&document.activeElement!==i)i.focus({preventScroll:true})},250)};
  tw.onscroll=()=>{clearTimeout(tw._t);tw._t=setTimeout(upd,60)};
  const go=i=>tw.scrollTo({left:i*tw.clientWidth,behavior:'smooth'});
  $('tNext').onclick=()=>{if(cur>=n-1)finish();else go(cur+1)};
  $('tSkip').onclick=()=>{if(isNew&&cur<n-1)go(n-1);else finish()};
  if(isNew)tw.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.id==='nameIn')finish()});
}

/* ---------- SAO LƯU / KHÔI PHỤC BẰNG MÃ ---------- */
const BAK_SALT_LEGACY = 'ttn-bak-7f3a';
const BAK_SALT_V2 = 'ttn-sec-v2-8a9f4c1e2b-2026';
function bakHash(t, salt = BAK_SALT_V2){
  let h = 0x811c9dc5;
  const x = salt + t + salt.length;
  for(let i = 0; i < x.length; i++){
    h ^= x.charCodeAt(i);
    h = Math.imul(h, 0x01000193) >>> 0;
  }
  return h.toString(36);
}
const b64e=u8=>{let s='';for(let i=0;i<u8.length;i+=0x8000)s+=String.fromCharCode.apply(null,u8.subarray(i,i+0x8000));return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')};
const b64d=t=>{
  t=String(t||'').replace(/[^A-Za-z0-9\+\/\-_]/g,'').replace(/-/g,'+').replace(/_/g,'/');
  while(t.length%4)t+='=';
  const s=atob(t),u=new Uint8Array(s.length);
  for(let i=0;i<s.length;i++)u[i]=s.charCodeAt(i);
  return u;
};
async function zipBytes(u8,dir){
  try {
    const C=dir?window.CompressionStream:window.DecompressionStream;
    if(!C)return null;
    const st=new Blob([u8]).stream().pipeThrough(new C('gzip'));
    return new Uint8Array(await new Response(st).arrayBuffer());
  } catch(e) {
    console.warn('zipBytes failed:', e);
    return null;
  }
}
async function makeBackup(){
  const json=JSON.stringify(S),raw=new TextEncoder().encode(json);let z=null;try{z=await zipBytes(raw,1)}catch(e){}
  const body=(z?'z':'p')+b64e(z||raw);return 'TTN1.'+body+'.'+bakHash(body, BAK_SALT_V2);
}

function b64url_e(u8){
  let bin = '';
  for(let i=0; i<u8.length; i++) bin += String.fromCharCode(u8[i]);
  return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}
function b64url_d(str){
  let b64 = str.replace(/-/g, '+').replace(/_/g, '/');
  while(b64.length % 4) b64 += '=';
  const bin = atob(b64);
  const u8 = new Uint8Array(bin.length);
  for(let i=0; i<bin.length; i++) u8[i] = bin.charCodeAt(i);
  return u8;
}

function makeUltraCompactBackup(){
  const allLocs = (typeof STARTUP_LOCATIONS !== 'undefined' && Array.isArray(STARTUP_LOCATIONS)) ? STARTUP_LOCATIONS.map(l => l.id) : ['default'];
  const allThemes = (typeof THEMES !== 'undefined' && Array.isArray(THEMES)) ? THEMES.map(t => t.id) : ['default'];
  const allUpgs = (typeof UPG !== 'undefined' && Array.isArray(UPG)) ? UPG.map(u => u.id) : [];
  const allStaff = (typeof STAFF !== 'undefined' && Array.isArray(STAFF)) ? STAFF.map(s => s.id) : [];
  const allItems = (typeof ITEMS !== 'undefined') ? Object.keys(ITEMS) : [];

  const locIdx = Math.max(0, allLocs.indexOf(S.startupLocation || 'default')) & 0x0f;
  const themeIdx = Math.max(0, allThemes.indexOf(S.theme || 'default')) & 0x0f;

  let upgMask = 0;
  allUpgs.forEach((k, i) => { if(S.upg && S.upg[k]) upgMask |= (1 << i); });

  let staffMask = 0;
  allStaff.forEach((k, i) => { if(S.hired && S.hired[k]) staffMask |= (1 << i); });

  const pet = S.pet || {};
  const petB1 = (pet.unlocked ? 0x80 : 0) | (pet.type === 'cat' ? 0x40 : 0) | ((pet.level || 1) & 0x3f);
  const petB2 = Math.min(255, pet.exp || 0);

  const capbi = S.capbi || {};
  const capbiB1 = (capbi.unlocked ? 0x80 : 0) | (capbi.active ? 0x40 : 0) | ((capbi.level || 1) & 0x3f);
  const capbiB2 = Math.min(255, capbi.exp || 0);

  const garden = S.garden || {};
  const gardenB1 = (garden.unlocked ? 0x80 : 0) | ((garden.level || 1) & 0x7f);
  const gardenB2 = Math.min(255, Math.floor((garden.points || 0) / 10));

  const stockList = [];
  if(S.stock && typeof S.stock === 'object'){
    Object.keys(S.stock).forEach(k => {
      const idx = allItems.indexOf(k);
      const q = Array.isArray(S.stock[k]) 
        ? S.stock[k].reduce((sum, b) => sum + (b && b.q || 0), 0)
        : (typeof S.stock[k] === 'number' ? S.stock[k] : 0);
      if(idx >= 0 && q > 0) stockList.push({ idx, q: Math.min(65535, q) });
    });
  }

  const nameBytes = new TextEncoder().encode(S.shopName || 'Tiệm Trà Mơ Ước');
  const nameLen = Math.min(255, nameBytes.length);

  const totalLen = 19 + 1 + stockList.length * 3 + 1 + nameLen;
  const u8 = new Uint8Array(totalLen);
  const dv = new DataView(u8.buffer);

  let off = 0;
  dv.setUint8(off++, 3); // v3
  dv.setUint16(off, Math.min(65535, S.day || 1), true); off += 2;
  const moneyK = Math.min(0xffffffff, Math.floor((S.money || 0) / 1000));
  dv.setUint32(off, moneyK, true); off += 4;
  dv.setUint8(off++, locIdx | (themeIdx << 4));
  dv.setUint8(off++, Math.min(255, S.crushLevel || 1));
  dv.setUint16(off, upgMask, true); off += 2;
  dv.setUint16(off, staffMask, true); off += 2;
  dv.setUint8(off++, petB1);
  dv.setUint8(off++, petB2);
  dv.setUint8(off++, capbiB1);
  dv.setUint8(off++, capbiB2);
  dv.setUint8(off++, gardenB1);
  dv.setUint8(off++, gardenB2);

  dv.setUint8(off++, stockList.length);
  stockList.forEach(item => {
    dv.setUint8(off++, item.idx);
    dv.setUint16(off, item.q, true); off += 2;
  });

  dv.setUint8(off++, nameLen);
  u8.set(nameBytes.subarray(0, nameLen), off);

  return 'TTN3.' + b64url_e(u8);
}

function expandUltraCompactBackup(code){
  const rawStr = code.replace(/^TTN3\./i, '');
  const u8 = b64url_d(rawStr);
  const dv = new DataView(u8.buffer);

  const allLocs = (typeof STARTUP_LOCATIONS !== 'undefined' && Array.isArray(STARTUP_LOCATIONS)) ? STARTUP_LOCATIONS.map(l => l.id) : ['default'];
  const allThemes = (typeof THEMES !== 'undefined' && Array.isArray(THEMES)) ? THEMES.map(t => t.id) : ['default'];
  const allUpgs = (typeof UPG !== 'undefined' && Array.isArray(UPG)) ? UPG.map(u => u.id) : [];
  const allStaff = (typeof STAFF !== 'undefined' && Array.isArray(STAFF)) ? STAFF.map(s => s.id) : [];
  const allItems = (typeof ITEMS !== 'undefined') ? Object.keys(ITEMS) : [];

  let off = 0;
  const v = dv.getUint8(off++);
  if(v !== 3) throw 'Phiên bản mã không khớp';

  const day = dv.getUint16(off, true); off += 2;
  const moneyK = dv.getUint32(off, true); off += 4;
  const money = moneyK * 1000;
  const locTheme = dv.getUint8(off++);
  const locIdx = locTheme & 0x0f;
  const themeIdx = (locTheme >> 4) & 0x0f;
  const startupLocation = allLocs[locIdx] || 'default';
  const theme = allThemes[themeIdx] || 'default';
  const crushLevel = dv.getUint8(off++);

  const upgMask = dv.getUint16(off, true); off += 2;
  const upg = {};
  allUpgs.forEach((k, i) => { if(upgMask & (1 << i)) upg[k] = true; });

  const staffMask = dv.getUint16(off, true); off += 2;
  const hired = {};
  allStaff.forEach((k, i) => { if(staffMask & (1 << i)) hired[k] = true; });

  const petB1 = dv.getUint8(off++);
  const petB2 = dv.getUint8(off++);
  const pet = {
    unlocked: !!(petB1 & 0x80),
    type: (petB1 & 0x40) ? 'cat' : 'dog',
    level: petB1 & 0x3f,
    exp: petB2
  };

  const capbiB1 = dv.getUint8(off++);
  const capbiB2 = dv.getUint8(off++);
  const capbi = {
    unlocked: !!(capbiB1 & 0x80),
    active: !!(capbiB1 & 0x40),
    level: capbiB1 & 0x3f,
    exp: capbiB2
  };

  const gardenB1 = dv.getUint8(off++);
  const gardenB2 = dv.getUint8(off++);
  const garden = {
    unlocked: !!(gardenB1 & 0x80),
    level: gardenB1 & 0x7f,
    points: gardenB2 * 10
  };

  const stockCount = dv.getUint8(off++);
  const stock = {};
  allItems.forEach(k => { stock[k] = []; });
  for(let i=0; i<stockCount; i++) {
    const itemIdx = dv.getUint8(off++);
    const q = dv.getUint16(off, true); off += 2;
    const k = allItems[itemIdx];
    if(k && q > 0) stock[k] = [{ q, exp: 99999 }];
  }

  const nameLen = dv.getUint8(off++);
  const shopName = new TextDecoder('utf-8').decode(u8.subarray(off, off + nameLen));

  const curS = window.S || {};
  const f = (typeof fresh === 'function') ? fresh() : {};
  const d = {
    ...f,
    shopName: shopName || (f.shopName || 'Tiệm Trà Mơ Ước'),
    day: day || 1,
    money: (money != null) ? money : (f.money || 0),
    startupLocation: startupLocation || 'default',
    theme: theme || 'default',
    crushLevel: crushLevel || 1,
    upg: { ...(f.upg || {}), ...upg },
    hired: { ...(f.hired || {}), ...hired },
    stock: { ...(f.stock || {}), ...stock },
    pet: f.pet ? { ...f.pet, ...pet } : pet,
    capbi: f.capbi ? { ...f.capbi, ...capbi } : capbi,
    garden: f.garden ? { ...f.garden, ...garden } : garden,
    collection: curS.collection || f.collection,
    lobbyRooms: curS.lobbyRooms || f.lobbyRooms || [true, false, false, false],
    decor: curS.decor || f.decor || {},
    activeDecor: curS.activeDecor || f.activeDecor || {},
    bank: curS.bank || f.bank || null,
    upgLv: curS.upgLv || f.upgLv || {},
    equipLv: curS.equipLv || f.equipLv || {}
  };

  return d;
}

async function makeCompactBackup(){
  const compact = {
    _v: 3,
    name: S.shopName || '',
    day: S.day || 1,
    money: (S.money != null) ? S.money : CFG.startMoney,
    loc: S.startupLocation || 'default',
    locLv: S.startupLocLevel || 1,
    locDays: S.startupLocDays || 0,
    theme: S.theme || 'default',
    themes: S.ownedThemes || { default: true },
    rev: S.totalRev || 0,
    tbr: Math.max(0, Number(S.totalBranchRev) || 0),
    tbn: Number(S.totalBranchNet) || 0,
    hl: Math.max(Number(S.historyLengthTotal) || 0, Number(S._restoredHistoryLen) || 0, Array.isArray(S.history) ? S.history.length : 0, (Number(S.day) || 1) - 1),
    br: S.branches || {},
    fr: S.franchise || null,
    prof: S.totalProfit || 0,
    st5: S.star5Count || 0,
    serv: S.served || 0,
    best: S.best || 0,
    bdr: S.bestDayRev || 0,
    bds: S.bestDayServed || 0,
    bank: S.bank ? {
      bal: S.bank.balance || S.bank.savings || 0,
      prin: S.bank.principal || S.bank.balance || S.bank.savings || 0,
      cap: S.bank.cap || 10000000,
      term: S.bank.termDays || 7,
      days: S.bank.daysPassed || 0,
      totInt: S.bank.totalInterest || 0,
      hist: Array.isArray(S.bank.history) ? S.bank.history.slice(-8) : []
    } : null,
    upg: Object.keys(S.upg || {}).filter(k => S.upg[k]),
    upgLv: S.upgLv || {},
    equipLv: S.equipLv || {},
    hired: Object.keys(S.hired || {}).filter(k => S.hired[k]),
    staffNames: S.staffNames || {},
    staffAvatars: S.staffAvatars || {},
    kpi: S.kpiPeriodStats || {},
    unpaid: S.staffUnpaidDays || {},
    rooms: Array.isArray(S.lobbyRooms) ? S.lobbyRooms : [true, false, false, false],
    decor: S.decor || {},
    actDec: S.activeDecor || {},
    stock: {},
    unlocked: Object.keys(S.unlocked || {}).filter(k => S.unlocked[k]),
    sell: S.sell || {},
    crush: S.crushLevel || 1,
    pet: S.pet ? {
      u: !!S.pet.unlocked,
      p: !!S.pet.paid10m,
      t: S.pet.type || 'dog',
      n: S.pet.name || '',
      dn: S.pet.dogName || '',
      cn: S.pet.catName || '',
      l: S.pet.level || 1,
      e: S.pet.exp || 0,
      hg: S.pet.hunger != null ? S.pet.hunger : 90,
      cl: S.pet.clean != null ? S.pet.clean : 90,
      hp: S.pet.happiness != null ? S.pet.happiness : 95,
      en: S.pet.energy != null ? S.pet.energy : 100
    } : null,
    capbi: S.capbi ? {
      u: !!S.capbi.unlocked,
      n: S.capbi.name || '',
      l: S.capbi.level || 1,
      e: S.capbi.exp || 0,
      a: !!S.capbi.active,
      hg: S.capbi.hunger != null ? S.capbi.hunger : 90,
      cl: S.capbi.clean != null ? S.capbi.clean : 90,
      hp: S.capbi.happiness != null ? S.capbi.happiness : 100,
      en: S.capbi.energy != null ? S.capbi.energy : 100
    } : null,
    garden: S.garden ? {
      u: !!S.garden.unlocked,
      l: S.garden.level || 1,
      pts: S.garden.points || 0,
      plants: S.garden.plants || [],
      seeds: S.garden.seeds || {}
    } : null,
    col: S.collection ? {
      u: S.collection.unopenedPacks || 0,
      c: S.collection.claimedPacks || 0,
      m: S.collection.milestonesClaimed || [],
      rec: S.collection.craftedRecipes || {},
      ings: S.collection.unlockedIngs || {},
      stars: S.collection.recipeStars || {},
      cards: S.collection.cards || null,
      last: S.collection.lastRevealed || []
    } : null,
    friends: Array.isArray(S.friends) ? S.friends.slice(0, 30) : [],
    trophies: Array.isArray(S.trophies) ? S.trophies : [],
    cupSkin: S.cupSkin || 'auto',
    ltr: S.lockedTopRank || 0,
    ltt: S.lockedTopTab || '',
    ltd: S.lockedTopDay || 0,
    utr: S.unlockedTopRanks || {}
  };

  if(S.stock && typeof S.stock === 'object'){
    Object.keys(S.stock).forEach(k => {
      const q = Array.isArray(S.stock[k])
        ? S.stock[k].reduce((sum, b) => sum + (b && b.q || 0), 0)
        : (typeof S.stock[k] === 'number' ? S.stock[k] : 0);
      if(q > 0) compact.stock[k] = q;
    });
  }

  const json = JSON.stringify(compact);
  const raw = new TextEncoder().encode(json);
  let z = null;
  try { z = await zipBytes(raw, 1); } catch(e){}
  const body = (z ? 'z' : 'p') + b64e(z || raw);
  return 'TTN2.' + body;
}

function expandCompactBackup(c){
  const f = (typeof fresh === 'function') ? fresh() : {};
  const d = {
    ...f,
    shopName: c.name || f.shopName || 'Tiệm Trà Mơ Ước',
    day: c.day || 1,
    money: (c.money != null) ? c.money : (f.money || 0),
    startupLocation: c.loc || f.startupLocation || 'default',
    startupLocLevel: Math.max(1, Math.min(5, Number(c.locLv) || 1)),
    startupLocDays: Math.max(0, Number(c.locDays) || 0),
    theme: c.theme || f.theme || 'default',
    ownedThemes: c.themes || f.ownedThemes || { default: true },
    totalRev: c.rev || 0,
    totalBranchRev: c.tbr != null ? Math.max(0, Number(c.tbr) || 0) : 0,
    totalBranchNet: c.tbn != null ? (Number(c.tbn) || 0) : 0,
    historyLengthTotal: Math.max(0, Number(c.hl) || 0, (Number(c.day) || 1) - 1),
    _restoredHistoryLen: Math.max(0, Number(c.hl) || 0, (Number(c.day) || 1) - 1),
    _legacyBranchRevCountersMissing: c.tbr == null,
    _legacyBranchNetCountersMissing: c.tbn == null,
    _legacyCompactChainDataMissing: c.br == null || c.fr == null || c.tbr == null || c.tbn == null,
    branches: (c.br && typeof c.br === 'object') ? c.br : (f.branches || {}),
    franchise: (c.fr && typeof c.fr === 'object') ? c.fr : (f.franchise || { partners: [], totalRoyaltyEarned: 0, feeEarned: 0, totalSupplyProfit: 0, totalPosFeeEarned: 0, totalSignFeeEarned: 0 }),
    totalProfit: c.prof || 0,
    star5Count: c.st5 || 0,
    served: c.serv || f.served || 0,
    best: c.best || f.best || 0,
    bestDayRev: c.bdr || f.bestDayRev || 0,
    bestDayServed: c.bds || f.bestDayServed || 0,
    upg: { ...f.upg },
    upgLv: { ...f.upgLv, ...(c.upgLv || {}) },
    equipLv: { ...f.equipLv, ...(c.equipLv || {}) },
    hired: {},
    staffNames: c.staffNames || {},
    staffAvatars: c.staffAvatars || {},
    kpiPeriodStats: c.kpi || {},
    staffUnpaidDays: c.unpaid || {},
    lobbyRooms: Array.isArray(c.rooms) ? c.rooms : (f.lobbyRooms || [true, false, false, false]),
    decor: c.decor || {},
    activeDecor: c.actDec || {},
    stock: {},
    unlocked: { ...f.unlocked },
    sell: { ...f.sell, ...(c.sell || {}) },
    crushLevel: c.crush || 1,
    friends: Array.isArray(c.friends) ? c.friends : (f.friends || []),
    trophies: Array.isArray(c.trophies) ? c.trophies : (f.trophies || []),
    cupSkin: c.cupSkin || 'auto',
    lockedTopRank: c.ltr || 0,
    lockedTopTab: c.ltt || '',
    lockedTopDay: c.ltd || 0,
    unlockedTopRanks: c.utr || {}
  };

  if(Array.isArray(c.upg)){
    c.upg.forEach(k => { d.upg[k] = true; });
  } else if(c.upg && typeof c.upg === 'object'){
    Object.assign(d.upg, c.upg);
  }

  if(Array.isArray(c.hired)){
    c.hired.forEach(k => { d.hired[k] = true; d.upg[k] = true; });
  }

  if(Array.isArray(c.unlocked)){
    c.unlocked.forEach(k => { d.unlocked[k] = true; });
  }

  if(typeof ITEMS !== 'undefined'){
    Object.keys(ITEMS).forEach(k => { d.stock[k] = []; });
  }
  if(c.stock && typeof c.stock === 'object'){
    Object.keys(c.stock).forEach(k => {
      const q = Number(c.stock[k]) || 0;
      if(q > 0) d.stock[k] = [{ q, exp: 99999 }];
    });
  }

  if(c.bank){
    const bBal = Number(c.bank.bal != null ? c.bank.bal : (c.bank.sav || 0)) || 0;
    const bPrin = Number(c.bank.prin != null ? c.bank.prin : bBal) || 0;
    d.bank = {
      balance: bBal,
      principal: bPrin,
      cap: Number(c.bank.cap) || 10000000,
      termDays: Number(c.bank.term) || 7,
      daysPassed: Number(c.bank.days) || 0,
      totalInterest: Number(c.bank.totInt) || 0,
      lastInterestDay: d.day,
      history: Array.isArray(c.bank.hist) ? c.bank.hist : []
    };
  }

  if(c.pet){
    d.pet = d.pet || {};
    d.pet.unlocked = !!c.pet.u;
    d.pet.paid10m = !!c.pet.p;
    if(c.pet.t) d.pet.type = c.pet.t;
    if(c.pet.n) d.pet.name = c.pet.n;
    if(c.pet.dn) d.pet.dogName = c.pet.dn;
    if(c.pet.cn) d.pet.catName = c.pet.cn;
    if(c.pet.l) d.pet.level = c.pet.l;
    if(c.pet.e != null) d.pet.exp = c.pet.e;
    if(c.pet.hg != null) d.pet.hunger = c.pet.hg;
    if(c.pet.cl != null) d.pet.clean = c.pet.cl;
    if(c.pet.hp != null) d.pet.happiness = c.pet.hp;
    if(c.pet.en != null) d.pet.energy = c.pet.en;
  }

  if(c.capbi){
    d.capbi = d.capbi || {};
    d.capbi.unlocked = !!c.capbi.u;
    if(c.capbi.n) d.capbi.name = c.capbi.n;
    if(c.capbi.l) d.capbi.level = c.capbi.l;
    if(c.capbi.e != null) d.capbi.exp = c.capbi.e;
    d.capbi.active = !!c.capbi.a;
    if(c.capbi.hg != null) d.capbi.hunger = c.capbi.hg;
    if(c.capbi.cl != null) d.capbi.clean = c.capbi.cl;
    if(c.capbi.hp != null) d.capbi.happiness = c.capbi.hp;
    if(c.capbi.en != null) d.capbi.energy = c.capbi.en;
  }

  if(c.garden){
    d.garden = d.garden || {};
    d.garden.unlocked = !!c.garden.u;
    if(c.garden.l) d.garden.level = c.garden.l;
    if(c.garden.pts != null) d.garden.points = c.garden.pts;
    if(Array.isArray(c.garden.plants)) d.garden.plants = c.garden.plants;
    if(c.garden.seeds && typeof c.garden.seeds === 'object') d.garden.seeds = c.garden.seeds;
  }

  if(c.col){
    d.collection = d.collection || {
      unopenedPacks: 0,
      claimedPacks: 0,
      milestonesClaimed: [],
      craftedRecipes: {},
      unlockedIngs: {},
      recipeStars: {},
      cards: null,
      lastRevealed: []
    };
    d.collection.unopenedPacks = c.col.u || 0;
    d.collection.claimedPacks = c.col.c || 0;
    if(Array.isArray(c.col.m)) d.collection.milestonesClaimed = c.col.m;
    if(c.col.rec && typeof c.col.rec === 'object') d.collection.craftedRecipes = c.col.rec;
    if(c.col.ings && typeof c.col.ings === 'object') d.collection.unlockedIngs = c.col.ings;
    if(c.col.stars && typeof c.col.stars === 'object') d.collection.recipeStars = c.col.stars;
    if(c.col.cards && typeof c.col.cards === 'object') d.collection.cards = c.col.cards;
    if(Array.isArray(c.col.last)) d.collection.lastRevealed = c.col.last;
  }

  return d;
}

function validateAntiCheatSave(d, opts = {}){
  if(!d || typeof d !== 'object') return;
  const isTampered = !!opts.isTampered;
  const isLegacy = !!opts.isLegacy;
  const shopNameStr = String(d.shopName || '').toLowerCase();

  // 1. Nhận diện dấu vết đặc trưng của tool hack Catvio Tools
  const isCatvioSignature = shopNameStr.includes('catvio') || (d.day >= 5000 && (d.star5Count >= 20000 || d.money >= 1000000000000));
  if(isCatvioSignature){
    throw '🚨 [Anti-Cheat] Phát hiện dữ liệu được tạo bởi công cụ gian lận bên thứ ba (Catvio Tools)! Hệ thống từ chối khôi phục bản sao lưu này để bảo đảm tính công bằng.';
  }

  // 2. Chặn gian lận Số lần 5 Sao Tổng (star5Count) bảo đảm công bằng Bảng Xếp Hạng:
  // Công thức thích ứng theo meta hiện đại: 200 + dayNum * 250, trần tối đa 80.000 sao.
  // Vừa bảo vệ người chơi chân chính farm sao ngày đêm (như Ngày 386 đạt 20k - 50k sao hoàn toàn hợp lệ),
  // vừa khóa chết 100% cheater cố tình bơm sao ảo ở ngày thấp.
  const dayNum = Math.max(1, parseInt(d.day, 10) || 1);
  const maxFeasibleStar5 = Math.min(80000, 200 + dayNum * 250);
  if(d.star5Count != null && (d.star5Count > maxFeasibleStar5 || d.star5Count > 80000)){
    throw `🚨 [Anti-Cheat] Số lần 5 Sao (x${d.star5Count}) vượt trần khả thi ở Ngày ${dayNum} (tối đa x${Math.floor(maxFeasibleStar5)})! Bản sao lưu không hợp lệ.`;
  }

  // 3. Chặn gian lận Chi nhánh & Nhượng quyền: trần 16 - 20 như trước
  if(d.franchise && Array.isArray(d.franchise.partners) && d.franchise.partners.length > 20){
    throw `🚨 [Anti-Cheat] Số lượng cơ sở nhượng quyền (${d.franchise.partners.length}) vượt quá trần tối đa của hệ thống!`;
  }

  // 4. Chặn gian lận Tiền mặt: Tối thiểu từ 50 Tỷ, trần theo ngày 5 Tỷ/ngày
  const maxFeasibleMoney = Math.max(50000000000, dayNum * 5000000000);
  if(d.money != null && d.money > maxFeasibleMoney){
    if(isTampered || isLegacy || d.money >= 500000000000){ // >= 500 tỉ khi ngày thấp, hoặc khi chữ ký không khớp
      throw `🚨 [Anti-Cheat] Số dư két tiền (${fmt(d.money)}) vượt trần tài chính khả dĩ ở Ngày ${dayNum}! Từ chối nạp file gian lận.`;
    }
  }

  // 5. Kiểm tra tính toàn vẹn chữ ký khi có dấu hiệu sửa đổi file ngoài
  if(isTampered){
    if(d.money > 50000000000 || dayNum > 2000 || (d.star5Count && d.star5Count > maxFeasibleStar5)){
      throw '⚠️ [Anti-Cheat] Chữ ký bảo mật của bản sao lưu không hợp lệ hoặc đã bị can thiệp bằng công cụ bên ngoài! Vui lòng dùng bản sao lưu chính thức được tạo từ game.';
    }
  }

  // 6. Chặn gian lận Sổ Tay Công Thức & Bộ Sưu Tập (Anti-Cheat Collection Guard):
  // Bất biến: Phải mở đủ nguyên liệu mới ghép đủ công thức!
  if(d.collection && d.collection.craftedRecipes && typeof d.collection.craftedRecipes === 'object'){
    const craftedList = Object.keys(d.collection.craftedRecipes).filter(k => d.collection.craftedRecipes[k]);
    if(craftedList.length > 0){
      const claimed = (d.collection.claimedPacks || 0) + (d.collection.unopenedPacks || 0);
      const served = Math.max(0, d.served || 0);
      const money = Math.max(0, d.money || 0);
      const totalRev = Math.max(0, d.totalRev || 0);
      const ingsCount = d.collection.unlockedIngs ? Object.keys(d.collection.unlockedIngs).length : 0;
      const hasLegitHistory = (claimed > 0) || (served >= 1000) || (money >= 50000000) || (totalRev >= 50000000) || (ingsCount >= 10);
      if(!hasLegitHistory && isTampered){
        throw `🚨 [Anti-Cheat] Phát hiện gian lận công thức độc bản (${craftedList.length} món) khi chưa mở đủ nguyên liệu!`;
      }
    }
  }
}

function normalizeBackupData(d, opts = {}){
  if(!d || typeof d !== 'object') throw 'Dữ liệu file sao lưu rỗng';
  if(d.data && typeof d.data === 'object' && (d.data.day || d.data.money != null)) d = d.data;
  if(d.save && typeof d.save === 'object' && (d.save.day || d.save.money != null)) d = d.save;

  validateAntiCheatSave(d, opts);

  // Tự động thu hồi và dọn dẹp sự cố cạy két ảo (dưới trần an toàn động) trong file sao lưu:
  const backupSafeCash = typeof getSafeCashCeiling === 'function' ? getSafeCashCeiling(d.day) : 2000000000;
  if(d.badNow && (d.badNow.id === 'trom' || d.badNow.all) && (Number(d.money) || 0) < backupSafeCash){
    const stolenVal = Number(d.badNow.v) || 0;
    if(stolenVal > 0){
      d.money = (Number(d.money) || 0) + stolenVal;
      if(d.cur && d.cur.stolen) d.cur.stolen = Math.max(0, d.cur.stolen - stolenVal);
    }
    d.badNow = null;
  }

  const hasDay = typeof d.day === 'number' || (typeof d.day === 'string' && !isNaN(+d.day));
  const hasMoney = d.money != null && !isNaN(+d.money);
  const hasStock = d.stock && typeof d.stock === 'object';
  const hasHistory = Array.isArray(d.history);
  const hasShopName = !!d.shopName;

  if(!hasDay && !hasMoney && !hasStock && !hasHistory && !hasShopName){
    throw 'Dữ liệu file không chứa thông tin tiến trình quán trà';
  }

  d.day = Math.max(1, parseInt(d.day, 10) || 1);
  d.money = Number(d.money);
  if(!isFinite(d.money)) d.money = CFG.startMoney;
  d.stock = (d.stock && typeof d.stock === 'object') ? d.stock : {};
  d.sell = (d.sell && typeof d.sell === 'object') ? d.sell : {};
  d.unlocked = (d.unlocked && typeof d.unlocked === 'object') ? d.unlocked : {};
  d.upg = (d.upg && typeof d.upg === 'object') ? d.upg : { sealer: true };
  d.shopName = d.shopName || 'Tiệm Trà Mơ Ước';

  return d;
}

async function readBackup(code){
  if(!code) throw 'Vui lòng dán mã hoặc chọn file sao lưu';
  let raw = String(code).trim().replace(/^\uFEFF/, '').replace(/^["'`]|["'`]$/g, '').trim();

  // 1. Thử phân tích cú pháp trực tiếp nếu là JSON thuần
  if(raw.startsWith('{') && raw.endsWith('}')){
    try {
      const parsed = JSON.parse(raw);
      if(parsed && typeof parsed === 'object') return normalizeBackupData(parsed, { isTampered: true, isRawJson: true });
    } catch(e) {
      if(typeof e === 'string' && e.includes('[Anti-Cheat]')) throw e;
    }
  }

  // 2. Tìm mã định dạng TTN3 (Mã siêu rút gọn 1 dòng mới ~70 ký tự)
  let m3 = raw.match(/TTN3\.([A-Za-z0-9_\-]+)/i);
  if(m3){
    try {
      const expanded = expandUltraCompactBackup(m3[0]);
      if(expanded && typeof expanded === 'object') return normalizeBackupData(expanded, { isV2: true });
    } catch(err) {
      if(typeof err === 'string' && err.includes('[Anti-Cheat]')) throw err;
      console.warn('Lỗi đọc nội dung TTN3:', err);
    }
  }

  // 3. Tìm mã định dạng TTN2 (Mã rút gọn nén)
  let m2 = raw.match(/TTN2\.([zp][A-Za-z0-9_\-\+/=]+)/i);
  if(m2){
    try {
      const bodyStr = m2[1];
      const mode = bodyStr[0];
      let u = b64d(bodyStr.slice(1));
      if(mode === 'z'){
        let decompressed = await zipBytes(u, 0);
        if(decompressed) u = decompressed;
      }
      const jsonStr = new TextDecoder('utf-8').decode(u);
      const compactObj = JSON.parse(jsonStr);
      if(compactObj && typeof compactObj === 'object'){
        const expanded = expandCompactBackup(compactObj);
        return normalizeBackupData(expanded, { isV2: true });
      }
    } catch(err) {
      if(typeof err === 'string' && err.includes('[Anti-Cheat]')) throw err;
      console.warn('Lỗi đọc nội dung TTN2:', err);
    }
  }

  // 4. Tìm mã định dạng TTN1 (Bản lưu đầy đủ từ file hoặc mã cũ)
  let m = raw.match(/TTN1\.([zp][A-Za-z0-9_\-\+/=]+)(?:\.([0-9a-z]+))?/i);
  if(m){
    const bodyStr = m[1];
    const hash = m[2];
    let isV2 = false;
    let isLegacy = false;
    if(hash && typeof bakHash === 'function'){
      if(hash === bakHash(bodyStr, BAK_SALT_V2)) isV2 = true;
      else if(hash === bakHash(bodyStr, BAK_SALT_LEGACY)) isLegacy = true;
    }
    const isTampered = !isV2 && !isLegacy;
    if(isTampered){
      console.warn('[Anti-Cheat] Mã băm TTN1 không hợp lệ hoặc đã bị can thiệp bởi công cụ ngoài...');
    }
    try {
      const mode = bodyStr[0];
      let u = b64d(bodyStr.slice(1));
      if(mode === 'z'){
        let decompressed = await zipBytes(u, 0);
        if(decompressed) u = decompressed;
        else console.warn('Không giải nén được bằng DecompressionStream, thử đọc thô');
      }
      const jsonStr = new TextDecoder('utf-8').decode(u);
      const parsed = JSON.parse(jsonStr);
      if(parsed && typeof parsed === 'object') return normalizeBackupData(parsed, { isTampered, isLegacy, isV2 });
    } catch(err) {
      if(typeof err === 'string' && err.includes('[Anti-Cheat]')) throw err;
      console.warn('Lỗi đọc nội dung TTN1:', err);
    }
  }

  // 5. Thử giải mã nếu là chuỗi Base64 của JSON thuần
  try {
    const cleanB64 = raw.replace(/\s+/g, '');
    let u = b64d(cleanB64);
    let jsonStr = new TextDecoder('utf-8').decode(u);
    if(jsonStr.startsWith('{')){
      const parsed = JSON.parse(jsonStr);
      if(parsed && typeof parsed === 'object') return normalizeBackupData(parsed, { isTampered: true, isRawJson: true });
    }
  } catch(e) {
    if(typeof e === 'string' && e.includes('[Anti-Cheat]')) throw e;
  }

  // 6. Trích xuất bất kỳ khối JSON nào lọt trong đoạn văn bản
  const jsonBlock = raw.match(/\{[\s\S]*\}/);
  if(jsonBlock){
    try {
      const parsed = JSON.parse(jsonBlock[0]);
      if(parsed && typeof parsed === 'object') return normalizeBackupData(parsed, { isTampered: true, isRawJson: true });
    } catch(e) {
      if(typeof e === 'string' && e.includes('[Anti-Cheat]')) throw e;
    }
  }

  throw 'File hoặc mã sao lưu không đọc được. Vui lòng kiểm tra lại file đã chọn.';
}
