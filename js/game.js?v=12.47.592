  if((!isHoardCheatEndDay || cheatTierEndDay < 2) && typeof mktAutoRescueAllFlops === 'function') mktAutoRescueAllFlops(false);
  // Kiểm tra Lích Đờ dỗi chưa được cứu (nghỉ việc hàng loạt khi có căn cứ gian lận isHoardCheatEndDay theo Ngưỡng Phán Quyết / Vượt Két)
  const sulkingBranches = [];
