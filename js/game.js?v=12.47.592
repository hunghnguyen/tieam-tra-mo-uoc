function getStaffTrainLv(id){
  if(!S || !S.staffTraining || !id) return 0;
  return Math.max(0, Math.min(5, parseInt(S.staffTraining[id], 10) || 0));
}

function getStaffWorkedDays(id){
  if(!S || !id) return 0;
  S.staffTotalDaysWorked = S.staffTotalDaysWorked || {};
  if(S.staffTotalDaysWorked[id] == null){
    const kpiLv = (S.staffKpi && S.staffKpi[id] && S.staffKpi[id].level) || 0;
    const curDays = (S.kpiPeriodStats && S.kpiPeriodStats[id] && S.kpiPeriodStats[id].daysWorked) || 0;
    S.staffTotalDaysWorked[id] = Math.max(0, kpiLv * 7 + curDays);
  }
  return Math.max(0, parseInt(S.staffTotalDaysWorked[id], 10) || 0);
}

function getStaffTrainInfo(id){
  const lv = getStaffTrainLv(id);
  const tier = STAFF_TRAINING_TIERS[lv] || STAFF_TRAINING_TIERS[0];
  const nextTier = lv < 5 ? STAFF_TRAINING_TIERS[lv + 1] : null;
  const perk = STAFF_TRAINING_PERKS[id] || STAFF_TRAINING_PERKS.staff1;
  const curDesc = lv === 5 ? `[${perk.ultName}] ${perk.ultDesc}` : (lv > 0 ? perk.lvDesc(lv) : 'Chưa qua đào tạo');
  const workedDays = getStaffWorkedDays(id);
  return { lv, tier, nextTier, perk, curDesc, workedDays };
}

function getStaffTrainKpiExtraRate(id){
  if(!id || id === 'staff0') return 0;
  return getStaffTrainLv(id) * 0.01; // +1% doanh thu KPI mỗi cấp đào tạo
}


function getStaffTeamSynergies(){
  const lvNightPair = (getStaffTrainLv('staff3') >= 5 && getStaffTrainLv('staffSv') >= 5);
  const lvDeliverySquad = (getStaffTrainLv('staffShipper') >= 5 && getStaffTrainLv('staffRacer') >= 5);
  let masterCount = 0;
  if(typeof STAFF !== 'undefined' && Array.isArray(STAFF)){
    STAFF.forEach(u => {
      if(getStaffTrainLv(u.id) >= 5) masterCount++;
    });
  }
  const lvQuintet = masterCount >= 5;
  const list = [
    {
      id: 'night_pair',
      name: '🌙 Bộ Đôi Ca Đêm',
      req: 'Quản Lý Tập Sự Lv.5 + Sinh Viên Ca Đêm Lv.5',
      desc: 'Doanh thu ca đêm (22h–6h) tự động tăng thêm +25%',
      active: lvNightPair
    },
    {
      id: 'delivery_squad',
      name: '⚡ Biệt Đội Giao Vận Thần Tốc',
      req: 'Shipper Thần Tốc Lv.5 + Chiến Thần Xa Lộ Lv.5',
      desc: 'Đơn Online tăng +25% giá trị bill & Giảm 20% phí hoa hồng app',
      active: lvDeliverySquad
    },
    {
      id: 'master_quintet',
      name: '👑 Ngũ Đại Sư Tinh Hoa',
      req: 'Có từ 5 nhân viên bất kỳ đạt Lv.5 Đại Sư trở lên',
      desc: `Hào quang Tiệm Trà Danh Giá (${masterCount}/5): Toàn bộ khách ghé quán tăng +10% Tiền Tip`,
      active: lvQuintet
    }
  ];
  return { list, hasNightPair: lvNightPair, hasDeliverySquad: lvDeliverySquad, hasQuintet: lvQuintet, masterCount };
}

function openStaffTrainingModal(staffId, onAfter){
  if(!S || !staffId) return;
  const u = STAFF.find(x => x.id === staffId);
  if(!u) return;
  const info = getStaffTrainInfo(staffId);
  const { lv, tier, nextTier, perk, workedDays } = info;
  const pName = staffPersonName(staffId);
  const fullName = pName ? `${pName} (${u.n})` : u.n;
  const curStars = S.star5Count || 0;
  const curMoney = S.money || 0;

  const tiersHTML = STAFF_TRAINING_TIERS.slice(1).map(t => {
    const isUnlocked = lv >= t.lv;
    const isNext = (lv + 1 === t.lv);
    const isUlt = t.lv === 5;
    const hasDays = workedDays >= (t.reqDays || 0);
    const descTxt = isUlt ? `👑 <b>[${perk.ultName}]:</b> ${perk.ultDesc}` : perk.lvDesc(t.lv);
    return `
      <div style="padding:8px 10px;border-radius:10px;margin-bottom:6px;border:1.5px solid ${isUnlocked ? '#86efac' : isNext ? '#f59e0b' : '#e2e8f0'};background:${isUnlocked ? '#f0fdf4' : isNext ? '#fffbeb' : '#f8fafc'};text-align:left;font-size:0.8rem;">
        <div style="display:flex;justify-content:space-between;align-items:center;font-weight:800;margin-bottom:3px;flex-wrap:wrap;gap:4px;">
          <span style="color:${t.color};">${t.badge} · ${t.title}</span>
          <span style="font-size:0.74rem;padding:2px 6px;border-radius:6px;background:${isUnlocked ? '#16a34a' : '#e2e8f0'};color:${isUnlocked ? '#fff' : '#475569'};">
            ${isUnlocked ? '✓ Đã tốt nghiệp' : `📅 ${t.reqDays} ngày · ${fmt(t.costMoney)} + ${t.costStar}⭐`}
          </span>
        </div>
        <div style="color:#334155;line-height:1.35;">• ${descTxt}</div>
        ${!isUnlocked ? `<div style="font-size:0.74rem;font-weight:700;margin-top:2px;color:${hasDays ? '#15803d' : '#dc2626'};">📅 Điều kiện thâm niên: Đã sử dụng nhân viên <b>${workedDays}/${t.reqDays} ngày</b> ${hasDays ? '✅ (Đạt)' : `(Cần đi làm thêm ${t.reqDays - workedDays} ngày)`}</div>` : ''}
        ${staffId !== 'staff0' ? `<div style="color:#c2410c;font-size:0.74rem;font-weight:700;margin-top:2px;">⚖️ Đãi ngộ KPI chu kỳ 7 ca: +${t.kpiExtraPct}% Doanh thu (Xuất sắc: ${(0.5 + t.kpiExtraPct).toFixed(1)}% DT)</div>` : ''}
      </div>
    `;
  }).join('');

  const hasEnoughDays = nextTier ? workedDays >= (nextTier.reqDays || 0) : false;
  const canAfford = nextTier && hasEnoughDays && curMoney >= nextTier.costMoney && curStars >= nextTier.costStar;

  const btns = [];
  if(nextTier){
    const btnLabel = !hasEnoughDays
      ? `🔒 Cần dùng đủ ${nextTier.reqDays} ngày (Hiện tại: ${workedDays}/${nextTier.reqDays} ngày)`
      : `🎓 Đào tạo lên Cấp ${nextTier.lv} (-${fmt(nextTier.costMoney)} & -${nextTier.costStar}⭐)`;
    btns.push([
      btnLabel,
      () => {
        if(inDebt()){
          toast('Đang nợ ngân hàng, hãy trả nợ trước khi đào tạo nhân viên!');
          return;
        }
        const curW = getStaffWorkedDays(staffId);
        if(curW < (nextTier.reqDays || 0)){
          toast(`Nhân viên cần đi làm đủ ${nextTier.reqDays} ngày tại quán mới đủ thâm niên đào tạo Cấp ${nextTier.lv}! (Hiện tại: ${curW}/${nextTier.reqDays} ngày)`);
          return;
        }
        if((S.money || 0) < nextTier.costMoney){
          toast(`Két không đủ ${fmt(nextTier.costMoney)} để đóng học phí đào tạo Cấp ${nextTier.lv}!`);
          return;
        }
        if((S.star5Count || 0) < nextTier.costStar){
          toast(`Cần ít nhất ${nextTier.costStar}⭐ Sao Danh Vọng để cấp chứng chỉ Cấp ${nextTier.lv}! (Hiện có: ${S.star5Count || 0}⭐)`);
          return;
        }
        S.money -= nextTier.costMoney;
        S.star5Count = Math.max(0, (S.star5Count || 0) - nextTier.costStar);
        S.staffTraining = S.staffTraining || {};
        S.staffTraining[staffId] = nextTier.lv;
        if(nextTier.lv >= 4){
          if(S.staffQuitNotices) delete S.staffQuitNotices[staffId];
          if(staffId === 'staffOn') delete S.staffOnLeaveNotice;
          if(R && R.staffDayOff) delete R.staffDayOff[staffId];
          if(R && R.staffLate) delete R.staffLate[staffId];
        }
        if(nextTier.lv >= 5 && staffId === 'staffGuard'){
          delete S.guardRestDay;
          delete S.guardRestUntil;
          S.guardWorkStreak = 0;
          if(S.hired && S.hired.staffGuard && S.upg) S.upg.staffGuard = true;
        }
        S.cur = S.cur || {};
        S.cur.equip = S.cur.equip || [];
        S.cur.equip.push({ n: `Đào tạo ${fullName} lên Cấp ${nextTier.lv} (${nextTier.title})`, v: nextTier.costMoney });
        save();
        head();
        try { sfx('lvup'); } catch(e){}
        toast(`🎓 Chúc mừng! ${fullName} đã tốt nghiệp khóa "${nextTier.title}" (Lv.${nextTier.lv}/5)! ✨`, 5000, 1);
        if(typeof onAfter === 'function') onAfter();
        else if(typeof refreshPrep === 'function') refreshPrep();
      },
      canAfford ? 1 : 0
    ]);
  }
  btns.push(['Đóng', () => { if(typeof onAfter === 'function') onAfter(); }]);

  ask(`
    <div style="text-align:center;margin-bottom:8px;">
      <div style="display:inline-block;margin-bottom:4px;">${staffAvatarImg(staffId, 52)}</div>
      <h2 style="margin:0 0 2px;font-size:1.12rem;color:#78350f;">🎓 HỌC VIỆN ĐÀO TẠO NHÂN SỰ</h2>
      <div style="font-size:0.86rem;font-weight:800;color:#1e293b;">${esc(fullName)}</div>
      <div style="margin-top:4px;display:flex;justify-content:center;gap:6px;flex-wrap:wrap;">
        <span style="display:inline-block;padding:3px 10px;border-radius:12px;font-size:0.78rem;font-weight:800;background:${tier.bg};color:${tier.color};border:1px solid ${tier.color}40;">
          Trình độ: ${tier.badge} - ${tier.title}
        </span>
        <span style="display:inline-block;padding:3px 10px;border-radius:12px;font-size:0.78rem;font-weight:800;background:#eff6ff;color:#1d4ed8;border:1px solid #bfdbfe;">
          📅 Thâm niên làm việc: ${workedDays} ngày
        </span>
      </div>
      <div style="font-size:0.78rem;color:#475569;margin-top:5px;">
        💰 Két hiện có: <b style="color:#15803d;">${fmt(curMoney)}</b> &nbsp;·&nbsp; ⭐ Sao tích lũy: <b style="color:#d97706;">${curStars}⭐</b>
      </div>
    </div>
    <div style="max-height:330px;overflow-y:auto;padding-right:4px;margin-bottom:6px;">
      ${tiersHTML}
    </div>
    <div style="background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;padding:6px 9px;margin-bottom:6px;text-align:left;font-size:0.75rem;">
      <div style="font-weight:800;color:#1e3a8a;margin-bottom:4px;display:flex;justify-content:space-between;align-items:center;">
        <span>🏆 ĐỒNG ĐỘI HÀO QUANG (TEAM SYNERGY)</span>
        <span style="color:#d97706;font-size:0.72rem;background:#fef3c7;padding:1px 6px;border-radius:6px;">Đại Sư hiện có: ${(typeof getStaffTeamSynergies === 'function' ? getStaffTeamSynergies().masterCount : 0)}/14</span>
      </div>
      ${(typeof getStaffTeamSynergies === 'function' ? getStaffTeamSynergies().list : []).map(syn => `
        <div style="margin-top:3px;padding:4px 6px;border-radius:6px;background:${syn.active ? '#ecfdf5' : '#f1f5f9'};border:1px solid ${syn.active ? '#a7f3d0' : '#e2e8f0'};color:${syn.active ? '#065f46' : '#64748b'};">
          <div style="font-weight:700;display:flex;justify-content:space-between;">
            <span>${syn.name}</span>
            <span style="font-size:0.7rem;font-weight:800;color:${syn.active ? '#059669' : '#94a3b8'};">${syn.active ? '✨ ĐANG KÍCH HOẠT' : '🔒 Khóa'}</span>
          </div>
          <div style="font-size:0.71rem;line-height:1.25;margin-top:1px;">• ${syn.desc}</div>
        </div>
      `).join('')}
    </div>
    <div style="background:#fff7ed;border:1px dashed #fdba74;border-radius:8px;padding:6px 9px;font-size:0.75rem;color:#9a3412;text-align:left;line-height:1.35;">
      💡 <b>Lưu ý Quản trị:</b> Nhân viên cần tích lũy đủ <b>số ngày đi làm quy định (3 ➔ 7 ➔ 14 ➔ 21 ➔ 30 ngày)</b> để mở khóa từng cấp đào tạo. Mỗi cấp giúp giảm 25% tật xấu (xóa 100% ở Lv.4), mở Kỹ năng Đại Sư ở Lv.5, và yêu cầu <b>+1% Doanh thu/cấp</b> khi xét KPI 7 ca. Nếu nghỉ việc hoặc bị sa thải, thâm niên và cấp đào tạo sẽ mất!
    </div>
  `, btns);
}

function getGuardBlockRate(){
  const lv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffGuard') : 0;
  if(lv >= 4) return 1.0;
  return Math.min(1.0, 0.90 + lv * 0.025);
}
function getGuardBlockPctTxt(){
  const r = getGuardBlockRate() * 100;
  return Number.isInteger(r) ? `${r}%` : `${r.toFixed(1)}%`;
}
function isGuardResting(){
  if(!S) return false;
  if(getStaffTrainLv('staffGuard') >= 5){
    if(S.guardRestDay != null || S.guardRestUntil != null){
      delete S.guardRestDay;
      delete S.guardRestUntil;
      S.guardWorkStreak = 0;
      if(S.hired && S.hired.staffGuard && S.upg) S.upg.staffGuard = true;
    }
    return false;
  }
  if(S.guardRestDay != null){
    if(S.guardRestDay !== S.day){
      delete S.guardRestDay;
      delete S.guardRestUntil;
      if(S.hired && S.hired.staffGuard && S.upg) S.upg.staffGuard = true;
      return false;
    }
    return true;
  }
  if(S.guardRestUntil && Date.now() < S.guardRestUntil){
    S.guardRestDay = S.day;
    delete S.guardRestUntil;
    return true;
  }
  return false;
}
function getGuardRestRemainTxt(){
  if(!isGuardResting()) return '';
  return `trọn Ngày ${S.day}`;
}
function staffAvatarImg(id, size = 42, extraStyle = ''){
  if(S && S.staffAvatars && S.staffAvatars[id]){
    return `<img src="${S.staffAvatars[id]}" class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;object-fit:cover;display:inline-block;vertical-align:middle;box-shadow:0 2px 6px rgba(0,0,0,0.12);background:#fff;border:1.5px solid #e2e8f0;${extraStyle}" alt="nv">`;
  }
  if(id === 'staffGuard'){
    return `<div class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;background:linear-gradient(135deg,#1e3a8a,#2563eb);display:inline-flex;align-items:center;justify-content:center;font-size:${Math.round(size*0.58)}px;box-shadow:0 2px 6px rgba(30,58,138,0.3);border:1.5px solid #93c5fd;flex-shrink:0;${extraStyle}">👮‍♂️</div>`;
  }
  if(id === 'staffRacer'){
    return `<div class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;background:linear-gradient(135deg,#ea580c,#dc2626);display:inline-flex;align-items:center;justify-content:center;font-size:${Math.round(size*0.58)}px;box-shadow:0 2px 6px rgba(220,38,38,0.35);border:1.5px solid #fdba74;flex-shrink:0;${extraStyle}">🏍️</div>`;
  }
  if(id === 'staffButler'){
    return `<div class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;background:linear-gradient(135deg,#1e1b4b,#312e81);display:inline-flex;align-items:center;justify-content:center;font-size:${Math.round(size*0.58)}px;box-shadow:0 2px 6px rgba(30,27,75,0.4);border:1.5px solid #a5b4fc;flex-shrink:0;${extraStyle}">🤵</div>`;
  }
  if(id === 'staffCleaner'){
    return `<div class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;background:linear-gradient(135deg,#0d9488,#059669);display:inline-flex;align-items:center;justify-content:center;font-size:${Math.round(size*0.58)}px;box-shadow:0 2px 6px rgba(13,148,136,0.35);border:1.5px solid #6ee7b7;flex-shrink:0;${extraStyle}">🧹</div>`;
  }
  if(id === 'staffShipper'){
    return `<div class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;background:linear-gradient(135deg,#f59e0b,#d97706);display:inline-flex;align-items:center;justify-content:center;font-size:${Math.round(size*0.58)}px;box-shadow:0 2px 6px rgba(245,158,11,0.35);border:1.5px solid #fde68a;flex-shrink:0;${extraStyle}">🛵</div>`;
  }
  const url = staffAvatarUrl(id);
  return `<img src="${url}" class="staff-avt-img" style="width:${size}px;height:${size}px;border-radius:50%;object-fit:cover;display:inline-block;vertical-align:middle;box-shadow:0 2px 6px rgba(0,0,0,0.12);background:#fff;border:1.5px solid #e2e8f0;${extraStyle}" alt="nv">`;
}

function openStaffAvatarPicker(staffId){
  if(!S || !staffId) return;
  const pName = (typeof staffPersonName === 'function' ? staffPersonName(staffId) : '') || 'Nhân viên';
  const current = (typeof staffAvatarUrl === 'function' ? staffAvatarUrl(staffId) : '');

  const avatarsHTML = NV_AVATAR_LIST.map((url, idx) => {
    const isSel = (url === current);
    const fname = url.split('/').pop().replace('.png', '');
    return `
      <div class="staff-picker-item" onclick="chooseStaffAvatar('${staffId}', '${url}')" style="cursor:pointer;padding:6px 2px;border-radius:12px;background:${isSel ? '#fef3c7' : '#f8fafc'};border:2px solid ${isSel ? '#f59e0b' : '#e2e8f0'};display:flex;flex-direction:column;align-items:center;justify-content:center;transition:all 0.15s;position:relative;" title="${fname}">
        <img src="${url}" style="width:48px;height:48px;border-radius:50%;object-fit:cover;box-shadow:0 2px 5px rgba(0,0,0,0.1);" alt="${fname}">
        <span style="font-size:10px;color:#64748b;margin-top:3px;font-weight:700;">${fname}</span>
        ${isSel ? '<span style="position:absolute;top:2px;right:2px;background:#f59e0b;color:#fff;font-size:10px;border-radius:50%;width:16px;height:16px;display:flex;align-items:center;justify-content:center;font-weight:bold;">✓</span>' : ''}
      </div>
    `;
  }).join('');

  ask(`
    <div style="text-align:center;margin-bottom:8px;">
      <h2 style="margin:0 0 4px;font-size:1.15rem;color:#78350f;">🖼️ Chọn Avatar Nhân Viên</h2>
      <p style="margin:0;font-size:0.84rem;color:#64748b;">Chọn hình đại diện cho <b>${esc(pName)}</b> (38 mẫu từ b00 đến b69):</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(5, 1fr);gap:8px;max-height:340px;overflow-y:auto;padding:6px;box-sizing:border-box;-webkit-overflow-scrolling:touch;">
      ${avatarsHTML}
    </div>
  `, [
    ['Đóng', () => {}]
  ]);
}

function chooseStaffAvatar(staffId, url){
  if(!S || !staffId || !url) return;
  S.staffAvatars = S.staffAvatars || {};
  S.staffAvatars[staffId] = url;
  save();
  try{ sfx('win'); }catch(_){}
  const pName = (typeof staffPersonName === 'function' ? staffPersonName(staffId) : '') || 'Nhân viên';
  toast(`🎉 Đã đổi ảnh đại diện cho ${pName}! ✨`);
  $('card').className = 'card';
  $('modal').hidden = true;
  if(typeof currentTab !== 'undefined' && currentTab === 'kpi' && typeof paneKpi === 'function') paneKpi();
  else if(typeof renderPrep === 'function') renderPrep();
}
function traffic(){
  const r=rating();
  const effR = Math.max(1, r);
  const s5Boost = (S && S.star5Count) ? Math.min(0.40, S.star5Count * 0.06) : 0;
  const rf = ((.75 + (effR - 1) / 4 * 1.15) * Math.min(1, Math.max(.7, .7 + (effR - 3.5) * .35)) + s5Boost) * (S.day < 10 ? .85 + .025 * S.day : 1);

  // ✅ THU THẬP TẤT CẢ BUFF VÀO ADDITIVE (Tránh nhân cấp số mũ)
  let additiveTraffic = 0;
  if(S.upg.sign)     additiveTraffic += 0.25;
  if(S.upg.ads)      additiveTraffic += 0.35;
  if(S.upg.mascot)   additiveTraffic += 0.40;
  if(S.upg.floor2)   additiveTraffic += 2.20;  // Nâng tầng +220% (phục vụ cùng lúc 10 khách)
  else if(S.upg.slot4) additiveTraffic += 1.20; // Mở rộng quầy +120% (phục vụ cùng lúc 6 khách)

  // Day boost (capped ở +80%)
  const dayBoost = Math.min(0.80, (S.day - 1) * 0.012);
  additiveTraffic += dayBoost;

  // Gen Z boost (+50% thay vì ×2.5)
  if(S.upg.staffGz && !R.gzSulking) additiveTraffic += 0.50;
  if((S.upgLv && S.upgLv.tra) > 0) additiveTraffic += Math.min(0.25, (S.upgLv.tra || 0) * 0.006);

  // Marketing & Cleaner & Shipper & Staff KPI
  if(S.upg.staffMkt) additiveTraffic += (getStaffTrainLv('staffMkt') >= 5 ? 0.70 : 0.45);
  if(typeof isStaffActive === 'function' && isStaffActive('staffCleaner')) additiveTraffic += 0.20;
  if(typeof isStaffActive === 'function' && isStaffActive('staffShipper')) additiveTraffic += 0.25;
  if(typeof getStaffTrafficBuffTotal === 'function') additiveTraffic += Math.min(0.35, getStaffTrafficBuffTotal());

  // Friend / Branch / Ads
  const friendBoost = (S.friendBuff && S.friendBuff.day === S.day) ? (S.friendBuff.boost || 0.20) : 0;
  additiveTraffic += friendBoost;
  if(S.mxh && S.mxh.activeAds){
    S.mxh.activeAds.forEach(a => {
      additiveTraffic += Math.min(0.40, a.boost || 0);  // Cap từng ads
    });
  }

  // Viral / Video
  if(S.mxh && S.mxh.viralTrafficDay === S.day) additiveTraffic += 0.50;
  if(S.mxh && S.mxh.videoBuffDay === S.day && S.mxh.videoBuffPct > 0) additiveTraffic += Math.min(0.40, S.mxh.videoBuffPct);

  // Tax boost
  if(typeof getTaxTrafficBoost === 'function') additiveTraffic += (getTaxTrafficBoost() - 1);

  // Location (nhân theo cấp Đế Chế Khởi Nghiệp)
  const bMul = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
  const dMul = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
  if(S && S.startupLocation === 'hanoi') additiveTraffic += 0.15 * bMul;
  else if(S && S.startupLocation === 'cantho') additiveTraffic -= 0.05 * dMul;
  else if(S && S.startupLocation === 'phuquoc') additiveTraffic -= 0.05 * dMul;
  else if(S && S.startupLocation === 'vungtau'){
    const isWk = (S.day % 7 === 0 || S.day % 7 === 6 || evIs('weekend') || evIs('holiday'));
    additiveTraffic += isWk ? (0.35 * bMul) : (-0.06 * dMul);
  }

  // 🐕 ĐẶC QUYỀN TÓ SHIBA: Vẫy đuôi gọi khách dạo phố (+20% ~ +50% lưu lượng khách ghé quán chính)
  if(S && S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50){
    const dogTrf = typeof getPetBuffValues === 'function' ? getPetBuffValues('dog', S.pet.level || 1) : { trafficBonusRate: 0.20 };
    additiveTraffic += (dogTrf.trafficBonusRate || 0.20);
  }

  // Party & Trend
  if(S.partyContract && S.partyContract.day === S.day && S.partyContract.accepted) additiveTraffic += 0.40;
  if(S && S.marketTrend){
    if(S.marketTrend.standeeActive) additiveTraffic += 0.25;
    if(S.marketTrend.rdStatus === 'completed' && S.marketTrend.rdStar === 5) additiveTraffic += 0.20;
  }

  // 🔥 CAP TỔNG ADDITIVE: Mở rộng trần khi sở hữu quầy lớn (+550%) hoặc nâng tầng (+700%)
  const maxAdditive = S.upg.floor2 ? 7.00 : (S.upg.slot4 ? 5.50 : 4.00);
  additiveTraffic = Math.min(maxAdditive, Math.max(-0.45, additiveTraffic));
  const totalBoost = 1 + additiveTraffic;

  // Weather (đã cap riêng)
  const e=ev();
  let weatherMul = e && EVS[e.id] ? EVS[e.id].mul : 1;
  if(S && S.startupLocation === 'halong'){
    if(evIs('rain') || evIs('storm')) weatherMul *= Math.max(0.35, 1 - 0.25 * dMul);
    else if(evIs('hot') || evIs('holiday') || evIs('weekend') || (S.day % 7 === 0 || S.day % 7 === 6)) weatherMul *= (1 + 0.15 * bMul);
  } else if(S && S.startupLocation === 'hue' && (evIs('rain') || evIs('storm'))){
    weatherMul *= Math.max(0.40, 1 - 0.18 * dMul);
  } else if(S && S.startupLocation === 'vungtau' && (evIs('rain') || evIs('storm'))){
    weatherMul *= Math.max(0.40, 1 - 0.20 * dMul);
  } else if(S && S.startupLocation === 'dalat' && (evIs('rain') || evIs('storm'))){
    weatherMul *= Math.max(0.45, 1 - 0.15 * dMul);
  }
  const cappedWeather = Math.min(1.50, Math.max(0.45, weatherMul));

  const avgIdx=(typeof isStaffActive === 'function' && isStaffActive('staffButler')) ? 1.0 : BASE_KEYS.filter(k=>S.unlocked[k]).reduce((a,k)=>a+S.sell[k]/DEF_SELL[k],0)/BASE_KEYS.filter(k=>S.unlocked[k]).length;
  const baseTrf = rf * totalBoost * cappedWeather / Math.max(.85, Math.min(1, avgIdx)**2);

  // Trần traffic tổng: 6.5x-8.5x thông thường; tăng thêm bonus khi mở rộng quầy (+2.5x) hoặc nâng tầng (+4.5x), chạm 11.0x-13.0x
  const hasAds = S.mxh && S.mxh.activeAds && S.mxh.activeAds.length > 0;
  const slotCapBonus = S.upg.floor2 ? 4.5 : (S.upg.slot4 ? 2.5 : 0);
  const maxTrafficCap = (hasAds ? 8.5 : 6.5) + slotCapBonus;

  return Math.min(maxTrafficCap, Math.max(1.1, baseTrf || 1.1));
}
const RX={fast:/nhanh|chưa tới 5 phút|đúng giờ|không phải đợi/,
  wait:/chờ|đợi|lâu|chậm|mỏi chân|xếp hàng|hàng dài|quán đông|đông quá|đông khách|đông kinh|kịp tay|đuối|bận|cao điểm|trễ/,
  pNeg:/đắt|giá hơi|giá này|giá cao|hơi phí|phí tiền|tiếc tiền|chát so|giá khá chát|ví mình|ví mỏng|so với giá|mạnh tay|chùn tay|đáng với giá|đáng giá|túi tiền hơn|điều chỉnh giá|bảng giá|giảm giá|khuyến mãi|hai ly quán khác/,
  pPos:/giá hợp lý|giá sinh viên|giá mềm|giá tốt|rẻ|đáng tiền|giá ok|giá phải chăng|giá chấp nhận|hạt dẻ|hời|giá dễ thương|giá tâm lý|túi tiền sinh viên|chưa tới trăm/,
  wrong:/sai|nhầm|lộn|làm lại|đổi lại|thiếu topping|dặn kỹ|dặn rõ|một đằng/,
  k:{size:/size/,sugar:/đường|ngọt lịm/,ice:/đá/,tops:/topping/,mon:/nhầm|một đằng|sai vị|món khác/}};
function reviewFits(t,why,c){const f=c&&c.rf;if(!f)return true;const L=t.toLowerCase();
  if(RX.fast.test(L)){if(f.wait)return false}else if(RX.wait.test(L)&&!f.wait&&!['wait','timeout','late'].includes(why))return false;
  if(RX.pNeg.test(L)&&!f.pricey)return false;
  if(RX.pPos.test(L)&&f.pricey)return false;
  if(RX.wrong.test(L)&&!f.wrong&&why!=='comfort')return false;
  if(/đổ ra|rỉ ra|dính (hết )?tay|tràn/.test(L)&&!f.spill)return false;
  if(c.cups&&c.cups.every(o=>!o.tops.length)&&/topping|trân châu|thạch|foam|kem sữa|phô mai|sương sáo|cặp bài trùng/.test(L))return false;
  if(c.cups&&c.cups.every(o=>o.ice==null||o.ice==='Không đá')&&/đá (hơi nhiều|nhiều quá|tan|vừa đủ|viên)|ít đá như/.test(L))return false;
  if(/size l|ly to|ly nhỏ/.test(L)&&c.cups&&!c.cups.some(o=>o.size==='L'))return false;
  if(why==='wrong'&&c.wk){for(const k in RX.k)if(!c.wk[k]&&RX.k[k].test(L))return false}
  return true}
function reviewText(why,c,st,extra){
  const o=c&&c.cups?c.cups[0]:null,mon=o?low(dname(o)):'trà sữa';
  const top=o&&o.tops.length?low(ITEMS[o.tops[0]].n):'topping';
  const strip=safeStripEmoji;
  const recent=new Set(S.reviews.slice(0,60).map(r=>strip(r.t)));
  const cap=x=>x.charAt(0).toUpperCase()+x.slice(1);
  const fill=t=>{t=t.replace(/\{Mon\}/g,cap(mon)).replace(/\{Top\}/g,cap(top)).replace(/\{shop\}/g,'quán '+shopName()).replace(/\{mon\}/g,mon).replace(/\{top\}/g,top).replace('%',extra||mon);return t.charAt(0).toUpperCase()+t.slice(1)};
  const make=()=>{const L=LONG[why];if(L&&Math.random()<.5)return fill(L.map(x=>rnd(x)).join(' '));const P=PARTS[why];if(P)return fill(rnd(P[0])+', '+rnd(P[1]));return fill(rnd(TXT[why]))};
  const used=new Set(S.reviews.map(r=>r.k||strip(r.t)));
  const fits=x=>reviewFits(x,why,c);
  const pool=(TXT[why]||[]).map(fill).filter(x=>!used.has(strip(x))&&fits(x));
  let t=pool.length&&Math.random()<.75?rnd(pool):make();for(let n=0;n<80&&(used.has(strip(t))||!fits(t));n++)t=n<40&&pool.length?rnd(pool):make();
  if(!fits(t)){const any=(TXT[why]||[]).map(fill).filter(fits);t=any.length?rnd(any):t}
  if(!safeHasEmoji(t)){const lastTail=(S.reviews[0]&&safeMatchTrailingEmoji(S.reviews[0].t))||'';
    const pool=TAIL_MOOD[MOOD[why]||'ok'].filter(x=>x.trim()!==lastTail);t+=rnd(pool.length?pool:TAIL_MOOD.ok)}
  return {t,k:strip(t)};
}
function addReview(st,why,online,c,extra){
  const sr=c&&c.star!=null, isFr=c&&c.isFriend, isSpec=!!(c&&c.isSpecialRecipeGuest);
  const isFrNeg = isFr && (['timeout','refused','soldout','soldoutPartial','soldoutOnl','wrong','late','bad'].includes(why) || st <= 2);
  if(why==='party'){
    const clientName = (extra && extra.name) || 'Ban Tổ Chức Tiệc';
    const pTitle = (extra && extra.partyTitle) || 'buổi tiệc';
    const cupsN = (extra && extra.cups) || 20;
    const partyReviews = [
      `🎉 Đặt tiệc ${pTitle} với ${cupsN} ly trà sữa ở quán, quá bất ngờ vì giao đúng giờ, trà thơm béo đậm vị, topping đầy ắp! Cả nhóm ai cũng tấm tắc khen. Quán uy tín 5 sao! ⭐⭐⭐⭐⭐`,
      `🎂 Tổ chức tiệc đặt cả chục ly trà của quán mà chất lượng đồng đều xuất sắc! Khách mời uống khen nức nở. Lần sau tiệc tùng nhất định lại ủng hộ quán tiếp! 🧋✨`,
      `🏢 Hợp đồng tiệc ${cupsN} ly chuẩn chỉnh từng ly một, đóng gói cẩn thận sạch sẽ. Rất cảm ơn chủ quán và các bạn nhân viên nhiệt tình chu đáo! Xứng đáng 5 sao chất lượng! 💖`
    ];
    const txt = rnd(partyReviews);
    S.reviews.unshift({s:5,t:txt,k:'party_'+Date.now()+Math.random(),d:S.day,o:false,n:clientName,f:'🎉',tg:'🎉 Đơn Đặt Tiệc',b:'tra',fl:null,tp:['tran'],ch:false,sz:'L'});
    S.revTotal=Math.max(S.revTotal||0,S.reviews.length-1)+1;if(S.reviews.length>2500)S.reviews.length=2500;R.today.stars.push(5);
    if(S.revDist && S.revDist[5] != null) S.revDist[5]++;
    checkReset5StarRating();
    return;
  }
  if(why==='party_fail'){
    const clientName = (extra && extra.name) || 'Khách Đặt Tiệc';
    const pTitle = (extra && extra.partyTitle) || 'tiệc';
    const txt = `Quán nhận cọc đặt tiệc ${pTitle} mà đến giờ giao bị thiếu ly, làm lỡ hết kế hoạch của chúng tôi! Quá thất vọng về cách phục vụ, không bao giờ quay lại! 😡👎`;
    S.reviews.unshift({s:1,t:txt,k:'party_fail_'+Date.now()+Math.random(),d:S.day,o:false,n:clientName,f:'😤',tg:'⚠️ Phàn Nàn Tiệc',b:'tra',fl:null,tp:[],ch:false,sz:'M'});
    S.revTotal=Math.max(S.revTotal||0,S.reviews.length-1)+1;if(S.reviews.length>2500)S.reviews.length=2500;R.today.stars.push(1);
    if(S.revDist && S.revDist[1] != null) S.revDist[1]++;
    checkReset5StarRating();
    return;
  }
  const isSpecialDrink = (why === 'special_drink' || why === 'special_recipe' || why === 'special_mastery' || isSpec || (c && c.isSpecialDrinkCustomer));
  const curCash = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S && S.money) : (Number(S && S.money) || 0);
  const revTiers = getSafeCashTiers(S && S.day);
  const verdictRev = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(curCash) : { isCheater: false, tier: 0 };
  const isCheaterRev = !!(verdictRev.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(curCash)));
  const revCheatTier = isCheaterRev ? Math.max(verdictRev.tier || 0, curCash >= revTiers.megaCap ? 4 : (curCash >= revTiers.highCap ? 3 : (curCash >= revTiers.midCap ? 2 : (curCash >= revTiers.lowCap ? 1 : 0)))) : 0;
  if(isCheaterRev && revCheatTier >= 3){
    // Chỉ khi có căn cứ gian lận (Ngưỡng Phán Quyết SHADOWBAN/BAN hoặc Vượt Két Tầng 3-4): khóa 5★ và ép xuống 1★-2★
    if(revCheatTier >= 4){
      st = Math.random() < 0.75 ? 1 : 2;
    } else {
      st = Math.random() < 0.55 ? 1 : (Math.random() < 0.70 ? 2 : 3);
    }
  } else if(isCheaterRev && revCheatTier >= 2){
    if(st >= 5 && Math.random() < 0.85) st = Math.random() < 0.5 ? 2 : 3;
    else if(st === 4 && Math.random() < 0.50) st = 3;
  } else if(sr){
    st=5;
  } else if(isSpec || why === 'special_mastery'){
    st=5;
  } else if(isFr && !isFrNeg){
    st=5;
  } else if(st === 4 && !isFrNeg){
    let up5Chance = 0;
    if(!isCheaterRev){
      if(typeof S !== 'undefined' && S && S.startupLocation === 'hue'){
        const bMul = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
        up5Chance += 0.15 * bMul; // Huế: Khách thanh lịch +15% tỷ lệ đánh giá 5★
      }
      if(typeof S !== 'undefined' && S && S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50){
        up5Chance += 0.12; // 🐕 Tó Shiba: Khách thích check-in cùng cún cưng +12% lên 5★
      }
    }
    if(up5Chance > 0 && Math.random() < Math.min(0.65, up5Chance)){
      st = 5;
    }
  }
  let frTxt;
  if(isFrNeg){
    const qPrefix = (c&&c.friendData&&c.friendData.quote) ? `"${c.friendData.quote}" - ` : '';
    if(why==='timeout'){
      frTxt = `${qPrefix}Tưởng qua ủng hộ bạn thân sẽ được ưu tiên, ai ngờ đứng đợi mỏi mòn không thấy nước đâu phải ôm bụng đói đi về! Trừ sao cảnh cáo nhé bạn iu! 😢👎`;
    } else if(why==='wrong'){
      frTxt = `${qPrefix}Bạn bè làm ăn thế này là chết rồi, order một đằng làm một nẻo! Uống ngụm nước mà tức á, cho ${st}★ để rút kinh nghiệm nhé! 😤🧋`;
    } else if(why==='refused'){
      frTxt = `${qPrefix}Cất công lặn lội ghé quán ủng hộ bạn iu mà bị từ chối không bán, hụt hẫng ghê luôn. Buồn người bạn này ghê á! 🥺💔`;
    } else {
      frTxt = `${qPrefix}Ghé ủng hộ quán bạn mình mà hết sạch nguyên liệu không làm được, thất vọng ghê. Lần sau chuẩn bị chu đáo hơn nha bạn thân! 😒🧋`;
    }
  } else {
    frTxt = (c&&c.friendData) ? `${c.friendData.quote?`"${c.friendData.quote}" - `:''}Trà của bạn mình pha chuẩn không cần chỉnh! Cả hội bạn đều mê ly ${c.cups&&c.cups[0]&&ITEMS[c.cups[0].base]?ITEMS[c.cups[0].base].n:'trà thơm béo'}! Chấm 5★ ủng hộ bạn iu! 🧋✨` : 'Trà của bạn mình pha ngon đỉnh chóp! 5 sao không có nhưng! 🧋✨';
  }

  const o = c && c.cups ? c.cups[0] : null;
  const isVip = !!(c && c.vip);
  const isBranch = !!(c && (c.fromBranch || (c.name && c.name.includes('[chi-nhánh]'))));

  let specReviewTxt = null;
  if(isSpecialDrink){
    const rec = (extra && extra.recipe) || (c && c.specialRecipe);
    const rName = rec ? rec.name : (o ? low(dname(o)) : 'đồ uống đặc biệt');
    if(st >= 5){
      const specRevPool = [
        `✨ [ĐỒ UỐNG ĐẶC BIỆT] Vừa mua thử ly "${rName}" theo lời giới thiệu của quán. Hương vị độc bản quá đỉnh, thơm béo hài hòa không lẫn vào đâu được! 5 sao chất lượng! ⭐⭐⭐⭐⭐`,
        `🧋 [MÓN ĐẶC BIỆT] Ly "${rName}" ngon xuất sắc đỉnh chóp! Đúng là tuyệt phẩm của tiệm, uống một ngụm là say đắm. Nhất định sẽ rủ bạn bè ghé ủng hộ món này tiếp! 💖`,
        `👑 [CỰC PHẨM ĐỘC BẢN] Đã thẩm định món "${rName}"! Kết hợp đỉnh cao giữa các tầng hương vị, nguyên liệu tuyển chọn tuyệt hảo! Xứng danh cực phẩm 5 sao! 🏆🍵`,
        `🌟 [ĐỒ UỐNG ĐẶC BIỆT] Ghé quán chỉ để thử món "${rName}" và thực sự bất ngờ! Vị trà đậm đà, topping hòa quyện xuất sắc. Xứng đáng là signature của tiệm! 🧋✨`,
        `🥤 [MÓN ĐẶC BIỆT] Món "${rName}" uống cuốn dã man! Vị ngon bùng nổ khác biệt hoàn toàn với trà sữa thông thường. 10 điểm chất lượng cho chủ tiệm! 💯⭐`
      ];
      specReviewTxt = rnd(specRevPool);
    } else if(st === 4){
      const specRevPool4 = [
        `✨ [MÓN ĐẶC BIỆT] Vừa thử ly "${rName}", vị rất lạ và thơm ngon! Trải nghiệm 4★ khá ưng ý, topping hòa quyện ổn áp! 🧋👍`,
        `🧋 [ĐỒ UỐNG ĐẶC BIỆT] Ly "${rName}" uống cuốn, hương vị độc đáo khác biệt so với menu thông thường. Chấm 4 sao khích lệ quán tiếp tục phát huy! 🌟🥤`,
        `🌟 [MÓN ĐẶC BIỆT] Món "${rName}" đậm đà, vị trà khá ngon. Phục vụ nhanh gọn gàng, chấm 4★ nha quán! 👌✨`,
        `🥤 [MÓN ĐẶC BIỆT] Ly "${rName}" khá ngon, thơm mùi trà đặc trưng của quán. Chấm 4 sao ủng hộ tiệm trà! ⭐⭐⭐⭐`
      ];
      specReviewTxt = rnd(specRevPool4);
    } else {
      specReviewTxt = `⚠️ [MÓN ĐẶC BIỆT] Thử ly "${rName}" hương vị khá độc lạ, nhưng quán để mình chờ hơi lâu nên đá tan bớt. Chấm ${st}★ rút kinh nghiệm nhen quán! 🧋`;
    }
  }

  let reviewerTxt = null;
  if(isVip){
    const mon = o ? low(dname(o)) : 'trà sữa';
    if(st >= 5){
      const posRev = [
        `🎬 [REVIEWER CHẤM ĐIỂM] Ghé thẩm quán theo lời đồn trên TikTok: Ly ${mon} thơm chuẩn vị mộc, kem cheese béo ngậy không ngấy tí nào. Đáng đồng tiền bát gạo! Chấm 9.8/10 uy tín! 🧋✨`,
        `🎙️ [FOOD BLOGGER ĐÁNH GIÁ] Quán này xứng đáng viral! Trân châu nấu độ dẻo vừa vặn, không bị sượng lõi, trà thơm nức mũi. 10 điểm cho sự tỉ mỉ của chủ quán! 🌟🥤`,
        `📸 [FOODIE CHECK-IN] Lên clip review quán này ngay và luôn! Menu phong phú, decor quầy sạch bóng, nhân viên niềm nở. Rất recommend mọi người ghé trải nghiệm ly ${mon}! 💯🧋`,
        `🔥 [TIKTOK REVIEWER 1M FOLLOW] Không bõ công xếp hàng chờ thẩm! Ly ${mon} đỉnh của chóp, vị ngọt thanh cực kỳ vừa miệng! 5 sao chất lượng! ⭐⭐⭐⭐⭐`,
        `✨ [CHUYÊN GIA ẨM THỰC] Trải nghiệm vị giác tuyệt vời! Hương vị ${mon} cân bằng hoàn hảo giữa độ chát nhẹ và hậu vị ngọt dịu. Một trong những tiệm trà sữa xuất sắc nhất! 👑🧋`,
        `🥤 [REVIEW CHÂN THỰC] Trân châu đường đen dẻo quánh, lớp kem béo ngậy tan chảy, trà ủ lá tươi nguyên bản. Quán làm ăn rất có tâm! 🧋💯`
      ];
      reviewerTxt = rnd(posRev);
    } else if(st >= 3){
      const midRev = [
        `🎙️ [FOOD REVIEWER] Trà sữa ${mon} vị khá ổn áp, độ ngọt vừa phải. Điểm trừ nhẹ là quán đông nên chờ hơi lâu xíu, nhưng bù lại nhân viên dạ thưa rất lễ phép! Chấm 8/10. 🧋👍`,
        `🎬 [REVIEW KHÁCH QUAN] Món signature ${mon} uống cuốn, topping giòn ngon. Hôm nay đá hơi nhiều chút làm tan nhanh, nếu quán chỉnh lại tỷ lệ đá sẽ chuẩn 10 điểm nha! 👌🥤`
      ];
      reviewerTxt = rnd(midRev);
    } else {
      const negRev = [
        `🚨 [REVIEWER CẢNH BÁO] Hôm nay ghé quán trải nghiệm ly ${mon} thì hơi hụt hẫng! Chờ mòn mỏi mà phục vụ sai món, trà bị nhạt và đá tan hết. Quán cần cải thiện tốc độ gấp! 👎😤`,
        `📉 [BÓC PHỐT ẨM THỰC] Đi theo review triệu view trên mạng nhưng thực tế thất vọng tràn trề! Làm sai topping, thái độ phục vụ lúng túng. 1 sao cho trải nghiệm hôm nay! ❌🧋`
      ];
      reviewerTxt = rnd(negRev);
    }
  }

  let branchReviewTxt = null;
  if(isBranch && !isVip && !isFr && !sr && Math.random() < 0.75){
    const mon = o ? low(dname(o)) : 'trà sữa';
    if(st >= 5){
      const branchPosRev = [
        `🏢 [KHÁCH CHI NHÁNH] Uống bên chi nhánh hoài, nay ghé quán chính uống ly ${mon} thấy đúng là quán mẹ có khác, thơm ngon đậm đà hơn hẳn! 10/10! 🧋✨`,
        `🏢 [KHÁCH CHI NHÁNH] Khách ruột chi nhánh ghé quán chính test tay nghề chủ quán, kết quả là dính luôn! Trân châu mềm dẻo đỉnh chóp! 🌟`,
        `🏢 [KHÁCH CHI NHÁNH] Chi nhánh pha đã ngon rồi mà quán chính còn xuất sắc hơn nữa! Rất đáng công lặn lội qua đây uống! ❤️🥤`,
        `🏢 [KHÁCH CHI NHÁNH] Nhân viên bên chi nhánh giới thiệu qua quán chính gặp chủ quán, phục vụ siêu nhiệt tình, nước ngon chuẩn vị! 💯`
      ];
      branchReviewTxt = rnd(branchPosRev);
    } else if(st <= 2){
      branchReviewTxt = `🏢 [KHÁCH CHI NHÁNH] Tưởng qua quán chính sẽ đỉnh hơn chi nhánh, ai ngờ chờ lâu quá trời mà làm sai món nữa! Hơi thất vọng nhen! 🥺👎`;
    }
  }

  const r = sr
    ? (x=>({t:x[0]+' [Tự động dịch] '+x[1],k:'★'+c.star+Math.random()}))(starLine(STARS[c.star],'rv'))
    : isSpecialDrink
      ? {t:specReviewTxt, k:'spec_rev_'+(c?c.id:Date.now())+'_'+Math.random()}
      : isFr
        ? {t:frTxt,k:'friend_'+c.id+Math.random()}
        : reviewerTxt
          ? {t:reviewerTxt,k:'vip_rev_'+c.id+Math.random()}
          : branchReviewTxt
            ? {t:branchReviewTxt,k:'branch_rev_'+c.id+Math.random()}
            : reviewText(why,c,st,extra);

  S.reviews.unshift({
    s: st,
    t: r.t,
    k: r.k,
    d: S.day,
    o: !!online,
    ...(sr ? { st: c.star, tg: STARS[c.star].t } : {}),
    ...(isSpecialDrink ? { tg: isSpec ? '👑 Khách Thẩm Định' : '✨ Đồ Uống Đặc Biệt', f: '🧋', isSpecialDrink: true, specialRecipeName: (c && c.specialRecipe ? c.specialRecipe.name : null) } : {}),
    ...(isFr && !isSpecialDrink ? { tg: isFrNeg ? '💔 Bạn Giận Dỗi' : '👑 VIP Bạn Bè' } : {}),
    ...(isVip && !isSpecialDrink ? { tg: '🎙️ Food Reviewer' } : {}),
    ...(isBranch && !isFr && !isVip && !sr && !isSpecialDrink ? { tg: '🏢 Khách Chi Nhánh' } : {}),
    n: c ? c.name : 'Khách',
    f: (c && c.face) || (isSpec ? '👑' : (isSpecialDrink ? '🧋' : (isVip ? '🎙️' : '🙂'))),
    b: o ? o.base : null,
    fl: o ? o.flav : null,
    tp: o ? o.tops : [],
    ch: o ? !!o.cheese : false,
    sz: o ? o.size : 'M'
  });

  S.revTotal=Math.max(S.revTotal||0,S.reviews.length-1)+1;if(S.reviews.length>2500)S.reviews.length=2500;R.today.stars.push(st);
  if(S.revDist && S.revDist[st] != null) S.revDist[st]++;
  checkReset5StarRating();
  if(typeof renderDesktopRightReviews === 'function' && window.innerWidth >= 1150){
    try { renderDesktopRightReviews(); } catch(e){}
  }
  if(st <= 1 && (!c || !c.isFriend) && Math.random() < 0.35){
    setTimeout(() => { if(S.reviews && S.reviews[0]) triggerFriendBadReview(S.reviews[0]); }, 150);
  }
  const shouldGzSulk = (st<=2||['timeout','late','wrong','bad','refused','soldout','soldoutOnl','soldoutPartial'].includes(why)) || (isTaxOverdue() && st<=3 && Math.random()<0.35);
  if(S.upg.staffGz&&R.running&&!R.gzSulking&&shouldGzSulk)gzTriggerSulk(why,st);
  if(S.upg&&S.upg.staffMkt)applyMktAutoReplies();}

function addKpiFiveStarReviews(u, count){
  if(!count || count <= 0) return;
  const pName = (typeof staffPersonName === 'function' && u ? staffPersonName(u.id) : null) || (u ? u.n : 'Nhân viên');
  const reviewPool = [
    `Bạn ${pName} pha chế nhanh thoăn thoắt, trà sữa đậm đà béo thơm chuẩn vị! Cho 5 sao chất lượng! 🧋✨`,
    `Nhân viên ${pName} phục vụ cực kỳ chu đáo, niềm nở và khéo léo. Uống ly trà sữa thấy vui cả ngày! ⭐⭐⭐⭐⭐`,
    `Quán phục vụ nhanh bất ngờ, chất lượng đỉnh chóp! Rất ấn tượng với sự tận tâm của bạn ${pName}! 💖`,
    `Trà thơm béo, bạn ${pName} khéo tay đóng gói cẩn thận chu đáo. 10 điểm chất lượng phục vụ! 🌟`,
    `Tốc độ ra món nhanh như chớp, trà sữa ngon xuất sắc! Cảm ơn bạn ${pName} nhé! 🧋🎉`,
    `Thưởng thức trà sữa ở quán luôn là trải nghiệm tuyệt vời, bạn ${pName} pha chế quá chuẩn vị! 💯✨`
  ];
  const reviewerNames = ['Bảo Vy', 'Minh Triết', 'Khánh Linh', 'Hoàng Nam', 'Thảo My', 'Tuấn Kiệt', 'Gia Hân', 'Đức Huy', 'Thanh Trúc', 'Anh Thư', 'Quốc Bảo'];
  S.reviews = S.reviews || [];
  for(let i = 0; i < count; i++){
    const txt = reviewPool[(i + Math.floor(Math.random() * reviewPool.length)) % reviewPool.length];
    const reviewerName = reviewerNames[(i + Math.floor(Math.random() * reviewerNames.length)) % reviewerNames.length];
    S.reviews.unshift({
      s: 5,
      t: txt,
      k: 'kpi_5star_' + (u ? u.id : 'staff') + '_' + Date.now() + '_' + i + '_' + Math.random(),
      d: S.day,
      o: false,
      tg: '🌟 Khen Ngợi Phục Vụ',
      f: '🌟',
      n: reviewerName,
      b: 'tra',
      fl: null,
      tp: ['tran'],
      ch: false,
      sz: 'L'
    });
    if(typeof R !== 'undefined' && R && R.today && Array.isArray(R.today.stars)){
      R.today.stars.push(5);
    }
  }
  S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
  if(S.reviews.length > 2500) S.reviews.length = 2500;
  if(typeof checkReset5StarRating === 'function') checkReset5StarRating();
  if(typeof renderDesktopRightReviews === 'function' && typeof window !== 'undefined' && window.innerWidth >= 1150){
    try { renderDesktopRightReviews(); } catch(e){}
  }
}


