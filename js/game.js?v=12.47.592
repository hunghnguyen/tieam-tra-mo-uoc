  staffCleaner: 'Cô Bảy Zọn Zẹp',
  staffShipper: 'Bảo Shipper'
};
function staffPersonName(id){
  if(DEFAULT_STAFF_NAMES[id]) return DEFAULT_STAFF_NAMES[id];
  if(!S) return '';
  S.staffNames = S.staffNames || {};
  if(!S.staffNames[id] && S.hired && S.hired[id]){
    S.staffNames[id] = genName();
  }
  return S.staffNames[id] || '';
}
function staffFullName(u){
  const p = staffPersonName(u.id);
  return p ? `${p} (${u.n})` : u.n;
}
function staffWageTxt(u){
  const id = (u && typeof u === 'object') ? u.id : u;
  if(id === 'staffGuard') return 'Lương: 300k/ngày + 1% doanh thu';
  if(id === 'staffRacer') return 'Lương: 1tr/ngày + 0.5% doanh thu';
  if(id === 'staffButler') return 'Lương: 500k/ngày + 2% doanh thu';
  if(id === 'staffCleaner') return 'Lương: 400k/ngày + 1.5% doanh thu';
  if(id === 'staffShipper') return 'Lương: 600k/ngày + 1% doanh thu';
  if(id === 'staffMkt') return 'Lương 200k/ngày (Tự quay video TikTok liên tục, buff +45% khách, giảm 20% thời gian pha)';
  if(id === 'staffSv') return 'Lương 300k/chỉ làm ca đêm (22h - 6h)';
  if(id === 'staffGz') return 'Lương 275k/ngày';
  if(id === 'staff0') return 'Lương: Tiền tip của quán (0đ lương cứng, không xét KPI)';
  if(id === 'staff1') return 'Lương 165k/ngày';
  if(id === 'staff2'){
    const c = (typeof getStaff2Count === 'function' && typeof S !== 'undefined' && S && S.upg && S.upg.staff2) ? getStaff2Count() : 1;
    return `Lương 200k/ngày/người + 40k/h sau 22h${c > 1 ? ` (${c} thợ: ${fmt(200000 * c)}/ngày)` : ''}`;
  }
  if(id === 'staffOn'){
    const c = (typeof getStaffOnCount === 'function' && typeof S !== 'undefined' && S && S.upg && S.upg.staffOn) ? getStaffOnCount() : 1;
    return `Lương 250k/ngày/người${c > 1 ? ` (${c} người: ${fmt(250000 * c)}/ngày)` : ''}`;
  }
  if(id === 'staff3') return 'Lương 200k/ngày';
  if(id === 'staffBuyer'){
    const c = (typeof getStaffBuyerCount === 'function' && typeof S !== 'undefined' && S && S.upg && S.upg.staffBuyer) ? getStaffBuyerCount() : 1;
    return `Lương 180k/ngày/người${c > 1 ? ` (${c} người: ${fmt(180000 * c)}/ngày)` : ''}`;
  }
  const st = (u && typeof u === 'object') ? u : (STAFF.find(x => x.id === id) || {});
  return `Lương ${fmt((st && CFG[st.wage]) || 0)}/ngày`;
}
const NV_AVATAR_LIST = [
  'img/imnv/b00.png', 'img/imnv/b01.png', 'img/imnv/b02.png',
  'img/imnv/b03.png', 'img/imnv/b04.png', 'img/imnv/b05.png',
  'img/imnv/b06.png', 'img/imnv/b07.png', 'img/imnv/b08.png',
  'img/imnv/b09.png', 'img/imnv/b10.png', 'img/imnv/b11.png',
  'img/imnv/b12.png', 'img/imnv/b13.png', 'img/imnv/b14.png',
  'img/imnv/b34.png', 'img/imnv/b35.png', 'img/imnv/b36.png',
  'img/imnv/b50.png', 'img/imnv/b51.png', 'img/imnv/b52.png',
  'img/imnv/b53.png', 'img/imnv/b54.png', 'img/imnv/b55.png',
  'img/imnv/b56.png', 'img/imnv/b57.png', 'img/imnv/b58.png',
  'img/imnv/b59.png', 'img/imnv/b60.png', 'img/imnv/b61.png',
  'img/imnv/b62.png', 'img/imnv/b63.png', 'img/imnv/b64.png',
  'img/imnv/b65.png', 'img/imnv/b66.png', 'img/imnv/b67.png',
  'img/imnv/b68.png', 'img/imnv/b69.png'
];
function genStaffAvatar(exclude = []){
  const avail = NV_AVATAR_LIST.filter(a => !exclude.includes(a));
  const pool = avail.length ? avail : NV_AVATAR_LIST;
  return pool[Math.floor(Math.random() * pool.length)];
}
function staffAvatarUrl(id){
  if(!S) return NV_AVATAR_LIST[0];
  S.staffAvatars = S.staffAvatars || {};
  if(!S.staffAvatars[id] && S.hired && S.hired[id]){
    const used = Object.values(S.staffAvatars);
    S.staffAvatars[id] = genStaffAvatar(used);
  }
  return S.staffAvatars[id] || NV_AVATAR_LIST[0];
}
function getPlayerLeaderboardAvatar(){
  if(typeof S !== 'undefined' && S){
    if(S.leaderboardAvatar && typeof S.leaderboardAvatar === 'string' && S.leaderboardAvatar.startsWith('img/imnv/')){
      return S.leaderboardAvatar;
    }
    const seed = String((S.id || S.shopName || S.ownerName || 'tiemtra') + '_avatar');
    let hash = 0;
    for(let i = 0; i < seed.length; i++){
      hash = ((hash << 5) - hash) + seed.charCodeAt(i);
      hash |= 0;
    }
    const idx = Math.abs(hash) % NV_AVATAR_LIST.length;
    S.leaderboardAvatar = NV_AVATAR_LIST[idx];
    return S.leaderboardAvatar;
  }
  return NV_AVATAR_LIST[0];
}
function getLeaderboardAvatarUrl(item, rank = 0){
  if(!item) return NV_AVATAR_LIST[0];
  if(item.avatar && typeof item.avatar === 'string' && (item.avatar.includes('/') || item.avatar.endsWith('.png') || item.avatar.endsWith('.webp'))){
    return item.avatar;
  }
  const seed = String(item.id || item.name || item.owner || ('rank_' + rank));
  let hash = 0;
  for(let i = 0; i < seed.length; i++){
    hash = ((hash << 5) - hash) + seed.charCodeAt(i);
    hash |= 0;
  }
  const idx = Math.abs(hash) % NV_AVATAR_LIST.length;
  return NV_AVATAR_LIST[idx];
}
