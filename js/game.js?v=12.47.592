  if(st.id === 'staffButler' || st.id === 'staffGuard'){
    const youthReasons = ['Được phú bà bao nuôi', 'Theo chồng về dinh', 'Tự ái vì sếp không khen tóc mới', 'Bận làm Tiktoker triệu view', 'Hết tiền nạp game gacha', 'Ứng tiền đi date với crush'];
    availableExcuses = availableExcuses.filter(x => !youthReasons.includes(x.reason));
  }

  if(hasQuitNotice || hasLeaveNotice){
    availableExcuses = availableExcuses.filter(x => x.type !== 'quit' && x.type !== 'off');
    if(!availableExcuses.length) return onProceed();
  }
  const excuse = rnd(availableExcuses);

  // Xử lý các loại drama
  if(excuse.type === 'quit'){
    // Thay vì nghỉ ngay, nộp đơn trước 1~3 ngày để chủ tiệm sắp xếp nhân sự
    // Với nhân viên online: nộp đơn trước đúng 1 ngày
    const noticeDays = (st.id === 'staffOn') ? 1 : (Math.floor(Math.random() * 3) + 1);
    const quitDay = S.day + noticeDays;

    S.staffQuitNotices[st.id] = {
      staffId: st.id,
      staffName: staffName,
      noticeDays: noticeDays,
      submittedDay: S.day,
      quitDay: quitDay,
      reason: excuse.reason,
      txt: excuse.txt,
      icon: excuse.icon
    };
    save();

    ask(`
      <div class="pbig">${excuse.icon}</div>
      <h2 style="color:#d97706;margin:4px 0 8px;">NỘP ĐƠN XIN NGHỈ VIỆC BÁO TRƯỚC!</h2>
      <div style="background:#fffbeb;border-left:4px solid #f59e0b;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
