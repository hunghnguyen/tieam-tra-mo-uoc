async function cloudSave(long){
  S.cloud=S.cloud||{};
  let code = S.cloud.code;
  if(!code || !/^\d{8}$/.test(code)){
    code = Math.floor(10000000 + Math.random() * 90000000).toString();
  }
  const res = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/saves`, {
    method: 'POST',
    headers: {
      'apikey': SUPABASE_CONFIG.anonKey,
      'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`,
      'Content-Type': 'application/json',
      'Prefer': 'resolution=merge-duplicates'
    },
    body: JSON.stringify({ code: code, data: long })
  });
  if(res.ok || res.status === 201 || res.status === 200){
    S.cloud.code = code;
    save();
    return code;
  }
  const errJson = await res.json().catch(() => ({}));
  throw new Error(errJson.message || errJson.error || 'Không thể lưu dữ liệu lên máy chủ Supabase!');
}

async function cloudLoad(code){
  code = String(code || '').trim().replace(/\s+/g, '');
  if(!/^\d{8}$/.test(code)) throw 'Mã sao lưu phải gồm đúng 8 chữ số!';
  const res = await fetch(`${SUPABASE_CONFIG.url}/rest/v1/saves?code=eq.${code}&select=*`, {
    headers: {
      'apikey': SUPABASE_CONFIG.anonKey,
      'Authorization': `Bearer ${SUPABASE_CONFIG.anonKey}`
    }
  });
  if(res.ok){
    const rows = await res.json();
    if(Array.isArray(rows) && rows.length > 0 && rows[0].data){
      const d = await readBackup(rows[0].data);
      d.cloud = { key: (d.cloud || {}).key, code };
      return d;
    }
    throw 'Không tìm thấy bản lưu với mã 8 số này!';
  }
  const errJson = await res.json().catch(() => ({}));
  throw new Error(errJson.message || errJson.error || 'Không thể tải bản lưu từ máy chủ Supabase!');
}
