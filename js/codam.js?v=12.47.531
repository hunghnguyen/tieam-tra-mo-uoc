      btnColor: '#ef4444'
    },
    rainbow: {
      key: 'rainbow',
      name: 'Cầu Vồng',
      icon: '🌈',
      desc: 'Hút sạch 1 loại Topping trên toàn bàn cờ',
      btnColor: '#ec4899'
    },
    moves: {
      key: 'moves',
      name: '+5 Lượt Đi',
      icon: '➕5',
      desc: 'Cộng ngay +5 lượt đi cho màn hiện tại',
      btnColor: '#06b6d4'
    },
    shuffle: {
      key: 'shuffle',
      name: 'Xáo Bàn Cờ',
      icon: '🔀',
      desc: 'Xáo trộn lại toàn bộ bàn kẹo ngay lập tức',
      btnColor: '#8b5cf6'
    }
  };

  function getBoosters() {
    if (!window.S) return { hammer: 1, bomb: 1, rainbow: 1, moves: 1, shuffle: 1 };
    if (!window.S.crushBoosters) {
      window.S.crushBoosters = { hammer: 1, bomb: 1, rainbow: 1, moves: 1, shuffle: 1 };
    }
    return window.S.crushBoosters;
  }

  function getBoosterCost() {
    const curMoney = (window.S && typeof window.S.money === 'number') ? window.S.money : 0;
    // 10% két quán (tối thiểu 1.000đ)
    const cashCost = Math.max(1000, Math.floor(curMoney * 0.10));
    // x10 tổng sao (10 Sao đẳng cấp star5Count)
    const starCost = 10;
    return {
      cashCost,
      starCost,
      curMoney,
      curStars: (window.S && window.S.star5Count) || 0
    };
  }

  function buyBooster(boosterKey) {
    if (!window.S) return false;
    const { cashCost, starCost, curMoney, curStars } = getBoosterCost();

    if (curMoney < cashCost) {
      if (typeof window.toast === 'function') {
        window.toast(`❌ Két tiền không đủ! Cần 10% két (${formatMoney(cashCost)}) để mua vật phẩm!`, 3500, 1);
      }
      return false;
    }
    if (curStars < starCost) {
      if (typeof window.toast === 'function') {
        window.toast(`❌ Tổng sao không đủ! Cần tối thiểu x10 Tổng Sao (⭐) (Hiện có: x${curStars} ⭐) để mua vật phẩm!`, 3500, 1);
      }
      return false;
    }

    window.S.money -= cashCost;
    window.S.star5Count = Math.max(0, curStars - starCost);
    const boosters = getBoosters();
    boosters[boosterKey] = (boosters[boosterKey] || 0) + 1;

    if (typeof window.save === 'function') window.save();
    if (typeof window.head === 'function') window.head();
    if (typeof window.sfx === 'function') window.sfx('cash');
    if (typeof window.toast === 'function') {
      const bName = BOOSTER_DEFS[boosterKey] ? BOOSTER_DEFS[boosterKey].name : 'Vật phẩm';
      window.toast(`🎉 Mua thành công 1x ${bName}! (-${formatMoney(cashCost)} & -10 ⭐ Tổng sao)`, 3500);
    }
    return true;
  }

  function openBuyBoosterModal(boosterKey) {
    const b = BOOSTER_DEFS[boosterKey];
    if (!b) return;
    const { cashCost, starCost, curMoney, curStars } = getBoosterCost();
    const canMoney = curMoney >= cashCost;
    const canStars = curStars >= starCost;
    const canAfford = canMoney && canStars;

    const outer = document.querySelector('.crush-board-outer') || document.getElementById('codam-card');
    if (!outer) return;
    const old = outer.querySelector('#crushBoosterModal');
    if (old) old.remove();

    const div = document.createElement('div');
    div.className = 'crush-level-intro-overlay';
    div.id = 'crushBoosterModal';
    div.innerHTML = `
      <div class="crush-level-intro-card" style="max-width:320px;text-align:center;">
        <div style="font-size:2.2rem;line-height:1;margin-bottom:4px;">${b.icon}</div>
        <h3 style="margin:0 0 4px;font-size:1.15rem;font-weight:900;color:#be185d;">MUA ${b.name.toUpperCase()}</h3>
        <div style="font-size:0.75rem;color:#64748b;margin-bottom:8px;">${b.desc}</div>

        <div style="background:#fdf2f8;border:1.5px dashed #fbcfe8;border-radius:12px;padding:8px 10px;margin-bottom:10px;text-align:left;">
          <div style="font-size:0.72rem;font-weight:900;color:#db2777;margin-bottom:4px;">GIÁ BÁN VẬT PHẨM:</div>
          <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.78rem;font-weight:800;margin-bottom:3px;">
            <span>💵 10% Két Quán:</span>
            <span style="color:${canMoney ? '#16a34a' : '#dc2626'};">${formatMoney(cashCost)} (${canMoney ? 'Đủ' : 'Thiếu'})</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;font-size:0.78rem;font-weight:800;margin-bottom:3px;">
            <span>⭐ x10 Tổng Sao:</span>
            <span style="color:${canStars ? '#16a34a' : '#dc2626'};">${starCost} Sao (${canStars ? 'Đủ' : 'Thiếu'})</span>
          </div>
          <div style="border-top:1px dashed #fbcfe8;padding-top:4px;margin-top:4px;font-size:0.7rem;color:#64748b;">
            Hiện có: <b>${formatMoney(curMoney)}</b> | <b>x${curStars} ⭐</b>
          </div>
        </div>

        <div style="display:flex;gap:6px;">
          <button type="button" class="crush-btn" id="confirmBuyBoosterBtn" 
                  style="flex:1;padding:8px 10px;font-size:0.88rem;font-weight:900;${!canAfford ? 'opacity:0.6;' : ''}">
            MUA NGAY 🛒
          </button>
          <button type="button" class="crush-btn sec" id="cancelBuyBoosterBtn" 
                  style="padding:8px 12px;font-size:0.88rem;">Đóng</button>
        </div>
      </div>
    `;
    outer.appendChild(div);

    const confirmBtn = div.querySelector('#confirmBuyBoosterBtn');
    const cancelBtn = div.querySelector('#cancelBuyBoosterBtn');

    if (cancelBtn) cancelBtn.onclick = () => div.remove();
    if (confirmBtn) {
      confirmBtn.onclick = () => {
        const ok = buyBooster(boosterKey);
        if (ok) {
          div.remove();
          renderBoostersBar();
        }
      };
    }
  }

  function renderBoostersHtml() {
    const boosters = getBoosters();
    return `
      <div class="crush-boosters-track">
        ${Object.keys(BOOSTER_DEFS).map(k => {
          const b = BOOSTER_DEFS[k];
          const count = boosters[k] || 0;
          const isActive = STATE.activeBooster === k;
          return `
            <div class="crush-booster-slot">
              <button type="button" class="crush-booster-btn ${isActive ? 'active' : ''} ${count === 0 ? 'empty' : ''}" 
                      data-booster="${k}" title="${b.name}: ${b.desc}">
                <span class="crush-booster-icon">${b.icon}</span>
                <span class="crush-booster-name">${b.name}</span>
                <span class="crush-booster-badge ${count === 0 ? 'zero' : ''}">${count}</span>
              </button>
              <button type="button" class="crush-booster-plus-btn" data-buy-booster="${k}" title="Mua thêm ${b.name}">+</button>
            </div>
          `;
        }).join('')}
      </div>
    `;
  }

  function renderBoostersBar() {
    const bar = document.getElementById('crushBoostersBar');
    if (bar) bar.innerHTML = renderBoostersHtml();
  }

  function updateBoardTargetingClass() {
    const gridEl = document.getElementById('crushBoardGrid');
    if (!gridEl) return;
    if (STATE.activeBooster) {
      gridEl.classList.add('booster-targeting');
    } else {
      gridEl.classList.remove('booster-targeting');
    }
  }

  async function handleBoosterClick(key) {
    if (STATE.isBusy || STATE.gameEnded) return;

    const boosters = getBoosters();
    const count = boosters[key] || 0;

    if (count <= 0) {
      openBuyBoosterModal(key);
      return;
    }

    // Nếu là lượt đi tức thì (moves hoặc shuffle)
    if (key === 'moves') {
      boosters.moves = Math.max(0, boosters.moves - 1);
      if (typeof window.save === 'function') window.save();
      STATE.moves += 5;
      triggerScreenShake('light');
      triggerComboFly('+5 LƯỢT ĐI! ➕5', 4);
      triggerPraise('+5 LƯỢT ĐI CHIẾN LƯỢC!');
      if (typeof window.sfx === 'function') window.sfx('lvup');
      renderHeaderAndStats();
      renderBoostersBar();
      return;
    }

    if (key === 'shuffle') {
      boosters.shuffle = Math.max(0, boosters.shuffle - 1);
      if (typeof window.save === 'function') window.save();
      triggerComboFly('ĐỔI BÀN CỜ! 🔀', 3);
      triggerPraise('ĐẢO BÀN CỜ TOÀN DIỆN!');
      if (typeof window.sfx === 'function') window.sfx('dice');
      renderBoostersBar();
      await triggerShuffle();
      return;
    }

    // Đối với các booster nhắm mục tiêu: hammer, bomb, rainbow
    if (STATE.activeBooster === key) {
      STATE.activeBooster = null;
      STATE.statusMsg = 'Đã hủy dùng vật phẩm';
      renderHeaderAndStats();
      renderBoostersBar();
      updateBoardTargetingClass();
    } else {
      STATE.activeBooster = key;
      const def = BOOSTER_DEFS[key];
      STATE.statusMsg = `${def.icon} ${def.name}: ${def.desc}`;
      if (typeof window.toast === 'function') {
        window.toast(`🎯 Chọn 1 ô trên bàn cờ để kích hoạt ${def.name}! (Bấm lại để hủy)`, 2500);
      }
      renderHeaderAndStats();
      renderBoostersBar();
      updateBoardTargetingClass();
    }
  }

  async function executeBoosterOnCell(boosterKey, r, c) {
    if (STATE.isBusy || STATE.gameEnded) return;

    const boosters = getBoosters();
    if ((boosters[boosterKey] || 0) <= 0) {
      STATE.activeBooster = null;
      renderBoostersBar();
      updateBoardTargetingClass();
      return;
    }

    STATE.isBusy = true;
    stopTurnTimer();

    // Khấu trừ 1 vật phẩm
    boosters[boosterKey] = Math.max(0, boosters[boosterKey] - 1);
    if (typeof window.save === 'function') window.save();

    STATE.activeBooster = null;
    renderBoostersBar();
    updateBoardTargetingClass();

    if (boosterKey === 'hammer') {
      // 🔨 BÚA TOPPING: Đập nổ ô (r, c)
      triggerScreenShake('medium');
      spawnExplosionParticles(r, c, '#f59e0b');
      spawnShockwave(r, c);
      if (typeof window.sfx === 'function') window.sfx('bell');
      triggerComboFly('ĐẬP BÚA! 🔨', 3);

      const cellsToClear = [{ r, c }];
      const { cells: expandedMatches, flyingFish } = expandSpecialExplosions(cellsToClear);
      await processEliminations(expandedMatches, [], flyingFish);
      await dropAndFillCascade();
      finishTurn();
    } else if (boosterKey === 'bomb') {
      // 💣 BOM PHÔ MAI: Nổ 3x3 quanh (r, c)
      triggerScreenShake('heavy');
      spawnGiantLaserBeams(r, c);
      spawnShockwave(r, c);
      if (typeof window.sfx === 'function') window.sfx('cash');
      triggerComboFly('BOM NỔ BUNG! 💣', 4);

      const cellsToClear = [];
      for (let dr = -1; dr <= 1; dr++) {
        for (let dc = -1; dc <= 1; dc++) {
          const nr = r + dr, nc = c + dc;
          if (nr >= 0 && nr < ROWS && nc >= 0 && nc < COLS) {
            cellsToClear.push({ r: nr, c: nc });
          }
        }
      }
      const { cells: expandedMatches, flyingFish } = expandSpecialExplosions(cellsToClear);
      await processEliminations(expandedMatches, [], flyingFish);
      await dropAndFillCascade();
      finishTurn();
    } else if (boosterKey === 'rainbow') {
      // 🌈 CẦU VỒNG TINH HOA: Hút sạch loại topping của ô (r, c) trên toàn bàn
      const targetTile = STATE.grid[r][c];
      let targetType = (targetTile && targetTile.type >= 0) ? targetTile.type : Math.floor(Math.random() * (STATE.typesCount || 4));

      triggerScreenShake('heavy');
      spawnShockwave(r, c);
      if (typeof window.sfx === 'function') window.sfx('bell');
      triggerComboFly('CẦU VỒNG QUÉT! 🌈', 5);

      const cellsToClear = [];
      for (let row = 0; row < ROWS; row++) {
        for (let col = 0; col < COLS; col++) {
          const t = STATE.grid[row][col];
          if (t && (t.type === targetType || (row === r && col === c))) {
            cellsToClear.push({ r: row, c: col });
          }
        }
      }
      const { cells: expandedMatches, flyingFish } = expandSpecialExplosions(cellsToClear);
      await processEliminations(expandedMatches, [], flyingFish);
      await dropAndFillCascade();
      finishTurn();
    }
  }

  // --- RENDER GIAO DIỆN CHÍNH ---
  function render() {
    const card = document.getElementById('codam-card');
    if (!card) return;

    const def = getLevelDefinition(STATE.level);
    const progressPct = Math.min(100, Math.round((STATE.score / STATE.targetScore) * 100));

    card.innerHTML = `
      <!-- Header -->
      <div class="crush-header">
        <div class="crush-title-box">
          <div class="crush-logo">🍬</div>
          <div>
            <h2 class="crush-title">MILK TEA CRUSH</h2>
            <div class="crush-subtitle">
              ${def.title}
              ${(window.S && window.S.crushBuffRate > 0) ? `<span style="color:#15803d;font-size:0.75rem;font-weight:800;margin-left:5px;">⚡ +${Math.round(window.S.crushBuffRate * 100)}% DT vĩnh viễn</span>` : ''}
            </div>
          </div>
        </div>
        <div class="crush-head-actions">
          <button type="button" class="crush-head-btn" id="crushRestartBtn" title="Chơi ván mới">🔄 Chơi lại</button>
          <button type="button" class="crush-head-btn crush-head-close" id="crushCloseBtn" title="Đóng">✕</button>
        </div>
      </div>

      <!-- Banner Tự Động Bán Nước Trong Lúc Chơi Kẹo -->
      ${(window.R && window.R.running) ? `
        <div class="crush-autosell-bar" id="crushAutoSellBar">
          <span class="crush-autosell-dot">🟢</span>
          <div class="crush-autosell-text">
            <span>Tự động bán: <b id="crushAutoSellEarned" style="color:#16a34a;">+${(window.fmt ? window.fmt(window.R.crushAutoEarned || 0) : ((window.R.crushAutoEarned || 0).toLocaleString() + 'đ'))}</b> (<span id="crushAutoSellCount">${window.R.crushAutoServedCount || 0}</span> ly)</span>
          </div>
        </div>
      ` : ''}

      <!-- Dashboard Bar -->
      <div class="crush-dashboard">
        <div class="crush-stat-block">
          <span class="crush-stat-label">Điểm số</span>
          <span class="crush-stat-val" id="crushScoreVal">${STATE.score.toLocaleString()}</span>
        </div>

        <div class="crush-moves-badge">
          <span class="crush-moves-num" id="crushMovesVal">${STATE.moves}</span>
          <span class="crush-moves-txt">Lượt</span>
        </div>

        <div class="crush-target-block">
          <span class="crush-stat-label">Mục tiêu: ${STATE.targetScore.toLocaleString()}</span>
          <div class="crush-stars-row">
            <span class="crush-star ${STATE.stars >= 1 ? 'active' : ''}">⭐</span>
            <span class="crush-star ${STATE.stars >= 2 ? 'active' : ''}">⭐</span>
            <span class="crush-star ${STATE.stars >= 3 ? 'active' : ''}">⭐</span>
          </div>
        </div>
      </div>

      <!-- Objectives Row -->
      <div class="crush-objectives-row">
        <div class="crush-obj-title">🎯 MỤC TIÊU:</div>
        <div class="crush-obj-list" id="crushObjList">
          ${renderObjectivesHtml()}
        </div>
      </div>

      <!-- Star Progress Bar -->
      <div class="crush-progress-bar-wrap">
        <div class="crush-progress-fill" style="width: ${progressPct}%;"></div>
      </div>

      <!-- Turn Countdown Timer Bar -->
      <div class="crush-timer-wrap" id="crushTimerWrap">
        <div class="crush-timer-track">
          <div class="crush-timer-fill" id="crushTimerFill" style="width: ${(STATE.turnTime / (STATE.turnTimeMax || TURN_TIME_MAX)) * 100}%;"></div>
        </div>
        <div class="crush-timer-badge" id="crushTimerBadge">
          <span class="crush-timer-icon">⏳</span>
          <span class="crush-timer-sec" id="crushTimerSec">${Math.ceil(STATE.turnTime)}s</span>
        </div>
      </div>

      <!-- Status Bar -->
      <div class="crush-status-bar">
        <span class="crush-status-msg" id="crushStatusMsg">
          ${STATE.statusMsg}
        </span>
        ${STATE.combo > 1 ? `<span class="crush-combo-badge">Combo x${STATE.combo}!</span>` : ''}
      </div>

      <!-- Board Outer -->
      <div class="crush-board-outer">
        <div class="crush-board-grid" id="crushBoardGrid">
          ${renderBoardHtml()}
        </div>
        <div class="crush-fx-layer" id="crushFxLayer" style="position:absolute;inset:0;pointer-events:none;z-index:200;overflow:hidden;"></div>

        <!-- Result Overlay -->
        ${STATE.gameEnded ? renderResultOverlayHtml() : ''}
      </div>

      <!-- Booster Bar -->
      <div class="crush-boosters-bar" id="crushBoostersBar">
        ${renderBoostersHtml()}
      </div>

      <!-- Footer -->
      <div class="crush-footer">
        <div class="crush-tip">
          💡 Ghép 2 kẹo đặc biệt với nhau để tạo Siêu Combo hủy diệt! Hoàn thành đủ Mục tiêu trước khi hết lượt để chiến thắng!
        </div>
      </div>
    `;

    bindEvents();
  }

  function renderHeaderAndStats() {
    const sEl = document.getElementById('crushScoreVal');
    const mEl = document.getElementById('crushMovesVal');
    const msgEl = document.getElementById('crushStatusMsg');
    const objEl = document.getElementById('crushObjList');
    if (sEl) sEl.textContent = STATE.score.toLocaleString();
    if (mEl) mEl.textContent = STATE.moves.toString();
    if (msgEl) msgEl.textContent = STATE.statusMsg;
    if (objEl) objEl.innerHTML = renderObjectivesHtml();
    updateTurnTimerUi();
  }

  function renderBoardHtml() {
    let html = '';
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const tile = STATE.grid[r][c];
        const isChecker = (r + c) % 2 === 1;
        const isSelected = STATE.selectedCell && STATE.selectedCell.r === r && STATE.selectedCell.c === c;

        const jellyLv = (STATE.jelly && STATE.jelly[r]) ? STATE.jelly[r][c] : 0;
        const jellyClass = jellyLv === 2 ? 'has-jelly-2' : (jellyLv === 1 ? 'has-jelly-1' : '');

        if (!tile) {
          html += `
            <div class="crush-cell ${isChecker ? 'checker' : ''} ${jellyClass}" data-cell-pos="${r},${c}">
              ${jellyLv > 0 ? `
                <div class="crush-jelly-coating ${jellyClass}">
                  <span class="crush-jelly-glaze"></span>
                  <span class="crush-jelly-tag">${jellyLv >= 2 ? '🍮²' : '🍮'}</span>
                </div>
              ` : ''}
            </div>
          `;
          continue;
        }

        const isIngredient = tile.special === 'ingredient';
        const topping = isIngredient 
          ? { name: 'Cherry', icon: '🍒', color: '#e11d48' }
          : (TOPPINGS[tile.type] || TOPPINGS[0]);

        const specialClass = tile.special !== 'none' ? `special-${tile.special}` : '';
        const lockedClass = tile.locked ? 'is-locked' : '';

        let icon = topping.icon;
        if (tile.special === 'color_bomb') icon = '🌈';
        else if (tile.special === 'fish') icon = '🐟';
        else if (isIngredient) icon = '🍒';

        let badgeHtml = '';
        if (tile.special === 'striped_h') {
          badgeHtml = '<span class="crush-special-badge" title="Tia Sét Ngang">⚡</span>';
        } else if (tile.special === 'striped_v') {
          badgeHtml = '<span class="crush-special-badge" title="Tia Sét Dọc">⚡</span>';
        } else if (tile.special === 'wrapped') {
          badgeHtml = '<span class="crush-special-badge" title="Kem Cheese Nổ Bung">💣</span>';
        } else if (tile.special === 'color_bomb') {
          badgeHtml = '<span class="crush-special-badge" title="Cầu Vồng Hoàng Gia">✨</span>';
        } else if (tile.special === 'fish') {
          badgeHtml = `<span class="crush-special-badge fish-badge" title="Con Cá">${topping.icon}</span>`;
        }

        html += `
          <div class="crush-cell ${isChecker ? 'checker' : ''} ${jellyClass}" data-cell-pos="${r},${c}">
            <div class="crush-tile crush-type-${tile.type} ${specialClass} ${lockedClass} ${isSelected ? 'selected' : ''}" 
                 data-r="${r}" data-c="${c}" data-tile-id="${tile.id}"
                 title="${topping.name}">
              <span class="crush-tile-icon">${icon}</span>
              ${badgeHtml}
            </div>
            ${jellyLv > 0 ? `
              <div class="crush-jelly-coating ${jellyClass}">
                <span class="crush-jelly-glaze"></span>
                <span class="crush-jelly-tag">${jellyLv >= 2 ? '🍮²' : '🍮'}</span>
              </div>
            ` : ''}
          </div>
        `;
      }
    }
    return html;
  }

  function fastUpdateBoardDOM(gridEl) {
    const cells = gridEl.children;
    let idx = 0;
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++, idx++) {
        const cellEl = cells[idx];
        if (!cellEl) continue;
        const tile = STATE.grid[r][c];
        const isChecker = (r + c) % 2 === 1;
        const isSelected = STATE.selectedCell && STATE.selectedCell.r === r && STATE.selectedCell.c === c;
        const jellyLv = (STATE.jelly && STATE.jelly[r]) ? STATE.jelly[r][c] : 0;
        const jellyClass = jellyLv === 2 ? 'has-jelly-2' : (jellyLv === 1 ? 'has-jelly-1' : '');

        const targetCellClass = `crush-cell ${isChecker ? 'checker' : ''} ${jellyClass}`.trim();
        if (cellEl.className !== targetCellClass) cellEl.className = targetCellClass;

        let tileEl = cellEl.querySelector('.crush-tile');

        if (!tile) {
          if (tileEl) tileEl.remove();
        } else {
          const isIngredient = tile.special === 'ingredient';
          const topping = isIngredient 
            ? { name: 'Cherry', icon: '🍒', color: '#e11d48' }
            : (TOPPINGS[tile.type] || TOPPINGS[0]);
          const specialClass = tile.special !== 'none' ? `special-${tile.special}` : '';
          const lockedClass = tile.locked ? 'is-locked' : '';
          let icon = topping.icon;
          if (tile.special === 'color_bomb') icon = '🌈';
          else if (tile.special === 'fish') icon = '🐟';
          else if (isIngredient) icon = '🍒';

          let badgeHtml = '';
          if (tile.special === 'striped_h') badgeHtml = '<span class="crush-special-badge" title="Tia Sét Ngang">⚡</span>';
          else if (tile.special === 'striped_v') badgeHtml = '<span class="crush-special-badge" title="Tia Sét Dọc">⚡</span>';
          else if (tile.special === 'wrapped') badgeHtml = '<span class="crush-special-badge" title="Kem Cheese Nổ Bung">💣</span>';
          else if (tile.special === 'color_bomb') badgeHtml = '<span class="crush-special-badge" title="Cầu Vồng Hoàng Gia">✨</span>';
          else if (tile.special === 'fish') badgeHtml = `<span class="crush-special-badge fish-badge" title="Con Cá">${topping.icon}</span>`;

          const targetTileClass = `crush-tile crush-type-${tile.type} ${specialClass} ${lockedClass} ${isSelected ? 'selected' : ''}`.trim();

          if (!tileEl) {
            tileEl = document.createElement('div');
            tileEl.className = targetTileClass;
            tileEl.dataset.r = r;
            tileEl.dataset.c = c;
            tileEl.dataset.tileId = tile.id;
            tileEl.title = topping.name;
            tileEl.innerHTML = `<span class="crush-tile-icon">${icon}</span>${badgeHtml}`;
            cellEl.prepend(tileEl);
          } else {
            if (tileEl.className !== targetTileClass) tileEl.className = targetTileClass;
            tileEl.dataset.r = r;
            tileEl.dataset.c = c;
            tileEl.dataset.tileId = tile.id;
            const iconEl = tileEl.querySelector('.crush-tile-icon');
            if (iconEl && iconEl.textContent !== icon) iconEl.textContent = icon;
            const curBadge = tileEl.querySelector('.crush-special-badge');
            if (badgeHtml) {
              if (!curBadge) tileEl.insertAdjacentHTML('beforeend', badgeHtml);
              else if (curBadge.outerHTML !== badgeHtml) {
                curBadge.remove();
                tileEl.insertAdjacentHTML('beforeend', badgeHtml);
              }
            } else if (curBadge) {
              curBadge.remove();
            }
          }
        }

        let jellyEl = cellEl.querySelector('.crush-jelly-coating');
        if (jellyLv > 0) {
          if (!jellyEl) {
            cellEl.insertAdjacentHTML('beforeend', `
              <div class="crush-jelly-coating ${jellyClass}">
                <span class="crush-jelly-glaze"></span>
                <span class="crush-jelly-tag">${jellyLv >= 2 ? '🍮²' : '🍮'}</span>
              </div>
            `);
          } else {
            if (jellyEl.className !== `crush-jelly-coating ${jellyClass}`) jellyEl.className = `crush-jelly-coating ${jellyClass}`;
            const tagEl = jellyEl.querySelector('.crush-jelly-tag');
            if (tagEl) tagEl.textContent = jellyLv >= 2 ? '🍮²' : '🍮';
          }
        } else if (jellyEl) {
          jellyEl.remove();
        }
      }
    }
  }

  function renderBoardOnly() {
    const gridEl = document.getElementById('crushBoardGrid');
    if (!gridEl) return;
    if (gridEl.children.length !== ROWS * COLS) {
      gridEl.innerHTML = renderBoardHtml();
    } else {
      fastUpdateBoardDOM(gridEl);
    }
    renderHeaderAndStats();
  }

  function renderResultOverlayHtml() {
    const isWin = isAllObjectivesComplete();
    const curBuffPct = Math.round(((window.S && window.S.crushBuffRate) || 0) * 100);
    let rewardTxt = '';
    if (isWin) {
      let cashTxt = '+30.000đ';
      if (STATE.stars === 3) cashTxt = '+100.000đ';
      else if (STATE.stars === 2) cashTxt = '+60.000đ';
      const isMilestone = (STATE.level % 5 === 0);
      const milestoneTxt = isMilestone ? '<br><span style="color:#10b981;font-weight:800;font-size:0.95rem;">🎁 ĐẠT MỐC 5 MÀN: NHẬN +1 TÚI NGUYÊN LIỆU BÍ MẬT!</span>' : '';
      rewardTxt = `${cashTxt} & TĂNG VĨNH VIỄN +1% Doanh Thu (Hiện có: +${curBuffPct}% vĩnh viễn) ⚡${milestoneTxt}`;
    } else {
      rewardTxt = `Hết lượt đi! Màn ${STATE.level} vẫn được giữ nguyên để phục thù (Buff vĩnh viễn +${curBuffPct}% không bị mất)!`;
    }

    const def = getLevelDefinition(STATE.level);

    return `
      <div class="crush-result-overlay">
        <div class="crush-result-icon">${isWin ? '🏆🎉' : '🥺'}</div>
        <h3 class="crush-result-title">${isWin ? 'CHIẾN THẮNG NGỌT NGÀO!' : 'HẾT LƯỢT ĐI RỒI!'}</h3>
        <div class="crush-result-desc">
          <b>${def.title}</b><br>
          Điểm số của bạn: <b style="color:#fef08a;font-size:1.1rem;">${STATE.score.toLocaleString()}</b> điểm<br>
          Xếp hạng: ${STATE.stars > 0 ? '⭐'.repeat(STATE.stars) : (isWin ? '⭐' : 'Chưa có sao')}
        </div>
        <div class="crush-reward-badge" style="${!isWin ? 'background:#fef2f2;border-color:#fca5a5;color:#b91c1c;' : ''}">
          ${isWin ? `🎁 ${rewardTxt}` : `⚠️ ${rewardTxt}`}
        </div>
        <div class="crush-result-btns">
          ${isWin ? `
            <button type="button" class="crush-btn" id="crushNextLevelBtn">▶ Chơi Tiếp (Màn ${STATE.level + 1}) ➜</button>
          ` : `
            <button type="button" class="crush-btn" id="crushRetryBtn">🔄 Chơi Lại Màn ${STATE.level}</button>
          `}
          <button type="button" class="crush-btn sec" id="crushOverCloseBtn">Đóng</button>
        </div>
      </div>
    `;
  }

  // --- SỰ KIỆN TƯƠNG TÁC (TOUCH, CLICK, DRAG) ---
  let touchStartX = 0;
  let touchStartY = 0;
  let touchStartCell = null;

  function bindEvents() {
    const card = document.getElementById('codam-card');
    if (!card) return;

    const modal = document.getElementById('codam-modal');
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) close();
      };
    }

    const closeBtn = card.querySelector('#crushCloseBtn');
    if (closeBtn) closeBtn.onclick = close;

    const restartBtn = card.querySelector('#crushRestartBtn');
    if (restartBtn) restartBtn.onclick = restartGame;

    const retryBtn = card.querySelector('#crushRetryBtn');
    if (retryBtn) retryBtn.onclick = restartGame;

    const nextLvlBtn = card.querySelector('#crushNextLevelBtn');
    if (nextLvlBtn) nextLvlBtn.onclick = startNextLevel;

    const overCloseBtn = card.querySelector('#crushOverCloseBtn');
    if (overCloseBtn) overCloseBtn.onclick = close;

    const boostersBar = card.querySelector('#crushBoostersBar');
    if (boostersBar) {
      boostersBar.onclick = (e) => {
        const buyBtn = e.target.closest('[data-buy-booster]');
        if (buyBtn) {
          e.stopPropagation();
          const key = buyBtn.dataset.buyBooster;
          openBuyBoosterModal(key);
          return;
        }
        const btn = e.target.closest('[data-booster]');
        if (btn) {
          e.stopPropagation();
          const key = btn.dataset.booster;
          handleBoosterClick(key);
          return;
        }
      };
    }

    const gridEl = card.querySelector('#crushBoardGrid');
    if (!gridEl) return;

    // 1. XỬ LÝ CHẠM VÀ VUỐT SIÊU NHẠY 60FPS (INSTANT TOUCH & GESTURE SWAP)
    let touchStartX = 0;
    let touchStartY = 0;
    let touchStartCell = null;
    let activePointerId = null;
    let isSwiped = false;

    function handleTapCell(r, c) {
      if (STATE.isBusy || STATE.gameEnded) return;

      if (STATE.activeBooster) {
        executeBoosterOnCell(STATE.activeBooster, r, c);
        return;
      }

      if (!STATE.selectedCell) {
        STATE.selectedCell = { r, c };
        renderBoardOnly();
      } else {
        const prev = STATE.selectedCell;
        if (prev.r === r && prev.c === c) {
          STATE.selectedCell = null;
          renderBoardOnly();
        } else {
          const dist = Math.abs(prev.r - r) + Math.abs(prev.c - c);
          if (dist === 1) {
            const p1 = { ...prev };
            STATE.selectedCell = null;
            handleSwap(p1.r, p1.c, r, c);
          } else {
            STATE.selectedCell = { r, c };
            renderBoardOnly();
          }
        }
      }
    }

    gridEl.onpointerdown = (e) => {
      if (STATE.isBusy || STATE.gameEnded) return;
      const tileEl = e.target.closest('.crush-tile') || e.target.closest('.crush-cell');
      if (!tileEl) return;
      if (e.cancelable) e.preventDefault();

      activePointerId = e.pointerId;
      touchStartX = e.clientX;
      touchStartY = e.clientY;
      isSwiped = false;
      const cellPos = tileEl.dataset.cellPos ? tileEl.dataset.cellPos.split(',') : [tileEl.dataset.r, tileEl.dataset.c];
      touchStartCell = {
        r: parseInt(cellPos[0], 10),
        c: parseInt(cellPos[1], 10)
      };

      try {
        gridEl.setPointerCapture(e.pointerId);
      } catch (_) {}
    };

    gridEl.onpointermove = (e) => {
      if (!touchStartCell || STATE.isBusy || STATE.gameEnded || isSwiped) return;
      if (STATE.activeBooster) return; // Không vuốt khi đang nhắm mục tiêu vật phẩm
      if (e.cancelable) e.preventDefault();

      const dx = e.clientX - touchStartX;
      const dy = e.clientY - touchStartY;
      const absX = Math.abs(dx);
      const absY = Math.abs(dy);

      // Kích hoạt hoán đổi ngay khi vuốt đạt 14px (không cần chờ nhấc ngón tay)
      if (Math.max(absX, absY) >= 14) {
        isSwiped = true;
        const { r, c } = touchStartCell;
        touchStartCell = null;

        let targetR = r;
        let targetC = c;
        if (absX > absY) {
          targetC += (dx > 0) ? 1 : -1;
        } else {
          targetR += (dy > 0) ? 1 : -1;
        }

        if (targetR >= 0 && targetR < ROWS && targetC >= 0 && targetC < COLS) {
          STATE.selectedCell = null;
          handleSwap(r, c, targetR, targetC);
        }

        try {
          if (activePointerId != null) gridEl.releasePointerCapture(activePointerId);
        } catch (_) {}
      }
    };

    gridEl.onpointerup = (e) => {
      try {
        if (activePointerId != null) gridEl.releasePointerCapture(activePointerId);
      } catch (_) {}
      activePointerId = null;

      if (isSwiped) {
        isSwiped = false;
        touchStartCell = null;
        return;
      }

      if (touchStartCell && !STATE.isBusy && !STATE.gameEnded) {
        const { r, c } = touchStartCell;
        touchStartCell = null;
        handleTapCell(r, c);
      } else {
        touchStartCell = null;
      }
    };

    gridEl.onpointercancel = () => {
      try {
        if (activePointerId != null) gridEl.releasePointerCapture(activePointerId);
      } catch (_) {}
      activePointerId = null;
      touchStartCell = null;
      isSwiped = false;
    };

    gridEl.onclick = (e) => {
      e.preventDefault();
      e.stopPropagation();
    };
  }

  // --- API MỞ / ĐÓNG MODAL ---
  function open() {
    const modal = document.getElementById('codam-modal');
    if (!modal) return;
    document.body.classList.add('codam-active');
    const toastEl = document.getElementById('toast');
    if (toastEl) {
      toastEl.classList.remove('show');
      toastEl.style.opacity = '0';
      toastEl.style.display = 'none';
    }
    const sbWrap = document.getElementById('staffBarWrap');
    if (sbWrap) sbWrap.style.display = 'none';

    modal.hidden = false;
    modal.scrollTop = 0;
    const card = document.getElementById('codam-card');
    if (card) card.scrollTop = 0;
    STATE.level = getSavedCrushLevel();
    if (STATE.level > 1) {
      checkAndAwardCrushMilestones(STATE.level - 1);
    }
    if (STATE.grid.length === 0 || STATE.gameEnded) {
      restartGame();
    } else {
      STATE.isBusy = false;
      render();
      startTurnTimer();
    }
    modal.onclick = (e) => {
      if (e.target === modal) close();
    };
    requestAnimationFrame(() => {
      if (modal) modal.scrollTop = 0;
      const c = document.getElementById('codam-card');
      if (c) c.scrollTop = 0;
    });
  }

  function close() {
    stopTurnTimer();
    document.body.classList.remove('codam-active');
    const toastEl = document.getElementById('toast');
    if (toastEl) toastEl.style.display = '';
    const sbWrap = document.getElementById('staffBarWrap');
    if (sbWrap) sbWrap.style.display = '';

    const modal = document.getElementById('codam-modal');
    if (!modal) return;
    modal.hidden = true;
    if (typeof window.onCloseMilkTeaCrush === 'function') {
      window.onCloseMilkTeaCrush();
    }
  }

  // Khai báo MilkTeaCrush, BobaCrush và CoDam để tương thích hoàn toàn
  window.MilkTeaCrush = {
    open,
    close,
    restart: restartGame,
    getState: () => ({ ...STATE }),
    checkAndAwardCrushMilestones
  };

  window.BobaCrush = window.MilkTeaCrush;
  window.CoDam = window.MilkTeaCrush;
  window.openMilkTeaCrush = open;
  window.openCoDam = open;
  window.openBobaCrush = open;
})();
