/* ===== TRƯỚC TIỆM & BẢO VỆ THẦN MÈO KARIN ===== */
let frontPedTimer = null;
let frontShopTimer = null;
let frontPeds = [];
let karinPatrol = { x: 50, speed: 0, dir: 1 };
const KARIN_COOLDOWN = 5 * 60 * 1000;

function updateKarinPatrol(){
  const wrap = $('frontKarinWrap');
  if(!wrap || wrap._inited) return;
  wrap._inited = true;
  karinPatrol.x = 50;
  wrap.style.left = '50%';
  const img = $('frontKarinImg');
  const imgBox = $('frontKarinBtn');
  if(imgBox) imgBox.style.transform = '';
  if(img) img.style.transform = 'scaleX(1)';
}

function getKarinCooldownRem(){
  const last = (S && S.karinLastBuffTime) || 0;
  const passed = Date.now() - last;
  return Math.max(0, KARIN_COOLDOWN - passed);
}

const FRONT_PED_POOLS = [];

function updateFrontShopUI(){
  const rem = getKarinCooldownRem();
  const btn = $('frontCallBtn');
  const info = $('frontBuffInfo');
  if(!btn) return;
  if(rem > 0){
    const remSec = Math.ceil(rem / 1000);
    const m = Math.floor(remSec / 60);
    const s = remSec % 60;
    const timeStr = `${m}p ${s < 10 ? '0' : ''}${s}s`;
    btn.textContent = `⏳ Hồi Chiêu: ${timeStr}`;
    btn.classList.add('on-cooldown');
    if(info) info.innerHTML = `<span>🐾 <b>Thần Mèo Karin:</b> Đang tịnh tâm tu luyện. Hãy quay lại sau <b>${timeStr}</b> nhé!</span>`;
  } else {
    btn.textContent = `📣 Xin Phước Thần Mèo (+20s Chờ & Tiền)`;
    btn.classList.remove('on-cooldown');
    if(info) info.innerHTML = `<span>🐾 <b>Thần Mèo Karin:</b> Ấn nhận bảo vệ: +20s kiên nhẫn toàn tiệm & cơ hội nhận lì xì tiền vía! (5p/lần)</span>`;
  }
}

document.addEventListener('visibilitychange', () => {
  if (frontPedTimer) { clearInterval(frontPedTimer); frontPedTimer = null; }
});

/* ==================== MILK TEA CRUSH AUTO-SELL SYSTEM ==================== */
function openCrushAutoSellMode(){
  if(R && R.running){
    R.crushAutoSelling = true;
    R.crushAutoTimer = 0.4;
  }
  if(window.MilkTeaCrush && typeof window.MilkTeaCrush.open === 'function'){
    window.MilkTeaCrush.open();
  } else if(typeof window.openMilkTeaCrush === 'function'){
    window.openMilkTeaCrush();
  }
}
window.openCrushAutoSellMode = openCrushAutoSellMode;

function updateCrushAutoSellLiveBanner(){
  const earnedEl = $('crushAutoSellEarned');
  const countEl = $('crushAutoSellCount');
  if(earnedEl && R){
    earnedEl.textContent = '+' + (typeof fmt === 'function' ? fmt(R.crushAutoEarned || 0) : ((R.crushAutoEarned || 0).toLocaleString() + 'đ'));
  }
  if(countEl && R){
    countEl.textContent = R.crushAutoServedCount || 0;
  }
}

function crushAutoServeOne(c, i){
  if(!c || !c.cups) return;
  const j = c.cups.findIndex((o, k) => !c.done[k]);
  if(j < 0) return;
  const o = c.cups[j];
  c.order = o;
  
  useStaffCup();
  const toConsume = [
    o.base,
    ...(o.flav ? [o.flav] : []),
    ...o.tops,
    ...(o.cheese ? ['cheese'] : []),
    ...(level() >= 2 && o.sugar && o.sugar > 0 ? ['sugar'] : []),
    ...(level() >= 2 && o.ice && o.ice !== 'Không đá' ? ['ice'] : [])
  ];
  toConsume.forEach(k => {
    if(qty(k) > 0) consume(k);
    else if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant(k);
  });
  
  const sugarN = (o.sugar === 0 ? 0 : o.sugar === 30 ? 1 : o.sugar === 50 ? 2 : o.sugar === 70 ? 3 : 4);
  const iceN = (o.ice === 'Không đá' ? 0 : o.ice === 'Ít đá' ? 1 : 2);
  const mine = cup;
  cup = newCup();
  Object.assign(cup, {
    base: o.base, flav: o.flav || null, tops: [...o.tops],
    cheese: !!o.cheese, sugar: o.sugar, ice: o.ice,
    sugarN, iceN, fill: .8, used: true, size: o.size, staff: true
  });
  
  const revBefore = (R.today ? R.today.rev : 0);
  serve(i);
  const revDelta = Math.max(0, (R.today ? R.today.rev : 0) - revBefore);
  
  R.crushAutoServedCount = (R.crushAutoServedCount || 0) + 1;
  R.crushAutoEarned = (R.crushAutoEarned || 0) + revDelta;
  
  cup = mine;
  renderCup();
  renderPanel();
  updateCrushAutoSellLiveBanner();
}

function crushAutoServeOnline(c, idx){
  if(!c || !c.order) return;
  const o = c.order;
  useStaffCup();
  const toConsume = [
    o.base,
    ...(o.flav ? [o.flav] : []),
    ...o.tops,
    ...(o.cheese ? ['cheese'] : []),
    ...(level() >= 2 && o.sugar && o.sugar > 0 ? ['sugar'] : []),
    ...(level() >= 2 && o.ice && o.ice !== 'Không đá' ? ['ice'] : [])
  ];
  toConsume.forEach(k => {
    if(qty(k) > 0) consume(k);
    else if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant(k);
  });
  const mine = cup;
  cup = newCup();
  Object.assign(cup, {
    base: o.base, flav: o.flav || null, tops: [...o.tops],
    cheese: !!o.cheese, sugar: o.sugar, ice: o.ice,
    fill: .8, used: true, size: o.size, staff: true
  });
  const revBefore = (R.today ? R.today.rev : 0);
  serveOnline(idx);
  const revDelta = Math.max(0, (R.today ? R.today.rev : 0) - revBefore);
  R.crushAutoServedCount = (R.crushAutoServedCount || 0) + 1;
  R.crushAutoEarned = (R.crushAutoEarned || 0) + revDelta;
  cup = mine;
  renderCup();
  renderPanel();
  updateCrushAutoSellLiveBanner();
}

function crushAutoBaristaTick(dt){
  const cm = $('codam-modal');
  if(!R || !R.running || R.closing || !cm || cm.hidden) return;
  
  R.crushAutoTimer = (R.crushAutoTimer || 0) - dt;
  if(R.crushAutoTimer > 0) return;
  R.crushAutoTimer = 1.6;
  
  const sorted = (R.slots || []).map((c, i) => ({ c, i }))
    .filter(x => x.c && x.c.cups && x.c.cups.some((o, k) => !x.c.done[k]))
    .sort((a, b) => a.c.id - b.c.id);
    
  for(const item of sorted){
    const c = item.c;
    if(R.gzWork && R.gzWork.cId === c.id) continue;
    if(R.svWork && R.svWork.cId === c.id) continue;
    if(typeof isStaff2WorkingOn === 'function' && isStaff2WorkingOn(c.id)) continue;
    
    crushAutoServeOne(c, item.i);
    return;
  }
  
  if(R.online && R.online.length > 0){
    const onlIdx = R.online.findIndex(c => c && !c.done && !isSto(c));
    if(onlIdx >= 0){
      crushAutoServeOnline(R.online[onlIdx], onlIdx);
      return;
    }
  }
}

window.onCloseMilkTeaCrush = function(){
  if(R && R.running && (R.crushAutoServedCount > 0 || R.crushAutoEarned > 0)){
    toast(`🍬 Tự động bán nước khi chơi kẹo: Đã phục vụ +${R.crushAutoServedCount} ly, thu về +${fmt(R.crushAutoEarned)}! ✨🎉`, 4500, 1);
    R.crushAutoServedCount = 0;
    R.crushAutoEarned = 0;
  }
  const isShiftTimeUp = (R && (R.isNightShift ? R.nightT <= 0 : R.t <= 0));
  const hasWaitingCust = R && ((R.slots && R.slots.some(Boolean)) || (R.online && R.online.length > 0));
  if(R && R.running && (R.closing || isShiftTimeUp) && !hasWaitingCust){
    R.closing = true;
    R.closingTimer = 0;
  }
};

