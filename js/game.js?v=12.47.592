    console.log('[SafeRecovery] Khởi động an toàn thành công!');
  } catch(e) {
    console.error('[SafeRecovery] Lỗi trong chế độ an toàn:', e);
  }
};

try {
  window.tsHostOk = () => true;
  let had = false;
  try {
    had = load();
  } catch(e) {
    console.error('Lỗi khi nạp dữ liệu save game:', e);
    S = (typeof fresh === 'function') ? fresh() : {};
  }
  if(S && S.sell && S.sell.L > safeMax('L')) S.sell.L = safeMax('L');
  R.today = { stars: [] };
  try { document.title = shopName(); } catch(e){}
  try { renderPrep(); } catch(e) { console.error('Lỗi renderPrep:', e); }
  try { musSync(); } catch(e){}
  try { if(typeof updateMiniScale === 'function') updateMiniScale(); } catch(e){}
  
  let _lastVer=null;try{_lastVer=localStorage.getItem('tsVer');localStorage.setItem('tsVer',GAME_VERSION)}catch(e){}
  let _seenV11=false;try{_seenV11=localStorage.getItem('tsSeenV11_box')}catch(e){}
  let _fromClassic = location.search.includes('from=classic');
  try {
    if (!_fromClassic && (sessionStorage.getItem('fromClassic') === '1' || localStorage.getItem('fromClassic') === '1')) {
      _fromClassic = true;
    }
    sessionStorage.removeItem('fromClassic');
    localStorage.removeItem('fromClassic');
  } catch(e) {}
  if (_fromClassic) {
    try { history.replaceState(null, '', location.pathname); } catch(e) {}
    const b = typeof $ === 'function' ? $('spBanner') : document.getElementById('spBanner');
    if (b) b.style.display = 'none';
    const sp = typeof $ === 'function' ? $('splash') : document.getElementById('splash');
    if (sp) {
      sp.hidden = true;
      sp.style.display = 'none';
      sp.innerHTML = '';
    }
    closeSplash();
    if (typeof renderPrep === 'function') renderPrep();
    if (had && S && S.day > 1 && S.lastBreakDay !== S.day) {
      setTimeout(() => checkEquipBreakdown(), 400);
    }
  } else {
    try {
      showSplash(had,()=>{
        if(had && S && S.day > 1 && S.lastBreakDay !== S.day){
          setTimeout(() => checkEquipBreakdown(), 400);
        }
      });
    } catch(e) {
      console.error('Lỗi showSplash:', e);
      if (typeof renderPrep === 'function') renderPrep();
    }
  }
} catch(fatalInitErr) {
  console.error('Lỗi nghiêm trọng khi khởi động game:', fatalInitErr);
  if (typeof window.initSafeRecovery === 'function') window.initSafeRecovery();
}

/* Tự động kiểm tra cập nhật phiên bản mới từ server */
async function autoSyncVersion(){
  if(typeof R !== 'undefined' && (R.running || R.mode === 'sell' || R.closing)) return;
  if(!location.protocol.startsWith('http')) return;
  if(window._tsReloadLock) return;

  // Kiểm tra quyền ghi Storage (tránh lặp vô tận trên Safari Private / Incognito)
  let canWrite = false;
  try {
    const k = '__ts_storage_test__';
    localStorage.setItem(k, '1');
    localStorage.removeItem(k);
    canWrite = true;
  } catch(e){
    canWrite = false;
  }
  if(!canWrite) {
    console.log('[AutoSync] Trình duyệt đang ở chế độ hạn chế Storage (Private/Incognito), huỷ auto reload để tránh lặp vô tận.');
    return;
  }

  try{
    const r = await fetch('version.json', { cache: 'no-store' });
    if(!r.ok) return;
    const d = await r.json();
    if(d && d.version && d.version !== GAME_VERSION){
      console.log('🔄 Phát hiện phiên bản mới từ server:', d.version, 'Bản đang chạy:', GAME_VERSION);
      try { localStorage.setItem('ts_app_version', d.version); } catch(e){}
      // Nếu đang trong game hoặc đã bắt đầu chơi, không ép reload đột ngột để tránh gián đoạn ca bán
      if(typeof R !== 'undefined' && (R.running || R.mode === 'sell' || R.closing || (S && S.day > 1))){
        console.log('Đang trong phiên chơi, bảo toàn tiến trình không reload.');
        return;
      }
      const syncKey = 'ts_last_sync_ver_' + d.version;
      const lastSyncTime = parseInt(localStorage.getItem(syncKey) || '0', 10);
      if(Date.now() - lastSyncTime < 10 * 60 * 1000) {
        console.log('Đã thử đồng bộ bản', d.version, 'gần đây, không lặp lại reload.');
        return;
      }
      window._tsReloadLock = true;
      localStorage.setItem(syncKey, Date.now().toString());
      await forceGlobalAppUpdate();
    }
  }catch(e){}
}
autoSyncVersion();

/* Đồng hồ đếm ngược thời gian online game cho tính năng Bạn Bè & Rương Tiếp Tế */
setInterval(()=>{
  if(typeof document!=='undefined'&&!document.hidden&&window.S&&window.BanBe&&typeof window.BanBe.tickOnlineTime==='function'){
    window.BanBe.tickOnlineTime(1);
  }
},1000);




document.addEventListener('DOMContentLoaded', ()=>{
  if(typeof renderDesktopSidebars === 'function') renderDesktopSidebars();
  if(typeof updateMiniScale === 'function') updateMiniScale();
  window.addEventListener('resize', ()=>{
    if(typeof updateMiniScale === 'function') updateMiniScale();
    if(typeof renderDesktopSidebars === 'function') renderDesktopSidebars();
  });
  window.addEventListener('orientationchange', ()=>{
    setTimeout(()=>{
      if(typeof updateMiniScale === 'function') updateMiniScale();
    }, 200);
  });
});

/* =========================================================================
 * 🖥️ COMPANION SIDEBARS (MẠNG XÃ HỘI & ĐÁNH GIÁ) VÀ CHẾ ĐỘ CỬA SỔ NHỎ
 * ========================================================================= */
function openMiniWindow(){
  const w = 450;
  const h = 880;
  const left = Math.max(0, Math.floor((screen.availWidth - w) / 2));
  const top = Math.max(0, Math.floor((screen.availHeight - h) / 2));
  let cleanBase = window.location.href.split('?')[0].split('#')[0];
  let url = cleanBase + '#mini=1';
  const win = window.open(url, 'TiemTraMoUoc_Popout_' + Date.now(), `width=${w},height=${h},left=${left},top=${top},resizable=yes,scrollbars=no,status=no,toolbar=no,menubar=no,location=no`);
  if(win){
    win.focus();
    toast('Đã mở game ở cửa sổ nhỏ! 🪟✨ Bạn có thể kéo to/nhỏ cửa sổ tùy ý, game sẽ tự động scale theo.', 3500);
  } else {
    toast('Trình duyệt đang chặn Pop-up. Vui lòng cho phép Pop-up trên trang để mở cửa sổ nhỏ!', 4000);
  }
}
window.openMiniWindow = openMiniWindow;

function isMiniWindowMode(){
  if(window.location.hash.includes('mini=1') || window.location.search.includes('mini=1')) return true;
  if(window.name && window.name.includes('Popout')) return true;
  if(window.opener && window.innerWidth < 700) return true;
  // Khi chơi trên máy tính mà khung màn hình bị thu nhỏ <= 460px:
  if(!('ontouchstart' in window) && window.innerWidth <= 460) return true;
  return false;
}

var MINI_BASE_W = 430;
var MINI_BASE_H = 860;

function updateMiniScale(){
  const scaler = $('appScaler');
  if(!scaler) return;

  const baseW = MINI_BASE_W || 430;
  const baseH = MINI_BASE_H || 860;
  const isMini = isMiniWindowMode();
  if(!isMini){
    document.body.classList.remove('mini-window-active');
    scaler.style.transform = '';
    scaler.style.width = '';
    scaler.style.height = '';
    scaler.style.minWidth = '';
    scaler.style.minHeight = '';
    scaler.style.maxWidth = '';
    scaler.style.maxHeight = '';
    scaler.style.position = '';
    scaler.style.left = '';
    scaler.style.top = '';
    scaler.style.margin = '';
    scaler.style.transformOrigin = '';
    return;
  }

  document.body.classList.add('mini-window-active');

  const vw = window.innerWidth;
  const vh = window.innerHeight;

  // Tính toán tỉ lệ scale theo tỉ lệ chéo (uniform aspect-fit scaling)
  const scale = Math.min(vw / baseW, vh / baseH);

  scaler.style.position = 'relative';
  scaler.style.width = baseW + 'px';
  scaler.style.height = baseH + 'px';
  scaler.style.minWidth = baseW + 'px';
  scaler.style.minHeight = baseH + 'px';
  scaler.style.maxWidth = baseW + 'px';
  scaler.style.maxHeight = baseH + 'px';
  scaler.style.left = 'auto';
  scaler.style.top = 'auto';
  scaler.style.margin = '0';
  scaler.style.transformOrigin = 'center center';
  scaler.style.transform = `scale(${scale})`;

  if(R && R.mode === 'sell' && typeof q3fit === 'function'){
    q3fit();
  }
}
window.updateMiniScale = updateMiniScale;

var _desktopRevFilter = 'all';

function renderDesktopLeftMxh(){
  const bodyEl = $('desktopSidebarLeftBody');
  if(!bodyEl) return;
  if(!window.S) return;
  initExtraState();

  const curShopName = (typeof shopName === 'function' ? shopName() : (S && S.shopName) || 'Tiệm Trà Mơ Ước');
  const followers = (S.mxh && S.mxh.followers) || 120;
  const avgR = rating();
  const revCountVal = (S.reviews || []).length;
  const activeAds = Array.isArray(S.mxh && S.mxh.activeAds) ? S.mxh.activeAds.filter(a => a && a.id) : [];
  const isAnyCampaignRunning = activeAds.length > 0;
  const adsTrafficBoost = activeAds.reduce((acc, a) => acc + (a && a.boost || 0), 0);
  const isVerified = (followers >= 50000 && avgR >= 4.5);

  if(!S.mxh.posts || !S.mxh.posts.length){
    S.mxh.posts = getDefaultTikTokPosts(curShopName);
  }
  const posts = S.mxh.posts.slice(0, 15);

  let html = `
    <!-- Thẻ Hồ Sơ Quán -->
    <div class="desktop-profile-card">
      <div class="desktop-profile-top">
        <div class="desktop-profile-avatar">🧋</div>
        <div class="desktop-profile-meta">
          <div class="desktop-profile-name" title="${esc(curShopName)}">${esc(curShopName)}</div>
          ${isVerified ? '<span class="desktop-badge verified">✓ Tích Xanh Official</span>' : '<span class="desktop-badge">🌱 Đang xây kênh</span>'}
        </div>
      </div>
      <div class="desktop-stats-row">
        <div class="desktop-stat-cell">
          <b style="color:#0284c7;">${fmtFollowers(followers)}</b>
          <small>Followers</small>
        </div>
        <div class="desktop-stat-cell">
          <b style="color:#eab308;">${avgR.toFixed(1)} ★</b>
          <small>${revCountVal} review</small>
        </div>
        <div class="desktop-stat-cell">
          <b style="color:#10b981;">+${Math.round(adsTrafficBoost * 100)}%</b>
          <small>Buff Ads</small>
        </div>
      </div>
    </div>

    <!-- Trạng thái Quảng Cáo -->
    <div class="desktop-ad-card ${isAnyCampaignRunning ? 'active' : ''}">
      ${isAnyCampaignRunning ? `
        <div class="desktop-ad-title">📢 Chiến dịch đang chạy:</div>
        <div class="desktop-ad-info">
          <b>${activeAds[0].icon || '📢'} ${esc(activeAds[0].name)}</b>: Còn ${activeAds[0].daysLeft} ngày (+${Math.round((activeAds[0].boost || 0) * 100)}% khách chính · +${Math.round(((ADS_CAMPAIGNS.find(x => x && x.id === activeAds[0].id) && ADS_CAMPAIGNS.find(x => x && x.id === activeAds[0].id).branchBoost != null) ? ADS_CAMPAIGNS.find(x => x && x.id === activeAds[0].id).branchBoost : (activeAds[0].branchBoost != null ? activeAds[0].branchBoost * 0.8 : (activeAds[0].boost ? activeAds[0].boost * 0.48 : 0.12))) * 100)}% chi nhánh)
        </div>
      ` : `
        <div style="font-size:0.78rem;color:var(--soft);margin-bottom:6px;">Chưa chạy chiến dịch quảng cáo</div>
        <button type="button" class="desktop-action-btn" onclick="switchTab('mxh')">📢 Chạy quảng cáo kéo khách</button>
      `}
    </div>

    <div class="desktop-section-lbl"><span>🔥</span> <b>Bảng Tin Cộng Đồng</b></div>

    <!-- Danh sách bài đăng MXH -->
    <div style="display:flex;flex-direction:column;gap:8px;">
      ${posts.map((post, idx) => {
        const isFlop = !!post.isFlop;
        return `
          <div class="desktop-feed-card" data-post-idx="${idx}">
            <div class="desktop-feed-head">
              <span class="desktop-feed-avt">${post.avt || '🧑'}</span>
              <span class="desktop-feed-author">${esc(post.author || 'Khách Hàng')}</span>
              <span class="desktop-feed-badge" ${isFlop ? 'style="background:#fee2e2;color:#b91c1c;"' : ''}>${esc(post.badge || 'Khách Hàng')}</span>
            </div>
            <div class="desktop-feed-text">${esc(post.content || '')}</div>
            <div class="desktop-feed-actions">
              <button type="button" class="desktop-feed-like ${post.liked ? 'liked' : ''}" data-desktop-like="${idx}">
                ${post.liked ? '❤️' : '🤍'} <b>${fmtFollowers(post.likes || 0)}</b>
              </button>
              <small style="color:var(--soft);font-size:0.68rem;">💬 ${(post.replies || []).length} cmt</small>
            </div>
            ${(post.replies && post.replies.length) ? `
              <div style="display:flex;flex-direction:column;gap:3px;margin-top:2px;">
                ${post.replies.map(r => `<div class="desktop-feed-reply-item"><b>${esc(curShopName)}:</b> ${esc(r)}</div>`).join('')}
              </div>
            ` : ''}
          </div>
        `;
      }).join('')}
    </div>
  `;

  bodyEl.innerHTML = html;

  // Gắn sự kiện click like
  bodyEl.querySelectorAll('[data-desktop-like]').forEach(btn => {
    btn.onclick = () => {
      const idx = +btn.dataset.desktopLike;
      const post = S.mxh.posts[idx];
      if(post){
        if(post.isFlop){
          post.isFlop = false;
          post.liked = true;
          post.views = Math.floor(25000 + Math.random() * 30000);
          post.likes = Math.floor(1800 + Math.random() * 2500);
          post.replies = post.replies || [];
          post.replies.push(`💖 Sếp Tổng đã thả tim giải cứu! Video đã bùng nổ lên ${fmtFollowers(post.views)} views! 🥰🎉`);
          S.mxh.followers = (S.mxh.followers || 120) + 800;
          save(); sfx('win');
          toast(`🎉 CỨU TƯƠNG TÁC THÀNH CÔNG! Đã thả tim giải cứu bài đăng!`);
        } else {
          post.liked = !post.liked;
          post.likes = (post.likes || 0) + (post.liked ? 1 : -1);
          sfx('tap');
        }
        save();
        renderDesktopLeftMxh();
      }
    };
  });
}

function renderDesktopRightReviews(){
  const bodyEl = $('desktopSidebarRightBody');
  if(!bodyEl) return;
  if(!window.S) return;
  if(!Array.isArray(S.reviews)) S.reviews = [];

  const avgR = rating();
  const all = (S.reviews || []).filter(Boolean);
  const rawCnt = [5, 4, 3, 2, 1].map(s => all.filter(x => x.s === s).length);
  const totalRev = all.length;

  const isResetMilestone = x => !!(x && (x.isMilestoneReset || (x.k && String(x.k).startsWith('cycle_milestone'))));
  const list = all.map((x, i) => [x, i]).filter(([x]) => {
    if(_desktopRevFilter === 'all') return true;
    if(_desktopRevFilter === 'nr') return !x.rp && !isResetMilestone(x);
    return x.s === +_desktopRevFilter;
  });

  let html = `
    <!-- Bảng điểm tổng quan -->
    <div class="desktop-rev-summary">
      <div class="desktop-rev-score">
        <b>${avgR.toFixed(1).replace('.', ',')}</b>
        <div class="desktop-rev-stars">${'★'.repeat(Math.min(5, Math.max(1, Math.round(avgR))))}${'☆'.repeat(Math.max(0, 5 - Math.round(avgR)))}</div>
        <small>${totalRev} đánh giá</small>
      </div>
      <div class="desktop-rev-bars">
        ${[5, 4, 3, 2, 1].map((s, i) => {
          const cnt = rawCnt[i];
          const pct = totalRev ? Math.round((cnt / totalRev) * 100) : 0;
          return `
            <div class="desktop-rev-bar-row">
              <span style="width:16px;">${s}★</span>
              <div class="desktop-bar-track"><div class="desktop-bar-fill" style="width:${pct}%"></div></div>
              <span style="width:24px;text-align:right;">${cnt}</span>
            </div>
          `;
        }).join('')}
      </div>
    </div>

    <!-- Bộ lọc đánh giá -->
    <div class="desktop-flt-chips">
      ${[['all', 'Tất cả'], [5, '5★'], [4, '4★'], [3, '3★'], [2, '2★'], [1, '1★'], ['nr', 'Chưa trả lời']].map(([val, label]) => `
        <button type="button" class="desktop-chip ${_desktopRevFilter === String(val) ? 'on' : ''}" data-rev-filter="${val}">${label}</button>
      `).join('')}
    </div>

    <!-- Danh sách đánh giá -->
    <div style="display:flex;flex-direction:column;gap:8px;">
      ${list.length ? list.slice(0, 30).map(([x, gi]) => {
        const isGood = x.s >= 4;
        const isBad = x.s <= 2;
        const cupThumb = (x.b && typeof cupHTML === 'function') ? cupHTML({
          base: x.b,
          flav: x.fl,
          tops: (x.tp || []).filter(Boolean),
          cheese: !!x.ch,
          size: x.sz || 'M'
        }, 30) : '';

        return `
          <div class="desktop-rev-card ${isBad ? 'bad' : isGood ? 'good' : ''}">
            <div class="desktop-rev-head">
              <span class="desktop-rev-user"><b>${esc(x.n || 'Khách hàng')}</b> ${(typeof x.f === 'string' && /^b\d+$/.test(x.f)) ? `<img src="${IMG}brand/${x.f}.png" alt="" style="width:20px;height:20px;border-radius:50%;object-fit:contain;vertical-align:middle;margin-left:4px;">` : (x.f || '😎')}</span>
              <span class="desktop-rev-rating">${'★'.repeat(x.s || 5)}</span>
            </div>
            ${cupThumb ? `
              <div class="desktop-rev-cup-row">
                <span class="rcup" style="display:inline-flex;transform:scale(0.85);transform-origin:left center;">${cupThumb}</span>
                <small>${ITEMS[x.b] ? ITEMS[x.b].n : 'Ly trà'}</small>
              </div>
            ` : ''}
            <div class="desktop-rev-text">"${esc(x.t || '')}"</div>

            ${x.mktRep ? `
              <div class="desktop-rev-sub mkt">
                <b>📢 Me két tinh:</b> ${esc(x.mktRep)}
              </div>
            ` : ''}

            ${x.rp ? `
              <div class="desktop-rev-sub owner">
                <b>👑 Chủ tiệm:</b> ${esc(x.rp)}
              </div>
            ` : `
              <div style="text-align:right;margin-top:2px;">
                <button type="button" class="desktop-reply-btn" data-reply-dlg="${gi}">👑 Phản hồi khách</button>
              </div>
            `}

            ${x.crp ? `
              <div class="desktop-rev-sub cust">
                <b>💬 Khách phản hồi lại:</b> ${esc(x.crp)}
              </div>
            ` : ''}
          </div>
        `;
      }).join('') : `
        <div style="text-align:center;padding:24px 10px;color:var(--soft);font-size:0.8rem;">
          ⭐ Chưa có đánh giá nào phù hợp bộ lọc.
        </div>
      `}
    </div>
  `;

  bodyEl.innerHTML = html;

  // Gắn sự kiện lọc
  bodyEl.querySelectorAll('[data-rev-filter]').forEach(btn => {
    btn.onclick = () => {
      _desktopRevFilter = btn.dataset.revFilter;
      renderDesktopRightReviews();
    };
  });

  // Gắn sự kiện nút phản hồi
  bodyEl.querySelectorAll('[data-reply-dlg]').forEach(btn => {
    btn.onclick = () => {
      const idx = +btn.dataset.replyDlg;
      if(typeof replyDlg === 'function') replyDlg(idx);
    };
  });
}

function renderDesktopSidebars(){
  return;
}
window.renderDesktopSidebars = renderDesktopSidebars;


/* =========================================================================
   🍵 TÍCH HỢP TRỰC TIẾP TIỆM TRÀ NHỎ (BẢN HOÀI NIỆM - DƯ VỊ CỦA CƠN SAY)
   - Điều hướng trang trực tiếp, không nhúng iframe để tránh bị chặn kết nối (frame-ancestors / X-Frame-Options)
   - Tự động lưu tiến trình game trước khi chuyển đổi
   - Vào thẳng quầy bán của mỗi phiên bản khi chuyển qua lại
   ========================================================================= */

function openClassicGame() {
  try {
    // 1. Ẩn modal Lời nhắn DEV nếu đang hiển thị
    const banner = $('spBanner');
    if (banner) banner.style.display = 'none';

    // 2. Lưu trạng thái game hiện tại của Tiệm Trà Mơ Ước
    if (typeof save === 'function') save();

    // 3. Tạm dừng ca bán nếu Tiệm Trà Mơ Ước đang mở bán
    if (typeof R !== 'undefined' && R && R.running && !R.paused) {
      R.paused = true;
      R._pausedByClassic = true;
      if (typeof timer !== 'undefined') clearInterval(timer);
    }

    // 4. Dừng âm thanh trước khi chuyển trang
    try {
      if (typeof bgmAudio !== 'undefined' && bgmAudio) bgmAudio.pause();
    } catch(e) {}
    try {
      if (typeof pourSnd === 'function') pourSnd(false);
    } catch(e) {}
    try {
      if (typeof AU !== 'undefined' && AU && AU.ctx && AU.ctx.state === 'running') {
        AU.ctx.suspend().catch(() => {});
      }
    } catch(e) {}

    try {
      sessionStorage.setItem('fromDream', '1');
      localStorage.setItem('fromDream', '1');
    } catch(e) {}
    // 5. Điều hướng trực tiếp sang trang Tiệm Trà Nhỏ (URL sạch không query param)
    window.location.href = 'tiemtranhosrc.html';
  } catch(err) {
    console.error('Lỗi khi mở Tiệm Trà Nhỏ:', err);
    if (typeof toast === 'function') {
      toast('Không thể mở bản Tiệm Trà Nhỏ: ' + (err && err.message));
    }
  }
}

function closeClassicGame() {
  try {
    if (typeof save === 'function') save();
  } catch(e) {}
  try {
    sessionStorage.setItem('fromClassic', '1');
    localStorage.setItem('fromClassic', '1');
  } catch(e) {}
  if (!location.pathname.includes('index.html') && location.pathname !== '/' && !location.pathname.endsWith('/')) {
    window.location.href = 'index.html';
  }
}

// Lắng nghe sự kiện postMessage từ cửa sổ khác nếu có
if (!window._classicMsgListenerBound) {
  window._classicMsgListenerBound = true;
  window.addEventListener('message', function(ev) {
    if (ev.data && ev.data.type === 'CLOSE_CLASSIC_GAME') {
      closeClassicGame();
    }
  });
}

window.openClassicGame = openClassicGame;
window.closeClassicGame = closeClassicGame;
