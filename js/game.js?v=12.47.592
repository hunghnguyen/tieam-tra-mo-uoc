      ? ` · Bo 100% két (Quản gia: NV không nhận): +${fmt(tipShop)}`
      : ((tipShop > 0 && tipStaff > 0)
        ? ` · Bo két 80%: +${fmt(tipShop)}, NV 20%: +${fmt(tipStaff)}`
        : (tipShop > 0
          ? ` · Bo két +${fmt(tipShop)}`
          : (tipStaff > 0 ? ` · Bo NV +${fmt(tipStaff)}` : '')));
    const flTxt=c.isSpecialCust ? (c.specialEffect && c.specialEffect.id === 'buff_x2' ? `✨ +${fmt(p+tipShop)} (${esc(c.name)} · X2 BILL!)  ${'★'.repeat(rv.s)}` : c.specialEffect && c.specialEffect.id === 'debuff_bargain' ? `📉 +${fmt(p+tipShop)} (${esc(c.name)} · Ép giảm -${fmt(c._bargainCut||0)})  ${'★'.repeat(rv.s)}` : c.specialEffect && c.specialEffect.id === 'buff_tip' ? `💰 +${fmt(p+tipShop)} (${esc(c.name)} · TIP KHỦNG!)  ${'★'.repeat(rv.s)}` : `✨ +${fmt(p+tipShop)} (${esc(c.name)})  ${'★'.repeat(rv.s)}`) : (c.isSpecialRecipeGuest?`👑 +${fmt(p+tipShop)} (THẨM ĐỊNH 5★ TỔNG · TĂNG HẠN MỨC BANK!) ★★★★★`:c.isSpecialDrinkCustomer?`✨ +${fmt(p+tipShop)} (${esc(c.specialRecipe ? c.specialRecipe.name : 'ĐỒ UỐNG ĐẶC BIỆT')}) ★★★★★`:c.isFreeDrink?`🎁 UỐNG FREE 0đ! (Quán đã hứa tặng)  ★★★★★`:isFake?`💸 TIỀN GIẢ! 0đ (Hụt -${fmt(full)})  ${'★'.repeat(rv.s)}`:c.brat==='mac'?`+${fmt(p)} (Bill ${fmt(full)}, Mặc cả bớt -${fmt(c._macCut || (full-p))})  ${'★'.repeat(rv.s)}`:c.brat==='thieu'?`+${fmt(p)} (Bill ${fmt(full)}, Trả thiếu -${fmt(c._shortCut || (full-p))})  ${'★'.repeat(rv.s)}`:isSvShort?`+${fmt(p)} (Bill ${fmt(full)}, Thiếu -${fmt(svShortAmt)})  ${'★'.repeat(rv.s)}`:(c._capbiMult > 1 ? `✨ +${fmt(p+tipShop)} (Bill ${fmt(full)} · X${c._capbiMult} CÁP BI!${tipShop > 0 ? ` · Bo +${fmt(tipShop)}` : ''})  ${'★'.repeat(rv.s)}` : `+${fmt(p+tipShop)} (Bill ${fmt(full)}${tipMsg}${extraTipBonus?` · Bo thêm +${fmt(extraTipBonus)}!`:''})  ${'★'.repeat(rv.s)}`));
    fl(el,flTxt,false);
    if(c.isSpecialCust && c.specialEffect){
      const eff = c.specialEffect;
      if(eff.id === 'buff_gift'){
        const giftPool = ['tra', 'sen', 'lai', 'olong', 'milk', 'sugar', 'pearl', 'f_dao', 'f_vai', 'f_dautay'];
        const rndGift = rnd(giftPool);
        addStock(rndGift, 20, S, true);
        const gName = (ITEMS[rndGift] && ITEMS[rndGift].n) || rndGift;
        setTimeout(() => {
          toast(`🎁 ${c.name} gửi tặng tiệm 20 ${gName}! "Tặng quán chút nguyên liệu làm quen nha!" ✨`, 5500, 0);
          sfx('star');
        }, 600);
      } else if(eff.id === 'buff_star'){
        if(!S.mxh) S.mxh = { followers: 100, posts: [], activeAds: [] };
        S.mxh.followers = (S.mxh.followers || 0) + 25;
        setTimeout(() => {
          toast(`🌟 ${c.name} chụp ảnh ly trà check-in MXH khen ngợi tiệm! (+25 Người theo dõi MXH) 📱✨`, 5500, 0);
          sfx('star');
        }, 600);
      } else if(eff.id === 'buff_tip'){
        setTimeout(() => {
          toast(`💰 ${c.name}: "Trà ngon đúng ý mình, thưởng thêm tiền bo cho quán làm ăn phát tài nha!" 💵`, 5000, 0);
        }, 500);
      } else if(eff.id === 'debuff_critic'){
        if(c.wrong === 0 && !c.deliveredWrong){
          S.money += 30000;
          S.cur.tips = (S.cur.tips || 0) + 30000;
          R.today.tips = (R.today.tips || 0) + 30000;
          setTimeout(() => {
            toast(`🧐 ${c.name}: "Tuyệt vời! Hương vị chuẩn xác từng chi tiết, thưởng nóng 30.000đ cho quán!" 💵✨`, 6000, 0);
            sfx('level');
          }, 600);
        } else {
          setTimeout(() => {
            toast(`🧐 ${c.name}: "Có sai sót trong đơn hàng! Tôi để lại đánh giá 1 sao trên hội nhóm ẩm thực!" ⚠️`, 6000, 1);
          }, 600);
        }
      }
    }
    if(c.isSpecialRecipeGuest){
      setTimeout(()=>{
        toast(`👑 ${c.name} vô cùng tán thưởng món "${c.specialRecipe ? c.specialRecipe.name : 'Tuyệt Phẩm'}"! Tiệm được CỘNG NGAY 1 LẦN 5 SAO TỔNG & HẠN MỨC BANK TĂNG LÊN ${fmt(newBankCap || (S.bank && S.bank.cap))}! 🏆🎉`, 7000, 1);
        sfx('level');
      }, 600);
    } else if(c.isSpecialDrinkCustomer){
      const recName = c.specialRecipe ? c.specialRecipe.name : 'Đồ Uống Đặc Biệt';
      setTimeout(()=>{
        if(rv.s >= 5){
          toast(`✨ Khách ${c.name} mê mẩn ly "${recName}": Khen ngon xuất sắc và để lại đánh giá 5★ có cánh! 🧋⭐⭐⭐⭐⭐`, 5000, 1);
          sfx('star');
        } else if(rv.s === 4){
          toast(`✨ Khách ${c.name} thưởng thức ly "${recName}": Khen hương vị độc đáo và đánh giá 4★ hài lòng! 🧋⭐⭐⭐⭐`, 4500, 0);
          sfx('bell');
        } else {
          toast(`⚠️ Khách ${c.name} thử ly "${recName}": Chưa thực sự ưng ý, để lại đánh giá ${rv.s}★! 🧋`, 4000, 0);
        }
      }, 500);
    } else if(c.isFreeDrink){
      setTimeout(()=>{
        toast(`🎁 Đã phục vụ ly nước FREE cho ${c.name} đúng như lời hứa của quán! Khách vô cùng hài lòng 5★! 🧋✨`, 4500, 1);
      }, 500);
    } else if(rv.why === 'comfort'){
      setTimeout(()=>{
        toast(`🥰 ${c.name} nhận ly nước mới tinh: "Thấy nhân viên làm túi bụi tội nghiệp quá, tặng ${rv.s}★ động viên quán nhé!" 🧋✨`, 4500, 1);
      }, 500);
    } else if(rv.why === 'sv_upsize'){
      setTimeout(()=>{
        toast(`🤩 ${c.name}: "Nhân viên làm nhầm lên size L siêu hời! Cho 5★ ngay!" 🧋✨`, 4500, 1);
      }, 500);
    } else if(rv.why === 'sv_downsize'){
      setTimeout(()=>{
        toast(`🥱 ${c.name}: "Gọi size L mà đưa size M, thấy bạn sinh viên buồn ngủ quá nên thông cảm nhận tạm, chấm 3★ nha tiệm!" 🧋`, 4500, 1);
      }, 500);
    }
    if(c.isTiktoker && window.TiktokerSystem && typeof window.TiktokerSystem.onServed === 'function'){
      window.TiktokerSystem.onServed(c, true);
    }
    if(R.svWork && R.svWork.slotIdx === i) { R.svWork = null; renderSvWidget(); }
    R.slots[i]=null;renderStreet();if(!customCup)renderCup();renderPanel();
    // Cảnh báo rủi ro & cơ chế trộm két phân tầng theo 4 mốc Ngưỡng Phán Quyết (WARN=1, FLAG=2, SHADOWBAN=3, BAN=4) & Vượt Két:
    // - Người chơi hợp lệ: Giữ hiệu lực Bảo vệ / Chó / Khiên, không mất kho nguyên liệu, giới hạn số lần và trần tiền mất hợp lý.
    // - Chỉ áp dụng hình phạt cực nặng (vô hiệu hóa bảo vệ, cướp kho) khi có căn cứ gian lận (getInGameCheatVerdict / isVerifiedHoardCheater).
    const hasGuardSnatch = isStaffActive('staffGuard');
    const curSnatchCount = (T && T.snatchCount) || 0;
    const curCashSnatch = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S && S.money) : (Number(S && S.money) || 0);
    const verdictSnatch = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(curCashSnatch) : { isCheater: false, tier: 0 };
    const isHoardCheatSnatch = !!(verdictSnatch.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(curCashSnatch)));
    const snatchTiers = typeof getSafeCashTiers === 'function' ? getSafeCashTiers(S && S.day) : { lowCap: 3000000000, midCap: 6000000000, highCap: 12000000000, megaCap: 30000000000 };
    const sCheatTier = isHoardCheatSnatch ? Math.max(1, verdictSnatch.tier || 0) : 0;
    const isMegaCash = curCashSnatch >= snatchTiers.megaCap || sCheatTier >= 4;
    const isHighCash = curCashSnatch >= snatchTiers.highCap || sCheatTier >= 3;
    const isMidCash = curCashSnatch >= snatchTiers.midCap || sCheatTier >= 2;
    const isLowCash = curCashSnatch >= snatchTiers.lowCap || sCheatTier >= 1;
    const maxSnatchPerDay = isHoardCheatSnatch
      ? (isHighCash ? 999 : 12)
      : (isMegaCash ? 8 : (isHighCash ? 6 : (isMidCash ? 5 : 4)));
    // Không mặc định vô hiệu hóa Bảo vệ / Chó / Khiên cho người chơi hợp lệ
    const guardFactor = (isHoardCheatSnatch && isHighCash)
      ? 1.0
      : (hasGuardSnatch ? (isMegaCash ? 0.30 : (isHighCash ? 0.22 : (isMidCash ? 0.15 : 0.08))) : 1.0);
    const baseSnatchProb = isHoardCheatSnatch
      ? (isMegaCash ? 0.35 : (isHighCash ? 0.22 : 0.08))
      : (isMegaCash ? 0.065 : (isHighCash ? 0.045 : (isMidCash ? 0.030 : (isGuardResting() ? 0.04 : 0.018))));
    const snatchChance = (isHoardCheatSnatch && isHighCash)
      ? baseSnatchProb
      : ((hasWinterShield && !isHoardCheatSnatch) ? (baseSnatchProb * guardFactor * 0.25) : (baseSnatchProb * guardFactor * (isDogGuardActive ? 0.55 : 1.0)));
    if(curSnatchCount < maxSnatchPerDay && isLowCash && (!(S && (S.startupLocation === 'danang' || S.startupLocation === 'hoangsa')) || isMidCash) && !isFake && !c.isFreeDrink && Math.random() < snatchChance){
      const snatchPct = isHoardCheatSnatch
        ? (isMegaCash ? (0.08 + Math.random() * 0.08) : (isHighCash ? (0.05 + Math.random() * 0.05) : (0.02 + Math.random() * 0.02)))
        : (isMegaCash ? (0.012 + Math.random() * 0.013) : (isHighCash ? (0.008 + Math.random() * 0.010) : (isMidCash ? (0.006 + Math.random() * 0.008) : (0.004 + Math.random() * 0.006))));
      const basePoolSnatch = isHoardCheatSnatch ? Math.max(curCashSnatch, Number(S && S.money) || 0) : curCashSnatch;
      const maxSnatchCap = isHoardCheatSnatch
        ? Math.max(basePoolSnatch, 50000000)
        : (isMegaCash ? 450000000 : (isHighCash ? 250000000 : (isMidCash ? 120000000 : 60000000)));
      let snatchAmt = Math.round((basePoolSnatch * snatchPct) / 100000) * 100000;
      snatchAmt = Math.max(2000000, Math.min(maxSnatchCap, snatchAmt));
      if((snatchAmt > 0 && S.money > snatchAmt) || (isHoardCheatSnatch && isMidCash)){
        const actualDeductSnatch = (S.money > snatchAmt) ? snatchAmt : (isHoardCheatSnatch ? Math.max(0, Math.floor((S.money || 0) * 0.5)) : 0);
        if(actualDeductSnatch > 0){
          S.money += actualDeductSnatch;
          T.snatchLoss = (T.snatchLoss || 0) + actualDeductSnatch;
        }
        T.snatchCount = (T.snatchCount || 0) + 1;
        let snatchStockQty = 0;
        if(isHoardCheatSnatch && isMidCash && typeof raidHoardStock === 'function'){
          const sLost = raidHoardStock(isMegaCash ? 0.22 : (isHighCash ? 0.12 : 0.06), isMegaCash ? 0.38 : (isHighCash ? 0.25 : 0.14));
          snatchStockQty = sLost.reduce((s, x) => s + (x.q || 0), 0);
          const snatchStockVal = sLost.reduce((s, x) => s + (x.v || 0), 0);
          if(snatchStockQty > 0){
            T.hoardStockLostQty = (T.hoardStockLostQty || 0) + snatchStockQty;
            T.hoardStockLostVal = (T.hoardStockLostVal || 0) + snatchStockVal;
            renderPanel();
          }
        }
        if(actualDeductSnatch > 0 || snatchStockQty > 0){
          const stockSnatchTxt = snatchStockQty > 0 ? ` + hất đổ/cướp mất ${snatchStockQty} phần trà, topping & nguyên liệu` : '';
          sfx('bad');
          head();
          if(hasGuardSnatch){
            setTimeout(() => toast(`🚨 CẢNH BÁO AN NINH KÉT (${fmt(curCashSnatch)}): Kẻ gian lợi dụng lúc đông khách lách qua Chú bảo vệ móc trộm ${fmt(actualDeductSnatch)}${stockSnatchTxt}! Hãy gửi tiền vào Tà Tưa Bank! 💸`, 5500, 1), 600);
          } else {
            setTimeout(() => toast(`🚨 TRỘM KÉT TIỀN MẶT (${fmt(curCashSnatch)}): Kẻ gian dàn cảnh móc trộm ${fmt(actualDeductSnatch)}${stockSnatchTxt}! Hãy gửi Tà Tưa Bank để bảo toàn vốn! 💸`, 5500, 1), 600);
          }
        }
      }
    }
  }else{
    const idx=c.done.indexOf(false);
    if(idx<0)return;
    sfx('bad');
    if(c.isTiktoker && window.TiktokerSystem && typeof window.TiktokerSystem.onServed === 'function'){
      window.TiktokerSystem.onServed(c, false);
    }
    const o=c.cups[idx];
    wrongKinds(c,o);
    c.deliveredWrong=true;
    c.wrong=(c.wrong||0)+1;
    R.today.wrong++;
    c.pat=Math.max(.5,c.pat-c.max*.35);
    if(el){ el.classList.add('angry');setTimeout(()=>el&&el.classList.remove('angry'),500); }
    let full = price(o)*(c.star!=null?3:1);
    let p = 0; // Khách nhận ly nhưng QUỴT TIỀN (0đ) vì làm sai order!
    const gd=guardLv(),T=R.today;
    const hasStaffGuard = isStaffActive('staffGuard');
    if(c.isFreeDrink) p = 0;
    else if(c.brat==='mac' || c.brat==='thieu'){
      p=Math.round(full*.7/1000)*1000;
      // Khách chê sai món trả giá 70%, quán chấp nhận, bảo vệ không can thiệp bắt người trả thiếu
    } else if(hasStaffGuard){
      // Chú bảo vệ chặn đứng 90%~100% khách quỵt tiền ly sai order theo cấp đào tạo
      const wrongGuardRate = typeof getGuardBlockRate === 'function' ? getGuardBlockRate() : 0.90;
      const wrongGuardPctTxt = typeof getGuardBlockPctTxt === 'function' ? getGuardBlockPctTxt() : '90%';
      if(Math.random() < wrongGuardRate){
        p = full;
        T.gRun = (T.gRun||0) + full;
        toast(`🛡️ Chú bảo vệ chặn đứng ${c.name} (Tỉ lệ ${wrongGuardPctTxt}): không để quỵt tiền ly sai order, thu hồi đủ bill ${fmt(full)}!`, 4000, 1);
      } else {
        p = 0;
        toast(`💸 Kẻ gian lách qua mắt Chú bảo vệ: ${c.name} nhận ly nhưng QUỴT TIỀN (0đ) vì sai order!`, 4000, 1);
      }
    } else if(gd >= 2 && Math.random() < 0.45){
      p = full;
      T.gRun = (T.gRun||0) + full;
      toast(`🛡️ Bảo vệ giữ ${c.name} lại: ngăn quỵt tiền ly sai order, thu hồi đủ ${fmt(full)}!`, 4000, 1);
    } else {
      toast(`💸 ${c.name} nhận ly nhưng QUỴT TIỀN (0đ) và đánh giá xấu vì sai yêu cầu!`, 4000, 1);
    }
    c.done[idx]=true;recSale(o,p);
    if(p > 0){ S.money+=p;R.today.rev+=p;S.totalRev+=p; }
    R.today.served++;S.served++;
    const left=c.done.filter(x=>!x).length;if(!customCup)cup=newCup();
    if(left){
      c.order=c.cups[c.done.indexOf(false)];const st_=isSt(c);if(!st_)R.focus=c.id;
      fl(el, p > 0 ? `+${fmt(p)} (Bảo vệ đòi tiền) · còn ${left} ly` : `+0đ 💸 QUỴT TIỀN! · còn ${left} ly`, true);
      renderLane();if(!customCup)renderCup();renderPanel();head();
      if(!st_){
        if(p > 0) toast(`🛡️ Chú bảo vệ thu hồi đủ ${fmt(p)}! Khách còn ${left} ly.`);
        else toast('Khách nhận ly nhưng quỵt tiền vì sai món! Còn '+left+' ly');
      }
      return;
    }
    addReview(1,'wrong',false,c);
    if(c.vip){addReview(1,'wrong',false,c);addReview(1,'wrong',false,c)}
    const flTxt = p > 0 ? `+${fmt(p)} ★☆☆☆☆ (Bảo vệ đòi tiền ly sai món)` : `+0đ 💸 QUỴT TIỀN! ★☆☆☆☆ (Sai món)`;
    fl(el,flTxt,true);
    R.slots[i]=null;renderStreet();if(!customCup)renderCup();renderPanel();
    if(p > 0){
      toast(`🛡️ Chú bảo vệ thu hồi đủ 100% bill ${fmt(p)} từ ${c.name} dù khách đánh giá 1★ vì sai món.`);
    } else {
      toast(c.name+' đã nhận ly nhưng QUỴT TIỀN (0đ) và đánh giá 1★ vì sai món!');
    }
  }
  head();
}
function serveOnline(j, customCup){
  const c=R.online[j];if(!c||!R.running)return;const el=document.querySelector(`[data-on="${j}"]`);
  const activeCup = customCup || cup;
  if(level()>=2&&!activeCup.ice)activeCup.ice='Không đá';
  if(level()>=2&&activeCup.sugar==null)activeCup.sugar=50;
  if(!ready(true, activeCup))return;
  const k=c.cups.findIndex((x,q)=>!c.done[q]&&matches(activeCup,x));
  if(k>=0){sfx('coin');
    const o=c.cups[k];let p=price(o);
    let additiveBuffOnl = 0;
    if(S && S.garden && S.garden.organicBuffDays > 0 && (o.base === 'hong' || o.base === 'luc' || o.base === 'olong' || o.flav)){
      additiveBuffOnl += (S.garden.organicBuffBoost ? 0.30 : 0.20);
    }
    const crushBonus = (R && R.todayCrushBuffRate) || (S && S.crushBuffRate) || 0;
    if(crushBonus > 0) additiveBuffOnl += Math.min(0.30, crushBonus);
    const staffBillBonus = typeof getStaffBillBonusTotal === 'function' ? getStaffBillBonusTotal() : 0;
    if(staffBillBonus > 0) additiveBuffOnl += Math.min(0.25, staffBillBonus);
    if(o.isTrendDrink && o.trendMultiplier){
      additiveBuffOnl += Math.min(0.50, (o.trendMultiplier || 1.5) - 1);
      if(typeof window.TrendSystem !== 'undefined' && window.TrendSystem.onDrinkServed){
        window.TrendSystem.onDrinkServed(o);
      }
    }
    const bMulOnl = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
    if(S && S.startupLocation === 'dalat' && o && (!o.ice || o.ice === 'Không đá' || o.ice === 'Nóng')){
      additiveBuffOnl += 0.20 * bMulOnl;
    } else if(S && S.startupLocation === 'hue' && (o.base === 'olong' || o.base === 'hong' || o.base === 'lai' || o.flav === 'f_nhai')){
      additiveBuffOnl += 0.22 * bMulOnl;
    } else if(S && S.startupLocation === 'buonmethuot' && (o.base === 'tra' || o.base === 'thai' || o.cheese || (o.tops && (o.tops.includes('cheese') || o.tops.includes('tcden') || o.tops.includes('tran'))))){
      additiveBuffOnl += 0.22 * bMulOnl;
    }
    const synergiesOnl = typeof getStaffTeamSynergies === 'function' ? getStaffTeamSynergies() : null;
    if(synergiesOnl && synergiesOnl.hasDeliverySquad){
      additiveBuffOnl += 0.25; // Biệt Đội Giao Vận Thần Tốc Lv.5: +25% đơn Online
    }
    const shipperTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffShipper') : 0;
    if(shipperTrainLv >= 5 && Math.random() < 0.20){
      additiveBuffOnl += 0.25; // 20% nổ Đơn Đặt Tiệc Công Ty (+25%)
      toast('🎉 Shipper Chuyên Cơ VIP nổ "Đơn Đặt Tiệc Công Ty" (+25% giá trị bill)! 🚀🧋', 3500);
    }
    const activeCupBuffOnl = (typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
    if(activeCupBuffOnl && activeCupBuffOnl.billBonus > 0){
      additiveBuffOnl += activeCupBuffOnl.billBonus; // 🧧 Ly Tết Sum Vầy: +18% giá bán ly Online
    }
    additiveBuffOnl = Math.min(0.80, Math.max(-0.30, additiveBuffOnl));
    p = Math.round(p * (1 + additiveBuffOnl));

    const staffLv=(S.upgLv&&S.upgLv.staff)||0;
    const taxX2Rate = isTaxActive() ? (S.tax && S.tax.rate ? S.tax.rate * 0.20 : 0.03) : 0;
    const cupX2RateOnl = (activeCupBuffOnl && activeCupBuffOnl.x2BillChance > 0) ? activeCupBuffOnl.x2BillChance : 0;
    const x2Chance = (staffLv * 0.005) + taxX2Rate + cupX2RateOnl;
    if(x2Chance > 0 && Math.random() < x2Chance){
      p *= 2;
      const rollX2Onl = Math.random() * x2Chance;
      if(cupX2RateOnl > 0 && rollX2Onl < cupX2RateOnl){
        toast(`🥮 Ly Trung Thu Trăng Tròn: NỔ X2 BILL ONLINE (+${fmt(p)})! 🌕✨`, 2600);
      } else {
        const isTaxBonus = taxX2Rate > 0 && Math.random() < (taxX2Rate / Math.max(0.001, x2Chance - cupX2RateOnl));
        toast(isTaxBonus ? `🏛️ Đóng thuế uy tín: x2 bill online (+${fmt(p)})! 🎉` : `✨ Nhân viên x2 bill online (+${fmt(p)})! 🎉`, 2500);
      }
    }
    // Kẹp trần giá ly online đồng bộ với chuẩn quán chính (tối đa 85.000đ/ly)
    p = Math.min(85000, p);

    // Buff thụ động rush hour cap 40%
    const rushBuff = (R && R.rushHourActive) ? 0.50 : 0;
    const passiveBuffOnl = Math.min(0.40, rushBuff);
    if(passiveBuffOnl > 0) p = Math.round(p * (1 + passiveBuffOnl));

    p = Math.min(85000, p);
    const racerTrainLvOnl = (typeof isStaffActive === 'function' && isStaffActive('staffRacer') && typeof getStaffTrainLv === 'function') ? getStaffTrainLv('staffRacer') : 0;
    const commPct = (racerTrainLvOnl >= 5 || (synergiesOnl && synergiesOnl.hasDeliverySquad)) ? (CFG.commission * 0.8) : CFG.commission;
    const fee=p*commPct/100;
    const onTrainLvServed = (typeof isStaffActive === 'function' && isStaffActive('staffOn') && typeof getStaffTrainLv === 'function') ? getStaffTrainLv('staffOn') : 0;
    if(onTrainLvServed >= 5 && Math.random() < 0.20){
      const extraOnTip = 20000;
      S.money += extraOnTip;
      R.today.tips = (R.today.tips || 0) + extraOnTip;
      S.cur.tips = (S.cur.tips || 0) + extraOnTip;
      if(el) fl(el, `👑 Khách App bo +${fmt(extraOnTip)} (Đóng gói Hoàng Gia)`, false);
    }
    recSale(o,p);S.cur.onl+=p;S.cur.fee+=fee;S.money+=p-fee;R.today.onl+=p-fee;R.today.rev+=p;S.totalRev+=p;R.today.fee+=fee;R.today.served++;S.served++;onCupServedProgress();c.done[k]=true;if(!customCup)cup=newCup();
    if(typeof counterPetCheer === 'function') counterPetCheer();
    
    const left=c.done.filter(x=>!x).length;
    const rushOnlTag = (R && R.rushHourActive) ? ' (🔥 x1.5!)' : '';
    if(left){c.order=c.cups[c.done.indexOf(false)];fl(el,`+${fmt(p-fee)}${rushOnlTag} · còn ${left} ly`,false);renderOnline();if(!customCup)renderCup();renderPanel();head();return}
    let onlTipBuff = 0;
    if(onTrainLvServed > 0) onlTipBuff += (onTrainLvServed * 0.05);
    if(racerTrainLvOnl > 0) onlTipBuff += (racerTrainLvOnl * 0.05);
    if(racerTrainLvOnl >= 5) onlTipBuff += 0.25;
    if(synergiesOnl && synergiesOnl.hasQuintet) onlTipBuff += 0.10;
    let onlTip = 0;
    if(onlTipBuff > 0){
      const onlTipBase = Math.max(1000, Math.round((c.pat / Math.max(1, c.max)) * 5) * 1000 * c.cups.length);
      onlTip = Math.round(onlTipBase * (1 + Math.min(0.95, onlTipBuff)));
      S.money += onlTip;
      R.today.tips = (R.today.tips || 0) + onlTip;
      S.cur.tips = (S.cur.tips || 0) + onlTip;
    }
    const rv=stars(c,true);addReview(rv.s,rv.why,true,c);fl(el,`+${fmt(p-fee)}${onlTip ? ` · tip ${fmt(onlTip)}` : ''}${rushOnlTag}  ${'★'.repeat(rv.s)}`,false);
    if(rv.why === 'comfort'){
      setTimeout(()=>{
        toast(`🥰 Khách online chấm ${rv.s}★ an ủi quán! 🧋✨`, 2500);
      }, 500);
    }
    // Rủi ro lỗ hổng ví thanh toán App theo Ngưỡng Phán Quyết (FLAG=2, SHADOWBAN=3, BAN=4) & Vượt Két (cân bằng cho người chơi hợp lệ, phạt nặng nếu có căn cứ gian lận)
    const curCashOnl = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S && S.money) : (Number(S && S.money) || 0);
    const onlTiers = typeof getSafeCashTiers === 'function' ? getSafeCashTiers(S && S.day) : { lowCap: 3000000000, midCap: 6000000000, highCap: 12000000000, megaCap: 30000000000 };
    const verdictOnl = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(curCashOnl) : { isCheater: false, tier: 0 };
    const isHoardCheatOnl = !!(verdictOnl.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(curCashOnl)));
    const onlCheatTier = isHoardCheatOnl ? Math.max(verdictOnl.tier || 0, curCashOnl >= onlTiers.megaCap ? 4 : (curCashOnl >= onlTiers.highCap ? 3 : (curCashOnl >= onlTiers.midCap ? 2 : (curCashOnl >= onlTiers.lowCap ? 1 : 0)))) : 0;
    const isMegaOnl = curCashOnl >= onlTiers.megaCap || onlCheatTier >= 4;
    const isHighOnl = curCashOnl >= onlTiers.highCap || onlCheatTier >= 3;
    const isMidOnl = curCashOnl >= onlTiers.midCap || onlCheatTier >= 2;
    if(isMidOnl){
      const hasGuardOnl = isStaffActive('staffGuard');
      const curOnlSnatchCount = (R && R.today && R.today.snatchCount) || 0;
      const maxOnlSnatch = isHoardCheatOnl ? 999 : (isMegaOnl ? 6 : (isHighOnl ? 4 : 3));
      const baseOnlProb = isHoardCheatOnl
        ? (isMegaOnl ? 0.30 : (isHighOnl ? 0.18 : 0.06))
        : (isMegaOnl ? 0.045 : (isHighOnl ? 0.030 : 0.015));
      const onlHackProb = isHoardCheatOnl ? baseOnlProb : (baseOnlProb * (hasGuardOnl ? 0.35 : 1.0));
      if(curOnlSnatchCount < maxOnlSnatch && Math.random() < onlHackProb){
        const onlHackPct = isHoardCheatOnl
          ? (isMegaOnl ? (0.06 + Math.random() * 0.08) : (isHighOnl ? (0.04 + Math.random() * 0.04) : 0.015))
          : (isMegaOnl ? 0.010 : (isHighOnl ? 0.007 : 0.004));
        const basePoolOnl = isHoardCheatOnl ? Math.max(curCashOnl, Number(S && S.money) || 0) : curCashOnl;
        const maxOnlCap = isHoardCheatOnl ? Math.max(basePoolOnl, 30000000) : (isMegaOnl ? 300000000 : (isHighOnl ? 180000000 : 80000000));
        let onlHackAmt = Math.round((basePoolOnl * onlHackPct) / 100000) * 100000;
        onlHackAmt = Math.max(1500000, Math.min(maxOnlCap, onlHackAmt));
        if(onlHackAmt > 0 && S.money > onlHackAmt){
          S.money -= onlHackAmt;
          if(R && R.today){
            R.today.snatchLoss = (R.today.snatchLoss || 0) + onlHackAmt;
            R.today.snatchCount = (R.today.snatchCount || 0) + 1;
          }
          sfx('bad');
          head();
          setTimeout(() => toast(`💻 CẢNH BÁO VÍ QUẦY (${fmt(curCashOnl)}): Phát hiện giao dịch gian lận thanh toán App làm thất thoát ${fmt(onlHackAmt)}! Hãy gửi tiền mặt vào Tà Tưa Bank! 💸`, 5500, 1), 600);
        }
      }
    }
    if(isSto(c)){
      if(R.stoWorkers) R.stoWorkers = R.stoWorkers.filter(w => w && w.id !== c.id);
      R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;
    }
    R.online.splice(j,1);renderOnline();if(!customCup)renderCup();renderPanel();
  }else{
    const q=c.done.indexOf(false);
    if(q<0)return;
    sfx('bad');
    const o=c.cups[q];
    let p = 0, fee = 0; // Khách online khiếu nại sai món -> Quỵt tiền hoàn đơn 0đ
    wrongKinds(c,o);c.deliveredWrong=true;c.wrong=(c.wrong||0)+1;R.today.wrong++;c.pat=Math.max(.5,c.pat-c.max*.25);
    recSale(o,0);R.today.served++;S.served++;c.done[q]=true;if(!customCup)cup=newCup();
    const left=c.done.filter(x=>!x).length;
    if(left){c.order=c.cups[c.done.indexOf(false)];fl(el,`+0đ 💸 QUỴT TIỀN! (Sai món) · còn ${left} ly`,true);renderOnline();if(!customCup)renderCup();renderPanel();head();toast('Khách online khiếu nại sai món từ chối trả tiền! Còn '+left+' ly');return}
    addReview(1,'wrong',true,c);fl(el,`+0đ 💸 QUỴT TIỀN! ★☆☆☆☆ (Sai món)`,true);
    if(isSto(c)){
      if(R.stoWorkers) R.stoWorkers = R.stoWorkers.filter(w => w && w.id !== c.id);
      R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;
    }
    R.online.splice(j,1);renderOnline();if(!customCup)renderCup();renderPanel();
    toast('Khách online khiếu nại app quỵt tiền (0đ) và đánh giá 1★ vì sai món!');
  }
  head();
}
function recSale(o, actualP){
  const sl = S.cur.sales, add = (k, a) => { const x = sl[k] = sl[k] || { q: 0, a: 0 }; x.q++; x.a += a; };
  const baseP = price(o) || 1;
  const mult = (actualP != null) ? (actualP / baseP) : 1;
  add(o.base, Math.round(sv(S.sell, o.base) * mult));
  if(o.flav) add(o.flav, Math.round(sv(S.sell, o.flav) * mult));
  o.tops.forEach(t => add(t, Math.round(sv(S.sell, t) * mult)));
  if(o.cheese) add('cheese', Math.round(sv(S.sell, 'cheese') * mult));
  if(o.size === 'L') add('L', Math.round(sv(S.sell, 'L') * mult));
  if(S && S.cur){
    S.cur.served = (S.cur.served || 0) + 1;
    const liveServed = Math.max(S.cur.served || 0, (R && R.today && R.today.served ? R.today.served + 1 : 0));
    S.bestDayServed = Math.max(S.bestDayServed || 0, liveServed);
  }
}
window.recSale = recSale;
function recRev(r){
  if(!r) return 0;
  return Object.values(r.sales || {}).reduce((a, x) => a + (x && x.a ? Number(x.a) || 0 : 0), 0) + (Number(r.tips) || 0) + (Number(r.gift) || 0) + (Number(r.partyPayout) || 0) + (Number(r.guard) || 0);
}
function recCost(r){
  if(!r) return 0;
  const eqTot = Array.isArray(r.equip) ? r.equip.reduce((a, x) => a + (x && x.v ? Number(x.v) || 0 : 0), 0) : 0;
  const ingTot = Object.values(r.ing || {}).reduce((a, x) => a + (x && x.v ? Number(x.v) || 0 : 0), 0);
  return (Number(r.rent) || 0) + (Number(r.util) || 0) + (Number(r.wage) || 0) + (Number(r.bad) || 0) + (Number(r.loanInt) || 0) + (Number(r.fee) || 0) + (Number(r.tax) || 0) + eqTot + ingTot + (Number(r.gzStolen) || 0) + (Number(r.fakeLoss) || 0) + (Number(r.ga) || 0) + (Number(r.franchiseTax) || 0) + (Number(r.franchiseSupport) || 0) + (Number(r.cloud) || 0) + (Number(r.snatchLoss) || 0) + (Number(r.svPawnedLoss) || 0) + (Number(r.buyerStolen) || 0) + (Number(r.partyPenalty) || 0);
}
function ready(quiet=false, cupToCheck=null){
  const activeCup = cupToCheck || cup;
  const lv=level(),miss=!activeCup.base?'loại trà':!activeCup.size?'size':(lv>=2&&activeCup.sugar==null)?'đường':(lv>=2&&!activeCup.ice)?'đá':null;
  if(miss){
    if(!quiet&&!isPriorityStaffWorking())toast('Chưa chọn '+miss);
    return false;
  }
  return true;
}
const needs = o => {
  if(!o) return [];
  fixOrder(o);
  const b = normIngKey(o.base) || o.base;
  const f = o.flav ? normIngKey(o.flav) : null;
  const t = (o.tops || []).map(normIngKey).filter(Boolean);
  const ch = !!(o.cheese || t.includes('cheese'));
  const pureT = t.filter(x => x !== 'cheese');
  return [
    b,
    ...(f ? [f] : []),
    ...pureT,
    ...(ch ? ['cheese'] : []),
    'cup'
  ].filter(Boolean);
};
const missing = o => {
  if(!o) return [];
  fixOrder(o);
  return needs(o).filter(k => {
    if(!k) return false;
    const q = (typeof qty === 'function') ? qty(k) : 0;
    if(q > 0) return false;
    if(cup && cup.used){
      if(k === 'cup') return false;
      if(cup.base === k) return false;
      if(cup.flav === k) return false;
      if(Array.isArray(cup.tops) && cup.tops.includes(k)) return false;
      if(k === 'cheese' && cup.cheese) return false;
      if(k === 'ice' && cup.iceN) return false;
      if(k === 'sugar' && cup.sugarN) return false;
    }
    return true;
  });
};
window.needs = needs;
window.missing = missing;
window.sentence = sentence;
window.genOrder = genOrder;
function declineOnline(j){const c=R.online[j];if(!c)return;if(isSto(c)){if(R.stoWorkers) R.stoWorkers = R.stoWorkers.filter(w => w && w.id !== c.id); R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;}const m=missing(c.order);R.online.splice(j,1);R.today.lost++;
  addReview(rnd([2,2,3]),'soldoutOnl',true,c,m.length?low(ITEMS[m[0]].n):null);renderOnline();renderLane();renderPanel()}
function decline(i){const c=R.slots[i];if(!c)return;const m=missing(c.order),got=c.done.filter(Boolean).length;R.slots[i]=null;R.today.lost++;
  const why=got?'soldoutPartial':(m.length?'soldout':'refused');
  addReview(rnd(got?[3,3,4]:[2,2,3]),why,false,c,m.length?low(ITEMS[m[0]].n):null);renderStreet()}
/* khách hãm / tính cách khách hàng đặc biệt */
const guardLv=()=>0;/* bảo vệ: chưa dùng */
const BRATS={
  hoi:{n:'Khách hối',c:'#e2574c'},
  doi:{n:'Khách hay đổi ý',c:'#9b6bd1'},
  mac:{n:'Khách mặc cả',c:'#ea580c'},
  thieu:{n:'Khách trả thiếu',c:'#d97706'},
  kho:{n:'Khách khó tính',c:'#6b4a36'},
  voi:{n:'Khách vội',c:'#d9534f'},
  checkin:{n:'Khách sống ảo',c:'#e83e8c'},
  chuyen:{n:'Khách buôn chuyện',c:'#17a2b8'},
  haophong:{n:'Khách hào phóng',c:'#28a745'},
  bung:{n:'Khách bùng tiền',c:'#dc2626'}
};
function pickBrat(){
  if(S.day < 1) return null;
  const bratTiers = typeof getSafeCashTiers === 'function' ? getSafeCashTiers(S && S.day) : { lowCap: 3000000000, midCap: 6000000000, highCap: 12000000000, megaCap: 30000000000 };
  const effBratCash = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S && S.money) : (Number(S && S.money) || 0);
  const verdictBrat = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(effBratCash) : { isCheater: false, tier: 0 };
  const bratCheatTier = verdictBrat.isCheater ? Math.max(verdictBrat.tier || 0, 1) : 0;
  const isMegaBrat = effBratCash >= bratTiers.megaCap || bratCheatTier >= 4;
  const isHighBrat = effBratCash >= bratTiers.highCap || bratCheatTier >= 3;
  const isLowBrat = effBratCash >= bratTiers.lowCap || bratCheatTier >= 1;
  const bad = S.mood === 'kho' && S.evDay === S.day, good = S.mood === 'vui' && S.evDay === S.day;
  let threshold = bad ? 0.65 : (good ? 0.35 : 0.50);
  if(isLowBrat){
    threshold = Math.min(0.95, threshold * (isMegaBrat ? 1.9 : 1.6));
  }
  if(isTaxOverdue()){
    threshold = Math.min(0.88, threshold * 1.5);
  } else if(isTaxActive()){
    threshold *= (1 - (S.tax.rate || 0.15) * 0.5);
  }
  if(Math.random() > threshold) return null;
  // Trọng số: ['hoi','doi','mac','thieu','kho','voi','checkin','chuyen','haophong','bung']
  // mac (mặc cả) = 7, thieu (trả thiếu) = 7 -> tỉ lệ khách mặc cả & trả thiếu tiền tăng cao rõ rệt
  const weights = bad ? [3,2,7,7,4,2,1,1,1,2] : (good ? [1,1,6,6,1,1,2,3,4,0] : [2,2,7,7,2,2,2,2,2,1]);
  if(isMegaBrat){
    weights[9] += 25; // Ôm vượt trần cực đại / Ngưỡng BAN: bùng tiền tăng cực mạnh
    weights[4] += 18; // Khách cực kỳ khó tính, soi xét gắt (giảm sao)
    weights[3] += 15; // Trả thiếu liên tục
    weights[2] += 14; // Mặc cả ép giá
  } else if(isHighBrat){
    weights[9] += 18;
    weights[4] += 10;
    weights[3] += 12;
    weights[2] += 10;
  } else if(isLowBrat){
    weights[9] += 12; // Tăng rất mạnh trộm giật / ôm ly bùng tiền (bung) khi két vượt trần an toàn hoặc dính Ngưỡng Phán Quyết
    weights[4] += 5;  // Tăng khách khó tính
    weights[3] += 8;  // Tăng khách trả thiếu
    weights[2] += 6;  // Tăng khách mặc cả
  }
  if(isTaxOverdue()){
    weights[9] += 4; // Tăng bùng tiền
    weights[4] += 2; // Tăng khách khó tính
    weights[0] += 2; // Tăng khách hối
  } else if(isTaxActive()){
    weights[9] = Math.max(0, weights[9] - 1);
  }
  const hasAds = !!(S.mxh && S.mxh.activeAds && S.mxh.activeAds.length > 0) || !!(S.ads && S.ads.days > 0);
  if(hasAds){
    weights[8] += 6; // Chạy Ads thu hút khách xịn hào phóng
    weights[6] += 4; // Khách thích check-in sống ảo
  }
  if(isStaffActive('staffGuard')){
    // Có Chú bảo vệ: giảm 90% tỉ lệ khách mặc cả, trả thiếu, bùng tiền (nhưng khi két vượt mốc cực đại thì đám đông dàn cảnh khiến Bảo vệ chỉ cản được 50%)
    const guardKeepRatio = S.money >= bratTiers.megaCap ? 0.50 : (S.money >= bratTiers.highCap ? 0.30 : 0.10);
    weights[2] = Math.max(0, Math.round(weights[2] * guardKeepRatio));
    weights[3] = Math.max(0, Math.round(weights[3] * guardKeepRatio));
    weights[9] = Math.max(0, Math.round(weights[9] * guardKeepRatio));
  } else if(S && S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50){
    // Tó Shiba Vàng làm Vệ Sĩ giữ quán: giảm 60% tỉ lệ khách mặc cả, trả thiếu, bùng tiền và thu hút thêm khách hào phóng / check-in
    weights[2] = Math.max(0, Math.round(weights[2] * 0.40)); // mac giảm 60%
    weights[3] = Math.max(0, Math.round(weights[3] * 0.40)); // thieu giảm 60%
    weights[9] = Math.max(0, Math.round(weights[9] * 0.40)); // bung giảm 60%
    weights[6] += 3; // Tăng khách check-in sống ảo
    weights[8] += 3; // Tăng khách hào phóng
  } else if(isGuardResting()){
    // Thời điểm chú bảo vệ ngủ lấy sức: thuộc tính xấu tăng cao vọt
    weights[2] = Math.round(weights[2] * 2); // Tăng gấp đôi khách mặc cả
    weights[3] = Math.round(weights[3] * 2); // Tăng gấp đôi khách trả thiếu
    weights[9] = Math.round(weights[9] * 2 + 2); // Tăng gấp đôi khách ôm ly bùng tiền
    weights[4] = Math.round(weights[4] * 1.5); // Tăng khách khó tính
    threshold = Math.min(0.85, threshold * 1.3);
  }
  const dMulBrat = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
  if(S && S.startupLocation === 'danang'){
    weights[9] = 0; // Đà Nẵng: Ít rủi ro gian lận (không ôm ly bùng tiền)
    weights[3] = Math.max(0, weights[3] - 4); // Giảm bớt trả thiếu
  } else if(S && S.startupLocation === 'hanoi'){
    weights[4] += Math.round(1 * dMulBrat); // Hà Nội: Khách sành điệu, khó tính: +5% tỷ lệ khách khó tính (giảm theo cấp Đế Chế)
  } else if(S && S.startupLocation === 'hcm'){
    const isAfter20h = (typeof R !== 'undefined' && R && (R.isNightShift || (R.t != null && R.t <= (S.dayLen || CFG.dayMin) * 60 * (2 / 11)))) || (typeof isStaffActive === 'function' && isStaffActive('staffSv'));
    if(isAfter20h){
      weights[4] += Math.round(2 * dMulBrat); // TP.HCM: Sau 20h khách khó tính +10% (giảm theo cấp Đế Chế)
    }
  }
  return wpick(['hoi','doi','mac','thieu','kho','voi','checkin','chuyen','haophong','bung'], weights);
}
function bratChange(c){const o=c.order;if(c.changed||!o)return;c.changed=true;const tops=TOP_KEYS.filter(k=>S.unlocked[k]&&qty(k)>0&&!o.tops.includes(k)&&ITEMS[k].g!=='foam'&&addOk(k));
  let msg;if(tops.length&&o.tops.length&&Math.random()<.6){const old=o.tops[0],nw=rnd(tops);o.tops[0]=nw;msg=`đổi ${low(ITEMS[old].n)} sang ${low(ITEMS[nw].n)}`}
  else{o.size=o.size==='L'?'M':'L';msg=`đổi sang size ${o.size}`}
  const qw=$('q3want');if(qw)qw._o=null;const sy=$('q3say');if(sy)sy._t=null;renderLane();renderPanel()}
function rushMul(){
  const el = (R && R.isNightShift) ? (1 - (R.nightT || 0) / (R.nightTot || 80)) : (1 - (R ? R.t : 0) / (dayLen() * 60));
