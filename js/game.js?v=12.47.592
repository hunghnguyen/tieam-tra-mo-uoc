function getDefaultTikTokPosts(shopName){
  const curShop = shopName || 'Tiệm Trà Mơ Ước';
  return [
    {
      id: 'p_init_1',
      author: 'Foodie Sài Gòn 🛵',
      avt: '👩‍🎤',
      badge: 'KOL Ẩm Thực 1.2M',
      time: '1 giờ trước',
      isTiktok: true,
      topic: `POV: Ghé thẩm quán trà sữa ${curShop} theo lời đồn triệu view trên TikTok!`,
      dialogue: [
        { speaker: 'Foodie Sài Gòn', text: `Bữa giờ thấy cõi mạng khen ${curShop} rần rần. Cho mình 1 ly Ô Long Nướng kem cheese full topping thử xem sao!` },
        { speaker: 'Chủ quán', text: 'Dạ ly của bạn đây ạ! Trà lá thượng hạng ủ tươi trong ngày, kèm phô mai tươi béo thơm độc quyền đánh mịn như mây!' },
        { speaker: 'Foodie Sài Gòn', text: 'Trời ơi húp ngụm đầu tiên mà rùng mình vì độ thơm béo! Trân châu dẻo quánh nhai đã cái nư dã man! 10/10 không có nhưng! 🧋✨' }
