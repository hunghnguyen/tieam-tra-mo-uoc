    buff: { freeIngChance: 0.25 },
    desc: 'Skin Quán Quân Top 1 Tổng Ly: Vòng nguyệt quế, chuông vàng & kẹo gậy lễ hội'
  }
];
const TOP1_CUP_SKINS = Object.fromEntries(TOP1_CUP_SKIN_LIST.map(s => [s.id, s]));
window.TOP1_CUP_SKIN_LIST = TOP1_CUP_SKIN_LIST;
window.TOP1_CUP_SKINS = TOP1_CUP_SKINS;

const LB_TAB_LABELS = {
  staff_tip: 'Tip NV (7N)',
  day_rev: 'DT Ngày',
  day_served: 'Ly Ngày',
  crush: 'Crush',
  capbi: 'Cáp Pi',
  avg_upg: 'TB Nâng Cấp',
  star: '1 Sao',
  served: 'Tổng Ly'
};

// Bản đồ 8 mục BXH -> Skin Ly dành riêng cho Quán Quân Top 1 (#1) mỗi bảng:
// 7 mục cố định 7 ly, riêng mục thứ 8 (staff_tip - Top Tip Nhân Viên) nhận 1 ly Random mỗi kỳ chốt BXH
const LB_TAB_CUP_SKIN_MAP = {
  day_rev: 'tet',
  day_served: 'spring',
  crush: 'summer',
  capbi: 'autumn',
  avg_upg: 'moon',
  star: 'winter',
  served: 'christmas',
  staff_tip: 'random'
};
window.LB_TAB_CUP_SKIN_MAP = LB_TAB_CUP_SKIN_MAP;

// Chu kỳ chốt Top 1 tự động mỗi ngày đồng bộ toàn server (00:00 UTC = 07:00 sáng giờ VN)
function getServerResetCycleKey(){
  try {
    return new Date().toISOString().slice(0, 10);
  } catch(e){
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
  }
}
window.getServerResetCycleKey = getServerResetCycleKey;

function getCupSkinByTab(tabId){
  const mapped = LB_TAB_CUP_SKIN_MAP[tabId];
  if(!mapped) return TOP1_CUP_SKINS.tet;
  if(mapped === 'random'){
    const cycleKey = getServerResetCycleKey();
    let savedRandomId = '';
    try {
      if(typeof S !== 'undefined' && S && S.dailyStaffTipSkinCycle === cycleKey && S.dailyStaffTipSkin && TOP1_CUP_SKINS[S.dailyStaffTipSkin]){
        savedRandomId = S.dailyStaffTipSkin;
      } else {
        const ls = localStorage.getItem('ts_daily_staff_tip_skin_' + cycleKey);
        if(ls && TOP1_CUP_SKINS[ls]) savedRandomId = ls;
      }
    } catch(e){}
    if(savedRandomId && TOP1_CUP_SKINS[savedRandomId]){
      return TOP1_CUP_SKINS[savedRandomId];
    }
    // Nếu chưa quay random cho kỳ hôm nay, hiển thị preview theo hash ngày server để đồng bộ
    let hash = 0;
    for(let i = 0; i < cycleKey.length; i++) hash = ((hash << 5) - hash) + cycleKey.charCodeAt(i);
    const idx = Math.abs(hash) % TOP1_CUP_SKIN_LIST.length;
    return TOP1_CUP_SKIN_LIST[idx];
  }
  return TOP1_CUP_SKINS[mapped] || TOP1_CUP_SKINS.tet;
}
window.getCupSkinByTab = getCupSkinByTab;

function getCupSkinByRank(rank, tabId = 'day_rev'){
  const r = parseInt(rank, 10) || 0;
  if(r !== 1) return null; // Chỉ Top 1 (#1) của mỗi bảng mới nhận được Ly Quán Quân
  return getCupSkinByTab(tabId);
}
window.getCupSkinByRank = getCupSkinByRank;

function getUnlockedTop1CupSkins(){
  const set = new Set();
  try {
    if(typeof S !== 'undefined' && S && Array.isArray(S.unlockedCupSkins)){
      S.unlockedCupSkins.forEach(id => { if(TOP1_CUP_SKINS[id]) set.add(id); });
    }
    const raw = localStorage.getItem('ts_unlocked_cup_skins');
    if(raw){
      const arr = JSON.parse(raw);
      if(Array.isArray(arr)) arr.forEach(id => { if(TOP1_CUP_SKINS[id]) set.add(id); });
    }
    if(typeof S !== 'undefined' && S && S.lockedTopSkinId && TOP1_CUP_SKINS[S.lockedTopSkinId]){
      set.add(S.lockedTopSkinId);
    }
    const savedLocked = localStorage.getItem('ts_locked_top_skin_id');
    if(savedLocked && TOP1_CUP_SKINS[savedLocked]) set.add(savedLocked);
  } catch(e){}
  return Array.from(set);
}
window.getUnlockedTop1CupSkins = getUnlockedTop1CupSkins;

function getLockedTopRank(){
  try {
    if(getUnlockedTop1CupSkins().length > 0) return 1;
    if(typeof S !== 'undefined' && S && S.lockedTopRank === 1) return 1;
    if(localStorage.getItem('ts_locked_top_rank') === '1') return 1;
  } catch(e){}
  return 0;
}
window.getLockedTopRank = getLockedTopRank;

function getUnlockedTopRanks(){
  return getUnlockedTop1CupSkins().length > 0 ? [1] : [];
}
window.getUnlockedTopRanks = getUnlockedTopRanks;

function isCupSkinItemUnlocked(skinId){
  if(skinId === 'default' || skinId === 'none') return true;
  if(skinId === 'auto') return isTop1CupUnlocked();
  if(!TOP1_CUP_SKINS[skinId]) return false;
  return getUnlockedTop1CupSkins().includes(skinId);
}
window.isCupSkinItemUnlocked = isCupSkinItemUnlocked;

function isTop1CupUnlocked(){
  try {
    if(getUnlockedTop1CupSkins().length > 0) return true;
  } catch(e){}
  return false;
}
window.isTop1CupUnlocked = isTop1CupUnlocked;

function unlockTop1CupSkin(sourceTab = 'day_rev', silent = false, rank = 1){
  const validRank = parseInt(rank, 10) || 0;
  // Chỉ duy nhất Top 1 (#1) của mỗi bảng xếp hạng mới mở khóa được Ly!
  if(validRank !== 1) return null;

  const cycleKey = getServerResetCycleKey();
  // Kiểm tra xem mục BXH này đã chốt Top 1 trong kỳ reset hôm nay chưa (Mỗi ngày chốt Top 1 lần theo từng mục)
  let lockedTabsToday = {};
  try {
    if(typeof S !== 'undefined' && S && S.dailyTop1LockCycle === cycleKey && S.dailyTop1LockedTabs && typeof S.dailyTop1LockedTabs === 'object'){
      lockedTabsToday = Object.assign({}, S.dailyTop1LockedTabs);
    } else {
      const rawLocked = localStorage.getItem('ts_daily_top1_locked_tabs_' + cycleKey);
      if(rawLocked) lockedTabsToday = JSON.parse(rawLocked) || {};
    }
  } catch(e){}

  const unlockedSet = new Set(getUnlockedTop1CupSkins());
  let awardedSkinId = LB_TAB_CUP_SKIN_MAP[sourceTab] || 'tet';
  let isRandomTab = (awardedSkinId === 'random');

  if(isRandomTab){
    // Nếu hôm nay đã quay random cho Top 1 Tip NV rồi thì giữ nguyên kết quả của kỳ chốt hôm nay
    if(lockedTabsToday[sourceTab] && TOP1_CUP_SKINS[lockedTabsToday[sourceTab]]){
      awardedSkinId = lockedTabsToday[sourceTab];
    } else {
      // Ưu tiên quay vào các mẫu ly người chơi chưa mở khóa, nếu đã đủ 7 ly thì quay ngẫu nhiên toàn bộ 7 ly
      const lockedPool = TOP1_CUP_SKIN_LIST.map(s => s.id).filter(id => !unlockedSet.has(id));
      const pool = lockedPool.length > 0 ? lockedPool : TOP1_CUP_SKIN_LIST.map(s => s.id);
      awardedSkinId = pool[Math.floor(Math.random() * pool.length)] || 'tet';
      try {
        if(typeof S !== 'undefined' && S){
          S.dailyStaffTipSkinCycle = cycleKey;
          S.dailyStaffTipSkin = awardedSkinId;
        }
        localStorage.setItem('ts_daily_staff_tip_skin_' + cycleKey, awardedSkinId);
      } catch(e){}
    }
  }

  const alreadyLockedThisTabToday = !!lockedTabsToday[sourceTab];
  const wasSkinAlreadyUnlocked = unlockedSet.has(awardedSkinId);
  lockedTabsToday[sourceTab] = awardedSkinId;
  unlockedSet.add(awardedSkinId);
  const unlockedArr = Array.from(unlockedSet);

  try {
    if(typeof S !== 'undefined' && S){
      S.top1CupUnlocked = true;
      S.lockedTopRank = 1;
      S.lockedTopTab = sourceTab;
      S.lockedTopSkinId = awardedSkinId;
      S.dailyTop1LockCycle = cycleKey;
      S.dailyTop1LockedTabs = lockedTabsToday;
      S.lockedTopSyncAt = Date.now();
      S.unlockedCupSkins = unlockedArr;
      if(!S.cupSkin) S.cupSkin = 'auto';
      save();
    }
    localStorage.setItem('ts_top1_cup_unlocked', '1');
    localStorage.setItem('ts_locked_top_rank', '1');
    localStorage.setItem('ts_locked_top_tab', String(sourceTab || 'day_rev'));
    localStorage.setItem('ts_locked_top_skin_id', awardedSkinId);
    localStorage.setItem('ts_unlocked_cup_skins', JSON.stringify(unlockedArr));
    localStorage.setItem('ts_daily_top1_locked_tabs_' + cycleKey, JSON.stringify(lockedTabsToday));
  } catch(e){}

  if(typeof renderCup === 'function'){
    try { renderCup(); } catch(e){}
  }

  const sk = TOP1_CUP_SKINS[awardedSkinId];
  if(!silent && (!alreadyLockedThisTabToday || !wasSkinAlreadyUnlocked) && sk){
    try { sfx('win'); } catch(e){}
    const tabName = LB_TAB_LABELS[sourceTab] || 'BXH';
    const randNote = isRandomTab ? ' (Quà Random Top 1 Tip NV)' : '';
    toast(`👑 Chốt Top 1 (${tabName})${randNote}! Nhận Ly ${sk.icon} ${sk.name} — Buff: ${sk.buffShort}!`, 6000);
  }
  return sk;
}
window.unlockTop1CupSkin = unlockTop1CupSkin;

function getResolvedCupSkinObj(overrideSkinId){
  let sid = overrideSkinId;
  if(!sid){
    if(!isTop1CupUnlocked()) return null;
    sid = (typeof S !== 'undefined' && S && S.cupSkin) ? S.cupSkin : 'auto';
  }
  if(sid === 'default' || sid === 'none') return null;
  const unlocked = getUnlockedTop1CupSkins();
  if(sid === 'auto'){
    if(typeof S !== 'undefined' && S && S.lockedTopSkinId && unlocked.includes(S.lockedTopSkinId)){
      return TOP1_CUP_SKINS[S.lockedTopSkinId];
    }
    const savedId = localStorage.getItem('ts_locked_top_skin_id');
    if(savedId && unlocked.includes(savedId) && TOP1_CUP_SKINS[savedId]){
      return TOP1_CUP_SKINS[savedId];
    }
    if(unlocked.length > 0 && TOP1_CUP_SKINS[unlocked[unlocked.length - 1]]){
      return TOP1_CUP_SKINS[unlocked[unlocked.length - 1]];
    }
    return null;
  }
  if(TOP1_CUP_SKINS[sid]){
    if(overrideSkinId || isCupSkinItemUnlocked(sid)) return TOP1_CUP_SKINS[sid];
    if(unlocked.length > 0 && TOP1_CUP_SKINS[unlocked[unlocked.length - 1]]){
      return TOP1_CUP_SKINS[unlocked[unlocked.length - 1]];
    }
  }
  return null;
}
window.getResolvedCupSkinObj = getResolvedCupSkinObj;

function getActiveCupSkinBuff(){
  const sk = getResolvedCupSkinObj();
  if(!sk || !sk.buff) return null;
  return sk.buff;
}
window.getActiveCupSkinBuff = getActiveCupSkinBuff;

function getActiveCupSkinUrl(forBrand = false, overrideSkinId = null){
  const sk = getResolvedCupSkinObj(overrideSkinId);
  if(!sk) return null;
  const path = forBrand ? (sk.brandSvg || sk.svg) : sk.svg;
  return path ? `${path}?v=${GAME_VERSION}` : null;
}
window.getActiveCupSkinUrl = getActiveCupSkinUrl;

function selectTop1CupSkin(skinId){
  if(!isTop1CupUnlocked()){
    try { sfx('bad'); } catch(e){}
    toast('🔒 Chỉ Quán Quân Top 1 (#1) của mỗi Bảng Xếp Hạng khi chốt ngày mới mở khóa được Skin Ly & Buff độc quyền!', 4800);
    return;
  }
  if(skinId !== 'auto' && skinId !== 'default' && !isCupSkinItemUnlocked(skinId)){
    const targetSk = TOP1_CUP_SKINS[skinId];
    try { sfx('bad'); } catch(e){}
    toast(`🔒 Ly "${targetSk ? targetSk.icon + ' ' + targetSk.name : ''}" (${targetSk ? targetSk.buffShort : ''}) chỉ mở khóa khi đạt ${targetSk ? targetSk.rankLabel : 'Top 1'} hoặc quay trúng từ Top 1 Tip NV!`, 5000);
    return;
  }
  if(typeof S !== 'undefined' && S){
    S.cupSkin = skinId;
    save();
  }
  try { sfx('tap'); } catch(e){}
  if(typeof renderCup === 'function') {
    try { renderCup(); } catch(e){}
  }
  const activeSk = getResolvedCupSkinObj(skinId === 'auto' ? null : skinId);
  const label = skinId === 'default'
    ? '🥤 Ly Trong Suốt Mặc Định (Không Buff)'
    : (skinId === 'auto'
      ? `✨ Theo Top 1 Đã Chốt (${activeSk ? activeSk.icon + ' ' + activeSk.name + ' · ' + activeSk.buffShort : 'Tự động'})`
      : `${TOP1_CUP_SKINS[skinId]?.icon || '👑'} Ly ${TOP1_CUP_SKINS[skinId]?.name || ''} (Buff: ${TOP1_CUP_SKINS[skinId]?.buffShort || ''})`);
  toast(`👑 Đã trang bị tại quầy pha chế: ${label}!`, 4200);
  const bar = document.getElementById('lbCupSkinBar');
  if(bar && typeof renderLbCupSkinBarHtml === 'function'){
    bar.outerHTML = renderLbCupSkinBarHtml();
  }
}
window.selectTop1CupSkin = selectTop1CupSkin;

const CX=55.6,BY=141,LH=105,halfAt=y=>y<51.7?44:44-(y-51.7)/(136.5-51.7)*11.1;
function glassHTML(c,opt){opt=opt||{};
  const fill=c.fill||0,surf=BY-Math.min(fill,1)*LH,vt=c.vt||[],vi=c.vi||[],foams=(c.tops||[]).filter(t=>ITEMS[t]&&ITEMS[t].g==='foam');let inner='';
  if(fill>0||opt.pour)inner+=`<rect class="lq" x="0" y="${surf}" width="110" height="${BY-surf+8}" fill="${liqCol(c)}"/><rect class="lqh" x="0" y="${surf}" width="110" height="3.5" fill="#fff" opacity=".3"/>`;
  const step=vt.length>3?Math.min(22,60/vt.length):22;
  vt.forEach((p,i)=>{const big=p.pts.length>10,sc=big?1.3:1;p.pts.forEach(([u,v],j)=>{const y=BY-(big?6:5)-v-i*step,x=CX+u*(halfAt(y)-(big?7:6));inner+=big?`<g transform="translate(${x} ${y}) scale(${sc}) translate(${-x} ${-y})">${pc(p.k,x,y,j+i)}</g>`:pc(p.k,x,y,j+i)})});
  const iceTop=fill>0?surf:Math.max(52,BY-(8+Math.min(vt.length*20,68)));
  vi.forEach(([u,v,r])=>{const x=CX+u*(halfAt(iceTop)-12);inner+=`<rect x="${x-8}" y="${iceTop+v}" width="16" height="16" rx="4" fill="#f2fbff" fill-opacity=".75" stroke="#8fb9cf" stroke-width="1.5" transform="rotate(${r} ${x} ${iceTop+v+8})"/>`});
  let fy=fill>0?surf:iceTop;
  foams.forEach(k=>{const th=13;fy-=th-3;const w=halfAt(fy)*2+4,x0=CX-w/2;
    inner+=`<path d="M${x0} ${fy+th}V${fy+5}q${w/8} -8 ${w/4} 0t${w/4} 0t${w/4} 0t${w/4} 0V${fy+th}Z" fill="${ITEMS[k].c}" stroke="#5a3d2b" stroke-width=".6"/>`});
  const id='q3c'+(opt.mini?'m':'');
  let out=`<svg viewBox="0 0 110 155.6" preserveAspectRatio="none"><defs><clipPath id="${id}"><path d="M8 27.8H103L99.9 51.7L88.8 136.5Q56 147 23.1 136.5L11.4 51.7Z"/></clipPath></defs>`;
  if(!opt.mini)out+=`<ellipse cx="${CX}" cy="150" rx="40" ry="5" fill="rgba(90,55,20,.25)"/>`;
  if(c.spill)out+=`<ellipse cx="${CX}" cy="150" rx="62" ry="7" fill="${liqCol(c)}" opacity=".85" stroke="#5a3d2b" stroke-width="1"/>`;
  if(opt.pour)out+=`<rect class="strm" x="${CX-3.5}" y="-80" width="7" height="${surf+80}" rx="3.5" fill="${ITEMS[opt.pour].c}" stroke="#5a3d2b" stroke-width=".8"/>`;
  out+=`<g clip-path="url(#${id})">${inner}</g>`;
  out+=`<path d="M8 27.8H103L99.9 51.7L88.8 136.5Q56 147 23.1 136.5L11.4 51.7Z" fill="none" stroke="#5a3d2b" stroke-width="1.5" opacity="0.6"/>`;
  if(!c.sealed&&!opt.mini)out+=`<line x1="${CX-halfAt(57)+4}" x2="${CX+halfAt(57)-4}" y1="57" y2="57" stroke="#2f8a63" stroke-width="2.2" stroke-dasharray="5 4"/>`;
  const hasBrandTem = !opt.mini && typeof S !== 'undefined' && S && S.upg && S.upg.brandKit && S.brand && S.brand.i;
  const skinUrl = !opt.mini ? getActiveCupSkinUrl(hasBrandTem, opt.skinId) : null;
  out+=`</svg><img src="${IMG}cup.png" alt="" onerror="this.style.display='none'">`;
  if(skinUrl)out+=`<img class="q3cup-skin" src="${skinUrl}" alt="" onerror="if(!this.dataset.fb){this.dataset.fb='1';this.src='img/'+this.getAttribute('src');}else{this.style.display='none';}">`;
  out+=`<img class="q3lid" src="${IMG}lid.png" alt=""${c.sealed?'':' hidden'} onerror="this.style.display='none'">`;
  if(!opt.mini&&c.size)out+=`<svg class="q3size-svg" viewBox="0 0 110 155.6" preserveAspectRatio="none"><g transform="translate(86 118)"><circle r="9" fill="#fffaf0" stroke="${Q3INK}" stroke-width="1.6"/><text y="4.5" text-anchor="middle" font-family="Baloo 2,sans-serif" font-weight="800" font-size="12" fill="${Q3INK}">${c.size}</text></g></svg>`;
  return `<div class="q3g">${out}</div>`}
function orderGlass(o){const ic={'Không đá':0,'Ít đá':1,'Đá thường':2}[o.ice]||0;
  return glassHTML({base:o.base,flav:o.flav,tops:o.tops,fill:.8,sealed:true,vt:o.tops.filter(t=>ITEMS[t]&&ITEMS[t].g!=='foam').map(k=>({k,pts:q3layer(k)})),vi:Array.from({length:ic===2?8:ic*3},(_,i)=>[Math.random()*2-1,4+Math.random()*22+i*3.5,Math.random()*40-20])},{mini:1})}
const q3reduce=(typeof window!=='undefined'&&typeof window.matchMedia==='function')?window.matchMedia('(prefers-reduced-motion:reduce)').matches:false;

function renderSell(){
  {const ae=document.activeElement;if(ae&&ae.blur&&/INPUT|TEXTAREA|SELECT/.test(ae.tagName))ae.blur()}scrollTo(0,0);
  R.mode='sell';document.body.classList.add('selling');R.focus=null;R.sealing=false;
  const zone=(a,x,y,w,h,extra,cls)=>`<button class="q3z ${cls||''}" ${a} data-r="${x},${y},${w},${h}" style="left:${x}px;top:${y}px;width:${w}px;height:${h}px">${extra||''}</button>`;
  let h='';
  h+=zone('data-a="size:M" aria-label="Lấy ly M" id="q3_M"',14,408,66,178)+zone('data-a="size:L" aria-label="Lấy ly L" id="q3_L"',82,368,64,218);
  h+=`<div class="q3badge" style="left:110px;top:368px" id="q3cups"></div>`;
  JAR_K.forEach((k,i)=>{const x=JAR_X[i];h+=zone(`data-tea="${k}" id="q3b_${k}" aria-label="Giữ để rót ${ITEMS[k].n}"`,x-37,362,74,160,'','q3jar');
    h+=`<div class="q3jarT" style="left:${x-31}px;top:428px;width:62px;height:46px">${JAR_L[k].map(w=>`<span${w.length>5?' style="font-size:14px"':''}>${w}</span>`).join('')}</div>`;
    h+=`<div class="q3badge q3sm" style="left:${x+14}px;top:372px" id="q3n_${k}"></div>`});
  h+=zone('data-a="seal" id="q3seal" aria-label="Dán nắp và giao ly"',638,334,122,228);
  h+=zone('data-a="trash" id="q3trash" aria-label="Đổ ly làm lại"',188,582,84,100);
  TRAY_K.forEach((k,i)=>{const [x0,x1]=TCOL[i%4],[y0,y1]=TROW[Math.floor(i/4)];
    h+=zone(`data-a="top:${k}" id="q3b_${k}" aria-label="${ITEMS[k].n}"`,x0,y0,x1-x0,y1-y0);
    h+=`<div class="q3badge" style="left:${BADGE_X[i%4]-15}px;top:${BADGE_Y[Math.floor(i/4)]-15}px;min-width:30px;height:30px" id="q3n_${k}"></div>`});
  const curThemeCls = getActiveThemeClass();
  const curLoc = getStartupLocation();
  const isDefaultLoc = (!curLoc || curLoc.id === 'default' || curLoc.isDefault);
  const locBg = (!isDefaultLoc && curLoc && curLoc.bg) ? curLoc.bg : 'img/bg2.jpg';
  const initBgUrl = locBg.includes('?') ? `${locBg}&v=${GAME_VERSION}` : `${locBg}?v=${GAME_VERSION}`;
  let spr='',patch='',defSpr='';const lv_=level();
  const binsOwn=BIN_K.map((k,i)=>[k,i]).filter(([k])=>k==='ice'||k==='sugar'?lv_>=2:S.unlocked[k]);
  
  binsOwn.forEach(([k,src],i)=>{
    const sx=15+124*src,dx=15+124*i;
    defSpr+=`<div class="q3spr" style="left:${dx}px;top:955px;width:124px;height:178px;background-position:${-sx}px -955px;"></div>`;
  });
  BTL_K.filter(k=>S.unlocked[k]).forEach((k,idx)=>{
    const i0=BTL_K.indexOf(k),sx=BTL_X[i0],x=BTL_X[isDefaultLoc?idx:i0];
    defSpr+=`<div class="q3spr" data-btl style="left:${x-31}px;top:1160px;width:62px;height:200px;background-position:${-(sx-31)}px -1160px;"></div>`;
  });

  if(isDefaultLoc){
    // Tiệm Trà Ban Đầu (Gốc): Dùng sprites hũ và chai từ img/bg.jpg, miếng che patch như bản gốc
    binsOwn.forEach(([k,src],i)=>{
      const sx=15+124*src,dx=15+124*i;
      spr+=`<div class="q3spr" style="left:${dx}px;top:955px;width:124px;height:178px;background-position:${-sx}px -955px;"></div>`;
      const a=k==='ice'?'data-a="ice" id="q3b_ice"':k==='sugar'?'data-a="sugar" id="q3b_sugar"':`data-a="top:${k}" id="q3b_${k}"`;
      h+=zone(`${a} data-s="${sx+4},975" aria-label="${BIN_LB[src].replace('<br>',' ')}"`,dx+4,975,116,158);
      h+=`<div class="q3lbT" style="left:${dx+10}px;top:1097px;width:104px;height:34px">${BIN_LB[src]}</div>`;
      if(ITEMS[k])h+=`<div class="q3badge q3sm" style="left:${dx+98}px;top:984px" id="q3n_${k}"></div>`;
    });
    if(binsOwn.length<BIN_K.length){
      const hx=15+124*binsOwn.length,hw=124*(BIN_K.length-binsOwn.length);
      patch=`<div class="q3patch" style="left:${hx}px;top:948px;width:${hw}px;height:194px"></div>`;
    }
    BTL_K.filter(k=>S.unlocked[k]).forEach(k=>{
      const i0=BTL_K.indexOf(k),i=spr.split('data-btl').length-1,sx=BTL_X[i0],x=BTL_X[i];
      spr+=`<div class="q3spr" data-btl style="left:${x-31}px;top:1160px;width:62px;height:200px;background-position:${-(sx-31)}px -1160px;"></div>`;
      h+=zone(`data-a="flav:${k}" id="q3b_${k}" data-s="${sx-29},1166" aria-label="Siro ${ITEMS[k].n}"`,x-29,1166,58,190);
      h+=`<div class="q3badge q3sm" style="left:${x+6}px;top:1206px" id="q3n_${k}"></div>`;
    });
  } else {
    // Địa điểm Khởi Nghiệp: Ảnh nền nghệ thuật đã có sẵn minh hoạ hũ và chai theo phong cách địa phương
    // Không chèn .q3spr và .q3patch để giữ trọn vẹn nét vẽ độc bản
    binsOwn.forEach(([k,src],i)=>{
      const sx=15+124*src,dx=15+124*i;
      const a=k==='ice'?'data-a="ice" id="q3b_ice"':k==='sugar'?'data-a="sugar" id="q3b_sugar"':`data-a="top:${k}" id="q3b_${k}"`;
      h+=zone(`${a} data-s="${sx+4},975" aria-label="${BIN_LB[src].replace('<br>',' ')}"`,dx+4,975,116,158);
      h+=`<div class="q3lbT" style="left:${dx+10}px;top:1097px;width:104px;height:34px">${BIN_LB[src]}</div>`;
      if(ITEMS[k])h+=`<div class="q3badge q3sm" style="left:${dx+98}px;top:984px" id="q3n_${k}"></div>`;
    });
    BTL_K.filter(k=>S.unlocked[k]).forEach(k=>{
      const i0=BTL_K.indexOf(k),sx=BTL_X[i0];
      h+=zone(`data-a="flav:${k}" id="q3b_${k}" data-s="${sx-29},1166" aria-label="Siro ${ITEMS[k].n}"`,sx-29,1166,58,190);
      h+=`<div class="q3badge q3sm" style="left:${sx+6}px;top:1206px" id="q3n_${k}"></div>`;
    });
  }
  $('view').innerHTML=`<div id="q3"><div id="q3stage" class="${curThemeCls}" style="background-image:url('${encodeURI(initBgUrl)}');background-size:768px 1376px;background-repeat:no-repeat;background-position:center top;">
    ${patch}<div id="q3tint" aria-hidden="true"></div>${(evIs('rain')||evIs('storm'))?'<div id="q3rain" aria-hidden="true"><i class="r1"></i><i class="r2"></i></div>':''}
    <div class="q3-location-tag" id="q3LocTag" title="Địa điểm: ${esc(curLoc.name)} (${esc(curLoc.region)}) - Nhấn xem chi tiết">
      <span>${curLoc.icon} ${esc(curLoc.name)}</span>
    </div>
    <div id="q3partyWrap" class="q3-party-wrap" style="${(R.party && S.partyContract) ? '' : 'display:none;'}">
      <div class="q3-party-inner">
        <div class="q3-party-title" id="q3partyTitle">${S.partyContract ? esc(S.partyContract.title) : ''}</div>
        <div class="q3-party-progress-box">
          <div class="q3-party-bar"><div class="q3-party-bar-fill" id="q3partyFill" style="width:0%"></div></div>
          <span class="q3-party-count" id="q3partyCount">0/0 ly</span>
        </div>
        <button class="q3-party-pack-btn" id="q3partyPackBtn" title="Đóng gói ly trên thớt cho đơn tiệc">📦 Đóng ly tiệc</button>
      </div>
    </div>
    <button id="q3FrontBtn" class="q3-front-btn" title="Quản lý Chuỗi Chi Nhánh">🏢 Chi Nhánh</button>
    <div class="q3lane" id="lane"></div>
    <div class="q3face" id="q3face" aria-hidden="true"></div>
    <div class="q3bub" id="q3bub"><div id="q3want" aria-hidden="true"></div><div id="q3say"></div><div class="q3pat"><span>KIÊN NHẪN</span><div class="q3bar"><i id="q3pat"></i></div></div></div>
    <div class="q3tag" style="left:30px;top:327px;width:108px;height:30px">QUẦY TRÀ</div>
    <button type="button" id="q3CrushBtn" class="q3-crush-btn" title="Trà Sữa Crush 🍬 (Vừa chơi kẹo vừa tự động bán nước!)">
      <div class="q3-crush-inner">
        <span class="q3-crush-emoji">🍬</span>
      </div>
      <span class="q3-crush-badge" id="q3CrushBadge">AUTO</span>
    </button>
    <button type="button" id="q3PhoneBtn" class="q3-phone-btn" title="Mạng Xã Hội (Trà Sữa Feed)">
      <img src="img/ic_phone.png" class="q3-phone-img" alt="Mạng Xã Hội">
      <span class="q3-phone-badge" id="q3PhoneBadge" style="display:none;">0</span>
    </button>
    ${renderCounterPetHtml()}
    ${renderCounterDecorsHtml()}
    <div id="q3sprs">${spr}</div><div id="q3pops"></div><div id="q3zones">${h}</div>
    <div id="q3noCup">Lấy ly<br>M hoặc L</div><div id="q3cup" aria-hidden="true"></div>
    <div class="q3gauge"><div class="q3lv" id="q3gLv"></div><div class="q3ok"></div></div><div id="q3hint"></div><button type="button" id="q3LobbyBtn" class="q3-lobby-btn" title="Ra sảnh bàn ghế phục vụ khách"><span class="q3-lobby-txt">Ra sảnh</span><span class="q3-lobby-arr">➔</span><span class="q3-lobby-badge" id="q3LobbyBadge" style="display:none;"></span></button><div id="q3coach" hidden></div>
  </div></div><div class="staff-bar-wrap" id="staffBarWrap"><div id="buyerWidget" class="buyer-widget" style="display:none"></div><div id="svWidget" class="gz-widget sv-widget" style="display:none"></div><button type="button" id="btnFakePolice" class="fake-police-bottom-btn" style="display:none;" title="Tố cáo khách đưa tiền giả"></button><div id="gzWidget" class="gz-widget" style="display:none"></div></div>`;
  if($('q3FrontBtn') && typeof openChiNhanhView === 'function') $('q3FrontBtn').onclick = openChiNhanhView;
  if($('q3CrushBtn') && typeof openCrushAutoSellMode === 'function') $('q3CrushBtn').onclick = openCrushAutoSellMode;
  if($('q3PhoneBtn') && typeof openMxhView === 'function') $('q3PhoneBtn').onclick = openMxhView;
  if($('q3LobbyBtn')) $('q3LobbyBtn').onclick = () => { if(typeof openLobbyView === 'function') openLobbyView(); };
  try { if(window.Lobby && typeof window.Lobby.updateBtnBadge === 'function') window.Lobby.updateBtnBadge(); } catch(e){}
  if($('q3partyPackBtn') && typeof packCupForParty === 'function') $('q3partyPackBtn').onclick = packCupForParty;
  if($('q3LocTag')) $('q3LocTag').onclick = () => { toast(`${curLoc.icon} ${curLoc.name}: 🟢 ${(curLoc.pros && curLoc.pros[0]) || ''} | 🔴 ${(curLoc.cons && curLoc.cons[0]) || ''}`, 4500); };
  try { renderPartyWidget(); } catch(e){}
  try { if(R.rushHourActive) renderRushHourBanner(); } catch(e){}
  try { if(R.combo) updateComboWidget(R.combo, false); } catch(e){}
  const st=$('q3stage');
  if(st){
    st._defSpr = defSpr;
    applyStageBackground(st, locBg);
  }
  st.onclick=e=>{
    const cpBtn=e.target.closest('#q3capbi');if(cpBtn){onCounterCapbiClick(e);return;}
    const pBtn=e.target.closest('#q3pet');if(pBtn){onCounterPetClick(e);return;}
    const dNeko=e.target.closest('#decorNeko');if(dNeko){toast('🐱 Mèo Thần Tài: Đang ban phước +10% tiền tip cho mọi ly trà! ✨');try{sfx('coin');}catch(_){}return;}
    const dPlant=e.target.closest('#decorPlant');if(dPlant){toast('🪴 Sen Đá Cát Tường: Thanh lọc không khí, khách kiên nhẫn thêm +3s! 🌿');try{sfx('tap');}catch(_){}return;}
    const dRadio=e.target.closest('#decorRadio');if(dRadio){toast('📻 Đài Cassette Lofi: Âm nhạc du dương giúp không gian thêm chill! 🎵');try{sfx('tap');}catch(_){}return;}
    const dx=e.target.closest('[data-decl]');if(dx){const id=+dx.dataset.decl,i=R.slots.findIndex(c=>c&&c.id===id);if(i>=0){decline(i);toast('Đã mời khách về');renderPanel()}else{const j=R.online.findIndex(c=>c.id===id);if(j>=0){declineOnline(j);toast('Đã huỷ đơn online')}}return}
    const ch=e.target.closest('[data-fc]');if(ch){const id=+ch.dataset.fc;if(isStaff2WorkingOn(id)){toast('Nhân viên pha chế đang lo đơn này');return}if((R.sto&&R.sto.id===id)||(R.stoWorkers&&R.stoWorkers.some(w=>w&&w.id===id))){toast('Nhân viên đơn online đang lo đơn này');return}R.playerSelectedCustId=id;R.focus=id;renderLane();renderPanel();coach();return}
    const cv=e.target.closest('[data-cv]');if(cv){const c=focusCust();const j=+cv.dataset.cv;if(c&&!c.done[j]){c.order=c.cups[j];R.playerSelectedCustId=c.id;R.focus=c.id;renderLane();renderPanel()}return}
    const dc=e.target.closest('[data-decl]');if(dc){const i=R.slots.findIndex(c=>c&&c.id===+dc.dataset.decl);if(i>=0)decline(i);return}
    if(!R.running||R.paused||R.sealing)return;const b=e.target.closest('[data-a]');if(b)q3act(b.dataset.a,b)};
  const gzw=$('gzWidget');if(gzw){gzw.onclick=onGzWidgetClick;gzw.onpointerdown=onGzWidgetClick}
  const svw=$('svWidget');if(svw){svw.onclick=onSvWidgetClick};const bw=$('buyerWidget');if(bw){bw.onclick=onBuyerWidgetClick}
  const pb=$('btnFakePolice');if(pb){pb.onclick=()=>reportFakeMoneyPolice()}
  const zs=$('q3zones');
  zs.addEventListener('pointerdown',e=>{const u=e.target.closest('[data-tea]');if(!u||!R.running||R.paused||R.sealing)return;e.preventDefault();try{u.setPointerCapture(e.pointerId)}catch(_){}startPour(u.dataset.tea,u)});
  ['pointerup','pointercancel','lostpointercapture'].forEach(ev=>zs.addEventListener(ev,stopPour));
  zs.addEventListener('keydown',e=>{const u=e.target.closest('[data-tea]');if(u&&(e.key===' '||e.key==='Enter')&&!e.repeat&&!R.pour){e.preventDefault();startPour(u.dataset.tea,u)}});
  zs.addEventListener('keyup',e=>{if(e.key===' '||e.key==='Enter')stopPour()});
  zs.addEventListener('contextmenu',e=>e.preventDefault());
  q3fit();renderLane();renderCup();renderPanel();renderGzWidget();renderBuyerWidget();renderSvWidget();renderFakeAlertBtn();initCounterPet();head();
  const q=$('q3');q.addEventListener('scroll',()=>{q.scrollTop=0;q.scrollLeft=0});[120,500,1500].forEach(t=>setTimeout(q3re,t));
}
/* Chrome Android bật "Trang web cho máy tính" → trang bị thu nhỏ; phóng lại cho vừa màn hình điện thoại */
const ZM=(()=>{try{const sw=screen.width,coarse=matchMedia('(pointer:coarse)').matches||navigator.maxTouchPoints>0;
  if(coarse&&sw>0&&sw<=820&&innerWidth>sw*1.35){const z=innerWidth/sw;document.documentElement.style.zoom=z;return z}}catch(e){}return 1})();
const vpW=()=>innerWidth/ZM,vpH=()=>innerHeight/ZM;
/* chừa mép dưới: vuốt ngang ở mép dưới iPhone là chuyển sang app khác (Zalo…) */
let _sab=null;function botGap(){if(_sab==null){const d=document.createElement('div');d.style.cssText='position:fixed;bottom:0;height:0;padding-bottom:env(safe-area-inset-bottom,0px);visibility:hidden';document.body.appendChild(d);_sab=d.offsetHeight||0;d.remove()}
  const touch=matchMedia('(pointer:coarse)').matches||navigator.maxTouchPoints>0;return touch?Math.max(_sab,10)+18:0}
function q3fit(){const q=$('q3');if(!q)return;const hd=document.querySelector('header'),aw=document.querySelector('.app>.awning');
  if(scrollX||scrollY)scrollTo(0,0);q.scrollTop=0;q.scrollLeft=0;
  const isMini = document.body.classList.contains('mini-window-active');
  const vv=window.visualViewport,vh=isMini ? 860 : (vpNow()/ZM),vw=isMini ? 430 : ((vv&&vv.width>100?Math.min(innerWidth,vv.width):innerWidth)/ZM);
  const top=isMini ? ((hd ? hd.offsetHeight : 45) + (aw ? aw.offsetHeight : 26)) : Math.max(0,Math.round((aw||hd).getBoundingClientRect().bottom/ZM)),W=vw,H=vh-top-botGap(),s=Math.min(W/768,H/(1376-Q3Y));
  q.style.top=top+'px';q.style.height=H+'px';q.style.bottom='auto';const st=$('q3stage');st.style.transform=`scale(${s})`;st.style.left=Math.max(0,(W-768*s)/2)+'px';st.style.top=(-Q3Y*s)+'px'}
function q3re(){if(R.mode==='sell')q3fit()}
addEventListener('resize',q3re);addEventListener('orientationchange',()=>setTimeout(q3re,300));addEventListener('pageshow',q3re);document.addEventListener('visibilitychange',()=>{if(!document.hidden)[0,300].forEach(t=>setTimeout(q3re,t))});addEventListener('load',q3re);
addEventListener('scroll',()=>{if(R.mode==='sell'&&(scrollX||scrollY))scrollTo(0,0)},{passive:true});
if(window.visualViewport){visualViewport.addEventListener('resize',q3re);visualViewport.addEventListener('scroll',q3re)}
/* iPhone (thêm vào MH chính): bàn phím đẩy trang lên và không trả về → tự kéo lại */
const isField=el=>el&&/INPUT|TEXTAREA|SELECT/.test(el.tagName)&&!/^(checkbox|radio|button|file|range|color)$/.test(el.type||'');
/* đang gõ: ẩn thanh Nấu & nhập / Mở cửa để không nổi đè lên ô nhập. Chuyển ô bằng mũi tên ^ v thì không kéo trang */
let kbT=null;
addEventListener('focusin',e=>{if(!isField(e.target))return;clearTimeout(kbT);document.body.classList.add('kbopen')});
addEventListener('focusout',()=>{clearTimeout(kbT);kbT=setTimeout(()=>{if(isField(document.activeElement))return;
  document.body.classList.remove('kbopen');
  /* bàn phím đóng hẳn: chỉ kéo lại nếu trang bị đẩy quá cuối */
  const mx=Math.max(0,document.documentElement.scrollHeight-innerHeight);if(scrollY>mx)scrollTo(0,mx);
  if(R.mode==='sell')q3fit()},350)});
/* iPhone (app trên MH chính): sau khi bàn phím đóng, khung nhìn đôi khi kẹt ở chiều cao lúc còn bàn phím (thấp hơn màn hình thật cỡ 340-360px).
   Game đo lại, và nếu thấy kẹt thì tự dùng chiều cao màn hình thật cho quầy pha, nút Mở cửa và hộp thoại */
const IOS_APP=(()=>{try{return /iP(hone|od)/.test(navigator.userAgent)&&(navigator.standalone===true||matchMedia('(display-mode: standalone)').matches)}catch(e){return false}})();
let VPFIX=0,vpGood=0,kbUsed=0;
/* chỉ sửa khi vừa dùng bàn phím (trong 2 phút) và khung nhìn hụt hẳn (dưới 72% màn hình, cỡ chiều cao lúc còn bàn phím) */
addEventListener('focusin',e=>{if(isField(e.target))kbUsed=Date.now()});
function vpNow(){const vv=window.visualViewport,h=(vv&&vv.height>100?Math.min(innerHeight,vv.height):innerHeight);
  if(IOS_APP&&innerWidth<=520&&kbUsed&&Date.now()-kbUsed<120000&&!isField(document.activeElement)){const sh=Math.max(screen.height,screen.width);
    if(innerHeight<sh*.72){VPFIX=vpGood&&vpGood>innerHeight?vpGood:Math.round(sh*.94);return VPFIX}}
  if(h>=Math.max(screen.height,screen.width)*.8)vpGood=h;
  VPFIX=0;return h}
function vpSync(){if(!IOS_APP||!document.body)return;if(!kbUsed||Date.now()-kbUsed>120000){if(VPFIX){VPFIX=0;document.body.classList.remove('vpfix')}return}const was=VPFIX;vpNow();
  document.body.classList.toggle('vpfix',!!VPFIX);document.documentElement.style.setProperty('--vpfix',VPFIX+'px');
  if(VPFIX&&!was){try{scrollTo(0,0)}catch(e){}}
  if(VPFIX!==was&&R.mode==='sell')q3fit()}
if(IOS_APP){['resize','orientationchange','pageshow','focusout','load'].forEach(e=>addEventListener(e,()=>{vpSync();[150,500,1200].forEach(t=>setTimeout(vpSync,t))}));
  if(window.visualViewport)visualViewport.addEventListener('resize',vpSync);document.addEventListener('visibilitychange',()=>{if(!document.hidden)[0,300,900].forEach(t=>setTimeout(vpSync,t))});vpSync()}
if(document.fonts&&document.fonts.ready)document.fonts.ready.then(q3re);
function isSto(c){ return !!(c && R && ((R.sto && c.id === R.sto.id) || (R.stoWorkers && R.stoWorkers.some(w => w && w.id === c.id)))); }
function isSt(c){ return !!(c && isStaff2WorkingOn(c.id)); }
function pSlots(){
  if(!R || !R.slots) return [];
  const sorted = R.slots.filter(Boolean).sort((a, b) => a.id - b.id);
  const firstId = sorted[0] ? sorted[0].id : null;
  return R.slots.map(c => {
    if(!c) return null;
    if(c.id === firstId) return c; // Khách đầu tiên tại quầy luôn hiển thị và không bao giờ bị ẩn khỏi quầy
    return isSt(c) ? null : c;
  });
}

function focusCust(){
  const allSlots = (R && R.slots) ? R.slots.filter(Boolean).sort((a, b) => a.id - b.id) : [];
  const firstSlotCust = allSlots[0] || null;

  // 1. Nếu người chơi chủ động bấm chọn khách cụ thể trên màn hình, ưu tiên giữ khách đó
  if(R.playerSelectedCustId){
    const all = [...pSlots().filter(Boolean), ...(R && R.online ? R.online.filter(c => !isSto(c)) : [])];
    const playerTarget = all.find(c => c.id === R.playerSelectedCustId);
    if(playerTarget){
      R.focus = playerTarget.id;
      return playerTarget;
    }
    R.playerSelectedCustId = null;
  }

  // 2. Chuẩn Quản lý tập sự & Gen Z tại quầy: Luôn luôn phục vụ Khách đầu tiên tại quầy (firstSlotCust)!
  // Tuyệt đối không bao giờ để khách đầu tiên bị thợ pha chế tranh hay bị bỏ rơi.
  if(firstSlotCust){
    // Nếu có thợ pha chế lỡ nhận khách đầu tiên này từ trước, lập tức giải phóng thợ để Gen Z / Quản lý làm
    if(Array.isArray(R.st2Workers)){
      const wIdx = R.st2Workers.findIndex(w => w && w.id === firstSlotCust.id);
      if(wIdx >= 0) R.st2Workers.splice(wIdx, 1);
    }
    if(R.st2 && R.st2.id === firstSlotCust.id) R.st2 = null;

    // Gen Z & SV ca đêm: Luôn luôn phục vụ khách đầu tiên tại quầy (firstSlotCust)!
    // Nếu có tác vụ dở dang của khách khác (không phải khách đầu), lập tức huỷ tác vụ đó để quay lại khách đầu
    if(R.gzWork && R.gzWork.cId && R.gzWork.cId !== firstSlotCust.id){
      clearStaffPouring();
      R.gzWork = null;
      if(cup && cup.staff) cup = newCup();
    }
    if(R.svWork && R.svWork.cId && R.svWork.cId !== firstSlotCust.id){
      clearStaffPouring();
      R.svWork = null;
      if(cup && cup.staff) cup = newCup();
    }

    R.focus = firstSlotCust.id;
    return firstSlotCust;
  }

  // 3. Nếu ở quầy không còn khách nào, phục vụ đơn online đến sớm nhất
  const onl = (R && R.online ? R.online.filter(c => !isSto(c)) : []).sort((a, b) => a.id - b.id);
  let f = onl.find(c => c.id === R.focus) || onl[0] || null;
  R.focus = f ? f.id : null;
  return f;
}
function shipBg(row,e,w,h){
  if(row >= 2){
    const r2 = (row - 2) % 5;
    return `background-image:url(${IMG}ship2.webp);background-size:${w*3}px ${h*5}px;background-position:${-e*w}px ${-r2*h}px;background-repeat:no-repeat`;
  }
  return `background-image:url(${IMG}ship.webp);background-size:${w*3}px ${h*2}px;background-position:${-e*w}px ${-row*h}px;background-repeat:no-repeat`;
}
const hasFace=c=>c&&(c.who!=null||c.ship!=null||c.star!=null),faceOf=(c,e,w,h)=>c.star!=null?starBg(STARS[c.star].f,e,w,h):c.ship!=null?shipBg(c.ship,e,w,h):faceBg(c.who,e,w,h,c.faceSet),faceRow=c=>c.star!=null?STARS[c.star].f:c.ship!=null?c.ship:c.who;
function faceBg(who,e,w,h,set){
  if(set === 2 || (who != null && who >= 9)){
    const r = Math.abs(who || 0) % 20;
    return `background-image:url(${IMG}faces2.webp);background-size:${w*3}px ${h*20}px;background-position:${-e*w}px ${-r*h}px;background-repeat:no-repeat`;
  }
  const r = Math.abs(who || 0) % 9;
  return `background-image:url(${IMG}faces.webp);background-size:${w*3}px ${h*9}px;background-position:${-e*w}px ${-r*h}px;background-repeat:no-repeat`;
}

function renderGzHeadCup(w, c){
  if(!w || !c) return '';
  const showChide = w.chide && Date.now() < (w.chideUntil || 0);
  const isSv = w.staff === 'sv';
  // Đã xoá bỏ hoàn toàn ly nước và thanh chữ bên dưới avatar khách theo yêu cầu người chơi
  const chideHtml = showChide ? `<div class="gz-chide-bubble">${isSv ? '🥱' : '😤'} ${esc(w.chide)}</div>` : '';
  return chideHtml;
}
function renderCustChip({c,a}, f){
  const r=Math.min(1,Math.max(0,c.pat/(c.max||1))),on=f&&c.id===f.id,left=c.done.filter(x=>!x).length;
  const stc=isSt(c);
  const isGzWorking = isStaffActive('staffGz') && (R.gzWork && R.gzWork.cId === c.id);
  const isSvWorking=(R.svWork&&R.svWork.cId===c.id);
  const staffWorking = isGzWorking ? { ...R.gzWork, staff: 'gz' } : (isSvWorking ? { ...R.svWork, staff: 'sv' } : null);
  const gzHeadHtml=staffWorking?renderGzHeadCup(staffWorking,c):'';
  const isBranchCust = c.fromBranch || (c.name && c.name.includes('[chi-nhánh]'));
  return `<button class="q3chip${on?' q3on':''}${stc?' q3stc':''}${c.born&&performance.now()-c.born<700?' q3in':''}${c.isSpecialCust?(c.specialEffect&&c.specialEffect.type==='buff'?' special-cust-buff':' special-cust-debuff'):''}${c.isSpecialRecipeGuest?' special-recipe-vip':''}${c.isFriend?' friend-vip':''}${c.isTiktoker?' tiktoker-glow-vip':(c.vip?' reviewer-vip':'')}" ${a} data-fc="${c.id}" aria-label="${esc(c.name)}" style="--p:${r};--c:${r>.5?'#5aae86':r>.25?'#f4b73a':'#e2574c'}">
    ${gzHeadHtml}${c.customAvatar?`<span class="q3fc" style="display:flex;align-items:center;justify-content:center;background:none;"><img src="${c.customAvatar}" alt="" style="width:36px;height:36px;object-fit:contain;pointer-events:none;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.25));"></span>`:c.star!=null?`<i class="q3fc" style="${starBg(STARS[c.star].f,r<.3?2:0,44,43)}"></i>`:c.ship!=null?`<i class="q3fc" style="${shipBg(c.ship,r<.45?2:0,44,43)}"></i>`:(c.isSpecialRecipeGuest||c.isFriend||c.vip||(typeof c.face==='string'&&/^b\d+$/.test(c.face)))?`<span class="q3fc" style="display:flex;align-items:center;justify-content:center;background:none;">${(typeof c.face==='string'&&/^b\d+$/.test(c.face))?`<img src="${IMG}brand/${c.face}.png" alt="" style="width:34px;height:34px;object-fit:contain;pointer-events:none;">`:c.face||'😎'}</span>`:hasFace(c)?`<i class="q3fc" style="${faceOf(c,r<.3?2:0,44,43)}"></i>`:'<i class="q3fc q3ph" style="font-size:22px;">📱</i>'}${c.app?`<b class="q3app" style="background:${(APPS.find(a=>a.id===c.app)||APPS[0]).c}">${ico('phone')}</b>`:''}${left>1?`<b class="q3n">×${left}</b>`:''}${isStaff2WorkingOn(c.id)||isSto(c)?`<b class="q3st">${ico('people')}</b>`:''}${(isStaffActive('staffGz') && !R.isNightShift && ((f && c.id === f.id) || (R.gzWork && R.gzWork.cId === c.id))) ? `<b class="q3st" style="background:#8b5cf6;" title="Gen Z đang phục vụ">🎧</b>` : ''}${(isStaffActive('staffSv') && R.isNightShift && ((f && c.id === f.id) || (R.svWork && R.svWork.cId === c.id))) ? `<b class="q3st" style="background:#4338ca;" title="Sinh viên đang phục vụ">🎓</b>` : ''}${isBranchCust?`<b class="q3st" style="background:#0284c7;color:#fff;" title="Khách từ chi nhánh">🏢</b>`:''}${c.isSpecialCust&&c.specialEffect?`<b class="q3st" style="background:${c.specialEffect.type==='buff'?'linear-gradient(135deg,#10b981,#059669)':'linear-gradient(135deg,#ef4444,#dc2626)'};color:#fff;font-size:10px;" title="${esc(c.specialEffect.name)}: ${esc(c.specialEffect.desc)}">${c.specialEffect.icon}</b>`:''}${c.isSpecialRecipeGuest?`<b class="q3st" style="background:linear-gradient(135deg,#f59e0b,#ea580c);color:#fff;" title="Khách Thẩm Định Đặc Biệt">👑</b>`:''}${c.isTiktoker?`<b class="q3vip tiktoker-badge-tag" style="font-size:9px;padding:0 3px;" title="Food Tiktoker ${esc(c.tiktokerInfo?c.tiktokerInfo.followers:'1M+')}">🎬</b>`:c.vip?`<b class="q3vip" style="background:#e11d48;" title="Food Reviewer">🎙️</b>`:''}${c.isFriend?`<b class="q3friend-vip" title="VIP Bạn Bè">👑</b>`:''}${!stc&&missing(c.order).length?`<b class="q3so">Hết</b><span class="q3x" data-decl="${c.id}" role="button" aria-label="${R.slots.includes(c)?'Mời khách về':'Huỷ đơn online'}">×</span>`:''}</button>`;
}
function renderLane(){
  const L=$('lane');if(!L)return;const f=focusCust();
  const onlineItems = (R.online||[]).map((c,j)=>({c, a:`data-on="${j}"`})).sort((x,y)=>x.c.id-y.c.id);
  const counterItems = (R.slots||[]).map((c,i)=>c&&{c, a:`data-slot="${i}"`}).filter(Boolean).sort((x,y)=>x.c.id-y.c.id);

  const isClosingState = !!(R && (R.closing || (R.isNightShift ? R.nightT <= 0 : R.t <= 0)));
  const closeBarBanner = isClosingState ? `
    <div style="position:absolute;top:-26px;left:0;right:0;height:24px;display:flex;align-items:center;justify-content:space-between;gap:8px;background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;padding:0 10px;border-radius:8px;font-size:0.72rem;font-weight:800;box-shadow:0 2px 6px rgba(234,88,12,0.35);z-index:30;box-sizing:border-box;">
      <span>${R.isNightShift ? '🌅 06:00: Hết ca đêm' : '🌙 22:00: Hết giờ bán'}</span>
      <button type="button" class="sbtn sm" style="background:#fff;color:#c2410c;border:none;padding:2px 8px;border-radius:6px;font-size:0.70rem;font-weight:900;cursor:pointer;flex:none;" onclick="window.forceEndDayNow && window.forceEndDayNow()">🛑 Kết ca ➜</button>
    </div>
  ` : '';

  const onlineChipsHtml = onlineItems.length > 0 
    ? onlineItems.map(item => renderCustChip(item, f)).join('')
    : `<span class="q3lane-empty-txt">Chưa có đơn online</span>`;

  const counterChipsHtml = counterItems.length > 0 
    ? counterItems.map(item => renderCustChip(item, f)).join('')
    : `<span class="q3lane-empty-txt">Đang đợi khách ghé quầy…</span>`;

  L.className = 'q3lane q3lane-split';
  L.innerHTML = closeBarBanner + `
    <div class="q3lane-row q3lane-row-online">
      <div class="q3lane-tag online" title="Hàng 1: Các đơn đặt online">
        <span class="q3lane-tag-ic">🛵</span>
        <span class="q3lane-tag-tx">Online</span>
        <span class="q3lane-tag-cnt">${onlineItems.length}</span>
      </div>
      <div class="q3lane-track">${onlineChipsHtml}</div>
    </div>
    <div class="q3lane-row q3lane-row-counter">
      <div class="q3lane-tag counter" title="Hàng 2: Khách mua tại quầy">
        <span class="q3lane-tag-ic">🧋</span>
        <span class="q3lane-tag-tx">Tại quầy</span>
        <span class="q3lane-tag-cnt">${counterItems.length}</span>
      </div>
      <div class="q3lane-track">${counterChipsHtml}</div>
    </div>
  `;
  const fc=$('q3face'),say=$('q3say');
  if(!f){
    coach();fc._id=null;fc.style.cssText='';fc.className='q3face';say._t=null;$('q3bub').classList.add('q3idleB');
    const hasWaiting = !!(R && ((R.slots && R.slots.some(Boolean)) || (R.online && R.online.length > 0)));
    const closeBtnHtml = isClosingState ? `<div style="margin-top:6px;"><button type="button" class="sbtn sm pri" style="padding:5px 12px;font-size:0.8rem;font-weight:800;border-radius:10px;background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;border:none;cursor:pointer;box-shadow:0 2px 6px rgba(234,88,12,0.4);" onclick="window.forceEndDayNow && window.forceEndDayNow()">🛑 Đóng ca &amp; Tổng kết ngay ➜</button></div>` : '';
    const idleTitle = isClosingState ? (hasWaiting ? '🌙 Làm nốt đơn sau 10h' : 'Đã đóng cửa') : (R.running&&rushMul()<.6 ? 'Quán đang vắng' : 'Đang chờ khách…');
    const idleSub = isClosingState ? (hasWaiting ? 'Phục vụ xong hết khách sẽ tự động kết ca' : 'Quán đã hết khách, sẵn sàng đóng sổ kết toán') : 'Ngồi chơi xíu đi';
    say.innerHTML=`<span class="q3idle">${idleTitle}<small>${idleSub}</small>${closeBtnHtml}</span>`;
    $('q3want').innerHTML='';$('q3want')._o=null;$('q3pat').style.width='0';return;
  }
  if(fc._id!==f.id){fc._id=f.id;if(!q3reduce){try{if(fc._anim)fc._anim.cancel();fc._anim=fc.animate([{transform:'translateX(-150px) rotate(-6deg)',opacity:0},{transform:'translateX(-60px) rotate(4deg)',opacity:1,offset:.5},{transform:'translateX(-20px) rotate(-3deg)',offset:.75},{transform:'none'}],{duration:650,easing:'ease-out'})}catch(e){}}}
  const isChibiFace = f && typeof f.face === 'string' && /^b\d+$/.test(f.face);
  if(f.customAvatar){
    fc.className='q3face'+(f.isSpecialCust?(f.specialEffect&&f.specialEffect.type==='buff'?' special-cust-buff':' special-cust-debuff'):'');
    fc.style.cssText='top:165px;display:flex;align-items:center;justify-content:center;background:none;position:relative;';
    fc.innerHTML=`<img src="${f.customAvatar}" alt="" style="max-height:140px;max-width:140px;object-fit:contain;filter:drop-shadow(0 4px 12px rgba(0,0,0,0.45));"><div style="position:absolute;bottom:15px;right:6px;background:${f.specialEffect&&f.specialEffect.type==='buff'?'linear-gradient(135deg,#10b981,#059669)':'linear-gradient(135deg,#ef4444,#dc2626)'};color:#fff;border-radius:12px;padding:2px 8px;font-size:0.75rem;font-weight:900;display:flex;align-items:center;gap:3px;box-shadow:0 2px 6px rgba(0,0,0,0.4);border:1px solid rgba(255,255,255,0.4);"><span>${f.specialEffect?f.specialEffect.icon:'✨'}</span><span>${f.specialEffect&&f.specialEffect.type==='buff'?'BUFF':'DEBUFF'}</span></div>`;
  } else if(f.star!=null){
    fc.innerHTML='';
    fc.className='q3face';
    fc.style.cssText=starBg(STARS[f.star].f, f.pat/f.max<.3?2:0, 144, 141);
  } else if(f.ship!=null){
    fc.innerHTML='';
    fc.className='q3face';
    fc.style.cssText=shipBg(f.ship, f.pat/f.max<.3?2:0, 144, 141);
  } else if(isChibiFace){
    fc.className='q3face';
    fc.style.cssText='display:flex;align-items:center;justify-content:center;background:none;';
    fc.innerHTML=`<img src="${IMG}brand/${f.face}.png" alt="" style="width:125px;height:125px;object-fit:contain;">`;
  } else if(f.isSpecialRecipeGuest){
    fc.className='q3face';
    fc.style.cssText='font-size:5rem;display:flex;align-items:center;justify-content:center;background:none;';
    fc.textContent='👑';
  } else if(f.isFriend){
    fc.className='q3face';
    fc.style.cssText='font-size:5rem;display:flex;align-items:center;justify-content:center;background:none;';
    fc.textContent=f.face||'😎';
  } else if(f.vip){
    fc.className='q3face';
    fc.style.cssText='font-size:5rem;display:flex;align-items:center;justify-content:center;background:none;';
    fc.textContent='🎙️';
  } else {
    fc.innerHTML='';
    fc.className='q3face'+(!hasFace(f)?' q3ph':'');fc.style.cssText=hasFace(f)?faceOf(f,f.pat/f.max<.3?2:0,144,141):'';fc.textContent=!hasFace(f)?'📱':'';
  }
  const n=f.cups.length,online=R.online.includes(f);
  const isBranchCust = f.fromBranch || (f.name && f.name.includes('[chi-nhánh]'));
  const specialCustTag = (f.isSpecialCust && f.specialEffect) ? `<span class="q3vipT" style="background:${f.specialEffect.type==='buff'?'linear-gradient(135deg,#10b981,#059669)':'linear-gradient(135deg,#ef4444,#dc2626)'};color:#fff;font-weight:800;box-shadow:0 2px 6px rgba(0,0,0,0.25);">✨ Khách Đặc Biệt: ${esc(f.name)} [${f.specialEffect.type==='buff'?'BUFF':'DEBUFF'} ${f.specialEffect.icon} ${esc(f.specialEffect.name)}: ${esc(f.specialEffect.desc)}]</span> ` : '';
  let t=online?`<span class="q3vipT" style="background:${(APPS.find(a=>a.id===f.app)||APPS[0]).c}">${appN(f)}</span> <b>${f.big?'Đơn lớn':'Đơn'} #${f.id}</b>: ${shortOrder(f.order)}${isBranchCust ? ' <span class="q3vipT" style="background:#0284c7;color:#fff;font-weight:800;">🏢 [chi-nhánh]</span>' : ''}`:(f.star!=null?`<span class="q3vipT" style="background:#9b5fd0">⭐ ${esc(STARS[f.star].n)}</span> `+(performance.now()-f.born<3500?`<span class="q3nat">${esc(f.hi)}</span>`:`<small class="q3tr">[Tự động dịch]</small> `):'')+specialCustTag+(f.isSpecialRecipeGuest?`<span class="q3vipT" style="background:linear-gradient(135deg,#eab308,#ea580c);color:#fff;font-weight:800;box-shadow:0 2px 6px rgba(234,88,12,0.4);">👑 Khách Thẩm Định: ${esc(f.name)} (${esc(f.specialRecipe?f.specialRecipe.name:'Món đặc biệt')})</span> `:'')+(f.isFriend?`<span class="q3vipT" style="background:#eab308;color:#000;">👑 VIP Bạn: ${esc(f.name)}</span> `:'')+(isBranchCust ? `<span class="q3vipT" style="background:#0284c7;color:#fff;font-weight:800;">🏢 [chi-nhánh]</span> ` : '')+(f.isTiktoker?`<span class="q3vipT tiktoker-badge-tag">🎬 TIKTOKER ${esc(f.tiktokerInfo?f.tiktokerInfo.followers:'1M+')}: ${esc(f.tiktokerInfo?f.tiktokerInfo.channel:'@tiktok')}</span> `:(f.star!=null&&performance.now()-f.born<3500?'':(f.vip?'<span class="q3vipT" style="background:#e11d48;color:#fff;font-weight:800;">🎙️ Food reviewer</span> ':'')))+(f.brat&&BRATS[f.brat]&&BRATS[f.brat].n?`<span class="q3vipT" style="background:${BRATS[f.brat].c};color:#fff;font-weight:800;">${f.brat==='mac'?'💸 Khách mặc cả':f.brat==='thieu'?'🪙 Khách trả thiếu':BRATS[f.brat].n}</span> `:'')+sentence(f);
  if(n>5)t=`<span class="q3tabs"><span class="q3cur">Ly ${f.cups.indexOf(f.order)+1}/${n}</span><span class="q3dn">✓ ${f.done.filter(Boolean).length}</span></span> `+t;
  else if(n>1)t=`<span class="q3tabs">${f.cups.map((x,j)=>`<span class="${f.done[j]?'q3dn':x===f.order?'q3cur':''}" data-cv="${j}">${f.done[j]?'✓ ':''}Ly ${j+1}</span>`).join('')}</span> `+t;
  if(missing(f.order).length&&!online)t+=` <button class="q3decl" data-decl="${f.id}">Hết món, mời về</button>`;
  if(isClosingState){
    t += `<div style="margin-top:6px;"><button type="button" class="sbtn sm pri" style="padding:4px 10px;font-size:0.75rem;font-weight:800;border-radius:8px;background:linear-gradient(135deg,#f97316,#ea580c);color:#fff;border:none;cursor:pointer;" onclick="window.forceEndDayNow && window.forceEndDayNow()">🛑 ${R.isNightShift ? '06:00 Hết ca đêm' : '22:00 Hết ca ngày'}: Đóng sổ kết toán ngay ➜</button></div>`;
  }
  $('q3bub').classList.remove('q3idleB');if(say._t!==t){say._t=t;say.innerHTML=t;q3fitSay()}coach();const qw=$('q3want');if(qw._o!==f.order){qw._o=f.order;qw.innerHTML=orderGlass(f.order)}updPat(f);
  const pBadge = $('q3PhoneBadge');
  if(pBadge){
    const onCount = (R && R.online) ? R.online.length : 0;
    if(onCount > 0){
      pBadge.style.display = 'flex';
      pBadge.textContent = onCount;
      if(pBadge.parentElement) pBadge.parentElement.classList.add('has-orders');
    } else {
      pBadge.style.display = 'none';
      if(pBadge.parentElement) pBadge.parentElement.classList.remove('has-orders');
    }
  }
}
function q3fitSay(){
  const e = $('q3say');
  if(!e) return;
  // Bắt đầu từ cỡ font chuẩn 22px
  let fs = 22;
  e.style.fontSize = fs + 'px';
  e.style.lineHeight = '1.18';
  
  // Luôn fix vừa chiều cao an toàn (68px), không bao giờ vượt khung hay đè lên thanh KIÊN NHẪN
  const maxH = 68;
  while(fs > 11.5 && e.scrollHeight > maxH){
    fs -= 0.5;
    e.style.fontSize = fs + 'px';
  }
}
const renderStreet=renderLane,renderOnline=renderLane;
function updPat(c){
  if(!c) return;
  const r = Math.min(1, Math.max(0, c.pat / (c.max || 1)));
  const laneEl = $('lane');
  const ch = laneEl ? laneEl.querySelector(`[data-fc="${c.id}"]`) : null;
  if(ch){
    const col = r > 0.5 ? '#5aae86' : r > 0.25 ? '#f4b73a' : '#e2574c';
    const deg = Math.round((r * 360) / 4) * 4;
    if(c._lastDeg !== deg || c._lastCol !== col){
      c._lastDeg = deg;
      c._lastCol = col;
      ch.style.setProperty('--p', r);
      ch.style.setProperty('--c', col);
    }
    const faceIdx = r < 0.3 ? 2 : 0;
    if(c._lastFaceIdx !== faceIdx){
      c._lastFaceIdx = faceIdx;
      const fc = ch.querySelector('.q3fc');
      if(fc && hasFace(c)) fc.style.backgroundPosition = `${-faceIdx * 56}px ${-faceRow(c) * 55}px`;
    }
  }
  const f = (typeof focusCust === 'function') ? focusCust() : null;
  if((f && c.id === f.id) || c.id === R.focus){
    const pct = Math.round(r * 100);
    const p = $('q3pat');
    if(p && p._lastPct !== pct){
      p._lastPct = pct;
      p.style.width = pct + '%';
      p.style.background = r > 0.5 ? '#8fcf8f' : r > 0.25 ? '#f4c04a' : '#f08a8a';
    }
    const faceIdx = r < 0.3 ? 2 : 0;
    const fc = $('q3face');
    if(fc && hasFace(c) && !R.flash && fc._lastFaceIdx !== faceIdx){
      fc._lastFaceIdx = faceIdx;
      if(!(typeof c.face === 'string' && /^b\d+$/.test(c.face))){
        fc.style.backgroundPosition = `${-faceIdx * 144}px ${-faceRow(c) * 141}px`;
      }
    }
  }
}
function pourFast(){const w=$('q3cup');if(!w)return false;const lq=w.querySelector('.lq'),lh=w.querySelector('.lqh'),st=w.querySelector('.strm');if(!lq||!st)return false;
  const surf=BY-Math.min(cup.fill||0,1)*LH;lq.setAttribute('y',surf);lq.setAttribute('height',BY-surf+8);if(lh)lh.setAttribute('y',surf);st.setAttribute('height',surf+80);$('q3gLv').style.width=Math.min(100,(cup.fill||0)*100)+'%';return true}
function renderCupHint(){
  const qh = $('q3hint');
  if(!qh) return;
  const fCust = focusCust(), curO = fCust ? fCust.order : null;
  if(!curO){
    qh.innerHTML = '';
    return;
  }
  if(level() >= 2){
    const sugTxt = curO.sugar != null ? curO.sugar + '% đường' : 'Đường chuẩn';
    const iceTxt = curO.ice || 'Đá thường';
    const sugDone = cup.size && normSug(cup.sugar) === normSug(curO.sugar);
    const needIceN = {'Không đá':0, 'Ít đá':1, 'Đá thường':2}[curO.ice] || 0;
    const iceDone = cup.size && (cup.iceN || 0) >= needIceN;
    const bothDone = sugDone && iceDone;
    qh.innerHTML = `<div class="q3cup-opt-box${bothDone ? ' done' : ''}"><span class="q3cup-opt-txt">${bothDone ? '✓ ' : ''}${sugTxt} - ${iceTxt}</span></div>`;
  } else {
    qh.innerHTML = '<div class="q3cup-opt-box"><span class="q3cup-opt-txt">Đường đá tự động</span></div>';
  }
}

function renderCup(){
  const w=$('q3cup');if(!w)return;const has=!!cup.size;$('q3noCup').hidden=has;
  const lm=$('lobby-modal');const lobbyOpen=!!(lm&&!lm.hidden);
  if(!has){w.innerHTML='';w.style.cssText='';$('q3gLv').style.width='0';$('q3hint').innerHTML='';if(lobbyOpen&&window.Lobby&&typeof window.Lobby.renderBaristaHud==='function')window.Lobby.renderBaristaHud();return}
  const h=cup.size==='L'?162:142,wd=Math.round(h*415/587);
  const isPouring = !!(R && R.pour && typeof JAR_K !== 'undefined' && JAR_K.includes(R.pour));
  const jarIdx = isPouring ? JAR_K.indexOf(R.pour) : -1;
  const targetLeft = (isPouring && jarIdx >= 0) ? Math.round(JAR_X[jarIdx] - wd / 2) : Math.round(133 - wd / 2);
  const targetTop = isPouring ? 505 : Math.round(870 - h);
  const nextLeft = targetLeft + 'px';
  const nextTop = targetTop + 'px';
  const wasEmpty = !w.style.left;
  if(wasEmpty) w.style.transition = 'none';
  if(w.style.left !== nextLeft) w.style.left = nextLeft;
  if(w.style.top !== nextTop) w.style.top = nextTop;
  if(wasEmpty){ void w.offsetWidth; w.style.transition = ''; }
  const nextWd = wd + 'px';
  const nextHt = h + 'px';
  if(w.style.width !== nextWd) w.style.width = nextWd;
  if(w.style.height !== nextHt) w.style.height = nextHt;
  const html=glassHTML({...cup,fill:cup.fill||0},{pour:R.pour}),g=w.firstElementChild;
  if(!g||!g.classList.contains('q3g')){w.innerHTML=html}else{
    const t=document.createElement('div');t.innerHTML=html;const n=t.firstElementChild,oc=[...g.children],nc=[...n.children];
    if(oc.length!==nc.length||oc.some((e,i)=>e.tagName!==nc[i].tagName))g.replaceWith(n);
    else nc.forEach((e,i)=>{if(e.tagName==='IMG'){oc[i].hidden=e.hidden;if(oc[i].getAttribute('src')!==e.getAttribute('src'))oc[i].src=e.getAttribute('src');}else g.replaceChild(e,oc[i])})}
  $('q3gLv').style.width=Math.min(100,(cup.fill||0)*100)+'%';
  renderCupHint();
  let te=w.querySelector('.q3tem');const showTem=has&&S.upg&&S.upg.brandKit&&S.brand&&S.brand.i;
  if(showTem){const th=temHTML(S.brand,Math.round(wd*.54),false);if(!te){te=document.createElement('div');te.className='q3tem';w.appendChild(te)}if(te._k!==th){te._k=th;te.innerHTML=th}}
  else if(te)te.remove();
  if(lobbyOpen&&window.Lobby&&typeof window.Lobby.renderBaristaHud==='function')window.Lobby.renderBaristaHud();
}
function renderPanel(){
  if(!$('q3zones'))return;const f=focusCust(),o=f?f.order:null,lv=level();
  // Gen Z và Sinh viên không hiện các khung màu cam (.q3want) quanh món pha chế
  const isStaffCrafting = !!((R.gzWork && (!f || R.gzWork.cId === f.id)) || (R.svWork && (!f || R.svWork.cId === f.id)) || (isStaffActive('staffGz') && !R.gzSulking) || (isStaffActive('staffSv') && R.isNightShift));
  const want=k=>{
    if(!o || isStaffCrafting)return false;
    if(o.base===k)return !cup.base||(cup.fill||0)<.72;
    if(o.flav===k)return cup.flav!==o.flav;
    if(o.tops.includes(k))return !cup.tops.includes(k);
    return false;
  };
  const set=(k,locked)=>{const b=$('q3b_'+k),n=$('q3n_'+k);if(!b)return;const q=ITEMS[k]?qty(k):1;
    b.classList.toggle('q3lock',!!locked);b.classList.toggle('q3empty',!locked&&q<=0);b.classList.toggle('q3want',!locked&&want(k));if(n){const tray=TRAY_K.includes(k);n.textContent=locked?"":q;n.style.display=locked&&!tray?"none":"";n.style.background=locked?"#ece4d8":"";n.style.borderColor=locked?"#c9b9a4":""}};
  [...JAR_K,...TRAY_K,...BTL_K,'cheese','fmatcha','fsalt','fube'].forEach(k=>set(k,!S.unlocked[k]));
  if(lv>=2){
    set('ice',false);set('sugar',false);
    const iceN={'Không đá':0,'Ít đá':1,'Đá thường':2}[o?o.ice:'']||0;
    const bIce = $('q3b_ice'), bSugar = $('q3b_sugar');
    if(bIce) bIce.classList.toggle('q3want',!isStaffCrafting&&!!o&&(cup.iceN||0)<iceN);
    if(bSugar) bSugar.classList.toggle('q3want',!isStaffCrafting&&!!o&&normSug(cup.sugar)!==normSug(o.sugar));
  }
  const cupsEl = $('q3cups');
  if(cupsEl) cupsEl.textContent=qty('cup');
  ['M','L'].forEach(z=>{const el=$('q3_'+z);if(el)el.classList.toggle('q3pick',cup.size===z);if(el&&o)el.classList.toggle('q3want',!isStaffCrafting&&!cup.size&&o.size===z)});
  if($('q3seal')&&o){
    const readyToSeal=ready(true);
    $('q3seal').classList.toggle('q3want',!isStaffCrafting&&readyToSeal);
  }
  renderCupHint();
}
function q3pop(el,wob){
  if(!el) return null;
  const r=(el.dataset.r||'').split(',').map(Number);if(r.length<4)return null;const so=el.dataset.s?el.dataset.s.split(',').map(Number):[r[0],r[1]];
  const pops = $('q3pops');
  if(!pops) return null;
  const d=document.createElement('div');d.className='q3pop'+(wob?' wob':'');d.style.cssText=`left:${r[0]}px;top:${r[1]}px;width:${r[2]}px;height:${r[3]}px;background-position:${-so[0]}px ${-so[1]}px`;
  pops.appendChild(d);
  if(!wob){
    const anim = d.animate([{transform:'scale(1)'},{transform:'scale(1.12,1.1)'},{transform:'scale(1)'}],{duration:q3reduce?1:280,easing:'ease-out'});
    if(anim) anim.onfinish=()=>{ if(d && d.parentNode) d.remove(); };
    setTimeout(()=>{ if(d && d.parentNode) d.remove(); }, 350);
  }
  return d;
}
function q3label(el,txt){
  if(!el) return;
  const a=el.getBoundingClientRect(),t=document.createElement('div');t.className='q3flyT';t.textContent=txt;document.body.appendChild(t);
  const w=t.offsetWidth;t.style.left=Math.max(4,Math.min(vpW()-w-4,(a.left+a.width/2)/ZM-w/2))+'px';t.style.top=(a.top/ZM-4)+'px';
  const anim = t.animate([{transform:'translateY(0)',opacity:1},{transform:'translateY(-16px)',opacity:0}],{duration:900,easing:'ease-out'});
  if(anim) anim.onfinish=()=>{ if(t && t.parentNode) t.remove(); };
  setTimeout(()=>{ if(t && t.parentNode) t.remove(); }, 1000);
}
function q3fly(fromEl,html,cb){
  if(!fromEl || !$('q3cup')){ if(cb) cb(); return; }
  const a=fromEl.getBoundingClientRect(),b=$('q3cup').getBoundingClientRect();
  const x0=(a.left+a.width/2)/ZM,y0=(a.top+a.height/2)/ZM,x1=(b.left+b.width/2)/ZM,y1=(b.top+b.height*.35)/ZM;
  const f=document.createElement('div');f.className='q3fly';f.innerHTML=html;document.body.appendChild(f);
  const T=(x,y,s)=>`translate(${x-12}px,${y-12}px) scale(${s})`;
  let cleaned = false;
  const cleanup = () => {
    if(!cleaned){
      cleaned = true;
      if(f && f.parentNode) f.remove();
      if(cb) cb();
    }
  };
  const anim = f.animate([{transform:T(x0,y0,1)},{transform:T((x0+x1)/2,Math.min(y0,y1)-40,1.15)},{transform:T(x1,y1,.8)}],{duration:q3reduce?1:420,easing:'ease-in-out'});
  if(anim) anim.onfinish = cleanup;
  setTimeout(cleanup, 500);
}
const q3dot=c=>`<svg width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="6" fill="${c}" stroke="${Q3INK}" stroke-width="1.5"/></svg>`;
function animateStaffTopping(topKey){
  if(!topKey || !ITEMS[topKey]) return;
  const btn = $('q3b_' + topKey);
  try {
    if(btn){
      q3pop(btn);
      q3label(btn, `🥄 + ${ITEMS[topKey].n}`);
      const foam = ITEMS[topKey].g === 'foam';
      const flySvg = foam ? cloudSvg(ITEMS[topKey].c, 24, 17) : `<svg width="30" height="30" viewBox="0 0 30 30">${[[6,20],[15,21],[24,20],[10,13],[20,13],[15,6],[4,12],[26,12]].map(([x,y],i)=>pc(topKey,x,y,i)).join('')}</svg>`;
      if(typeof q3fly === 'function' && $('q3cup')) q3fly(btn, flySvg);
    } else {
      const flyBox = document.createElement('div');
      flyBox.className = 'q3flyT';
      flyBox.textContent = `🥄 + ${ITEMS[topKey].n}`;
      flyBox.style.cssText = 'position:fixed;left:50%;top:55%;transform:translate(-50%,-50%);z-index:999;';
      document.body.appendChild(flyBox);
      const anim = flyBox.animate([{transform:'translate(-50%,0)',opacity:1},{transform:'translate(-50%,-20px)',opacity:0}],{duration:900,easing:'ease-out'});
      if(anim) anim.onfinish=()=>{ if(flyBox && flyBox.parentNode) flyBox.remove(); };
      setTimeout(()=>{ if(flyBox && flyBox.parentNode) flyBox.remove(); }, 1000);
    }
  } catch(e) {
    console.warn('animateStaffTopping error:', e);
  }
}
function q3act(a,el){
  const [t,k]=a.split(':');
  // Không bao giờ khoá phím người chơi; chỉ cảnh báo nếu ấn rót trà lúc nhân viên đang rót
  if(R.staffPouring && t==='base'){toast('Nhân viên đang rót trà, chờ một xíu nhé');return}
  if(t==='seal')return sealServe();
  if(t==='trash'){
    if(R.gzWork){ clearStaffPouring(); R.gzWork = null; renderGzWidget(); }
    if(R.svWork){ clearStaffPouring(); R.svWork = null; renderSvWidget(); }
    if(!cup.size && !cup.used && (!cup.tops || cup.tops.length === 0) && !cup.base){
      toast('Chưa có ly nào trên thớt để đổ');
      return;
    }
    sfx('trash');
    toast('Đã đổ bỏ ly làm lại');
    spoilCup();
    cup = newCup();
    renderCup();
    renderPanel();
    coach();
    return;
  }
  if(t==='size'){
    const isEmptyCup = !cup.base && (!cup.tops || cup.tops.length === 0) && (cup.fill || 0) === 0 && !cup.sugarN && !cup.iceN && !cup.flav && !cup.cheese;
    if(!cup.size || isEmptyCup || (cup.staff && !cup.base)){
      // Chưa có ly hoặc ly trên thớt hoàn toàn rỗng hoặc do nhân viên auto lấy chưa rót trà: đổi size/lấy ly mới mượt mà 100%
      cup = newCup();
    } else {
      // Đã có ly có nguyên liệu trên thớt mà người chơi bấm lấy ly mới/đổi size:
      // Tự động đổ ly cũ vào xô inox luôn, KHÔNG BAO GIỜ chặn đứng người chơi bằng cảnh báo khó chịu!
      sfx('trash');
      spoilCup();
      toast('Đã tự động đổ ly cũ vào xô để lấy ly ' + k + ' mới');
      cup = newCup();
    }
    if(!qty('cup')){
      if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant('cup');
      else toast('Hết ly! Nhập thêm ở kho ngày mai');
      return;
    }
    q3pop(el);
    sfx('cup');
    if(R.gzWork){
      clearStaffPouring();
      R.gzWork = null;
      renderGzWidget();
    }
    if(R.svWork){
      clearStaffPouring();
      R.svWork = null;
      renderSvWidget();
    }
    cup.size = k;
    cup.staff = false; // Người chơi làm chủ ly, nhân viên tuyệt đối không cướp
    renderCup();
    renderPanel();
    coach();
    staffHelp();
    return;
  }
  if(t==='top'||t==='flav'||t==='sugar'||t==='ice'){
    const itemKey = (t === 'sugar' || k === 'sugar') ? 'sugar' : ((t === 'ice' || k === 'ice') ? 'ice' : k);
    if(!qty(itemKey)){
      if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant(itemKey);
      else toast('Hết ' + (ITEMS[itemKey] ? ITEMS[itemKey].n : (itemKey==='sugar'?'nước đường':'đá')) + '! Nhập thêm ở kho ngày mai');
      return;
    }
  }
  if(!cup.size){toast('Lấy ly M hoặc L trước');return}
  if(t==='top'){if(!S.unlocked[k]){toast((S.off||{})[k]?ITEMS[k].n+' đã bỏ khỏi menu':'Chưa mở '+ITEMS[k].n+' (Nâng cấp)');return}const n=cup.tops.length;addIng('top',k);if(cup.tops.length===n)return;
    q3pop(el);sfx('plop');q3label(el,ITEMS[k].n);const foam=ITEMS[k].g==='foam';
    if(!foam)(cup.vt=cup.vt||[]).push({k,pts:q3layer(k)});
    q3fly(el,foam?cloudSvg(ITEMS[k].c,24,17):`<svg width="30" height="30" viewBox="0 0 30 30">${[[6,20],[15,21],[24,20],[10,13],[20,13],[15,6],[4,12],[26,12]].map(([x,y],i)=>pc(k,x,y,i)).join('')}</svg>`,()=>{renderCup();renderPanel();autoSeal();coach()});return}
  if(t==='flav'){if(!S.unlocked[k]){toast((S.off||{})[k]?'Siro '+low(ITEMS[k].n)+' đã bỏ khỏi menu':'Chưa mở siro '+low(ITEMS[k].n)+' (Nâng cấp)');return}if(cup.flav===k){toast('Đã có siro '+low(ITEMS[k].n));return}
    const was=cup.flav;addIng('flav',k);if(cup.flav===was)return;q3pop(el);sfx('pump');q3label(el,'Siro '+low(ITEMS[k].n));q3fly(el,q3dot(ITEMS[k].c),()=>{renderCup();renderPanel();autoSeal();coach()});return}
  if(t==='sugar'){if(level()<2){toast('Khách chưa cần chọn đường');return}
    if((cup.sugarN||0)>=4){cup.sugarN=4;toast('Tối đa 100%');return}
    if(!qty('sugar')){if(S.upg&&(S.upg.staffBuyer||S.upg.staffRacer))staffBuyerTriggerInstant('sugar');else toast('Hết nước đường! Nhập thêm ở kho ngày mai');return}
    consume('sugar');
    cup.sugarN=(cup.sugarN||0)+1;
    cup.sugar=SUGAR[cup.sugarN-1];q3pop(el);sfx('pump');renderPanel();
    q3fly(el,q3dot('#f0c56a'),()=>{renderCup();renderPanel();q3label(el,cup.sugar+'% đường');autoSeal();coach()});return}
  if(t==='ice'){if(level()<2){toast('Khách chưa cần chọn đá');return}if((cup.iceN||0)>=2){toast('Đá đầy rồi');return}
    if(!qty('ice')){if(S.upg&&(S.upg.staffBuyer||S.upg.staffRacer))staffBuyerTriggerInstant('ice');else toast('Hết đá! Nhập thêm ở kho ngày mai');return}
    consume('ice');
    cup.iceN=(cup.iceN||0)+1;
    cup.ice=cup.iceN===1?'Ít đá':'Đá thường';q3pop(el);sfx('ice');renderPanel();
    q3fly(el,`<svg width="24" height="24" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4" fill="#eaf7fd" stroke="#8fb9cf" stroke-width="2"/></svg>`,()=>{
      cup.vi=cup.vi||[];for(let i=0;i<(cup.iceN===2?5:3);i++)cup.vi.push([Math.random()*2-1,4+Math.random()*22+cup.vi.length*3.5,Math.random()*40-20]);renderCup();renderPanel();q3label(el,cup.iceN===1?'Ít đá':'Đá bình thường');autoSeal();coach()});return}
}
let q3raf,q3last,q3pourEl,q3wob;
const coachDay=()=>{const L=CFG.levels;return [1,L.l2,L.l3].includes(S.day)};
const coachOn=()=>S.coach!==false;
function coach(){const b=$('q3coach');if(!b)return;const prev=document.querySelector('.q3coachT');
  const set=(txt,id)=>{if(b._t!==txt){b._t=txt;b.textContent=txt}b.hidden=false;const t=id&&$(id);if(prev&&prev!==t)prev.classList.remove('q3coachT');if(t)t.classList.add('q3coachT')};
  if(!coachOn()||!R.running||isPriorityStaffWorking()){b.hidden=true;prev&&prev.classList.remove('q3coachT');return}
  const f=focusCust(),o=f&&f.order,lv=level();
  if(!o){b.hidden=true;prev&&prev.classList.remove('q3coachT');return}
  if(R.svWork && R.svWork.step === 'wait_seal') return set('Sinh viên đã bỏ đường đá! Chạm máy dán nắp để giao ly','q3seal');
  const isEmptyCup = !cup.base && (!cup.tops || cup.tops.length === 0) && (cup.fill || 0) === 0 && !cup.used && !cup.sugarN && !cup.iceN && !cup.flav && !cup.cheese;
  if(!cup.size){
    return set(`Bước 1: chạm chồng ly ${o.size}`,'q3_'+o.size);
  }
  if(cup.size !== o.size && !cup._svWrongAccept){
    if(isEmptyCup){
      return set(`Bước 1: chạm chồng ly ${o.size} để đổi size`,'q3_'+o.size);
    }
    return set('Ly bị sai size, chạm xô inox để đổ làm lại','q3trash');
  }
  if(cup.spill||(cup.fill||0)>.95||(cup.base&&cup.base!==o.base)||cup.mixed)return set('Ly bị sai, chạm xô inox để đổ làm lại','q3trash');
  if(!cup.base||(cup.fill||0)<.72)return set(`Bước 2: nhấn giữ hũ ${ITEMS[o.base].n}, thả tay khi tới vạch xanh`,'q3b_'+o.base);
  {const iceN={'Không đá':0,'Ít đá':1,'Đá thường':2}[o.ice]||0;
   if((cup.flav&&cup.flav!==(o.flav||null))||cup.tops.some(t=>!o.tops.includes(t))||(lv>=2&&(cup.sugar||0)>o.sugar)||(lv>=2&&(cup.iceN||0)>iceN))return set('Ly bị dư hoặc sai món, chạm xô inox để đổ làm lại','q3trash')}
  if(o.flav&&cup.flav!==o.flav)return set(`Chạm chai siro ${low(ITEMS[o.flav].n)}`,'q3b_'+o.flav);
  const miss=o.tops.find(t=>!cup.tops.includes(t));if(miss)return set(`Bước 3: chạm ${low(ITEMS[miss].n)} để thêm topping`,'q3b_'+miss);
  if(lv>=2&&normSug(cup.sugar)!==normSug(o.sugar)){const sVal=normSug(o.sugar);const n=SUGAR.indexOf(sVal)+1;return set(`Bấm bình nước đường ${n>0?n:3} lần để được ${sVal||o.sugar}% đường`,'q3b_sugar')}
  const iceN={'Không đá':0,'Ít đá':1,'Đá thường':2}[o.ice]||0;
  if(lv>=2&&(cup.iceN||0)<iceN)return set(iceN===1?'Xúc đá 1 lần (ít đá)':'Xúc đá 2 lần (đá bình thường)','q3b_ice');
  if(lv>=2&&(cup.iceN||0)>iceN)return set('Dư đá rồi, chạm xô để đổ làm lại','q3trash');
  if(S.upg.sealer&&(cup.fill||0)<.66)return set('Rót thêm trà tới vạch xanh','q3b_'+o.base);
  set(S.upg.sealer?'Máy đang tự dán nắp…':'Bước cuối: chạm máy dán nắp để giao ly','q3seal')}
function staffHelp(){
  if(!(isStaffActive('staff0')||isStaffActive('staff1')||isStaffActive('staff3'))||!R.running||(!R.closing && R.t<=0))return;
  if(R.gzWork || R.svWork || (cup && cup.staff)) return;
  const f=focusCust(),o=f&&f.order;if(!o||o.size!==cup.size||cup.base)return;
  if(!qty(o.base))return;

  const isStaff0=isStaffActive('staff0')&&!isStaffActive('staff1')&&!isStaffActive('staff3');
  const s0Factor = Math.max(0, 1 - (STAFF_TRAINING_TIERS[getStaffTrainLv('staff0')].defectReduce || 0));
  const s1Factor = Math.max(0, 1 - (STAFF_TRAINING_TIERS[getStaffTrainLv('staff1')].defectReduce || 0));
  const s3Factor = Math.max(0, 1 - (STAFF_TRAINING_TIERS[getStaffTrainLv('staff3')].defectReduce || 0));
  // Thử việc 0 lương: 8% tỉ lệ trốn việc lướt điện thoại (giảm theo cấp đào tạo, Lv.4+ = 0%)
  if(isStaff0&&Math.random()<(0.08 * s0Factor)){
    toast('Nhân viên thử việc 0 lương đang trốn việc bấm điện thoại 📱! Bạn tự rót trà và xúc đá nhé.',4500,1);
    return;
  }

  R.helping=true;
  clearTimeout(R._helpSafetyTimer);
  R._helpSafetyTimer=setTimeout(()=>{
    if(R.helping){R.helping=false;R.staffPouring=false;renderCup();renderPanel();coach()}
  },4500);
  const hasGuard=isStaffActive('staffGuard');
  const oops0=isStaff0&&Math.random()<((hasGuard?0.05:0.10) * s0Factor); // Thử việc 0 lương: 10% làm sai, giảm theo Đào tạo & Bảo vệ
  const isStaff1=isStaffActive('staff1');
  const isStaff3=isStaffActive('staff3');
  // Thử việc chính thức: 10% làm sai bill hỏng; Quản lý tập sự: 5% làm sai bill hỏng; giảm theo Đào tạo & Chú bảo vệ
  const isDamaged=(isStaff1&&Math.random()<((hasGuard?0.05:0.10)*s1Factor))||(isStaff3&&Math.random()<((hasGuard?0.025:0.05)*s3Factor));
  const oops=isDamaged;
  const target=(oops||oops0)?0.6:0.8;
  const nb=(R.s1n=(R.s1n||0)+1);
  const bad=isStaff1&&(s1Factor>0)&&(Math.random()<s1Factor)&&(R.s1bad||[]).includes(nb); // CHỈ áp dụng s1bad cho Thử việc chính thức (staff1), triệt tiêu khi Đào tạo Lv.4+
  let bdesc='';

  setTimeout(()=>{
    if(!R.running||!R.helping){R.helping=false;return}
    try{
      let chosenBase=o.base;
      if(oops0){
        const altBases=BASE_KEYS.filter(k=>S.unlocked[k]&&qty(k)>0&&k!==o.base);
        if(altBases.length){
          chosenBase=altBases[Math.floor(Math.random()*altBases.length)];
          bdesc='rót nhầm loại trà '+low(ITEMS[chosenBase].n);
        }
      }
      addIng('base',chosenBase);
      if(cup.base!==chosenBase){R.helping=false;coach();return}
      R.pour=chosenBase;R.staffPouring=true;pourSnd(true);
      const el=$('q3b_'+chosenBase);el&&el.classList.add('q3on');let last=performance.now();
      renderCup();

      const step=now=>{
        try{
          if(!R.helping){R.pour=null;R.staffPouring=false;pourSnd(false);el&&el.classList.remove('q3on');renderCup();return}
          const helpSpd = 1 + Math.max(getStaffSpeedBuff('staff0'), getStaffSpeedBuff('staff1'), getStaffSpeedBuff('staff3'));
          const baseStepRate = isStaff0 ? 300 : 280; // 300ms với Thử việc 0 lương, 280ms với Thử việc chính thức & Quản lý
          const pourRate = (1000 / baseStepRate) * 0.40 * helpSpd * getTeaPourSpeedMul();
          cup.fill=Math.min(target,(cup.fill||0)+(now-last)/1000*pourRate);last=now;
          if(!pourFast()) renderCup();
          if(cup.fill<target){requestAnimationFrame(step);return}
          R.pour=null;R.staffPouring=false;pourSnd(false);el&&el.classList.remove('q3on');
          // Nếu nhân viên rót thiếu trà (target < 0.72 hoặc fill < 0.72), chủ tiệm sẽ chủ động rót thêm cho đủ vạch
          if(cup && cup.base && (cup.fill||0) < 0.72){
            cup.fill = 0.8;
            toast('🧑‍🍳 Nhân viên rót thiếu trà, chủ tiệm đã chủ động rót thêm cho đủ vạch xanh! 🧋✨', 3500);
          }
          renderCup();

          const lv=level(),iceN={'Không đá':0,'Ít đá':1,'Đá thường':2}[o.ice]||0;
          const adds=[];

          if(isStaff0){
            // Thử việc 0 lương: Chỉ rót trà và đá. Bạn tự cho siro, đường, topping, dán nắp
            if(lv>=2){
              let staff0Ice=iceN;
              if(oops0&&!bdesc){staff0Ice=(iceN===2?1:2);bdesc='xúc sai lượng đá'}
              for(let i=0;i<staff0Ice;i++)adds.push(['ice']);
            }
          }else{
            // Thử việc chính thức & Quản lý tập sự: rót trà, hương, đường, đá
            if(o.flav)adds.push(['flav',o.flav]);
            if(lv>=2&&o.sugar!=null){
              const sVal=normSug(o.sugar);
              const sIdx=SUGAR.indexOf(sVal);
              const count=sIdx>=0?sIdx+1:3;
              for(let i=0;i<count;i++)adds.push(['sugar']);
            }
            if(lv>=2){
              for(let i=0;i<iceN;i++)adds.push(['ice']);
            }
            if(bad){
              const alt=FLAV_KEYS.find(k=>S.unlocked[k]&&qty(k)>0&&k!==o.flav);
              if(o.flav&&alt){adds[0]=['flav',alt];bdesc='cho nhầm siro '+low(ITEMS[alt].n)}
              else if(lv>=2&&o.sugar&&normSug(o.sugar)<100){adds.push(['sugar']);bdesc='cho dư đường'}
              else if(lv>=2){if(iceN<2)adds.push(['ice']);else adds.splice(adds.findIndex(a=>a[0]==='ice'),1);bdesc='cho sai lượng đá'}
              else if(alt){adds.push(['flav',alt]);bdesc='cho nhầm siro '+low(ITEMS[alt].n)}
            }
            // Thử việc chính thức & Quản lý tập sự: thêm múc topping
            if((isStaffActive('staff3') || isStaffActive('staff1')) && !bdesc){
              (o.tops||[]).forEach(k0=>{
                const k = normIngKey(k0) || k0;
                if(qty(k) <= 0 && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant(k);
                if(!cup.tops.includes(k) && qty(k) > 0 && ITEMS[k]) adds.push(['top', k]);
              });
              if(o.cheese && !cup.cheese){
                if(qty('cheese') <= 0 && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant('cheese');
                if(qty('cheese') > 0) adds.push(['cheese', 'cheese']);
              }
            }
          }

          const staffName=isStaff0?'Nhân viên thử việc 0 lương':(isStaffActive('staff3')?'Quản lý tập sự':'Thử việc chính thức');

          const next=()=>{
            try{
              if(!adds.length||!R.running){
                if(level()>=2&&!cup.ice)cup.ice='Không đá';
                R.helping=false;
                clearTimeout(R._helpSafetyTimer);
                if((bdesc || isDamaged) && R.running){
                  const errReason = bdesc || (isStaff3 ? 'làm sai công thức của khách' : 'lỡ tay làm sai bill');
                  toast(staffName + ' ' + errReason + ', ly bị hỏng đã đổ bỏ làm lại! Bạn lấy ly mới nhé 🥤🗑️', 5000, 1);
                  sfx('trash');spoilCup();renderCup();renderPanel();coach();return;
                }
                if(cup && cup.base && (cup.fill || 0) < 0.72){
                  cup.fill = 0.8;
                  toast('🧑‍🍳 Nhân viên rót thiếu trà, chủ tiệm đã chủ động rót thêm cho đủ vạch xanh! 🧋✨', 3500);
                }
                renderCup();renderPanel();autoSeal();coach();return;
              }
              const [kind,k]=adds.shift();
              const helpSpd = 1 + Math.max(getStaffSpeedBuff('staff0'), getStaffSpeedBuff('staff1'), getStaffSpeedBuff('staff3'));
              const stepTimeMs = Math.max(100, Math.round((isStaff0 ? 300 : 280) / helpSpd));
              if(kind==='sugar'){
                if(qty('sugar') > 0) consume('sugar');
                sfx('pump');cup.sugarN=(cup.sugarN||0)+1;cup.sugar=SUGAR[cup.sugarN-1];
                const z=$('q3b_sugar');z&&q3pop(z);renderCup();renderPanel();setTimeout(next,stepTimeMs);return;
              }
              if(kind==='ice'){
                if(qty('ice') > 0) consume('ice');
                sfx('ice');cup.iceN=(cup.iceN||0)+1;cup.ice=cup.iceN===1?'Ít đá':'Đá thường';
                cup.vi=cup.vi||[];for(let i=0;i<(cup.iceN===2?5:3);i++)cup.vi.push([Math.random()*2-1,4+Math.random()*22+cup.vi.length*3.5,Math.random()*40-20]);
                const z=$('q3b_ice');z&&q3pop(z);renderCup();renderPanel();setTimeout(next,stepTimeMs);return;
              }
              if((kind==='top'&&cup.tops.includes(k))||(kind==='cheese'&&cup.cheese)){next();return;}
              if(kind==='top'){
                if(qty(k)>0) consume(k);
                cup.tops.push(k);
                if(ITEMS[k]&&ITEMS[k].g!=='foam')(cup.vt=cup.vt||[]).push({k,pts:q3layer(k)});
                animateStaffTopping(k);
                sfx('plop');
              } else if(kind==='cheese'){
                if(qty('cheese')>0) consume('cheese');
                cup.cheese=true;
                animateStaffTopping('cheese');
                sfx('plop');
              } else {
                addIng(kind,k);
                sfx('pump');
              }
              const z=$('q3b_'+k);z&&q3pop(z);renderCup();renderPanel();setTimeout(next,stepTimeMs);
            }catch(err){
              console.error('staffHelp next step error:',err);
              R.helping=false;clearTimeout(R._helpSafetyTimer);renderCup();renderPanel();coach();
            }
          };
          setTimeout(next,120);
        }catch(err){
          console.error('staffHelp step error:',err);
          R.helping=false;clearTimeout(R._helpSafetyTimer);renderCup();renderPanel();coach();
        }
      };
      requestAnimationFrame(step);
    }catch(err){
      console.error('staffHelp start error:',err);
      R.helping=false;clearTimeout(R._helpSafetyTimer);renderCup();renderPanel();coach();
    }
  },200);
}
function isPriorityStaffWorking(){
  if(!R || !R.running) return false;
  // Gen Z ca ngày (hoạt động và không đình công chữa lành)
  if(!R.isNightShift && isStaffActive('staffGz') && !R.gzSulking) return true;
  // Sinh viên cuối tháng: CHỈ làm sau 22h (ca đêm) sau khi Gen Z hết ca
  if(R.isNightShift && isStaffActive('staffSv')) return true;
  return false;
}

function clearStaffPouring(){
  if(R && R.staffPouring){
    R.pour = null;
    R.staffPouring = false;
    pourSnd(false);
    if(window.ITEMS){
      Object.keys(ITEMS).forEach(k => {
        const el = $('q3b_' + k);
        if(el) el.classList.remove('q3on');
      });
    }
    renderCup();
  }
}

/* ==================== THỢ PHA CHẾ (staff2) ==================== */
function staffTick(dt){
  if(!isStaffActive('staff2')) return;
  const numBaristas = (typeof getStaff2Count === 'function') ? getStaff2Count() : 1;
  if(numBaristas <= 0) return;

  R.st2Workers = R.st2Workers || [];
  if(R.st2 && !R.st2Workers.some(w => w && w.id === R.st2.id)){
    R.st2Workers.push(R.st2);
  }

  const sortedSlots = R.slots.filter(Boolean).sort((a, b) => a.id - b.id);
  const firstCust = sortedSlots[0] || null;
  const curF = (typeof focusCust === 'function') ? focusCust() : null;
  const currentFocusId = curF ? curF.id : R.focus;

  // 1. Process active workers
  for(let wIdx = R.st2Workers.length - 1; wIdx >= 0; wIdx--){
    const worker = R.st2Workers[wIdx];
    if(!worker){ R.st2Workers.splice(wIdx, 1); continue; }

    if((R.gzWork && R.gzWork.cId === worker.id) || (R.svWork && R.svWork.cId === worker.id)){
      R.st2Workers.splice(wIdx, 1);
      continue;
    }

    const i = R.slots.findIndex(x => x && x.id === worker.id);
    const c = R.slots[i];
    if(!c){
      R.st2Workers.splice(wIdx, 1);
      continue;
    }
    // Chuẩn tiemtranhosrc: Chỉ nhận khi có từ 2 khách trở lên
    if(sortedSlots.length < 2){
      R.st2Workers.splice(wIdx, 1);
      continue;
    }
    // Khách đầu tiên ở quầy (firstCust) là độc quyền của Quản lý / Gen Z! Tuyệt đối không chạm vào khách đầu tiên hoặc khách đang focus
    if((firstCust && c.id === firstCust.id) || (currentFocusId && c.id === currentFocusId)){
      R.st2Workers.splice(wIdx, 1);
      continue;
    }

    worker.t -= dt;
    if(worker.t <= 0){
      staffStepWorker(worker, c, i);
    }
  }

  R.st2 = (R.st2Workers && R.st2Workers[0]) || null;

  const isShiftTimeUp = R.isNightShift ? R.nightT <= 0 : R.t <= 0;
  if(isShiftTimeUp && !R.closing) return;
  // Chuẩn tiemtranhosrc: if(list.length < 2) return;
  if(sortedSlots.length < 2) return;

  // 2. Assign free workers to waiting customers
  const freeWorkers = numBaristas - R.st2Workers.length;
  if(freeWorkers > 0){
    const can = c => c.cups.some((o, j) => !c.done[j] && needs(o).every(k => qty(k) > 0));
    // DÙNG sortedSlots.slice(1): Thợ pha chế CHỈ ĐƯỢC CHỌN TỪ KHÁCH THỨ 2 TRỞ ĐI (hàng chờ sau lưng khách đầu)!
    // Khách đầu tiên tại quầy (sortedSlots[0]) TUYỆT ĐỐI 100% KHÔNG NẰM TRONG CANDLIST CỦA THỢ PHA CHẾ!
    const candList = sortedSlots.slice(1).filter(c => {
      if(isStaff2WorkingOn(c.id)) return false;
      if((R.gzWork && R.gzWork.cId === c.id) || (R.svWork && R.svWork.cId === c.id)) return false;
      // Chuẩn nguồn gốc tiemtranhosrc: Tuyệt đối không tranh khách của quản lý/Gen Z (R.focus / curF)
      if(c.id === R.focus || (currentFocusId && c.id === currentFocusId)) return false;
      return can(c);
    });

    if(candList.length > 0){
      // Ưu tiên khách đang chờ lâu nhất (thanh kiên nhẫn thấp nhất / sắp hết)
      candList.sort((a, b) => (a.pat / a.max) - (b.pat / b.max));
      const assignCount = Math.min(freeWorkers, candList.length);
      for(let k = 0; k < assignCount; k++){
        const newWorker = { id: candList[k].id, t: st2T() };
        R.st2Workers.push(newWorker);
      }
      R.st2 = (R.st2Workers && R.st2Workers[0]) || null;
      renderLane();
      renderPanel();
    }
  }
}
const st2T = () => Math.max(0.6, 1.5 / (1 + getStaffSpeedBuff('staff2')));/* Tốc độ chuẩn: 1500ms/ly, buff tốc độ theo cấp */
function stDone(){
  if(R.isNightShift){ if(R.nightT < 0) R.otNightCloseT = Math.min(R.otNightCloseT || 0, R.nightT); }
  else if(R.t < 0) R.otT = Math.min(R.otT || 0, R.t);
  R.st2 = null;
  R.st2Workers = [];
  renderLane();
  renderPanel();
}
function stWorkerDone(worker){
  if(R.isNightShift){ if(R.nightT < 0) R.otNightCloseT = Math.min(R.otNightCloseT || 0, R.nightT); }
  else if(R.t < 0) R.otT = Math.min(R.otT || 0, R.t);
  if(Array.isArray(R.st2Workers)){
    R.st2Workers = R.st2Workers.filter(w => w !== worker);
  }
  R.st2 = (R.st2Workers && R.st2Workers[0]) || null;
  renderLane();
  renderPanel();
}
function stWorkerFinish(worker, c, i){
  if(R.slots[i] === c){
    decline(i);
    toast(c.name + ' về, món còn lại đã hết');
  }
  stWorkerDone(worker);
}
function staffStepWorker(worker,c,i){
  const skip=k=>c.skip&&c.skip[k];
  const j=c.cups.findIndex((o,k)=>!c.done[k]&&!skip(k));
  if(j<0){stWorkerFinish(worker,c,i);return}
  const o=c.cups[j];c.order=o;
  if(!needs(o).every(k=>qty(k)>0)){
    const missingK = needs(o).find(k=>qty(k)<=0);
    if(missingK && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant(missingK);
    if(!needs(o).every(k=>qty(k)>0)){
      (c.skip=c.skip||[])[j]=true;worker.t=0.25/(1+getStaffSpeedBuff('staff2'));return;
    }
  }
  const workerCup = newCup();
  workerCup.size = o.size;
  if(!useStaffCup(workerCup)){
    (c.skip = c.skip || [])[j] = true;
    worker.t = 0.25 / (1 + getStaffSpeedBuff('staff2'));
    return;
  }
  const toConsume = [
    o.base,
    ...(o.flav ? [o.flav] : []),
    ...o.tops,
    ...(o.cheese ? ['cheese'] : []),
    ...(level() >= 2 && o.sugar && o.sugar > 0 ? ['sugar'] : []),
    ...(level() >= 2 && o.ice && o.ice !== 'Không đá' ? ['ice'] : [])
  ];
  toConsume.forEach(k => { if(qty(k) > 0) consume(k); });
  const sugarN = (o.sugar === 0 ? 0 : o.sugar === 30 ? 1 : o.sugar === 50 ? 2 : o.sugar === 70 ? 3 : 4);
  const iceN = (o.ice === 'Không đá' ? 0 : o.ice === 'Ít đá' ? 1 : 2);
  Object.assign(workerCup, {
    base: o.base, flav: o.flav || null, tops: [...o.tops],
    cheese: !!o.cheese, sugar: o.sugar, ice: o.ice,
    sugarN, iceN, fill: .8, used: true
  });
  const s2Factor = Math.max(0, 1 - (STAFF_TRAINING_TIERS[getStaffTrainLv('staff2')].defectReduce || 0));
  if(Math.random() < (.005 * s2Factor)){
    const was = workerCup.tops;
    workerCup.tops = was.length ? [] : [TOP_KEYS.find(k => S.unlocked[k])];/* 0,5% làm sai: bị đổ, làm lại */
    toast('Nhân viên pha chế làm sai ly ' + (j + 1) + ' của ' + c.name + ': ' + (was.length ? 'quên ' + was.map(k => low(ITEMS[k].n)).join(', ') : 'bỏ nhầm ' + low(ITEMS[workerCup.tops[0]].n)) + '. Ly bị đổ, làm lại', 5000, 1);
  }
  if(getStaffTrainLv('staff2') >= 5) workerCup._st2Lv5Served = true;
  serve(i, workerCup);
  renderPanel();
  if(R.slots[i] !== c){ stWorkerDone(worker); return; }
  worker.t = st2T();
  if(!c.cups.some((x, k) => !c.done[k] && !skip(k))) stWorkerFinish(worker, c, i);
}
function staffStep(c, i){
  staffStepWorker(R.st2 || { id: c.id, t: st2T() }, c, i);
}
function stFinish(c, i){
  if(R.slots[i] === c){
    R.st2 = null;
    decline(i);
    toast(c.name + ' về, món còn lại đã hết');
  }
  stDone();
}

/* ==================== NHÂN VIÊN ĐƠN ONLINE (staffOn) - CHUẨN 100% BẢN GỐC TRÀ NHỎ ==================== */
function staffOnTick(dt){
  if(!isStaffActive('staffOn') || !R.running) return;
  const numWorkers = (typeof getStaffOnCount === 'function') ? getStaffOnCount() : (S.upg.staffOn ? 1 : 0);
  if(numWorkers <= 0) return;

  R.stoWorkers = R.stoWorkers || [];
  if(R.sto && !R.stoWorkers.some(w => w && w.id === R.sto.id)){
    R.stoWorkers.push(R.sto);
  }

  // 1. Process active workers
  for(let wIdx = R.stoWorkers.length - 1; wIdx >= 0; wIdx--){
    const worker = R.stoWorkers[wIdx];
    if(!worker){ R.stoWorkers.splice(wIdx, 1); continue; }

    const j = R.online.findIndex(x => x && x.id === worker.id);
    if(j < 0){
      R.stoWorkers.splice(wIdx, 1);
      continue;
    }
    worker.t -= dt;
    if(worker.t <= 0){
      staffOnStepWorker(worker, R.online[j], j);
    }
  }

  R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;

  // 2. Assign free workers to waiting online orders
  const freeWorkers = numWorkers - R.stoWorkers.length;
  if(freeWorkers > 0){
    const can = c => c.cups.some((o, k) => !c.done[k] && needs(o).every(item => qty(item) > 0));
    const candList = R.online.filter(c => {
      if(c.id === R.focus) return false;
      if(R.stoWorkers.some(w => w && w.id === c.id)) return false;
      return can(c);
    }).sort((a, b) => (a.pat / a.max) - (b.pat / b.max));

    if(candList.length > 0){
      const assignCount = Math.min(freeWorkers, candList.length);
      const onlSpd = Math.max(0.4, 1.0 / (1 + getStaffSpeedBuff('staffOn')));
      for(let k = 0; k < assignCount; k++){
        R.stoWorkers.push({ id: candList[k].id, t: onlSpd });
      }
      R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;
      renderLane();
      renderPanel();
    }
  }
}

function staffOnStepWorker(worker, c, j){
  const q = c.cups.findIndex((o, k) => !c.done[k] && !(c.skip && c.skip[k]));
  if(q < 0){
    if(Array.isArray(R.stoWorkers)) R.stoWorkers = R.stoWorkers.filter(w => w !== worker);
    R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;
    declineOnline(j);
    toast('Đơn #' + c.id + ' thiếu món, nhân viên huỷ phần còn lại');
    renderLane();
    return;
  }
  const o = c.cups[q];
  if(!needs(o).every(k => qty(k) > 0)){
    const missingK = needs(o).find(k => qty(k) <= 0);
    if(missingK && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant(missingK);
    if(!needs(o).every(k => qty(k) > 0)){
      (c.skip = c.skip || [])[q] = true;
      if(worker) worker.t = 0.3;
      return;
    }
  }
  const onlCup = newCup();
  onlCup.size = o.size;
  if(!useStaffCup(onlCup)){
    (c.skip = c.skip || [])[q] = true;
    if(worker) worker.t = 0.3;
    return;
  }
  const toConsumeOnl = [
    o.base,
    ...(o.flav ? [o.flav] : []),
    ...o.tops,
    ...(o.cheese ? ['cheese'] : []),
    ...(level() >= 2 && o.sugar && o.sugar > 0 ? ['sugar'] : []),
    ...(level() >= 2 && o.ice && o.ice !== 'Không đá' ? ['ice'] : [])
  ];
  toConsumeOnl.forEach(k => { if(qty(k) > 0) consume(k); });
  const onlSugarN = (o.sugar === 0 ? 0 : o.sugar === 30 ? 1 : o.sugar === 50 ? 2 : o.sugar === 70 ? 3 : 4);
  const onlIceN = (o.ice === 'Không đá' ? 0 : o.ice === 'Ít đá' ? 1 : 2);
  Object.assign(onlCup, {
    base: o.base, flav: o.flav || null, tops: [...o.tops],
    cheese: !!o.cheese, sugar: o.sugar, ice: o.ice,
    sugarN: onlSugarN, iceN: onlIceN, fill: 0.8, used: true
  });
  const onlSpd = Math.max(0.4, 1.0 / (1 + getStaffSpeedBuff('staffOn')));
  const sOnFactor = Math.max(0, 1 - (STAFF_TRAINING_TIERS[getStaffTrainLv('staffOn')].defectReduce || 0));
  const onlSpoilChance = (isStaffActive('staffGuard') ? 0.005 : 0.01) * sOnFactor;
  if(Math.random() < onlSpoilChance){
    if(worker) worker.t = onlSpd;
    toast('Nhân viên đơn online làm hỏng 1 ly của đơn #' + c.id + ', đổ bỏ làm lại 🥤🗑️', 5000, 1);
    return;
  }
  c.order = o;
  serveOnline(j, onlCup);
  renderPanel();
  coach();
  if(!R.online.includes(c)){
    if(Array.isArray(R.stoWorkers)) R.stoWorkers = R.stoWorkers.filter(w => w !== worker);
    R.sto = (R.stoWorkers && R.stoWorkers[0]) || null;
    renderLane();
    return;
  }
  if(worker) worker.t = onlSpd;
}

function staffOnStep(c, j){
  staffOnStepWorker(R.sto, c, j);
}

/* nhân viên Gen Z: tự động pha chế từ A-Z với các bước có thời gian chờ & hoạt ảnh trực quan (lấy ly, topping, rót trà, hương, đường, đá, dán nắp, giao).
   Khi bị áp lực khách chê / đánh giá xấu sẽ tự đình công nghỉ ngang đi chữa lành.
   Người chơi cần ấn liên tục vào nhân viên để động viên (5 lần) thì sẽ vui vẻ làm tiếp.
   Nếu không có chủ quán giám sát, đôi khi Gen Z sẽ "đá bill" (ẵm trọn tiền bill). Chủ quán có thể chạm để giám sát hoặc bắt quả tang! */
function gzTriggerSulk(why, st){
  if(!S.upg.staffGz || !R.running || R.gzSulking) return;
  if(getStaffTrainLv('staffGz') >= 4) return; // Đào tạo Lv.4+: Tâm lý vững vàng 100%, không bao giờ tự ý đi chữa lành!
  if(S.gzNeverSulk || (R.today && R.today.gzStealSuccess)) return; // khi gen z đá bill thành công thì sẽ không bao giờ dỗi nữa
  if(why !== 'overwork' && R.gzCheeredToday) return; // Mỗi ngày gen z chỉ cần dỗ dành 1 lần (trừ khi làm đủ 100 ly kiệt sức)
  if(why !== 'overwork' && R.gzSulkCooldown && Date.now() < R.gzSulkCooldown) return;
  R.gzSulking = true;
  R.gzCheers = 0;
  R.gzSulkTimer = 25; // 25s rộng rãi để người chơi kịp bấm dỗ dành
  R.gzWork = null;
  R.sealing = false;
  R.pour = null;
  clearStaffPouring();
  if(cup && cup.staff) cup = newCup();

  let quotes = [];
  if(why === 'overwork'){
    quotes = [
      'Em làm liền tù tì mệt lả rồi sếp ơi... Tụt mood quá, sếp mau dỗ em đi không em nghỉ việc đó! 🥺💔',
      'Pha liên tục kiệt quệ năng lượng rồi... Sếp dỗ em trong 25s kẻo em nộp đơn nghỉ việc luôn! 🥺'
    ];
  } else if(why === 'rain'){
    quotes = [
      'Trời mưa buồn quá, tâm trạng em bất ổn rồi... Em xin phép đi healing ngắm mưa sếp ơi! 🌧️🥺',
      'Mưa gió thế này năng lượng em tụt dốc không phanh... Em xin tạm nghỉ đi chữa lành đây! 🌧️💔'
    ];
  } else if(why === 'hot'){
    quotes = [
      'Trời nắng gắt oi bức quá, nhiệt huyết em bốc hơi hết rồi! Em xin phép nghỉ hạ hoả chữa lành nhé! ☀️🥺',
      'Nắng nóng làm em tụt mood quá sếp ơi... Em đi healing tránh nóng đây! ☀️💔'
    ];
  } else if(why === 'timeout' || why === 'late'){
    quotes = [
      'Khách bỏ về chê phục vụ lâu làm em hoảng loạn... Em xin phép nghỉ ngang để chữa lành cảm xúc! 🥺💔',
      'Áp lực đơn dồn dập khiến em sang chấn tâm lý quá... Cho em xin tạm nghỉ đi healing! 🎧🥺'
    ];
  } else if(why === 'wrong' || why === 'bad' || (st && st <= 2)){
    quotes = [
      'Khách chê & đánh giá xấu quá, năng lượng em về 0 rồi... Em đi healing đây! 🥺💔',
      'Tổn thương đứa trẻ bên trong em rồi... Sếp mau dỗ em đi không em nghỉ luôn đó! 🥺'
    ];
  } else {
    quotes = [
      'Áp lực quán căng quá, em bị tụt mood nghiêm trọng rồi... Sếp chạm dỗ em cái em mới làm tiếp nha! 💔🥺',
      'Em dỗi rồi, đi chữa lành đây sếp ơi! 🥺🎧'
    ];
  }
  R.gzMsg = quotes[Math.floor(Math.random() * quotes.length)];
  toast(why === 'overwork' ? '🚨 Gen Z làm liên tục mệt lả đi chữa lành! Bấm dỗ dành trong 25s nhé! 🥺💔' : '🚨 Gen Z đình công đi chữa lành! Bấm dỗ dành trong 25s nhé! 🥺💔', 5000, 1);
  sfx('bad');
  renderGzWidget();
}

function gzCheer(e){
  if(!S.upg.staffGz || !R.running) return;
  if(e && e.stopPropagation) e.stopPropagation();
  if(R.gzSulking){
    R.gzSulking = false;
    R.gzCheers = 0;
    R.gzSulkTimer = 0;
    R.gzCheeredToday = true; // Mỗi ngày gen z chỉ cần dỗ dành 1 lần
    R.gzSulkCooldown = Date.now() + 60000; // Miễn nhiễm dỗi 60s sau khi dỗ dành
    R.gzFalseCatchCount = 0;
    R.gzWork = null;
    R.sealing = false;
    R.pour = null;
    clearStaffPouring();
    sfx('lvup');
    gzSpawnHeart(e);
    const pName = staffPersonName('staffGz') || 'Gen Z';
    R.gzMsg = 'Em đã được chữa lành! Lại chiến tiếp đây sếp ơi! 🔥💪';
    toast(`💖 Nhân viên ${pName}: "Em được sếp dỗ ngọt ngào nên hết dỗi rồi! Vào việc tiếp đây sếp ơi! 🔥"`, 4500, 1);
  }
  renderGzWidget();
  renderLane();
  renderCup();
  renderPanel();
}

function gzWeatherComplain(){
  if(!isStaffActive('staffGz') || !R.running || R.gzSulking) return;
  if(getStaffTrainLv('staffGz') >= 4) return;
  R.gzWeatherComplaining = true;
  R.gzMsg = evIs('rain') ? 'Mưa gió ế ẩm quá sếp ơi, em lười không muốn pha chế nè... 🌧️ Chạm để dỗ dành em nha!' : 'Nắng nóng chảy mỡ sếp ơi, em mệt xỉu không muốn làm... ☀️ Chạm để dỗ dành em nha!';
  renderGzWidget();
}

function onGzWidgetClick(e){
  if(!S.upg.staffGz || !R.running) return;
  if(e){ e.stopPropagation(); if(e.cancelable && e.preventDefault) e.preventDefault(); }
  const now = Date.now();
  if(onGzWidgetClick._lastTrigger && (now - onGzWidgetClick._lastTrigger < 300)) return;
  onGzWidgetClick._lastTrigger = now;

  if(R.gzWeatherComplaining){
    R.gzWeatherComplaining = false;
    sfx('lvup');
    gzSpawnHeart(e);
    toast('💖 Đã dỗ dành Gen Z! Bạn ấy vui vẻ tràn trề năng lượng làm việc! ✨', 3500);
    R.gzMsg = 'Cảm ơn sếp iu đã dỗ dành, em có động lực pha trà hết mình rồi nè! 🥰✨';
    renderGzWidget();
    return;
  }

  if((e.target && e.target.closest('[data-gz-act="police"]')) || (e.target && e.target.closest('.police-btn'))){
    reportFakeMoneyPolice();
    return;
  }

  // Chạm bất cứ đâu trên widget khi Gen Z dỗi đều dỗ dành thành công 100%
  if(R.gzSulking || (e.target && e.target.closest('[data-gz-act="cheer"]')) || (e.target && e.target.closest('.cheer-btn'))){
    gzCheer(e);
    return;
  }

  // Bắt quả tang: nếu vừa đá bill HOẶC đang trong 5s thời hạn đếm ngược HOẶC còn ghi nhận bill bị đá
  const isCatchWindow = R.gzStolenRecent || (R.gzCatchExpiresAt && Date.now() < R.gzCatchExpiresAt) || (R.gzLastStolenBill > 0);
  if(isCatchWindow){
    catchGenZ();
    return;
  }
}

function gzFalseCatchAccusation(){
  R.gzFalseCatchCount = (R.gzFalseCatchCount || 0) + 1;
  const now = Date.now();
  const isRapid = R.gzLastCatchClick && (now - R.gzLastCatchClick < 3500);
  R.gzLastCatchClick = now;

  // Tính tỉ lệ nghỉ việc khi bấm không đúng lúc (spam)
  let quitChance = R.gzFalseCatchCount === 1 ? 0.25 : R.gzFalseCatchCount === 2 ? 0.55 : 0.90;
  if(isRapid) quitChance += 0.25;

  if(Math.random() < quitChance){
    gzQuitFromSpamCatch();
    return;
  }

  sfx('bad');
  const warnLines = [
    'Gen Z: "Ủa sếp? Em đang pha chế đàng hoàng sếp bấm Bắt quả tang vu oan em vậy? Nghi ngờ em là em dỗi em bỏ việc luôn đó nha! 😡🎧"',
    'Gen Z: "Sếp lại bấm vu oan em đấy à? Quán đừng có ép người quá đáng! Bấm lần nữa là em bỏ việc đi luôn đấy! ⚠️😤"',
    'Gen Z: "Em không có đá bill! Sếp đừng có spam nút bắt quả tang sỉ nhục em, tổn thương đứa trẻ bên trong em rồi! 💔😡"'
  ];
  const msg = warnLines[Math.min(R.gzFalseCatchCount - 1, warnLines.length - 1)];
  R.gzMsg = 'Bị sếp vu oan bắt quả tang vô cớ! Rất bực mình! 😤';
  toast(msg, 4500, 1);
  renderGzWidget();
}

function gzQuitFromSulk(){
  const pName = staffPersonName('staffGz') || 'Gen Z';
  const pAvatar = staffAvatarUrl('staffGz');
  S.upg.staffGz = false;
  if(S.hired) S.hired.staffGz = false; // Phải thuê lại 1tr!
  if(S.staffKpi && S.staffKpi.staffGz) S.staffKpi.staffGz = { trafficBuff: 0, billBonus: 0, level: 0 };
  if(S.staffTraining) S.staffTraining.staffGz = 0;
  if(S.staffTotalDaysWorked) S.staffTotalDaysWorked.staffGz = 0;
  if(S.staffNames) delete S.staffNames.staffGz;
  if(S.staffAvatars) delete S.staffAvatars.staffGz;
  R.gzWork = null;
  R.gzSulking = false;
  R.gzSulkTimer = 0;
  R.gzStolenRecent = false;
  R.sealing = false;
  R.pour = null;
  clearStaffPouring();
  if(cup){
    cup.staff = false;
    if(cup.used) cup = newCup();
  }
  sfx('bad');

  const gz1StarTexts = [
    'Quán vô tâm, sếp không hề quan tâm nhân viên! Người ta tổn thương đi healing mà 25s trôi qua không thèm dỗ 1 câu! Cạch mặt quán!',
    'Môi trường cực kỳ lạnh nhạt, sếp thờ ơ bỏ mặc nhân viên dỗi tụt mood! Em nộp đơn nghỉ việc luôn cho sếp tự làm!',
    'Không dỗ dành kịp thời làm tổn thương đứa trẻ bên trong em sâu sắc! 1 sao vì chủ quán quá vô cảm!',
    'Tưởng tiệm trà mơ ước hoá ra sếp bỏ bê nhân viên! Dỗi 25s không ai dỗ, em thu dọn đồ đạc nghỉ việc luôn!',
    '1 sao bóc phốt quán trà sữa bóc lột, nhân viên bị áp lực đi chữa lành mà sếp ngó lơ không thèm dỗ dành!'
  ];
  const gzRev = {
    s: 1,
    t: rnd(gz1StarTexts),
    k: 'gz_quit_sulk_' + Date.now(),
    d: S.day,
    o: false,
    n: `${pName} (Cựu Gen Z)`,
    f: pAvatar,
    tag: 'genz_quit_sulk',
    isGzRev: true,
    b: null, fl: null, tp: [], ch: false, sz: 'M'
  };
  S.reviews.unshift(gzRev);
  if(R.today && Array.isArray(R.today.stars)) R.today.stars.push(1);
  S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
  if(S.reviews.length > 2500) S.reviews.length = 2500;
  save();
  head();
  renderGzWidget();
  renderCup();
  renderPanel();
  renderLane();

  // Tạm dừng game để modal thông báo không bị trôi thời gian ca
  if(R && R.running && !R.paused){
    R.paused = true;
    clearInterval(timer);
  }

  ask(`
    <div class="pbig">💔🥺</div>
    <h2 style="color:#dc2626;font-weight:800;font-size:1.25rem;margin:4px 0 8px;">GEN Z NGHỈ VIỆC VÌ KHÔNG ĐƯỢC DỖ DÀNH!</h2>
    <p style="line-height:1.55;font-size:0.92rem;color:var(--ink);">
      Do bạn <b>quá 25 giây không dỗ dành</b> khi Gen Z đi chữa lành, bạn ấy cảm thấy bị sếp ngó lơ, tổn thương tâm lý nên đã tháo tạp dề bỏ việc luôn:<br>
      <i style="color:#b91c1c;font-weight:700;display:block;margin:6px 0;">"Em dỗi cả buổi mà sếp chẳng thèm dỗ em lấy một câu... Em thấy sếp không hề trân trọng em, em nộp đơn nghỉ việc và vừa lên mạng bóc phốt 1 sao quán luôn rồi! 😭💔"</i>
    </p>
    <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:10px;padding:8px 12px;font-size:0.86rem;color:#991b1b;margin-top:8px;text-align:left;">
      ⚠️ <b>Hậu quả:</b><br>
      • Gen Z đã <b>nghỉ việc hẳn</b> (xóa cấp Đào tạo &amp; thâm niên, lần sau muốn tuyển lại phải trả phí <b>1.000.000đ</b>).<br>
      • Quán vừa bị <b>đánh giá 1 sao</b> trong mục Đánh giá (hãy vào trả lời để xoa dịu nhé)!<br>
      • Quầy pha chế đã chuyển về chế độ <b>chủ tiệm tự tay làm</b>, tiếp tục phục vụ khách ngay!
    </div>
  `, [
    ['Đã hiểu, tự làm tiếp', ()=>{
      R.sealing = false;
      R.pour = null;
      clearStaffPouring();
      if(cup){ cup.staff = false; if(cup.used) cup = newCup(); }
      if(R && R.running) resumeGame();
      renderCup();
      renderPanel();
      renderLane();
    }, 1]
  ]);
}

function gzQuitFromSpamCatch(){
  const pName = staffPersonName('staffGz') || 'Gen Z';
  const pAvatar = staffAvatarUrl('staffGz');
  S.upg.staffGz = false;
  if(S.hired) S.hired.staffGz = false; // Phải thuê lại 1tr!
  if(S.staffKpi && S.staffKpi.staffGz) S.staffKpi.staffGz = { trafficBuff: 0, billBonus: 0, level: 0 };
  if(S.staffTraining) S.staffTraining.staffGz = 0;
  if(S.staffTotalDaysWorked) S.staffTotalDaysWorked.staffGz = 0;
  if(S.staffNames) delete S.staffNames.staffGz;
  if(S.staffAvatars) delete S.staffAvatars.staffGz;
  R.gzWork = null;
  R.gzSulking = false;
  R.gzStolenRecent = false;
  R.sealing = false;
  R.pour = null;
  clearStaffPouring();
  if(cup){
    cup.staff = false;
    if(cup.used) cup = newCup();
  }
  sfx('bad');

  const gz1StarTexts = [
    'Quán chèn ép nhân viên, bóc lột sức lao động, sếp toxic suốt ngày vu oan vô cớ! Cạch mặt quán này!',
    'Quán lừa sinh viên mới ra trường! Bắt làm đủ thứ từ A-Z xong quay sang vu khống ăn cắp tiền bill, quá thất đức!',
    'Môi trường cực kỳ độc hại! Chủ quán đa nghi như Tào Tháo, động tí là bấm bắt quả tang sỉ nhục nhân viên. Né gấp!',
    'Tưởng tiệm trà mơ ước hoá ra ác mộng! Ép người quá đáng, làm như người ta thèm mấy đồng bạc lẻ của quán không bằng!',
    '1 sao vì chủ quán quá đáng! Vu oan giá hoạ cho sinh viên làm thêm, làm ăn thất đức sớm muộn cũng dẹp tiệm!'
  ];
  const gzRev = {
    s: 1,
    t: rnd(gz1StarTexts),
    k: 'gz_quit_' + Date.now(),
    d: S.day,
    o: false,
    n: `${pName} (Cựu Gen Z)`,
    f: pAvatar,
    tag: 'genz_quit',
    isGzRev: true,
    b: null, fl: null, tp: [], ch: false, sz: 'M'
  };
  S.reviews.unshift(gzRev);
  if(R.today && Array.isArray(R.today.stars)) R.today.stars.push(1);
  S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
  if(S.reviews.length > 2500) S.reviews.length = 2500;
  save();
  head();
  renderGzWidget();
  renderCup();
  renderPanel();
  renderLane();

  // Tạm dừng game để modal thông báo không bị trôi thời gian ca
  if(R && R.running && !R.paused){
    R.paused = true;
    clearInterval(timer);
  }

  ask(`
    <div class="pbig">💔😤</div>
    <h2 style="color:#dc2626;font-weight:800;font-size:1.25rem;margin:4px 0 8px;">GEN Z NGHỈ VIỆC VÌ BỊ VU OAN!</h2>
    <p style="line-height:1.55;font-size:0.92rem;color:var(--ink);">
      Do bạn <b>bấm bắt quả tang vô cớ (spam)</b> khi nhân viên không hề đá bill, Gen Z đã phẫn nộ tháo tạp dề bỏ về:<br>
      <i style="color:#b91c1c;font-weight:700;display:block;margin:6px 0;">"Em làm việc đàng hoàng mà sếp vu oan ép người quá đáng! Em nộp đơn nghỉ việc luôn, và em vừa lên mạng tặng quán 1 sao bóc phốt!"</i>
    </p>
    <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:10px;padding:8px 12px;font-size:0.86rem;color:#991b1b;margin-top:8px;text-align:left;">
      ⚠️ <b>Hậu quả:</b><br>
      • Gen Z đã <b>nghỉ việc hẳn</b> (lần sau muốn tuyển lại phải trả phí <b>1.000.000đ</b>).<br>
      • Quán vừa bị <b>đánh giá 1 sao</b> trong mục Đánh giá (hãy vào trả lời để xoa dịu nhé)!<br>
      • Quầy pha chế đã chuyển về chế độ <b>chủ tiệm tự tay làm</b>, tiếp tục phục vụ khách ngay!
    </div>
  `, [
    ['Đã hiểu, tự làm tiếp', ()=>{
      R.sealing = false;
      R.pour = null;
      clearStaffPouring();
      if(cup){ cup.staff = false; if(cup.used) cup = newCup(); }
      if(R && R.running) resumeGame();
      renderCup();
      renderPanel();
      renderLane();
    }, 1]
  ]);
}

function catchGenZ(){
  clearTimeout(R._gzCatchTimer);
  const stAmt = R.gzLastStolenBill || (R.today && R.today.gzStolen) || 0;
  if(stAmt <= 0) return;

  S.money += stAmt;
  R.today.rev += stAmt;
  S.totalRev += stAmt;
  R.today.gzStolen = Math.max(0, (R.today.gzStolen || 0) - stAmt);
  R.gzLastStolenBill = 0;
  R.gzStolenRecent = false;
  R.gzCatchExpiresAt = 0;
  R.gzStolenCustId = null;
  R.gzStealCooldown = 0;
  R.today.gzTipToShop = false;

  // Tịch thu tiền bo nhân viên đã giữ trong ngày
  let confTip = 0;
  if(S.cur && S.cur.staffTip > 0){
    confTip = S.cur.staffTip;
    S.cur.staffTip = 0;
    S.cur.tips = (S.cur.tips || 0) + confTip;
    S.money += confTip;
    S.totalRev += confTip;
    R.today.tips = (R.today.tips || 0) + confTip;
  }

  // Đã bị bắt quả tang -> Đã tính 1 lần đá bill hôm nay, không tăng tỉ lệ và cam kết không tái phạm
  if(R.today){
    R.today.gzStealAttempts = Math.max(1, (R.today.gzStealAttempts || 0));
    R.today.gzStealSuccess = false;
  }
  R.gzCaughtCount = 0;

  const pName = staffPersonName('staffGz') || 'Gen Z';
  sfx('lvup');
  R.gzMsg = `${pName} cúi đầu: "Em nộp lại bill ${fmt(stAmt)} và nộp hết tiền bo, xin lỗi sếp ạ!" 😭✨`;
  renderGzWidget();
  head();
  save();

  const moneyEl = $('hMoney') || document.body;
  if(typeof fl === 'function') fl(moneyEl, `+${fmt(stAmt + confTip)}`, false);
  toast(`🚨 BẮT QUẢ TANG! Thu hồi ${fmt(stAmt)}${confTip > 0 ? ` và tịch thu ${fmt(confTip)} tiền bo` : ''} từ ${pName}! 🎉`, 4000, 1);
}

function gzSpawnHeart(e){
  const el = $('gzWidget');
  if(!el) return;
  const rect = el.getBoundingClientRect();
  const h = document.createElement('div');
  h.className = 'gz-fly-heart';
  const icons = ['💖','✨','🧋','💕','🔥','🌟','👀'];
  h.textContent = icons[Math.floor(Math.random() * icons.length)];
  const x = e && e.clientX ? (e.clientX - rect.left) : (rect.width * (0.2 + Math.random() * 0.6));
  const y = e && e.clientY ? (e.clientY - rect.top) : (rect.height * 0.4);
  h.style.left = x + 'px';
  h.style.top = y + 'px';
  el.appendChild(h);
  setTimeout(() => h.remove(), 950);
}

function renderGzWidget(){
  const w = $('gzWidget');
  const st = $('q3stage');
  if(!w) return;
  if(!isStaffActive('staffGz') || !R.running || R.isNightShift){
    if(w.style.display !== 'none') w.style.display = 'none';
    if(st) st.classList.remove('has-gz');
    return;
  }

  if(w.style.display !== 'flex') w.style.display = 'flex';
  if(st && !st.classList.contains('has-gz')) st.classList.add('has-gz');

  const pName = staffPersonName('staffGz') || 'Nhân viên Gen Z';
  const avtImg = staffAvatarImg('staffGz', 38);

  const isSulking = !!R.gzSulking;
  const isStealing = !!(R.gzStolenRecent || (R.gzCatchExpiresAt && Date.now() < R.gzCatchExpiresAt) || (R.gzLastStolenBill > 0));
  const isChiding = !!(R.gzWork && R.gzWork.chide && Date.now() < (R.gzWork.chideUntil || 0));
  const isMistakeMsg = !!(R.gzMistakeMsg && Date.now() < (R.gzMistakeMsgUntil || 0));
  const isTipMsg = !!(R.gzTipMsg && Date.now() < (R.gzTipMsgUntil || 0));
  const isTripRunning = !!(R.buyerTrip && R.buyerTrip.t > 0);
  const isBuyerMsg = !!(R.gzBuyerMsg && Date.now() < (R.gzBuyerMsgUntil || 0));

  // Khởi tạo khung DOM tĩnh duy nhất 1 lần nếu chưa có để triệt tiêu 100% hiện tượng nhảy tab
  if(!w.querySelector('.gz-body') || !w.querySelector('#gzMsgEl')){
    w.innerHTML = `
      <div class="gz-avatar" id="gzAvtBox" style="position:relative;">${avtImg}</div>
      <div class="gz-body">
        <div class="gz-head-row">
          <span class="gz-name" id="gzNameEl">${esc(pName)}</span>
          <span class="gz-pill" id="gzPillEl">⚡ Tự động pha chế A-Z</span>
        </div>
        <div class="gz-msg" id="gzMsgEl">Đang sẵn sàng nhận đơn pha chế... ✨</div>
        <div class="gz-cheer-row" id="gzCheerRow" style="display:none;"></div>
      </div>
      <button type="button" class="gz-poke-chip" id="gzBtnEl" style="display:none;"></button>
    `;
  }

  const avtBox = w.querySelector('#gzAvtBox');
  const hpIcon = w.querySelector('.gz-hp');
  if(hpIcon) hpIcon.remove();
  const nameEl = w.querySelector('#gzNameEl');
  const pillEl = w.querySelector('#gzPillEl');
  const msgEl = w.querySelector('#gzMsgEl');
  const cheerRow = w.querySelector('#gzCheerRow');
  const btnEl = w.querySelector('#gzBtnEl');

  if(nameEl && nameEl.textContent !== pName) nameEl.textContent = pName;

  const isFakeMoney = !!(R.fakeCase && R.fakeCase.suspect && !R.fakeCase.expired && !R.fakeCase.reported);
  let fakeLeft = 0;
  if(isFakeMoney){
    const elapsed = Math.floor((Date.now() - (R.fakeCase.time || Date.now())) / 1000);
    fakeLeft = Math.max(0, 10 - elapsed);
    if(fakeLeft <= 0){
      R.fakeCase.expired = true;
    }
  }
  const isFakeActive = isFakeMoney && fakeLeft > 0;
  if(!isFakeActive && w.classList.contains('gz-fakemoney')){
    w.classList.remove('gz-fakemoney');
    if(btnEl && btnEl.getAttribute('data-gz-act') === 'police'){
      btnEl.style.display = 'none';
      btnEl.className = 'gz-poke-chip';
      btnEl.removeAttribute('data-gz-act');
      btnEl.onclick = null;
    }
  }

  // Đảm bảo widget luôn hiển thị chuẩn 2 hàng, không bao giờ bị dồn 3 hàng gây tràn khung
  if(!isSulking){
    if(cheerRow) cheerRow.style.display = 'none';
    if(msgEl) msgEl.style.display = '';
  } else {
    if(msgEl) msgEl.style.display = 'none';
    if(cheerRow) cheerRow.style.display = 'flex';
  }

  if(isFakeActive){
    w.className = 'gz-widget gz-fakemoney';
    const sName = R.fakeCase.suspect ? R.fakeCase.suspect.name : 'Khách';
    if(pillEl){
      pillEl.className = 'gz-pill';
      pillEl.textContent = '🚨 TIỀN GIẢ! (' + fakeLeft + 's)';
      pillEl.style.background = '#dc2626';
      pillEl.style.color = '#fff';
    }
    if(msgEl){
      msgEl.textContent = 'Khách ' + sName + ' vừa đưa tiền giả! Báo C.An ngay (+500k)!';
      msgEl.style.color = '#b91c1c';
      msgEl.style.fontWeight = '700';
    }
    if(btnEl){
      btnEl.style.display = 'flex';
      btnEl.className = 'gz-poke-chip police-btn';
      btnEl.setAttribute('data-gz-act', 'police');
      btnEl.innerHTML = '🚨 Báo C.An <b>' + fakeLeft + 's</b> (+500k)';
      const doPolice = (e) => { if(e){ e.stopPropagation(); if(e.cancelable && e.preventDefault) e.preventDefault(); } reportFakeMoneyPolice(); };
      btnEl.onpointerdown = doPolice;
      btnEl.onclick = doPolice;
    }
  } else if(isSulking){
    w.className = 'gz-widget gz-sulking';
    const rem = Math.max(0, Math.ceil(R.gzSulkTimer != null ? R.gzSulkTimer : 10));
    const c = Math.min(3, R.gzCheers || 0);

    if(pillEl){
      pillEl.className = 'gz-pill gz-pill-sulk';
      pillEl.textContent = '💔 Đi chữa lành (' + rem + 's)';
      pillEl.style.background = '';
      pillEl.style.color = '';
    }
    if(cheerRow){
      cheerRow.innerHTML = '<span class="gz-cheer-hint">👉 Dỗ trong <b class="gz-sulk-sec" style="color:#b91c1c;">' + rem + 's</b>:</span> <span class="gz-hearts-bar">' + '💖'.repeat(c) + '🤍'.repeat(3 - c) + '</span> <b class="gz-cheer-num">' + c + '/3</b>';
    }
    if(btnEl){
      btnEl.style.display = 'block';
      btnEl.className = 'gz-poke-chip cheer-btn';
      btnEl.setAttribute('data-gz-act', 'cheer');
      btnEl.textContent = '💖 Dỗ dành (' + c + '/3)';
      const doCheer = (e) => { if(e){ e.stopPropagation(); if(e.cancelable && e.preventDefault) e.preventDefault(); } gzCheer(e); };
      btnEl.onpointerdown = doCheer;
      btnEl.onclick = doCheer;
    }
  } else if(isStealing){
    w.className = 'gz-widget gz-stealing';
    const remSec = R.gzCatchExpiresAt ? Math.max(1, Math.ceil((R.gzCatchExpiresAt - Date.now()) / 1000)) : 5;
    const stolenVal = R.gzLastStolenBill || (R.today && R.today.gzStolen) || 0;

    if(pillEl){
      pillEl.className = 'gz-pill gz-pill-stole';
      pillEl.textContent = '🤫 Đang đá bill (' + remSec + 's)!';
      pillEl.style.background = '';
      pillEl.style.color = '';
    }
    if(msgEl){
      msgEl.textContent = 'Vừa lén ẵm bill ' + fmt(stolenVal) + '! Bấm "Bắt quả tang" ngay!';
      msgEl.style.color = '';
    }
    if(cheerRow) cheerRow.style.display = 'none';
    if(btnEl){
      btnEl.style.display = 'block';
      btnEl.className = 'gz-poke-chip catch-active';
      btnEl.setAttribute('data-gz-act', 'catch');
      btnEl.textContent = '🚨 Bắt quả tang (' + remSec + 's)';
      const doCatch = (e) => { if(e){ e.stopPropagation(); if(e.cancelable && e.preventDefault) e.preventDefault(); } catchGenZ(); };
      btnEl.onpointerdown = doCatch;
      btnEl.onclick = doCatch;
    }
  } else if(isChiding){
    w.className = 'gz-widget gz-chiding';
    if(pillEl){
      pillEl.className = 'gz-pill';
      pillEl.textContent = '😤 Cứu nguy (Sếp làm chậm)';
      pillEl.style.background = '#e11d48';
      pillEl.style.color = '#fff';
    }
    if(msgEl){
      msgEl.textContent = '"' + R.gzWork.chide + '"';
      msgEl.style.color = '#e11d48';
    }
    if(cheerRow) cheerRow.style.display = 'none';
    if(btnEl) btnEl.style.display = 'none';
  } else if(isMistakeMsg){
    w.className = 'gz-widget gz-mistake';
    if(pillEl){
      pillEl.className = 'gz-pill';
      pillEl.textContent = '🗑️ Sơ ý làm sai bill';
      pillEl.style.background = '#e11d48';
      pillEl.style.color = '#fff';
    }
    if(msgEl){
      msgEl.textContent = R.gzMistakeMsg;
      msgEl.style.color = '#e11d48';
      msgEl.style.fontWeight = '700';
    }
    if(cheerRow) cheerRow.style.display = 'none';
    if(btnEl) btnEl.style.display = 'none';
  } else if(isTipMsg){
    w.className = 'gz-widget gz-tip';
    if(pillEl){
      pillEl.className = 'gz-pill';
      pillEl.textContent = '💵 Nộp lại tiền bo (+' + fmt(R.gzLastReturnedTip || 0) + ')';
      pillEl.style.background = '#059669';
      pillEl.style.color = '#fff';
    }
    if(msgEl){
      msgEl.textContent = R.gzTipMsg;
      msgEl.style.color = '#059669';
      msgEl.style.fontWeight = '700';
    }
    if(cheerRow) cheerRow.style.display = 'none';
    if(btnEl) btnEl.style.display = 'none';
  } else if(isTripRunning){
    w.className = 'gz-widget gz-trip-running';
    const rem = Math.max(0.1, R.buyerTrip.t).toFixed(1);
    const itemName = R.buyerTrip.name || 'nguyên liệu';
    const bName = staffPersonName('staffBuyer') || 'NV Đi Chợ';
    if(pillEl){
      pillEl.className = 'gz-pill';
      pillEl.textContent = '🛵 Đang đi chợ (' + rem + 's)';
      pillEl.style.background = '#d97706';
      pillEl.style.color = '#fff';
    }
    if(msgEl){
      msgEl.textContent = `🛵 ${bName} đang chạy mua ${itemName} (${rem}s)... 💨`;
      msgEl.style.color = '#92400e';
      msgEl.style.fontWeight = '700';
    }
    if(cheerRow) cheerRow.style.display = 'none';
    if(btnEl) btnEl.style.display = 'none';
  } else if(isBuyerMsg){
    w.className = 'gz-widget gz-buyer-notif';
    if(pillEl){
      pillEl.className = 'gz-pill';
      pillEl.textContent = '🛵 Đi chợ về';
      pillEl.style.background = '#0284c7';
      pillEl.style.color = '#fff';
    }
    if(msgEl){
      msgEl.textContent = R.gzBuyerMsg;
      msgEl.style.color = '#0284c7';
      msgEl.style.fontWeight = '700';
    }
    if(cheerRow) cheerRow.style.display = 'none';
    if(btnEl) btnEl.style.display = 'none';
  } else {
    w.className = 'gz-widget gz-normal';
    let status = 'Tự động pha chế A-Z... ✨';
    let pillText = '⚡ Tự động pha chế A-Z';
    if(R.gzWork){
      const wSt = R.gzWork.step;
      const c = R.gzWork.type === 'lane' ? R.slots[R.gzWork.slotIdx] : (R.online||[]).find(x => x && x.id === R.gzWork.cId);
      const o = c ? c.cups[R.gzWork.cupIdx] : null;
      if(wSt === 'cup'){
        status = `🥤 Đang lấy ly size ${o ? o.size : 'M'}...`;
        pillText = '🥤 Lấy ly';
      } else if(wSt === 'tea'){
        const bName = o && ITEMS[o.base] ? ITEMS[o.base].n : 'cốt trà';
        status = `🫖 Đang rót ${bName}...`;
        pillText = '🫖 Rót trà';
      } else if(wSt === 'flav'){
        const fName = o && o.flav && ITEMS[o.flav] ? ITEMS[o.flav].n : 'siro';
        status = `🧴 Đang bơm siro ${fName}...`;
        pillText = '🧴 Thêm siro';
      } else if(wSt === 'tops'){
        const curTopKey = o && o.tops ? o.tops[R.gzWork.topIdx || 0] : null;
        const tName = curTopKey && ITEMS[curTopKey] ? ITEMS[curTopKey].n : 'topping';
        status = `🥄 Đang múc topping: ${tName}... ✨`;
        pillText = '🥄 Múc topping';
      } else if(wSt === 'sugar_ice'){
        const sugVal = (o && o.sugar != null) ? o.sugar : (cup.sugar != null ? cup.sugar : 50);
        const iceVal = (o && o.ice) ? o.ice : (cup.ice || 'Đá thường');
        status = `🧊 Đang thêm ${sugVal}% đường & ${iceVal}...`;
        pillText = '🧊 Đường & đá';
      } else if(wSt === 'seal'){
        status = '✨ Đang dán nắp & giao cho khách... 🧋';
        pillText = '🧋 Dán nắp & Giao';
      }
    }
    if(pillEl && pillEl.textContent !== pillText){
      pillEl.className = 'gz-pill gz-pill-work';
      pillEl.textContent = pillText;
      pillEl.style.background = '';
      pillEl.style.color = '';
    }
    if(msgEl && msgEl.textContent !== status){
      msgEl.textContent = status;
      msgEl.style.color = '';
    }
    if(btnEl){
      btnEl.style.display = 'none';
      if(btnEl.getAttribute('data-gz-act') === 'police'){
        btnEl.className = 'gz-poke-chip';
        btnEl.removeAttribute('data-gz-act');
        btnEl.onclick = null;
      }
    }
  }
}

function staffGzTick(dt){
  if(!isStaffActive('staffGz')){
    if(R.gzWork || R.gzSulking){
      clearStaffPouring();
      R.gzWork = null;
      R.gzSulking = false;
      if(cup && cup.used && cup.staff) cup = newCup();
      renderGzWidget();
      renderLane();
      renderCup();
      renderPanel();
    }
    return;
  }
  if(!R.running || (!R.closing && R.t <= 0) || R.isNightShift) return;
  if((R.gzSupervised || 0) > 0) R.gzSupervised = Math.max(0, R.gzSupervised - dt);
  if(R.gzSulking){
    R.gzSulkTimer = Math.max(0, (R.gzSulkTimer != null ? R.gzSulkTimer : 10) - dt);
    const rem = Math.ceil(R.gzSulkTimer);
    const w = $('gzWidget');
    if(w && w.classList.contains('gz-sulking')){
      const secEls = w.querySelectorAll('.gz-sulk-sec');
      secEls.forEach(el => { el.textContent = `${rem}s`; });
    }
    if(R.gzSulkTimer <= 0){
      gzQuitFromSulk();
    }
    return;
  }
  if(R.gzStealCooldown && Date.now() < R.gzStealCooldown) return;

  if(R.gzWork){
    const w = R.gzWork;
    const c = w.type === 'lane' ? (R.slots[w.slotIdx] || R.slots.find(x => x && x.id === w.cId)) : (R.online && R.online.find(x => x && x.id === w.cId));
    if(!c || c.id !== w.cId || c.done[w.cupIdx]){
      clearStaffPouring();
      R.gzWork = null;
      renderGzWidget();
      renderLane();
      return;
    }
    w.t -= dt;
    if(w.step === 'tea_pour'){
      const prog = Math.min(1, Math.max(0, 1 - (w.t / (w.totalT || 1))));
      cup.fill = Math.min(0.8, 0.05 + prog * 0.75);
      w.liquidH = Math.min(75, 15 + prog * 60);
      if(!pourFast()) renderCup();
    }
    if(w.t <= 0){
      staffGzStep();
    }
    return;
  }

  // Gen Z: Tự động pha chế siêu tốc từ A-Z tại quầy (Sàn cứng 100ms = 0.10s)
  const gzSpd = 1 + getStaffSpeedBuff('staffGz');
  const gzStepT = Math.max(0.10, 0.20 / gzSpd);

  // Chuẩn tiemtranhosrc: Gen Z nhận khách giống Nhân viên phụ quầy 2 (Quản lý tập sự / staff3) phục vụ focusCust() tại quầy
  const f = (typeof focusCust === 'function') ? focusCust() : null;
  if(!f) return;

  const cupIdx = f.cups ? f.cups.findIndex((o, k) => !f.done[k]) : -1;
  if(cupIdx < 0) return;
  const o = f.cups[cupIdx];
  f.order = o;

  // Kiểm tra nguyên liệu còn thiếu cho ly này: dùng missing(o) chuẩn xác (không bị kẹt kho cup=0 khi ly đã có sẵn)
  const curMissing = (typeof missing === 'function') ? missing(o) : [];
  const boardHasMatchingCup = cup && cup.size && cup.size === o.size && cup.used;
  const needCupFromStock = !boardHasMatchingCup && qty('cup') <= 0;
  if(curMissing.length > 0 || needCupFromStock){
    const itemToFetch = curMissing[0] || (needCupFromStock ? 'cup' : null);
    if(itemToFetch && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
      staffBuyerTriggerInstant(itemToFetch);
    }
    return;
  }

  // Thêm bước lấy ly: Tự động dọn ly sai/dở dang và lấy ly chuẩn từ chồng ly
  const isWrongCupOnBoard = cup && cup.size && (
    cup.size !== o.size ||
    (cup.base && cup.base !== o.base) ||
    (cup.flav && o.flav && cup.flav !== o.flav)
  );
  if(isWrongCupOnBoard && cup.staff){
    spoilCup();
    cup = newCup();
  }
  const isCupNeeded = !cup || !cup.size || !cup.used || !cup._cupDeducted;
  if(isCupNeeded || (cup.staff && cup.size !== o.size)){
    if(!qty('cup')){
      if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant('cup');
      return;
    }
    cup = newCup();
    cup.size = o.size;
    cup.staff = true;
    if(!useStaffCup(cup)){
      return;
    }
    const btn = $('q3_' + o.size);
    if(btn) q3pop(btn);
    sfx('cup');
    renderCup();
    renderPanel();
    coach();
  }

  // Khi đã có ly đúng size: Bắt đầu chu trình pha chế trọn gói A-Z
  if(cup.size === o.size){
    let startStep = 'tea';
    if(cup.base === o.base && (cup.fill || 0) >= 0.72){
      if(o.flav && cup.flav !== o.flav) startStep = 'flav';
      else if(o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) startStep = 'tops';
      else if(level() >= 2 && (cup.sugar == null || !cup.ice)) startStep = 'sugar_ice';
      else startStep = 'seal';
    }
    const isLaneCust = R.slots && R.slots.includes(f);
    const targetType = isLaneCust ? 'lane' : 'online';
    R.gzWork = {
      type: targetType,
      cId: f.id,
      slotIdx: isLaneCust ? R.slots.indexOf(f) : -1,
      onlIdx: !isLaneCust && R.online ? R.online.indexOf(f) : -1,
      cupIdx: cupIdx,
      step: startStep,
      t: gzStepT, totalT: gzStepT,
      topIdx: 0,
      cup: cup
    };
    renderLane();
    renderPanel();
    return;
  }

  // Trong lúc đóng cửa: nếu khách còn sót lại mà không thể làm được vì hết nguyên liệu, giải phóng khách để kết thúc ngày
  if(R.closing && !R.gzWork){
    for(let i = 0; i < R.slots.length; i++){
      const c = R.slots[i];
      if(!c) continue;
      const remaining = c.cups.filter((o, k) => !c.done[k]);
      if(remaining.length > 0 && !remaining.some(o => needs(o).every(k => qty(k) > 0))){
        const el = document.querySelector(`[data-slot="${i}"]`);
        if(el) fl(el, 'Hết đồ, xin lỗi hẹn khách mai nhé! 🏮', true);
        decline(i);
      }
    }
    for(let j = R.online.length - 1; j >= 0; j--){
      const c = R.online[j];
      if(!c) continue;
      const remaining = c.cups.filter((o, k) => !c.done[k]);
      if(remaining.length > 0 && !remaining.some(o => needs(o).every(k => qty(k) > 0))){
        declineOnline(j);
      }
    }
  }
}

function staffGzStep(){
  if(!isStaffActive('staffGz') || !R.gzWork || !R.running){
    clearStaffPouring();
    R.gzWork = null;
    if(cup && cup.used && cup.staff && !cup.base) cup = newCup();
    renderGzWidget();
    renderLane();
    renderCup();
    renderPanel();
    return;
  }
  const gzSpd = 1 + getStaffSpeedBuff('staffGz');
  const gzStepT = Math.max(0.10, 0.20 / gzSpd);
  const w = R.gzWork;
  const c = w.type === 'lane' ? R.slots[w.slotIdx] : R.online.find(x => x && x.id === w.cId);
  if(!c || c.id !== w.cId || c.done[w.cupIdx]){
    clearStaffPouring();
    R.gzWork = null;
    renderGzWidget();
    renderLane();
    return;
  }
  const o = c.cups[w.cupIdx];
  if(!o){
    clearStaffPouring();
    R.gzWork = null;
    renderGzWidget();
    renderLane();
    return;
  }
  const curMissing = (typeof missing === 'function') ? missing(o) : [];
  if(curMissing.length > 0){
    clearStaffPouring();
    R.gzWork = null;
    if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
      staffBuyerTriggerInstant(curMissing[0]);
    }
    renderGzWidget();
    renderLane();
    return;
  }

  // 1. STEP CUP
  if(w.step === 'cup'){
    if(!cup.size || !cup.used){
      useCup();
      cup = newCup();
      cup.size = o.size;
      cup.used = true;
      cup.staff = true;
      const btn = $('q3_' + o.size);
      if(btn) q3pop(btn);
      sfx('tap');
    }
    w.step = 'tea';
  }

  // 2. STEP TEA
  if(w.step === 'tea'){
    if(cup.base === o.base && (cup.fill || 0) >= 0.72){
      w.step = (o.flav && cup.flav !== o.flav) ? 'flav' : ((o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) ? 'tops' : (level() >= 2 ? 'sugar_ice' : 'seal'));
      w.t = gzStepT;
      renderCup();
      renderPanel();
      return;
    }
    if(!cup.base){
      if(qty(o.base) > 0) consume(o.base);
      cup.base = o.base;
      cup.fill = 0.05;
      R.pour = o.base;
      R.staffPouring = true;
      pourSnd(true);
      const bBtn = $('q3b_' + o.base);
      if(bBtn){
        q3pop(bBtn);
        bBtn.classList.add('q3on');
      }
      w.step = 'tea_pour';
      w.totalT = gzStepT * 1.5;
      w.t = w.totalT;
      renderCup();
      renderPanel();
      renderLane();
      return;
    }
  }

  if(w.step === 'tea_pour'){
    cup.fill = 0.8;
    clearStaffPouring();
    sfx('plop');
    w.step = (o.flav && cup.flav !== o.flav) ? 'flav' : ((o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) ? 'tops' : (level() >= 2 ? 'sugar_ice' : 'seal'));
    w.t = gzStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 3. STEP FLAV
  if(w.step === 'flav'){
    if(o.flav && cup.flav !== o.flav && qty(o.flav) > 0){
      consume(o.flav);
      cup.flav = o.flav;
      const btn = $('q3b_' + o.flav);
      if(btn) q3pop(btn);
      sfx('pump');
    }
    w.step = (o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) ? 'tops' : (level() >= 2 ? 'sugar_ice' : 'seal');
    w.t = gzStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 4. STEP TOPS
  if(w.step === 'tops'){
    const missingTops = o.tops.filter(t => !cup.tops.includes(t));
    if(missingTops.length > 0){
      const topKey = missingTops[0];
      if(topKey && qty(topKey) > 0){
        consume(topKey);
        cup.tops.push(topKey);
        if(ITEMS[topKey] && ITEMS[topKey].g !== 'foam'){
          cup.vt = cup.vt || [];
          cup.vt.push({ k: topKey, pts: q3layer(topKey) });
        }
        const btn = $('q3b_' + topKey);
        if(btn) q3pop(btn);
        sfx('plop');
      } else if(topKey && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
        staffBuyerTriggerInstant(topKey);
      }
      if(missingTops.length > 1){
        w.t = gzStepT;
        renderCup();
        renderPanel();
        renderLane();
        return;
      }
    }
    if(o.cheese && !cup.cheese && qty('cheese') > 0){
      consume('cheese');
      cup.cheese = true;
      sfx('plop');
    }
    w.step = level() >= 2 ? 'sugar_ice' : 'seal';
    w.t = gzStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 5. STEP SUGAR & ICE
  if(w.step === 'sugar_ice'){
    const lv = level();
    if(lv >= 2){
      if(cup.sugar == null){
        cup.sugar = o.sugar != null ? o.sugar : 50;
        cup.sugarN = SUGAR.indexOf(cup.sugar) + 1;
        if(cup.sugar > 0 && qty('sugar') > 0) consume('sugar');
        const sBtn = $('q3b_sugar');
        if(sBtn) q3pop(sBtn);
      }
      if(!cup.ice){
        cup.ice = o.ice || 'Đá thường';
        cup.iceN = (cup.ice === 'Không đá' ? 0 : cup.ice === 'Ít đá' ? 1 : 2);
        if(cup.ice !== 'Không đá' && qty('ice') > 0) consume('ice');
        const iBtn = $('q3b_ice');
        if(iBtn) q3pop(iBtn);
        sfx('ice');
      }
    }
    w.step = 'seal';
    w.t = gzStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 6. STEP SEAL & SERVE / "ĐÁ BILL"
  if(w.step === 'seal'){
    // Gen Z: 1% làm sai bill, hỏng thì đổ bỏ làm lại từ đầu
    if(Math.random() < 0.01){
      sfx('trash');
      spoilCup();
      const pName = staffPersonName('staffGz') || 'Gen Z';
      R.gzMistakeMsg = `${pName} sơ ý làm sai bill của ${c.name}, ly bị hỏng đã đổ bỏ làm lại từ đầu! 🥺`;
      R.gzMistakeMsgUntil = Date.now() + 5000;
      renderGzWidget();
      cup = newCup();
      R.gzWork = null;
      renderCup();
      renderPanel();
      renderLane();
      return;
    }
    cup.sealed = true;
    const sBtn = $('q3seal');
    if(sBtn) q3pop(sBtn);
    sfx('seal');
    renderCup();
    w.cup = cup;

    // Đảm bảo cup đầy đủ thông số chính xác 100%
    cup.base = o.base;
    cup.size = o.size;
    cup.flav = o.flav || null;
    cup.tops = [...o.tops];
    cup.cheese = !!o.cheese;
    cup.sugar = o.sugar;
    cup.ice = o.ice;
    cup.fill = 0.8;
    cup.used = true;

    if(w.type === 'lane'){
      const staffBillBonus = getStaffBillBonusTotal();
      let fullBill = Math.round(price(o) * (c.star != null ? 3 : 1) * (1 + staffBillBonus));
      if(S && S.garden && S.garden.organicBuffDays > 0 && (o.base === 'hong' || o.base === 'luc' || o.base === 'olong' || o.flav)){
        fullBill = Math.round(fullBill * 1.20);
      }
      const isSupervised = (R.gzSupervised || 0) > 0;

      // Mỗi ngày chỉ đá bill tối đa 1 lần, khi thành công tuyệt đối không đá bill nữa
      const alreadyStoleToday = !!(R.today && (
        (R.today.gzStealAttempts || 0) >= 1 ||
        R.today.gzStealSuccess ||
        (R.today.gzStolen || 0) > 0
      ));

      // Giảm tỉ lệ đá bill xuống ~1.5%
      let stealChance = 0.015;
      if(isTaxActive()){
        stealChance *= (1 - ((S.tax && S.tax.rate) ? S.tax.rate * 0.5 : 0.075));
      } else if(isTaxOverdue()){
        stealChance = Math.min(0.02, stealChance * 1.35);
      }
      if(isGuardResting()){
        stealChance = Math.min(0.05, stealChance * 2.5); // Chú bảo vệ đang ngủ: nguy cơ trộm cắp tăng vọt
      }
      stealChance = Math.min(0.05, Math.max(0.008, stealChance));
      const gzTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffGz') : 0;
      if(gzTrainLv >= 4) stealChance = 0;
      else if(gzTrainLv > 0) stealChance *= Math.max(0, 1 - gzTrainLv * 0.25);

      // Có Chú bảo vệ đứng tiệm: Chặn 90%~100% trộm cắp / đá bill theo cấp đào tạo
      const guardStopsSteal = isStaffActive('staffGuard') && Math.random() < (typeof getGuardBlockRate === 'function' ? getGuardBlockRate() : 0.90);
      const willSteal = !alreadyStoleToday && !isSupervised && !guardStopsSteal && Math.random() < stealChance;

      if(willSteal){
        if(R.today) R.today.gzStealAttempts = (R.today.gzStealAttempts || 0) + 1;
        R.gzCaughtCount = 0;
        c.done[w.cupIdx] = true;
        recSale(o);
        R.today.served++;
        S.served++;
        R.today.gzStolen = (R.today.gzStolen || 0) + fullBill;
        R.gzStolenRecent = true;
        R.gzLastStolenBill = fullBill;
        R.gzStolenCustId = c.id;
        R.gzStealCooldown = Date.now() + 2500;

        const left = c.done.filter(x => !x).length;
        const el = document.querySelector(`[data-slot="${w.slotIdx}"]`);
        if(left){
          c.order = c.cups[c.done.indexOf(false)];
          if(el) fl(el, `🤫 Đá bill ${fmt(fullBill)}! còn ${left} ly`, true);
        } else {
          const rv = stars(c, false);
          addReview(rv.s, rv.why, false, c);
          if(el) fl(el, `🤫 Đá bill ${fmt(fullBill)}! ${'★'.repeat(rv.s)}`, true);
          R.slots[w.slotIdx] = null;
        }
        toast(`Gen Z vừa "đá bill" ${fmt(fullBill)} của ${c.name}! Bấm "BẮT QUẢ TANG" trong 5s để đòi lại tiền & tịch thu tiền bo! 🚨💸`, 5000, 1);
        sfx('bad');
        R.gzMsg = `🤫 Vừa lén đá bill ${fmt(fullBill)}! Bấm "Bắt quả tang" ngay!`;
        
        clearTimeout(R._gzCatchTimer);
        R.gzCatchExpiresAt = Date.now() + 5000;
        R._gzCatchTimer = setTimeout(() => {
          if(R.gzStolenRecent){
            R.gzStolenRecent = false;
            R.gzLastStolenBill = 0;
            R.gzCatchExpiresAt = 0;
            R.gzStolenCustId = null;
            if(R.today) R.today.gzStealSuccess = true;
            S.gzNeverSulk = true;
            R.gzSulking = false;
            save();
            renderGzWidget();
            toast('Đã quá 5s! Gen Z đã tẩu tán xong tiền bill mất rồi! 💸 (Đá bill thành công nên sẽ không bao giờ dỗi nữa)', 4000);
          }
        }, 5000);

        cup = newCup();
        renderCup();
        renderGzWidget();
      } else {
        const actualSlot = R.slots.indexOf(c);
        serve(actualSlot >= 0 ? actualSlot : w.slotIdx);
      }
    } else if(w.type === 'online'){
      c.order = o;
      const actualOnlIdx = R.online ? R.online.indexOf(c) : -1;
      serveOnline(actualOnlIdx >= 0 ? actualOnlIdx : w.onlIdx);
    }

    R.gzCupsMade = (R.gzCupsMade || 0) + 1;
    const gzTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffGz') : 0;
    const gzThreshold = 100 + gzTrainLv * 40;
    if(R.gzCupsMade >= gzThreshold){
      R.gzCupsMade = 0;
      if(gzTrainLv >= 5){
        R.gzRushHourUntil = Date.now() + 15000;
        toast('🔥 Trưởng Ca Gen Z Đại Sư đạt mốc ly: Kích hoạt SỐT TRÀ SỮA (+20% Tiền Tip trong 15s)! ✨🍹', 4000);
        try { sfx('win'); } catch(_) {}
      } else {
        setTimeout(() => {
          if(R.running && !R.gzSulking) gzTriggerSulk('overwork');
        }, 250);
      }
    }

    if(cup && cup.used && cup.staff) cup = newCup();
    R.gzWork = null;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }
}

/* ===== NHÂN VIÊN ĐI CHỢ (staffBuyer) ===== */
function getBuyerBatch(k){
  if(!k) return null;
  k = (typeof normIngKey === 'function' ? normIngKey(k) : k) || k;
  if(k === 'cup'){
    const q = 20;
    const c = q * (CFG.cost.cup || 1500);
    return { k, q, cost: c, name: 'Ly nhựa', unit: 'ly', type: 'supply' };
  }
  if(k === 'ice'){
    const q = 25;
    let uCost = CFG.cost.ice || 1000;
    if(S && S.garden && S.garden.lemonBuffDays > 0) uCost = Math.round(uCost * (S.garden.lemonBuffBoost ? 0.7 : 0.8));
    const c = q * uCost;
    return { k, q, cost: c, name: 'Đá viên', unit: 'phần', type: 'supply' };
  }
  if(k === 'sugar'){
    const q = 30;
    let uCost = CFG.cost.sugar || 500;
    if(S && S.garden && S.garden.lemonBuffDays > 0) uCost = Math.round(uCost * (S.garden.lemonBuffBoost ? 0.7 : 0.8));
    const c = q * uCost;
    return { k, q, cost: c, name: 'Nước đường', unit: 'phần', type: 'supply' };
  }
  if(FLAV_KEYS.includes(k)){
    const q = CFG.bottleN || 45;
    const c = bottleCost(k);
    const itemN = ITEMS[k] ? ITEMS[k].n : k;
    return { k, q, cost: c, name: 'Siro ' + low(itemN), unit: 'chai (' + q + ' ly)', type: 'flav' };
  }
  if(BASE_KEYS.includes(k)){
    const q = 15;
    const c = q * (CFG.cost[k] || (ITEMS[k] && ITEMS[k].cost) || 2500);
    const itemN = ITEMS[k] ? ITEMS[k].n : k;
    return { k, q, cost: c, name: itemN, unit: 'phần', type: 'base' };
  }
  if(TOP_KEYS.includes(k)){
    const q = 15;
    const c = q * (CFG.cost[k] || (ITEMS[k] && ITEMS[k].cost) || 2000);
    const itemN = ITEMS[k] ? ITEMS[k].n : k;
    return { k, q, cost: c, name: itemN, unit: 'phần', type: 'top' };
  }
  return null;
}

function canAffordBatch(k){
  k = (typeof normIngKey === 'function' ? normIngKey(k) : k) || k;
  const batch = getBuyerBatch(k);
  if(!batch) return false;
  return (S && S.money >= batch.cost);
}

function findDepletedIngredient(){
  if(!S || !S.upg || (!S.upg.staffBuyer && !S.upg.staffRacer)) return null;
  if(typeof isStaffActive === 'function' && !isStaffActive('staffBuyer') && !isStaffActive('staffRacer')) return null;

  // 1. Kiểm tra đơn hàng đang chờ (khách tại quầy hoặc app) cần món nào mà quán đang hết sạch (qty === 0)
  const allOrders = [];
  (R.slots || []).forEach(c => {
    if(c && c.cups) c.cups.forEach((o, j) => { if(!c.done || !c.done[j]) allOrders.push(o); });
  });
  (R.online || []).forEach(c => {
    if(c && c.cups) c.cups.forEach((o, j) => { if(!c.done || !c.done[j]) allOrders.push(o); });
  });

  for(const o of allOrders){
    const reqs = (typeof needs === 'function') ? needs(o) : [];
    for(let k of reqs){
      k = (typeof normIngKey === 'function' ? normIngKey(k) : k) || k;
      if(k && qty(k) === 0 && canAffordBatch(k)) return k;
    }
  }

  // 2. Khách đang chờ cần món sắp hết (<= 2)
  for(const o of allOrders){
    const reqs = (typeof needs === 'function') ? needs(o) : [];
    for(let k of reqs){
      k = (typeof normIngKey === 'function' ? normIngKey(k) : k) || k;
      if(k && qty(k) <= 2 && canAffordBatch(k)) return k;
    }
  }

  // 3. Dụng cụ cơ bản khi sắp cạn (<= 4)
  if(qty('cup') <= 4 && canAffordBatch('cup')) return 'cup';
  if(level() >= 2 && qty('ice') <= 4 && canAffordBatch('ice')) return 'ice';
  if(level() >= 2 && qty('sugar') <= 4 && canAffordBatch('sugar')) return 'sugar';

  // 4. Kiểm tra trà cốt đã mở trong menu bị hết hoặc còn ít (<= 2)
  for(const k of BASE_KEYS){
    if(S.unlocked[k] && !(S.off||{})[k] && qty(k) <= 2 && canAffordBatch(k)) return k;
  }

  // 5. Kiểm tra topping đã mở trong menu bị hết hoặc còn ít (<= 2)
  for(const k of TOP_KEYS){
    if(S.unlocked[k] && !(S.off||{})[k] && qty(k) <= 2 && canAffordBatch(k)) return k;
  }

  // 6. Kiểm tra hương siro đã từng mở/đã dùng/đang trend/công thức đã chế tạo bị hết hoặc còn ít (<= 2)
  const actTrend = (typeof TrendSystem !== 'undefined' && TrendSystem.getActiveTrend) ? TrendSystem.getActiveTrend() : null;
  const tFlav = (actTrend && actTrend.orderRecipe && actTrend.orderRecipe.flav) ? actTrend.orderRecipe.flav : null;
  const craftedFlavs = new Set();
  if(S.collection && S.collection.craftedRecipes){
    Object.values(S.collection.craftedRecipes).forEach(cr => {
      const fl = cr && cr.gameOrder && cr.gameOrder.flav;
      if(fl) craftedFlavs.add((typeof normIngKey === 'function' ? normIngKey(fl) : fl) || fl);
    });
  }

  for(const k of FLAV_KEYS){
    const isRel = (S.unlocked && S.unlocked[k]) ||
      (S.used && S.used[k] > 0) ||
      (R.today && R.today.used && R.today.used[k] > 0) ||
      (S.cur && S.cur.ing && S.cur.ing[k]) ||
      (S.stock && S.stock[k] && S.stock[k].some(b => b.q > 0)) ||
      (k === tFlav) ||
      craftedFlavs.has(k);

    if(isRel && !(S.off||{})[k] && qty(k) <= 2 && canAffordBatch(k)) return k;
  }

  return null;
}

function staffBuyerStartTrip(k){
  if(!R.running) return;
  const isRacer = (typeof isStaffActive === 'function') && isStaffActive('staffRacer');
  const isBuyer = (typeof isStaffActive === 'function') && isStaffActive('staffBuyer');
  if(!isRacer && !isBuyer) return;

  k = (typeof normIngKey === 'function' ? normIngKey(k) : k) || k;
  const batch = getBuyerBatch(k);
  if(!batch) return;

  const hasMotorbike = !!(S.upg && S.upg.motorbike && (isRacer || isBuyer));
  if(S.money < batch.cost && !hasMotorbike) return; // Không đủ tiền thì không khởi hành tránh kẹt

  // CHIẾN THẦN XA LỘ: Đi chợ siêu tốc tức thì (0s chờ)!
  if(isRacer){
    R.buyerTrips = [];
    R.buyerTrip = null;
    const instantTrip = {
      id: 'trip_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
      k,
      batch,
      name: batch.name,
      t: 0,
      totalT: 0
    };
    const ok = staffBuyerCompleteTrip(instantTrip);
    if(ok){
      toast(`⚡🏍️ Chiến thần xa lộ: Đã mua bổ sung ${batch.name} tức thì (0s chờ)!`, 2500);
    }
    return;
  }

  const numBuyers = (typeof getStaffBuyerCount === 'function') ? getStaffBuyerCount() : 1;
  R.buyerTrips = (R.buyerTrips || []).filter(tr => tr && tr.t > 0);
  if(R.buyerTrips.length >= numBuyers) return;
  if(R.buyerTrips.some(tr => tr.k === k)) return;

  const buyerSpd = Math.max(0.5, 1 + getStaffSpeedBuff('staffBuyer'));
  let baseDur = 2 + Math.random() * 3; // Tốc độ chuẩn: đi 2-5s/1 lần
  if(typeof S !== 'undefined' && S && S.startupLocation === 'hoangsa'){
    const dMul = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
    baseDur *= (1 + 0.25 * dMul); // Hoàng Sa – Trường Sa: Thời gian nhập hàng +25%
  }
  const dur = Math.max(1.0, baseDur / buyerSpd);
  const newTrip = {
    id: 'trip_' + Date.now() + '_' + Math.random().toString(36).slice(2, 6),
    k,
    batch,
    name: batch.name,
    t: dur,
    totalT: dur
  };
  R.buyerTrips.push(newTrip);
  R.buyerTrip = R.buyerTrips[0] || newTrip;
  renderBuyerWidget();
}

function staffBuyerCompleteTrip(specificTrip){
  R.buyerTrips = R.buyerTrips || [];
  const trip = specificTrip || R.buyerTrip || R.buyerTrips[0];
  if(!trip) return false;

  R.buyerTrips = R.buyerTrips.filter(tr => tr && tr !== trip && tr.id !== trip.id && tr.t > 0);
  R.buyerTrip = (R.buyerTrips && R.buyerTrips[0]) || null;

  try {
    const batch = trip.batch;
    if(!batch) return false;
    const isRacer = (typeof isStaffActive === 'function') && isStaffActive('staffRacer');
    const pName = isRacer ? (staffPersonName('staffRacer') || 'Chiến thần xa lộ') : (staffPersonName('staffBuyer') || 'NV Đi chợ');
    const batchCost = batch.cost;
    const hasMotorbike = !!(S.upg && S.upg.motorbike && (isRacer || isStaffActive('staffBuyer')));

    // Xe máy: 10% trả giá không mất tiền mua hàng (0đ)
    let isFreeBargain = false;
    let actualBatchCost = batchCost;
    if(hasMotorbike && Math.random() < 0.10){
      isFreeBargain = true;
      actualBatchCost = 0;
    }
    const buyerTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffBuyer') : 0;
    if(buyerTrainLv >= 5 && !isFreeBargain){
      if(Math.random() < 0.25){
        actualBatchCost = Math.round(actualBatchCost * 0.70);
        toast(`🎟️ ${pName} săn được Voucher giảm giá 30% tiền chợ nguyên liệu (-30%)!`, 3500);
      } else {
        actualBatchCost = Math.round(actualBatchCost * 0.80);
      }
    }

    if(S.money < actualBatchCost){
      toast(`🛵 Đi chợ về tay không: Két thiếu ${fmt(actualBatchCost)}!`, 2500);
      return false;
    }

    // Xe máy: 5% được x2 món hàng khi mua
    let isDoubleBonus = false;
    let finalQty = batch.q;
    if(hasMotorbike && Math.random() < 0.05){
      isDoubleBonus = true;
      finalQty = batch.q * 2;
    }

    R.buyerTripsToday = (R.buyerTripsToday || 0) + 1;
    const trips = R.buyerTripsToday;
    R.today.buyerTrips = trips;

    // Giảm mạnh tỉ lệ nhân viên đi chợ khai khống tiền hàng theo yêu cầu
    // 4 lần đầu 0% (hoàn toàn trung thực), lần 5 chỉ 5%, lần 7+ tối đa 12%
    let cheatChance = 0;
    if(trips >= 7) cheatChance = 0.12;
    else if(trips >= 5) cheatChance = 0.05;
    // Có Chiến thần xa lộ hoặc mặc cả 0đ: triệt tiêu 100% gian lận; Có Chú bảo vệ: chặn 90% (chỉ còn 10% nguy cơ)
    if(isStaffActive('staffRacer') || isFreeBargain) cheatChance = 0;
    else if(isStaffActive('staffGuard')) cheatChance *= 0.10;
    if(buyerTrainLv >= 4) cheatChance = 0;
    else if(buyerTrainLv > 0) cheatChance *= Math.max(0, 1 - buyerTrainLv * 0.25);

    let stolen = 0;
    if(Math.random() < cheatChance){
      const cheatRate = 0.05 + Math.random() * 0.05; // chỉ 5% - 10% nhẹ nhàng
      stolen = Math.max(2000, Math.round(batchCost * cheatRate / 1000) * 1000);
      stolen = Math.min(stolen, Math.max(0, S.money - batchCost));
    }

    // Có tỉ lệ mua trúng đồ hết hạn nếu đi chợ nhiều lần trong ngày (>= 3 lần), gây ngộ độc cho khách hàng
    // Chiến thần xa lộ: 100% không bao giờ mua đồ bị hỏng!
    // Có Chú bảo vệ kiểm tra: giảm 50% tỉ lệ sai sót (từ 8% xuống 4%)
    let poisonChance = isStaffActive('staffRacer') ? 0 : (isStaffActive('staffGuard') ? 0.04 : 0.08);
    if(buyerTrainLv >= 4) poisonChance = 0;
    else if(buyerTrainLv > 0) poisonChance *= Math.max(0, 1 - buyerTrainLv * 0.25);
    if(trips >= 3 && Math.random() < poisonChance){
      S.kpiPeriodStats = S.kpiPeriodStats || {};
      const ps = S.kpiPeriodStats.staffBuyer = S.kpiPeriodStats.staffBuyer || { daysWorked: 0, served: 0, errors: 0 };
      ps.errors = (ps.errors || 0) + 1;
      const poisonRev = {
        s: 1,
        t: `Uống ly trà sữa có vị lạ khó chịu, về đau bụng cả đêm vì quán dùng ${batch.name} hết hạn! Quá nguy hiểm! 1★`,
        k: 'buyer_poison_' + Date.now(),
        d: S.day,
        o: false,
        n: 'Khách bị đau bụng',
        f: '🤢',
        tag: 'buyer_expired',
        b: null, fl: null, tp: [], ch: false, sz: 'M'
      };
      S.reviews.unshift(poisonRev);
      if(R.today && Array.isArray(R.today.stars)) R.today.stars.push(1);
      S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
      if(S.reviews.length > 2500) S.reviews.length = 2500;
      setTimeout(() => {
        toast(`🚨 CẢNH BÁO: ${pName} đi chợ vội mua trúng ${batch.name} hết hạn sử dụng! Khách uống bị đau bụng phốt 1★! 🤢🗑️`, 6000, 1);
        sfx('bad');
      }, 700);
    }

    const totalDeduct = actualBatchCost + stolen;
    S.money -= totalDeduct;

    // Ghi nhận chi phí nguyên liệu vào S.cur.ing
    S.cur = S.cur || {};
    S.cur.ing = S.cur.ing || {};
    const g = S.cur.ing[batch.k] = S.cur.ing[batch.k] || { q: 0, v: 0 };
    g.q += finalQty;
    g.v += actualBatchCost;

    // Nhập kho ngay trong lúc bán hàng
    addStock(batch.k, finalQty, S, true);
    if(batch.type === 'flav') syncFlav();

    // Xoá cờ 'so' (hết món) trên tất cả đơn khách đang chờ nếu món đó vừa được mua về
    (R.slots || []).forEach(c => {
      if(c && c.cups){
        c.cups.forEach(cup => {
          if(cup.so === batch.k || (typeof normIngKey === 'function' && normIngKey(cup.so) === batch.k)) cup.so = null;
        });
      }
    });
    (R.online || []).forEach(c => {
      if(c && c.cups){
        c.cups.forEach(cup => {
          if(cup.so === batch.k || (typeof normIngKey === 'function' && normIngKey(cup.so) === batch.k)) cup.so = null;
        });
      }
    });

    S.kpiPeriodStats = S.kpiPeriodStats || {};
    if(stolen > 0){
      R.today.buyerStolen = (R.today.buyerStolen || 0) + stolen;
      const ps = S.kpiPeriodStats.staffBuyer = S.kpiPeriodStats.staffBuyer || { daysWorked: 0, served: 0, errors: 0 };
      ps.errors = (ps.errors || 0) + 1;

      sfx('bad');
      if($('lane')) fl($('lane'), `⚠️ Khai gian -${fmt(stolen)}`, true);
      const buyerText = `🛵 ${pName} đi chợ lần ${trips} về: Khai gian hóa đơn ${fmt(totalDeduct)} (đút túi riêng +${fmt(stolen)})! ⚠️`;
      if(S.upg && S.upg.staffGz){
        R.gzBuyerMsg = buyerText;
        R.gzBuyerMsgUntil = Date.now() + 5000;
        renderGzWidget();
      } else if(S.upg && S.upg.staffSv && R.isNightShift){
        R.svBuyerMsg = buyerText;
        R.svBuyerMsgUntil = Date.now() + 5000;
        renderSvWidget();
      } else {
        R.buyerDoneMsg = buyerText;
        R.buyerDoneMsgUntil = Date.now() + 5000;
        renderBuyerWidget();
      }
    } else {
      sfx('coin');
      if($('lane')) fl($('lane'), `✓ Nhập +${finalQty} ${batch.name}${isFreeBargain ? ' (0đ)' : ''}`);
      const buyerText = `🛵 ${pName} đã mua +${finalQty} ${batch.unit} ${batch.name} (-${fmt(actualBatchCost)})${isFreeBargain ? ' [Mặc cả 0đ]' : ''}${isDoubleBonus ? ' [x2 Lộc]' : ''}`;
      if(S.upg && S.upg.staffGz){
        R.gzBuyerMsg = buyerText;
        R.gzBuyerMsgUntil = Date.now() + 4500;
        renderGzWidget();
      } else if(S.upg && S.upg.staffSv && R.isNightShift){
        R.svBuyerMsg = buyerText;
        R.svBuyerMsgUntil = Date.now() + 4500;
        renderSvWidget();
      } else {
        R.buyerDoneMsg = buyerText;
        R.buyerDoneMsgUntil = Date.now() + 4000;
        renderBuyerWidget();
      }
    }

    if(isFreeBargain){
      toast(`🛵💬 Mặc cả đỉnh cao: ${pName} dùng xe máy lượn chợ khéo trả giá, mua ${batch.name} với giá 0đ! 🎉`, 3500);
    }
    if(isDoubleBonus){
      setTimeout(() => {
        toast(`🎁🛵 Lộc lá chợ đầu mối: Mua 1 tặng 1, nhận x2 số lượng ${batch.name} (+${finalQty} phần vào kho)! ✨`, 4000);
      }, isFreeBargain ? 1000 : 0);
    }

    // Xe máy: Tăng mạnh độ bền, 9 cuốc đầu hoàn toàn an tâm (0%), chỉ tính tỉ lệ hao mòn nhẹ từ cuốc thứ 10 trở đi (tối đa 8%)
    if(hasMotorbike && trips >= 10){
      const bikeBreakChance = Math.min(0.08, (trips - 9) * 0.012);
      if(Math.random() < bikeBreakChance){
        if(isStaffActive('staffButler')){
          setTimeout(() => {
            toast(`🛠️🛵 Xe máy vừa gặp sự cố hỏng hóc đã được Quản gia sửa chữa và bảo dưỡng tức thì! Xe chạy êm ru! 🤵✨`, 5000, 1);
          }, 1500);
        } else {
          S.upg.motorbike = false;
          sfx('bad');
          setTimeout(() => {
            toast(`💥🛵 Chạy chợ liên tục ${trips} cuốc nên Xe máy bị hỏng hóc giữa đường! Hãy vào Nâng cấp bảo trì hoặc sắm xe mới!`, 6000, 1);
          }, 1500);
        }
      }
    }

    renderPanel();
    renderCup();
    head();
    coach();
    if(typeof renderLane === 'function') renderLane();
    if(typeof renderStreet === 'function') renderStreet();
    if(typeof renderOnline === 'function') renderOnline();

    if(isRacer){
      R.buyerTrips = [];
      R.buyerTrip = null;
    }

    if(R.buyerQueue && R.buyerQueue.length > 0){
      const isRacerTrip = isRacer;
      const numBuyers = isRacerTrip ? 1 : ((typeof getStaffBuyerCount === 'function') ? getStaffBuyerCount() : 1);
      while(R.buyerQueue.length > 0 && R.buyerTrips.length < numBuyers){
        let nextK = R.buyerQueue.shift();
        nextK = (typeof normIngKey === 'function' ? normIngKey(nextK) : nextK) || nextK;
        if(qty(nextK) <= 2 && !R.buyerTrips.some(tr => tr.k === nextK)){
          staffBuyerStartTrip(nextK);
        }
      }
    }
    return true;
  } catch(err){
    console.error('Lỗi staffBuyerCompleteTrip:', err);
    return false;
  } finally {
    if(typeof isStaffActive === 'function' && isStaffActive('staffRacer')){
      R.buyerTrips = [];
      R.buyerTrip = null;
    } else {
      R.buyerTrips = (R.buyerTrips || []).filter(tr => tr && tr.t > 0);
      R.buyerTrip = (R.buyerTrips && R.buyerTrips[0]) || null;
    }
    renderBuyerWidget();
  }
}

function staffBuyerTriggerInstant(k){
  if(!S || !S.upg || (!S.upg.staffBuyer && !S.upg.staffRacer)) return;
  k = (typeof normIngKey === 'function' ? normIngKey(k) : k) || k;
  const isRacer = (typeof isStaffActive === 'function') && isStaffActive('staffRacer');
  const isBuyer = (typeof isStaffActive === 'function') && isStaffActive('staffBuyer');
  if(!isRacer && !isBuyer) return;

  const pName = isRacer ? (staffPersonName('staffRacer') || 'Chiến thần xa lộ') : (staffPersonName('staffBuyer') || 'NV Đi chợ');
  const itemName = (ITEMS[k] && ITEMS[k].n) || (k === 'cup' ? 'ly' : k === 'sugar' ? 'đường' : k === 'ice' ? 'đá' : k);

  // Nếu có Chiến thần xa lộ: Đi chợ siêu tốc tức thì 0s, khách KHÔNG BAO GIỜ bỏ về!
  if(isRacer){
    staffBuyerStartTrip(k);
    return;
  }

  R.buyerTrips = (R.buyerTrips || []).filter(tr => tr && tr.t > 0);
  if(R.buyerTrip && !R.buyerTrips.includes(R.buyerTrip)){
    R.buyerTrips.push(R.buyerTrip);
  }

  const existingTrip = R.buyerTrips.find(tr => tr.k === k);
  if(existingTrip){
    const msg = `🛵 ${pName} đang trên đường mua ${itemName} (${Math.max(0.1, existingTrip.t).toFixed(1)}s), chờ xíu nhé!`;
    if(S.upg && S.upg.staffGz && !R.isNightShift){
      R.gzBuyerMsg = msg;
      R.gzBuyerMsgUntil = Date.now() + 2500;
      renderGzWidget();
    } else if(S.upg && S.upg.staffSv && R.isNightShift){
      R.svBuyerMsg = msg;
      R.svBuyerMsgUntil = Date.now() + 2500;
      renderSvWidget();
    } else {
      renderBuyerWidget();
    }
    return;
  }

  const numBuyers = (typeof getStaffBuyerCount === 'function') ? getStaffBuyerCount() : 1;
  if(R.buyerTrips.length < numBuyers){
    staffBuyerStartTrip(k);
    const msg = `🛵 ${pName} đang chạy xe đi mua ${itemName}!`;
    if(S.upg && S.upg.staffGz && !R.isNightShift){
      R.gzBuyerMsg = msg;
      R.gzBuyerMsgUntil = Date.now() + 2200;
      renderGzWidget();
    } else if(S.upg && S.upg.staffSv && R.isNightShift){
      R.svBuyerMsg = msg;
      R.svBuyerMsgUntil = Date.now() + 2200;
      renderSvWidget();
    } else {
      renderBuyerWidget();
    }
    return;
  }

  R.buyerQueue = R.buyerQueue || [];
  if(!R.buyerQueue.includes(k)) R.buyerQueue.push(k);
  const msg = `🛵 ${pName} đang bận mua chuyến khác, xong sẽ đi mua ${itemName} ngay!`;
  if(S.upg && S.upg.staffGz && !R.isNightShift){
    R.gzBuyerMsg = msg;
    R.gzBuyerMsgUntil = Date.now() + 2500;
    renderGzWidget();
  } else if(S.upg && S.upg.staffSv && R.isNightShift){
    R.svBuyerMsg = msg;
    R.svBuyerMsgUntil = Date.now() + 2500;
    renderSvWidget();
  } else {
    renderBuyerWidget();
  }
}

function staffBuyerTick(dt){
  if(!S || !S.upg || (!S.upg.staffBuyer && !S.upg.staffRacer) || !R.running){
    if(R.buyerTrip || (R.buyerTrips && R.buyerTrips.length)){
      R.buyerTrip = null;
      R.buyerTrips = [];
      renderBuyerWidget();
    }
    return;
  }

  const isRacer = (typeof isStaffActive === 'function') && isStaffActive('staffRacer');
  const isBuyer = (typeof isStaffActive === 'function') && isStaffActive('staffBuyer');
  if(!isRacer && !isBuyer) return;

  R.buyerTrips = R.buyerTrips || [];
  if(isRacer){
    // Chiến thần xa lộ hoàn thành tức thì 0s, không để tồn đọng trip chạy nền
    R.buyerTrips = [];
    R.buyerTrip = null;
  } else {
    // Cập nhật tất cả các chuyến đi chợ đang diễn ra cho NV Đi chợ
    for(let i = R.buyerTrips.length - 1; i >= 0; i--){
      const trip = R.buyerTrips[i];
      if(!trip || typeof trip.t !== 'number' || isNaN(trip.t)){ R.buyerTrips.splice(i, 1); continue; }
      trip.t -= dt;
      if(trip.t <= 0){
        staffBuyerCompleteTrip(trip);
      }
    }
    R.buyerTrips = R.buyerTrips.filter(tr => tr && tr.t > 0);
    R.buyerTrip = (R.buyerTrips && R.buyerTrips[0]) || null;

    const curTripSec = R.buyerTrip ? Math.ceil(R.buyerTrip.t) : 0;
    if(curTripSec !== R._lastBuyerSec){
      R._lastBuyerSec = curTripSec;
      if(isStaffActive('staffGz') && !R.isNightShift){
        renderGzWidget();
      } else if(isStaffActive('staffSv') && R.isNightShift){
        renderSvWidget();
      } else {
        renderBuyerWidget();
      }
    }
  }

  // Khi quán hết giờ làm việc và KHÔNG còn khách nào đang chờ: kết thúc đi chợ
  const hasWaitingCust = (R.slots && R.slots.some(Boolean)) || (R.online && R.online.length > 0);
  const isShiftTimeUp = (R.isNightShift ? R.nightT <= 0 : R.t <= 0);
  const isShiftEnded = (R.closing || isShiftTimeUp) && !hasWaitingCust;
  if(isShiftEnded){
    renderBuyerWidget();
    return;
  }

  const numBuyers = isRacer ? 1 : ((typeof getStaffBuyerCount === 'function') ? getStaffBuyerCount() : 1);
  const freeBuyers = numBuyers - R.buyerTrips.length;
  if(freeBuyers > 0){
    // 1. Lấy từ queue
    if(R.buyerQueue && R.buyerQueue.length > 0){
      for(let qIdx = R.buyerQueue.length - 1; qIdx >= 0; qIdx--){
        let qk = R.buyerQueue[qIdx];
        qk = (typeof normIngKey === 'function' ? normIngKey(qk) : qk) || qk;
        if(qty(qk) > 2){
          R.buyerQueue.splice(qIdx, 1);
        } else if(!R.buyerTrips.some(tr => tr.k === qk)){
          R.buyerQueue.splice(qIdx, 1);
          staffBuyerStartTrip(qk);
          if(R.buyerTrips.length >= numBuyers) break;
        }
      }
    }
    // 2. Tự quét tìm món cạn kho
    if(R.buyerTrips.length < numBuyers){
      R.buyerScanT = (R.buyerScanT || 0) - dt;
      if(R.buyerScanT <= 0){
        R.buyerScanT = isRacer ? 0.35 : 0.8;
        const neededKey = findDepletedIngredient();
        if(neededKey && !R.buyerTrips.some(tr => tr.k === neededKey)){
          staffBuyerStartTrip(neededKey);
        }
      }
    }
  }
}

function renderBuyerWidget(){
  const w = $('buyerWidget');
  if(!w) return;
  // Khi đã thuê Gen Z hoặc Sinh Viên ca đêm: tích hợp hoàn toàn thông tin chạy chợ vào tab của nhân viên đó, ẩn hẳn buyerWidget
  if((S && S.upg && S.upg.staffGz && !R.isNightShift) || (S && S.upg && S.upg.staffSv && R.isNightShift)){
    w.style.display = 'none';
    w._tripKey = null;
    return;
  }
  const isRacer = (typeof isStaffActive === 'function') && isStaffActive('staffRacer');
  const isBuyer = (typeof isStaffActive === 'function') && isStaffActive('staffBuyer');
  if(!isRacer && !isBuyer){
    w.style.display = 'none';
    w._tripKey = null;
    return;
  }
  const pName = isRacer ? (staffPersonName('staffRacer') || 'Chiến thần xa lộ') : (staffPersonName('staffBuyer') || 'NV Đi Chợ');

  // Hiển thị thông báo mua hàng về nếu có
  if(R && R.buyerDoneMsg && Date.now() < (R.buyerDoneMsgUntil || 0)){
    w.style.display = 'flex';
    w.className = 'buyer-widget done-trip';
    w.innerHTML = `
      <span style="font-size:20px;line-height:1;flex:none;">${isRacer ? '🏎️' : '🛵'}</span>
      <div style="display:flex;flex-direction:column;line-height:1.2;min-width:0;overflow:hidden;cursor:pointer;">
        <span style="font-size:0.68rem;opacity:0.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Nhập hàng thành công:</span>
        <span style="font-size:0.8rem;font-weight:800;color:#0284c7;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(R.buyerDoneMsg)}</span>
      </div>
    `;
    return;
  }

  const trips = (R && R.buyerTrips && R.buyerTrips.length) ? R.buyerTrips : (R && R.buyerTrip ? [R.buyerTrip] : []);
  if(!R || !R.running){
    w.style.display = 'none';
    w._tripKey = null;
    return;
  }

  if(!trips.length){
    w.style.display = 'flex';
    w.className = 'buyer-widget ready';
    w.innerHTML = `
      <span style="font-size:20px;line-height:1;flex:none;">${isRacer ? '🏎️' : '🛵'}</span>
      <div style="display:flex;flex-direction:column;line-height:1.2;min-width:0;overflow:hidden;cursor:pointer;">
        <span style="font-size:0.68rem;opacity:0.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(pName)}:</span>
        <span style="font-size:0.8rem;font-weight:700;color:#059669;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Sẵn sàng ${isRacer ? '0s' : ''} (Chạm để sai bảo) ✨</span>
      </div>
    `;
    w._tripKey = 'ready_' + pName;
    return;
  }

  w.style.display = 'flex';
  const tripCount = trips.length;
  const rem = Math.max(0.1, trips[0].t).toFixed(1);
  const itemNames = trips.map(tr => tr.name).join(', ');
  const tripKey = pName + '_' + itemNames + '_' + tripCount;
  if(w._tripKey !== tripKey){
    w._tripKey = tripKey;
    w.className = 'buyer-widget on-trip';
    w.innerHTML = `
      <span style="font-size:20px;line-height:1;flex:none;">${isRacer ? '🏎️' : '🛵'}</span>
      <div style="display:flex;flex-direction:column;line-height:1.2;min-width:0;overflow:hidden;cursor:pointer;">
        <span style="font-size:0.68rem;opacity:0.9;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${esc(pName)}${tripCount > 1 ? ` (${tripCount} người)` : ''} đang chạy chợ:</span>
        <span style="font-size:0.8rem;font-weight:800;color:#92400e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">Mua ${esc(itemNames)} (<span class="buyer-time-val">${rem}s</span>) 💨</span>
      </div>
    `;
  } else {
    const timeEl = w.querySelector('.buyer-time-val');
    if(timeEl) timeEl.textContent = `${rem}s`;
  }
}

function openBuyerDispatchModal(){
  if(!S || !S.upg || (!S.upg.staffBuyer && !S.upg.staffRacer)) return;
  const isRacer = (typeof isStaffActive === 'function') && isStaffActive('staffRacer');
  const pName = isRacer ? (staffPersonName('staffRacer') || 'Chiến thần xa lộ') : (staffPersonName('staffBuyer') || 'NV Đi Chợ');
  const numBuyers = isRacer ? 1 : ((typeof getStaffBuyerCount === 'function') ? getStaffBuyerCount() : 1);
  const trips = (R && R.buyerTrips && R.buyerTrips.length) ? R.buyerTrips : (R && R.buyerTrip ? [R.buyerTrip] : []);
  if(!isRacer && trips.length >= numBuyers){
    const rem = Math.max(0.1, trips[0].t).toFixed(1);
    const itemNames = trips.map(t => t.name).join(', ');
    toast(`🛵 Đội đi chợ (${trips.length}/${numBuyers} người) đang bận mua [${itemNames}]! Còn khoảng ${rem}s nữa 💨`, 2500);
    return;
  }

  const items = [];
  items.push('cup');
  if(level() >= 2) items.push('ice', 'sugar');
  BASE_KEYS.forEach(k => { if(S.unlocked[k] && !(S.off||{})[k]) items.push(k); });
  TOP_KEYS.forEach(k => { if(S.unlocked[k] && !(S.off||{})[k]) items.push(k); });
  const actTrend = (typeof TrendSystem !== 'undefined' && TrendSystem.getActiveTrend) ? TrendSystem.getActiveTrend() : null;
  const tFlav = (actTrend && actTrend.orderRecipe && actTrend.orderRecipe.flav) ? actTrend.orderRecipe.flav : null;
  const craftedFlavs = new Set();
  if(S.collection && S.collection.craftedRecipes){
    Object.values(S.collection.craftedRecipes).forEach(cr => {
      const fl = cr && cr.gameOrder && cr.gameOrder.flav;
      if(fl) craftedFlavs.add((typeof normIngKey === 'function' ? normIngKey(fl) : fl) || fl);
    });
  }
  FLAV_KEYS.forEach(k => {
    const isRel = (S.unlocked && S.unlocked[k]) ||
      (S.used && S.used[k] > 0) ||
      (R && R.today && R.today.used && R.today.used[k] > 0) ||
      (S.cur && S.cur.ing && S.cur.ing[k]) ||
      (S.stock && S.stock[k] && S.stock[k].some(b => b.q > 0)) ||
      (k === tFlav) ||
      craftedFlavs.has(k);
    if(isRel && !(S.off||{})[k]) items.push(k);
  });

  const rowsHtml = items.map(k => {
    const batch = getBuyerBatch(k);
    if(!batch) return '';
    const currentQ = qty(k);
    const canAfford = S.money >= batch.cost;
    const isLow = currentQ <= 3;
    return `
      <div style="display:flex;align-items:center;justify-content:space-between;padding:8px 10px;border-radius:12px;background:${isLow ? '#fffbeb' : '#f8fafc'};margin-bottom:6px;border:1px solid ${isLow ? '#fde68a' : '#e2e8f0'};">
        <div style="display:flex;flex-direction:column;line-height:1.2;text-align:left;">
          <div style="font-weight:700;font-size:0.9rem;color:#1e293b;">${esc(batch.name)} ${isLow ? '<span style="color:#dc2626;font-size:0.75rem;">(Sắp hết)</span>' : ''}</div>
          <div style="font-size:0.75rem;color:#64748b;">Kho: <b>${currentQ}</b> ${batch.unit} | Mua +${batch.q}: <b>${fmt(batch.cost)}</b></div>
        </div>
        <button type="button" class="sbtn sm primary" style="padding:6px 14px;font-size:0.8rem;border-radius:10px;white-space:nowrap;" ${!canAfford ? 'disabled' : ''} onclick="staffBuyerTriggerInstant('${k}');$('modal').hidden=true;">
          ${isRacer ? '🏎️ Mua tức thì' : '🛵 Đi mua'}
        </button>
      </div>
    `;
  }).join('');

  ask(`
    <div class="pbig">${isRacer ? '🏎️' : '🛵'}</div>
    <h3 style="margin:4px 0 2px;">Sai bảo ${esc(pName)} Đi Chợ</h3>
    <div style="font-size:0.82rem;color:#64748b;margin-bottom:12px;">${isRacer ? 'Chiến thần xa lộ mua bổ sung tức thì (0s chờ):' : 'Bấm món bạn muốn nhân viên chạy xe đi mua ngay:'}</div>
    <div style="max-height:280px;overflow-y:auto;padding-right:4px;">
      ${rowsHtml}
    </div>
  `, [['✕ Đóng', () => {}, 1]]);
}

function onBuyerWidgetClick(){
  if(!S || !S.upg || (!S.upg.staffBuyer && !S.upg.staffRacer)) return;
  openBuyerDispatchModal();
}

/* ===== NHÂN VIÊN SINH VIÊN CUỐI THÁNG (BÁN XUYÊN ĐÊM 22H - 6H) ===== */
function svTriggerStealIntent(){
  if(!R.running || !R.isNightShift || R.svStealTriggered) return;
  if(R.svWork){
    clearStaffPouring();
    R.svWork = null;
  }
  R.svStealTriggered = true;
  const ownedEquip = UPG.filter(u => S.upg[u.id]);
  const maxEquip = Math.max(1, ownedEquip.length);
  const count = Math.floor(Math.random() * maxEquip) + 1;
  R.svStealCount = count;
  R.svStealClicksNeeded = count;
  R.svStealClicksDone = 0;
  R.svStealTimer = 16.0;
  R.svStealIntent = true;
  const pName = (S.staffNames && S.staffNames.staffSv) || 'Sinh viên cuối tháng';
  R.svMsg = `Đã hơn 2h sáng, túng tiền trọ quá... Em đang tính lén đem ${count} món trang bị của quán đi cầm đồ 🥺📦!`;
  sfx('bad');
  toast(`🚨 2H SÁNG: ${pName} túng tiền trọ định lén bán ${count} món trang bị của quán! Hãy bấm KHUYÊN NGĂN ${count} lần trước khi quá muộn!`, 6500, 1);
  renderSvWidget();
}

function svCheer(e){
  if(!S.upg.staffSv || !R.running || !R.svStealIntent) return;
  if(e){ e.stopPropagation(); if(e.preventDefault) e.preventDefault(); }
  R.svStealClicksDone = (R.svStealClicksDone || 0) + 1;
  sfx('tap');
  if(typeof gzSpawnHeart === 'function') gzSpawnHeart(e);
  const pName = (S.staffNames && S.staffNames.staffSv) || 'Sinh viên cuối tháng';
  const remain = R.svStealClicksNeeded - R.svStealClicksDone;
  if(remain <= 0){
    R.svStealIntent = false;
    R.svStealClicksDone = R.svStealClicksNeeded;
    sfx('lvup');
    R.svMsg = 'Em hối hận rồi, cảm ơn sếp đã bao dung khuyên ngăn! Em xin hứa chăm chỉ làm việc chuộc lỗi! 😭✨';
    toast(`❤️ Đã khuyên ngăn thành công! ${pName} òa khóc từ bỏ ý định bán trang bị và chăm chỉ làm tiếp!`, 5500, 1);
  } else {
    const adviseQuotes = [
      'Sếp: "Bình tĩnh em ơi, khó khăn tiền trọ cứ nói sếp giúp!" 🫂',
      'Sếp: "Đừng dại dột làm liều em ơi, giữ lấy lương tâm!" 💬',
      'Sếp: "Thiếu tiền trọ cuối tháng sếp ứng lương trước cho!" 💵',
      'Sếp: "Để đồ lại cho quán làm ăn, đừng bán em ơi!" ✋',
      'Sếp: "Cố gắng lên em, vượt qua tháng này là ổn thôi!" ✨'
    ];
    R.svMsg = adviseQuotes[Math.floor(Math.random() * adviseQuotes.length)] + ` (Còn ${remain} lần khuyên)`;
  }
  renderSvWidget();
}

function svStealFail(){
  R.svStealIntent = false;
  const count = R.svStealCount || 1;
  const penalty = count * 150000;
  S.money -= penalty;
  S.cur.svPawnedLoss = (S.cur.svPawnedLoss || 0) + penalty;
  sfx('bad');
  const pName = (S.staffNames && S.staffNames.staffSv) || 'Sinh viên cuối tháng';
  toast(`💸 Không kịp khuyên ngăn! ${pName} đã lén mang ${count} món trang bị đi tiệm cầm đồ! Quán phải chi -${fmt(penalty)} chuộc lại tài sản! 😰`, 6500, 1);
  R.svMsg = `Em lỡ dại mang ${count} món đồ đi cầm rồi... Em xin lỗi sếp nhiều lắm 😢`;
  renderSvWidget();
}

function onSvWidgetClick(e){
  if(!S.upg.staffSv || !R.running || !R.isNightShift) return;
  if(e){ e.stopPropagation(); if(e.preventDefault) e.preventDefault(); }
  if((e.target && e.target.closest('[data-sv-act="police"]')) || (e.target && e.target.closest('.police-btn'))){
    reportFakeMoneyPolice();
    return;
  }
  if(R.svStealIntent){
    svCheer(e);
    return;
  }
  sfx('tap');
  if(typeof gzSpawnHeart === 'function') gzSpawnHeart(e);
  const pName = (S.staffNames && S.staffNames.staffSv) || 'Sinh viên cuối tháng';
  const funLines = [
    `${pName}: "Ca đêm vắng mà chill sếp ơi, em đang tập trung pha chế đây! ☕"`,
    `${pName}: "Hơi buồn ngủ xíu nhưng em vẫn gồng được, sếp nhớ bấm đường đá giúp em nha! 🥱🧋"`,
    `${pName}: "Làm đêm kiếm thêm tiền trang trải học phí, em cảm ơn sếp nhận em vào làm! 🧑‍🎓✨"`
  ];
  toast(funLines[Math.floor(Math.random() * funLines.length)], 3000);
}

function renderSvWidget(){
  const w = $('svWidget');
  const st = $('q3stage');
  if(!w) return;
  // Sinh viên cuối tháng CHỈ LÀM SAU 22H (ca đêm R.isNightShift), sau khi Gen Z hết ca
  const isSvActive = isStaffActive('staffSv') && R.isNightShift;
  if(!isSvActive || !R.running){
    w.style.display = 'none';
    if(st) st.classList.remove('has-sv');
    return;
  }
  w.style.display = 'flex';
  if(st) st.classList.add('has-sv');

  const pName = (S.staffNames && S.staffNames.staffSv) || 'Sinh viên cuối tháng';
  const avtImg = staffAvatarImg('staffSv', 38);

  const isFakeMoney = !!(R.fakeCase && R.fakeCase.suspect && !R.fakeCase.expired && !R.fakeCase.reported);
  let fakeLeft = 0;
  if(isFakeMoney){
    const elapsed = Math.floor((Date.now() - (R.fakeCase.time || Date.now())) / 1000);
    fakeLeft = Math.max(0, 10 - elapsed);
    if(fakeLeft <= 0){
      R.fakeCase.expired = true;
    }
  }
  const isFakeActive = isFakeMoney && fakeLeft > 0;

  if(isFakeActive){
    w.className = 'gz-widget sv-widget gz-fakemoney';
    const sName = R.fakeCase.suspect ? R.fakeCase.suspect.name : 'Khách';
    w.innerHTML = `
      <div class="gz-avatar">${avtImg}</div>
      <div class="gz-body">
        <div class="gz-head-row">
          <span class="gz-name">${esc(pName)}</span>
          <span class="gz-pill" style="background:#dc2626;color:#fff;">🚨 TIỀN GIẢ! (${fakeLeft}s)</span>
        </div>
        <div class="gz-msg" style="color:#b91c1c;font-weight:700;">Khách ${esc(sName)} vừa đưa tiền giả! Báo C.An ngay (+500k)!</div>
      </div>
      <button type="button" class="gz-poke-chip police-btn" id="svPoliceBtn" data-sv-act="police">🚨 Báo C.An <b>${fakeLeft}s</b> (+500k)</button>
    `;
    const pBtn = w.querySelector('#svPoliceBtn');
    if(pBtn) pBtn.onclick = (ev) => { ev.stopPropagation(); reportFakeMoneyPolice(); };
    return;
  }

  if(R.svStealIntent){
    w.className = 'gz-widget sv-widget sv-stealing';
    const needed = R.svStealClicksNeeded || 1;
    const done = Math.min(needed, R.svStealClicksDone || 0);
    const rem = Math.max(0, Math.ceil(R.svStealTimer || 0));
    w.innerHTML = `
      <div class="gz-avatar">${avtImg}</div>
      <div class="gz-body">
        <div class="gz-head-row">
          <span class="gz-name">${esc(pName)}</span>
          <span class="gz-pill sv-pill-steal">🚨 ĐỊNH BÁN ${R.svStealCount} MÓN ĐỒ (${rem}s)</span>
        </div>
        <div class="gz-msg sv-steal-msg" style="color:#b91c1c;font-weight:600;" title="${esc(R.svMsg || 'Túng tiền trọ quá...')}">${esc(R.svMsg || 'Túng tiền trọ quá...')}</div>
      </div>
      <button type="button" class="gz-poke-chip sv-cheer-btn" data-sv-act="cheer">🛑 Khuyên ngăn (${done}/${needed})</button>
    `;
  } else {
    // KHI ĐÃ HẾT Ý ĐỒ BÁN ĐỒ HOẶC HẾT TIỀN GIẢ: XOÁ SẠCH LẬP TỨC TRẠNG THÁI VÀ NÚT BẤM
    const hadPoliceState = w.classList.contains('gz-fakemoney') || !!w.querySelector('#svPoliceBtn') || !!w.querySelector('.police-btn');
    const hadStealState = w.classList.contains('sv-stealing') || !!w.querySelector('.sv-cheer-btn') || !!w.querySelector('.gz-cheer-row') || hadPoliceState;
    w.classList.remove('sv-stealing', 'gz-fakemoney');
    const oldPBtn = w.querySelector('#svPoliceBtn, .police-btn');
    if(oldPBtn) oldPBtn.remove();
    w.className = 'gz-widget sv-widget';

    const isShiftClosing = !!(R && (R.closing || (R.isNightShift ? R.nightT <= 0 : R.t <= 0)));
    let workStatus = isShiftClosing ? '✨ Đang hoàn thành nốt đơn khách trước khi đóng sổ! 🧋' : 'Tự động pha chế A-Z... ✨';
    let shiftBadge = isShiftClosing ? '🌙 Kết ca (phục vụ nốt khách)' : '🌙 Ca đêm (22h - 6h)';
    if(R.svWork){
      const wSt = R.svWork.step;
      const c = R.slots[R.svWork.slotIdx];
      const o = c ? c.cups[R.svWork.cupIdx] : null;
      if(wSt === 'cup'){
        workStatus = `🥤 Đang lấy ly size ${o ? o.size : 'M'}...`;
        shiftBadge = '🥤 Lấy ly';
      } else if(wSt === 'tea'){
        const bName = o && ITEMS[o.base] ? ITEMS[o.base].n : 'cốt trà';
        workStatus = `🫖 Đang rót ${bName}...`;
        shiftBadge = '🫖 Rót trà';
      } else if(wSt === 'flav'){
        const fName = o && o.flav && ITEMS[o.flav] ? ITEMS[o.flav].n : 'siro';
        workStatus = `🧴 Đang bơm siro ${fName}...`;
        shiftBadge = '🧴 Thêm siro';
      } else if(wSt === 'tops'){
        const curTopKey = o && o.tops ? o.tops[R.svWork.topIdx || 0] : null;
        const tName = curTopKey && ITEMS[curTopKey] ? ITEMS[curTopKey].n : 'topping';
        workStatus = `🥄 Đang múc topping: ${tName}... ✨`;
        shiftBadge = '🥄 Múc topping';
      } else if(wSt === 'sugar_ice'){
        const sugVal = (o && o.sugar != null) ? o.sugar : (cup.sugar != null ? cup.sugar : 50);
        const iceVal = (o && o.ice) ? o.ice : (cup.ice || 'Đá thường');
        workStatus = `🧊 Đang thêm ${sugVal}% đường & ${iceVal}...`;
        shiftBadge = '🧊 Đường & đá';
      } else if(wSt === 'seal'){
        workStatus = '✨ Đang dán nắp & giao cho khách... 🧋';
        shiftBadge = '🧋 Dán nắp & Giao';
      }
    }
    const isChiding = !!(R.svWork && R.svWork.chide && Date.now() < (R.svWork.chideUntil || 0));
    const isTipMsg = !!(R.svTipMsg && Date.now() < (R.svTipMsgUntil || 0));
    const isBuyerMsg = !!(R.svBuyerMsg && Date.now() < (R.svBuyerMsgUntil || 0));
    let pillBadge = isChiding ? '🥱 Cứu nguy ca đêm' : (isTipMsg ? `💵 Nộp lại tiền bo (+${fmt(R.svLastReturnedTip || 0)})` : (isBuyerMsg ? '🛵 Đi chợ về' : shiftBadge));
    let pillBg = isChiding ? '#e11d48' : (isTipMsg ? '#059669' : (isBuyerMsg ? '#0284c7' : '#4338ca'));
    let msgText = isChiding ? ('"' + R.svWork.chide + '"') : (isTipMsg ? R.svTipMsg : (isBuyerMsg ? R.svBuyerMsg : workStatus));

    const msgEl = w.querySelector('.gz-msg');
    const pillEl = w.querySelector('.gz-pill');
    const nameEl = w.querySelector('.gz-name');

    // NẾU KHÔNG CÒN TRẠNG THÁI KHUYÊN NGĂN HOẶC TIỀN GIẢ VÀ CÁC THẺ DOM ĐÃ ĐẦY ĐỦ: CẬP NHẬT NHẸ TEXT
    if(!hadStealState && !hadPoliceState && msgEl && pillEl && nameEl && !w.querySelector('.sv-cheer-btn') && !w.querySelector('.police-btn') && !w.querySelector('#svPoliceBtn') && !w.querySelector('.gz-hp')){
      if(msgEl.textContent !== msgText) msgEl.textContent = msgText;
      if(pillEl.textContent !== pillBadge) pillEl.textContent = pillBadge;
      pillEl.style.background = pillBg;
      msgEl.style.color = (isChiding ? '#e11d48' : (isTipMsg ? '#059669' : (isBuyerMsg ? '#0284c7' : '')));
      msgEl.style.fontWeight = (isChiding || isTipMsg || isBuyerMsg) ? '700' : '';
      if(nameEl.textContent !== pName) nameEl.textContent = pName;
      return;
    }

    // NẾU VỪA KHUYÊN NGĂN XONG HOẶC CHƯA CÓ DOM CHUẨN: TÁI TẠO LẠI TOÀN BỘ SẠCH SẼ 100%
    w.innerHTML = `
      <div class="gz-avatar">${avtImg}</div>
      <div class="gz-body">
        <div class="gz-head-row">
          <span class="gz-name">${esc(pName)}</span>
          <span class="gz-pill" style="background:${pillBg};color:#fff;">${pillBadge}</span>
        </div>
        <div class="gz-msg" style="${(isChiding || isTipMsg) ? 'color:' + (isChiding ? '#e11d48' : '#059669') + ';font-weight:700;' : ''}">${esc(msgText)}</div>
      </div>
    `;
  }
}

function staffSvTick(dt){
  // Sinh viên cuối tháng CHỈ LÀM SAU 22H (ca đêm R.isNightShift), sau khi Gen Z hết ca
  if(!isStaffActive('staffSv') || !R.isNightShift || !R.running || R.paused) return;

  // 1. Nếu đang có ý định bán trang bị, đếm ngược thời gian
  if(R.svStealIntent){
    R.svStealTimer = Math.max(0, (R.svStealTimer || 0) - dt);
    const w = $('svWidget');
    if(w){
      const rem = Math.ceil(R.svStealTimer);
      const remEl = w.querySelector('.sv-rem-sec');
      if(remEl) remEl.textContent = `${rem}s`;
    }
    if(R.svStealTimer <= 0){
      svStealFail();
    }
    return;
  }

  // 2. Kiểm tra mốc 2h sáng: có ý đồ bán trang bị quán (chỉ ca đêm)
  if(R.isNightShift){
    const elNight = Math.min(1, Math.max(0, 1 - (R.nightT / (R.nightTot || 80))));
    const svTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffSv') : 0;
    if(elNight >= 0.50 && !R.svStealTriggered && !R.closing){
      if(svTrainLv >= 4){
        // Cấp 4+: Thủ khoa ca đêm 100% trung thực, không bao giờ có ý định bán trang bị
      } else if(svTrainLv > 0 && Math.random() < svTrainLv * 0.25){
        // Giảm 25%/cấp nguy cơ nảy sinh ý đồ trộm đồ
      } else {
        svTriggerStealIntent();
        return;
      }
    }
  }

  // 3. Nếu đang thực hiện pha chế ly
  if(R.svWork){
    const w = R.svWork;
    const c = w.type === 'online' ? (R.online && R.online.find(x => x && x.id === w.cId)) : (R.slots[w.slotIdx] || R.slots.find(x => x && x.id === w.cId));
    if(!c || c.id !== w.cId || c.done[w.cupIdx]){
      clearStaffPouring();
      R.svWork = null;
      renderSvWidget();
      renderLane();
      if(w.type === 'online') renderOnline();
      return;
    }
    w.t -= dt;
    if(w.step === 'tea_pour'){
      const prog = Math.min(1, Math.max(0, 1 - (w.t / (w.totalT || 1))));
      cup.fill = Math.min(0.8, 0.05 + prog * 0.75);
      w.liquidH = Math.min(75, 15 + prog * 60);
      if(!pourFast()) renderCup();
    }
    if(w.t <= 0){
      staffSvStep();
    }
    return;
  }

  // 4. Sinh viên ca đêm: Tự động pha chế trọn gói các đơn quầy đêm 22h-6h (Sàn cứng 100ms = 0.10s)
  const svSpd = 1 + getStaffSpeedBuff('staffSv');
  const svStepT = Math.max(0.10, 0.25 / svSpd);

  // Chuẩn: Sinh viên ca đêm nhận khách giống Nhân viên phụ quầy 2 (Quản lý tập sự / staff3) phục vụ focusCust() tại quầy đêm
  const f = (typeof focusCust === 'function') ? focusCust() : null;
  if(!f) return;

  const cupIdx = f.cups ? f.cups.findIndex((o, k) => !f.done[k]) : -1;
  if(cupIdx < 0) return;
  const o = f.cups[cupIdx];
  f.order = o;

  const isOnline = !!(R.online && R.online.some(c => c && c.id === f.id));
  const targetCust = f;
  const targetCupIdx = cupIdx;

  // Kiểm tra nguyên liệu còn thiếu cho ly này: dùng missing(o) chuẩn xác (không bị kẹt kho cup=0 khi ly đã có sẵn)
  const curMissing = (typeof missing === 'function') ? missing(o) : [];
  const boardHasMatchingCup = cup && cup.size && (cup.size === o.size || cup._svWrongAccept) && cup.used;
  const needCupFromStock = !boardHasMatchingCup && qty('cup') <= 0;

  if(curMissing.length > 0 || needCupFromStock){
    const itemToFetch = curMissing[0] || (needCupFromStock ? 'cup' : null);
    if(itemToFetch && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
      staffBuyerTriggerInstant(itemToFetch);
    }
    return;
  }

  // Tự động dọn ly sai/dở dang trên bàn nếu không khớp với đơn của khách hiện tại
  const isWrongCupOnBoard = cup && cup.size && (
    (!cup._svWrongAccept && cup.size !== o.size) ||
    (cup.base && cup.base !== o.base) ||
    (cup.flav && o.flav && cup.flav !== o.flav)
  );
  if(isWrongCupOnBoard){
    spoilCup();
    cup = newCup();
  }

  // Tự động lấy ly: Lấy ly khi trên bàn chưa có ly, ly rỗng chưa có size, hoặc ly sai size
  const isCupNeeded = !cup || !cup.size || !cup.used || !cup._cupDeducted;
  if(isCupNeeded || (!cup._svWrongAccept && cup.size !== o.size)){
    if(!qty('cup')){
      if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)) staffBuyerTriggerInstant('cup');
      return;
    }
    cup = newCup();

    let wrongSizeRate = 0.05;
    if(S.pet && S.pet.unlocked && (S.pet.happiness || 0) >= 50){
      wrongSizeRate = 0.025;
    }
    const svTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffSv') : 0;
    if(svTrainLv >= 5){
      // Cấp 5 Đại Sư: 0% downsize, khi nhầm size thì 100% là Auto Upsize L (5★)
      if(o.size === 'M' && Math.random() < 0.20){
        cup.size = 'L';
        targetCust._svWrongSize = 'up';
        cup._svWrongAccept = true;
        targetCust.order._svWrongAccept = true;
        o._svWrongAccept = true;
        toast('👑 Sinh viên Đại Sư ca đêm: Tự động Upsize L miễn phí (Khách 100% cho 5★)!', 3500);
      } else {
        cup.size = o.size;
      }
    } else {
      if(svTrainLv > 0) wrongSizeRate *= Math.max(0, 1 - svTrainLv * 0.25);
      const isSleepy = Math.random() < wrongSizeRate;
      if(isSleepy && o.size === 'M'){
        cup.size = 'L';
        targetCust._svWrongSize = 'up';
        cup._svWrongAccept = true;
        targetCust.order._svWrongAccept = true;
        o._svWrongAccept = true;
        toast('🥱 Sinh viên cuối tháng ngái ngủ lấy nhầm ly size L (khách gọi M)!', 4000);
      } else if(isSleepy && o.size === 'L'){
        cup.size = 'M';
        targetCust._svWrongSize = 'down';
        cup._svWrongAccept = true;
        targetCust.order._svWrongAccept = true;
        o._svWrongAccept = true;
        toast('🥱 Sinh viên cuối tháng ngáp dài lấy nhầm ly size M (khách gọi L)!', 4000);
      } else {
        cup.size = o.size;
      }
    }
    cup.used = true;
    cup.staff = true;
    if(!useStaffCup(cup)){
      return;
    }
    const btn = $('q3_' + cup.size);
    if(btn) q3pop(btn);
    sfx('tap');
    renderCup();
    renderPanel();
    coach();
  }

  // Khi đã có ly đúng size: Bắt đầu chu trình pha chế trọn gói
  const isSizeOk = cup && cup.size && (cup.size === o.size || cup._svWrongAccept);
  if(isSizeOk){
    let startStep = 'tea';
    if(cup.base === o.base && (cup.fill || 0) >= 0.72){
      if(o.flav && cup.flav !== o.flav) startStep = 'flav';
      else if(o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) startStep = 'tops';
      else if(level() >= 2 && (cup.sugar == null || !cup.ice)) startStep = 'sugar_ice';
      else startStep = 'seal';
    } else if(cup.base && cup.base !== o.base){
      spoilCup();
      cup = newCup();
      renderCup();
      renderPanel();
      return;
    }
    const slotIdx = isOnline ? (R.online ? R.online.indexOf(targetCust) : -1) : (R.slots ? R.slots.indexOf(targetCust) : -1);
    R.svWork = {
      type: isOnline ? 'online' : 'lane',
      slotIdx: slotIdx,
      cId: targetCust.id,
      cupIdx: targetCupIdx,
      step: startStep,
      t: svStepT, totalT: svStepT,
      topIdx: 0,
      cup: cup
    };
    renderLane();
    if(isOnline) renderOnline();
    renderPanel();
    return;
  }
}

function staffSvStep(){
  if(!R.svWork || !R.running){
    clearStaffPouring();
    R.svWork = null;
    if(cup && cup.used && cup.staff && !cup.base) cup = newCup();
    renderSvWidget();
    renderLane();
    renderCup();
    renderPanel();
    return;
  }
  const svSpd = 1 + getStaffSpeedBuff('staffSv');
  const svStepT = Math.max(0.10, 0.25 / svSpd);
  const w = R.svWork;
  const c = w.type === 'online' ? (R.online && R.online.find(x => x && x.id === w.cId)) : (R.slots[w.slotIdx] || R.slots.find(x => x && x.id === w.cId));
  if(!c || c.id !== w.cId || c.done[w.cupIdx]){
    clearStaffPouring();
    R.svWork = null;
    renderSvWidget();
    renderLane();
    if(w.type === 'online') renderOnline();
    return;
  }
  const o = c.cups[w.cupIdx];
  if(!o){
    clearStaffPouring();
    R.svWork = null;
    renderSvWidget();
    renderLane();
    return;
  }
  // Dùng missing(o) để kiểm tra các nguyên liệu CÒN LẠI chưa cho vào ly
  const curMissing = (typeof missing === 'function') ? missing(o) : [];
  if(curMissing.length > 0){
    clearStaffPouring();
    R.svWork = null;
    if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
      staffBuyerTriggerInstant(curMissing[0]);
    }
    renderSvWidget();
    renderLane();
    return;
  }

  // 1. STEP CUP
  if(w.step === 'cup'){
    if(!cup.size || !cup.used || !cup._cupDeducted){
      cup = newCup();
      cup.size = o.size;
      cup.used = true;
      cup.staff = true;
      useStaffCup(cup);
      const btn = $('q3_' + cup.size);
      if(btn) q3pop(btn);
      sfx('tap');
    }
    w.step = 'tea';
  }

  // 2. STEP TEA
  if(w.step === 'tea'){
    if(cup.base === o.base && (cup.fill || 0) >= 0.72){
      w.step = (o.flav && cup.flav !== o.flav) ? 'flav' : ((o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) ? 'tops' : (level() >= 2 ? 'sugar_ice' : 'seal'));
      w.t = svStepT;
      renderCup();
      renderPanel();
      return;
    }
    if(!cup.base){
      if(qty(o.base) > 0) consume(o.base);
      cup.base = o.base;
      cup.fill = 0.05;
      R.pour = o.base;
      R.staffPouring = true;
      pourSnd(true);
      const bBtn = $('q3b_' + o.base);
      if(bBtn){
        q3pop(bBtn);
        bBtn.classList.add('q3on');
      }
      w.step = 'tea_pour';
      w.totalT = svStepT * 1.5;
      w.t = w.totalT;
      renderCup();
      renderPanel();
      renderLane();
      return;
    }
  }

  if(w.step === 'tea_pour'){
    cup.fill = 0.8;
    clearStaffPouring();
    sfx('plop');
    w.step = (o.flav && cup.flav !== o.flav) ? 'flav' : ((o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) ? 'tops' : (level() >= 2 ? 'sugar_ice' : 'seal'));
    w.t = svStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 3. STEP FLAV
  if(w.step === 'flav'){
    if(o.flav && cup.flav !== o.flav && qty(o.flav) > 0){
      consume(o.flav);
      cup.flav = o.flav;
      const btn = $('q3b_' + o.flav);
      if(btn) q3pop(btn);
      sfx('pump');
    }
    w.step = (o.tops.some(t => !cup.tops.includes(t)) || (o.cheese && !cup.cheese)) ? 'tops' : (level() >= 2 ? 'sugar_ice' : 'seal');
    w.t = svStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 4. STEP TOPS
  if(w.step === 'tops'){
    const missingTops = o.tops.filter(t => !cup.tops.includes(t));
    if(missingTops.length > 0){
      const topKey = missingTops[0];
      if(topKey && qty(topKey) > 0){
        consume(topKey);
        cup.tops.push(topKey);
        if(ITEMS[topKey] && ITEMS[topKey].g !== 'foam'){
          cup.vt = cup.vt || [];
          cup.vt.push({ k: topKey, pts: q3layer(topKey) });
        }
        const btn = $('q3b_' + topKey);
        if(btn) q3pop(btn);
        sfx('plop');
      } else if(topKey && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
        staffBuyerTriggerInstant(topKey);
      }
      if(missingTops.length > 1){
        w.t = svStepT;
        renderCup();
        renderPanel();
        renderLane();
        return;
      }
    }
    if(o.cheese && !cup.cheese && qty('cheese') > 0){
      consume('cheese');
      cup.cheese = true;
      sfx('plop');
    }
    w.step = level() >= 2 ? 'sugar_ice' : 'seal';
    w.t = svStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 5. STEP SUGAR & ICE
  if(w.step === 'sugar_ice'){
    const lv = level();
    if(lv >= 2){
      if(cup.sugar == null){
        cup.sugar = o.sugar != null ? o.sugar : 70;
        cup.sugarN = SUGAR.indexOf(cup.sugar) + 1;
        if(cup.sugar > 0 && qty('sugar') > 0) consume('sugar');
        const sBtn = $('q3b_sugar');
        if(sBtn) q3pop(sBtn);
      }
      if(!cup.ice){
        cup.ice = o.ice || 'Đá thường';
        cup.iceN = (cup.ice === 'Không đá' ? 0 : cup.ice === 'Ít đá' ? 1 : 2);
        if(cup.ice !== 'Không đá' && qty('ice') > 0) consume('ice');
        const iBtn = $('q3b_ice');
        if(iBtn) q3pop(iBtn);
        sfx('ice');
      }
    }
    w.step = 'seal';
    w.t = svStepT;
    renderCup();
    renderPanel();
    renderLane();
    return;
  }

  // 6. DÁN NẮP VÀ GIAO LY
  if(w.step === 'seal'){
    cup.sealed = true;
    const sBtn = $('q3seal');
    if(sBtn) q3pop(sBtn);
    sfx('seal');
    renderCup();
    w.cup = cup;

    // Đảm bảo cup đầy đủ thông số chính xác 100%
    cup.base = o.base;
    if(!cup.size) cup.size = o.size;
    cup.flav = o.flav || null;
    cup.tops = [...o.tops];
    cup.cheese = !!o.cheese;
    cup.sugar = o.sugar;
    cup.ice = o.ice;
    cup.fill = 0.8;
    cup.used = true;

    if(w.type === 'online'){
      const actualOnlIdx = R.online ? R.online.indexOf(c) : -1;
      if(actualOnlIdx >= 0) serveOnline(actualOnlIdx);
    } else {
      const actualSlot = R.slots ? R.slots.indexOf(c) : -1;
      serve(actualSlot >= 0 ? actualSlot : w.slotIdx);
    }

    if(cup && cup.used && cup.staff) cup = newCup();
    R.svWork = null;
    renderCup();
    renderPanel();
    renderLane();
    if(w.type === 'online') renderOnline();
    renderSvWidget();
    return;
  }
}

function autoSeal(){if(!S.upg.sealer||isEquip3Broken('sealer'))return;clearTimeout(R.asT);R.asT=setTimeout(()=>{
  if(!R.running||R.paused||R.sealing||R.pour||R.helping||!cup.size||!cup.base||cup.sealed||cup.spill)return;
  const lv=level(),c2={...cup,ice:lv>=2?(cup.ice||'Không đá'):cup.ice};
  const ok=(lv<2||cup.sugar)&&(pSlots().some(c=>c&&c.cups.some((o,j)=>!c.done[j]&&matches(c2,o)))||R.online.some(c=>c.cups.some((o,q)=>!c.done[q]&&matches(c2,o))));
  if(ok){
    if((cup.fill||0) < 0.72){
      cup.fill = 0.8;
      toast('🧑‍🍳 Nhân viên rót thiếu trà, chủ tiệm đã chủ động rót thêm cho đủ vạch xanh! 🧋✨', 2500);
      renderCup();
    }
    R.asMsg=null;toast('Máy tự dán nắp');sealServe(1);return;
  }
  /* máy không dán: nói rõ lý do để người chơi biết mà sửa */
  const all=[];[...pSlots().filter(Boolean),...R.online].forEach(c=>c.cups.forEach((x,j)=>{if(!c.done[j])all.push(x)}));if(!all.length)return;
  const diff=o=>{const bad=[];
  if(cup.size!==o.size)bad.push('sai size');
  if(cup.base!==o.base||cup.mixed)bad.push('sai loại trà');
  if(cup.flav&&cup.flav!==(o.flav||null))bad.push(o.flav?'sai siro':'dư siro '+low(ITEMS[cup.flav].n));
  cup.tops.filter(t=>!o.tops.includes(t)).forEach(t=>bad.push('dư '+low(ITEMS[t].n)));
  const misTops=o.tops.filter(t=>!cup.tops.includes(t));
  if(misTops.length)bad.push('thiếu '+(misTops.length>2?`${misTops.length} loại topping`:misTops.map(t=>low(ITEMS[t].n)).join(', ')));
  if(lv>=2&&o.sugar!=null&&(cup.sugar||0)>o.sugar)bad.push('dư đường');
  const iceN={'Không đá':0,'Ít đá':1,'Đá thường':2};if(lv>=2&&o.ice!=null&&(cup.iceN||0)>iceN[o.ice])bad.push('dư đá');return bad};
  const bad=all.map(diff).sort((x,y)=>x.length-y.length)[0];
  let msg=bad.length?'Máy chưa dán nắp: '+bad.join(', ')+'. Chạm máy dán nắp nếu vẫn muốn giao ly (khách nhận nhưng đánh giá xấu)':ok?'Máy chưa dán nắp: trà còn ít, rót thêm tới vạch xanh':null;
  if(msg&&R.asMsg!==msg){R.asMsg=msg;toast(msg)}},150)}
function startPour(k,el){
  if(R.staffPouring){toast('Nhân viên đang rót trà, chờ xíu');return}if(R.pour)return;
  if(!ITEMS[k])return;
  if(!qty(k)){if(S.upg.staffBuyer || S.upg.staffRacer)staffBuyerTriggerInstant(k);else toast('Hết '+ITEMS[k].n+'! Nhập thêm ở kho ngày mai');return}
  if(!cup.size){toast('Lấy ly M hoặc L trước');return}if(!S.unlocked[k]){toast((S.off||{})[k]?ITEMS[k].n+' đã bỏ khỏi menu':'Chưa mở '+ITEMS[k].n+' (Nâng cấp)');return}
  if(!cup.base){addIng('base',k);if(cup.base!==k)return}else if(cup.base!==k)cup.mixed=true;
  R.pour=k;pourSnd(true);q3pourEl=el;if(el&&el.classList)el.classList.add('q3on');q3wob=el?q3pop(el,1):null;q3last=performance.now();renderPanel();renderCup();
  const tick=now=>{if(!R.pour)return;const dt=(now-q3last)/1000;q3last=now;const was=cup.spill;const pourSpd = (1 + getStaffSpeedBuff() * 0.35) * getTeaPourSpeedMul();cup.fill=(cup.fill||0)+dt*(0.54 * Math.min(2.5, pourSpd));if(cup.fill>1.02){cup.fill=1.02;cup.spill=true}if(was!==cup.spill||!pourFast())renderCup();q3raf=requestAnimationFrame(tick)};
  q3raf=requestAnimationFrame(tick)}
function stopPour(){if(!R.pour||R.staffPouring)return;R.pour=null;pourSnd(false);cancelAnimationFrame(q3raf);q3pourEl&&q3pourEl.classList.remove('q3on');q3wob&&q3wob.remove();q3wob=null;renderCup();autoSeal();coach()}
function q3burst(s){const st=$('q3stage');if(!st||q3reduce)return;const n=s>=5?7:4;
  for(let i=0;i<n;i++){const im=document.createElement('img');im.className='q3burst';im.src=IMG+'stk_'+(i%2?'star':'heart')+'.png';im.alt='';
    im.style.left=(96+Math.random()*50)+'px';im.style.top=(230+Math.random()*30)+'px';st.appendChild(im);
    const dx=(Math.random()*2-1)*110,dy=-60-Math.random()*90;
    im.animate([{transform:'translate(0,0) scale(.3)',opacity:0},{transform:`translate(${dx*.4}px,${dy*.5}px) scale(1)`,opacity:1,offset:.3},{transform:`translate(${dx}px,${dy}px) scale(.8) rotate(${dx/3}deg)`,opacity:0}],{duration:1100+Math.random()*400,easing:'ease-out',delay:i*60}).onfinish=()=>im.remove()}}
function sealServe(fast){
  const sealSpd = 1 + getStaffSpeedBuff() * 0.35;const baseD = q3reduce ? 240 : (fast ? 450 : 1050);const D = Math.max(180, Math.round(baseD / Math.min(1.8, sealSpd)));const k1=D/1200;
  if(!cup.size){toast('Lấy ly M hoặc L trước');return}
  if(!cup.base){toast('Chưa rót trà');return}
  if(cup && cup.base && (cup.fill || 0) < 0.72){
    cup.fill = 0.8;
    toast('🧑‍🍳 Chủ tiệm đã chủ động rót thêm trà cho chuẩn vạch xanh! 🧋✨', 2500);
    renderCup();
  }
  if(level()>=2&&!cup.sugar)cup.sugar=70;
  if(level()>=2&&!cup.ice)cup.ice='Không đá';
  if(!ready())return;
  const cands=[];pSlots().forEach((c,i)=>{if(c&&c.cups.some((o,j)=>!c.done[j]&&matches(cup,o)))cands.push(c)});
  R.online.forEach(c=>{if(!isSto(c)&&c.cups.some((o,q)=>!c.done[q]&&matches(cup,o)))cands.push(c)});
  const fc=focusCust();
  const target=(fc&&cands.includes(fc))?fc:(cands.length?cands.sort((a,b)=>a.id-b.id)[0]:fc);
  if(!target){toast('Chưa có khách');return}
  R.focus=target.id;renderLane();renderPanel();R.sealing=true;
  clearTimeout(R._sealingTimeout);
  R._sealingTimeout = setTimeout(()=>{ R.sealing = false; }, 2500);
  try {
    const w=$('q3cup'),stg=$('q3stage'),sr=stg?stg.getBoundingClientRect():null,k=sr?sr.width/768:1,r=w?w.getBoundingClientRect():null;
    if(!w||!stg||!sr||!r){
      R.sealing=false;clearTimeout(R._sealingTimeout);
      const i=R.slots.indexOf(target),j=R.online.indexOf(target);
      if(i>=0)serve(i);else serveOnline(j);
      return;
    }
    const cx=(r.left-sr.left)/k+r.width/k/2,cy=(r.top-sr.top)/k+r.height/k/2;
    const toS=`translate(${700-cx}px,${505-cy}px) scale(.42)`,toC=`translate(${116-cx}px,${262-cy}px) scale(.5)`;
    let an = null;
    try {
      an=w.animate([{transform:'none',offset:0},{transform:toS,offset:.3},{transform:toS,offset:.62},{transform:toC,opacity:1,offset:.95},{transform:toC,opacity:0,offset:1}],{duration:D,easing:'ease-in-out',fill:'forwards'});
    } catch(eAnimation) { console.warn('Animation failed:', eAnimation); }
    setTimeout(()=>{try{const s=$('q3seal');s&&q3pop(s);sfx('seal');cup.sealed=true;renderCup()}catch(_){}},q3reduce?100:520*k1);
    setTimeout(()=>{
      try{an&&an.cancel()}catch(_){}
      R.sealing=false;clearTimeout(R._sealingTimeout);
      if(!R.running)return;
      const off=cup.spill||Math.abs((cup.fill||0)-.8)>.14;
      const i=R.slots.indexOf(target),j=R.online.indexOf(target);
      if(i<0&&j<0){cup.sealed=false;renderCup();toast('Khách đã đi mất');return}
      if(off&&matches(cup,target.order))target.fillPen=(target.fillPen||0)+1;if(cup.spill||(cup.fill||0)>.95)target.spilled=true;
      const nRev=S.reviews.length;
      if(i>=0)serve(i);else serveOnline(j);
      if(S.reviews.length>nRev&&hasFace(target)){const s=S.reviews[0].s,e=s>=4?1:s<=2?2:0,fc=$('q3face');R.flash=true;
        if(fc){fc.className='q3face';fc.textContent='';fc.style.cssText=faceOf(target,e,144,141);}
        if(s>=4)q3burst(s);setTimeout(()=>{R.flash=false;renderLane()},1100)}
    },q3reduce?320:1450*k1);
  } catch(err) {
    console.error('Error in sealServe:', err);
    R.sealing=false;clearTimeout(R._sealingTimeout);
    const i=R.slots.indexOf(target),j=R.online.indexOf(target);
    if(i>=0)serve(i);else serveOnline(j);
  }
}

/* ---------- GAME LOOP ---------- */
const appN=c=>(APPS.find(a=>a.id===c.app)||APPS[0]).n;
function genOrder(){
  const lv=level(),un=k=>S.unlocked[k],has=k=>qty(k)>0;
  const bases=BASE_KEYS.filter(un),fl=FLAV_KEYS.filter(un).filter(addOk);let so=null;

  // Nếu quán đã áp món trend vào menu (rdStatus === 'completed'), có 25% - 40% khách gọi món Trend
  const actTrend = (typeof window.TrendSystem !== 'undefined' && window.TrendSystem.getActiveTrend) ? window.TrendSystem.getActiveTrend() : null;
  const isTrendApplied = S.marketTrend && S.marketTrend.rdStatus === 'completed' && actTrend;
  const trendChance = (S.marketTrend && S.marketTrend.standeeActive) ? 0.40 : 0.25;
  if(isTrendApplied && Math.random() < trendChance){
    const trRecipe = S.marketTrend.customRecipe || actTrend.orderRecipe || {};
    const trBase = trRecipe.base || 'tra';
    const trFlav = trRecipe.flav || null;
    const trTops = (trRecipe.tops || []).filter(addOk);
    if(un(trBase) && (!trFlav || un(trFlav))){
      const sugPick = wpick([30, 50, 70, 100], [0.2, 0.5, 0.2, 0.1]);
      const icePick = wpick(['Không đá', 'Ít đá', 'Bình thường'], [0.15, 0.45, 0.40]);
      const sizePick = (lv >= 3 && Math.random() < 0.35) ? 'L' : 'M';
      const mul = (actTrend.priceMultipliers && actTrend.priceMultipliers[S.marketTrend.stage || 1]) || 1.5;
      return {
        base: trBase,
        flav: trFlav,
        tops: [...trTops],
        sugar: lv >= 2 ? sugPick : null,
        ice: lv >= 2 ? icePick : null,
        size: sizePick,
        trendName: actTrend.name,
        isTrendDrink: true,
        trendMultiplier: mul,
        trendStar: S.marketTrend.rdStar || 3
      };
    }
  }

  // khách muốn món nào đó; khi hết món, thay vì chờ nhân viên đi chợ mua về thì khách có tỉ lệ bỏ về (45%)
  const want=ks=>{
    const k=rnd(ks);
    if(has(k))return k;
    if(Math.random() < 0.45){
      so = so || k;
      return k;
    }
    const av=ks.filter(has);
    if(av.length)return rnd(av);
    so=so||k;
    return k;
  };
  const tr=evIs('trend')&&S.unlocked[ev().k]&&Math.random()<.5?ev().k:null;
  const extraIngPct = getToolsExtraIngChance();
  const base=tr||want(bases),flav0=base!=='thai'&&fl.length&&Math.random()<Math.min(0.95, 0.85 + extraIngPct)?want(fl):null,flav=flav0&&addSkip(flav0)?null:flav0;

  const unTops = TOP_KEYS.filter(k => un(k) && addOk(k));
  const tcPool = unTops.filter(k => ITEMS[k].g === 'tc').sort(() => Math.random() - 0.5);
  const thachPool = unTops.filter(k => ITEMS[k].g === 'thach').sort(() => Math.random() - 0.5);
  const pmPool = unTops.filter(k => ITEMS[k].g === 'pm').sort(() => Math.random() - 0.5);
  const foamPool = unTops.filter(k => ITEMS[k].g === 'foam').sort(() => Math.random() - 0.5);

  // Giảm bớt lượng topping về nguyên như cũ: tầm 1 - 3 topping, tối đa 4 topping
  const maxAvailable = unTops.length;
  const maxAllowed = lv >= 3 ? 4 : (lv >= 2 ? 3 : 2);
  const targetMax = Math.min(maxAllowed, maxAvailable);

  let numTops = 0;
  if(targetMax === 1) numTops = wpick([0, 1], [0.15, 0.85]);
  else if(targetMax === 2) numTops = wpick([1, 2], [0.55, 0.45]);
  else if(targetMax === 3) numTops = wpick([1, 2, 3], [0.40, 0.45, 0.15]);
  else if(targetMax >= 4) numTops = wpick([1, 2, 3, 4], [0.35, 0.45, 0.16, 0.04]);

  if(Math.random() < extraIngPct && numTops < targetMax){
    numTops = Math.min(targetMax, numTops + 1);
  }

  const candidatePool = [];
  if(tcPool.length) candidatePool.push(...tcPool.slice(0, 2));
  if(thachPool.length) candidatePool.push(...thachPool.slice(0, 2));
  if(pmPool.length) candidatePool.push(...pmPool.slice(0, 2));
  if(foamPool.length && Math.random() < 0.2) candidatePool.push(foamPool[0]);

  const shuffledCandidates = candidatePool.sort(() => Math.random() - 0.5);
  const pick = [];
  for(const k0 of shuffledCandidates){
    if(pick.length >= numTops) break;
    let k = k0;
    const gPool = ITEMS[k].g === 'tc' ? tcPool : ITEMS[k].g === 'thach' ? thachPool : ITEMS[k].g === 'pm' ? pmPool : foamPool;
    if(!has(k)){
      // Khách muốn topping này nhưng hết: có 40% tỉ lệ khách không chịu đổi món mà bỏ về luôn
      if(Math.random() < 0.40){
        so = so || k;
      } else {
        const av = gPool.filter(x => has(x) && !pick.includes(x));
        if(av.length) k = av[0];
        else {
          const allAv = unTops.filter(x => has(x) && !pick.includes(x));
          if(allAv.length) k = allAv[0];
          else { so = so || k; }
        }
      }
    }
    if(pick.includes(k) || (ITEMS[k].g === 'foam' && pick.some(x => ITEMS[x].g === 'foam')) || addSkip(k)) continue;
    pick.push(k);
  }

  const isFullTop = false;
  const preferL = (pick.length >= 3) && Math.random() < 0.55;
  const size = preferL ? 'L' : (Math.random() < lChance() ? 'L' : 'M');
  return {base,flav,tops:pick,isFullTop,cheese:false,size,so,
    sugar:lv>=2?wpick(SUGAR,[.15,.3,.35,.2]):null,ice:lv>=2?wpick(ICE,evIs('hot')?[.05,.2,.75]:[.15,.35,.5]):null};
}
const bigOrder=()=>false; /* Không bao giờ chặn khách mới khi còn chỗ trống ở quầy */
function checkSpawnSpecialRecipeGuest(i){
  if(i < 0 || i >= R.slots.length || R.slots[i] || bigOrder()) return false;
  // Không spawn trùng lặp khách thẩm định nếu trên quầy đã có 1 khách thẩm định
  if(R.slots.some(s => s && s.isSpecialRecipeGuest)) return false;

  // Giới hạn tần suất: Mỗi ca làm việc (mỗi ngày) tối đa 1 khách chuyên gia ghé quán (x2 nếu có Băng Hà Cực Quang)
  R.today = R.today || {};
  const hasBangHaBuff = !!(S && S.collection && S.collection.craftedRecipes && S.collection.craftedRecipes['rec_vutru_bangha']);
  const maxSpecialGuests = hasBangHaBuff ? 2 : 1;
  if((R.today.specialGuestCount || 0) >= maxSpecialGuests) return false;

  // Tỉ lệ xuất hiện: 1.5% (3.5% nếu có Băng Hà Cực Quang) mỗi lượt spawn khách mới (sau lượt đầu tiên)
  const specialSpawnRate = hasBangHaBuff ? 0.035 : 0.015;
  if(!R.firstDone || Math.random() > specialSpawnRate) return false;

  // Bắt buộc người chơi PHẢI ĐÃ CHẾ TẠO / MỞ KHÓA ít nhất 1 công thức độc bản trong Sổ Tay Công Thức
  const craftedKeys = (S && S.collection && S.collection.craftedRecipes) ? Object.keys(S.collection.craftedRecipes) : [];
  if(!craftedKeys.length) return false;

  const recipes = getAllRecipes();
  if(!recipes.length) return false;

  // CHỈ LẤY CÁC CÔNG THỨC ĐÃ MỞ KHÓA TRONG SỔ TAY VÀ ĐẦY ĐỦ NGUYÊN LIỆU TRONG KHO (TUYỆT ĐỐI KHÔNG FALLBACK SANG MÓN CHƯA MỞ)
  const pool = recipes.filter(r => craftedKeys.includes(r.id) && canMakeRecipe(r, true));
  if(!pool.length) return false; // Nếu các món đã mở khóa hiện đang hết nguyên liệu thì chuyên gia không đến

  const rec = rnd(pool);
  if(!rec || !rec.gameOrder) return false;

  const order = fixOrder(JSON.parse(JSON.stringify(rec.gameOrder)));
  const cups = [order];
  const lv = (typeof level === 'function') ? level() : 1;
  const huongMul = 1 + ((S.upgLv && S.upgLv.huong) || 0) * 0.003;
  const max = (70 + (lv >= 2 ? 10 : 0)) * huongMul;

  const specialTitles = [
    'Chuyên Gia Ẩm Thực Michelin ⭐',
    'Bậc Thầy Pha Chế Quốc Tế 🍵',
    'Nghệ Nhân Thưởng Trà Hoàng Gia 👑',
    'Giám Khảo Ẩm Thực Đỉnh Cao 🏆',
    'Thực Khách Sành Sỏi Đất Sài Thành 🎩',
    'Nhà Phê Bình Hương Vị 5 Sao ✨',
    'Bậc Thầy Trà Đạo Cung Đình 🪷'
  ];
  const cName = rnd(specialTitles);

  const sayLines = [
    'Chào quán, tôi đặc biệt ghé thẩm định món sáng tạo',
    'Tôi tìm đến đây nghe danh công thức kết hợp',
    'Hôm nay tôi muốn trực tiếp chấm điểm tuyệt phẩm',
    'Làm cho tôi 1 ly chuẩn công thức bí truyền'
  ];
  const endLines = [
    ' nha! Pha chuẩn vị tôi sẽ tặng ngay 1 lần 5 sao tổng và nâng hạn mức ngân hàng cho quán! ⭐🏦',
    ' nhé! Hương vị hoàn hảo sẽ đem lại danh tiếng 5 sao và bảo chứng hạn mức Tà Tưa Bank đấy! 🏆✨',
    ' nhé! Chúc quán chinh phục được thang điểm 5 sao tuyệt đối hôm nay! 👑🥤'
  ];

  R.slots[i] = {
    id: ++uid,
    isSpecialRecipeGuest: true,
    isSpecialDrinkCustomer: true,
    specialRecipe: rec,
    name: cName,
    face: '👑',
    who: 0,
    say: rnd(sayLines),
    end: rnd(endLines),
    cups,
    done: [false],
    order: cups[0],
    pat: max,
    max: max,
    wrong: 0,
    paid: 0,
    born: performance.now(),
    vip: false,
    brat: null,
    isFreeDrink: false
  };

  R.today.specialGuestCount = (R.today.specialGuestCount || 0) + 1;
  toast(`👑 Khách Thẩm Định Đặc Biệt ghé quầy order món "${rec.name}"! Phục vụ chuẩn để nhận ngay 1 LẦN 5 SAO TỔNG & TĂNG HẠN MỨC BANK! ⭐🏦`, 6000);
  renderStreet();
  sfx('bell');
  return true;
}
window.checkSpawnSpecialRecipeGuest = checkSpawnSpecialRecipeGuest;

