  ${r.petRanAway ? `
    <div style="background:#fff1f2;border:1.5px solid #ef4444;border-radius:10px;padding:6px 10px;margin:2px 0;text-align:left;color:#991b1b;font-size:0.84rem;line-height:1.3;">
      😿 <b>Thú cưng ${esc(r.petRanAway)} đã buồn bã bỏ nhà đi mất!</b>
    </div>
  ` : ''}
  ${r.petDangerNotice ? `
    <div style="background:#fff7ed;border:1.5px solid #f97316;border-radius:10px;padding:6px 10px;margin:2px 0;text-align:left;color:#9a3412;font-size:0.84rem;line-height:1.3;">
      ⚠️ <b>Báo động: Bé ${esc(r.petDangerNotice)} có 1 chỉ số chạm đáy 0%!</b>
    </div>
  ` : ''}
  ${(bankruptBranches.length || bankruptFranchises.length) ? `
    <div style="background:#fff1f2;border:1.5px solid #f43f5e;border-radius:10px;padding:6px 10px;margin:2px 0;text-align:left;color:#9f1239;font-size:0.84rem;line-height:1.3;">
      💥 <b>${bankruptBranches.length + bankruptFranchises.length} chi nhánh / nhượng quyền vỡ nợ phá sản${peakHoardCash >= endDayCashTiers.lowCap ? ' do khủng hoảng tích trữ tiền mặt trong két' : (isHoardCheatEndDay ? ` do Ngưỡng Phán Quyết Chống Hack (${verdictEndDay.status || 'CHEAT'})` : ' do doanh thu thấp')}!</b>
    </div>
  ` : ''}
  ${sulkingBranches.length ? `
    <div style="background:#fff1f2;border:1.5px solid #fda4af;border-radius:10px;padding:6px 10px;margin:2px 0;text-align:left;color:#9f1239;font-size:0.84rem;line-height:1.3;">
      💔 <b>${sulkingBranches.length} Lích Đờ nghỉ việc${peakHoardCash >= endDayCashTiers.midCap ? ' do hoảng sợ khủng hoảng an ninh két tiền' : (isHoardCheatEndDay && cheatTierEndDay >= 2 ? ` do Ngưỡng Phán Quyết Chống Hack (${verdictEndDay.status || 'CHEAT'})` : ' do video bị flop')} (Chi nhánh tạm đóng)!</b>
    </div>
  ` : ''}
  ${(typeof hoardQuitStaff !== 'undefined' && hoardQuitStaff.length) ? `
    <div style="background:#fef2f2;border:1.5px solid #dc2626;border-radius:10px;padding:6px 10px;margin:2px 0;text-align:left;color:#991b1b;font-size:0.84rem;line-height:1.35;">
      🏃‍♂️💨 <b>${hoardQuitStaff.length} nhân viên quán chính nghỉ việc do ${peakHoardCash >= endDayCashTiers.lowCap ? 'hoảng sợ cướp két' : `Ngưỡng Phán Quyết Chống Hack (${verdictEndDay.status || 'CHEAT'})`} (${hoardQuitStaff.map(n => esc(n)).join(', ')})!</b>
    </div>
  ` : ''}
  ${(r.hoardStockLostQty && r.hoardStockLostQty > 0) ? `
    <div style="background:#fff1f2;border:1.5px solid #e11d48;border-radius:10px;padding:6px 10px;margin:2px 0;text-align:left;color:#9f1239;font-size:0.84rem;line-height:1.35;">
      📦🔥 <b>Kho hàng bị cướp / tịch thu mất ${r.hoardStockLostQty.toLocaleString('vi-VN')} phần cốt trà, hương vị, topping &amp; nguyên liệu (trị giá ~${fmt(r.hoardStockLostVal || 0)}) do ${peakHoardCash >= endDayCashTiers.lowCap ? 'két tích trữ tiền tỷ' : `Ngưỡng Phán Quyết Chống Hack (${verdictEndDay.status || 'CHEAT'})`}!</b>
    </div>
  ` : ''}

  ${(() => {
    try {
      return (typeof renderFnbFinancialReport === 'function') ? renderFnbFinancialReport(fnbDayData, { compact: true }) : '';
    } catch(e) {
      console.error('Lỗi renderFnbFinancialReport:', e);
      return '';
    }
  })()}

  ${(r.franchiseRev || r.franchiseTotalIncome) ? `
    <div style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1.5px solid #3b82f6;border-radius:12px;padding:8px 12px;margin:4px 0;text-align:left;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
        <b style="color:#1d4ed8;font-size:0.9rem;">🏢 HỆ THỐNG NHƯỢNG QUYỀN (${(S.franchise && Array.isArray(S.franchise.partners)) ? S.franchise.partners.filter(p => p && !p.closed).length : 0} CƠ SỞ)</b>
        <span style="font-weight:800;color:#2563eb;font-size:0.95rem;">+${fmt(r.franchiseTotalIncome || 0)}</span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;font-size:0.8rem;color:#1e40af;">
        <div>👑 Phí bản quyền (Royalty): <b style="color:#1d4ed8;">+${fmt(r.franchiseRoyalty || 0)}</b></div>
        <div>📦 Lãi sỉ nguyên liệu: <b style="color:#059669;">+${fmt(r.franchiseSupplyProfit || 0)}</b></div>
        <div>💻 Phí POS &amp; Bản quyền: <b style="color:#4f46e5;">+${fmt(r.franchisePosFee || 0)}</b></div>
        <div>👥 Nhân sự toàn chuỗi: <b>${r.franchiseStaff || 0} NV</b></div>
      </div>
    </div>
  ` : ''}

  <details class="day-details-box" id="dayDetailAccordion">
    <summary>
      <span>📋 Chi tiết các khoản thu chi &amp; lợi nhuận</span>
      <span class="dd-badge-closed">▼ Xem chi tiết</span>
      <span class="dd-badge-open">▲ Thu gọn</span>
    </summary>
    <div class="day-details-content">
      <div class="ledger" style="margin:2px 0 0;">
        ${(r.lobbyRev > 0) ? `
          <div><span>${ico('price')} Doanh thu bán lẻ tại quầy${r.dogBonus ? ` <b style="color:#ea580c;">(🐕 +${fmt(r.dogBonus)} từ Shiba)</b>` : ''}${r.catBonus ? ` <b style="color:#f59e0b;">(🐱 +${fmt(r.catBonus)} từ Mèo)</b>` : ''}</span><span class="revc">+${fmt(Math.max(0, rev - (r.lobbyRev || 0)))}</span></div>
          <div><span>🏮 Doanh thu Sảnh Tiệm (bàn ghế khách ngồi +30%)</span><span class="revc">+${fmt(r.lobbyRev)}</span></div>
          ${r.lobbyTips ? `<div><span>✨ Tiền bo khách ngồi sảnh tiệm</span><span class="pos">+${fmt(r.lobbyTips)}</span></div>` : ''}
        ` : `
          <div><span>${ico('price')} Doanh thu quán chính${r.dogBonus ? ` <b style="color:#ea580c;">(🐕 +${fmt(r.dogBonus)} từ Shiba)</b>` : ''}${r.catBonus ? ` <b style="color:#f59e0b;">(🐱 +${fmt(r.catBonus)} từ Mèo)</b>` : ''}</span><span class="revc">+${fmt(rev)}</span></div>
        `}
        ${r.branchRev ? `<div><span>🏢 Doanh thu chi nhánh trực thuộc${r.branchAdBonus ? ` <b style="color:#059669;">(📢 +${fmt(r.branchAdBonus)} từ Ads)</b>` : ''}${r.branchPetBonus ? ` <b style="color:#f59e0b;">(🐱 +${fmt(r.branchPetBonus)} từ Mèo)</b>` : ''}</span><span class="revc">+${fmt(r.branchRev)}</span></div>` : ''}
        ${r.branchRent ? `<div><span class="wl">🏢 Thuê mặt bằng chi nhánh</span><span class="neg">−${fmt(r.branchRent)}</span></div>` : (S && S.realEstate && S.realEstate.branches && Object.values(S.realEstate.branches).some(Boolean)) ? `<div><span class="wl" style="color:#059669;">🏰 Mặt bằng chi nhánh</span><span class="pos" style="color:#059669;font-weight:700;">0đ (Đã mua đứt mặt bằng)</span></div>` : ''}
        ${r.branchWage ? `<div><span class="wl">🏢 Lương NV chi nhánh (Lích đờ phát)</span><span class="neg">−${fmt(r.branchWage)}</span></div>` : ''}
        ${r.branchIng ? `<div><span class="wl">🏢 Tiền nhập NL chi nhánh</span><span class="neg">−${fmt(r.branchIng)}</span></div>` : ''}
        ${r.franchiseRev ? `<div><span>🤝 Doanh thu toàn chuỗi nhượng quyền (${r.franchiseStaff || 0} NV)${r.franchiseAdBonus ? ` <b style="color:#059669;">(📢 +${fmt(r.franchiseAdBonus)} từ Ads)</b>` : ''}${r.franchisePetBonus ? ` <b style="color:#f59e0b;">(🐱 +${fmt(r.franchisePetBonus)} từ Mèo)</b>` : ''}</span><span class="revc">+${fmt(r.franchiseRev)}</span></div>` : ''}
        ${r.franchiseRoyalty ? `<div><span>🤝 Phí bản quyền Royalty nhượng quyền thu về</span><span class="pos">+${fmt(r.franchiseRoyalty)}</span></div>` : ''}
        ${r.franchiseSupplyProfit ? `<div><span>📦 Lợi nhuận bán sỉ nguyên liệu độc quyền (Supply Chain)</span><span class="pos">+${fmt(r.franchiseSupplyProfit)}</span></div>` : ''}
        ${r.franchisePosFee ? `<div><span>💻 Phí phần mềm POS &amp; Bản quyền công thức</span><span class="pos">+${fmt(r.franchisePosFee)}</span></div>` : ''}
        ${r.franchiseTotalIncome ? `<div style="background:#ecfdf5;border-radius:8px;padding:3px 8px;margin:2px 0;font-weight:800;color:#047857;"><span>💎 TỔNG THU NHƯỢNG QUYỀN ĐỔ VỀ KÉT</span><span class="pos">+${fmt(r.franchiseTotalIncome)}</span></div>` : ''}
        ${bankruptBranches.length ? `<div><span class="wl">💥 Chi nhánh trực thuộc vỡ nợ</span><span class="neg">${bankruptBranches.length} cơ sở phá sản</span></div>` : ''}
        ${bankruptFranchises.length ? `<div><span class="wl">💥 Đối tác nhượng quyền vỡ nợ</span><span class="neg">${bankruptFranchises.length} cơ sở phá sản</span></div>` : ''}
        ${sulkingBranches.length ? `<div><span class="wl">💔 Chi nhánh đóng cửa</span><span class="neg">${sulkingBranches.length} chi nhánh mất Lích Đờ</span></div>` : ''}
        ${r.partyPayout ? `<div><span class="wl">🎉 Thưởng hợp đồng tiệc</span><span class="revc">+${fmt(r.partyPayout)}</span></div>` : ''}
        ${r.partyPenalty ? `<div><span class="wl">⚠️ Phạt giao thiếu đơn tiệc</span><span class="neg">−${fmt(r.partyPenalty)}</span></div>` : ''}
        ${ingTot > 0 ? `<div><span class="wl">📦 Tiền nguyên liệu &amp; bao bì thực chi trong ca</span><span class="neg">−${fmt(ingTot)}</span></div>` : ''}
        ${eqTot?`<div><span class="wl">🛠️ Nâng cấp & mua sắm trang bị</span><span class="neg">−${fmt(eqTot)}</span></div>`:''}
        ${(S && S.realEstate && (S.realEstate.main || ownedBranchCount >= 4)) ? `
          <div><span class="wl" style="color:#059669;">🏰 Mặt bằng &amp; Điện nước</span><span class="pos" style="color:#059669;font-weight:700;">0đ (Đã mua đứt BĐS)</span></div>
        ` : `
          ${r.rent?`<div><span class="wl">🏠 Mặt bằng</span><span class="neg">−${fmt(r.rent)}</span></div>`:''}
          ${r.util?`<div><span class="wl">⚡ Điện nước</span><span class="neg">−${fmt(r.util)}</span></div>`:''}
        `}
        ${r.fee?`<div><span class="wl">🛵 Phí sàn app online (${CFG.commission}%)</span><span class="neg">−${fmt(r.fee)}</span></div>`:''}
        ${r.tax?`<div><span class="wl">🏛️ Thuế doanh thu</span><span class="neg">−${fmt(r.tax)}</span></div>`:''}
        ${r.ga?`<div><span class="wl">🏢 G&A Văn phòng chuỗi</span><span class="neg">−${fmt(r.ga)}</span></div>`:''}
        ${r.franchiseTax?`<div><span class="wl">🏛️ Thuế thu nhập chuỗi nhượng quyền (5%)</span><span class="neg">−${fmt(r.franchiseTax)}</span></div>`:''}
        ${r.franchiseSupport?`<div><span class="wl">🤝 Hỗ trợ chuỗi nhượng quyền</span><span class="neg">−${fmt(r.franchiseSupport)}</span></div>`:''}
        ${r.cloud?`<div><span class="wl">☁️ Hạ tầng Cloud POS chuỗi</span><span class="neg">−${fmt(r.cloud)}</span></div>`:''}
        ${(r.wage - (r.ot || 0) - (r.wageBonus || 0)) > 0 ? `<div><span class="wl">${ico('trophy')} Lương cứng nhân viên</span><span class="neg">−${fmt(r.wage - (r.ot || 0) - (r.wageBonus || 0))}</span></div>` : ''}
        ${r.wageBonus ? `<div><span class="wl">🌟 Thưởng KPI sản lượng quy mô</span><span class="neg">−${fmt(r.wageBonus)}</span></div>` : ''}
        ${r.ot?`<div><span class="wl">${ico('clock')} Tăng ca nhân viên pha chế</span><span class="neg">−${fmt(r.ot)}</span></div>`:''}${r.bad?`<div><span class="wl">${ico('warn')} Sự cố mất tiền (phạt vu khống...)</span><span class="neg">−${fmt(r.bad)}</span></div>`:''}
        ${r.loanInt?`<div><span class="wl">${ico('money')} Trả nợ (lãi ${fmt(r.loanInt)})</span><span class="neg">−${fmt(r.loanOut+r.loanInt)}</span></div>`:''}
        ${r.guard?`<div><span class="wl">${ico('people')} Bảo vệ thu lại</span><span class="pos">+${fmt(r.guard)}</span></div>`:''}
        ${r.staffTip?`<div><span class="wl">${ico('trophy')} Tip nhân viên nhận (20% tiền bo)</span><span style="color:#d97706;font-weight:700;">+${fmt(r.staffTip)} (NV giữ)</span></div>`:''}
        ${r.gzStolen?`<div><span class="wl">🤫 Gen Z đá bill (thiếu giám sát)</span><span class="neg">−${fmt(r.gzStolen)}</span></div>`:''}
        ${r.buyerStolen?`<div><span class="wl">🛵 Đi chợ khai gian (${r.buyerTrips||1} chuyến)</span><span class="neg">−${fmt(r.buyerStolen)}</span></div>`:''}
        ${gzQuitNotice?`<div><span class="wl">💔 Nhân viên Gen Z</span><span class="neg">Nghỉ việc do dỗi cả ngày không được dỗ (cần thuê lại 1tr)</span></div>`:''}
        ${r.svPawnedLoss?`<div><span class="wl">💸 Chuộc đồ SV cầm (${fmt(r.svPawnedLoss)})</span><span class="neg">−${fmt(r.svPawnedLoss)}</span></div>`:''}
        ${(r.fakeLoss || (T && T.fakeLoss))?`<div><span class="wl">💸 Khách đưa tiền giả (${(r.fakeCount || (T && T.fakeCount))||1} đơn)</span><span class="neg">−${fmt(r.fakeLoss || (T && T.fakeLoss))}</span></div>`:''}
        ${(r.snatchLoss || (T && T.snatchLoss))?`<div><span class="wl">🚨 Trộm giật / móc két quầy (${(r.snatchCount || (T && T.snatchCount))||1} lần)</span><span class="neg">−${fmt(r.snatchLoss || (T && T.snatchLoss))}</span></div>`:''}
        ${r.spoil&&r.spoil.n?`<div><span class="wl">🥤 ${r.spoil.n} ly hỏng</span><span class="neg">−${fmt(r.spoil.v)} (nằm trong nguyên liệu)</span></div>`:''}
        ${wv?`<div><span class="wl">${ico('trash')} ${r.hoardStockLostQty ? 'Hủy hết hạn &amp; Mất kho' : 'Hủy hết hạn'}: ${waste.map(x=>(ITEMS[x.k]?ITEMS[x.k].s:x.k)+' '+x.q).join(', ')}</span><span class="neg">−${fmt(wv)} (nằm trong nguyên liệu)</span></div>`:''}
        <div class="tot"><span>${ico('chartup')} Lãi</span><span class="${profit<0?'neg':'pos'}">${profit<0?'−':'+'}${fmt(Math.abs(profit))}</span></div>
        <div class="tot"><span>${ico('money')} Két</span><span>${fmt(S.money)}</span></div>
        ${(() => {
          const startCashVal = Number(r.startCash != null ? r.startCash : (S.money - profit + (r.loanOut || 0)));
          const rawCashDiff = S.money - (startCashVal + profit - (Number(r.loanOut) || 0));
          const hasExtraCash = Math.abs(rawCashDiff) > 1000;
          return `<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:8px 10px;margin:8px 0 2px;font-size:0.82rem;line-height:1.45;text-align:left;color:#334155;">
            <div style="font-weight:800;color:#0f172a;margin-bottom:4px;display:flex;justify-content:space-between;align-items:center;">
              <span>🏦 Đối Soát Két Tiền &amp; Dòng Tiền:</span>
              <span style="color:#059669;font-weight:800;">Khớp 100% ✨</span>
            </div>
            <div>• Két đầu ngày: <b>${fmt(startCashVal)}</b></div>
            <div>• Lợi nhuận ròng P&amp;L hôm nay: <b style="color:${profit>=0?'#15803d':'#dc2626'};">${profit>=0?'+':'-'}${fmt(Math.abs(profit))}</b></div>
            ${hasExtraCash ? `<div>• Biến động dòng tiền ngoài ca (Cọc tiệc / Sự kiện / Nông trại): <b style="color:${rawCashDiff>0?'#059669':'#dc2626'};">${rawCashDiff>0?'+':'-'}${fmt(Math.abs(rawCashDiff))}</b></div>` : ''}
            ${r.loanOut ? `<div>• Trả nợ gốc vay ngân hàng: <b style="color:#b91c1c;">-${fmt(r.loanOut)}</b></div>` : ''}
            <div>• Két cuối ngày kết toán: <b style="color:#1d4ed8;font-size:0.92rem;">${fmt(S.money)}</b></div>
            ${hasExtraCash ? `<div style="font-size:0.75rem;color:#047857;margin-top:3px;line-height:1.35;background:#ecfdf5;padding:4px 6px;border-radius:6px;border:1px solid #a7f3d0;">✨ Đã đối soát &amp; cân đối hoàn tất dòng tiền giữa sổ cái P&amp;L và số dư két tiền mặt thực tế.</div>` : ''}
          </div>`;
        })()}
      </div>
      ${(() => {
        const topSales = (typeof getBestSellers === 'function') ? getBestSellers(r.sales) : [];
        return topSales.length ? `<div style="background:#fff7ed;border:1.5px solid #fed7aa;border-radius:12px;padding:8px 10px;margin:8px 0 2px;font-size:0.86rem;text-align:left;">
          <div style="font-weight:800;color:#c2410c;margin-bottom:4px;">🔥 Top 3 Best Seller Ca Này:</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            ${topSales.map((x, i) => `<span style="background:#ffedd5;color:#9a3412;padding:2px 8px;border-radius:8px;font-weight:700;">${['🥇','🥈','🥉'][i]} ${x.type === 'top' ? '🧋 ' : x.type === 'flav' ? '🍑 ' : '🍵 '}${x.name} (${x.qty} phần)</span>`).join('')}
          </div>
        </div>` : '';
      })()}
    </div>
  </details>

  ${!broke&&S.ev&&EVS[S.ev.id]?`<div class="day-forecast-strip">${ico(EVS[S.ev.id].ic)} Ngày mai: <b>${EVS[S.ev.id].n}</b>. ${evText(S.ev)}</div>`:''}
  ${(nextLv&&LV_TXT[nextLv])?`<div class="day-forecast-strip warn">⚠️ Từ ngày ${S.day}: ${LV_TXT[nextLv].toLowerCase()}</div>`:''}
  ${justOnline?`<div class="day-forecast-strip info">📱 Mở đơn online Soppi!</div>`:''}

  <div class="day-action-row">
    ${broke ? `<button class="big" id="go" style="width:100%;min-height:46px;">Mở quán mới</button>` : `
      <button type="button" class="sbtn" id="seeSum" style="flex:1;">📊 Tổng kết</button>
      <button type="button" class="big" id="go" style="flex:1.8;margin:0;">Ngày ${S.day} ➜</button>
    `}
  </div>`;
  $('modal').hidden=false;$('go').focus();
  const dayDetAcc = $('dayDetailAccordion');
  if(dayDetAcc){
    dayDetAcc.ontoggle = () => {
      if(dayDetAcc.open){
        setTimeout(() => {
          dayDetAcc.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 60);
      }
    };
  }

  const close=tab=>{
    if($('card')) $('card').className = 'card';
    $('modal').hidden=true;
    if(broke){const n=S.shopName;S=fresh();S.shopName=n;save()}
    R.tab=tab;R.sumMode='day';R.sumIdx=null;
    renderPrep();
    window.scrollTo(0,0);
    if(!broke){
      checkEquipBreakdown(()=>{
        if((S.staffSalesDays || 0) >= 7 && STAFF.some(u => S.hired && S.hired[u.id])){
          if(typeof isStaffActive === 'function' && isStaffActive('staffButler')){
            staffButlerAutoPayMaxKpi();
          } else {
            setTimeout(() => openStaffKpiModal(true), 350);
          }
        }
        setTimeout(prepChecks, 450);
      });
    }
  };
  $('go').onclick=()=>close('kho');if($('seeSum'))$('seeSum').onclick=()=>close('tongket');
  };
    const gRep=T.gRunN||T.gEsc;
    if(gRep){ask(`<div class="pbig">${ico('people')}</div><h2>Bảo vệ báo cáo</h2><div class="ledger">
      ${T.gRunN?`<div><span>${T.gRunN} khách quỵt tiền bị tóm, lấy lại</span><span class="pos">+${fmt(gRun)}</span></div>`:''}
      ${T.gEsc?`<div><span class="wl">Để xổng ${T.gEsc} khách</span><span class="wl">0đ</span></div>`:''}
      <div class="tot"><span>Tổng thu lại</span><span class="pos">+${fmt(gRun)}</span></div></div>`,[['Xem tổng kết ngày',showCard,1]])}else showCard();
  } catch(err) {
    console.error('Lỗi tính toán finishEndDay, kích hoạt fallback hiển thị:', err);
    try {
      if(S && !broke && !dayIncremented) {
        S.day++;
        S.cur = newRec(S.day);
        dayIncremented = true;
        save();
      }
      if($('modal')) {
        $('modal').hidden = false;
        const endedDay = (r && r.day) ? r.day : (dayIncremented ? S.day - 1 : (S ? S.day : 1));
        const nextDay = S ? S.day : (endedDay + 1);
        $('card').innerHTML = `<h2>Hết ngày ${endedDay}</h2><p>Đã hoàn thành ca bán và lưu tiến trình!</p><button class="big" id="go">Ngày ${nextDay} ➜</button>`;
        $('go').onclick = () => {
          $('modal').hidden = true;
          R.tab = 'kho';
          R.sumMode = 'day';
          R.sumIdx = null;
          renderPrep();
          window.scrollTo(0, 0);
        };
      }
    } catch(err2) {
      console.error('Lỗi fallback showCard:', err2);
      try {
        if(S && !broke && !dayIncremented) {
          S.day++;
          S.cur = newRec(S.day);
          dayIncremented = true;
          save();
        }
      } catch(e3){}
      if($('modal')) $('modal').hidden = false;
      if($('card')) {
        const endedDay = (r && r.day) ? r.day : (dayIncremented ? S.day - 1 : (S ? S.day : 1));
        const nextDay = S ? S.day : (endedDay + 1);
        $('card').innerHTML = `<h2>Hết ngày ${endedDay}</h2><p>Đã ghi nhận ca bán.</p><button class="big" id="go">Ngày ${nextDay} ➜</button>`;
        $('go').onclick = () => {
          $('modal').hidden = true;
          R.tab = 'kho';
          renderPrep();
          window.scrollTo(0, 0);
        };
      }
    }
  } finally {
    finishEndDay._running = false;
  }
}

/* =========================================================================
 * 📊 BÁO CÁO PHÂN TÍCH LỖ LÃI P&L CHUẨN F&B (FINANCIAL STATEMENT)
 * Thước đo F&B thực tế: COGS 28-32%, Labor 15-20%, Điểm hòa vốn Break-Even
 * ========================================================================= */
function renderFnbFinancialReport(d, opts = {}){
  if(!d) return '';
  const rev = Math.max(0, d.rev || 0);
  const salesTot = Math.max(0, d.salesTot || 0);
  const ingTot = Math.max(0, d.ingTot || 0);
  const wageTot = Math.max(0, d.wageTot || 0);
  const rentTot = Math.max(0, d.rentTot || 0);
  const utilTot = Math.max(0, d.utilTot || 0);
  const fixedCost = rentTot + utilTot + wageTot;
  const eqTot = Math.max(0, d.eqTot || 0);
  const feeTot = Math.max(0, d.feeTot || 0);
  const taxTot = Math.max(0, d.taxTot || 0);
  const gaTot = Math.max(0, d.gaTot || 0);
  const franchiseIncomeTax = Math.max(0, d.franchiseIncomeTax || d.franchiseTaxTot || d.franchiseTax || 0);
  const loanTot = Math.max(0, d.loanTot || 0);
  const badTot = Math.max(0, d.badTot || 0);

  // Phân biệt chi phí vận hành (OPEX) và chi phí mua sắm tài sản cố định (CAPEX)
  const opexOther = feeTot + taxTot + loanTot + badTot + gaTot + franchiseIncomeTax;
  const capex = eqTot; // Đầu tư máy móc thiết bị & chi nhánh
  const opCost = ingTot + wageTot + rentTot + utilTot + opexOther;
  const totalCost = opCost + capex;
  const profit = d.profit != null ? d.profit : (rev - totalCost);
  const served = Math.max(0, d.served || 0);
  const periodLabel = d.periodLabel || 'Hôm nay';
  const isCompact = !!opts.compact;

  const vn = n => fmt(n);

  // Tỷ lệ % trên doanh thu toàn chuỗi (dùng cho thanh phân bổ cơ cấu tổng)
  const cogsRevPct = rev > 0 ? (ingTot / rev) * 100 : 0;
  const laborRevPct = rev > 0 ? (wageTot / rev) * 100 : 0;
  const rentPct = rev > 0 ? ((rentTot + utilTot) / rev) * 100 : 0;
  const opexOtherPct = rev > 0 ? (opexOther / rev) * 100 : 0;
  const capexPct = rev > 0 ? (capex / rev) * 100 : 0;
  const netPct = rev > 0 ? (profit / rev) * 100 : 0;

  // Đánh giá tỷ lệ F&B chuẩn trên doanh thu bán lẻ trực tiếp (tránh bị pha loãng bởi doanh thu nhượng quyền)
  const cogsBase = (d.retailRevTot && d.retailRevTot > 0) ? d.retailRevTot : (salesTot > 0 ? salesTot : rev);
  const cogsPct = cogsBase > 0 ? (ingTot / cogsBase) * 100 : 0;
  const laborPct = cogsBase > 0 ? (wageTot / cogsBase) * 100 : 0;

  // Thanh phân bổ chi phí chuẩn F&B (Stacked Bar)
  const barBase = Math.max(rev, opCost + Math.min(capex, rev * 0.4), 1);
  const cogsBarW = Math.min(100, Math.max(ingTot > 0 ? 3 : 0, (ingTot / barBase) * 100)).toFixed(1);
  const laborBarW = Math.min(100, Math.max(wageTot > 0 ? 3 : 0, (wageTot / barBase) * 100)).toFixed(1);
  const rentBarW = Math.min(100, Math.max((rentTot + utilTot) > 0 ? 3 : 0, ((rentTot + utilTot) / barBase) * 100)).toFixed(1);
  const otherBarW = Math.min(100, Math.max(opexOther > 0 ? 3 : 0, (opexOther / barBase) * 100)).toFixed(1);
  const capexBarW = capex > 0 ? Math.min(30, Math.max(3, (capex / barBase) * 100)).toFixed(1) : 0;
  const profitBarW = profit > 0 ? Math.min(100, Math.max(3, (profit / barBase) * 100)).toFixed(1) : 0;

  // Điểm hòa vốn (Break-Even Point)
  const asp = served > 0 ? Math.round(salesTot / served) : 32000;
  const cogsPerCup = served > 0 ? Math.round(ingTot / served) : 9500;
  const cm = Math.max(5000, asp - cogsPerCup); // Biên đóng góp trung bình mỗi ly
  const nonRetailIncome = Math.max(0, (d.franchiseTotalIncome != null ? d.franchiseTotalIncome : (d.franchiseIncome || 0)) + Math.max(0, d.branchProfitTot || d.branchNet || 0));
  const netRetailFixedCost = Math.max(0, fixedCost - nonRetailIncome);
  const bepCups = cm > 0 ? Math.ceil(netRetailFixedCost / cm) : 0;

  // 1. Đánh giá COGS (Giá vốn nguyên liệu)
  let cogsStatus = 'good';
  let cogsMsg = '🟢 Chuẩn vàng F&B (28–32%)';
  if(cogsPct > 38){
    cogsStatus = 'danger';
    cogsMsg = '🔴 Quá cao! Lãng phí/NL đắt';
  } else if(cogsPct > 32){
    cogsStatus = 'warn';
    cogsMsg = '🟡 Hơi cao (chuẩn 28–32%)';
  } else if(rev === 0 || ingTot === 0){
    cogsStatus = 'good';
    cogsMsg = '⚪ Chưa tốn nguyên liệu';
  } else if(cogsPct < 25){
    cogsStatus = 'good';
    cogsMsg = '🟢 Tối ưu xuất sắc (<28%)';
  }

  // 2. Đánh giá Labor Cost (Chi phí nhân sự)
  let laborStatus = 'good';
  let laborMsg = '🟢 Tối ưu & năng suất (15–20%)';
  if(laborPct > 28){
    laborStatus = 'danger';
    laborMsg = '🔴 Quá tải quỹ lương (>28%)';
  } else if(laborPct > 20){
    laborStatus = 'warn';
    laborMsg = '🟡 Hơi cao (chuẩn 15–20%)';
  } else if(rev === 0 || wageTot === 0){
    laborStatus = 'good';
    laborMsg = '⚪ Tự làm, 0đ quỹ lương';
  } else if(laborPct < 15){
    laborStatus = 'good';
    laborMsg = '🟢 Tự vận hành / Tiết kiệm';
  }

  // 3. Đánh giá Điểm hòa vốn (Break-Even)
  let bepStatus = (profit >= 0 || served >= bepCups) ? 'good' : (served >= bepCups * 0.75 ? 'warn' : 'danger');
  let bepMsg = (profit >= 0 || served >= bepCups)
    ? `🟢 Vượt mốc (+${Math.max(0, served - bepCups)} ly, chuỗi đang lãi ròng ✨)`
    : `🔴 Chưa hòa vốn bán lẻ (Thiếu ${Math.max(1, bepCups - served)} ly để đủ chi phí)`;

  // Chẩn đoán chuyên sâu từ chuyên gia F&B
  let diagClass = 'healthy';
  let diagTitle = 'Cơ cấu tài chính khoẻ mạnh! ✨';
  let diagBody = (nonRetailIncome > 0 && profit >= 0)
    ? `Chuỗi vận hành xuất sắc! Thu nhập từ chi nhánh & nhượng quyền (${fmt(nonRetailIncome)}) kết hợp cùng quầy bán lẻ đã bù đắp toàn bộ chi phí và sinh lời ròng +${fmt(profit)}.`
    : 'Nguyên liệu và chi phí nhân sự nằm trong tỷ lệ vàng F&B, quán kiểm soát dòng tiền xuất sắc.';

  if(profit < 0){
    if(capex > rev * 0.5){
      diagClass = 'warning';
      diagTitle = 'Đầu tư trang bị & mở rộng (CAPEX)! 🛠️';
      diagBody = `Hôm nay phát sinh khoản mua sắm trang thiết bị/chi nhánh lớn (<b>${fmt(capex)}</b>). Đây là chi phí đầu tư tài sản sinh lời lâu dài, không phải lỗ do quán vận hành kém.`;
    } else {
      diagClass = 'danger';
      diagTitle = 'Cảnh báo rủi ro thua lỗ! 🚨';
      if(rentPct > 25){
        diagBody = `Tiền mặt bằng & điện nước chiếm tới <b>${rentPct.toFixed(1)}%</b> doanh thu (quá ngưỡng 15%). Quán cần bán tối thiểu <b>${bepCups} ly</b> để gánh chi phí cố định!`;
      } else if(laborPct > 28){
        diagBody = `Quỹ lương nhân sự chiếm <b>${laborPct.toFixed(1)}%</b> doanh thu (chuẩn 15–20%). Lương nhân viên quá cao so với doanh số, cần gia tăng số đơn bán!`;
      } else if(cogsPct > 36){
        diagBody = `Giá vốn nguyên liệu chiếm <b>${cogsPct.toFixed(1)}%</b> (chuẩn 28–32%). Nguyên liệu quá đắt hoặc hao hụt nhiều, cần kiểm soát ly hỏng & định lượng.`;
      } else if(served >= bepCups){
        diagBody = `Sản lượng bán đã vượt điểm hòa vốn (+${served - bepCups} ly), nhưng chi phí thuế/phí/thất thoát hôm nay (${fmt(opexOther)}) quá cao khiến kết quả bị âm.`;
      } else {
        diagBody = `Tổng chi phí (${fmt(totalCost)}) vượt doanh thu (${fmt(rev)}). Quán thiếu <b>${Math.max(1, bepCups - served)} ly</b> để đạt điểm hòa vốn!`;
      }
    }
  } else if(bepCups > 0 && served < bepCups){
    diagClass = 'warning';
    diagTitle = 'Chưa đạt sản lượng hòa vốn bán lẻ! ⚠️';
    diagBody = `Sản lượng bán tại quầy (<b>${served} ly</b>) chưa đủ gánh chi phí cố định (${bepCups} ly). Quán có lãi ròng nhờ doanh thu chi nhánh hoặc tiền thưởng/tip, hãy đẩy mạnh đơn bán lẻ để kinh doanh bền vững hơn!`;
  } else if(cogsPct > 33 || laborPct > 22 || rentPct > 18){
    diagClass = 'warning';
    diagTitle = 'Lưu ý tối ưu biên lợi nhuận! 💡';
    const issues = [];
    if(cogsPct > 32) issues.push(`COGS nguyên liệu (${cogsPct.toFixed(1)}%)`);
    if(laborPct > 20) issues.push(`Quỹ lương (${laborPct.toFixed(1)}%)`);
    if(rentPct > 15) issues.push(`Mặt bằng (${rentPct.toFixed(1)}%)`);
    diagBody = `Quán đang có lãi nhưng ${issues.join(' và ')} đang cao hơn chuẩn F&B. Tối ưu khoản này sẽ giúp két tiền tăng trưởng vượt bậc!`;
  }

  const opexStr = opexOtherPct > 100 ? fmt(opexOther) : opexOtherPct.toFixed(1) + '%';
  const capexStr = capexPct > 100 ? fmt(capex) : capexPct.toFixed(1) + '%';
  const netStr = (profit >= 0 ? '+' : '−') + (Math.abs(netPct) > 100 ? fmt(Math.abs(profit)) : Math.abs(netPct).toFixed(1) + '%');

  return `
  <div class="fnb-report-card${isCompact ? ' compact' : ''}">
    ${isCompact ? `
    <!-- Dải 4 chỉ số Thu Chi Lãi Két thay thế hộp tổng tiền cũ -->
    <div class="fnb-cash-strip">
      <div class="cs-item inc"><span>📈 Thu</span><b>+${fmt(rev)}</b></div>
      <div class="cs-item exp"><span>📉 Chi</span><b>−${fmt(totalCost)}</b></div>
      <div class="cs-item ${profit >= 0 ? 'prof' : 'loss'}">
        <span>${profit >= 0 ? '💰 Lãi' : '💸 Lỗ'}</span>
        <b>${profit >= 0 ? '+' : '−'}${fmt(Math.abs(profit))}</b>
      </div>
      <div class="cs-item bank"><span>🏦 Két</span><b>${fmt(S.money)}</b></div>
    </div>` : `
    <div class="fnb-head">
      <div class="fnb-title">
        <span class="fnb-badge">📊 Báo Cáo P&amp;L Chuẩn F&amp;B</span>
        <h3>Phân Tích Lỗ Lãi &amp; Điểm Hòa Vốn</h3>
      </div>
      <span class="fnb-period">${periodLabel}</span>
    </div>`}

    <!-- Thanh phân bổ cơ cấu chi phí chuẩn F&B -->
    <div class="fnb-bar-wrap">
      <div class="fnb-bar-title">
        <span>Cơ cấu doanh thu (${fmt(rev)})</span>
        <b style="color:${profit >= 0 ? '#16a34a' : '#dc2626'}">${profit >= 0 ? 'Lãi: +' : 'Lỗ: −'}${fmt(Math.abs(profit))} (${netStr})</b>
      </div>
      <div class="fnb-stacked-bar">
        <div class="fnb-seg cogs" style="width:${cogsBarW}%" title="COGS Nguyên liệu: ${cogsRevPct.toFixed(1)}% (${fmt(ingTot)})"></div>
        <div class="fnb-seg labor" style="width:${laborBarW}%" title="Lương nhân sự: ${laborRevPct.toFixed(1)}% (${fmt(wageTot)})"></div>
        <div class="fnb-seg rent" style="width:${rentBarW}%" title="Mặt bằng &amp; Điện nước: ${rentPct.toFixed(1)}% (${fmt(rentTot + utilTot)})"></div>
        <div class="fnb-seg other" style="width:${otherBarW}%" title="G&amp;A chuỗi, Thuế NQ, Thuế, Phí app &amp; Khác: ${opexStr} (${fmt(opexOther)})"></div>
        ${capex > 0 ? `<div class="fnb-seg" style="width:${capexBarW}%;background:#8b5cf6;" title="Đầu tư thiết bị &amp; Cơ sở (CAPEX): ${capexStr} (${fmt(capex)})"></div>` : ''}
        ${profit > 0 ? `<div class="fnb-seg profit" style="width:${profitBarW}%" title="Lãi ròng: ${netStr} (${fmt(profit)})"></div>` : ''}
      </div>
      <div class="fnb-legend">
        <span class="lg-item"><i class="fnb-dot cogs"></i> NL: <b>${cogsRevPct.toFixed(1)}%</b></span>
        <span class="lg-item"><i class="fnb-dot labor"></i> Lương: <b>${laborRevPct.toFixed(1)}%</b></span>
        <span class="lg-item"><i class="fnb-dot rent"></i> MB: <b>${rentPct.toFixed(1)}%</b></span>
        ${opexOther > 0 ? `<span class="lg-item"><i class="fnb-dot other"></i> ${gaTot > 0 || franchiseIncomeTax > 0 ? 'G&amp;A/Thuế/Khác' : 'Khác/Thuế'}: <b>${opexStr}</b></span>` : ''}
        ${capex > 0 ? `<span class="lg-item"><i class="fnb-dot" style="background:#8b5cf6;"></i> CAPEX: <b>${capexStr}</b></span>` : ''}
        <span class="lg-item"><i class="fnb-dot ${profit >= 0 ? 'profit' : 'loss'}"></i> ${profit >= 0 ? 'Lãi' : 'Lỗ'}: <b>${netStr}</b></span>
      </div>
    </div>

    <!-- 3 Thẻ chỉ số chuẩn F&B -->
    <div class="fnb-kpi-grid">
      <div class="fnb-kpi-box ${cogsStatus}">
        <div class="kpi-top">
          <span class="kpi-tag">📦 COGS</span>
          <span class="kpi-val">${cogsPct.toFixed(1)}%</span>
        </div>
        <div class="kpi-amt">${fmt(ingTot)}${d.branchIngTot ? ` <small style="font-size:0.72rem;color:var(--soft);font-weight:normal;">(${fmt(d.mainIngTot || (ingTot - d.branchIngTot))} + ${fmt(d.branchIngTot)} CN)</small>` : ''}</div>
        <div class="kpi-note">${cogsMsg}</div>
      </div>

      <div class="fnb-kpi-box ${laborStatus}">
        <div class="kpi-top">
          <span class="kpi-tag">👥 Nhân sự</span>
          <span class="kpi-val">${laborPct.toFixed(1)}%</span>
        </div>
        <div class="kpi-amt">${fmt(wageTot)}${d.branchWageTot ? ` <small style="font-size:0.72rem;color:var(--soft);font-weight:normal;">(${fmt(d.mainWageTot || (wageTot - d.branchWageTot))} + ${fmt(d.branchWageTot)} CN)</small>` : ''}</div>
        <div class="kpi-note">${laborMsg}</div>
      </div>

      <div class="fnb-kpi-box ${bepStatus}">
        <div class="kpi-top">
          <span class="kpi-tag">🎯 Hòa vốn</span>
          <span class="kpi-val">${bepCups} ly</span>
        </div>
        ${!isCompact ? `<div class="kpi-amt">Đã bán: <b>${served} ly</b> (${served >= bepCups ? 'Đạt' : 'Chưa đạt'})</div>` : ''}
        <div class="kpi-note">${served >= bepCups ? `🟢 Đạt (+${served - bepCups} ly)` : `🔴 Thiếu ${bepCups - served} ly`}</div>
      </div>
    </div>

    <!-- Hộp chẩn đoán tài chính chuyên gia F&B -->
    <div class="fnb-diag-box ${isCompact ? 'compact ' : ''}${diagClass}">
      <span>🩺 <b>${diagTitle}</b> ${diagBody}</span>
    </div>
  </div>`;
}

/* ---------- TỔNG KẾT ---------- */
function aggregate(recs){
  const g={spoil:{n:0,v:0},sales:{},tips:0,lobbyRev:0,lobbyTips:0,onl:0,fee:0,equip:[],ing:{},waste:{},rent:0,util:0,tax:0,served:0,lost:0,starSum:0,starN:0,partyPayout:0,partyPenalty:0,guard:0,gzStolen:0,fakeLoss:0,snatchLoss:0,snatchCount:0,svPawnedLoss:0,buyerStolen:0,buyerTrips:0,ga:0,franchiseTax:0,franchiseSupport:0,cloud:0,branchRev:0,branchRent:0,branchWage:0,branchIng:0,branchNet:0,franchiseRev:0,franchiseRent:0,franchiseWage:0,franchiseIng:0,franchiseNet:0,franchiseRoyalty:0,franchiseSupplyProfit:0,franchisePosFee:0,franchiseTotalIncome:0};
  const addMap=(m,src,f)=>Object.entries(src).forEach(([k,x])=>{const y=m[k]=m[k]||{};Object.keys(x).forEach(p=>y[p]=(y[p]||0)+x[p])});
  recs.forEach(r=>{addMap(g.sales,r.sales);addMap(g.ing,r.ing);addMap(g.waste,r.waste);g.equip.push(...r.equip.map(e=>({...e,d:r.day})));if(r.spoil){g.spoil.n+=r.spoil.n;g.spoil.v+=r.spoil.v}
    ['tips','staffTip','gift','loanInt','onl','fee','rent','util','wage','ot','bad','tax','served','lost','starSum','starN','gzStolen','fakeLoss','snatchLoss','snatchCount','svPawnedLoss','ga','franchiseTax','franchiseSupport','cloud','buyerStolen','buyerTrips','partyPayout','partyPenalty','guard','branchRev','branchRent','branchWage','branchIng','branchNet','franchiseRev','franchiseRent','franchiseWage','franchiseIng','franchiseNet','franchiseRoyalty','franchiseSupplyProfit','franchisePosFee','franchiseTotalIncome','lobbyRev','lobbyTips'].forEach(p=>g[p]=(g[p]||0)+(r[p]||0))});
  return g;
}
function paneSum(){
  const H=S.history;
  if(!H.length){$('pane').innerHTML='<div class="sec">Tổng kết</div><p class="note">Chưa có dữ liệu. Bán xong ngày đầu tiên là có tổng kết ở đây.</p>';return}
  const mode=R.sumMode||'day',size={day:1,week:7,month:30}[mode];
  const blocks=[...new Set(H.map(r=>Math.floor((r.day-1)/size)))];
  let idx=R.sumIdx==null||!blocks.includes(R.sumIdx)?blocks[blocks.length-1]:R.sumIdx;
  const recs=H.filter(r=>Math.floor((r.day-1)/size)===idx),g=aggregate(recs);
  const d0=idx*size+1,d1=d0+size-1,last=recs[recs.length-1].day;
  const label=mode==='day'?`Ngày ${d0}`:`${mode==='week'?'Tuần':'Tháng'} ${idx+1} · ngày ${d0}–${d1}${last<d1?' (đang diễn ra)':''}`;
  const pi=blocks.indexOf(idx);
  const vn=n=>fmt(n);
  // revenue rows
  const name=k=>iname(k);
  const grp=(keys,title)=>{const rows=keys.map(k=>({k,q:(g.sales[k]||{}).q||0,a:(g.sales[k]||{}).a||0})).filter(r=>r.q>0).sort((a,b)=>b.q-a.q);
    if(!rows.length)return '';
    const mx=Math.max(1,...rows.map(r=>r.q));
    return `<div class="tgrp">${title}</div>`+rows.map(r=>`<div class="trow${r.q?'':' zero'}"><div><b>${name(r.k)}</b>: ${r.q} phần<div class="tbar"><i style="width:${r.q/mx*100}%"></i></div></div><div>${r.q?fmt(r.a/r.q):'–'}</div><div>${fmt(r.a)}</div></div>`).join('')};
  const baseK=[...BASE_KEYS.filter(k=>S.unlocked[k]||g.sales[k]),...Object.keys(g.sales).filter(k=>!ITEMS[k]&&k!=='L')],flK=FLAV_KEYS.filter(k=>S.unlocked[k]||g.sales[k]),topK=TOP_KEYS.filter(k=>S.unlocked[k]||g.sales[k]);
  const salesTot=Object.values(g.sales).reduce((a,x)=>a+x.a,0),rev=salesTot+g.tips+(g.gift||0)+(g.partyPayout||0)+(g.guard||0)+(g.branchRev||0)+(g.franchiseTotalIncome||g.franchiseRoyalty||0);
  const ingTot=Object.values(g.ing).reduce((a,x)=>a+x.v,0),eqTot=g.equip.reduce((a,x)=>a+x.v,0);
  const cost=g.rent+g.util+(g.wage||0)+(g.bad||0)+(g.loanInt||0)+eqTot+g.fee+ingTot+g.tax+(g.branchRent||0)+(g.branchWage||0)+(g.branchIng||0)+(g.gzStolen||0)+(g.fakeLoss||0)+(g.snatchLoss||0)+(g.svPawnedLoss||0)+(g.buyerStolen||0)+(g.partyPenalty||0)+(g.ga||0)+(g.franchiseTax||0)+(g.franchiseSupport||0)+(g.cloud||0),profit=rev-cost;
  const avg=g.starN?(g.starSum/g.starN).toFixed(1).replace('.',','):'–';
  const bestB=baseK.map(k=>[k,(g.sales[k]||{}).q||0]).sort((a,b)=>b[1]-a[1]),bestT=topK.map(k=>[k,(g.sales[k]||{}).q||0]).sort((a,b)=>b[1]-a[1]);
  const wasteRows=Object.entries(g.waste);
  const fnbData = {
    rev: rev,
    salesTot: salesTot + (g.branchRev || 0),
    ingTot: ingTot + (g.branchIng || 0),
    wageTot: (g.wage || 0) + (g.branchWage || 0),
    rentTot: (g.rent || 0) + (g.branchRent || 0),
    utilTot: g.util || 0,
    eqTot: eqTot,
    feeTot: (g.fee || 0) + (g.franchiseSupport || 0) + (g.cloud || 0),
    taxTot: g.tax || 0,
    gaTot: g.ga || 0,
    franchiseTaxTot: g.franchiseTax || 0,
    franchiseIncomeTax: g.franchiseTax || 0,
    loanTot: g.loanInt || 0,
    badTot: (g.bad || 0) + (g.gzStolen || 0) + (g.fakeLoss || 0) + (g.buyerStolen || 0) + (g.snatchLoss || 0) + (g.svPawnedLoss || 0) + (g.partyPenalty || 0),
    profit: profit,
    served: g.served || 0,
    periodLabel: label
  };
  let h=`<div class="segtabs">${[['day','Theo ngày'],['week','Theo tuần'],['month','Theo tháng']].map(([m,l])=>`<button class="chip${mode===m?' on':''}" data-sm="${m}">${l}</button>`).join('')}</div>
  <div class="pnav"><button class="sbtn" data-nav="-1" ${pi>0?'':'disabled'} aria-label="Kỳ trước">‹</button><b>${label}</b><button class="sbtn" data-nav="1" ${pi<blocks.length-1?'':'disabled'} aria-label="Kỳ sau">›</button></div>
  ${mode==='day'&&recs[0].ev&&EVS[recs[0].ev.id]?`<div class="fore">${ico(EVS[recs[0].ev.id].ic)} Sự kiện: <b>${EVS[recs[0].ev.id].n}</b></div>`:''}
  <div class="kpis"><div><b>${g.served}</b>ly bán</div><div><b>${g.lost}</b>khách bỏ về</div><div><b>${avg}★</b>đánh giá</div></div>
  ${bestB[0]&&bestB[0][1]?`<div class="fore">🔥 Bán chạy: <b>${iname(bestB[0][0])}</b>${bestT[0]&&bestT[0][1]?`, topping <b>${iname(bestT[0][0])}</b>`:''}. Ít khách gọi: <b>${iname(bestB[bestB.length-1][0])}</b>${bestT.length>1?`, <b>${iname(bestT[bestT.length-1][0])}</b>`:''}.</div>`:''}
  ${renderFnbFinancialReport(fnbData)}
  <div class="rh revc">Doanh thu</div>
  <div class="note" style="margin:0 0 2px">Đơn vị tiền: k = 1.000đ, tr = 1.000.000đ, tỉ = 1.000.000.000đ</div><div class="thead"><div>Thành phần</div><div>Đơn giá</div><div>Tổng</div></div>
  ${grp(baseK,'Món')}${grp(flK,'Hương vị')}${grp(topK,'Topping')}${g.sales.L?grp(['L'],'Phụ thu'):''}
  ${g.lobbyRev?`<div class="trow"><div><b>🏮 Doanh thu Sảnh Tiệm (+30%)</b></div><div></div><div>${fmt(g.lobbyRev)}</div></div>`:''}
  ${g.tips?`<div class="trow"><div><b>Tiền tip (Chủ tiệm nhận 80%)</b></div><div></div><div>${fmt(g.tips)}</div></div>`:''}
  ${g.gift?`<div class="trow"><div><b>Tiền được tặng</b></div><div></div><div>${fmt(g.gift)}</div></div>`:''}
  ${g.branchRev?`<div class="trow"><div><b>🏢 Doanh thu chi nhánh</b></div><div></div><div>${fmt(g.branchRev)}</div></div>`:''}
  ${g.franchiseRoyalty?`<div class="trow"><div><b>🤝 Phí nhượng quyền thu về</b></div><div></div><div>${fmt(g.franchiseRoyalty)}</div></div>`:''}
  ${g.franchiseSupplyProfit?`<div class="trow"><div><b>📦 Lãi bán sỉ nguyên liệu chuỗi</b></div><div></div><div>${fmt(g.franchiseSupplyProfit)}</div></div>`:''}
  ${g.franchisePosFee?`<div class="trow"><div><b>💻 Phí phần mềm POS &amp; Bản quyền</b></div><div></div><div>${fmt(g.franchisePosFee)}</div></div>`:''}
  ${g.staffTip?`<div class="note" style="margin:4px 0 0">Tip nhân viên giữ (20% tiền bo): ${fmt(g.staffTip)} (Chủ tiệm đã nhận 80% vào doanh thu két quán)</div>`:''}
  ${g.lobbyTips?`<div class="note" style="margin:2px 0 0;font-size:0.75rem;color:#047857;">Trong đó tiền bo khách ngồi sảnh tiệm: ${fmt(g.lobbyTips)}</div>`:''}
  ${g.onl?`<div class="note" style="margin:4px 0 0">Trong đó đơn online: ${fmt(g.onl)}</div>`:''}
  <div class="ttot revc"><span>Tổng doanh thu</span><span>${fmt(rev)}</span></div>
  <div class="rh neg">Chi phí</div>
  <div class="crow"><span>Mặt bằng</span><span>${fmt(g.rent)}</span></div>
  ${g.branchRent?`<div class="crow"><span>🏢 Thuê mặt bằng chi nhánh</span><span>${fmt(g.branchRent)}</span></div>`:''}
  ${g.branchWage?`<div class="crow"><span>🏢 Lương NV chi nhánh</span><span>${fmt(g.branchWage)}</span></div>`:''}
  ${g.branchIng?`<div class="crow"><span>🏢 Tiền nhập NL chi nhánh</span><span>${fmt(g.branchIng)}</span></div>`:''}
  ${(g.franchiseWage || g.franchiseIng || g.franchiseRent) ? `<div class="note" style="margin:4px 0 0;font-size:0.75rem;color:#6b7280;">ℹ️ Chi phí vận hành chuỗi nhượng quyền (${fmt((g.franchiseRent||0)+(g.franchiseWage||0)+(g.franchiseIng||0))}) do đối tác tự chi trả, không tính vào chi phí quán mẹ.</div>` : ''}
  <div class="crow"><span>Điện nước</span><span>${fmt(g.util)}</span></div>
  ${g.wage-(g.ot||0)?`<div class="crow"><span>Lương nhân viên</span><span>${fmt(g.wage-(g.ot||0))}</span></div>`:''}${g.ot?`<div class="crow"><span>Tăng ca nhân viên pha chế</span><span>${fmt(g.ot)}</span></div>`:''}${g.bad?`<div class="crow"><span>Sự cố mất tiền</span><span>${fmt(g.bad)}</span></div>`:''}
  ${g.partyPenalty?`<div class="crow"><span>⚠️ Phạt giao thiếu đơn tiệc</span><span>${fmt(g.partyPenalty)}</span></div>`:''}
  ${g.buyerStolen?`<div class="crow"><span>🛵 Đi chợ khai gian (${g.buyerTrips||1} chuyến)</span><span>${fmt(g.buyerStolen)}</span></div>`:''}
  ${g.svPawnedLoss?`<div class="crow"><span>💸 Chuộc đồ SV cầm</span><span>${fmt(g.svPawnedLoss)}</span></div>`:''}
  ${g.snatchLoss?`<div class="crow"><span>🚨 Trộm giật / móc két quầy (${g.snatchCount||1} lần)</span><span>${fmt(g.snatchLoss)}</span></div>`:''}
  ${g.gzStolen?`<div class="crow"><span>🤫 Gen Z đá bill</span><span>${fmt(g.gzStolen)}</span></div>`:''}
  ${g.fakeLoss?`<div class="crow"><span>💸 Khách đưa tiền giả</span><span>${fmt(g.fakeLoss)}</span></div>`:''}
  ${g.loanInt?`<div class="crow"><span>Lãi vay</span><span>${fmt(g.loanInt)}</span></div>`:''}
  <div class="crow"><span>Máy móc, trang bị & công thức</span><span>${fmt(eqTot)}</span></div>
  ${g.equip.map(e=>`<div class="crow sub"><span>– ${e.n}${mode!=='day'?' (ngày '+e.d+')':''}</span><span>${fmt(e.v)}</span></div>`).join('')}
  ${g.fee||S.online?`<div class="crow"><span>Phí app giao hàng (${CFG.commission}%)</span><span>${fmt(g.fee)}</span></div>`:''}
  <div class="crow"><span>Nguyên liệu</span><span>${fmt(ingTot)}</span></div>
  ${Object.entries(g.ing).sort((a,b)=>b[1].v-a[1].v).map(([k,x])=>`<div class="trow sub"><div>– ${iname(k)}: ${x.q} phần</div><div>${fmt(x.v/x.q)}</div><div>${fmt(x.v)}</div></div>`).join('')}
  ${g.spoil.n?`<div class="wbox">🥤 Ly làm hỏng: ${g.spoil.n} ly · ${fmt(g.spoil.v)} (đã nằm trong tiền nguyên liệu)</div>`:''}
  <div class="crow"><span>Thuế</span><span>${fmt(g.tax)}</span></div>
  ${g.franchiseTax?`<div class="crow"><span>🏛️ Thuế thu nhập chuỗi nhượng quyền (5%)</span><span>−${fmt(g.franchiseTax)}</span></div>`:''}
  ${g.ga?`<div class="crow"><span>🏢 G&A Văn phòng chuỗi</span><span>${fmt(g.ga)}</span></div>`:''}
  ${g.franchiseSupport?`<div class="crow"><span>🤝 Hỗ trợ chuỗi nhượng quyền</span><span>${fmt(g.franchiseSupport)}</span></div>`:''}
  ${g.cloud?`<div class="crow"><span>☁️ Hạ tầng Cloud POS chuỗi</span><span>${fmt(g.cloud)}</span></div>`:''}
  <div class="ttot neg"><span>Tổng chi phí</span><span>${fmt(cost)}</span></div>
  <div class="final ${profit<0?'neg':'pos'}"><span>Lợi nhuận sau thuế<small>Doanh thu − chi phí</small></span><span>${profit<0?'−':'+'}${fmt(Math.abs(profit))}</span></div>`;
  $('pane').innerHTML=h;
  $('pane').onclick=e=>{const m=e.target.closest('[data-sm]'),n=e.target.closest('[data-nav]');
    if(m){R.sumMode=m.dataset.sm;R.sumIdx=null;paneSum()}
    if(n&&!n.disabled){R.sumIdx=blocks[pi+ +n.dataset.nav];paneSum()}};
}

/* ---------- OWNER PANEL ---------- */
function ownerLogin(){
  ask('<h2>🔑 Mã chủ game</h2><input id="pin" type="password" inputmode="numeric" class="pinbox" aria-label="Mã chủ game">',[['Huỷ',()=>{}],['Mở',()=>{const p=$('pin').value.trim();if(p!==CFG.ownerPin)return toast('Sai mã');ownerPanel()},1]]);
  setTimeout(()=>$('pin')&&$('pin').focus(),50);
}
function oRow(label,key,val,step,unit){const m=unit==='đ';return `<div class="rowi"><div><div class="nm">${label}</div></div><div class="pin"><input type="number" inputmode="decimal" step="${m?step/1000:step}" value="${m?val/1000:val}" data-o="${key}" ${m?'data-m="1"':''} aria-label="${label}"><span>${m?'k':unit}</span></div></div>`}
function ownerPanel(){
  const o=CFG.online;
  $('card').innerHTML=`<h2>🔑 Bảng chủ game</h2><p>Người chơi không thấy phần này.</p><div class="owner">
  <div class="sec">Điều kiện mở đơn online (phải đủ cả 3)</div>
  ${oRow('Lợi nhuận tích luỹ từ','online.minProfit',o.minProfit,500000,'đ')}
  ${oRow('Mở đơn online từ ngày','online.fromDay',o.fromDay,1,'')}
  ${oRow('Đánh giá tối thiểu','online.minRating',o.minRating,0.1,'★')}
  ${oRow('Phí app giao hàng','commission',CFG.commission,1,'%')}
  ${oRow('Lương nhân viên phụ quầy','wage1',CFG.wage1,5000,'đ')}
  ${oRow('Lương nhân viên pha chế','wage2',CFG.wage2,5000,'đ')}
  ${oRow('Lương nhân viên phụ quầy 2','wage3',CFG.wage3,5000,'đ')}
  ${oRow('Lương nhân viên đơn online','wageOn',CFG.wageOn,5000,'đ')}
  ${oRow('Lương nhân viên Gen Z','wageGz',CFG.wageGz,5000,'đ')}
  ${oRow('Lương Me két tinh (TikTok)','wageMkt',CFG.wageMkt,5000,'đ')}
  ${oRow('Giá 1 chai hương','bottle',CFG.bottle,5000,'đ')}
  ${oRow('Giá tablet','tablet',CFG.tablet,100000,'đ')}
  <div class="sec">Cấp độ (ngày bắt đầu)</div>
  ${oRow('Cấp 2: thêm đường, đá','levels.l2',CFG.levels.l2,1,'')}
  ${oRow('Cấp 3: đơn 2–5 ly, ly tới 4 topping','levels.l3',CFG.levels.l3,1,'')}
  <div class="sec">Luật chơi</div>
  ${oRow('Thời gian thật cho 1 ngày (11:00–22:00)','dayMin',CFG.dayMin,0.5,'phút')}
  ${oRow('Vốn ban đầu (ván mới)','startMoney',CFG.startMoney,50000,'đ')}
  ${oRow('Giá 1 ly tối đa (quá thì 60% khách bỏ đi)','priceCap',CFG.priceCap,5000,'đ')}
  ${oRow('Trà (trừ matcha) đắt từ','teaCap',CFG.teaCap,5000,'đ')}
  ${oRow('Matcha đắt từ','teaCapMatcha',CFG.teaCapMatcha,5000,'đ')}
  ${oRow('Giá 1 món tối đa (quá thì vắng 80%)','itemCap',CFG.itemCap,5000,'đ')}
  ${oRow('Phụ thu size L đắt từ (90% khách bỏ size L)','sizeWarn',CFG.sizeWarn,1000,'đ')}
  ${oRow('Phụ thu size L tối đa (không ai chọn L, vắng 80%)','sizeCap',CFG.sizeCap,5000,'đ')}
  <div class="sec">Chi phí cố định & thuế</div>
  ${oRow('Mặt bằng mỗi ngày','rent',CFG.rent,5000,'đ')}
  ${oRow('Điện nước cơ bản mỗi ngày','utilBase',CFG.utilBase,5000,'đ')}
  ${oRow('Điện nước thêm mỗi trang bị','utilPerUpg',CFG.utilPerUpg,1000,'đ')}
  ${oRow('Ngưỡng doanh thu năm không chịu thuế','taxThreshold',CFG.taxThreshold,1000000,'đ')}
  ${oRow('Thuế GTGT trên doanh thu','vat',CFG.vat,0.5,'%')}
  ${oRow('Thuế TNCN trên doanh thu','pit',CFG.pit,0.5,'%')}
  ${oRow('Trộm: két trên','thiefMoney',CFG.thiefMoney,1000000,'đ')}
  ${oRow('Trộm: trước ngày','thiefDay',CFG.thiefDay,1,'')}
  ${oRow('Trộm: chừa lại trong két','thiefLeft',CFG.thiefLeft,50000,'đ')}
  ${oRow('Mã chủ game (chỉ số)','ownerPin',CFG.ownerPin,1,'')}
  <div class="sec">Giá nhập nguyên liệu (mỗi phần)</div>
  ${Object.keys(ITEMS).map(k=>oRow(ITEMS[k].n,'cost.'+k,CFG.cost[k],500,'đ')).join('')}
  <div class="sec">Hạn dùng (0 = không hết hạn)</div>
  ${Object.keys(ITEMS).map(k=>oRow(ITEMS[k].n,'life.'+k,CFG.life[k],1,'ngày')).join('')}
  </div>
  <button class="danger" id="oReset">Khôi phục mặc định</button><br><button class="big" id="oClose">Lưu và đóng</button>`;
  $('modal').hidden=false;
  $('card').onchange=e=>{const i=e.target;if(!i.dataset.o)return;const [a,b]=i.dataset.o.split('.');let v=+i.value*(i.dataset.m?1000:1);
    if(a==='ownerPin'){CFG.ownerPin=String(i.value).trim()||'2468';saveCfg();return}
    if(!(v>=0))v=0;
    if(a==='dayMin')v=Math.min(10,Math.max(.5,Math.round(v*2)/2));
    if(a==='online'&&b==='minRating')v=Math.min(5,Math.round(v*10)/10);
    if(a==='commission')v=Math.min(100,Math.round(v));if(a==='vat'||a==='pit')v=Math.min(100,Math.round(v*10)/10);if(a==='life')v=Math.round(v);
    if(b)CFG[a][b]=v;else CFG[a]=v;i.value=i.dataset.m?v/1000:v;saveCfg()};
  $('oReset').onclick=()=>{CFG=JSON.parse(JSON.stringify(DEFAULT_CONFIG));saveCfg();ownerPanel()};
  $('oClose').onclick=()=>{$('card').onchange=null;$('modal').hidden=true;renderPrep()};
}

/* ---------- HỘP THOẠI TRONG GAME (thay confirm/prompt bị chặn) ---------- */
function ask(html,btns){
  $('card').classList.remove('card-kpi-modal');
  $('card').classList.remove('card-sell-modal');
  $('card').onchange=null;
  $('card').innerHTML=html+`<div class="askbtns">${btns.map((b,i)=>`<button class="${b[2]?'big':'sbtn ghost'}" data-ask="${i}">${b[0]}</button>`).join('')}</div>`;
  $('modal').hidden=false;
  $('card').querySelectorAll('[data-ask]').forEach(el=>el.onclick=()=>{const b=btns[+el.dataset.ask];const keep=el.closest('.card').querySelector('#pin')?$('pin').value:null;if(isField(document.activeElement))document.activeElement.blur();$('modal').hidden=true;b[1](keep)});
}
window.closeModal = function(){ const m = document.getElementById('modal'); if(m) m.hidden = true; };

function fl(el,t,bad){
  if(!el && R.mode !== 'sell') return;
  const f = document.createElement('div');
  f.className = 'float' + (bad ? ' bad' : '');
  const formattedT = String(t || '').replace(/★/g, '<span class="float-star">★</span>');
  f.innerHTML = formattedT;

  const stage = $('q3stage');
  if(R.mode === 'sell' && stage){
    // Đưa vào trong q3stage để tự động scale đồng bộ với mọi màn hình, kích thước nhỏ gọn vừa vặn
    stage.appendChild(f);
    f.style.left = '460px';
    f.style.top = '295px';
    f.style.transform = 'translate(-50%, 0)';
  } else {
    document.body.appendChild(f);
    if(el){
      const r = el.getBoundingClientRect();
      f.style.left = Math.max(6, Math.min(vpW() - f.offsetWidth - 6, (r.left + r.width / 2) / ZM - f.offsetWidth / 2)) + 'px';
      f.style.top = Math.round((r.bottom / ZM) + 6) + 'px';
    }
  }
  setTimeout(() => f.remove(), 1250);
}
let tt,tPri=0;function toast(m,ms,pri){
  // Tuyệt đối không hiện toast che màn hình khi đang chơi Milk Tea Crush
  const isCrushModalActive = (typeof R !== 'undefined' && R.crushAutoSelling) ||
    document.body.classList.contains('codam-active') ||
    (function(){ const cm = $('codam-modal'); return cm && !cm.hidden; })();
  if(isCrushModalActive && !pri){
    return;
  }
  if(R.mode==='sell' && !pri){
    const isCustomerMsg = /(khách|reviewer|bạn thân|ghé quán|tới quán|chê|bỏ về|bỏ đi|phải đi|quỵt|quýt|order|đơn lớn|học sinh|nhận ly|ly free|mời về|huỷ đơn|chọn đường|chọn đá|chưa có khách|đi mất|tài xế|khiếu nại)/i.test(m);
    if(isCustomerMsg) return;
  }
  // Nếu đang có vụ án tiền giả (10s đếm ngược): Tuyệt đối không bật toast để tránh che quầy và nút Báo Công An
  if(R.mode==='sell' && R.fakeCase && !R.fakeCase.reported && !R.fakeCase.expired){
    return;
  }
  const now=performance.now();if(!pri&&now<tPri)return;const t=$('toast');if(!t)return;t.innerHTML=m;t.classList.toggle('sell',R.mode==='sell');t.classList.toggle('pri',!!pri);
  const isLobbyOpen = document.body.classList.contains('lobby-open') || (function(){ const lm = $('lobby-modal'); return lm && !lm.hidden; })();
  t.classList.toggle('in-lobby', !!isLobbyOpen);
  const sbWrap = $('staffBarWrap');
  const hasBottomWidget = sbWrap && Array.from(sbWrap.children).some(el => !el.hidden && el.style.display !== 'none' && !el.classList.contains('hidden'));
  const hasStaffBar = R.mode === 'sell' && !isLobbyOpen && (
    hasBottomWidget ||
    (typeof isStaffActive === 'function' && isStaffActive('staffGz') && !R.isNightShift) ||
    (typeof isStaffActive === 'function' && isStaffActive('staffSv') && R.isNightShift)
  );
  t.classList.toggle('has-staff-bar', !!hasStaffBar);
  t.onclick = () => { t.classList.remove('show'); tPri = 0; };
  t.classList.add('show');clearTimeout(tt);ms=ms||(isLobbyOpen?1800:(R.mode==='sell'?2400:2500));tPri=pri?now+ms:0;tt=setTimeout(()=>{t.classList.remove('show');tPri=0},ms)}


/* ---------- MÀU GIAO DIỆN ---------- */
const THEMES=[
  {id:'kem',n:'Kem sữa',bg:'#fdf3e4',panel:'#fffaf2',line:'#ead7bd',ink:'#3a2317',soft:'#7a5a48',acc:'#ef6f8e',accd:'#c24c69',t:null},
  {id:'nau',n:'Nâu cà phê',bg:'#ead9c4',panel:'#f7ecdf',line:'#cfae8a',ink:'#3a2317',soft:'#6b4a36',acc:'#9a6340',accd:'#6b3f22',t:['#8a5a3b',.32]},
  {id:'socola',n:'Sô cô la',bg:'#d9c2ab',panel:'#efe2d4',line:'#b8916e',ink:'#2e1c12',soft:'#5e3f2b',acc:'#6b3f22',accd:'#4a2a14',t:['#5b3a26',.4]},
  {id:'dau',n:'Hồng dâu',bg:'#fde8ee',panel:'#fff5f8',line:'#f3c7d4',ink:'#3a2330',soft:'#7a4a5c',acc:'#e85d8a',accd:'#b8406a',t:['#f48fb1',.2]},
  {id:'dao',n:'Cam đào',bg:'#fdebdc',panel:'#fff6ef',line:'#f5cdb0',ink:'#3a2317',soft:'#7a5040',acc:'#f08a5d',accd:'#c0643c',t:['#ffab91',.22]},
  {id:'thai',n:'Trà Thái',bg:'#fde6cf',panel:'#fff4e8',line:'#f3c595',ink:'#3a2317',soft:'#7a5030',acc:'#e8792f',accd:'#b55718',t:['#ffa726',.22]},
  {id:'chanh',n:'Vàng chanh',bg:'#fbf6d6',panel:'#fffdf0',line:'#ebe097',ink:'#33301a',soft:'#6e6632',acc:'#c9a820',accd:'#977d0e',t:['#fff176',.25]},
  {id:'matcha',n:'Xanh matcha',bg:'#eef4e2',panel:'#f8fbf1',line:'#cfe0b3',ink:'#25331a',soft:'#566b43',acc:'#6aa84f',accd:'#4b7f36',t:['#9ccc65',.22]},
  {id:'bacha',n:'Bạc hà',bg:'#e3f5f0',panel:'#f4fcf9',line:'#b9e2d6',ink:'#1d3530',soft:'#4b6f66',acc:'#3fae90',accd:'#2b8069',t:['#80cbc4',.24]},
  {id:'bien',n:'Xanh biển',bg:'#e6f2fa',panel:'#f5fbff',line:'#bfdcef',ink:'#1c2d3a',soft:'#4a6378',acc:'#3d8fd1',accd:'#2a6aa0',t:['#64b5f6',.22]},
  {id:'khoaimon',n:'Tím khoai môn',bg:'#efe7f7',panel:'#faf6fd',line:'#d7c6ea',ink:'#2d2238',soft:'#62507a',acc:'#9b6bd1',accd:'#7147a3',t:['#b39ddb',.26]},
  {id:'dem',n:'Đêm dịu',bg:'#2b2433',panel:'#3a3144',line:'#574a63',ink:'#f5ecf7',soft:'#cbbad3',acc:'#f08fb0',accd:'#b85f80',t:['#3b2d5c',.19]}
];
let THEME='kem';try{THEME=localStorage.getItem('tsTheme')||'kem'}catch(e){}
function applyTheme(id){const t=THEMES.find(x=>x.id===id)||THEMES[0];THEME=t.id;try{localStorage.setItem('tsTheme',t.id)}catch(e){}
  const r=document.documentElement.style;r.setProperty('--bg',t.bg);r.setProperty('--panel',t.panel);r.setProperty('--line',t.line);r.setProperty('--ink',t.ink);r.setProperty('--soft',t.soft);r.setProperty('--pink',t.acc);r.setProperty('--pink-d',t.accd);
  r.setProperty('--tint',t.t?t.t[0]:'transparent');r.setProperty('--tintm','#ffffff');r.setProperty('--tinta',t.t?t.t[1]:0);document.body.classList.toggle('dark',t.id==='dem');
  let m=document.querySelector('meta[name=theme-color]');if(!m){m=document.createElement('meta');m.name='theme-color';document.head.appendChild(m)}m.content=t.bg}
function themeDlg(){$('card').onchange=null;
  $('card').innerHTML=`<h2>Màu giao diện</h2><p>Chọn màu bạn thích, đổi lúc nào cũng được.</p><div class="thg">${THEMES.map(t=>`<button class="thb${t.id===THEME?' on':''}" data-th="${t.id}"><i style="background:linear-gradient(135deg,${t.bg} 0 50%,${t.acc} 50%)"></i>${t.n}</button>`).join('')}</div><button class="big" id="thClose" style="margin-top:12px">Xong</button>`;
  $('modal').hidden=false;$('card').querySelectorAll('[data-th]').forEach(b=>b.onclick=()=>{applyTheme(b.dataset.th);themeDlg()});$('thClose').onclick=showSettings}
/* ---------- ÂM THANH (Tài nguyên thực snd/, KHÔNG dùng oscillator giả lập) ---------- */
const AU={ctx:null,on:true,mus:true,season:null,bgmTrack:'lofi',volMus:0.7,volSfx:0.8};
try{
  const a=JSON.parse(localStorage.getItem('tsAudio'));
  if(a){
    AU.on=a.on!==false;
    AU.mus=a.mus!==false;
    AU.season=a.season||null;
    if(a.bgmTrack)AU.bgmTrack=a.bgmTrack;
    if(typeof a.volMus==='number')AU.volMus=Math.max(0,Math.min(1,a.volMus));
    if(typeof a.volSfx==='number')AU.volSfx=Math.max(0,Math.min(1,a.volSfx));
  }
}catch(e){}
if(typeof AU.volMus!=='number')AU.volMus=0.7;
if(typeof AU.volSfx!=='number')AU.volSfx=0.8;
function saveAu(){
  try{
    localStorage.setItem('tsAudio',JSON.stringify({
      on:AU.on,
      mus:AU.mus,
      season:AU.season||null,
      bgmTrack:AU.bgmTrack||'lofi',
      volMus:AU.volMus,
      volSfx:AU.volSfx
    }));
  }catch(e){}
  updateQuickVolIcon();
}
function setMusVol(v){
  AU.volMus=Math.max(0,Math.min(1,Math.round(v*100)/100));
  saveAu();
  const modeFactor=(R&&R.mode==='sell')?1.0:0.85;
  const targetVol=(AU.mus?AU.volMus:0)*modeFactor;
  if(bgmAudio){
    try{bgmAudio.volume=targetVol}catch(e){}
    if(targetVol<=0||!AU.mus){
      bgmAudio.pause();
    }else if(bgmAudio.paused&&!document.hidden){
      const p=bgmAudio.play();
      if(p&&p.catch)p.catch(()=>{});
    }
  }
  if(AU.ctx&&AU.mg){
    try{
      AU.mg.gain.cancelScheduledValues(AU.ctx.currentTime);
      AU.mg.gain.linearRampToValueAtTime(targetVol,AU.ctx.currentTime+0.08);
    }catch(e){
      AU.mg.gain.value=targetVol;
    }
  }
  if(loopSrc&&loopSrc.g&&AU.ctx){
    try{
      loopSrc.g.gain.cancelScheduledValues(AU.ctx.currentTime);
      loopSrc.g.gain.linearRampToValueAtTime(targetVol,AU.ctx.currentTime+0.08);
    }catch(e){
      loopSrc.g.gain.value=targetVol;
    }
  }
}
function setSfxVol(v,playSample){
  AU.volSfx=Math.max(0,Math.min(1,Math.round(v*100)/100));
  saveAu();
  const targetVol=AU.on?AU.volSfx:0;
  if(AU.ctx&&AU.fx){
    try{
      AU.fx.gain.cancelScheduledValues(AU.ctx.currentTime);
      AU.fx.gain.linearRampToValueAtTime(targetVol,AU.ctx.currentTime+0.05);
    }catch(e){
      AU.fx.gain.value=targetVol;
    }
  }
  if(pourAudio){
    try{pourAudio.volume=Math.max(0,Math.min(1,0.22*targetVol))}catch(e){}
  }
  if(playSample&&AU.on&&AU.volSfx>0){try{playSmp('bell',0.35)}catch(e){}}
}
function updateQuickVolIcon(){
  const btn=$('volQuickBtn');
  if(btn){
    const isMuted=(!AU.mus||AU.volMus<=0)&&(!AU.on||AU.volSfx<=0);
    btn.innerHTML=`<span style="font-size:1.05rem;line-height:1;display:grid;place-items:center;">${isMuted?'🔇':'🔊'}</span>`;
    btn.title=`Âm lượng (Nhạc: ${AU.mus?Math.round(AU.volMus*100)+'%':'Tắt'} · SFX: ${AU.on?Math.round(AU.volSfx*100)+'%':'Tắt'})`;
  }
}
function getVolumeControlHTML(prefix){
  prefix=prefix||'vol';
  const musPct=AU.mus?Math.round((AU.volMus!=null?AU.volMus:0.7)*100):0;
  const sfxPct=AU.on?Math.round((AU.volSfx!=null?AU.volSfx:0.8)*100):0;
  return `
    <div class="set-vol-card">
      <div class="set-vol-row">
        <div class="set-vol-head">
          <span class="set-vol-name">🎵 Nhạc nền quán</span>
          <span class="set-vol-pct" id="${prefix}_mus_pct">${AU.mus?musPct+'%':'Đang tắt'}</span>
        </div>
        <div class="set-vol-bar">
          <button type="button" class="set-vol-step" id="${prefix}_mus_down" aria-label="Giảm nhạc" title="Giảm 10%">➖</button>
          <input type="range" class="set-vol-range" id="${prefix}_mus_range" min="0" max="100" step="5" value="${musPct}">
          <button type="button" class="set-vol-step" id="${prefix}_mus_up" aria-label="Tăng nhạc" title="Tăng 10%">➕</button>
          <button type="button" class="set-vol-mute ${AU.mus?'':'is-muted'}" id="${prefix}_mus_mute" title="${AU.mus?'Tắt nhạc nền':'Bật nhạc nền'}">${AU.mus?'🔊':'🔇'}</button>
        </div>
      </div>
      <div class="set-vol-row">
        <div class="set-vol-head">
          <span class="set-vol-name">🧋 Âm thanh pha chế & SFX</span>
          <span class="set-vol-pct" id="${prefix}_sfx_pct">${AU.on?sfxPct+'%':'Đang tắt'}</span>
        </div>
        <div class="set-vol-bar">
          <button type="button" class="set-vol-step" id="${prefix}_sfx_down" aria-label="Giảm âm thanh" title="Giảm 10%">➖</button>
          <input type="range" class="set-vol-range" id="${prefix}_sfx_range" min="0" max="100" step="5" value="${sfxPct}">
          <button type="button" class="set-vol-step" id="${prefix}_sfx_up" aria-label="Tăng âm thanh" title="Tăng 10%">➕</button>
          <button type="button" class="set-vol-mute ${AU.on?'':'is-muted'}" id="${prefix}_sfx_mute" title="${AU.on?'Tắt âm thanh':'Bật âm thanh'}">${AU.on?'🔊':'🔇'}</button>
        </div>
      </div>
    </div>
  `;
}
function bindVolumeControls(prefix,onUpdate){
  prefix=prefix||'vol';
  const musDown=$(`${prefix}_mus_down`),musUp=$(`${prefix}_mus_up`),musRange=$(`${prefix}_mus_range`),musMute=$(`${prefix}_mus_mute`),musPct=$(`${prefix}_mus_pct`);
  const sfxDown=$(`${prefix}_sfx_down`),sfxUp=$(`${prefix}_sfx_up`),sfxRange=$(`${prefix}_sfx_range`),sfxMute=$(`${prefix}_sfx_mute`),sfxPct=$(`${prefix}_sfx_pct`);
  function updateMusUI(){
    const cur=AU.mus?Math.round(AU.volMus*100):0;
    if(musPct)musPct.textContent=AU.mus?(Math.round(AU.volMus*100)+'%'):'Đang tắt';
    if(musRange)musRange.value=cur;
    if(musMute){musMute.textContent=AU.mus?'🔊':'🔇';musMute.classList.toggle('is-muted',!AU.mus)}
    updateQuickVolIcon();
    if(typeof onUpdate==='function')onUpdate('mus');
  }
  function updateSfxUI(){
    const cur=AU.on?Math.round(AU.volSfx*100):0;
    if(sfxPct)sfxPct.textContent=AU.on?(Math.round(AU.volSfx*100)+'%'):'Đang tắt';
    if(sfxRange)sfxRange.value=cur;
    if(sfxMute){sfxMute.textContent=AU.on?'🔊':'🔇';sfxMute.classList.toggle('is-muted',!AU.on)}
    updateQuickVolIcon();
    if(typeof onUpdate==='function')onUpdate('sfx');
  }
  if(musDown){
    musDown.onclick=(e)=>{
      e.stopPropagation();
      let cur=Math.round((AU.volMus||0.7)*100);
      cur=Math.max(0,cur-10);
      AU.volMus=cur/100;
      if(cur===0)AU.mus=false;else if(!AU.mus)AU.mus=true;
      saveAu();setMusVol(AU.volMus);musSync();updateMusUI();
    };
  }
  if(musUp){
    musUp.onclick=(e)=>{
      e.stopPropagation();
      let cur=Math.round((AU.volMus||0.7)*100);
      cur=Math.min(100,cur+10);
      AU.volMus=cur/100;AU.mus=true;
      saveAu();setMusVol(AU.volMus);musSync();updateMusUI();
    };
  }
  if(musRange){
    const onMusChange=(e)=>{
      const val=parseInt(e.target.value,10);
      AU.volMus=val/100;
      if(val===0)AU.mus=false;else if(!AU.mus)AU.mus=true;
      saveAu();setMusVol(AU.volMus);musSync();updateMusUI();
    };
    musRange.oninput=onMusChange;
    musRange.onchange=onMusChange;
  }
  if(musMute){
    musMute.onclick=(e)=>{
      e.stopPropagation();
      AU.mus=!AU.mus;
      if(AU.mus&&AU.volMus<=0)AU.volMus=0.5;
      saveAu();setMusVol(AU.volMus);musSync();updateMusUI();
    };
  }
  if(sfxDown){
    sfxDown.onclick=(e)=>{
      e.stopPropagation();
      let cur=Math.round((AU.volSfx||0.8)*100);
      cur=Math.max(0,cur-10);
      AU.volSfx=cur/100;
      if(cur===0)AU.on=false;else if(!AU.on)AU.on=true;
      saveAu();setSfxVol(AU.volSfx,true);updateSfxUI();
    };
  }
  if(sfxUp){
    sfxUp.onclick=(e)=>{
      e.stopPropagation();
      let cur=Math.round((AU.volSfx||0.8)*100);
      cur=Math.min(100,cur+10);
      AU.volSfx=cur/100;AU.on=true;
      saveAu();setSfxVol(AU.volSfx,true);updateSfxUI();
    };
  }
  if(sfxRange){
    const onSfxChange=(e,playBell)=>{
      const val=parseInt(e.target.value,10);
      AU.volSfx=val/100;
      if(val===0)AU.on=false;else if(!AU.on)AU.on=true;
      saveAu();setSfxVol(AU.volSfx,false);updateSfxUI();
      if(playBell&&AU.on&&AU.volSfx>0)playSmp('bell',0.35);
    };
    sfxRange.oninput=(e)=>onSfxChange(e,false);
    sfxRange.onchange=(e)=>onSfxChange(e,true);
  }
  if(sfxMute){
    sfxMute.onclick=(e)=>{
      e.stopPropagation();
      AU.on=!AU.on;
      if(AU.on&&AU.volSfx<=0)AU.volSfx=0.5;
      saveAu();setSfxVol(AU.volSfx,AU.on);updateSfxUI();
    };
  }
}
function showVolumeModal(){
  au();
  if(R&&R.running&&!R.paused&&R._pausedBySettings!==false){
    R._pausedBySettings=true;
    R.paused=true;
    clearInterval(timer);
  }
  $('card').onchange=null;
  $('card').innerHTML=`
    <h2>🎛️ Âm lượng trò chơi</h2>
    <p style="font-size:0.86rem;color:var(--soft);margin-bottom:12px;">Điều chỉnh âm lượng nhạc nền và âm thanh pha chế theo sở thích:</p>
    ${getVolumeControlHTML('qvol')}
    <button class="big" id="qvolClose" style="margin-top:14px;">Xong</button>
  `;
  $('modal').hidden=false;
  bindVolumeControls('qvol');
  $('qvolClose').onclick=()=>{
    $('modal').hidden=true;
    if(R&&R.running&&R._pausedBySettings){
      delete R._pausedBySettings;
      resumeGame();
    }
  };
}
function au(){
  if(!AU.ctx){
    const C = window.AudioContext || window.webkitAudioContext;
    if(!C) return null;
    const c = AU.ctx = new C();
    AU.master = c.createGain();
    AU.master.gain.value = 0.9;
    AU.master.connect(c.destination);

    AU.fx = c.createGain();
    AU.fx.gain.value = AU.on ? (AU.volSfx != null ? AU.volSfx : 0.8) : 0;
    AU.fx.connect(AU.master);

    AU.mg = c.createGain();
    const modeFactor = (R && R.mode === 'sell') ? 1.0 : 0.85;
    const targetVol = (AU.mus ? (AU.volMus != null ? AU.volMus : 0.7) : 0) * modeFactor;
    AU.mg.gain.value = targetVol;
    AU.mg.connect(AU.master);
  }
  if(AU.ctx.state === 'suspended' && !document.hidden){
    AU.ctx.resume().catch(()=>{});
  }
  return AU.ctx;
}
/* Vô hiệu hóa hoàn toàn âm thanh tổng hợp oscillator điện tử */
function tn(){}
function nz(){}
const SFX={
  tap(){},cup(){},plop(){},top(){},pump(){},ice(){},trash(){},seal(){},coin(){},star(){},bad(){},bell(){},end(){}
};

/* Danh mục file âm thanh thu thật (thư mục snd/) */
const SMP={
  lofi:'snd/Nhạc Chill Quán Cafe - Những Ca Khúc Lofi Nhẹ Nhàng Hay Nhất Dành Cho Quán Cafe - Nhạc Lofi 2026.mp3',
  m_thu:'snd/m_thu.mp3',
  m_dong:'snd/m_dong.mp3',
  m_xuan:'snd/m_xuan.mp3',
  m_he:'snd/m_he.mp3',
  pour:'snd/pour.wav',
  bell:'snd/bell.mp3',
  cash:'snd/cash.mp3',
  lvup:'snd/levelup.mp3'
};
/* Chỉ giải mã PCM vào RAM các file SFX siêu ngắn (< 200KB).
   Toàn bộ nhạc nền BGM (m_thu, m_dong, m_xuan, m_he, lofi) được stream qua HTML5 Audio để tiết kiệm ~120MB RAM PCM trên iOS Safari, chống văng trang (Jetsam Crash). */
const SFX_ONLY_KEYS = ['pour', 'bell', 'cash', 'lvup'];
const SBUF={},SFAIL={},SPOOL={};
let smpLoading=false;
const SRAW={};
if(typeof location!=='undefined'&&location.protocol.startsWith('http')){
  SFX_ONLY_KEYS.forEach(k=>{
    const u=SMP[k];
    if(!u)return;
    SRAW[k]=fetch(u).then(r=>{if(!r.ok)throw 0;return r.arrayBuffer()}).catch(()=>null);
  });
}
function loadSmp(){
  if(smpLoading||!AU.ctx)return;smpLoading=true;
  SFX_ONLY_KEYS.forEach(k=>{
    const u=SMP[k];
    if(!u)return;
    const p=SRAW[k]||(typeof location!=='undefined'&&location.protocol.startsWith('http')?fetch(u).then(r=>r.arrayBuffer()).catch(()=>null):Promise.resolve(null));
    p.then(b=>{
      if(!b)throw 0;
      return new Promise((ok,no)=>{
        try{const res=AU.ctx.decodeAudioData(b.slice(0),ok,no);if(res&&res.then)res.then(ok,no)}catch(e){no(e)}
      });
    }).then(buf=>{
      SBUF[k]=buf;
      delete SRAW[k];
    }).catch(()=>{SFAIL[k]=1});
  });
}

/* Âm lượng hiệu ứng chuẩn: 35% nhân theo AU.volSfx - Tái sử dụng Audio Pool để không vượt trần 32 MediaPipelines trên iOS */
const EFFECT_VOL = 0.35;
function playAudioFile(k,vol){
  if(!AU.on||(AU.volSfx!=null&&AU.volSfx<=0))return false;
  const u=SMP[k];if(!u)return false;
  try{
    let snd=SPOOL[k];
    if(!snd){
      snd=new Audio(u);
      snd.preload='auto';
      SPOOL[k]=snd;
    } else {
      try{snd.currentTime=0;}catch(e){}
    }
    const base=typeof vol==='number'?vol:EFFECT_VOL;
    const finalVol=Math.max(0,Math.min(1,base*(AU.volSfx!=null?AU.volSfx:0.8)));
    snd.volume=finalVol;
    const p=snd.play();if(p&&p.catch)p.catch(()=>{});
    return true;
  }catch(e){return false}
}
function playSmp(k,vol){
  if(!AU.on||(AU.volSfx!=null&&AU.volSfx<=0))return false;
  const base=typeof vol==='number'?vol:EFFECT_VOL;
  if(AU.ctx&&SBUF[k]&&AU.ctx.state==='running'){
    try{
      const s=AU.ctx.createBufferSource(),g=AU.ctx.createGain();
      s.buffer=SBUF[k];
      g.gain.value=base;
      s.connect(g);
      g.connect(AU.fx);
      s.start();
      return true;
    }catch(e){}
  }
  return playAudioFile(k,base);
}

/* Ánh xạ hiệu ứng sang file thực tế trong snd/, âm lượng gốc 35% */
const SMAP={
  bell:['bell',0.35],
  coin:['cash',0.35],
  cash:['cash',0.35],
  star:['bell',0.35],
  lvup:['lvup',0.35]
};
function sfx(n){
  if(!AU.on||(AU.volSfx!=null&&AU.volSfx<=0))return;
  // Tắt hoàn toàn âm thanh chọn topping, siro, đường, xúc đá
  if(n==='plop'||n==='top'||n==='pump'||n==='ice')return;
  loadSmp();
  try{
    const m=SMAP[n];
    if(m){playSmp(m[0],m[1]);return}
  }catch(e){}
}

/* Rót trà: pour.wav (âm lượng tỉ lệ theo AU.volSfx) */
let pourSrc=null,pourAudio=null;
function pourSnd(on){
  if(!AU.on||(AU.volSfx!=null&&AU.volSfx<=0)){
    if(pourSrc&&AU.ctx){try{pourSrc.s.stop(AU.ctx.currentTime+.05)}catch(e){}pourSrc=null}
    if(pourAudio){pourAudio.pause();try{pourAudio.currentTime=0}catch(e){}}
    return;
  }
  const c=au();loadSmp();
  const curSfxVol=AU.volSfx!=null?AU.volSfx:0.8;
  const pVol=Math.max(0,Math.min(1,0.22*curSfxVol));
  if(on){
    if(c&&SBUF.pour&&!pourSrc){
      try{
        const s=c.createBufferSource(),g=c.createGain();s.buffer=SBUF.pour;s.loop=true;
        g.gain.value=0.22;
        s.connect(g);g.connect(AU.fx);s.start(0,Math.random()*2.5);pourSrc={s,g};return;
      }catch(e){}
    }
    if(!pourAudio){
      pourAudio=new Audio(SMP.pour);
      pourAudio.loop=true;
      pourAudio.preload='auto';
    }
    try{pourAudio.volume=pVol}catch(e){}
    const p=pourAudio.play();if(p&&p.catch)p.catch(()=>{});
  }else{
    if(pourSrc&&c){try{pourSrc.s.stop(c.currentTime+.05)}catch(e){}pourSrc=null}
    if(pourAudio){pourAudio.pause();try{pourAudio.currentTime=0}catch(e){}}
  }
}

const SEASONS={
  thu:{n:'Mùa thu',g:1.5},
  dong:{n:'Mùa đông',g:1.35},
  xuan:{n:'Mùa xuân',g:.85},
  he:{n:'Mùa hè',g:.7}
};
function seasonNow(){
  const m=new Date().getMonth()+1;
  return (m>=9&&m<=11)?'thu':(m===12||m<=2)?'dong':(m<=5)?'xuan':'he';
}
const seasonKey=()=>(AU.season&&SEASONS[AU.season])?AU.season:seasonNow();
let loopSrc=null,bgmAudio=null,currentBgmKey=null;
function musLoop(k){
  if(loopSrc&&AU.ctx){try{loopSrc.s.stop()}catch(e){}loopSrc=null}
}
function musSync(){
  const want=AU.mus&&!document.hidden;
  const key=(AU.bgmTrack==='lofi')?'lofi':('m_'+seasonKey());
  const rawUrl=SMP[key]||('snd/'+key+'.mp3');
  const modeFactor=(R&&R.mode==='sell')?1.0:0.85;
  const targetVol=(AU.mus?(AU.volMus!=null?AU.volMus:0.7):0)*modeFactor;

  if(!want || targetVol <= 0){
    if(bgmAudio&&!bgmAudio.paused)bgmAudio.pause();
    musLoop(null);
    return;
  }

  // Phát toàn bộ nhạc nền (4 mùa + Lofi) trực tiếp bằng 1 luồng HTML5 Audio duy nhất (preload='metadata')
  if(loopSrc&&AU.ctx){try{loopSrc.s.stop()}catch(e){}loopSrc=null}
  if(!bgmAudio){
    bgmAudio=new Audio();
    bgmAudio.loop=true;
    bgmAudio.preload='metadata';
  }

  // CHỈ nạp lại src khi đổi bài (currentBgmKey !== key), KHÔNG BAO GIỜ reset src khi đang buffer/pause!
  if(currentBgmKey!==key){
    currentBgmKey=key;
    bgmAudio.src=rawUrl;
    bgmAudio.load();
  }
  try{bgmAudio.volume=targetVol}catch(e){}
  if(bgmAudio.paused){
    const p=bgmAudio.play();
    if(p&&p.catch)p.catch(()=>{});
  }
}
try{if(navigator.audioSession)navigator.audioSession.type='ambient'}catch(e){}
let _lastAuUnlock=0;
function auUnlock(){
  const now=Date.now();
  if(now-_lastAuUnlock<400&&AU.ctx&&AU.ctx.state==='running'&&smpLoading&&(!AU.mus||(bgmAudio&&!bgmAudio.paused)))return;
  _lastAuUnlock=now;
  const c=au();if(c&&c.state!=='running'){c.resume().then(musSync).catch(()=>{})}
  loadSmp();musSync();
}
['touchstart','touchend','pointerdown','click','keydown'].forEach(ev=>addEventListener(ev,auUnlock,{capture:true,passive:true}));
document.addEventListener('visibilitychange',()=>{
  if(document.hidden){
    pourSnd(false);if(bgmAudio)bgmAudio.pause();if(AU.ctx)AU.ctx.suspend().catch(()=>{});
  }else{
    if(AU.ctx)AU.ctx.resume().catch(()=>{});musSync();
  }
});
/* Hỗ trợ phục hồi BFCache trên iOS Safari khi đổi qua app khác rồi quay lại */
window.addEventListener('pageshow', (event) => {
  try {
    if (typeof AU !== 'undefined' && AU && AU.ctx && AU.ctx.state === 'suspended') AU.ctx.resume().catch(()=>{});
    if (typeof musSync === 'function') musSync();
    const v = document.getElementById('view');
    if (!v || v.innerHTML.trim().length < 20) {
      if (typeof window.initSafeRecovery === 'function') window.initSafeRecovery();
    }
  } catch(e) {}
});
document.addEventListener('click',e=>{if(e.target.closest('.big,.sbtn,.tab,.stab,.setb,.chip,.rpbtn,.sp4-go'))sfx('tap')},true);

/* ============================================================
   CƠ CHẾ XOÁ SẠCH CACHE & BẮT BUỘC CẬP NHẬT PHIÊN BẢN MỚI NHẤT
   ============================================================ */
async function forceGlobalAppUpdate(){
  try {
    if (typeof toast === 'function') toast('Đang lưu tiến trình, xoá sạch bộ nhớ đệm (Cache) & tải bản mới nhất...');
  } catch(e) {}
  try {
    if (typeof isUnstartedDay1Save !== 'function' || !isUnstartedDay1Save(S)) {
      if (typeof save === 'function') save(true);
      if (typeof autoBak === 'function') autoBak();
    }
  } catch (e) {}

  let latestVer = GAME_VERSION;
  try {
    const res = await fetch('version.json', { cache: 'no-store' });
    if (res.ok) {
      const data = await res.json();
      if (data && data.version) latestVer = data.version;
    }
  } catch (e) {}

  try {
    // Lưu phiên bản mới vào localStorage để index.html nhận diện chuẩn xác
    localStorage.setItem('ts_app_version', latestVer);
    localStorage.setItem('ts_last_sync_ver_' + latestVer, Date.now().toString());
    localStorage.removeItem('tsSeenV11_box');
  } catch (e) {}

  try {
    if (typeof sessionStorage !== 'undefined') {
      sessionStorage.clear();
      sessionStorage.setItem('ts_reload_guard_' + latestVer, '1');
    }
  } catch (e) {}

  try {
    if ('caches' in window) {
      const ks = await caches.keys();
      await Promise.all(ks.map(k => caches.delete(k)));
    }
  } catch (e) {}

  try {
    if (navigator.serviceWorker) {
      const regs = await navigator.serviceWorker.getRegistrations();
      await Promise.all(regs.map(r => r.unregister()));
    }
  } catch (e) {}

  // Tuyệt đối không thêm tham số query (?_v=, ?_t=, ?from=...) để tránh lỗi "Site not found" trên hosting reverse proxy
  try {
    if (window.location.search.includes('from=classic')) {
      sessionStorage.setItem('fromClassic', '1');
      localStorage.setItem('fromClassic', '1');
    }
  } catch(e) {}
  const cleanUrl = window.location.href.split('?')[0];
  try {
    if (window.location.href !== cleanUrl) {
      window.history.replaceState(null, '', cleanUrl);
    }
  } catch(e) {}
  window.location.reload();
}
window.forceGlobalAppUpdate = forceGlobalAppUpdate;

/* ---------- MÀN HÌNH CHÀO + HƯỚNG DẪN ---------- */
function closeSplash(){const sp=$('splash');sp.hidden=true;sp.innerHTML='';auUnlock();musSync();if(R.mode==='prep')setTimeout(prepChecks,300)}
const SP_MSG=['Đang nấu trân châu…','Đang ủ trà…','Đang lau quầy…','Đang xếp ly…','Sắp mở cửa…'];
