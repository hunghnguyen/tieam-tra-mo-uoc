        cold: { name: 'Gió mùa lướt sóng biển đảo', icon: '🍃', temp: '22°C', desc: 'Gió đông bắc lướt sóng dạt dào se lạnh, tách trà ấm trao tay đong đầy nghĩa đồng bào.' },
        fog: { name: 'Sương mù rạng đông biển Đông', icon: '🌫️', temp: '25°C', desc: 'Sáng sớm chân trời ửng hồng mờ sương, tiệm trà mở cửa đón ngày mới bình yên.' },
        sunny: { name: 'Biển xanh nắng vàng tấc đất thiêng', icon: '🌤️', temp: '31°C', desc: 'Trời trong vắt cờ đỏ sao vàng tung bay kiêu hãnh, 100% khách gửi trọn tin yêu 5 sao.' }
      }
    },
    hanoi: {
      name: 'Thủ đô Hà Nội',
      climate: 'Đồng bằng Bắc Bộ 4 mùa rõ nét: Xuân ẩm nồm, Hạ oi ả, Thu heo may, Đông rét buốt',
      evMap: {
        rain: { name: 'Mưa rào phố cổ', icon: '🌧️', temp: '25°C', desc: 'Mưa rào mát rượi 36 phố phường, đơn online giao tận văn phòng tấp nập.' },
        storm: { name: 'Dông lốc hạ nhiệt thủ đô', icon: '⛈️', temp: '24°C', desc: 'Gió giật làm nghiêng cành lá, khách trú mưa rôm rả tại quầy trà.' },
        hot: { name: 'Nắng hè oi ả phố phường', icon: '☀️', temp: '37°C', desc: 'Nhiệt độ mặt đường tăng cao, khách gọi trà trái cây đá tuyết giải nhiệt đỉnh điểm!' },
        cold: { name: 'Gió mùa Đông Bắc rét căm', icon: '❄️', temp: '13°C', desc: 'Rét buốt tê tái cành bàng, khách co ro gọi trà sữa nóng béo ngậy giao tận chăn ấm.' },
        fog: { name: 'Mưa phùn sương nồm ẩm', icon: '🌫️', temp: '18°C', desc: 'Đặc sản nồm ẩm Bắc Bộ, sương mờ Hồ Gươm, nhâm nhi ly trà nóng ấm lòng.' },
        sunny: { name: 'Nắng thu heo may hoa sữa', icon: '🌤️', temp: '26°C', desc: 'Tiết trời thu Hà Nội đẹp mê hoặc, gió heo may lãng mạn, khách ghé quán đông kín chỗ.' }
      }
    }
  };

  function getRegionProfile(locId) {
    const id = (locId && REGION_CLIMATE[locId]) ? locId : 'hanoi';
    return REGION_CLIMATE[id];
  }

  function getSeasonKey(day) {
    const d = Math.max(1, day || 1);
    const dayInYear = ((d - 1) % 120) + 1; // 1..120
    if (dayInYear <= 30) return 'spring';
    if (dayInYear <= 60) return 'summer';
    if (dayInYear <= 90) return 'autumn';
    return 'winter';
  }

  function getSeason(day) {
    const key = getSeasonKey(day);
    return SEASONS[key] || SEASONS.spring;
  }

  function getDailyWeather(day) {
    const s = getSeason(day);
    const locId = (window.S && window.S.startupLocation) ? window.S.startupLocation : 'hanoi';
    const prof = getRegionProfile(locId);

    // Nếu xem ngày hôm nay và đang có sự kiện thời tiết kích hoạt từ game.js (S.ev)
    const isToday = (window.S && window.S.day === day);
    const curEvId = (isToday && window.S && window.S.ev) ? window.S.ev.id : null;

    if (curEvId && prof.evMap && prof.evMap[curEvId]) {
      const sp = prof.evMap[curEvId];
      let custMul = 1.0, onlMul = 1.0, iceMul = 1.0;
      if (curEvId === 'rain') { custMul = 0.8; onlMul = 1.6; iceMul = 0.8; }
      else if (curEvId === 'storm') { custMul = 0.55; onlMul = 2.0; iceMul = 0.7; }
      else if (curEvId === 'hot') { custMul = 1.35; onlMul = 1.05; iceMul = 1.5; }
      else if (curEvId === 'cold') { custMul = 0.85; onlMul = 1.5; iceMul = 0.45; }
      else if (curEvId === 'fog') { custMul = 0.95; onlMul = 1.25; iceMul = 0.7; }
      else if (curEvId === 'sunny') { custMul = 1.25; onlMul = 1.05; iceMul = 1.1; }

      return {
        seasonKey: s.id,
        seasonName: s.name,
        seasonIcon: s.icon,
        id: `reg_${locId}_${curEvId}`,
        name: sp.name,
        icon: sp.icon,
        temp: sp.temp,
        desc: sp.desc,
        custMul,
        onlMul,
        iceMul,
        regionName: prof.name,
        regionClimate: prof.climate
      };
    }

    // Nếu là ngày thường hoặc xem dự báo ngày mai: Lấy thời tiết ổn định theo seed ngày game + bản sắc vùng miền
    const seed = (day * 9301 + 49297) % 233280;
    const idx = Math.floor((seed / 233280) * s.weathers.length);
    const w = s.weathers[idx] || s.weathers[0];

    // Thích ứng nhiệt độ & mô tả theo vùng miền
    let adaptTemp = w.temp;
    let adaptName = w.name;
    let adaptDesc = w.desc;

    if (locId === 'sapa') {
      // Sa Pa luôn se lạnh / mát lạnh
      if (w.id.includes('hot')) { adaptTemp = '23°C'; adaptName = 'Nắng mát trốn nóng'; adaptDesc = 'Trời mát lạnh trong lành, Sa Pa đón du khách đổ về trốn nóng.'; }
      else if (w.id.includes('cold')) { adaptTemp = '5°C'; adaptName = 'Rét buốt mờ tuyết'; adaptDesc = 'Khí trời lạnh căm, khách thích cầm ly trà nóng hổi sưởi ấm bàn tay.'; }
      else if (w.id.includes('fog')) { adaptTemp = '11°C'; adaptName = 'Sương mờ đỉnh đèo'; adaptDesc = 'Sương phủ trắng xóa, khách ngồi quán ngắm sương nhâm nhi trà thơm.'; }
      else { adaptTemp = '16°C'; }
    } else if (locId === 'hcm' || locId === 'cantho' || locId === 'camau') {
      // Nam Bộ quanh năm ấm áp không có rét buốt
      if (w.id.includes('cold')) { adaptTemp = '24°C'; adaptName = 'Gió chướng se mát'; adaptDesc = 'Tiết trời se lạnh hiếm có, khách rủ nhau đi thưởng trà sữa xôm tụ.'; }
      else if (w.id.includes('fog')) { adaptTemp = '26°C'; adaptName = 'Sương mai bờ sông'; adaptDesc = 'Nắng sớm dịu mát trên sông nước, khách mua trà tươi khởi đầu ngày mới.'; }
      else if (w.id.includes('hot')) { adaptTemp = '36°C'; adaptName = 'Nắng vàng rực rỡ'; adaptDesc = 'Trời nắng chan hòa rực rỡ, trà trái cây và lục trà đá đắt hàng.'; }
      else { adaptTemp = '31°C'; }
    } else if (locId === 'hue') {
      if (w.id.includes('rain')) { adaptTemp = '20°C'; adaptName = 'Mưa dầm xứ Huế'; adaptDesc = 'Mưa dầm rả rích trên sông Hương, khách ghé thưởng trà đàm đạo chuyện xưa.'; }
      else if (w.id.includes('hot')) { adaptTemp = '37°C'; adaptName = 'Nắng rát gió Lào'; adaptDesc = 'Gió phơn khô nóng thổi qua đèo, trà giải nhiệt và nhiều đá cực kỳ đắt khách.'; }
    } else if (locId === 'hoangsa') {
      if (w.id.includes('rain') || w.id.includes('storm')) { adaptTemp = '26°C'; adaptName = 'Mưa gió biển Đông'; adaptDesc = 'Mưa gió biển khơi dạt dào, quán trà là điểm tựa ấm lòng quân dân.'; }
      else { adaptTemp = '31°C'; adaptName = 'Nắng gió biển trời thiêng liêng'; adaptDesc = 'Biển xanh ngắt chan hòa nắng gió đại dương, quán phục vụ trà thơm mát.'; }
    }

    return {
      seasonKey: s.id,
      seasonName: s.name,
      seasonIcon: s.icon,
      ...w,
      temp: adaptTemp,
      name: adaptName,
      desc: adaptDesc,
      regionName: prof.name,
      regionClimate: prof.climate
    };
  }

  // Quản lý Hệ Thống Thời Tiết
  const WeatherSystem = {
    getSeason,
    getDailyWeather,

    getToday() {
      const day = (window.S && S.day) ? S.day : 1;
      return getDailyWeather(day);
    },

    getTomorrow() {
      const day = (window.S && S.day) ? S.day + 1 : 2;
      return getDailyWeather(day);
    },

    // Hiệu ứng thời tiết trực quan trên màn hình bán hàng
    renderSellingFx(container) {
      this.cleanupSellingFx();
      if (!container) return;
      const w = this.getToday();
      
      // Nếu có mưa
      if (w.id.includes('rain') || w.id.includes('shower') || (window.evIs && (evIs('rain') || evIs('storm')))) {
        const rainLayer = document.createElement('div');
        rainLayer.id = 'weatherFxRain';
        rainLayer.className = 'weather-fx-rain-layer';
        for (let i = 0; i < 24; i++) {
          const drop = document.createElement('div');
          drop.className = 'weather-raindrop';
          drop.style.left = (Math.random() * 100) + '%';
          drop.style.animationDuration = (0.55 + Math.random() * 0.45) + 's';
          drop.style.animationDelay = (Math.random() * 0.8) + 's';
          rainLayer.appendChild(drop);
        }
        container.appendChild(rainLayer);
      }
      // Nếu trời nắng gắt
      else if (w.id.includes('sunny') || w.id.includes('hot') || (window.evIs && (evIs('hot') || evIs('sunny')))) {
        const sunLayer = document.createElement('div');
        sunLayer.id = 'weatherFxSun';
        sunLayer.className = 'weather-fx-sun-layer';
        container.appendChild(sunLayer);
      }
    },

    cleanupSellingFx() {
      const r = document.getElementById('weatherFxRain');
      if (r) r.remove();
      const s = document.getElementById('weatherFxSun');
      if (s) s.remove();
    },

    openModal() {
      if (typeof window.ask !== 'function') return;
      const today = this.getToday();
      const tom = this.getTomorrow();
      const season = getSeason((window.S && S.day) || 1);

      const viralDays = (window.S && S.tiktokerViralDays) ? S.tiktokerViralDays : 0;
      const viralBadge = viralDays > 0 ? `
        <div style="background:linear-gradient(135deg,#fe2c55,#ff0050);color:#fff;border-radius:12px;padding:8px 12px;margin-bottom:12px;font-size:0.84rem;font-weight:700;display:flex;align-items:center;gap:8px;box-shadow:0 3px 10px rgba(254,44,85,0.35);">
          <span>🔥</span>
          <div>CLIP TIKTOK TRIỆU VIEW ĐANG TRENDING! Lượng khách hôm nay tăng vọt <b>+35%</b> (Còn ${viralDays} ngày buff)</div>
        </div>
      ` : '';

      const organicBuff = (window.S && S.garden && S.garden.organicBuffDays > 0) ? `
        <div style="background:#ecfdf5;border:1.5px solid #10b981;color:#065f46;border-radius:12px;padding:8px 12px;margin-bottom:12px;font-size:0.84rem;font-weight:700;display:flex;align-items:center;gap:8px;">
          <span>🌿</span>
          <div>Lá Bạc Hà Vườn Nhà: Giá bán mọi ly Trà Trái Cây &amp; Lục Trà được cộng thêm <b>+20%</b> hôm nay!</div>
        </div>
      ` : '';

      const html = `
        <div class="pbig" style="font-size:44px;line-height:1;margin-bottom:6px;">${today.icon}</div>
        <h2 style="margin:2px 0 6px;color:#1e293b;font-size:1.25rem;">THỜI TIẾT &amp; DỰ BÁO TIỆM TRÀ</h2>
        <div style="font-size:0.86rem;color:#64748b;margin-bottom:8px;">Ngày ${window.S ? S.day : 1} · Chu kỳ 4 mùa sống động</div>
        <div style="background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px;padding:6px 12px;margin-bottom:12px;font-size:0.82rem;color:#0369a1;text-align:left;">
          📍 Khởi nghiệp tại: <b>${today.regionName || 'Thủ đô Hà Nội'}</b><br>
          <span style="font-size:0.77rem;color:#0284c7;opacity:0.9;">🌱 ${today.regionClimate || '4 mùa rõ rệt'}</span>
        </div>

        ${viralBadge}
        ${organicBuff}

        <!-- THỜI TIẾT HÔM NAY -->
        <div style="background:#f8fafc;border:2px solid #e2e8f0;border-radius:16px;padding:12px 14px;margin-bottom:10px;text-align:left;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
            <div style="font-size:0.95rem;font-weight:800;color:#0f172a;display:flex;align-items:center;gap:6px;">
              <span>${today.icon}</span> <span>Hôm nay: ${today.name}</span>
            </div>
            <span style="font-weight:800;color:#e11d48;background:#ffe4e6;padding:2px 8px;border-radius:10px;font-size:0.85rem;">${today.temp}</span>
          </div>
          <div style="font-size:0.83rem;color:#475569;line-height:1.45;margin-bottom:6px;">${today.desc}</div>
          <div style="display:flex;gap:6px;flex-wrap:wrap;font-size:0.75rem;">
            <span style="background:#e0f2fe;color:#0369a1;padding:2px 6px;border-radius:6px;font-weight:700;">Khách quầy: x${today.custMul.toFixed(2)}</span>
            <span style="background:#fef3c7;color:#92400e;padding:2px 6px;border-radius:6px;font-weight:700;">Đơn Online: x${today.onlMul.toFixed(2)}</span>
            <span style="background:#f1f5f9;color:#475569;padding:2px 6px;border-radius:6px;font-weight:700;">Tiêu thụ đá: x${today.iceMul.toFixed(2)}</span>
          </div>
        </div>

        <!-- MÙA TRONG NĂM -->
        <div style="background:#fffbeb;border:2px solid #fde68a;border-radius:16px;padding:12px 14px;margin-bottom:10px;text-align:left;">
          <div style="font-size:0.95rem;font-weight:800;color:#92400e;display:flex;align-items:center;gap:6px;margin-bottom:4px;">
            <span>${season.icon}</span> <span>${season.name}</span>
          </div>
          <div style="font-size:0.83rem;color:#78350f;line-height:1.45;">${season.desc}</div>
        </div>

        <!-- DỰ BÁO NGÀY MAI -->
        <div style="background:#f1f5f9;border:1.5px dashed #cbd5e1;border-radius:14px;padding:10px 12px;text-align:left;font-size:0.82rem;color:#475569;">
          🔮 <b>Dự báo ngày mai:</b> ${tom.icon} <b>${tom.name}</b> (${tom.temp}) - ${tom.desc}
        </div>
      `;

      window.ask(html, [['Đã hiểu, cảm ơn', () => {}, 1]]);
    }
  };

  // 2. FOOD TIKTOKER / REVIEWER TRIỆU VIEW ĐỘT XUẤT
  const TIKTOKER_CHANNELS = [
    { name: 'Khoai Mê Trà Sữa 🧋', followers: '2.5M', quote: 'Chào cả nhà, nay cùng Khoai ghé thẩm quán trà sữa hot hit này nha!', channel: '@khoaitrasua_official' },
    { name: 'Hôm Nay Ăn Gì? 🎬', followers: '1.8M', quote: 'Hello các bác! Nghe đồn quán này trân châu tự nấu mềm dẻo đỉnh chóp, để tôi test liền!', channel: '@homnayangi_review' },
    { name: 'Cô Gái Có Nơ Mỏ Khoét 🎀', followers: '1.2M', quote: 'Ghé thẩm quán theo yêu cầu của 500 anh em! Camera zoom cận cảnh từng giọt kem cheese luôn nè!', channel: '@mocuakhauvi' },
    { name: 'Food Tour Sài Gòn Phố 🛵', followers: '950K', quote: 'Quán ruột của tui đây rồi! Cùng xem tay nghề chủ quán hôm nay có giữ vững phong độ không nhé!', channel: '@saigonfoodtour' }
  ];

  const TiktokerSystem = {
    // Kiểm tra xem khách có phải là Food Tiktoker không
    checkShouldSpawn(day) {
      if (window.R && window.R.tiktokerTodayDone) return false;
      // Nếu có event reviewer hoặc có tỉ lệ đột xuất 20% mỗi ngày
      const isEvent = typeof window.evIs === 'function' && window.evIs('reviewer');
      if (isEvent) return true;
      if (day >= 2 && Math.random() < 0.20) return true;
      return false;
    },

    getRandomTiktoker() {
      const idx = Math.floor(Math.random() * TIKTOKER_CHANNELS.length);
      return TIKTOKER_CHANNELS[idx];
    },

    // Khi phục vụ xong cho Tiktoker
    onServed(c, isCorrect) {
      if (!c || !c.isTiktoker) return;
      const t = c.tiktokerInfo || TIKTOKER_CHANNELS[0];
      if (isCorrect) {
        // Nhận clip viral triệu view
        if (!window.S.tiktokerViralDays) window.S.tiktokerViralDays = 0;
        window.S.tiktokerViralDays = Math.max(window.S.tiktokerViralDays, 2); // Buff 2 ngày

        const sponsorMoney = 300000 + Math.floor(Math.random() * 300000);
        window.S.money = (window.S.money || 0) + sponsorMoney;
        if (window.S.cur) {
          window.S.cur.gift = (window.S.cur.gift || 0) + sponsorMoney;
        }
        if (window.S.totalRev) window.S.totalRev += sponsorMoney;

        setTimeout(() => {
          if (typeof window.toast === 'function') {
            window.toast(`🔥 CLIP TIKTOK CỦA ${t.name} ĐẠT 1M VIEW! Kênh tài trợ nóng +${fmt(sponsorMoney)} và quán được buff +35% khách trong 2 ngày tới! 🎉`, 6000, 1);
          }
        }, 1200);
      } else {
        setTimeout(() => {
          if (typeof window.toast === 'function') {
            window.toast(`🎬 ${t.name} đăng clip review: "Hụt hẫng vì phục vụ sai món..." Quán cần chú ý hơn nha! 🥺`, 5000);
          }
        }, 1200);
      }
    }
  };

  window.WeatherSystem = WeatherSystem;
  window.TiktokerSystem = TiktokerSystem;

})();
