function getMaxSlots(){
  if(S && S.upg && S.upg.floor2) return 10;
  if(S && S.upg && S.upg.slot4) return 6;
  return 3;
}
const maxP = getMaxSlots;
Object.defineProperty(window, 'S', {
  get: () => S,
  set: (v) => { S = v; },
  configurable: true
});
window.getMoney = () => (S && typeof S.money === 'number') ? S.money : 0;
window.setMoney = (m) => { if (S) { S.money = m; head(); save(); } };
window.recordGamble = (won, lost) => {
  if (!S) return;
  if (won > 0) S.gambleWon = (S.gambleWon || 0) + won;
  if (lost > 0) S.gambleLost = (S.gambleLost || 0) + lost;
  S.gambleNet = (S.gambleWon || 0) - (S.gambleLost || 0);
  save();
};
function migrate(d){const u=d.unlocked||{};
  if(u.dao&&!u.f_dao){S.unlocked.hong=true;S.unlocked.f_dao=true}
  if(u.dau&&!u.f_dau)S.unlocked.f_dau=true;
  const refund={khoaimon:250000,tctrang:200000,pudding:250000,kemtrung:400000};
  Object.keys(refund).forEach(k=>{if(u[k])S.money+=refund[k]});
  ['khoaimon','dau','dao','tctrang','pudding','kemtrung','tradao','travai','chomchom','hatdac','hatchia','chanmeo','S'].forEach(k=>{delete S.stock[k];delete S.unlocked[k];delete S.sell[k]});
}
function calcTotalProfit(){
  const H = (typeof S !== 'undefined' && S && S.history) ? S.history : [];
  let profOp = 0;
  if(Array.isArray(H) && H.length > 0){
    profOp = H.reduce((a, rec) => {
      if(!rec) return a;
      const ingV = Object.values(rec.ing || {}).reduce((s, x) => s + (x && x.v ? Number(x.v) || 0 : 0), 0);
      const opC = (Number(rec.rent) || 0) + (Number(rec.util) || 0) + (Number(rec.wage) || 0) + (Number(rec.bad) || 0) + (Number(rec.loanInt) || 0) + (Number(rec.fee) || 0) + (Number(rec.tax) || 0) + ingV;
      const branchGain = (Number(rec.branchNet) || 0) + (Number(rec.franchiseNet) || 0);
      const rev = typeof recRev === 'function' ? recRev(rec) : (Object.values(rec.sales || {}).reduce((sa, sx) => sa + (sx && sx.a ? Number(sx.a) || 0 : 0), 0) + (Number(rec.tips) || 0));
      return a + Math.max(0, rev - opC + branchGain);
    }, 0);
  }
  if(typeof S !== 'undefined' && S && S.cur){
    const curIngV = Object.values(S.cur.ing || {}).reduce((s, x) => s + (x && x.v ? Number(x.v) || 0 : 0), 0);
    const curOpC = (Number(S.cur.rent) || 0) + (Number(S.cur.util) || 0) + (Number(S.cur.wage) || 0) + (Number(S.cur.bad) || 0) + (Number(S.cur.loanInt) || 0) + (Number(S.cur.fee) || 0) + (Number(S.cur.tax) || 0) + curIngV;
    const curRev = typeof recRev === 'function' ? recRev(S.cur) : (Object.values(S.cur.sales || {}).reduce((sa, sx) => sa + (sx && sx.a ? Number(sx.a) || 0 : 0), 0) + (Number(S.cur.tips) || 0));
    profOp += Math.max(0, curRev - curOpC);
  }
  const minEst = Math.round((Number(typeof S !== 'undefined' && S && S.totalRev) || 0) * 0.35);
  const curStored = Number(typeof S !== 'undefined' && S && S.totalProfit) || 0;
  const finalProfit = Math.max(0, profOp, minEst, curStored);
  return isFinite(finalProfit) ? finalProfit : 0;
}
function calc7DayAvgProfit(){
  if(typeof S === 'undefined' || !S) return 0;
  const H = Array.isArray(S.history) ? S.history : [];
  const recentDays = H.slice(-7);
  
  if(recentDays.length === 0){
    if(S.cur){
      const curIngV = Object.values(S.cur.ing || {}).reduce((s, x) => s + (x && x.v ? Number(x.v) || 0 : 0), 0);
      const curOpC = (Number(S.cur.rent) || 0) + (Number(S.cur.util) || 0) + (Number(S.cur.wage) || 0) + (Number(S.cur.bad) || 0) + (Number(S.cur.loanInt) || 0) + (Number(S.cur.fee) || 0) + (Number(S.cur.tax) || 0) + curIngV;
      const curRev = typeof recRev === 'function' ? recRev(S.cur) : (Object.values(S.cur.sales || {}).reduce((sa, sx) => sa + (sx && sx.a ? Number(sx.a) || 0 : 0), 0) + (Number(S.cur.tips) || 0));
      return Math.max(0, curRev - curOpC);
    }
    return 0;
  }

  let totalProf7 = 0;
  recentDays.forEach(rec => {
    if(!rec) return;
    const ingV = Object.values(rec.ing || {}).reduce((s, x) => s + (x && x.v ? Number(x.v) || 0 : 0), 0);
    const opC = (Number(rec.rent) || 0) + (Number(rec.util) || 0) + (Number(rec.wage) || 0) + (Number(rec.bad) || 0) + (Number(rec.loanInt) || 0) + (Number(rec.fee) || 0) + (Number(rec.tax) || 0) + ingV;
    const branchGain = (Number(rec.branchNet) || 0) + (Number(rec.franchiseNet) || 0);
    const rev = typeof recRev === 'function' ? recRev(rec) : (Object.values(rec.sales || {}).reduce((sa, sx) => sa + (sx && sx.a ? Number(sx.a) || 0 : 0), 0) + (Number(rec.tips) || 0));
    totalProf7 += Math.max(0, rev - opC + branchGain);
  });

  return Math.round(totalProf7 / recentDays.length);
}
function getOneStarReviewCount(){
  if(typeof S === 'undefined' || !S) return 0;
  const dist = (typeof getOrInitRevDistribution === 'function') ? getOrInitRevDistribution() : (S.revDist || {});
  const fromDist = (dist && typeof dist[1] === 'number') ? dist[1] : 0;
  const fromList = Array.isArray(S.reviews) ? S.reviews.filter(r => r && r.s === 1).length : 0;
  return Math.max(fromDist, fromList, 0);
}

function calc7DayStaffTips(){
  if(typeof S === 'undefined' || !S) return 0;
  const H = Array.isArray(S.history) ? S.history : [];
  const recentDays = H.slice(-7);
  let total = 0;
  recentDays.forEach(rec => {
    if(!rec) return;
    total += (Number(rec.staffTip) || Number(rec.wageBonus) || 0);
  });
  if(S.cur && Number(S.cur.staffTip) > 0){
    total += Number(S.cur.staffTip);
  }
  return total;
}

function calcAvgUpgLevel(){
  if(typeof S === 'undefined' || !S || !S.upgLv) return 0;
  const keys = ['tra', 'huong', 'top', 'equip', 'staff', 'onl'];
  let sum = 0;
  keys.forEach(k => {
    let lv = Number(S.upgLv[k]) || 0;
    if(lv > 80) lv = 80;
    sum += Math.max(0, lv);
  });
  return Math.round((sum / keys.length) * 10) / 10;
}

function getRecServedCount(rec){
  if(!rec || typeof rec !== 'object') return 0;
  const explicitServed = Math.max(0, parseInt(rec.served, 10) || 0);
  let salesCups = 0;
  if(rec.sales && typeof rec.sales === 'object'){
    const bKeys = (typeof BASE_KEYS !== 'undefined' && Array.isArray(BASE_KEYS)) ? BASE_KEYS : ['black', 'green', 'oolong', 'roasted', 'hong', 'luc', 'olong', 'lai', 'tra', 'thai'];
    bKeys.forEach(k => {
      if(rec.sales[k] && rec.sales[k].q) salesCups += (parseInt(rec.sales[k].q, 10) || 0);
    });
    if(rec.sales.lobby_dining && rec.sales.lobby_dining.q){
      salesCups += (parseInt(rec.sales.lobby_dining.q, 10) || 0);
    }
  }
  return Math.max(explicitServed, salesCups);
}

/* ===== TRẦN DOANH THU NGÀY & TRẦN KÉT TIỀN MẶT AN TOÀN TĂNG ĐỘNG THEO NGÀY CHƠI (v12.47.588) ===== */
function getDynamicDayServedCap(dayOverride){
  const d = Math.max(1, parseInt(dayOverride != null ? dayOverride : (typeof S !== 'undefined' && S && S.day), 10) || 1);
  // Đồng bộ 100% công thức trần vật lý với Anti-Cheat Rule 3 & Supabase SQL (GEMINI.md Mục 7)
  return Math.min(7000, Math.round(500 + d * 2.5));
}
window.getDynamicDayServedCap = getDynamicDayServedCap;

function getDynamicDayCupRevCap(dayOverride){
  const d = Math.max(1, parseInt(dayOverride != null ? dayOverride : (typeof S !== 'undefined' && S && S.day), 10) || 1);
  // Khởi điểm 300.000đ/ly ở Ngày 1, tăng thêm +60đ/ly mỗi ngày lên tối đa 420.000đ/ly (ở Ngày 2.000+), khớp 100% với Supabase SQL
  return Math.min(420000, Math.round(300000 + Math.max(0, d - 1) * 60));
}
window.getDynamicDayCupRevCap = getDynamicDayCupRevCap;

function getDynamicDayRevCeiling(dayOverride, servedOverride){
  const d = Math.max(1, parseInt(dayOverride != null ? dayOverride : (typeof S !== 'undefined' && S && S.day), 10) || 1);
  const maxServed = servedOverride != null
    ? Math.max(0, parseInt(servedOverride, 10) || 0)
    : getDynamicDayServedCap(d);
  return Math.round(maxServed * getDynamicDayCupRevCap(d));
}
window.getDynamicDayRevCeiling = getDynamicDayRevCeiling;

function getSafeCashCeiling(dayOverride){
  const d = Math.max(1, parseInt(dayOverride != null ? dayOverride : (typeof S !== 'undefined' && S && S.day), 10) || 1);
  // Khởi điểm 3 Tỷ ở Ngày 1, tăng thêm +20 Triệu/ngày lên tối đa 30 Tỷ (ở Ngày 1.351+), đồng thời tự động nới theo 1.5x kỷ lục doanh thu ngày của quán
  const byDay = 3000000000 + Math.max(0, d - 1) * 20000000;
  const bestDayRevFloor = (typeof S !== 'undefined' && S && S.bestDayRev > 0) ? Math.round(Number(S.bestDayRev) * 1.5) : 0;
  return Math.min(30000000000, Math.max(byDay, bestDayRevFloor));
}
window.getSafeCashCeiling = getSafeCashCeiling;

function getSafeCashTiers(dayOverride){
  const lowCap = getSafeCashCeiling(dayOverride);
  const midCap = Math.max(6000000000, Math.round(lowCap * 1.5));
  const highCap = Math.max(12000000000, Math.round(lowCap * 2.5));
  const megaCap = Math.max(30000000000, Math.round(lowCap * 4.0));
  return { lowCap, midCap, highCap, megaCap };
}
window.getSafeCashTiers = getSafeCashTiers;

// Chỉ xét lượng tiền mặt tồn từ ĐẦU CA (startCash) khi đang trong ca bán hoặc lúc kết thúc ca (finishEndDay).
// Tuyệt đối KHÔNG tính phần doanh thu (3 Tỷ - 5 Tỷ+) vừa kiếm được trong ca hôm nay trước khi người chơi kịp sang ngày mới để gửi Tà Tưa Bank!
function getEffectiveHoardCash(cashOverride){
  if(typeof S === 'undefined' || !S) return 0;
  const rawCash = cashOverride != null ? Math.max(0, Number(cashOverride) || 0) : Math.max(0, Number(S.money) || 0);
  const inShiftOrEndDay = !!(typeof R !== 'undefined' && R && (R.running || R.mode === 'sell' || R._inFinishEndDay));
  if(inShiftOrEndDay && S.cur && S.cur.startCash != null){
    const startCash = Math.max(0, Number(S.cur.startCash) || 0);
    return Math.min(rawCash, startCash);
  }
  return rawCash;
}
window.getEffectiveHoardCash = getEffectiveHoardCash;

function calcEffectiveBestDayStats(){
  if(typeof S === 'undefined' || !S) return { dayServed: 0, dayRev: 0 };
  const validDay = Math.max(1, parseInt(S.day, 10) || 1);
  const totalServed = Math.max(0, parseInt(S.served != null ? S.served : (S.best || 0), 10) || 0);
  const totalRev = Math.max(0, parseInt(S.totalRev, 10) || 0);
  const hadStoredBestServed = (parseInt(S.bestDayServed, 10) || 0) > 0;

  let bestServed = Math.max(0, parseInt(S.bestDayServed, 10) || 0);
  let bestRev = Math.max(0, parseInt(S.bestDayRev, 10) || 0);

  if(typeof R !== 'undefined' && R && R.today){
    bestServed = Math.max(bestServed, parseInt(R.today.served, 10) || 0);
    bestRev = Math.max(bestRev, parseInt(R.today.rev, 10) || 0);
  }
  if(S.cur){
    bestServed = Math.max(bestServed, getRecServedCount(S.cur));
    const curRev = (typeof recRev === 'function' ? recRev(S.cur) : 0) || 0;
    bestRev = Math.max(bestRev, Math.round(curRev));
  }
  if(Array.isArray(S.history)){
    for(let i = 0; i < S.history.length; i++){
      const h = S.history[i];
      if(!h) continue;
      bestServed = Math.max(bestServed, getRecServedCount(h));
      const hRev = (typeof recRev === 'function' ? recRev(h) : 0) || 0;
      bestRev = Math.max(bestRev, Math.round(hRev));
    }
  }

  // Khôi phục thông minh cho file lưu cũ chưa từng lưu S.bestDayServed dù đã bán nhiều ly
  if((!hadStoredBestServed || bestServed === 0) && (totalServed > 0 || bestRev > 0)){
    const avgCupPrice = (totalServed > 0 && totalRev > 0) ? Math.min(135000, Math.max(30000, totalRev / totalServed)) : 65000;
    const estFromBestRev = bestRev > 0 ? Math.max(1, Math.round(bestRev / avgCupPrice), Math.ceil(bestRev / 145000)) : 0;
    const completedDays = Math.max(1, validDay > 1 ? validDay - 1 : 1);
    const estFromAvgServed = totalServed > 0 ? Math.max(1, Math.round(totalServed / completedDays)) : 0;
    bestServed = Math.max(bestServed, estFromBestRev, estFromAvgServed);
  }
  if(bestRev === 0 && bestServed > 0){
    const avgCupPrice = (totalServed > 0 && totalRev > 0) ? Math.min(135000, Math.max(30000, totalRev / totalServed)) : 55000;
    bestRev = Math.round(bestServed * avgCupPrice);
  }

  const maxAllowedServed = getDynamicDayServedCap(validDay);
  if(validDay >= 3 && totalServed >= 100 && bestServed > totalServed){
    bestServed = totalServed;
  }
  if(bestServed > maxAllowedServed) bestServed = maxAllowedServed;

  if(bestServed > 0){
    const dynamicCupCap = getDynamicDayCupRevCap(validDay);
    const maxFeasibleRev = Math.round(bestServed * dynamicCupCap);
    if(bestRev > maxFeasibleRev) bestRev = maxFeasibleRev;
  } else if(bestRev > 0 && bestServed === 0){
    bestRev = 0;
  }

  S.bestDayServed = bestServed;
  S.bestDayRev = bestRev;
  return { dayServed: bestServed, dayRev: bestRev };
}

function loadFrom(d){
  if(!d||typeof d!=='object')return;
  const hasBranchRevCounter = Object.prototype.hasOwnProperty.call(d, 'totalBranchRev') && d.totalBranchRev != null;
  const hasBranchNetCounter = Object.prototype.hasOwnProperty.call(d, 'totalBranchNet') && d.totalBranchNet != null;
  const f=fresh();
  d.stock=d.stock||{};
  Object.keys(d.stock).forEach(k=>{
    if(typeof d.stock[k]==='number'){
      const q=d.stock[k];
      d.stock[k]= q > 0 ? [{ q, exp: 99999 }] : [];
    } else if(!Array.isArray(d.stock[k])){
      d.stock[k] = [];
    }
  });
  d.sell=d.sell||{};
  d.unlocked=d.unlocked||{};
  d.upg=d.upg||{};
  S={...f,...d,stock:{...f.stock,...d.stock},sell:{...f.sell,...d.sell},unlocked:{...f.unlocked,...d.unlocked},upg:{...f.upg,...d.upg}};
  S.totalBranchRev = Math.max(0, Number(S.totalBranchRev) || 0);
  S.totalBranchNet = Number(S.totalBranchNet) || 0;
  S.historyLengthTotal = Math.max(0, Number(S.historyLengthTotal) || Number(S._restoredHistoryLen) || Number(S._compactHistoryLength) || 0, (Number(S.day) || 1) - 1, Array.isArray(S.history) ? S.history.length : 0);
  S._legacyBranchRevCountersMissing = !!d._legacyBranchRevCountersMissing || !hasBranchRevCounter;
  S._legacyBranchNetCountersMissing = !!d._legacyBranchNetCountersMissing || !hasBranchNetCounter;
  S.realEstate = S.realEstate || (d.realEstate ? d.realEstate : { main: false, branches: {} });
  S.realEstate.branches = S.realEstate.branches || {};
  
  if(typeof ITEMS !== 'undefined'){
    Object.keys(ITEMS).forEach(k => {
      if(!Array.isArray(S.stock[k])) S.stock[k] = [];
    });
  }
  if(!Array.isArray(S.stock.ice)) S.stock.ice = [];
  if(!Array.isArray(S.stock.sugar)) S.stock.sugar = [];
  if(!Array.isArray(S.stock.cup)) S.stock.cup = [];

  S.history = Array.isArray(S.history) ? S.history : [];
  if(Array.isArray(S.history) && S.history.length > 0){
    const lastRec = S.history[S.history.length - 1];
    if(lastRec && typeof lastRec.day === 'number' && S.day === lastRec.day + 2){
      const curEmpty = !S.cur || ((!S.cur.served || S.cur.served === 0) && (!S.cur.sales || Object.keys(S.cur.sales).length === 0));
      if(curEmpty){
        console.log(`[Auto-Repair] Phát hiện ngày bị nhảy cóc từ ngày ${lastRec.day} sang ngày ${S.day}. Khôi phục về ngày ${lastRec.day + 1}.`);
        S.day = lastRec.day + 1;
        S.cur = newRec(S.day);
        rollDay(S.day);
      }
    }
  }
  S.equipLv = S.equipLv || { binhrot:1, sealer: (S.upg && S.upg.sealer) ? 1 : 1, khaytop:1, lyduongda:1 };
  if(S.equipLv.binhrot == null) S.equipLv.binhrot = 1;
  if(S.equipLv.sealer == null) S.equipLv.sealer = (S.upg && S.upg.sealer) ? 1 : 1;
  if(S.equipLv.khaytop == null) S.equipLv.khaytop = 1;
  S.equipBroken = S.equipBroken || {};
  if(S.equipLv.sealer >= 1){
    S.upg = S.upg || {};
    if(S.equipBroken.sealer || S.upg.sealer === false){
      S.equipBroken.sealer = true;
      S.upg.sealer = false;
    } else {
      S.upg.sealer = true;
    }
  }
  try{migrate(d);}catch(e){console.error('migrate error',e);}
  if(S.stock&&S.stock.cup){
    const totCup=Array.isArray(S.stock.cup)?S.stock.cup.reduce((a,x)=>a+(x&&x.q||0),0):0;
    S.stock.cup=totCup>0?[{q:totCup,exp:99999}]:[];
  }
  // Bảo toàn 100% nguyên liệu trà khô trong kho khi nạp tiến trình / cập nhật phiên bản mới
  if(typeof BASE_KEYS !== 'undefined' && Array.isArray(BASE_KEYS)){
    BASE_KEYS.forEach(k => {
      if(S.stock && S.stock[k]){
        const totTea = Array.isArray(S.stock[k]) ? S.stock[k].reduce((a,x)=>a+(x&&x.q||0),0) : (typeof S.stock[k] === 'number' ? S.stock[k] : 0);
        if(totTea > 0){
          S.stock[k] = [{ q: totTea, exp: 99999 }];
        }
      }
    });
  }
  if(!d.cur)S.cur=newRec(S.day);
  if(S.seenLv==null)S.seenLv=levelOf(Math.max(1,S.day-1));
  if(S.evDay!==S.day)rollDay(S.day);
  S.hired=S.hired||{};
  S.upg=S.upg||{};
  if(typeof STAFF !== 'undefined' && Array.isArray(STAFF)){
    STAFF.forEach(x=>{if(S.upg[x.id])S.hired[x.id]=true});
  }
  if(S.upg.guard1&&S.upg.guard2)S.upg.guard1=false;
  if(S.upg.staff1&&S.upg.staff3)S.upg.staff3=false;
  if(S.upg.staffRacer&&S.upg.staffBuyer)S.upg.staffBuyer=false;
  if(S.upg.staffGz&&S.upg.staff1){S.upg.staff1=false;}
  if(S.upg.staffSv&&S.upg.staff1){S.upg.staff1=false;}
  if(S.online&&(!S.tablets||S.tablets<1))S.tablets=1;
  if(S.online){S.apps=S.apps||{};S.apps.sp=true;S.apps.tt=true;S.apps.be=true;S.apps.gr=true;}
  S.apps=S.apps||{};
  S.staffKpi= (S.staffKpi && typeof S.staffKpi === 'object') ? S.staffKpi : {};
  Object.keys(S.staffKpi).forEach(k=>{if(S.staffKpi[k]){S.staffKpi[k].trafficBuff=0;S.staffKpi[k].speedBuff=S.staffKpi[k].speedBuff||0;}});
  S.staffSalesDays=S.staffSalesDays||0;
  S.kpiPeriodStats= (S.kpiPeriodStats && typeof S.kpiPeriodStats === 'object') ? S.kpiPeriodStats : {};
  S.staffNames= (S.staffNames && typeof S.staffNames === 'object') ? S.staffNames : {};
  S.staffQuitNotices= (S.staffQuitNotices && typeof S.staffQuitNotices === 'object') ? S.staffQuitNotices : {};
  S.staffOffDay= (S.staffOffDay && typeof S.staffOffDay === 'object') ? S.staffOffDay : {};
  S.staffUnpaidDays= (S.staffUnpaidDays && typeof S.staffUnpaidDays === 'object') ? S.staffUnpaidDays : {};
  if(S.staffTraining && typeof S.staffTraining === 'object'){
    Object.keys(S.staffTraining).forEach(stId => {
      if((parseInt(S.staffTraining[stId], 10) || 0) >= 4){
        if(S.staffQuitNotices && S.staffQuitNotices[stId]) delete S.staffQuitNotices[stId];
        if(stId === 'staffOn' && S.staffOnLeaveNotice) delete S.staffOnLeaveNotice;
      }
    });
  }
  if(S.staffTraining && (parseInt(S.staffTraining.staffGuard, 10) || 0) >= 5){
    if(S.guardRestDay != null || S.guardRestUntil != null || (S.hired && S.hired.staffGuard && S.upg && !S.upg.staffGuard)){
      delete S.guardRestDay;
      delete S.guardRestUntil;
      S.guardWorkStreak = 0;
      if(S.hired && S.hired.staffGuard && S.upg) S.upg.staffGuard = true;
    }
  } else if(S.guardRestDay != null && S.guardRestDay !== S.day){
    delete S.guardRestDay;
    delete S.guardRestUntil;
    if(S.hired && S.hired.staffGuard && S.upg) S.upg.staffGuard = true;
  }
  if(typeof STAFF !== 'undefined' && Array.isArray(STAFF)){
    STAFF.forEach(x=>{if(S.hired[x.id]&&!S.staffNames[x.id])S.staffNames[x.id]=genName()});
    S.staffAvatars= (S.staffAvatars && typeof S.staffAvatars === 'object') ? S.staffAvatars : {};
    STAFF.forEach(x=>{if(S.staffAvatars[x.id]&&S.staffAvatars[x.id].includes('img/nv/b'))delete S.staffAvatars[x.id];if(S.hired[x.id]&&!S.staffAvatars[x.id]){const used=Object.values(S.staffAvatars);S.staffAvatars[x.id]=genStaffAvatar(used);}});
  }
  try{syncFlav();}catch(e){}
  try{S.totalProfit=calcTotalProfit();}catch(e){}
  try{calcEffectiveBestDayStats();}catch(e){}
  if(!(d.lifeV>=3)){
    if(typeof ITEMS !== 'undefined'){
      Object.keys(ITEMS).forEach(k=>{if(Array.isArray(S.stock[k])){S.stock[k].forEach(b=>{if(b&&b.exp<99999)b.exp=Math.max(b.exp,S.day+30)})}});
    }
    S.lifeV=3;save();
  }
  try{sanitize()}catch(e){}
  if(Array.isArray(S.reviews)){
    S.reviews.forEach(r=>{
      if(r && typeof r === 'object'){
        if(!r.k)r.k=safeStripEmoji(r.t||'');
        if(Array.isArray(r.tp))r.tp=r.tp.map(normIngKey).filter(Boolean);
      }
    });
  } else {
    S.reviews = [];
  }
  if(!d.badPlan){S.badPlan=mkBadPlan(S.day);save()};
  S.friends=Array.isArray(S.friends)?S.friends:[];
  S.myCard=S.myCard||null;
  S.redeemedCodes=Array.isArray(S.redeemedCodes)?S.redeemedCodes:[];
  S.trophies=Array.isArray(S.trophies)?S.trophies:[];
  S.giftsReceivedToday=S.giftsReceivedToday||0;
  S.giftsDay=S.giftsDay||S.day;
  S.freeDrinkQueue=Array.isArray(S.freeDrinkQueue)?S.freeDrinkQueue:[];
  try{initExtraState();}catch(e){console.error('initExtraState error',e);}
  try{
    const verifiedRevenue = calcVerifiedCumulativeRevenue(S);
    if(S._legacyBranchRevCountersMissing) S.totalBranchRev = Math.max(Number(S.totalBranchRev) || 0, Number(verifiedRevenue.branchRev) || 0);
    if(S._legacyBranchNetCountersMissing) S.totalBranchNet = Number(verifiedRevenue.branchNet) || 0;
    else S.totalBranchNet = Math.max(Number(S.totalBranchNet) || 0, Number(verifiedRevenue.branchNet) || 0);
    S.historyLengthTotal = Math.max(Number(S.historyLengthTotal) || 0, Array.isArray(S.history) ? S.history.length : 0, (Number(S.day) || 1) - 1);
    S._legacyBranchRevCountersMissing = false;
    S._legacyBranchNetCountersMissing = false;
  } catch(e) { console.warn('Khôi phục tổng doanh thu chuỗi:', e); }
  try{if(window.BanBe)window.BanBe.init();}catch(e){console.error('BanBe init error',e);}
  try{if(window.Collection){if(typeof window.Collection.checkMilestones==='function')window.Collection.checkMilestones();if(typeof window.Collection.updateBadge==='function')window.Collection.updateBadge();}}catch(e){console.error('Collection init error',e);}
  try{if(typeof isStaffActive === 'function' && isStaffActive('staffButler') && typeof staffButlerAutoBestSellerPricing === 'function') staffButlerAutoBestSellerPricing();}catch(e){}
}
function isUnstartedDay1Save(d){
  if(!d || typeof d !== 'object') return true;
  const day = parseInt(d.day, 10) || 1;
  const served = parseInt(d.served != null ? d.served : d.best, 10) || 0;
  const totalRev = Number(d.totalRev) || 0;
  const histLen = Array.isArray(d.history) ? d.history.length : 0;
  const hasName = !!(d.shopName && String(d.shopName).trim());
  const curServed = (d.cur && parseInt(d.cur.served, 10)) || 0;
  return day <= 1 && served <= 0 && totalRev <= 0 && histLen <= 0 && curServed <= 0 && !hasName;
}
function getSaveProgressScore(d){
  if(!d || typeof d !== 'object') return -1;
  if(isUnstartedDay1Save(d)) return 0;
  const day = Math.max(1, parseInt(d.day, 10) || 1);
  const served = Math.max(0, parseInt(d.served != null ? d.served : d.best, 10) || 0);
  const totalRev = Math.max(0, Number(d.totalRev) || 0);
  return day * 1e9 + served * 1e3 + Math.min(999, Math.floor(totalRev / 1e6));
}
function load(){
  // verifyDevNoticeIntegrity();
  const candKeys = [SAVE, 'tsBak1', 'tsBak2', 'tsBak3', SAVE + '_rescue', SAVE + '_before_restore', SAVE + '_persist'];
  const validSaves = [];
  for(let k of candKeys){
    try{
      const raw = localStorage.getItem(k);
      if(!raw) continue;
      const d = JSON.parse(raw);
      if(d && (d.stock || d.day || d.money != null)){
        validSaves.push({ key: k, raw, d, score: getSaveProgressScore(d) });
      }
    }catch(e){
      console.warn('Không thể đọc dữ liệu từ ' + k, e);
    }
  }
  // Nếu SAVE chính bị ghi đè bởi bản Ngày 1 chưa chơi nhưng trong các bản sao lưu (tsBak1..3, _persist, _rescue) vẫn còn bản chơi thật có tiến trình cao hơn -> Tự động ưu tiên khôi phục bản có tiến trình cao nhất!
  validSaves.sort((a, b) => {
    if((a.score > 0) !== (b.score > 0)) return (b.score > 0 ? 1 : 0) - (a.score > 0 ? 1 : 0);
    if(a.key === SAVE && b.score <= a.score * 1.05 && a.score > 0) return -1;
    if(b.key === SAVE && a.score <= b.score * 1.05 && b.score > 0) return 1;
    return b.score - a.score;
  });
  for(let cand of validSaves){
    if(cand.score <= 0) continue; // Bỏ qua bản Ngày 1 trống rỗng tự sinh chưa khai trương
    try{
      loadFrom(cand.d);
      try{
        localStorage.setItem(SAVE, cand.raw);
        if((S.day || 1) > 1 || (S.served || 0) > 0){
          localStorage.setItem(SAVE + '_persist', cand.raw);
        }
      }catch(e){}
      return true;
    }catch(e){
      console.warn('Không thể nạp dữ liệu từ ' + cand.key, e);
    }
  }
  // Nếu chỉ có bản Ngày 1 trống chưa đặt tên / chưa bán ly nào (do auto-save nhầm lúc khởi động trước đây) -> Xoá bản trống để hiện đúng màn hình Bắt đầu / Khôi phục mã sao lưu
  if(validSaves.length > 0 && validSaves.every(x => x.score <= 0)){
    try { localStorage.removeItem(SAVE); } catch(e){}
  } else {
    try{
      const oldRaw = localStorage.getItem(SAVE);
      if(oldRaw && oldRaw.length > 30){
        localStorage.setItem(SAVE + '_rescue', oldRaw);
        R.loadErr = true;
      }
    }catch(e){}
  }
  S = fresh();
  rollDay(1);
  return false;
}

/* ---------- HỆ THỐNG TRANG BỊ QUẦY PHA CHẾ 3 CẤP ĐỘ ---------- */
const EQUIP3_CFG = {
  binhrot: {
    id: 'binhrot',
    title: 'Bình rót trà',
    icon: (sz=38) => `<img src="img/brt.jpg" width="${sz}" height="${sz}" style="object-fit:cover;border-radius:${sz > 30 ? 10 : 6}px;" alt="">`,
    levels: [
      { lv: 1, name: 'Hũ trà thủy tinh', desc: 'Rót trà nhanh hơn 10%' },
      { lv: 2, name: 'Bình rót inox vòi lớn', desc: 'Rót trà nhanh hơn 20%', cost: 10000000 },
      { lv: 3, name: 'Máy chiết trà áp suất cao', desc: 'Rót trà nhanh hơn 40%', cost: 50000000 }
    ]
  },
  sealer: {
    id: 'sealer',
    title: 'Máy dán nắp',
    icon: (sz=38) => `<img src="img/mdn.jpg" width="${sz}" height="${sz}" style="object-fit:cover;border-radius:${sz > 30 ? 10 : 6}px;" alt="">`,
    levels: [
      { lv: 1, name: 'Máy dán nắp tự động', desc: 'Pha đúng món nhận tip 30%' },
      { lv: 2, name: 'Máy dán nắp siêu tốc C2', desc: 'Pha đúng món nhận tip 40%', cost: 10000000 },
      { lv: 3, name: 'Máy dán nắp thông minh C3', desc: 'Pha đúng món nhận tip 50%', cost: 50000000 }
    ]
  },
  khaytop: {
    id: 'khaytop',
    title: 'Khay topping',
    icon: (sz=38) => `<img src="img/ktp.jpg" width="${sz}" height="${sz}" style="object-fit:cover;border-radius:${sz > 30 ? 10 : 6}px;" alt="">`,
    levels: [
      { lv: 1, name: 'Khay inox', desc: 'Tăng hạn sử dụng nguyên liệu lên 1 ngày' },
      { lv: 2, name: 'Khay giữ nhiệt ủ lạnh', desc: 'Tăng hạn sử dụng nguyên liệu lên 2 ngày', cost: 10000000 },
      { lv: 3, name: 'Khay bảo quản chân không', desc: 'Tăng hạn sử dụng nguyên liệu lên 3 ngày', cost: 50000000 }
    ]
  },
  lyduongda: {
    id: 'lyduongda',
    title: 'Ly, đường, đá',
    icon: (sz=38) => `<img src="img/ldd.jpg" width="${sz}" height="${sz}" style="object-fit:cover;border-radius:${sz > 30 ? 10 : 6}px;" alt="">`,
    levels: [
      { lv: 1, name: 'Bộ dụng cụ tiêu chuẩn', desc: 'Khách hàng tăng 5% tỉ lệ chọn nhiều nguyên liệu hơn' },
      { lv: 2, name: 'Bộ định lượng chuyên nghiệp', desc: 'Khách hàng tăng 7% tỉ lệ chọn nhiều nguyên liệu hơn', cost: 10000000 },
      { lv: 3, name: 'Trạm pha chế cao cấp', desc: 'Khách hàng tăng 10% tỉ lệ chọn nhiều nguyên liệu hơn', cost: 50000000 }
    ]
  }
};

function getEquip3Lv(id){
  if(!window.S) return 1;
  if(!S.equipLv) S.equipLv = { binhrot:1, sealer: (S.upg && S.upg.sealer) ? 1 : 1, khaytop:1, lyduongda:1 };
  if(S.equipLv[id] == null) S.equipLv[id] = 1;
  return S.equipLv[id];
}

function isEquip3Broken(id){
  if(!window.S) return false;
  if(id === 'sealer'){
    if(S.upg && S.upg.sealer === false) return true;
  }
  return !!(S.equipBroken && S.equipBroken[id]);
}

function getEquip3RepairCost(id){
  const curLv = getEquip3Lv(id);
  return curLv >= 3 ? 3000000 : (curLv === 2 ? 1500000 : 500000);
}

function repairEquip3(id){
  if(inDebt()){ toast('Đang nợ, trả xong mới sửa được trang bị!'); return; }
  const cfg = EQUIP3_CFG[id];
  if(!cfg) return;
  const curLv = getEquip3Lv(id);
  const cost = getEquip3RepairCost(id);
  if(S.money < cost){
    toast(`Két không đủ ${fmtTr(cost)} để sửa chữa ${cfg.title}!`);
    return;
  }
  S.money -= cost;
  S.cur.equip = S.cur.equip || [];
  S.cur.equip.push({ n: `Sửa chữa ${cfg.title} (Cấp ${curLv})`, v: cost });

  S.equipBroken = S.equipBroken || {};
  S.equipBroken[id] = false;
  if(id === 'sealer'){
    S.upg = S.upg || {};
    S.upg.sealer = true;
  }

  save();
  sfx('star');
  toast(`🛠️ ĐÃ SỬA CHỮA THÀNH CÔNG: ${cfg.title} (Cấp ${curLv})! Thiết bị hoạt động lại bình thường với 100% hiệu năng! ✨`);
  refreshPrep();
}

function repairAllEquip3(){
  if(inDebt()){ toast('Đang nợ, trả xong mới sửa được trang bị!'); return; }
  const keys = ['binhrot', 'sealer', 'khaytop', 'lyduongda'];
  const brokenKeys = keys.filter(id => isEquip3Broken(id));
  if(!brokenKeys.length){
    toast('Tất cả trang bị đều đang hoạt động tốt!');
    return;
  }
  let totalCost = 0;
  brokenKeys.forEach(id => { totalCost += getEquip3RepairCost(id); });
  if(S.money < totalCost){
    toast(`Két không đủ ${fmtTr(totalCost)} để sửa tất cả ${brokenKeys.length} trang bị hỏng!`);
    return;
  }
  S.money -= totalCost;
  S.cur.equip = S.cur.equip || [];
  S.cur.equip.push({ n: `Sửa toàn bộ ${brokenKeys.length} trang bị hỏng`, v: totalCost });

  S.equipBroken = S.equipBroken || {};
  brokenKeys.forEach(id => {
    S.equipBroken[id] = false;
    if(id === 'sealer'){
      S.upg = S.upg || {};
      S.upg.sealer = true;
    }
  });

  save();
  sfx('star');
  toast(`🛠️ ĐÃ SỬA CHỮA THÀNH CÔNG TẤT CẢ ${brokenKeys.length} TRANG BỊ! Toàn bộ máy móc hoạt động lại trơn tru! 🚀✨`);
  refreshPrep();
}

function getTeaPourSpeedMul(){
  if(isEquip3Broken('binhrot')) return 1.0;
  const lv = getEquip3Lv('binhrot');
  let mul = (lv >= 3 ? 1.40 : (lv === 2 ? 1.20 : 1.10));
  if(window.R && window.R.slots && window.R.slots.some(s => s && s.isSpecialCust && s.specialEffect && s.specialEffect.id === 'buff_speed')){
    mul *= 1.40;
  }
  const cupBuff = (typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
  if(cupBuff && cupBuff.speedBonus){
    mul *= (1 + cupBuff.speedBonus);
  }
  return mul;
}

function getSealerTipBonus(){
  if(isEquip3Broken('sealer') || (S.upg && !S.upg.sealer)) return 0;
  const lv = getEquip3Lv('sealer');
  if(lv >= 3) return 0.50;
  if(lv === 2) return 0.40;
  return 0.30;
}

function getToppingTrayBonus(){
  if(isEquip3Broken('khaytop')) return 0;
  const lv = getEquip3Lv('khaytop');
  if(lv >= 3) return 3;
  if(lv === 2) return 2;
  return 1;
}

function getToolsExtraIngChance(){
  if(isEquip3Broken('lyduongda')) return 0;
  const lv = getEquip3Lv('lyduongda');
  if(lv >= 3) return 0.10;
  if(lv === 2) return 0.07;
  return 0.05;
}

function getIngLife(k){
  if(k === 'ice' && S && S.upg && S.upg.fridge) return 0;
  if(k === 'cup') return 0;
  let l = (CFG.life && CFG.life[k] !== undefined) ? CFG.life[k] : ((ITEMS[k] && ITEMS[k].life !== undefined) ? ITEMS[k].life : 1);
  if(TOP_KEYS.includes(k) || (ITEMS[k] && ITEMS[k].type === 'top')){
    l += getToppingTrayBonus();
  }
  return l;
}

function handleEquip3Up(id){
  if(inDebt()){ toast('Đang nợ, trả xong mới nâng cấp được'); return; }
  const cfg = EQUIP3_CFG[id];
  if(!cfg) return;
  const curLv = getEquip3Lv(id);
  if(curLv >= 3){ toast('Trang bị này đã đạt cấp tối đa!'); return; }
  const nextInfo = cfg.levels[curLv];
  const cost = nextInfo.cost;
  if(S.money < cost){
    toast(`Két không đủ ${fmtTr(cost)} để nâng cấp ${cfg.title}!`);
    return;
  }
  S.money -= cost;
  S.equipLv = S.equipLv || {};
  S.equipLv[id] = curLv + 1;
  S.equipBroken = S.equipBroken || {};
  S.equipBroken[id] = false;
  if(id === 'sealer'){
    S.upg = S.upg || {};
    S.upg.sealer = true;
  }
  S.cur.equip = S.cur.equip || [];
  S.cur.equip.push({ n: `Nâng cấp ${cfg.title} (Cấp ${curLv + 1})`, v: cost });

  // Gia hạn thêm ngày cho các mẻ topping trong kho khi nâng cấp khay topping
  if(id === 'khaytop' && S.stock){
    TOP_KEYS.forEach(k => {
      if(S.stock[k]){
        S.stock[k].forEach(b => { if(b.exp < 99999) b.exp += 1; });
      }
    });
  }

  save();
  sfx('lvup');
  toast(`🎉 Đã nâng cấp ${cfg.title} lên Cấp ${curLv + 1}! (${nextInfo.desc})`);
  refreshPrep();
}

function renderEquip3Section(){
  const keys = ['binhrot', 'sealer', 'khaytop', 'lyduongda'];
  const anyBroken = keys.some(id => isEquip3Broken(id));
  
  let headerNotice = '';
  if(anyBroken){
    const brokenNames = keys.filter(id => isEquip3Broken(id)).map(id => EQUIP3_CFG[id].title).join(', ');
    headerNotice = `
      <div style="background:#fef2f2;border:1.5px solid #f87171;padding:10px 14px;border-radius:10px;margin-bottom:12px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <div style="color:#991b1b;font-size:0.85rem;line-height:1.4;">
          <b>⚠️ CẢNH BÁO: PHÁT HIỆN TRANG BỊ HỎNG!</b><br>
          <span style="font-size:0.80rem;color:#b91c1c;">Thiết bị đang hư hỏng: <b>${brokenNames}</b>. Hãy sửa chữa ngay để khôi phục hiệu quả máy móc!</span>
        </div>
        <button type="button" class="sbtn pri" data-equip3-repair-all="1" style="background:#dc2626;border-color:#b91c1c;color:#fff;font-weight:800;padding:6px 14px;border-radius:6px;box-shadow:0 2px 6px rgba(220,38,38,0.35);">
          🛠️ Sửa tất cả
        </button>
      </div>
    `;
  }

  return headerNotice + `<div class="equip3-grid">` + keys.map(id => {
    const cfg = EQUIP3_CFG[id];
    const curLv = getEquip3Lv(id);
    const curInfo = cfg.levels[curLv - 1] || cfg.levels[0];
    const isMax = curLv >= 3;
    const nextInfo = !isMax ? cfg.levels[curLv] : null;
    const cost = nextInfo ? nextInfo.cost : 0;
    const costText = cost >= 1e6 ? (cost / 1e6) + 'tr' : (cost / 1e3) + 'k';
    const canAfford = nextInfo ? (S.money >= cost) : false;
    const isBroken = isEquip3Broken(id);
    const repCost = getEquip3RepairCost(id);
    const repCostText = repCost >= 1e6 ? (repCost / 1e6) + 'tr' : (repCost / 1e3) + 'k';
    const canAffordRep = S.money >= repCost;

    return `
      <div class="equip3-card ${isBroken ? 'broken-equip' : ''}" style="${isBroken ? 'border:2px solid #ef4444;background:#fff8f8;box-shadow:0 0 10px rgba(239,68,68,0.22);' : ''}">
        <div class="equip3-top">
          <div class="equip3-icon-box" style="${isBroken ? 'filter:grayscale(60%);opacity:0.85;' : ''}">
            ${cfg.icon(38)}
          </div>
          <div class="equip3-body">
            <div class="equip3-header-row">
              <span class="equip3-title">${cfg.title}</span>
              <span class="equip3-badge">C${curLv}</span>
              ${isBroken ? `<span class="equip3-badge" style="background:#dc2626;color:#fff;font-weight:800;animation:pulse 1.5s infinite;margin-left:4px;">⚠️ HỎNG</span>` : ''}
            </div>
            <div class="equip3-pips">
              <span class="equip3-pip ${curLv >= 1 ? 'active' : ''}"></span>
              <span class="equip3-pip ${curLv >= 2 ? 'active' : ''}"></span>
              <span class="equip3-pip ${curLv >= 3 ? 'active' : ''}"></span>
            </div>
            <div class="equip3-cur-name" style="${isBroken ? 'text-decoration:line-through;color:#94a3b8;' : ''}">${curInfo.name}</div>
            <div class="equip3-cur-desc" style="${isBroken ? 'color:#dc2626;font-weight:700;' : ''}">
              ${isBroken ? '❌ Thiết bị đang hỏng! Toàn bộ hiệu ứng bị mất cho đến khi sửa.' : curInfo.desc}
            </div>
          </div>
        </div>

        ${isBroken ? `
          <div class="equip3-repair-row" style="margin-top:10px;background:#fef2f2;border:1.5px solid #fca5a5;padding:8px 10px;border-radius:8px;display:flex;align-items:center;justify-content:space-between;gap:8px;">
            <div style="font-size:0.80rem;color:#991b1b;line-height:1.3;">
              <b>🛠️ Cần sửa chữa thiết bị</b><br>
              <span>Phí thay linh kiện: <b style="color:#b91c1c;">${repCostText}</b></span>
            </div>
            <button type="button" class="sbtn pri equip3-btn" data-equip3-repair="${id}" ${!canAffordRep ? 'disabled' : ''} style="background:#dc2626;border-color:#b91c1c;color:#fff;font-weight:800;padding:6px 14px;border-radius:6px;box-shadow:0 2px 6px rgba(220,38,38,0.3);">
              <span class="e3-cost">${repCostText}</span>
              <span class="e3-action">Sửa ngay</span>
            </button>
          </div>
        ` : ''}

        ${!isMax && nextInfo ? `
          <div class="equip3-next-row" style="margin-top:${isBroken ? '6px' : '0'};">
            <div class="equip3-next-info">
              <div class="equip3-next-icon">
                ${cfg.icon(22)}
              </div>
              <div class="equip3-next-text">
                <div class="equip3-next-title">Lên C${curLv + 1} • ${nextInfo.name}</div>
                <div class="equip3-next-hint">${isBroken ? 'Nâng cấp sẽ tự động sửa & phục hồi thiết bị' : 'Mở khóa hiệu quả mới khi nâng cấp'}</div>
              </div>
            </div>
            <button type="button" class="sbtn pri equip3-btn" data-equip3-up="${id}" ${!canAfford ? 'disabled' : ''}>
              <span class="e3-cost">${costText}</span>
              <span class="e3-action">Nâng cấp</span>
            </button>
          </div>
        ` : (isMax && !isBroken ? `
          <div class="equip3-maxed">⭐ Đã đạt cấp tối đa (Cấp 3)</div>
        ` : '')}
      </div>
    `;
  }).join('') + `</div>`;
}

/* ---------- KHO THEO MẺ, CÓ HẠN DÙNG ---------- */
function addStock(k,q,st=S,allowInSale=false){
  if(!q)return;
  st.stock=st.stock||{};
  st.stock[k]=st.stock[k]||[];
  const isFridgeIce=(k==='ice'&&st&&st.upg&&st.upg.fridge);
  const l=isFridgeIce?0:getIngLife(k),exp=l?st.day+l-1:99999,b=st.stock[k].find(x=>x.exp===exp);
  if(b)b.q+=q;
  else{st.stock[k].push({q,exp});st.stock[k].sort((a,c)=>a.exp-c.exp)}
  if(typeof FLAV_KEYS !== 'undefined' && FLAV_KEYS.includes(k)){
    syncFlav();
  }
}
const qty=k=>(S&&S.stock&&S.stock[k])?S.stock[k].reduce((a,b)=>a+b.q,0):0;
/* hương có trong menu khi còn hàng trong chai */
const bottleCost=k=>{
  let c=CFG.bottle*(evIs('sale')&&ev().k===k?.7:1);
  if(typeof S !== 'undefined' && S){
    if(S.startupLocation === 'sapa'){
      c *= 1.15; // Sa Pa: Chi phí vận chuyển đèo dốc +15% giá vốn
    } else if(S.startupLocation === 'hoangsa'){
      c *= 1.20; // Hoàng Sa – Trường Sa: Nguồn hàng hạn chế: +20% giá vốn nguyên liệu
    }
  }
  return Math.round(c);
};
function syncFlav(){
  if(typeof FLAV_KEYS !== 'undefined' && Array.isArray(FLAV_KEYS) && typeof S !== 'undefined' && S && S.unlocked){
    FLAV_KEYS.forEach(k=>{
      if(S.off) delete S.off[k];
      S.unlocked[k] = qty(k) > 0;
    });
  }
}
window.syncFlav = syncFlav;
function take(k){
  if(!S || !S.stock || !Array.isArray(S.stock[k])) return false;
  const b=S.stock[k].find(x=>x.q>0);
  if(!b) return false;
  const cupBuff = (typeof R !== 'undefined' && R && R.running && typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
  if(cupBuff && cupBuff.freeIngChance && Math.random() < cupBuff.freeIngChance){
    return true;
  }
  b.q--;
  S.stock[k]=S.stock[k].filter(x=>x.q>0);
  if(typeof FLAV_KEYS !== 'undefined' && FLAV_KEYS.includes(k) && qty(k) === 0){
    syncFlav();
  }
  return true;
}
function expireStock(){
  const out=[];
  if(!S || !S.stock) return out;
  Object.keys(S.stock).forEach(k=>{
    let q=0;
    if(!Array.isArray(S.stock[k])) return;
    S.stock[k]=S.stock[k].filter(b=>{
      if(k==='ice'&&S.upg&&S.upg.fridge)return true;
      if(k==='cup')return true;
      if(b.exp<=S.day){q+=b.q;return false}
      return true;
    });
    if(q){
      let c=CFG.cost[k];
      if((k==='sugar'||k==='ice')&&S&&S.garden&&S.garden.lemonBuffDays>0)c=Math.round(c*(S.garden.lemonBuffBoost?0.7:0.8));
      out.push({k,q,v:q*c});
    }
  });
  syncFlav();
  return out;
}
// Tổng hợp đầy đủ doanh thu tích lũy thực tế từ 3 nguồn (Quán chính + Chi nhánh trực thuộc + Nhượng quyền) và đối chiếu dữ liệu lưu cũ / mã sao lưu rút gọn
function calcVerifiedCumulativeRevenue(st){
  const s = st || (typeof S !== 'undefined' ? S : null);
  if(!s) return { mainRev: 0, branchRev: 0, branchNet: 0, franRev: 0, bankInt: 0, totalVerifiedRev: 0, totalRev: 0, effServed: 0, served: 0, effHistLen: 0, historyDays: 0 };

  const num = v => { const n = Number(v); return Number.isFinite(n) ? n : 0; };
  const d = Math.max(1, Math.floor(num(s.day) || 1));
  const H = Array.isArray(s.history) ? s.history.filter(r => r && typeof r === 'object') : [];
  const histLen = H.length;
  const historyDays = Math.max(histLen, Math.floor(num(s.historyLengthTotal) || num(s._restoredHistoryLen) || 0), d - 1);
  const historyScale = (histLen > 0 && historyDays > histLen) ? (historyDays / histLen) : 1;

  const sv = Math.max(0, num(s.served != null ? s.served : s.best));
  const rv = Math.max(0, num(s.totalRev));
  const prof = Math.max(0, num(s.totalProfit));

  // 1. Doanh thu tích lũy Quán Chính (bao gồm S.totalRev, ca hiện tại S.cur, lịch sử S.history & đối chiếu file lưu cũ từng bị cắt history 400 ngày)
  const readMainRevenue = rec => {
    if(!rec || typeof rec !== 'object') return 0;
    const core = typeof recRev === 'function'
      ? Math.max(0, num(recRev(rec)))
      : Object.values(rec.sales || {}).reduce((sum, v) => sum + num(v && v.a), 0) + num(rec.tips) + num(rec.gift) + num(rec.partyPayout) + num(rec.guard);
    return Math.max(0, core + num(rec.lobbyRev) + num(rec.dogBonus));
  };
  const curShiftRev = readMainRevenue(s.cur);
  let histMainSum = 0;
  let histBranchRev = 0;
  let histBranchNet = 0;
  let histFranSum = 0;
  let histBankIntSum = 0;
  let histServed = 0;
  for(let i = 0; i < histLen; i++){
    const r = H[i];
    histMainSum += readMainRevenue(r);
    histBranchRev += Math.max(0, num(r.branchRev));
    histBranchNet += num(r.branchNet);
    const rFran = Math.max(
      0,
      num(r.franchiseTotalIncome != null ? r.franchiseTotalIncome : (num(r.franchiseRoyalty) + num(r.franchiseSupplyProfit) + num(r.franchisePosFee))),
      Math.round(Math.max(0, num(r.franchiseRev)) * 0.28)
    );
    histFranSum += rFran;
    histBankIntSum += Math.max(0, num(r.bankInterest));
    histServed += Math.max(0, num(r.served));
  }
  const verifiedServed = Math.max(sv, histServed);
  const extrapMainRev = Math.round(histMainSum * historyScale);
  const servedRevenueFloor = verifiedServed * 15000;
  const legacyCupRevFloor = (verifiedServed >= 500 && (rv > 0 || histMainSum > 0)) ? Math.round(verifiedServed * 55000) : 0;
  const mainRev = Math.max(0, rv + curShiftRev, histMainSum + curShiftRev, extrapMainRev, prof, servedRevenueFloor, legacyCupRevFloor);

  // 2. Doanh thu tích lũy Chi Nhánh Trực Thuộc (vốn cộng thẳng branchNet vào S.money ở finishEndDay mà không cộng vào S.totalRev)
  const branchEntries = (s.branches && typeof s.branches === 'object')
    ? Object.entries(s.branches).filter(([, b]) => b && (b.bought || b.owned))
    : [];
  const branchCount = branchEntries.length;
  const branchCountByDay = histDay => branchEntries.filter(([, b]) => Math.max(1, num(b.openedDay) || 1) <= histDay).length;
  let historicalBranchStoreDays = 0;
  H.forEach((rec, i) => {
    const recDay = Math.max(1, Math.floor(num(rec.day) || (historyDays - histLen + i + 1)));
    historicalBranchStoreDays += branchCountByDay(recDay);
  });
  const observedBranchRevenuePerStoreDay = historicalBranchStoreDays > 0 ? (histBranchRev / historicalBranchStoreDays) : 0;
  const branchSpecs = (typeof BRANCH_LOCATIONS !== 'undefined' && Array.isArray(BRANCH_LOCATIONS)) ? BRANCH_LOCATIONS : [];
  let branchPortfolioEstimate = 0;
  let branchNetPortfolioEstimate = 0;
  let branchCountersSum = 0;
  let branchNetCountersSum = 0;
  let branchNetCountersComplete = branchCount > 0;
  for(let i = 0; i < branchCount; i++){
    const [bid, bData] = branchEntries[i];
    const storedRev = Math.max(0, num(bData.totalRev));
    const hasStoredNet = Object.prototype.hasOwnProperty.call(bData, 'totalNet') && bData.totalNet != null;
    const storedNet = num(bData.totalNet);
    branchCountersSum += storedRev;
    if(hasStoredNet) branchNetCountersSum += storedNet;
    else branchNetCountersComplete = false;
    const openedDay = Math.max(1, Math.floor(num(bData.openedDay) || 1));
    const completedOpenDays = Math.max(0, Math.min(d - 1, historyDays) - openedDay + 1);
    const bCfg = branchSpecs.find(x => x && x.id === bid);
    const recentRev = Math.max(0, num(bData.lastDay && bData.lastDay.rev));
    const recentNet = num(bData.lastDay && bData.lastDay.profit);
    const fallbackDailyRev = recentRev > 0 ? recentRev : (bCfg ? (num(bCfg.minRev) + num(bCfg.maxRev)) / 2 : 0);
    const dailyRev = observedBranchRevenuePerStoreDay > 0 ? observedBranchRevenuePerStoreDay : fallbackDailyRev;
    const estimateRev = storedRev > 0 ? storedRev : (dailyRev * completedOpenDays);
    // Counter totalNet = 0 hoặc âm vẫn hợp lệ; chỉ ước tính từ lastDay nếu field totalNet bị thiếu
    const estimateNet = hasStoredNet ? storedNet : (recentNet * completedOpenDays);
    branchPortfolioEstimate += Math.max(0, estimateRev);
    branchNetPortfolioEstimate += estimateNet;
  }
  const extrapBranchRev = Math.round(histBranchRev * historyScale);
  const extrapBranchNet = histBranchNet * historyScale;
  const branchRev = Math.max(
    0,
    num(s.totalBranchRev),
    branchCountersSum,
    extrapBranchRev,
    Math.round(branchPortfolioEstimate)
  );
  // Net profit có thể âm nên không dùng Math.max để ép lỗ thành 0
  const branchNetFallback = branchNetCountersComplete
    ? branchNetCountersSum
    : (histBranchNet !== 0 ? extrapBranchNet : branchNetPortfolioEstimate);
  const branchNet = s._legacyBranchNetCountersMissing ? branchNetFallback : num(s.totalBranchNet);

  // 3. Doanh thu & Phí Nhượng Quyền tích lũy (totalRoyaltyEarned + totalSupplyProfit + totalPosFeeEarned + feeEarned + p.totalRoyalty)
  const fr = (s.franchise && typeof s.franchise === 'object') ? s.franchise : {};
  const partners = Array.isArray(fr.partners) ? fr.partners.filter(Boolean) : [];
  const franCount = partners.length;
  const royalty = Math.max(0, num(fr.totalRoyaltyEarned));
  const supply = Math.max(0, num(fr.totalSupplyProfit));
  const pos = Math.max(0, num(fr.totalPosFeeEarned));
  const legacySignFees = Math.max(0, num(fr.feeEarned));
  const separateSignFees = Math.max(0, num(fr.totalSignFeeEarned));
  const franCounters = royalty + supply + pos + legacySignFees + separateSignFees;
  let perPartnerSum = 0;
  for(let i = 0; i < franCount; i++){
    const p = partners[i];
    const entryFee = p.entryFee != null ? Math.max(0, num(p.entryFee)) : 100000000;
    perPartnerSum += Math.max(0, num(p.totalRoyalty)) + Math.max(0, num(p.totalSupplyProfit)) + Math.max(0, num(p.totalPosFee)) + entryFee;
  }
  const franchiseFeesEstimate = Math.max(
    legacySignFees + separateSignFees,
    perPartnerSum > 0 ? partners.reduce((sum, p) => sum + (p.entryFee != null ? Math.max(0, num(p.entryFee)) : 100000000), 0) : 0
  );
  const extrapFranRev = Math.round(histFranSum * historyScale + franchiseFeesEstimate);
  const franRev = Math.max(0, franCounters, perPartnerSum, extrapFranRev);

  // 4. Lãi ngân hàng tích lũy thực tế (bao gồm bản lưu cũ khi chưa tách S.bank.totalInterest)
  const bankBal = Math.max(0, num(s.bank && s.bank.balance));
  const bankPrin = Math.max(0, num(s.bank && s.bank.principal));
  const bankOverPrin = (bankPrin > 0 && bankBal > bankPrin) ? (bankBal - bankPrin) : 0;
  const bankInt = Math.max(0, num(s.bank && s.bank.totalInterest), histBankIntSum, bankOverPrin);

  const totalVerifiedRev = mainRev + branchRev + franRev;
  const effServed = verifiedServed + ((branchCount + franCount) * Math.min(d, 365) * 45);
  const effHistLen = Math.max(
    histLen,
    historyDays,
    (verifiedServed >= Math.min(800, d * 60) && mainRev >= Math.min(200000000, d * 4000000)) ? Math.min(d, 400) : 0
  );

  return {
    mainRev,
    branchRev,
    branchNet,
    franRev,
    bankInt,
    totalVerifiedRev,
    totalRev: totalVerifiedRev,
    effServed,
    served: verifiedServed,
    effHistLen,
    historyDays
  };
}

function getInGameCheatVerdict(cashOverride, forceRefresh = false){
  if(typeof S === 'undefined' || !S){
    return { score: 0, status: 'CLEAN', scoreTier: 0, cashTier: 0, tier: 0, isCheater: false, isLowTier: false, isMidTier: false, isHighTier: false, isMegaTier: false, reasons: [] };
  }
  const rawInput = cashOverride != null ? Math.max(0, Number(cashOverride) || 0) : Math.max(0, Number(S.money) || 0);
  const effCash = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(rawInput) : rawInput;
  const now = Date.now();
  if(!forceRefresh && window._cachedInGameVerdict && (now - (window._cachedInGameVerdictAt || 0) < 1500) && Math.abs((window._cachedInGameVerdictCash || 0) - effCash) < 50000000 && window._cachedInGameVerdictDay === S.day){
    return window._cachedInGameVerdict;
  }

  const d = Math.max(1, parseInt(S.day, 10) || 1);
  const tiers = typeof getSafeCashTiers === 'function' ? getSafeCashTiers(d) : { lowCap: 3000000000, midCap: 6000000000, highCap: 12000000000, megaCap: 30000000000 };
  const bankBal = Math.max(0, Number(S.bank && S.bank.balance) || 0);
  const totalLiquid = effCash + bankBal;

  const hasNoAuditableLegacyLedger = !!S._legacyCompactChainDataMissing && (!Array.isArray(S.history) || S.history.length === 0) && (Number(S.historyLengthTotal) || 0) > 0;
  if(hasNoAuditableLegacyLedger){
    const cleanRes = { score: 0, status: 'CLEAN', scoreTier: 0, cashTier: 0, tier: 0, isCheater: false, isLowTier: false, isMidTier: false, isHighTier: false, isMegaTier: false, reasons: [] };
    window._cachedInGameVerdict = cleanRes;
    window._cachedInGameVerdictAt = now;
    window._cachedInGameVerdictCash = effCash;
    window._cachedInGameVerdictDay = S.day;
    return cleanRes;
  }

  let score = 0;
  const reasons = [];

  // 1. Chấm điểm trực tiếp theo Hệ thống Anti-Cheat 10 Tầng (evaluateLeaderboardPlayerCheatScore)
  if(typeof evaluateLeaderboardPlayerCheatScore === 'function'){
    try {
      const bestStats = (typeof calcEffectiveBestDayStats === 'function') ? calcEffectiveBestDayStats() : { dayServed: S.bestDayServed || 0, dayRev: S.bestDayRev || 0 };
      const brCount = S.branches ? Object.values(S.branches).filter(b => b && (b.bought || b.owned)).length : 0;
      const frCount = (S.franchise && Array.isArray(S.franchise.partners)) ? S.franchise.partners.length : 0;
      const craftedCount = (S.collection && S.collection.craftedRecipes) ? Object.keys(S.collection.craftedRecipes).filter(k => S.collection.craftedRecipes[k]).length : 0;
      const decCount = S.decor ? Object.keys(S.decor).filter(k => S.decor[k]).length : 0;
      const evalPayload = {
        id: String((typeof ensurePlayerCloudKey === 'function' ? ensurePlayerCloudKey() : S.cloudKey) || 'local_self'),
        name: String(S.shopName || 'Tiệm Trà Mơ Ước'),
        owner: String(S.ownerName || 'Chủ tiệm'),
        day: d,
        profit: typeof calc7DayAvgProfit === 'function' ? Math.max(0, parseInt(calc7DayAvgProfit(), 10) || 0) : 0,
        rev: Math.max(0, parseInt(S.totalRev, 10) || 0),
        served: Math.max(0, parseInt(S.served != null ? S.served : (S.best || 0), 10) || 0),
        dayRev: Math.max(0, parseInt(bestStats.dayRev, 10) || 0),
        dayServed: Math.max(0, parseInt(bestStats.dayServed, 10) || 0),
        staffTip7d: typeof calc7DayStaffTips === 'function' ? Math.max(0, parseInt(calc7DayStaffTips(), 10) || 0) : 0,
        avgUpg: typeof calcAvgUpgLevel === 'function' ? Math.max(0, parseFloat(calcAvgUpgLevel()) || 0) : 0,
        crushLevel: Math.max(1, parseInt(S.crushLevel || 1, 10) || 1),
        capbiLevel: Math.max(0, parseInt(S.capbi && S.capbi.unlocked ? (S.capbi.level || 1) : 0, 10) || 0),
        star1Count: typeof getOneStarReviewCount === 'function' ? Math.max(0, parseInt(getOneStarReviewCount(), 10) || 0) : 0,
        star5Count: Math.max(0, parseInt(S.star5Count, 10) || 0),
        money: effCash,
        bankBalance: bankBal,
        branchCount: brCount,
        franchiseCount: frCount,
        craftedRecipes: craftedCount,
        petLevel: Math.max(0, parseInt(S.pet && S.pet.level, 10) || 0),
        gardenLevel: Math.max(0, parseInt(S.garden && S.garden.level, 10) || 0),
        decorCount: decCount,
        historyLength: Array.isArray(S.history) ? S.history.length : 0,
        reviewsLength: Array.isArray(S.reviews) ? S.reviews.length : 0
      };
      const lbEval = evaluateLeaderboardPlayerCheatScore(evalPayload, true);
      if(lbEval && typeof lbEval.score === 'number'){
        score = Math.max(score, lbEval.score);
        if(Array.isArray(lbEval.reasons)) lbEval.reasons.forEach(r => { if(!reasons.includes(r)) reasons.push(r); });
      }
    } catch(_){}
  }

  // 2. Đối soát Tài sản Thực 3 Nguồn (Quầy chính + Chi nhánh + Nhượng quyền + Lãi Bank) cho cả Két tiền mặt VÀ Tà Tưa Bank
  if(typeof calcVerifiedCumulativeRevenue === 'function'){
    const revInfo = calcVerifiedCumulativeRevenue(S);
    const verifiedRev = Math.max(0, Number(revInfo.totalVerifiedRev) || 0);
    const bankInt = Math.max(0, Number(revInfo.bankInt) || 0);
    const effServed = Math.max(0, Number(revInfo.served) || 0);
    const hasChain = Object.values(S.branches || {}).some(b => b && (b.bought || b.owned)) || !!(S.franchise && Array.isArray(S.franchise.partners) && S.franchise.partners.length);
    const maxLegitAccumulated = Math.max(tiers.midCap + 2000000000, verifiedRev * 1.45 + bankInt + 5000000000);

    if(totalLiquid > maxLegitAccumulated){
      const excess = totalLiquid - maxLegitAccumulated;
      if(excess >= 30000000000 || totalLiquid >= tiers.megaCap){
        score = Math.max(score, 100);
        reasons.push('hoard_unverified_mega');
      } else if(excess >= 12000000000 || totalLiquid >= tiers.highCap){
        score = Math.max(score, 50);
        reasons.push('hoard_unverified_high');
      } else if(excess >= 5000000000 || totalLiquid >= tiers.midCap){
        score = Math.max(score, 30);
        reasons.push('hoard_unverified_mid');
      } else {
        score = Math.max(score, 15);
        reasons.push('hoard_unverified_warn');
      }
    }

    if(totalLiquid >= tiers.megaCap && (d < 35 || verifiedRev < 22000000000 || (!hasChain && effServed < 10000))){
      score = Math.max(score, 100);
      reasons.push('hoard_milestone_mega');
    } else if(totalLiquid >= tiers.highCap && (d < 15 || verifiedRev < 7500000000 || (!hasChain && effServed < 3000))){
      score = Math.max(score, 50);
      reasons.push('hoard_milestone_high');
    } else if(totalLiquid >= tiers.midCap && (d < 7 || verifiedRev < 3500000000 || (!hasChain && effServed < 1000))){
      score = Math.max(score, 30);
      reasons.push('hoard_milestone_mid');
    }
  }

  // 3. Ánh xạ Ngưỡng Phán Quyết theo Điểm (cheatScore) tương đương 100% với 4 Mốc Vượt Két:
  // - Tier 4 (>= 100 điểm - BAN)       <-> megaCap
  // - Tier 3 (50..99 điểm - SHADOWBAN) <-> highCap
  // - Tier 2 (30..49 điểm - FLAG)      <-> midCap
  // - Tier 1 (10..29 điểm - WARN)      <-> lowCap
  // - Tier 0 (0..9 điểm   - CLEAN)     <-> An toàn
  let scoreTier = 0;
  let status = 'CLEAN';
  if(score >= 100){
    scoreTier = 4;
    status = 'BAN';
  } else if(score >= 50){
    scoreTier = 3;
    status = 'SHADOWBAN';
  } else if(score >= 30){
    scoreTier = 2;
    status = 'FLAG';
  } else if(score >= 10){
    scoreTier = 1;
    status = 'WARN';
  }

  let cashTier = 0;
  if(effCash >= tiers.megaCap) cashTier = 4;
  else if(effCash >= tiers.highCap) cashTier = 3;
  else if(effCash >= tiers.midCap) cashTier = 2;
  else if(effCash >= tiers.lowCap) cashTier = 1;

  const isCheater = score >= 10;
  const effTier = isCheater ? Math.max(scoreTier, cashTier) : 0;

  const res = {
    score,
    status,
    scoreTier,
    cashTier,
    tier: effTier,
    isCheater,
    isLowTier: effTier >= 1,
    isMidTier: effTier >= 2,
    isHighTier: effTier >= 3,
    isMegaTier: effTier >= 4,
    reasons
  };

  window._cachedInGameVerdict = res;
  window._cachedInGameVerdictAt = now;
  window._cachedInGameVerdictCash = effCash;
  window._cachedInGameVerdictDay = S.day;
  return res;
}
window.getInGameCheatVerdict = getInGameCheatVerdict;

function isVerifiedHoardCheater(cashOverride){
  if(typeof S === 'undefined' || !S) return false;
  const verdict = getInGameCheatVerdict(cashOverride);
  return !!(verdict && verdict.isCheater);
}
window.isVerifiedHoardCheater = isVerifiedHoardCheater;
function raidHoardStock(minPct, maxPct){
  const out = [];
  if(!S || !S.stock) return out;
  Object.keys(S.stock).forEach(k => {
    const arr = S.stock[k];
    if(!Array.isArray(arr) || !arr.length) return;
    const totalQ = arr.reduce((a, b) => a + (b && b.q > 0 ? b.q : 0), 0);
    if(totalQ <= 0) return;
    const pct = minPct + Math.random() * Math.max(0, maxPct - minPct);
    let toRemove = Math.max(1, Math.round(totalQ * pct));
    let removed = 0;
    for(let i = 0; i < arr.length && toRemove > 0; i++){
      if(arr[i] && arr[i].q > 0){
        const takeQ = Math.min(arr[i].q, toRemove);
        arr[i].q -= takeQ;
        toRemove -= takeQ;
        removed += takeQ;
      }
    }
    S.stock[k] = arr.filter(b => b && b.q > 0);
    if(removed > 0 && ITEMS[k]){
      let c = (CFG && CFG.cost && CFG.cost[k]) || ITEMS[k].cost || 1500;
      if((k==='sugar'||k==='ice')&&S&&S.garden&&S.garden.lemonBuffDays>0) c = Math.round(c*(S.garden.lemonBuffBoost?0.7:0.8));
      out.push({ k, q: removed, v: removed * c });
    }
  });
  // Nếu cướp kho quy mô lớn (minPct >= 0.40), cướp luôn cả kho nông sản Vườn Trà nếu có
  if(minPct >= 0.40 && S.garden && S.garden.inventory && typeof S.garden.inventory === 'object'){
    Object.keys(S.garden.inventory).forEach(gk => {
      const gq = Number(S.garden.inventory[gk]) || 0;
      if(gq > 0){
        const gLost = Math.max(1, Math.round(gq * minPct));
        S.garden.inventory[gk] = Math.max(0, gq - gLost);
      }
    });
  }
  syncFlav();
  return out;
}
function lifeTxt(k){if(k==='ice'&&S&&S.upg&&S.upg.fridge)return 'Vĩnh viễn (Tủ lạnh)';if(k==='cup')return 'Không hết hạn';const l=getIngLife(k);return l?(l===1?'Dùng trong ngày':'Để được '+l+' ngày'):'Không hết hạn'}
const revCount=()=>Math.max(S.revTotal||0,(S.reviews||[]).length);
/* bản lưu gọn: bỏ khoá chống trùng của đánh giá (tự tính lại khi mở game), bản dự phòng chỉ giữ 200 đánh giá mới nhất */
function pack(maxRev){return JSON.stringify(S,function(k,v){if(this===S&&k==='reviews'){const a=maxRev?v.slice(0,maxRev):v;return a.map(r=>{const{k:_k,...o}=r;return o})}return v})}
function dropBaks(){['tsBak3','tsBak2','tsBak1',SAVE+'_rescue',SAVE+'_persist'].forEach(k=>{try{localStorage.removeItem(k)}catch(e){}})}
let _saveTimeout = null;
let _lastSaveTime = 0;
function save(forceNow = false){
  if(window.tsHostOk && !window.tsHostOk()) return;
  const now = Date.now();
  if(forceNow || (now - _lastSaveTime > 2500)){
    _lastSaveTime = now;
    if(_saveTimeout){ clearTimeout(_saveTimeout); _saveTimeout = null; }
    _doSaveActual();
  } else if(!_saveTimeout){
    _saveTimeout = setTimeout(() => {
      _saveTimeout = null;
      _lastSaveTime = Date.now();
      _doSaveActual();
    }, 1500);
  }
}
function trimReviewsPreservingDiversity(reviews, maxCount = 200){
  if(!Array.isArray(reviews) || reviews.length <= maxCount) return reviews;
  const pool = reviews.filter(Boolean);
  const preserved = [];
  const preservedKeys = new Set();
  const addPreserved = (r) => {
    if(r && !preservedKeys.has(r.k || r)){
      preservedKeys.add(r.k || r);
      preserved.push(r);
    }
  };
  
  // 1. Giữ các đánh giá đồ uống đặc biệt và mốc reset
  pool.filter(r => r.isSpecialDrink || (r.tg && r.tg.includes('Đặc Biệt'))).slice(0, 5).forEach(addPreserved);
  pool.filter(r => r.isMilestoneReset || (r.k && String(r.k).startsWith('cycle0s_'))).slice(0, 4).forEach(addPreserved);
  
  // 2. Giữ tối thiểu 3-4 đánh giá cho mỗi loại sao 1, 2, 3, 4 để người chơi luôn có đánh giá khi lọc
  [1, 2, 3, 4].forEach(s => {
    pool.filter(r => r.s === s).slice(0, 4).forEach(addPreserved);
  });
  
  // 3. Điền các vị trí còn lại bằng các đánh giá mới nhất
  const remainingSlots = Math.max(0, maxCount - preserved.length);
  const newest = pool.filter(r => !preservedKeys.has(r.k || r)).slice(0, remainingSlots);
  
  return [...newest, ...preserved];
}
function _doSaveActual(){
  if(typeof isUnstartedDay1Save === 'function' && isUnstartedDay1Save(S)) return;
  if(S && Array.isArray(S.reviews) && S.reviews.length > 200){
    S.reviews = trimReviewsPreservingDiversity(S.reviews, 200);
  }
  let js;
  try{ js = pack(200); }catch(e){ R.noStore = true; return; }
  try{
    localStorage.setItem(SAVE, js);
    if(S && ((S.day || 1) > 1 || (S.served || 0) > 0)){
      try { localStorage.setItem(SAVE + '_persist', js); } catch(e){}
    }
    R.noStore = false;
    return;
  }catch(e){}

  /* Đầy bộ nhớ Safari (QuotaExceededError): Xoá triệt để các bản backup cũ & nén gọn dữ liệu */
  dropBaks();
  try{
    localStorage.setItem(SAVE, js);
    R.noStore = false;
    return;
  }catch(e){}

  try{
    if(S && Array.isArray(S.reviews) && S.reviews.length > 120){
      S.reviews = S.reviews.slice(0, 120);
    }
    if(S && Array.isArray(S.history) && S.history.length > 120){
      S.history = S.history.slice(-120);
    }
    js = pack(120);
    localStorage.setItem(SAVE, js);
    R.noStore = false;
    return;
  }catch(e){
    try{
      if(S && Array.isArray(S.reviews)) S.reviews = S.reviews.slice(0, 40);
      js = pack(40);
      localStorage.setItem(SAVE, js);
      R.noStore = false;
    }catch(e2){
      try{
        if(localStorage.getItem(SAVE)){
          R.noStore = false;
          return;
        }
      }catch(e3){}
      R.noStore = true;
    }
  }
}
/* thử xem máy có cho lưu không */
function storeOk(){
  try{
    if(localStorage.getItem(SAVE)) return true;
    localStorage.setItem('tsT','1');
    const ok=localStorage.getItem('tsT')==='1';
    localStorage.removeItem('tsT');
    return ok;
  }catch(e){
    try{
      if(typeof localStorage !== 'undefined' && localStorage.getItem(SAVE)) return true;
    }catch(e2){}
    return false;
  }
}
function autoBak(){
  if(typeof isUnstartedDay1Save === 'function' && isUnstartedDay1Save(S)) return;
  try{const cur=pack(100);const b1=localStorage.getItem('tsBak1'),b2=localStorage.getItem('tsBak2');
  try{if(b2)localStorage.setItem('tsBak3',b2);if(b1)localStorage.setItem('tsBak2',b1);localStorage.setItem('tsBak1',cur)}
  catch(e){/* đầy bộ nhớ: bỏ dự phòng cũ, ưu tiên giữ bản chính */['tsBak3','tsBak2'].forEach(k=>{try{localStorage.removeItem(k)}catch(e){}});try{localStorage.setItem('tsBak1',cur)}catch(e){try{localStorage.removeItem('tsBak1')}catch(e){}}}}catch(e){}
}
const newCup=()=>({cost:0,size:null,sugar:null,ice:null,base:null,flav:null,tops:[],cheese:false,used:false,fill:0,sugarN:0,iceN:0,spill:false,mixed:false,sealed:false,vt:[],vi:[]});

/* ---------- ECONOMY ---------- */
function isCapbiActive(){
  return !!(typeof S !== 'undefined' && S && S.capbi && S.capbi.unlocked && S.capbi.active && (S.capbi.happiness || 0) >= 50);
}
function getCapbiIngPriceBonusRate(){
  if(!isCapbiActive()) return 0;
  return (typeof getCapbiBuffValues === 'function' ? (getCapbiBuffValues(S.capbi.level).ingPriceBonusRate || 0.10) : 0.10);
}
function getBaseItemCap(k){
  if(k === 'L') return CFG.sizeCap || 50000;
  if(ITEMS[k]){
    if(ITEMS[k].type === 'base'){
      return (k === 'matcha' ? (CFG.teaCapMatcha || 50000) : (CFG.teaCap || 40000));
    }
    if(ITEMS[k].type === 'flav' || ITEMS[k].type === 'top'){
      return ADD_CAP || 30000;
    }
  }
  return CFG.itemCap || 50000;
}
function getButlerBuffedKeys(){
  if(typeof S === 'undefined' || !S) return [];
  if(Array.isArray(S.butlerBuffedKeys) && S.butlerBuffedKeys.length > 0 && S.butlerBuffedDay === S.day){
    return S.butlerBuffedKeys.filter(k => S.unlocked && S.unlocked[k]);
  }
  const pool = [...BASE_KEYS, ...FLAV_KEYS, ...TOP_KEYS].filter(k => S.unlocked && S.unlocked[k] && ITEMS[k]);
  if(!pool.length) return [];
  const shuffled = [...pool].sort(() => Math.random() - 0.5);
  const picked = shuffled.slice(0, 3);
  S.butlerBuffedKeys = picked;
  S.butlerBuffedDay = S.day;
  return picked;
}
function getButlerBestSellerKeys(){
  return getButlerBuffedKeys();
}
function getButlerOverstockedKeys(){
  return []; // Không còn giảm giá xả tồn nguyên liệu nữa
}
function isButlerBuffed(k){
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(!hasButler) return false;
  return getButlerBuffedKeys().includes(k);
}
function isButlerBestSeller(k){
  return isButlerBuffed(k);
}
function isButlerOverstocked(k){
  return false; // Không còn giảm giá nguyên liệu nữa
}
function getButlerBoostType(k){
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(!hasButler) return null;
  if(isButlerBuffed(k)) return 'buffed';
  return 'standard';
}
function unbuffedSafeMax(k){
  let normalCap = CFG.itemCap || 50000;
  if(k === 'L') normalCap = CFG.sizeWarn || 20000;
  else if(ITEMS[k]){
    if(ITEMS[k].type === 'base'){
      normalCap = (k === 'matcha' ? (CFG.teaCapMatcha || 50000) : (CFG.teaCap || 40000));
    } else if(ITEMS[k].type === 'flav' || ITEMS[k].type === 'top'){
      normalCap = ADD_WARN || 20000;
    }
  }
  return normalCap;
}
function safeMax(k){
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  const normalCap = unbuffedSafeMax(k);
  if(hasButler && isButlerBuffed(k)){
    const def = (k === 'L' ? (DEF_SELL.L || 7000) : (DEF_SELL[k] || 10000));
    const buffFromDef = Math.round((def * 1.50) / 500) * 500;
    const buffFromCap = Math.round((normalCap * 1.50) / 500) * 500;
    return Math.max(normalCap, buffFromDef, buffFromCap);
  }
  return normalCap;
}

const sellMax = k => {
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  const baseCap = getBaseItemCap(k);
  let b = baseCap;
  if(hasButler && isButlerBuffed(k)){
    const def = (k === 'L' ? (DEF_SELL.L || 7000) : (DEF_SELL[k] || 10000));
    const buffPrice = Math.round((def * 1.50) / 500) * 500; // Buff +50% giá bán
    b = Math.max(baseCap, buffPrice);
  } else if(!hasButler && typeof S !== 'undefined' && S && S.startupLocation === 'cantho'){
    b = Math.round(b * 0.90);
  }
  const r = getCapbiIngPriceBonusRate();
  return r > 0 ? Math.round(b * (1 + r)) : b;
};
const ADD_WARN=20000,ADD_CAP=30000;
const addOk=k=>{
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(hasButler){
    if(isButlerBuffed(k)) return sv(S.sell, k) <= sellMax(k);
    return sv(S.sell, k) <= ADD_CAP;
  }
  return sv(S.sell, k) <= ADD_CAP;
};
const addSkip=k=>{
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(hasButler){
    if(isButlerBuffed(k)) return sv(S.sell, k) > sellMax(k);
    return sv(S.sell, k) > ADD_WARN && Math.random() >= 0.2;
  }
  return sv(S.sell, k) > ADD_WARN && Math.random() >= 0.2;
};
const sv=(sell,k)=>{
  const v=+sell[k];
  if(!isFinite(v)||v<=0) return 0;
  let val = Math.min(v, sellMax(k));
  const r = getCapbiIngPriceBonusRate();
  if(r > 0) val = Math.round(val * (1 + r));
  return val;
};
const price=(o,sell=S.sell)=>Math.max(10000,sv(sell,o.base)+(o.flav&&ITEMS[o.flav]?sv(sell,o.flav):0)+o.tops.reduce((a,t)=>a+sv(sell,t),0)+(o.cheese?sv(sell,'cheese'):0)+(o.size==='L'?sv(sell,'L'):0));
window.price=price;
function sanitize(){
  Object.keys(S.sell).forEach(k=>{
    let v=+S.sell[k];
    if(!isFinite(v)||v<0) v=DEF_SELL[k]||0;
    if(DEF_SELL[k] && v < DEF_SELL[k]){
      v = DEF_SELL[k];
    }
    S.sell[k]=Math.min(v,safeMax(k));
  });
  [...BASE_KEYS, ...FLAV_KEYS, ...TOP_KEYS].forEach(k => {
    if(S.unlocked && S.unlocked[k] && (!S.sell[k] || S.sell[k] < (DEF_SELL[k] || 0))){
      S.sell[k] = DEF_SELL[k] || 0;
    }
  });
  let bad=false;const fix=r=>{if(!r||!r.sales)return;let f=false;
    Object.entries(r.sales).forEach(([k,x])=>{if(x&&x.q>0&&!isFinite(x.a)){x.a=x.q*(DEF_SELL[k]||25000);f=true}});
    if(r.bad && r.bad > 7000000) r.bad = 0;
    if(f){bad=true;const sl=Object.values(r.sales).reduce((a,x)=>a+x.a,0);r.onl=Math.min(r.onl||0,sl);r.fee=Math.round(r.onl*CFG.commission/100);r.tax=Math.min(r.tax||0,Math.round(sl*(CFG.vat+CFG.pit)/100))}};
  (S.history||[]).forEach(fix);fix(S.cur);

  // Anti-Cheat Hard Enforcement:
  // Chuẩn hóa và bảo vệ số lần 5 Sao (star5Count) khoa học, bảo đảm công bằng tuyệt đối cho Bảng Xếp Hạng:
  // Trần khả thi thích ứng theo meta hiện đại (bao gồm cả buff Me Két Tinh + nhiều chi nhánh): Math.min(80000, 200 + (S.day || 1) * 500).
  const maxFeasibleStar5 = Math.min(80000, 200 + (S.day || 1) * 500);
  if(S.star5Count > maxFeasibleStar5){
    console.warn('[Anti-Cheat] star5Count bất thường:', S.star5Count, 'kẹp về trần khả thi:', maxFeasibleStar5);
    S.star5Count = Math.floor(maxFeasibleStar5);
  }
  if(S.franchise && Array.isArray(S.franchise.partners) && S.franchise.partners.length > 20){
    console.warn('[Anti-Cheat] Số lượng đối tác nhượng quyền bất thường:', S.franchise.partners.length);
    S.franchise.partners = S.franchise.partners.slice(0, 16);
  }
  // Chuẩn hóa equipLv (binhrot, sealer, khaytop, lyduongda tối đa cấp 3)
  if(S.equipLv && typeof S.equipLv === 'object'){
    ['binhrot','sealer','khaytop','lyduongda'].forEach(k=>{
      let lv = parseInt(S.equipLv[k], 10);
      if(isNaN(lv) || lv < 1) lv = 1;
      if(lv > 3) lv = 3;
      S.equipLv[k] = lv;
    });
  }
  S.upgLv = S.upgLv || {tra:0, huong:0, top:0, equip:0, staff:0, onl:0};
  // Chống hack: Tự động reset toàn bộ cấp độ > 50 về lại Cấp 50 đúng 1 lần duy nhất để xóa bỏ hack cũ
  if(!S._upgLvResetTo50Done_v12_47_538){
    S._upgLvResetTo50Done_v12_47_538 = true;
    if(S.upgLv){
      let resetCount = 0;
      ['tra','huong','top','equip','staff','onl'].forEach(k=>{
        if(typeof S.upgLv[k] === 'number' && S.upgLv[k] > 50){
          S.upgLv[k] = 50;
          resetCount++;
        }
      });
      if(resetCount > 0){
        save();
        setTimeout(() => {
          if(typeof toast === 'function') toast(`🛡️ Đã chuẩn hóa ${resetCount} hạng mục nâng cấp về Cấp 50 để mở màn đột phá công bằng!`, 6000, 1);
        }, 500);
      }
    }
  }

  // Đồng bộ chuẩn hóa upgLv ngay tại loadFrom() theo cơ chế Hybrid Cap (Trần cứng 80 + Trần động theo rev & served, hỗ trợ Nhượng quyền & Veteran day >= 150)
  if(S.upgLv){
    const curDay = Math.max(1, parseInt(S.day, 10) || 1);
    const curRev = Math.max(0, Number(S.totalRev) || 0);
    const curServed = Math.max(0, Number(S.served != null ? S.served : S.best) || 0);
    const franCount = (S.franchise && Array.isArray(S.franchise.partners)) ? S.franchise.partners.length : 0;
    const hasFran = franCount > 0;
    const isVet = curDay >= 150;
    const effRev = hasFran ? (curRev + franCount * curDay * 50000000) : (isVet ? (curRev + curDay * 200000000) : curRev);
    const effServed = hasFran ? (curServed + franCount * curDay * 50) : (isVet ? (curServed + curDay * 250) : curServed);
    const revCap = 40 + Math.log10(Math.max(1, effRev / 1e9)) * 12;
    const servedCap = 40 + Math.log10(Math.max(1, effServed / 1e4)) * 12;
    const dynCap = Math.min(80, Math.ceil(Math.min(revCap, servedCap)));
    const minRev50 = (hasFran || isVet) ? 15000000000 : 50000000000;
    const minServed50 = (hasFran || isVet) ? 50000 : 100000;
    ['tra','huong','top','equip','staff','onl'].forEach(k=>{
      if(typeof S.upgLv[k] !== 'number' || isNaN(S.upgLv[k]) || S.upgLv[k] < 0) S.upgLv[k] = 0;
      if(S.upgLv[k] > 80) S.upgLv[k] = 80;
      if(S.upgLv[k] > 50 && (curRev < minRev50 || curServed < minServed50)) S.upgLv[k] = 50;
      else if(S.upgLv[k] > 50 && S.upgLv[k] > dynCap) S.upgLv[k] = Math.max(50, dynCap);
    });
  }
  // Dọn dẹp sự cố cạy két ảo nếu tiền trong két dưới trần an toàn động theo ngày và hoàn tiền nếu đang chờ sự cố:
  S._shadowbanned = false;
  S._banned = false;
  S._lastPeakHoardCash = 0;
  if(S.badNow && (S.badNow.id === 'trom' || S.badNow.all) && (Number(S.money) || 0) < getSafeCashCeiling(S.day)){
    const stolenVal = Number(S.badNow.v) || 0;
    if(stolenVal > 0){
      S.money = (Number(S.money) || 0) + stolenVal;
      if(S.cur && S.cur.stolen) S.cur.stolen = Math.max(0, S.cur.stolen - stolenVal);
    }
    S.badNow = null;
  }
  const HLoad = Array.isArray(S.history) ? S.history : [];
  if(HLoad.length > 0){
    const histBrRev = HLoad.reduce((a, r) => a + Math.max(0, Number(r && r.branchRev) || 0), 0);
    const histBrNet = HLoad.reduce((a, r) => a + (Number(r && r.branchNet) || 0), 0);
    if(!S.totalBranchRev || S.totalBranchRev < histBrRev) S.totalBranchRev = histBrRev;
    if(S._legacyBranchNetCountersMissing) S.totalBranchNet = histBrNet;
    else if(S.totalBranchNet < histBrNet) S.totalBranchNet = histBrNet;
  }
  if(typeof calcVerifiedCumulativeRevenue === 'function'){
    const revCheck = calcVerifiedCumulativeRevenue(S);
    if(revCheck.mainRev > (Number(S.totalRev) || 0)) S.totalRev = revCheck.mainRev;
  }
  // Tự động khôi phục các Chi nhánh / Nhượng quyền từng bị đánh dấu bankrupt/closed oan do doanh thu ngày 3 Tỷ+ đổ vào két trước khi kịp gửi Bank
  if(!isVerifiedHoardCheater(S.money)){
    if(S.branches && typeof S.branches === 'object'){
      Object.values(S.branches).forEach(bData => {
        if(bData && (bData.bought || bData.owned) && bData.bankrupt){
          bData.bankrupt = false;
          bData.closed = false;
        }
      });
    }
    if(S.franchise && Array.isArray(S.franchise.partners)){
      S.franchise.partners.forEach(p => {
        if(p && p.bankrupt){
          p.bankrupt = false;
          p.closed = false;
        }
      });
    }
  }
  const cap = Math.min(500000000000, Math.max(50000000000, CFG.startMoney + (S.day || 1) * 5000000000));
  if(!isFinite(S.money) || S.money > cap){
    S.money = Math.min(Math.max(0, Number(S.money) || 0), cap);
    const H = S.history || [];
    const profOp = H.reduce((a,r)=>{const ingV=Object.values(r.ing||{}).reduce((s,x)=>s+(x.v||0),0);const opC=(r.rent||0)+(r.util||0)+(r.wage||0)+(r.bad||0)+(r.loanInt||0)+(r.loanOut||0)+(r.fee||0)+(r.tax||0)+ingV;return a+Math.max(0,recRev(r)-opC)},0);
    const minEst = Math.round((S.totalRev || 0) * 0.35);
    S.totalProfit = Math.max(0, Number(S.totalProfit) || 0, profOp, minEst);
    S.totalRev = Math.max(0, Number(S.totalRev) || 0, H.reduce((a,r)=>a+recRev(r),0));
    S.yearRev = Math.min(S.yearRev || 0, S.totalRev);
    if(!isFinite(S.cur.tips) || S.cur.tips > cap) S.cur.tips = 0;
    save();
  }
  if(S.bank && typeof S.bank === 'object'){
    if(!isFinite(S.bank.balance) || S.bank.balance > cap){
      S.bank.balance = Math.min(Math.max(0, Number(S.bank.balance) || 0), cap);
    }
  }
  S.gambleWon = S.gambleWon || 0;
  S.gambleLost = S.gambleLost || 0;
  S.gambleNet = S.gambleNet || 0;
  S.staffTraining = S.staffTraining || {};
  Object.keys(S.staffTraining).forEach(k=>{
    let v = parseInt(S.staffTraining[k], 10);
    if(isNaN(v) || v < 0) v = 0;
    if(v > 5) v = 5;
    S.staffTraining[k] = v;
  });
  S.staffTotalDaysWorked = S.staffTotalDaysWorked || {};
  STAFF.forEach(u=>{
    if(S.staffTotalDaysWorked[u.id] == null){
      const kpiLv = (S.staffKpi && S.staffKpi[u.id] && S.staffKpi[u.id].level) || 0;
      const curDays = (S.kpiPeriodStats && S.kpiPeriodStats[u.id] && S.kpiPeriodStats[u.id].daysWorked) || 0;
      S.staffTotalDaysWorked[u.id] = Math.max(0, kpiLv * 7 + curDays);
    } else {
      S.staffTotalDaysWorked[u.id] = Math.max(0, parseInt(S.staffTotalDaysWorked[u.id], 10) || 0);
    }
  });
  if(typeof enforceStaffExclusivity === 'function') enforceStaffExclusivity();
  (S.reviews || []).forEach(r => {
    if(r.freeDrinkNext && !r.freeDrinkDelivered) {
      r.freeDrinkActive = true;
    }
  });
  if(S.star5Count == null){
    const servedFallbackStars = Math.min(200, Math.floor((Number(S.served != null ? S.served : S.best) || 0) / 500));
    if(S.bank && S.bank.cap && S.bank.cap > 10000000){
      const times = Math.round(Math.log(S.bank.cap / 10000000) / Math.log(1.10));
      S.star5Count = Math.max(1, times, servedFallbackStars);
    } else if(rating() >= 4.95){
      S.star5Count = Math.max(1, servedFallbackStars);
    } else {
      S.star5Count = servedFallbackStars;
    }
  }
  // Khắc phục review 0 sao reset chu kỳ cũ bị nhồi quá nhiều (40 cái) gây kẹt điểm
  if(S.reviews && S.reviews.length){
    let cycle0Count = 0;
    S.reviews = S.reviews.filter(r => {
      if(r && r.k && r.k.startsWith('cycle0s_')){
        cycle0Count++;
        return cycle0Count <= 4;
      }
      return true;
    });
  }
  // Xoá bỏ triệt để các review xử phạt kiểm tra ATTP cờ bạc cũ
  if(S.reviews && S.reviews.length){
    const initLen = S.reviews.length;
    S.reviews = S.reviews.filter(r => {
      if(!r) return false;
      const k = r.k || '';
      const n = r.n || '';
      const t = r.t || '';
      if(k.startsWith('attp_') || k.includes('attp') || n.includes('ATTP') || t.includes('ATTP') || t.includes('Đoàn kiểm tra')) {
        return false;
      }
      return true;
    });
    if(S.reviews.length !== initLen && typeof head === 'function'){
      head();
    }
  }
  if(typeof initBankState === 'function') initBankState();

  // Khắc phục dữ liệu cũ bị nhiễm số tiền thiếu thành số khách bỏ về (>200)
  (S.history || []).forEach(r => {
    if(r && typeof r.lost === 'number' && r.lost > 200) {
      r.lost = Math.min(Math.round((r.served || 50) * 0.05), 25);
    }
  });
  if(typeof R !== 'undefined' && R && R.today && typeof R.today.lost === 'number' && R.today.lost > 200) {
    R.today.lost = Math.min(Math.round((R.today.served || 50) * 0.05), 15);
  }
  if(R){
    R.staffDayOff = {};
    R.staffLate = {};
  }
  if(typeof $ === 'function'){
    const cEl = $('card');
    if(cEl && cEl.innerHTML && (cEl.innerHTML.includes('DRAMA NHÂN SỰ') || cEl.innerHTML.includes('áp lực cạnh tranh'))){
      if($('modal')) $('modal').hidden = true;
      cEl.innerHTML = '';
    }
  }
  cleanMilestoneResetReviews();
  backfillSpecialDrinkReviewsIfMissing();
  if(!S.lobbyRooms || !Array.isArray(S.lobbyRooms)) S.lobbyRooms = [true, false, false, false];
  S.totalProfit = calcTotalProfit();
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler') && typeof staffButlerPerformDuties === 'function'){
    try { staffButlerPerformDuties(true); } catch(e) { console.error('Sanitize butler duties:', e); }
  }
}
const unitCost=o=>{
  let ic=CFG.cost.ice,sc=CFG.cost.sugar;
  if(S&&S.garden&&S.garden.lemonBuffDays>0){const f=S.garden.lemonBuffBoost?0.7:0.8;ic=Math.round(ic*f);sc=Math.round(sc*f);}
  const isCanTho = (typeof S !== 'undefined' && S && S.startupLocation === 'cantho');
  const isBmt = (typeof S !== 'undefined' && S && S.startupLocation === 'buonmethuot');
  const bMul = (typeof getStartupBuffMul === 'function') ? getStartupBuffMul() : 1.0;
  const dMul = (typeof getStartupDebuffMul === 'function') ? getStartupDebuffMul() : 1.0;
  const topsCost = o.tops.reduce((a,t)=>{
    let tc = CFG.cost[t] || 0;
    if(isCanTho && ITEMS[t] && (ITEMS[t].g === 'thach' || ITEMS[t].g === 'pm' || ITEMS[t].g === 'top')){
      tc = Math.round(tc * Math.max(0.35, 1 - 0.25 * bMul));
    }
    return a + tc;
  }, 0);
  let baseCost = CFG.cost[o.base] || 0;
  if(isBmt){
    baseCost = Math.round(baseCost * Math.max(0.50, 1 - 0.15 * bMul)); // Buôn Ma Thuột: Nguyên liệu cốt Trà & Sữa -15% × buffMul
  }
  let c = baseCost+(o.flav&&ITEMS[o.flav]?CFG.cost[o.flav]:0)+topsCost+(o.cheese?CFG.cost.cheese:0)+CFG.cost.cup+(level()>=2&&o.ice&&o.ice!=='Không đá'?ic:0)+(level()>=2&&o.sugar&&o.sugar>0?sc:0);
  if(typeof S !== 'undefined' && S){
    if(S.startupLocation === 'sapa'){
      c = Math.round(c * (1 + 0.15 * dMul)); // Sa Pa: Chi phí vận chuyển đèo dốc +15% × debuffMul
    } else if(S.startupLocation === 'hoangsa'){
      c = Math.round(c * (1 + 0.20 * dMul)); // Hoàng Sa – Trường Sa: +20% × debuffMul
    } else if(S.startupLocation === 'camau' && (o.isCombo || (o.tops && o.tops.length >= 2))){
      c = Math.round(c * (1 + 0.12 * dMul)); // Cà Mau: Đơn gia đình +12% × debuffMul
    } else if(S.startupLocation === 'phuquoc'){
      c = Math.round(c * (1 + 0.15 * dMul)); // Phú Quốc: Giá vốn nguyên liệu +15% × debuffMul
    } else if(S.startupLocation === 'dalat' && (o.base === 'olong' || o.base === 'hong')){
      c = Math.round(c * (1 + 0.10 * dMul)); // Đà Lạt: Nguyên liệu đặc sản +10% × debuffMul
    }
  }
  return c;
};
function getEffectivePriceCap(o){
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(hasButler) return 999999000; // Quản gia bảo chứng: không áp trần giá ly, khách 100% không chê đắt
  return CFG.priceCap || 120000;
}
const priceIdx=o=>{
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(hasButler){
    if(typeof orderPricey === 'function' && orderPricey(o)) return price(o)/price(o,DEF_SELL);
    return 1.0;
  }
  return price(o)/price(o,DEF_SELL);
};
const overCap=o=>{
  if(!o) return false;
  const hasButler = (typeof isStaffActive === 'function' && isStaffActive('staffButler'));
  if(hasButler) return false; // Quản gia bảo chứng: 100% không bao giờ chê đắt!
  return price(o) > getEffectivePriceCap(o);
};
const pricyItems=()=>{
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler')) return []; // Quản gia bảo chứng: 100% không bao giờ chê đắt!
  return [...BASE_KEYS.filter(k=>S.unlocked && S.unlocked[k] && S.sell[k] > safeMax(k)), ...(S.sell.L > safeMax('L') ? ['L'] : [])];
};
const lPricey=()=>{
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler')) return false; // Quản gia bảo chứng: 100% không bao giờ chê đắt!
  return S.sell.L > safeMax('L');
};
const lChance=()=>{
  if(S.sell.L >= (CFG.sizeCap || 50000)) return 0;
  if(lPricey()) return 0.035;
  return 0.35;
};
function getStaffNominalDailyWage(stId, rev = 0){
  if(stId === 'staffGuard') return 300000 + Math.round(rev * 0.01);
  if(stId === 'staffRacer') return 1000000 + Math.round(rev * 0.005);
  if(stId === 'staffButler') return 500000 + Math.round(rev * 0.02);
  if(stId === 'staffCleaner') return 400000 + Math.round(rev * 0.015);
  if(stId === 'staffShipper') return 600000 + Math.round(rev * 0.01);
  const st = STAFF.find(x => x.id === stId);
  if(st && CFG[st.wage] != null) return CFG[st.wage];
  if(stId === 'staff2') return CFG.wage2;
  if(stId === 'staffGz') return CFG.wageGz;
  if(stId === 'staffMkt') return CFG.wageMkt;
  if(stId === 'staffBuyer') return CFG.wageBuyer;
  if(stId === 'staffSv') return CFG.wageSv;
  if(stId === 'staffOn') return CFG.wageOn;
  return CFG.wage0 || 0;
}

function getStoreReferenceRev(){
  if(typeof S === 'undefined' || !S) return 5000000;
  if(S.kpiPeriodTotalRev && S.staffSalesDays > 0) return Math.round(S.kpiPeriodTotalRev / S.staffSalesDays);
  if(S.history && S.history.length > 0){
    const recent = S.history.slice(-7);
    return Math.round(recent.reduce((a, b) => a + (b.rev || 0), 0) / recent.length);
  }
  if(S.totalRev && S.day > 0) return Math.round(S.totalRev / S.day);
  return 5000000;
}

function getStaffHireCost(u){
  const id = (u && typeof u === 'object') ? u.id : u;
  const st = (u && typeof u === 'object') ? u : STAFF.find(x => x.id === id);
  if(!st) return 0;
  if(st.id === 'staffGuard' || st.id === 'staffRacer' || st.id === 'staffButler' || st.id === 'staffCleaner' || st.id === 'staffShipper'){
    const refRev = getStoreReferenceRev();
    return getStaffNominalDailyWage(st.id, refRev);
  }
  return st.cost || 0;
}

function getStaffHireCostTxt(u){
  const st = (u && typeof u === 'object') ? u : STAFF.find(x => x.id === u);
  if(!st) return 'Miễn phí';
  if(st.id === 'staffGuard' || st.id === 'staffRacer' || st.id === 'staffButler' || st.id === 'staffCleaner' || st.id === 'staffShipper'){
    const c = getStaffHireCost(st);
    return c >= 1e6 ? (c / 1e6).toFixed(1).replace(/\.0$/, '') + 'tr' : fmt(c);
  }
  return st.cost ? (st.cost >= 1e6 ? (st.cost / 1e6) + 'tr' : fmt(st.cost)) : 'Miễn phí';
}
const isStaffUnpaid=(id)=>!!(S&&S.staffUnpaidDays&&S.staffUnpaidDays[id]>0);
const wageDay=()=>STAFF.reduce((a,x)=>{
  if(!S.upg[x.id]||(R.staffDayOff&&R.staffDayOff[x.id])||isStaffUnpaid(x.id))return a;
  const rev = (R && R.today && R.today.rev) ? R.today.rev : ((S && S.cur && S.cur.rev) ? S.cur.rev : 0);
  const count = (x.id==='staff2'&&typeof getStaff2Count==='function')?getStaff2Count():(x.id==='staffBuyer'&&typeof getStaffBuyerCount==='function')?getStaffBuyerCount():(x.id==='staffOn'&&typeof getStaffOnCount==='function')?getStaffOnCount():1;
  return a + (getStaffNominalDailyWage(x.id, rev) * count);
},0);
function upgCount(){
  return (typeof S !== 'undefined' && S && S.upg) ? Object.keys(S.upg).filter(k => S.upg[k]).length : 0;
}
const fixed=()=>{
  let r = CFG.rent;
  let u = CFG.utilBase + upgCount() * CFG.utilPerUpg + (S.upg && S.upg.fridge ? 100000 : 0);
  const isMainOwned = !!(S && S.realEstate && S.realEstate.main);
  const ownedBranchCount = (S && S.realEstate && S.realEstate.branches) ? Object.values(S.realEstate.branches).filter(Boolean).length : 0;
  const branchDiscount = Math.min(1.0, ownedBranchCount * 0.25);
  const bMul = (typeof getStartupBuffMul === 'function') ? getStartupBuffMul() : 1.0;
  const dMul = (typeof getStartupDebuffMul === 'function') ? getStartupDebuffMul() : 1.0;

  if(isMainOwned){
    // ĐÃ MUA ĐỨT MẶT BẰNG TRỤ SỞ FLAGSHIP (SỔ ĐỎ CHÍNH CHỦ): 0đ tiền thuê nhà & điện nước cố định
    r = 0;
    u = 0;
  } else {
    if(S && S.startupLocation === 'hanoi'){
      r = Math.round(r * (1 + 0.15 * dMul)); // Hà Nội: Mặt bằng & vận hành Thủ đô +15% × debuffMul
      u = Math.round(u * (1 + 0.15 * dMul));
    } else if(S && S.startupLocation === 'hcm'){
      u = Math.round(u * (1 + 0.20 * dMul)); // TP.HCM: Điện nước +20% × debuffMul
    } else if(S && S.startupLocation === 'buonmethuot'){
      r = Math.round(r * Math.max(0.30, 1 - 0.25 * bMul)); // Buôn Ma Thuột: Mặt bằng -25% × buffMul
    } else if(S && S.startupLocation === 'camau'){
      u = Math.round(u * (1 + 0.12 * dMul)); // Cà Mau: Điện nước +12% × debuffMul
    }
    if(branchDiscount > 0){
      r = Math.round(r * (1 - branchDiscount));
      u = Math.round(u * (1 - branchDiscount));
    }
  }
  return { rent: r, util: u };
};
function rating(){const r=(S.reviews||[]).slice(0,40);if(!r.length)return 4;return r.reduce((a,x)=>a+(x&&x.s!=null?+x.s:4),0)/r.length}
function starStr(v){const f=Math.max(0,Math.min(5,Math.round(v)));return f===0?'☆☆☆☆☆ (0★)':'★'.repeat(f)+'☆'.repeat(5-f)}
/* ---------- SỰ KIỆN & THỜI TIẾT ---------- */
const EVS={
  hot:{n:'Trời nóng',d:'Khách quầy đông hơn 35%, nhiều người gọi thêm đá giải nhiệt',ic:'upsnow',mul:1.35,onlMul:0.95},
  rain:{n:'Trời mưa',d:'Khách quầy giảm 35%, khách lười ra đường nên đơn online bùng nổ (+80%)',ic:'warn',mul:0.65,onlMul:1.80},
  cold:{n:'Trời se lạnh',d:'Khách chuộng các loại trà đậm vị, ít đá, thích thêm thạch & phô mai (+20% khách)',ic:'upsnow',mul:1.20,onlMul:1.05},
  storm:{n:'Trời bão lớn',d:'Mưa gió bão bùng! Khách tại quán giảm 50%, đơn online bùng nổ cực mạnh (+120%)',ic:'warn',mul:0.50,onlMul:2.20},
  sunny:{n:'Nắng đẹp dịu mát',d:'Thời tiết lý tưởng! Khách dạo phố ghé quán tấp nập (+40%), kiên nhẫn hơn',ic:'calendar',mul:1.40,onlMul:1.00},
  fog:{n:'Sương mù mát mẻ',d:'Khách chill ghé quán đông hơn (+20%), thích nhâm nhi trà olong & matcha',ic:'upsnow',mul:1.20,onlMul:1.00},
  humid:{n:'Nồm ẩm oi ả',d:'Thời tiết nồm ẩm khó chịu, khách ghé giải khát (+15%)',ic:'warn',mul:1.15,onlMul:1.10},
  weekend:{n:'Cuối tuần',d:'Khách đông hơn 30%, nhiều người mua 2-3 ly',ic:'calendar',mul:1.30,onlMul:1.25},
  students:{n:'Học sinh tan học',d:'Giữa ngày có một nhóm học sinh ghé cùng lúc (+15% khách)',ic:'people',mul:1.15,onlMul:1.05},
  reviewer:{n:'Chuyên gia ẩm thực ghé quán',d:'Một khách đặc biệt: pha đúng được 3 đánh giá tốt, pha sai bị đánh giá xấu',ic:'star',mul:1.05,onlMul:1.00},
  trend:{n:'Món hot trên mạng',d:'% được gọi nhiều gấp đôi, khách tò mò ghé quán (+25%)',ic:'chartup',mul:1.25,onlMul:1.20},
  sale:{n:'Nhà cung cấp giảm giá',d:'Nhập % rẻ hơn 30% trong hôm nay',ic:'price',mul:1.00,onlMul:1.00},
  holiday:{n:'Ngày lễ',d:'Khách đông gấp đôi (+100%), tiền boa gấp đôi',ic:'gift',mul:2.00,onlMul:1.60}
};
const GIFTS=[
  {n:'Lì xì từ mạnh thường quân',d:'Một vị khách quen thích quán nên gửi tặng',min:50000,max:200000},
  {n:'Trả lại ví cho khách',d:'Bạn nhặt được ví khách để quên và trả lại, khách gửi tiền cảm ơn',min:50000,max:150000},
  {n:'Giải quán đẹp khu phố',d:'Quán được bình chọn là quán dễ thương nhất khu',min:200000,max:300000,need:()=>upgCount()>=2},
  {n:'Nhãn hàng trà tài trợ',d:'Quán được đánh giá cao nên được nhãn hàng tài trợ',min:400000,max:600000,need:()=>S.reviews.length>=20&&rating()>=4.5},
  {n:'Bán ve chai, thùng carton',d:'Dọn kho bán được ít tiền',min:20000,max:60000},
  {k:'bung',n:'Công an trả tiền khách bùng',d:'Công an phường bắt được nhóm khách ôm ly bỏ chạy hôm trước, trả lại tiền cho quán',min:50000,max:200000,need:()=>(S.bungN||0)>0},
  {n:'Vé số trúng giải',d:'Một khách trả tiền trà sữa bằng tờ vé số, ai ngờ trúng giải',min:100000,max:500000},
  {n:'Nhà cung cấp hoàn tiền',d:'Lô nguyên liệu tuần trước giao thiếu, nhà cung cấp gửi trả lại tiền',min:50000,max:250000},
  {n:'Quán được bình chọn',d:'Quán được bình chọn trên mạng là quán trà sữa được yêu thích, nhận tiền thưởng',min:200000,max:500000,need:()=>S.reviews.length>=50&&rating()>=4.3},
  {n:'Cọc tiệc công ty',d:'Một công ty gần đây đặt trà sữa cho tiệc cuối tháng, gửi trước tiền cọc',min:150000,max:400000,need:()=>S.day>=15}
];
const ev=()=>S.ev&&S.evDay===S.day?S.ev:null;
const evIs=id=>{const e=ev();return !!e&&e.id===id};
const evText=e=>(e&&EVS[e.id]&&EVS[e.id].d)?EVS[e.id].d.replace('%',e.k&&ITEMS[e.k]?low(ITEMS[e.k].n):''):'';
/* ===== HỆ THỐNG HỢP ĐỒNG ĐẶT TIỆC & ĐƠN LỚN ===== */
function getPartyAvgCupPrice(){
  let priceFromHist = 0;
  if(typeof S !== 'undefined' && S && S.history && S.history.length > 0){
    const valid = S.history.slice(-7).filter(r => r && (r.served || 0) > 0);
    if(valid.length > 0){
      let totSales = 0;
      let totCups = 0;
      valid.forEach(r => {
        const sales = (r.sales && typeof r.sales === 'object') ? Object.values(r.sales).reduce((a, x) => a + (x && x.a ? Number(x.a) || 0 : 0), 0) : (r.rev || 0);
        totSales += sales;
        totCups += (r.served || 0);
      });
      if(totCups > 0 && totSales > 0){
        priceFromHist = Math.round(totSales / totCups);
      }
    }
  }

  let priceFromMenu = 32000;
  if(typeof S !== 'undefined' && S && S.sell){
    const unlockedBases = (typeof BASE_KEYS !== 'undefined' && Array.isArray(BASE_KEYS)) ? BASE_KEYS.filter(k => S.unlocked && S.unlocked[k]) : [];
    if(unlockedBases.length > 0){
      const avgBase = unlockedBases.reduce((a, k) => a + (S.sell[k] || (typeof DEF_SELL !== 'undefined' && DEF_SELL[k]) || 25000), 0) / unlockedBases.length;
      priceFromMenu = Math.round(avgBase * 1.45);
    }
  }

  // Lấy giá cao nhất giữa doanh thu thực tế gần đây và menu hiện tại, sàn tối thiểu 35.000đ/ly
  const finalPrice = Math.max(35000, priceFromHist, priceFromMenu);
  return Math.round(finalPrice / 1000) * 1000;
}

function rollPartyContract(d){
  if(d < 3) { S.partyContract = null; return; }
  const isSpecial = evIs('weekend') || evIs('holiday');
  const chance = isSpecial ? 0.75 : 0.45;
  if(Math.random() >= chance){
    S.partyContract = null;
    return;
  }
  const TYPES = [
    {
      type: 'birthday', icon: '🎂', typeLabel: 'Tiệc Sinh Nhật',
      titles: ['🎂 Tiệc Sinh Nhật Tuổi Mộng Mơ', '🎂 Tiệc Thôi Nôi Bé Cưng', '🎂 Sinh Nhật Bất Ngờ Cho Bạn Thân', '🎂 Tiệc Sinh Nhật Văn Phòng'],
      clients: ['Chị Mai (Mẹ bé Bin)', 'Anh Hoàng (Nhóm bạn thân)', 'Bé Trâm (Sinh viên)', 'Chị Vy (Trưởng ban sự kiện)']
    },
    {
      type: 'company', icon: '🏢', typeLabel: 'Tiệc Công Ty',
      titles: ['🏢 Tiệc Trà Chiều Công Ty Công Nghệ', '🏢 Tiệc Họp Khởi Động Dự Án Mới', '🏢 Chiêu Đãi Đối Tác & Khách Hàng', '🏢 Tiệc Trà Thứ Sáu Toàn Công Ty'],
      clients: ['Anh Đức (Giám đốc dự án)', 'Chị Lan (Trưởng phòng Nhân sự)', 'Anh Minh (Team Leader IT)', 'Chị Thảo (Admin văn phòng)']
    },
    {
      type: 'alumni', icon: '🎓', typeLabel: 'Họp Lớp & Hội Khóa',
      titles: ['🎓 Liên Hoan Họp Lớp Niên Khóa Cũ', '🎓 Tiệc Tri Ân Thầy Cô Giáo', '🎓 Họp Mặt Hội Đồng Hương', '🎓 Tiệc Mừng Tốt Nghiệp Ra Trường'],
      clients: ['Anh Tuấn (Lớp trưởng K45)', 'Chị Hương (Ban liên lạc hội khóa)', 'Bạn Duy (Bí thư đoàn khoa)', 'Chị Ngọc (Đại diện cựu học sinh)']
    },
    {
      type: 'sports', icon: '⚽', typeLabel: 'Hội Thao & Giải Đấu',
      titles: ['⚽ Giải Bóng Đá Giao Hữu Công Ty', '🏸 Giải Cầu Lông Mở Rộng Cuối Tuần', '🏃 Tiệc Mừng Hoàn Thành Giải Marathon', '🏀 Giao Lưu Thể Thao Thanh Niên'],
      clients: ['Anh Thắng (Đội trưởng bóng đá)', 'Anh Dũng (Ban tổ chức hội thao)', 'Chị Phương (CLB Thể thao)', 'Anh Kiên (Đội cổ vũ)']
    },
    {
      type: 'festival', icon: '🎊', typeLabel: 'Lễ Hội & Khai Trương',
      titles: ['🎊 Tiệc Mừng Khai Trương Cửa Hàng Bạn', '🎊 Tiệc Workshop Sáng Tạo Cuối Tuần', '🎊 Hội Chợ Ẩm Thực Khu Phố', '🎊 Tiệc Tri Ân Khách Hàng Thân Thiết'],
      clients: ['Chị Hằng (Chủ shop thời trang)', 'Anh Quang (Ban điều hành phố đi bộ)', 'Chị Yến (Tổ chức sự kiện cộng đồng)', 'Anh Hưng (Nghệ nhân gốm)']
    }
  ];

  const tInfo = rnd(TYPES);
  const title = rnd(tInfo.titles);
  const client = rnd(tInfo.clients);

  let cups;
  let refServed = 0;
  if(typeof S !== 'undefined' && S && S.history && S.history.length > 0){
    const valid = S.history.slice(-7).filter(r => r && (r.served || 0) > 0);
    if(valid.length > 0){
      refServed = Math.round(valid.reduce((a, b) => a + (b.served || 0), 0) / valid.length);
    }
  }

  if(refServed >= 80){
    const minCups = Math.max(25, Math.round(refServed * 0.20));
    const maxCups = Math.max(minCups + 5, Math.round(refServed * 0.32));
    cups = minCups + Math.floor(Math.random() * (maxCups - minCups + 1));
  } else {
    if(d <= 10) cups = 8 + Math.floor(Math.random() * 5); // 8 - 12 ly
    else if(d <= 30) cups = 14 + Math.floor(Math.random() * 7); // 14 - 20 ly
    else if(d <= 60) cups = 20 + Math.floor(Math.random() * 9); // 20 - 28 ly
    else cups = 28 + Math.floor(Math.random() * 15); // 28 - 42 ly
  }

  const avgCupPrice = getPartyAvgCupPrice();
  const totalVal = cups * avgCupPrice;
  const deposit = Math.round((totalVal * 0.35) / 10000) * 10000;
  const payout = Math.round((totalVal * 0.65) / 10000) * 10000;
  const bonus = Math.round((totalVal * 0.25) / 10000) * 10000;

  S.partyContract = {
    id: 'pc_' + d + '_' + Date.now(),
    day: d,
    type: tInfo.type,
    icon: tInfo.icon,
    typeLabel: tInfo.typeLabel,
    title,
    client,
    cups,
    avgCupPrice,
    deposit,
    payout,
    bonus,
    accepted: false,
    rejected: false,
    served: 0,
    completed: false
  };
}

function partyContractCard(){
  const pc = S.partyContract;
  if(!pc || pc.day !== S.day || pc.rejected) return '';

  if(!pc.accepted){
    const realAvgPrice = getPartyAvgCupPrice();
    if(!pc.avgCupPrice || pc.avgCupPrice < realAvgPrice){
      pc.avgCupPrice = realAvgPrice;
      const totalVal = pc.cups * realAvgPrice;
      pc.deposit = Math.round((totalVal * 0.35) / 10000) * 10000;
      pc.payout = Math.round((totalVal * 0.65) / 10000) * 10000;
      pc.bonus = Math.round((totalVal * 0.25) / 10000) * 10000;
    }
    return `
    <div class="party-contract-card" id="partyContractCard">
      <div class="party-header">
        <span class="party-badge">${pc.icon} ${pc.typeLabel}</span>
        <span class="party-deadline">⏰ Giao trong ca hôm nay</span>
      </div>
      <div class="party-title">${pc.title}</div>
      <div class="party-client">👤 Đại diện đặt: <b>${esc(pc.client)}</b> · Số lượng: <b style="color:#ea580c;font-size:1.05rem;">${pc.cups} ly trà</b> ${pc.avgCupPrice ? `<span style="font-size:0.82rem;color:#64748b;font-weight:600;">(~${fmt(pc.avgCupPrice)}/ly)</span>` : ''}</div>
      <div class="party-finance">
        <div class="p-fin-box deposit">
          <small>Cọc nhận ngay</small>
          <b>+${fmt(pc.deposit)}</b>
        </div>
        <div class="p-fin-box payout">
          <small>Thanh toán kết ca</small>
          <b>+${fmt(pc.payout)}</b>
        </div>
        <div class="p-fin-box bonus">
          <small>Thưởng hoàn thành</small>
          <b>+${fmt(pc.bonus)}</b>
        </div>
      </div>
      <div class="party-desc">
        ✨ <i>Nhận cọc <b>${fmt(pc.deposit)}</b> ngay để chuẩn bị nguyên liệu. Trong ca, mỗi ly trà pha bán hoặc đóng gói đều tính vào đơn tiệc. Giao đủ <b>${pc.cups} ly</b> để nhận thêm <b>+${fmt(pc.payout + pc.bonus)}</b> và đánh giá 5★ VIP!</i>
      </div>
      <div class="party-actions">
        <button class="sbtn pri party-accept-btn" id="btnAcceptParty">✍️ Ký hợp đồng & Nhận cọc ngay (+${fmt(pc.deposit)})</button>
        <button class="sbtn ghost party-reject-btn" id="btnRejectParty">Bỏ qua</button>
      </div>
    </div>`;
  } else {
    return `
    <div class="party-contract-card accepted" id="partyContractCard">
      <div class="party-header">
        <span class="party-badge">${pc.icon} ${pc.typeLabel}</span>
        <span class="party-status">✅ ĐÃ KÝ HỢP ĐỒNG · ĐÃ NHẬN CỌC ${fmt(pc.deposit)}</span>
      </div>
      <div class="party-title">${pc.title}</div>
      <div class="party-client">🎯 Chỉ tiêu ca hôm nay: <b>${pc.cups} ly trà</b> · Nhận thêm khi hoàn thành: <b style="color:#16a34a;">+${fmt(pc.payout + pc.bonus)}</b></div>
      <div class="party-tip">
        📦 <i>Mẹo: Hãy nấu sẵn đủ cốt trà & topping trong kho, sau đó bấm <b>"Mở cửa quán"</b>. Trong ca làm việc bạn có thể bấm <b>[📦 Đóng ly tiệc]</b> hoặc bán hàng bình thường để hoàn thành hợp đồng!</i>
      </div>
    </div>`;
  }
}

function acceptPartyContract(){
  if(!S.partyContract || S.partyContract.accepted) return;
  sfx('coin');
  S.partyContract.accepted = true;
  S.money += S.partyContract.deposit;
  if(S.cur) S.cur.partyDeposit = S.partyContract.deposit;
  save();
  head();
  toast(`🎉 Đã ký hợp đồng! Nhận trước ${fmt(S.partyContract.deposit)} tiền cọc vào két quán!`);
  renderPrep();
}

function rejectPartyContract(){
  if(!S.partyContract) return;
  sfx('tap');
  S.partyContract.rejected = true;
  save();
  toast('Đã từ chối đơn đặt tiệc hôm nay.');
  renderPrep();
}

function getLocationWeatherPool(loc){
  // Danh sách sự kiện sinh hoạt thường ngày của quán trà (chiếm khoảng 30% tỉ lệ xuất hiện ngày thường):
  const lifeEvents = ['students', 'reviewer', 'trend', 'sale'];
  
  // Thời tiết phân bố chuẩn theo khí hậu thực tế của 10 vùng miền:
  let weathers = [];
  switch(loc){
    case 'sapa':
      // Sa Pa: Vùng cao cận ôn đới Hoàng Liên Sơn quanh năm se lạnh sương mù, tuyệt đối không có nóng bức gay gắt
      weathers = ['cold', 'cold', 'fog', 'fog', 'fog', 'rain', 'sunny'];
      break;
    case 'hcm':
      // TP. Hồ Chí Minh: Nam Bộ 2 mùa Mưa - Nắng ấm áp, không có rét buốt hay sương lạnh
      weathers = ['sunny', 'sunny', 'sunny', 'hot', 'hot', 'rain', 'rain', 'humid'];
      break;
    case 'hue':
      // Cố đô Huế: Mưa dầm xứ Huế êm đềm, sương mờ cổ kính
      weathers = ['rain', 'rain', 'rain', 'rain', 'fog', 'fog', 'cold', 'sunny'];
      break;
    case 'cantho':
      // Cần Thơ: Miền Tây sông nước nắng ấm quanh năm, mưa rào mát mẻ miệt vườn
      weathers = ['sunny', 'sunny', 'sunny', 'hot', 'hot', 'rain', 'rain'];
      break;
    case 'camau':
      // Cà Mau: Đất mũi cực Nam nắng ấm ngập tràn, mưa rừng đước
      weathers = ['sunny', 'sunny', 'rain', 'rain', 'hot', 'humid'];
      break;
    case 'danang':
      // Đà Nẵng: Duyên hải Nam Trung Bộ nắng biển trong xanh, mùa mưa bão miền Trung
      weathers = ['sunny', 'sunny', 'sunny', 'hot', 'rain', 'storm'];
      break;
    case 'buonmethuot':
      // Buôn Ma Thuột: Cao nguyên đất đỏ ban ngày nắng trong, chiều tối se lạnh
      weathers = ['sunny', 'sunny', 'cold', 'cold', 'fog', 'rain'];
      break;
    case 'halong':
      // Hạ Long: Vịnh biển du lịch hè nắng rực rỡ, bão biển, đông se lạnh ven vịnh
      weathers = ['sunny', 'sunny', 'rain', 'storm', 'cold', 'fog'];
      break;
    case 'hoangsa':
      // Hoàng Sa – Trường Sa: Biển đảo xa bờ nắng gió bao la, dông bão biển lớn
      weathers = ['sunny', 'sunny', 'sunny', 'hot', 'hot', 'storm', 'storm'];
      break;
    case 'vungtau':
      // Vũng Tàu: Thành phố biển du lịch nắng ấm quanh năm, mưa rào mát mẻ
      weathers = ['sunny', 'sunny', 'sunny', 'hot', 'hot', 'rain', 'rain'];
      break;
    case 'dalat':
      // Đà Lạt: Thành phố ngàn hoa cao nguyên sương mù se lạnh quanh năm, mưa rào chiều
      weathers = ['cold', 'cold', 'cold', 'fog', 'fog', 'fog', 'rain', 'sunny'];
      break;
    case 'phuquoc':
      // Phú Quốc: Đảo ngọc nắng vàng rực rỡ, mùa mưa dông bão biển
      weathers = ['sunny', 'sunny', 'sunny', 'hot', 'rain', 'storm'];
      break;
    case 'hanoi':
    default:
      // Hà Nội: Khí hậu miền Bắc 4 mùa phong phú
      weathers = ['hot', 'rain', 'cold', 'storm', 'sunny', 'fog', 'humid'];
      break;
  }
  return [...weathers, ...weathers, ...lifeEvents];
}

function rollDay(d){
  let e=null;
  if(d>1&&d%30===0)e={id:'holiday'};
  else if(d>1&&(d%7===6||d%7===0))e={id:'weekend'};
  else {
    const loc = (typeof S !== 'undefined' && S && S.startupLocation) ? S.startupLocation : 'hanoi';
    const pool = getLocationWeatherPool(loc);
    const id=rnd(pool);
    e={id};
    if(id==='trend'){const b=BASE_KEYS.filter(k=>S.unlocked&&S.unlocked[k]);e.k=rnd(b.length?b:BASE_KEYS)}
    if(id==='sale'){const b=[...BASE_KEYS,...TOP_KEYS,...FLAV_KEYS].filter(k=>S.unlocked&&S.unlocked[k]);e.k=rnd(b.length?b:BASE_KEYS)}
  }
  S.ev=e;S.evDay=d;
  rollPartyContract(d);
  {/* khách khó ở: đúng 2 ngày ngẫu nhiên trong mỗi 60 ngày, lặp lại */
   const blk=Math.floor((d-1)/60);if(!S.moodPlan||S.moodPlan.blk!==blk){const a=[],lo=Math.max(3,blk*60+1);while(a.length<2){const x=lo+Math.floor(Math.random()*(blk*60+61-lo));if(!a.includes(x))a.push(x)}S.moodPlan={blk,days:a}}
   S.mood=S.moodPlan.days.includes(d)?'kho':(d>2&&Math.random()<.1?'vui':null)}
  if(d>2&&Math.random()<.1){const g=GIFTS.filter(x=>!x.need||x.need());const bg=g.find(x=>x.k==='bung');const x=bg&&Math.random()<.5?bg:rnd(g);S.gift={k:x.k||null,n:x.n,d:x.d,v:Math.round((x.min+Math.random()*(x.max-x.min))/5000)*5000}}else S.gift=null;
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler') && typeof staffButlerAutoBestSellerPricing === 'function'){
    try {
      if(typeof S !== 'undefined' && S){
        S.butlerBuffedKeys = null;
        S.butlerBuffedDay = null;
      }
      staffButlerAutoBestSellerPricing();
    } catch(e){}
  }
  if(typeof window.TrendSystem !== 'undefined' && window.TrendSystem.onDayRolled){
    try { window.TrendSystem.onDayRolled(d); } catch(e){ console.error('TrendSystem onDayRolled error:', e); }
  }
}
/* vay: ngân hàng (S.loan) và vay nóng (S.hot), trả góp 10 ngày, lãi tính theo năm 360 ngày */
const LOANS=[{id:'loan',n:'Vay ngân hàng',max:()=>CFG.bankMax,rate:()=>CFG.bankRate,opts:()=>[200000,500000,CFG.bankMax]},
  {id:'hot',n:'Vay nóng',max:()=>CFG.hotMax,rate:()=>CFG.hotRate,opts:()=>[1000000,2000000,CFG.hotMax],hide:1}];
const debts=()=>LOANS.filter(L=>S[L.id]&&S[L.id].left>0);
const inDebt=()=>debts().length>0;
function loanCard(){const ds=debts(),free=LOANS.filter(L=>!L.hide&&!(S[L.id]&&S[L.id].left>0));let h='';
  if(ds.length)h+=`<div class="evc loan"><span>${ico('money')}</span><div><b>Đang nợ</b><small>${ds.map(L=>{const x=S[L.id];return `${L.n}: còn ${x.left} ngày, mỗi ngày ${fmt(x.pay+x.int)} (lãi ${fmt(x.int)})`}).join('<br>')}<br>Đang nợ thì chưa mua được nâng cấp.</small></div><button class="sbtn" id="loanPay">Trả hết</button></div>`;
  if(free.length&&S.money<CFG.loanLow)h+=`<div class="evc loan"><span>${ico('money')}</span><div><b>Két sắp cạn tiền</b><small>${free.map(L=>L.n+' tối đa '+fmtTr(L.max())+', lãi '+L.rate()+'%/năm').join(' · ')}. Trả góp 10 ngày.</small></div><button class="sbtn pri" id="loanGo">Vay</button></div>`;
  return h}
function bindLoan(){const g=$('loanGo'),p=$('loanPay');
  if(g)g.onclick=()=>{const free=LOANS.filter(L=>!L.hide&&!(S[L.id]&&S[L.id].left>0)),btn=[];
    free.forEach(L=>L.opts().forEach(v=>{const d=Math.round(v/10),it=Math.round(v*L.rate()/100/360);btn.push([`${L.n} ${fmtTr(v)} · trả ${fmt(d+it)}/ngày`,()=>{S[L.id]={left:10,pay:d,int:it,amt:v};S.money+=v;save();toast('Đã nhận '+fmt(v));head();refreshPrep()},1])}));
    ask(`<div class="pbig">${ico('money')}</div><h2>Vay ngân hàng</h2><p>Trả góp trong 10 ngày, tiền trả tự trừ vào cuối mỗi ngày. Lãi tính theo năm (1 năm trong game là 360 ngày).</p><div class="lvs">${free.map(L=>`<div><b>${L.n}:</b> tối đa ${fmtTr(L.max())}, lãi ${L.rate()}%/năm</div>`).join('')}</div>`,[['Huỷ',()=>{}],...btn])};
  if(p)p.onclick=()=>{const due=debts().reduce((a,L)=>a+S[L.id].pay*S[L.id].left,0);ask(`<h2>Trả hết nợ?</h2><p>Trả ${fmt(due)} tiền gốc còn lại, không phải trả lãi những ngày sau.</p>`,[['Huỷ',()=>{}],['Trả hết',()=>{if(S.money<due){toast('Két không đủ tiền');return}S.money-=due;S.cur.loanOut=(S.cur.loanOut||0)+due;LOANS.forEach(L=>S[L.id]=null);save();toast('Đã trả hết nợ');head();refreshPrep()},1]])}}
const ecost=k=>{
  let c=CFG.cost[k]*(evIs('sale')&&ev().k===k?.7:1);
  if((k==='sugar'||k==='ice')&&S&&S.garden&&S.garden.lemonBuffDays>0)c*=(S.garden.lemonBuffBoost?0.7:0.8);
  if(typeof S !== 'undefined' && S){
    const bMul = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
    const dMul = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
    if(S.startupLocation === 'sapa'){
      c *= (1 + 0.15 * dMul); // Sa Pa: Chi phí vận chuyển đèo dốc +15% giá vốn
    } else if(S.startupLocation === 'cantho'){
      if(ITEMS[k] && (ITEMS[k].g === 'thach' || ITEMS[k].g === 'pm' || ITEMS[k].type === 'top')){
        c *= Math.max(0.25, 1 - 0.25 * bMul); // Cần Thơ: Topping / Thạch / Phô mai -25% chi phí nguyên liệu
      }
    } else if(S.startupLocation === 'buonmethuot'){
      if(ITEMS[k] && (ITEMS[k].type === 'base' || k === 'sua' || k === 'kem' || k === 'pm')){
        c *= Math.max(0.30, 1 - 0.15 * bMul); // Buôn Ma Thuột: Nguồn nguyên liệu tận gốc -15% giá vốn cốt trà & sữa
      }
    } else if(S.startupLocation === 'hoangsa'){
      c *= (1 + 0.20 * dMul); // Hoàng Sa – Trường Sa: Nguồn hàng hạn chế: +20% giá vốn nguyên liệu
    } else if(S.startupLocation === 'phuquoc'){
      c *= (1 + 0.15 * dMul); // Phú Quốc: Giá vốn nguyên liệu +15%
    } else if(S.startupLocation === 'dalat'){
      if(k === 'olong' || k === 'hong' || (ITEMS[k] && ITEMS[k].type === 'base')){
        c *= (1 + 0.10 * dMul); // Đà Lạt: Nguyên liệu đặc sản +10% giá vốn
      }
    }
  }
  return Math.round(c);
};
function evCard(){const e=ev();
  let h = !e ? '' : `<div class="evc"><span>${ico(EVS[e.id].ic)}</span><div><b>Hôm nay: ${EVS[e.id].n}</b><small>${evText(e)}</small></div></div>`;
  if(isGuardResting()){
    h += `<div class="evc" style="background:#fff7ed;border-color:#f97316;"><span>👮‍♂️</span><div><b style="color:#c2410c;">Chú bảo vệ nghỉ ngủ lấy sức (1 ngày bán hàng)</b><small style="color:#9a3412;">Nghỉ ${getGuardRestRemainTxt()}. Hôm nay vắng chú bảo vệ, nguy cơ tiền giả, trộm cắp, bùng tiền tăng cao!</small></div></div>`;
  }
  return h;
}
/* sự cố mất tiền: gian lận thì mất gần hết; người chơi thật 0–2 lần trong 90 ngày, mất dưới 1 triệu */
const BAD=[
  {id:'trom',n:'Trộm ghé quán!',ic:'sad',all:'Đêm qua trộm cạy két, lấy sạch tiền.',some:'Đêm qua trộm cạy két, lấy mất %.'},
  {id:'thue',n:'Rắc rối về thuế',ic:'receipt',all:'Cơ quan thuế phát hiện doanh thu không khớp sổ sách. Chủ quán trốn thuế, tài sản bị tịch thu.',some:'Nộp thuế chậm, quán bị phạt %.'},
  {id:'qltt',n:'Quản lý thị trường kiểm tra',ic:'warn',all:'Tiền mặt trong két quá lớn mà không chứng minh được nguồn gốc, bị tạm giữ toàn bộ.',some:'Đoàn kiểm tra thị trường nhắc nhở niêm yết giá quầy pha, quán bị phạt %.'},
  {id:'lua',n:'Bị lừa qua điện thoại',ic:'phone',all:'Kẻ gian giả danh ngân hàng gọi tới, chủ quán lỡ chuyển hết tiền trong két.',some:'Kẻ gian giả danh ngân hàng gọi tới, chủ quán lỡ chuyển %.'},
  {id:'coin',n:'"Đầu tư" tiền ảo',ic:'chartdown',all:'Chủ quán dồn hết tiền vào một sàn tiền ảo lạ. Sàn sập, mất trắng.',some:'Chủ quán thử "đầu tư" tiền ảo trên một sàn lạ, lỗ %.'}];
function mkBadPlan(start){const r=Math.random(),n=r<.3?0:r<.7?1:2,ids=BAD.map(b=>b.id).sort(()=>Math.random()-.5),days=[];
  while(days.length<n){const d=start+10+Math.floor(Math.random()*80);if(!days.includes(d))days.push(d)}
  days.sort((a,b)=>a-b);return {start,ev:days.map((d,i)=>({d,id:ids[i],done:false}))}}
/* két gian lận: chỉ kích hoạt khi tiền két vượt trần an ninh động theo ngày */
function cheatHit(isSevere = false){
  // TUYỆT ĐỐI KHÔNG cạy két hoặc trừ tiền nếu số tiền mặt thực tế < trần két an toàn động
  const actualMoney = Number(S && S.money) || 0;
  const safeCap = getSafeCashCeiling(S && S.day);
  if(actualMoney < safeCap) {
    if(S && S.badNow && (S.badNow.id === 'trom' || S.badNow.all)) S.badNow = null;
    return;
  }
  const keep = (CFG.thiefLeft != null && CFG.thiefLeft > 0) ? CFG.thiefLeft : (1 + Math.floor(Math.random() * 9)) * 100000;
  let lost = Math.max(0, S.money - keep);
  const equipRed = isSevere ? 0 : Math.min(0.9, ((S.upgLv && S.upgLv.equip) || 0) * 0.01);
  if(equipRed > 0) lost = Math.round(lost * (1 - equipRed));
  S.money = Math.max(keep, S.money - lost);
  S.cur.stolen = (S.cur.stolen || 0) + lost;
  const hasGuard = isStaffActive('staffGuard');
  const guardNotice = hasGuard ? ' (Chú bảo vệ chỉ bảo vệ trong ca bán hàng; tiền két vượt mức quy định nên ban đêm vẫn bị cạy két!)' : '';
  S.badNow = {
    id: 'trom',
    all: 1,
    v: lost,
    keep: S.money,
    n: '🚨 Két tiền vượt mức quy định bị trộm!',
    msg: `Két tiền mặt vượt quá mức quy định (${fmt(safeCap)}) nên đã bị kẻ gian đột nhập cạy két khoắng sạch${guardNotice}! Két bị mất <b>${fmt(lost)}</b>.`
  };
  save();
}

function badCheck(){
  // BẢO VỆ TÀI CHÍNH & TỰ ĐỘNG HOÀN TIỀN CẠY KÉT ẢO:
  // Nếu phát hiện sự cố cạy két / trộm tiền mặt (id: 'trom' hoặc all: 1) khi số tiền trong két dưới trần két an toàn động theo ngày,
  // lập tức hủy bỏ và hoàn trả toàn bộ số tiền bị trừ nhầm về lại két quán cho người chơi!
  const safeCapNow = getSafeCashCeiling(S && S.day);
  if(S.badNow && (S.badNow.id === 'trom' || S.badNow.all)){
    const actualMoney = Number(S.money) || 0;
    const stolenVal = Number(S.badNow.v) || 0;
    if(actualMoney < safeCapNow){
      if(stolenVal > 0){
        S.money = actualMoney + stolenVal;
        if(S.cur && S.cur.stolen) S.cur.stolen = Math.max(0, S.cur.stolen - stolenVal);
        try { toast(`🛡️ [Bảo Vệ Két] Đã thu hồi và hoàn trả ${fmt(stolenVal)} tiền két bị trừ nhầm! Két hiện có ${fmt(S.money)}.`, 6000, 1); } catch(_) {}
      }
      S.badNow = null;
      save();
    }
  }
  if(!S.badNow&&S.badPlan){const e=S.badPlan.ev.find(x=>!x.done&&x.d<=S.day);
    if(e){
      const guardInterception = isStaffActive('staffGuard') && Math.random() < (typeof getGuardBlockRate === 'function' ? getGuardBlockRate() : 0.90);
      if((e.id==='trom'||e.id==='lua'||e.id==='coin') && guardInterception){
        e.done=true;
        save();
        toast(`🛡️ Chú bảo vệ đã kịp thời phát hiện và chặn đứng sự cố gian lận/lừa đảo (Tỉ lệ ${typeof getGuardBlockPctTxt === 'function' ? getGuardBlockPctTxt() : '90%'})! Không bị mất tiền! 🎉`, 5000);
      } else {
        e.done=true;
        if(S.day-e.d<=1){
          const equipRed = Math.min(0.60, ((S.upgLv && S.upgLv.equip) || 0) * 0.01);
          let v=Math.min(Math.round((200000+Math.random()*700000)/50000)*50000,Math.floor(S.money/3/1000)*1000);
          if(equipRed>0)v=Math.round(v*(1-equipRed));
          if(v>=10000){
            S.money-=v;
            // Tách tổn thất két ra khỏi P&L: chỉ trừ S.money, không cộng dồn vào r.bad
            const guardMissed = isStaffActive('staffGuard');
            S.badNow={id:e.id,v,msg:guardMissed?`⚠️ Kẻ gian quá tinh vi đã lọt qua mắt Chú bảo vệ (10% rủi ro)! Két quán bị mất %!` : undefined};
            try { toast(`🚨 Sự cố két: Mất ${fmt(v)} tiền mặt!`, 5000); } catch(_) {}
          }
        }
        save();
      }
    }
  }
  // Nguy cơ trộm cắp ban đêm & Phán Quyết Chống Hack theo 4 tầng Ngưỡng Phán Quyết (WARN=1, FLAG=2, SHADOWBAN=3, BAN=4) & Vượt Két
  const actualMoney = Number(S && S.money) || 0;
  const tiers = getSafeCashTiers(S && S.day);
  const verdictNight = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(actualMoney, true) : { isCheater: false, tier: 0, status: 'CLEAN' };
  if((actualMoney >= tiers.lowCap || verdictNight.isCheater) && !S.badNow && S._lastBillionNightCrimeDay !== S.day){
    S._lastBillionNightCrimeDay = S.day;
    const isCheaterHoard = !!(verdictNight.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(actualMoney)));
    const vTier = isCheaterHoard ? Math.max(1, verdictNight.tier || 0) : 0;
    const isMegaHoard = actualMoney >= tiers.megaCap || vTier >= 4;
    const isHighHoard = actualMoney >= tiers.highCap || vTier >= 3;
    const isMidHoard = actualMoney >= tiers.midCap || vTier >= 2;
    const hasGuard = isStaffActive('staffGuard');
    const hasDogGuard = !!(S && S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50);
    const baseNightRate = isCheaterHoard
      ? (isMegaHoard ? 0.95 : (isHighHoard ? 0.85 : (isMidHoard ? 0.55 : 0.35)))
      : (isMegaHoard ? 0.35 : (isHighHoard ? 0.25 : (isMidHoard ? 0.15 : 0.10)));
    const guardMul = (hasGuard && !isGuardResting()) ? 0.40 : (isGuardResting() ? 1.15 : 1.0);
    const dogMul = hasDogGuard ? 0.60 : 1.0;
    const legitCrimeRate = Math.min(0.85, baseNightRate * guardMul * dogMul);
    const crimeRate = (isCheaterHoard && (isMegaHoard || isHighHoard)) ? 1.0 : legitCrimeRate;
    if(Math.random() < crimeRate){
      const guardNote = hasGuard
        ? (isCheaterHoard ? ` (Hệ thống phát hiện dấu hiệu bất thường [${verdictNight.status || 'CHEAT'}] nên bảo vệ không thể can thiệp!)` : ' (Két tiền mặt vượt ngưỡng an toàn ban đêm nên kẻ gian vẫn lọt qua một phần cảnh giới!)')
        : '';
      const totalLiquidPool = actualMoney + (isCheaterHoard && S && S.bank ? Math.max(0, Number(S.bank.balance) || 0) : 0);
      const displayPoolAmt = isCheaterHoard ? Math.max(actualMoney, totalLiquidPool) : actualMoney;
      const crimeTypes = [
        { id: 'trom', n: (isCheaterHoard && isMegaHoard) ? '🚨 PHÁN QUYẾT AN NINH & SIÊU TRỘM KHOẮNG SẠCH KÉT!' : `🚨 Trộm đột nhập phá két đêm (Két trên ${fmt(tiers.lowCap)})!`, ic: 'sad', msg: `Đêm qua kẻ gian đã dùng thiết bị nhiệt cắt két sắt vì phát hiện quán nắm giữ <b>${fmt(displayPoolAmt)}</b> tài sản/tiền mặt bất thường${guardNote}! Bị khoắng mất %, hãy gửi tiền hợp lệ vào Tà Tưa Bank ngay!` },
        { id: 'lua', n: '🚨 CẢNH BÁO AN NINH & KIỂM TOÁN TÀI CHÍNH!', ic: 'phone', msg: `Phát hiện dòng tiền/chỉ số vượt ngưỡng an toàn tài chính (<b>${fmt(displayPoolAmt)}</b>) khiến quán bị tội phạm công nghệ cao & thanh tra nhắm tới${guardNote}, thiệt hại mất %!` },
        { id: 'lua_ket', n: '🚨 BĂNG ĐẢNG ĐỘT KÍCH KÉT TIỀN TỶ TRONG ĐÊM!', ic: 'sad', msg: `Băng nhóm tội phạm có tổ chức đột kích vào quầy thu ngân (${fmt(displayPoolAmt)})${guardNote}, gây thiệt hại %!` },
        { id: 'hacker', n: '🚨 HACKER TẤN CÔNG KÉT ĐIỆN TỬ BAN ĐÊM!', ic: 'phone', msg: `Nhóm Hacker phát hiện lỗ hổng dữ liệu & két thu ngân (${fmt(displayPoolAmt)})${guardNote}, tấn công hệ thống và rút ruột mất %!` }
      ];
      const crime = rnd(crimeTypes);
      // Người chơi hợp lệ được hưởng giảm thiệt hại từ nâng cấp thiết bị và có trần tổn thất tối đa thống nhất với luồng cuối ca
      const equipRed = (isCheaterHoard && (isMegaHoard || isHighHoard)) ? 0 : Math.min(0.35, ((S.upgLv && S.upgLv.equip) || 0) * 0.005);
      const pctLoss = isCheaterHoard
        ? (isMegaHoard ? (0.80 + Math.random() * 0.12) : (isHighHoard ? (0.65 + Math.random() * 0.15) : (0.25 + Math.random() * 0.20)))
        : (isMegaHoard ? (0.04 + Math.random() * 0.04) : (isHighHoard ? (0.025 + Math.random() * 0.025) : (isMidHoard ? (0.015 + Math.random() * 0.015) : (0.01 + Math.random() * 0.01))));
      const maxLegitNightCap = isMegaHoard ? 1500000000 : (isHighHoard ? 600000000 : (isMidHoard ? 250000000 : 80000000));
      const basePoolForLoss = isCheaterHoard ? totalLiquidPool : Math.max(0, Number(S.money) || 0);
      let lostAmt = Math.round((basePoolForLoss * pctLoss) / 100000) * 100000;
      if(equipRed > 0) lostAmt = Math.round(lostAmt * (1 - equipRed));
      if(!isCheaterHoard) lostAmt = Math.min(lostAmt, maxLegitNightCap);
      lostAmt = isCheaterHoard
        ? Math.min(lostAmt, Math.max(0, totalLiquidPool))
        : Math.max(5000000, Math.min(lostAmt, Math.max(0, S.money - 500000000)));
      // Chỉ tịch thu kho nguyên liệu/trà/topping số lượng lớn khi có căn cứ gian lận (isCheaterHoard)
      const stockLostArr = (isCheaterHoard && typeof raidHoardStock === 'function')
        ? raidHoardStock(isMegaHoard ? 0.75 : (isHighHoard ? 0.55 : 0.25), isMegaHoard ? 0.90 : (isHighHoard ? 0.75 : 0.45))
        : [];
      const totalStockLostQty = stockLostArr.reduce((s, x) => s + (x.q || 0), 0);
      const totalStockLostVal = stockLostArr.reduce((s, x) => s + (x.v || 0), 0);
      const stockLostNote = totalStockLostQty > 0
        ? `<br><span style="color:#dc2626;font-weight:800;">📦 Kho hàng bị hôi của / tịch thu mất <b>${totalStockLostQty.toLocaleString('vi-VN')} phần</b> cốt trà, hương vị, topping & nguyên liệu (trị giá ~<b>${fmt(totalStockLostVal)}</b>)!</span>`
        : '';
      if(lostAmt >= 5000000 || totalStockLostQty > 0){
        if(lostAmt >= 5000000){
          const deductCash = Math.min(Math.max(0, Number(S.money) || 0), lostAmt);
          S.money = Math.max(0, (Number(S.money) || 0) - deductCash);
          const remBankLoss = lostAmt - deductCash;
          if(isCheaterHoard && remBankLoss > 0 && S.bank && (Number(S.bank.balance) || 0) > 0){
            S.bank.balance = Math.max(0, (Number(S.bank.balance) || 0) - remBankLoss);
            S.bank.principal = Math.max(0, Math.min(Number(S.bank.principal) || 0, S.bank.balance));
          }
        }
        S.badNow = { id: crime.id, n: crime.n, ic: crime.ic, msg: crime.msg.replace('%', '<b>' + fmt(lostAmt) + '</b>') + stockLostNote, v: lostAmt };
        save();
        try { toast(`🚨 Bị khoắng/thu hồi mất ${fmt(lostAmt)}${totalStockLostQty > 0 ? ` & mất ${totalStockLostQty} phần trà/topping` : ''}!`, 6000, 1); } catch(_) {}
      }
    }
  }

  const b=S.badNow;if(!b)return false;S.badNow=null;save();sfx('bad');const t=BAD.find(x=>b.id===x.id)||BAD[0];
  const title = b.n || t.n;
  const icon = b.ic || t.ic;
  const body = b.msg || (b.all?t.all:t.some.replace('%','<b>'+fmt(b.v)+'</b>'));
  ask(`<div class="pbig">${ico(icon)}</div><h2>${title}</h2><p>${body}</p>${b.all?`<p class="warnline">Trong két chỉ còn ${fmt(b.keep)}.</p>`:''}`,[['Buồn ghê',()=>{head();if(R.mode==='prep')refreshPrep()},1]]);return true}

/* chờ hết màn hình chào và hộp thoại khác rồi mới báo trộm / quà */

/* ===== CẢNH BÁO AN NINH: KÉT VƯỢT TRẦN AN TOÀN ĐỘNG THEO NGÀY ===== */
function check1BillionRisk(){
  const m = Number(S && S.money) || 0;
  const safeCap = getSafeCashCeiling(S && S.day);
  if(!S || m < safeCap) return false;
  if(S._last1BWarnDay === S.day) return false;
  S._last1BWarnDay = S.day;
  save();

  ask(`
    <div class="pbig">🚨🏦</div>
    <h2 style="color:#dc2626;margin:4px 0 8px;">CẢNH BÁO: KÉT TIỀN VƯỢT TRẦN AN TOÀN (${fmt(safeCap).toUpperCase()})!</h2>
    <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:14px;padding:12px 14px;text-align:left;font-size:0.88rem;line-height:1.6;color:#991b1b;margin-bottom:12px;">
      <p style="margin:0 0 8px 0;font-weight:700;color:#b91c1c;">
        ⚠️ <b>Nguy Cơ An Ninh Cực Cao:</b> Két tiền mặt hiện có <b style="font-size:1.02rem;">${fmt(S.money)}</b> (vượt trần an toàn Ngày ${S.day} là <b>${fmt(safeCap)}</b>)! Tích trữ quá nhiều tiền mặt đang kích hoạt <b>nguy cơ trộm cắp cạy két đêm, lừa đảo viễn thông rút ruột két, khách tuồn tiền giả và trộm giật móc két tại quầy</b>!
      </p>
      <p style="margin:0 0 10px 0;color:#1e293b;">
        👉 <b>Biện Pháp Phòng Ngừa:</b> Hãy khẩn trương <b>gửi tiền vào Tà Tưa Bank</b> để được bảo vệ an toàn tuyệt đối 100%, sinh lãi kép mỗi ngày! <i>Lưu ý: Trần két an toàn tự động tăng thêm +10 Triệu mỗi ngày chơi (tối đa 20 Tỷ). Khi tiền két vượt mức ${fmt(safeCap)} thì ban đêm vẫn có nguy cơ bị trộm cắp cạy két!</i>
      </p>
      <div style="background:#eff6ff;border:1px dashed #93c5fd;border-radius:10px;padding:10px 12px;color:#1e40af;font-size:0.82rem;font-weight:600;line-height:1.5;">
        ⭐ <b>Cách Tăng Hạn Mức Gửi Tiền:</b> Để gửi được nhiều tiền vào ngân hàng, tiệm cần <b>đạt 5.0★ TỔNG ĐÁNH GIÁ</b>! Mỗi lần tiệm chạm mốc 5 sao xuất sắc, Tà Tưa Bank sẽ tự động tăng thêm hạn mức gửi tiền (+10% / +5%).
      </div>
    </div>
  `, [
    ['🏦 Gửi tiền vào Bank ngay', () => {
      openBankDepositDlg();
    }, 1],
    ['⭐ Xem đánh giá quán', () => {
      switchTab('danhgia');
    }],
    ['Đã hiểu & Cảnh giác', () => {}]
  ]);
  return true;
}

/* ===== HỆ THỐNG NHÂN SỰ: ĐÃ XOÁ BỎ HOÀN TOÀN DRAMA ===== */
function getActiveStaffList(){
  if(!S || !S.upg) return [];
  return STAFF.filter(u => S.upg[u.id]);
}

function staffDramaCheck(){
  if(!S || !S.upg || S._lastHoardStaffQuitDay === S.day) return false;
  const hoardCash = Math.max(Number(S.money) || 0, Number(S._lastPeakHoardCash) || 0);
  const tiers = getSafeCashTiers(S.day);
  const verdictDrama = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(hoardCash, true) : { isCheater: false, tier: 0, status: 'CLEAN' };
  const isCheaterDrama = !!(verdictDrama.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(hoardCash)));
  if(!isCheaterDrama) return false;
  const dTier = Math.max(verdictDrama.tier || 0, hoardCash >= tiers.megaCap ? 4 : (hoardCash >= tiers.highCap ? 3 : (hoardCash >= tiers.midCap ? 2 : (hoardCash >= tiers.lowCap ? 1 : 0))));
  if(dTier < 2) return false;
  S._lastHoardStaffQuitDay = S.day;

  const isMega = dTier >= 4;
  const isHigh = dTier >= 3;
  const isMid = dTier >= 2;
  const quitProb = isMega ? 0.75 : (isHigh ? 0.45 : (isMid ? 0.20 : 0.08));

  const quitNames = [];
  if(typeof STAFF !== 'undefined' && Array.isArray(STAFF)){
    STAFF.forEach(u => {
      if(!u || !u.id) return;
      const isHired = (u.id === 'staff0') ? !!(S.upg && S.upg.staff0) : !!((S.hired && S.hired[u.id]) || (S.upg && S.upg[u.id]));
      if(isHired && Math.random() < quitProb){
        if(S.upg) S.upg[u.id] = false;
        if(S.hired) S.hired[u.id] = false;
        if(S.staffKpi) S.staffKpi[u.id] = { speedBuff: 0, billBonus: 0, level: 0 };
        if(S.staffTraining) S.staffTraining[u.id] = 0;
        if(S.staffTotalDaysWorked) S.staffTotalDaysWorked[u.id] = 0;
        quitNames.push(typeof staffFullName === 'function' ? staffFullName(u) : (u.n || u.id));
        if(S.staffNames) delete S.staffNames[u.id];
        if(S.staffAvatars) delete S.staffAvatars[u.id];
      }
    });
  }

  if(quitNames.length > 0){
    save();
    sfx('bad');
    const reasonLabel = hoardCash >= tiers.midCap
      ? `két tích trữ lượng tiền mặt bất thường <b>${fmt(hoardCash)}</b> vượt xa doanh thu thực tế`
      : `hệ thống phát hiện chỉ số bất thường (Ngưỡng Phán Quyết <b>${verdictDrama.status || 'FLAG'} — ${verdictDrama.score || 30}đ</b>)`;
    ask(`
      <div class="pbig">💔🏃‍♂️💨</div>
      <h2 style="color:#dc2626;margin:4px 0 8px;">NHÂN VIÊN ĐỒNG LOẠT NỘN ĐƠN NGHỈ VIỆC!</h2>
      <div style="background:#fef2f2;border:1.5px solid #fecaca;padding:12px 14px;border-radius:10px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        <div style="color:#b91c1c;font-weight:700;margin-bottom:6px;">
          🚨 Phát hiện ${reasonLabel}, băng đảng tội phạm &amp; thanh tra liên tục rình rập khiến nhân viên hoảng sợ cực độ và quyết định <b>nghỉ việc ngay lập tức</b>:
        </div>
        <div style="margin:8px 0 6px;display:flex;flex-direction:column;gap:5px;">
          ${quitNames.map(n => `<div style="font-weight:700;color:#991b1b;background:#fff;padding:6px 10px;border-radius:6px;border:1px solid #fee2e2;">• 💔 ${esc(n)} (Đã nghỉ việc &amp; rời quán)</div>`).join('')}
        </div>
        <div style="color:#475569;font-size:0.82rem;margin-top:6px;">👉 Hãy gửi tiền mặt vào <b>Tà Tưa Bank</b> để ổn định an ninh và vào mục <b>Nâng cấp &gt; Nhân sự</b> để tuyển dụng lại nhân viên!</div>
      </div>
    `, [['Đã hiểu', () => { head(); if(R.mode === 'prep') refreshPrep(); }, 1]]);
    return true;
  }
  return false;
}

function prepChecks(){
  if(R.mode!=='prep'||!$('splash').hidden)return;
  if(!$('modal').hidden){clearTimeout(R.pcT);R.pcT=setTimeout(prepChecks,500);return}
  if(storeCheck())return;
  if(badCheck())return;
  if(check1BillionRisk())return;
  if(S.gift){giftCheck();return}
  if(staffDramaCheck())return;
  const isPrepCheat = typeof getInGameCheatVerdict === 'function' && getInGameCheatVerdict().isCheater;
  if(((Number(S && S.money) || 0) >= getSafeCashCeiling(S && S.day) || isPrepCheat) && S.lastBreakDay !== S.day && typeof checkEquipBreakdown === 'function'){
    checkEquipBreakdown(() => setTimeout(prepChecks, 350));
    return;
  }
  bakRemind();
}
function storeCheck(){
  if(R.loadErr){R.loadErr=false;ask(`<div class="pbig">${ico('warn')}</div><h2>Không đọc được tiến trình cũ</h2><p>Bản lưu trong máy bị lỗi nên game mở quán mới. Bản cũ vẫn được giữ lại, không bị xoá.</p><p>Vào <b>Cài đặt > Khôi phục bản tự lưu</b> để lấy lại, hoặc dán mã sao lưu nếu có.</p>`,[['Để sau',()=>{}],['Khôi phục ngay',autoRestoreDlg,1]]);return true}
  let hasSavedData = false;
  try{ hasSavedData = !!(typeof localStorage !== 'undefined' && localStorage.getItem(SAVE)); }catch(e){}
  if(!hasSavedData && (R.noStore||!storeOk()) && !R.noStoreWarned){
    R.noStore=true;R.noStoreWarned=true;
    ask(`<div class="pbig">${ico('warn')}</div><h2>Máy đang chặn lưu tiến trình</h2><p>Game chạy bình thường nhưng <b>tắt app là mất hết tiến trình</b>, mở lại sẽ về ngày 1.</p>
      <div class="lvs"><div><b>iPhone:</b> Cài đặt > Safari > tắt <b>Chặn tất cả cookie</b>. Không mở game bằng tab ẩn danh.</div><div>Kiểm tra thêm: Thời gian sử dụng > Giới hạn nội dung & quyền riêng tư, và bộ nhớ máy còn trống.</div><div>Trong lúc chưa sửa được, hãy <b>tạo mã sao lưu</b> trước khi tắt app để giữ tiến trình.</div></div>`,[['Đã hiểu',()=>{}],['Tạo mã sao lưu',backupDlg,1]]);return true}
  return false}
function bakRemind(){if(R.noStore||S.day<8||S.day-(S.bakDay||0)<7||S.day-(S.bakAsk||0)<7)return;S.bakAsk=S.day;save();
  ask(`<div class="pbig">${ico('box')}</div><h2>Sao lưu tiến trình nhé?</h2><p>Tạo mã sao lưu để giữ quán khi đổi máy, xoá app hay máy tự dọn dữ liệu. Chỉ mất vài giây.</p>`,[['Để sau',()=>{}],['Tạo mã',backupDlg,1]])}
function autoRestoreDlg(){
  $('card').onchange=null;
  const list=[
    ['tsBak1','Cuối ngày gần nhất'],
    ['tsBak2','Một ngày trước đó'],
    ['tsBak3','Hai ngày trước đó'],
    [SAVE+'_rescue','Bản cứu hộ (trước khi bị lỗi)'],
    [SAVE+'_before_restore','Bản trước lần khôi phục gần nhất'],
    [SAVE+'_persist','Bản lưu bền vững']
  ].map(([k,n])=>{
    try{
      const r=localStorage.getItem(k);
      if(!r)return null;
      const d=JSON.parse(r);
      return (d && (d.stock || d.day || d.money != null)) ? {k,n,d} : null;
    }catch(e){return null}
  }).filter(Boolean);
  if(!list.length){
    ask(`<h2>Chưa có bản tự lưu</h2><p>Game tự lưu mỗi cuối ngày. Nếu có mã sao lưu hoặc file sao lưu, hãy dùng Khôi phục từ mã.</p>`,[['Đóng',showSettings],['Khôi phục từ mã / file',()=>restoreDlg(),1]]);
    return;
  }
  ask(`<h2>Khôi phục bản tự lưu</h2><p>Chọn bản muốn lấy lại. Tiến trình hiện tại sẽ được lưu vào bộ nhớ dự phòng trước khi thay thế.</p>`,[['Huỷ',showSettings],...list.map(x=>[`${x.n}: ${esc(x.d.shopName||'Tiệm Trà Mơ Ước')} · Ngày ${x.d.day} · ${fmt(x.d.money||0)}`,()=>applyRestore(x.d),1])]);
}
function stopShift(clearData = true){
  if(typeof timer !== 'undefined' && timer){
    clearInterval(timer);
    timer = null;
  }
  if(typeof R !== 'undefined' && R){
    if(R._fakeIntervalTimer){
      clearInterval(R._fakeIntervalTimer);
      R._fakeIntervalTimer = null;
    }
    if(R._gzCatchTimer){
      clearTimeout(R._gzCatchTimer);
      R._gzCatchTimer = null;
    }
    R.running = false;
    R.paused = false;
    R._pausedBySettings = false;
    R.mode = 'prep';
    R.closing = false;
    R.pour = false;
    R.sealing = false;
    R.rushHourActive = false;
    R.todayCrushBuffRate = 0;
    R.combo = 0;
    if(clearData){
      R.slots = [];
      R.online = [];
      R.gzWork = null;
      R.svWork = null;
      R.buyerTrip = null;
      R.st2 = null;
      R.st2Workers = [];
      R.sto = null;
      R.stoWorkers = [];
      R.helping = false;
      R.fakeCase = null;
      R.party = null;
    }
  }
  try {
    document.body.classList.remove('selling');
    if(typeof pourSnd === 'function') pourSnd(false);
    if(typeof clearStaffPouring === 'function') clearStaffPouring();
    if(typeof hideAllPoliceButtons === 'function') hideAllPoliceButtons();
    if(typeof stopCounterPet === 'function') stopCounterPet();
  } catch(e){}
}
function applyRestore(d){
  if(!d || typeof d !== 'object'){
    toast('Dữ liệu khôi phục không hợp lệ');
    return;
  }
  stopShift(true);
  try {
    const curRaw = localStorage.getItem(SAVE);
    if(curRaw) localStorage.setItem(SAVE + '_before_restore', curRaw);
  } catch(e){}
  try{
    const jsonStr = JSON.stringify(d);
    localStorage.setItem(SAVE, jsonStr);
    localStorage.setItem('tsBak1', jsonStr);
  }catch(e){
    console.warn('Lỗi ghi localStorage khi restore:', e);
  }
  try{
    loadFrom(d);
  }catch(e){
    console.error('Lỗi khi loadFrom:', e);
    toast('Bản sao lưu có cấu trúc lỗi, đã nạp an toàn: ' + (e && e.message || ''));
  }
  try { save(); } catch(e){}
  const m = typeof $ === 'function' ? $('modal') : document.getElementById('modal');
  if(m) m.hidden = true;
  if(typeof closeSplash === 'function') closeSplash();
  R.mode = 'prep';
  R.plan = {};
  R.tab = 'kho';
  try { document.title = shopName(); } catch(e){}
  try { renderPrep(); } catch(e){ console.error('Lỗi renderPrep:', e); }
  toast(`🎉 Đã khôi phục thành công quán "${shopName()}" - Ngày ${S.day}! Số dư: ${fmt(S.money)}`, 5000, 1);
}
function giftCheck(){if(!S.gift)return;sfx('lvup');const g=S.gift;S.gift=null;if(g.k==='bung')S.bungN=0;S.money+=g.v;S.cur.gift=(S.cur.gift||0)+g.v;save();
  ask(`<div class="pbig">${ico('gift')}</div><h2>${g.n}</h2><p>${g.d}</p><p class="lvup">+${fmt(g.v)} vào két</p>`,[['Tuyệt quá',()=>{head();refreshPrep()},1]])}
function getStaffTrafficBuffTotal(){
  if(!S || !S.staffKpi) return 0;
  return STAFF.reduce((acc, u) => {
    if(S.hired && S.hired[u.id] && S.upg && S.upg[u.id]){
      return acc + ((S.staffKpi[u.id] && S.staffKpi[u.id].trafficBuff) || 0);
    }
    return acc;
  }, 0);
}
/* ===== HỆ THỐNG ĐÓNG THUẾ TRỰC TUYẾN 72H (3 NGÀY THỰC) ===== */
const TAX_CYCLE_MS = 72 * 3600 * 1000; // 72h (3 ngày thực tế)
function initTaxState(){
  if(!S) return;
  if(!S.tax){
    S.tax = {
      paidAt: 0,
      expiresAt: Date.now() + TAX_CYCLE_MS, // 72h (3 ngày thực tế) ân hạn ban đầu
      rate: 0,
      amount: 0,
      totalPaid: 0,
      payCount: 0
    };
  } else {
    // Sửa lỗi nộp thuế cộng dồn vượt 72h: giới hạn trần tối đa không quá 72h từ hiện tại
    if(S.tax.expiresAt && S.tax.expiresAt > Date.now() + TAX_CYCLE_MS){
      S.tax.expiresAt = Date.now() + TAX_CYCLE_MS;
    }
  }
}
function isTaxActive(){
  if(!S) return false;
  initTaxState();
  return S.tax.expiresAt && Date.now() < S.tax.expiresAt && S.tax.rate > 0;
}
window.isTaxActive = isTaxActive;
function isTaxOverdue(){
  if(!S) return false;
  // Khi đã thuê nhân viên Me Két Tinh: không bị tính quá hạn đóng thuế 72h
  if(S.upg && S.upg.staffMkt) return false;
  initTaxState();
  if(!S.tax.expiresAt) return false;
  return Date.now() >= S.tax.expiresAt;
}
window.isTaxOverdue = isTaxOverdue;
function getTaxTrafficBoost(){
  if(isTaxActive()) return 1 + (S.tax.rate || 0.15);
  if(isTaxOverdue()) return 0.80; // Giảm 20% lượng khách khi nợ thuế
  return 1.0;
}
function getTaxSpeedBuff(){
  if(isTaxActive()) return (S.tax.rate || 0.15);
  if(isTaxOverdue()) return -0.20; // Nhân viên bất mãn giảm 20% tốc độ
  return 0;
}
function formatTaxTime(ms){
  if(ms <= 0) return '00:00:00';
  const totSec = Math.floor(ms / 1000);
  const h = Math.floor(totSec / 3600);
  const m = Math.floor((totSec % 3600) / 60);
  const s = totSec % 60;
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
}

/* ===== HỆ THỐNG TÀ TƯA BANK (PRIVATE BANKING LATE-GAME, TỐI ĐA 1.000 TỶ) ===== */
const BANK_MAX_CAP = 1000000000000; // Giới hạn tối đa của Tà Tưa Bank là 1.000 tỉ VNĐ (1 Nghìn Tỉ)

function getBankTierInfo(star5Count){
  const stars = Math.max(0, star5Count || (typeof S !== 'undefined' && S && S.star5Count) || 0);
  const hasRealEstate = typeof S !== 'undefined' && S && S.realEstate && (S.realEstate.main || Object.values(S.realEstate.branches || {}).some(Boolean));
  if(stars >= 1500 || (stars >= 1000 && hasRealEstate)){
    return { id: 'black', name: 'Thẻ Đen Vô Cực (Black Card VIP)', icon: '🖤', maxCap: 1000000000000, color: '#09090b', badgeColor: '#f59e0b', desc: 'Trần 1.000 Tỉ VNĐ (1 Nghìn Tỉ) · Bảo chứng thấu chi tín dụng' };
  }
  if(stars >= 1000){
    return { id: 'diamond', name: 'Thẻ Kim Cương (Diamond)', icon: '💎', maxCap: 999000000000, color: '#0284c7', badgeColor: '#38bdf8', desc: 'Trần 999 Tỉ VNĐ · Kết chuyển lãi ròng tự động' };
  }
  if(stars >= 500){
    return { id: 'platinum', name: 'Thẻ Bạch Kim (Platinum)', icon: '💳', maxCap: 500000000000, color: '#475569', badgeColor: '#94a3b8', desc: 'Trần 500 Tỉ VNĐ · Ưu đãi lãi suất VIP' };
  }
  return { id: 'gold', name: 'Thẻ Vàng (Standard)', icon: '🟡', maxCap: 99000000000, color: '#064e3b', badgeColor: '#a7f3d0', desc: 'Trần 99 Tỉ VNĐ · Tích luỹ tiêu chuẩn' };
}

const BANK_TERMS = [
  { days: 1,  rate: 0.005, label: '1 ngày (+0.5%/ngày)',  dailyRatePct: '0.5%', desc: '0.5%/ngày (ngắn hạn linh hoạt)' },
  { days: 7,  rate: 0.010, label: '7 ngày (+1.0%/ngày)',  dailyRatePct: '1.0%', desc: '1.0%/ngày (~7.2% tích luỹ 7 ngày)' },
  { days: 14, rate: 0.012, label: '14 ngày (+1.2%/ngày)', dailyRatePct: '1.2%', desc: '1.2%/ngày (~18.2% tích luỹ 14 ngày)' },
  { days: 21, rate: 0.013, label: '21 ngày (+1.3%/ngày)', dailyRatePct: '1.3%', desc: '1.3%/ngày (~31.2% tích luỹ 21 ngày)' },
  { days: 28, rate: 0.014, label: '28 ngày (+1.4%/ngày)', dailyRatePct: '1.4%', desc: '1.4%/ngày (~47.6% tích luỹ 28 ngày)' },
  { days: 35, rate: 0.015, label: '35 ngày (+1.5%/ngày)', dailyRatePct: '1.5%', desc: '1.5%/ngày (~68.4% tích luỹ 35 ngày)' },
  { days: 60, rate: 0.016, label: '60 ngày (+1.6%/ngày)', dailyRatePct: '1.6%', desc: '1.6%/ngày (VIP Private Banking)' },
  { days: 90, rate: 0.018, label: '90 ngày (+1.8%/ngày)', dailyRatePct: '1.8%', desc: '1.8%/ngày (Black Card Siêu Kỳ Hạn)' }
];

function getBankDailyRate(termDays){
  const t = BANK_TERMS.find(x => x.days === termDays);
  return t ? t.rate : 0.010;
}

function getBankDailyInterest(balance, termDays){
  const b = Number(balance) || 0;
  if(b <= 0) return 0;
  let interest = 0;
  
  // Bậc 1: 0-100tr @ 1.0%
  const tier1 = Math.min(b, 100000000);
  interest += tier1 * 0.010;
  
  // Bậc 2: 100-500tr @ 0.7%
  if(b > 100000000){
    const tier2 = Math.min(b - 100000000, 400000000);
    interest += tier2 * 0.007;
  }
  
  // Bậc 3: 500tr-2tỉ @ 0.4%
  if(b > 500000000){
    const tier3 = Math.min(b - 500000000, 1500000000);
    interest += tier3 * 0.004;
  }
  
  // Bậc 4: 2-10 tỉ @ 0.2%
  if(b > 2000000000){
    const tier4 = Math.min(b - 2000000000, 8000000000);
    interest += tier4 * 0.002;
  }
  
  // Bậc 5: 10-50 tỉ @ 0.1%
  if(b > 10000000000){
    const tier5 = Math.min(b - 10000000000, 40000000000);
    interest += tier5 * 0.001;
  }
  
  // Bậc 6: 50-200 tỉ @ 0.03%
  if(b > 50000000000){
    const tier6 = Math.min(b - 50000000000, 150000000000);
    interest += tier6 * 0.0003;
  }

  // Bậc 7: >200 tỉ @ 0.01%
  if(b > 200000000000){
    interest += (b - 200000000000) * 0.0001;
  }

  if(termDays){
    const termRate = getBankDailyRate(termDays);
    if(termRate && termRate !== 0.010){
      interest *= (termRate / 0.010);
    }
  }

  return Math.round(interest);
}

function getBankDailyRateByBalance(balance, termDays){
  const b = Number(balance) || 0;
  if(b <= 0) return 0.010;
  return getBankDailyInterest(b, termDays) / b;
}

function calcBankCapBy5Star(star5Count){
  let cap = 10000000;
  const n = Math.max(0, star5Count || 0);
  const tierInfo = getBankTierInfo(n);
  const currentMaxCap = tierInfo.maxCap;
  for(let i = 0; i < n; i++){
    if(cap < 1000000000){
      cap = Math.round(cap * 1.10);
    } else if(cap < 99000000000){
      cap = Math.round(cap * 1.05);
    } else {
      cap = Math.round(cap * 1.02);
    }
    if(cap >= currentMaxCap){
      cap = currentMaxCap;
      break;
    }
  }
  return Math.min(currentMaxCap, cap);
}

function initBankState(){
  if(!S) return;
  if(!S.realEstate) S.realEstate = { main: false, branches: {} };
  if(!S.decorLv) S.decorLv = {};
  if(!S.bank){
    S.bank = {
      cap: 10000000,          // Khởi điểm 10tr
      balance: 0,
      principal: 0,
      termDays: 7,            // Mốc kỳ hạn đặt trước
      daysPassed: 0,
      totalInterest: 0
    };
  } else {
    // Tự động tương thích nếu dữ liệu cũ có savings thay vì balance
    if((S.bank.balance == null || S.bank.balance === 0) && S.bank.savings != null && Number(S.bank.savings) > 0){
      S.bank.balance = Number(S.bank.savings) || 0;
      S.bank.principal = S.bank.balance;
    }
    if(S.bank.principal == null){
      S.bank.principal = S.bank.balance || 0;
    }
    if(S.bank.balance == null) S.bank.balance = 0;
    if(S.bank.cap == null) S.bank.cap = 10000000;
    const tierInfo = getBankTierInfo(S.star5Count);
    if(S.bank.cap > tierInfo.maxCap) S.bank.cap = tierInfo.maxCap;
    if(S.bank.termDays == null) S.bank.termDays = 7;
    if(S.bank.daysPassed == null) S.bank.daysPassed = 0;
  }
  // Tự động đồng bộ hạn mức tương ứng với số lần cán mốc 5 sao đạt được
  const minCap = calcBankCapBy5Star(S.star5Count || 0);
  if((S.bank.cap || 0) < minCap){
    S.bank.cap = minCap;
  }
}

function increaseBankCapOn5Star(){
  if(!S) return;
  initBankState();
  const tierInfo = getBankTierInfo(S.star5Count);
  const oldCap = S.bank.cap || 10000000;
  if(oldCap >= tierInfo.maxCap){
    S.bank.cap = tierInfo.maxCap;
    return tierInfo.maxCap;
  }
  let newCap;
  let pctAdded = 10;
  if(oldCap < 1000000000){
    newCap = Math.round(oldCap * 1.10);
    pctAdded = 10;
  } else if(oldCap < 99000000000){
    newCap = Math.round(oldCap * 1.05);
    pctAdded = 5;
  } else {
    newCap = Math.round(oldCap * 1.02);
    pctAdded = 2;
  }
  newCap = Math.min(tierInfo.maxCap, newCap);
  S.bank.cap = newCap;
  save();
  toast(`⭐ Cán mốc 5.0 sao! Hạn mức ${tierInfo.name} tăng +${pctAdded}% lên ${fmt(newCap)}! 🏦✨`, 5000);
  return newCap;
}

function checkMktAutoPayTax(){
  if(!S || !S.upg || !S.upg.staffMkt) return false;
  initTaxState();
  initBankState();

  const now = Date.now();
  // Điều kiện cần đóng thuế tự động:
  // 1. Thuế chưa được kích hoạt (!isTaxActive())
  // 2. Thuế không có hạn hoặc đã quá hạn (!S.tax.expiresAt || now >= S.tax.expiresAt)
  // 3. Thuế sắp hết hạn trong vòng 2 giờ (S.tax.expiresAt - now <= 2 * 3600 * 1000)
  const isExpiringSoon = S.tax.expiresAt && (S.tax.expiresAt - now <= 2 * 3600 * 1000);
  const needsPay = !isTaxActive() || !S.tax.expiresAt || (now >= S.tax.expiresAt) || isExpiringSoon;
  if(!needsPay) return false;

  const money = S.money || 0;
  if(money < 1000){
    // Quán không đủ tiền két tối thiểu (1.000đ) để trích đóng thuế,
    // nhưng Me Két Tinh vẫn bảo lãnh an toàn sổ tiết kiệm Tà Tưa Bank không bị tịch thu.
    return false;
  }

  // Tự động trích két 15% (mức bảo hộ tối đa chuẩn 72h)
  const pct = 15;
  const taxAmount = Math.max(1000, Math.round(money * (pct / 100)));
  const actualPaid = Math.min(money, taxAmount);

  S.money = Math.max(0, S.money - actualPaid);
  S.cur = S.cur || {};
  S.cur.tax = (S.cur.tax || 0) + actualPaid;
  S.tax.paidAt = now;
  S.tax.expiresAt = now + TAX_CYCLE_MS; // Gia hạn thêm 72h (3 ngày thực)
  S.tax.rate = pct / 100;
  S.tax.amount = actualPaid;
  S.tax.lastPaidAt = now;
  S.tax.totalPaid = (S.tax.totalPaid || 0) + actualPaid;
  S.tax.payCount = (S.tax.payCount || 0) + 1;
  save();

  if(typeof head === 'function') head();

  const mktName = (S.staffNames && S.staffNames.staffMkt) || 'Me Két Tinh';
  toast(`📢 Nhân viên Me Két Tinh (${mktName}) đã tự động trích ${pct}% két (${fmt(actualPaid)}) kích hoạt 72h thời gian tồn tại buff thuế đặc quyền cho quán! 🏛️✨`, 7000, 1);
  return true;
}

function getAllRecipes(){
  if(typeof RECIPES !== 'undefined' && Array.isArray(RECIPES) && RECIPES.length) return RECIPES;
  if(window.Collection && Array.isArray(window.Collection.RECIPES) && window.Collection.RECIPES.length) return window.Collection.RECIPES;
  if(window.RECIPES && Array.isArray(window.RECIPES) && window.RECIPES.length) return window.RECIPES;
  return [];
}

function cleanMilestoneResetReviews(){
  if(!window.S || !Array.isArray(S.reviews)) return;
  S.reviews.forEach(x => {
    if(!x) return;
    const isReset = !!(x.isMilestoneReset || (x.k && String(x.k).startsWith('cycle0s_')) || x.tg === '⭐ Cán Mốc 5 Sao' || (x.t && (x.t.includes('Đạt đỉnh 5 sao hoàn hảo') || x.t.includes('Đặt lại vạch xuất phát 0 sao') || x.t.includes('Cán Mốc 5 Sao'))));
    if(isReset){
      x.isMilestoneReset = true;
      delete x.rp;
      delete x.crp;
      delete x.mktRep;
      delete x.mktName;
      delete x.mktCustHappy;
      delete x.mktStarUp;
      delete x.mktStarDown;
      delete x.deltaStars;
    }
  });
}

function backfillSpecialDrinkReviewsIfMissing(){
  if(!window.S || !S.collection || !S.collection.craftedRecipes) return;
  const craftedKeys = Object.keys(S.collection.craftedRecipes);
  if(!craftedKeys.length) return;
  
  S.reviews = S.reviews || [];
  const hasSpecReview = S.reviews.some(x => x && (x.isSpecialDrink || (x.tg && x.tg.includes('Đặc Biệt')) || (x.t && (x.t.includes('ĐỒ UỐNG ĐẶC BIỆT') || x.t.includes('MÓN ĐẶC BIỆT') || x.t.includes('CỰC PHẨM ĐỘC BẢN')))));
  
  if(!hasSpecReview){
    const allRecipes = getAllRecipes();
    const craftedRecipes = allRecipes.filter(r => craftedKeys.includes(r.id));
    if(!craftedRecipes.length) return;

    const backfillItems = [];
    const reviewerNames = ['Foodie Check-in 🧋', 'Khách Nghiền Trà Sữa', 'Tín Đồ Trà Sữa Sài Gòn'];
    craftedRecipes.slice(0, 3).forEach((rec, idx) => {
      const order = rec.gameOrder || { base: 'tra', flav: null, tops: ['tcden'], size: 'M' };
      backfillItems.push({
        s: 5,
        origS: 5,
        t: `✨ [ĐỒ UỐNG ĐẶC BIỆT] Vừa ghé quán thưởng thức ly "${rec.name}". Hương vị độc bản quá đỉnh, thơm béo hài hòa không lẫn vào đâu được! 5 sao chất lượng! ⭐⭐⭐⭐⭐`,
        k: 'spec_backfill_' + rec.id + '_' + Date.now(),
        d: S.day || 1,
        o: false,
        n: reviewerNames[idx % reviewerNames.length],
        f: '🧋',
        tg: '✨ Đồ Uống Đặc Biệt',
        isSpecialDrink: true,
        specialRecipeName: rec.name,
        b: order.base,
        fl: order.flav,
        tp: order.tops || [],
        ch: !!order.cheese,
        sz: order.size || 'M',
        time: Date.now() - (idx + 1) * 3600000
      });
    });
    // Đặt các review đồ uống đặc biệt này lên đầu danh sách để người chơi thấy ngay!
    S.reviews = [...backfillItems, ...S.reviews];
    save();
  }
}

function ensureDiverseReviewsIfMissing(){
  // ĐÃ VÔ HIỆU HÓA: Tuyệt đối không tự chèn đánh giá xấu giả mạo (1-4 sao) làm biến dạng phân bổ sao và nhảy số ảo
  return;
}

function cleanDiverseFakeReviews(){
  if(!window.S || !Array.isArray(S.reviews)) return;
  const beforeLen = S.reviews.length;
  S.reviews = S.reviews.filter(x => !x || !x.k || !String(x.k).startsWith('diverse_star_'));
  if(S.reviews.length !== beforeLen && typeof save === 'function') save();
}

function getOrInitRevDistribution(){
  if(!window.S) return { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
  const totalRev = (typeof revCount === 'function') ? revCount() : Math.max(S.revTotal || 0, (S.reviews || []).length);
  const curR = (typeof rating === 'function') ? rating() : 4.5;
  
  if(S.revDist && typeof S.revDist === 'object'){
    const sum = (S.revDist[5]||0) + (S.revDist[4]||0) + (S.revDist[3]||0) + (S.revDist[2]||0) + (S.revDist[1]||0);
    if(sum > 0 && Math.abs(sum - totalRev) < 100){
      if(sum !== totalRev){
        S.revDist[5] = Math.max(0, (S.revDist[5]||0) + (totalRev - sum));
      }
      return S.revDist;
    }
  }

  // Khởi tạo phân bổ tự nhiên chuẩn F&B theo số sao trung bình thực tế curR (tránh nhảy đều, nhảy loạn xạ)
  const normR = Math.max(1, Math.min(5, curR));
  let p5, p4, p3, p2, p1;
  if(normR >= 4.8){
    p5 = 0.88; p4 = 0.085; p3 = 0.022; p2 = 0.009; p1 = 0.004;
  } else if(normR >= 4.5){
    p5 = 0.76; p4 = 0.170; p3 = 0.042; p2 = 0.018; p1 = 0.010;
  } else if(normR >= 4.0){
    p5 = 0.58; p4 = 0.270; p3 = 0.085; p2 = 0.040; p1 = 0.025;
  } else if(normR >= 3.5){
    p5 = 0.40; p4 = 0.300; p3 = 0.180; p2 = 0.070; p1 = 0.050;
  } else if(normR >= 3.0){
    p5 = 0.25; p4 = 0.300; p3 = 0.250; p2 = 0.120; p1 = 0.080;
  } else {
    p5 = 0.15; p4 = 0.200; p3 = 0.250; p2 = 0.220; p1 = 0.180;
  }

  const c4 = Math.round(totalRev * p4);
  const c3 = Math.round(totalRev * p3);
  const c2 = Math.round(totalRev * p2);
  const c1 = Math.round(totalRev * p1);
  const c5 = Math.max(0, totalRev - (c4 + c3 + c2 + c1));

  S.revDist = { 5: c5, 4: c4, 3: c3, 2: c2, 1: c1 };
  return S.revDist;
}

function checkReset5StarRating(){
  if(!S || !(S.reviews && S.reviews.length >= 5)) return;
  const curR = rating();
  if(curR >= 4.80){
    const maxFeasibleStar5 = Math.min(80000, 200 + (S.day || 1) * 250);
    if((S.star5Count || 0) >= maxFeasibleStar5){
      if(typeof R !== 'undefined' && R && !R._starCapWarnedToday){
        R._starCapWarnedToday = true;
        if(typeof toast === 'function') toast(`⭐ Quán đã đạt trần sao danh vọng tối đa của Ngày ${S.day || 1} (x${Math.floor(maxFeasibleStar5)})! Hãy sang ngày mới để tiếp tục tích lũy! ✨`, 4500, 1);
      }
    } else {
      S.star5Count = (S.star5Count || 0) + 1;
      increaseBankCapOn5Star();
    }
    
    // Đạt 5 sao: reset về 0 sao để bắt đầu chu kỳ cày mới
    // Phản hồi đánh giá của việc reset là không cần thiết, tuyệt đối không tạo rp, crp hay mktRep
    const pool = [
      {t:'Quán vừa cán mốc 5 sao xuất sắc! Khởi động chu kỳ thử thách mới với 0 sao để khẳng định chất lượng bền vững!', n:'Hệ Thống Đánh Giá'},
      {t:'Đạt đỉnh 5 sao hoàn hảo! Đặt lại vạch xuất phát 0 sao, cùng chờ đón những ly trà thơm ngon tiếp theo!', n:'Cộng Đồng Trà Sữa'},
      {t:'Tiệm trà thăng hoa đạt 5 sao! Bắt đầu chặng đường mới từ 0 sao để quán tiếp tục bứt phá phong độ!', n:'Khách Thân Thiết'},
      {t:'Vinh danh tiệm trà 5 sao! Reset đánh giá về 0 sao để bước vào hành trình phục vụ khách hàng mới!', n:'ShopeeFood Review'}
    ];

    const newItems = [];
    for(let i = 0; i < 4; i++){
      const template = pool[i % pool.length];
      newItems.push({
        s: 0,
        origS: 0,
        t: template.t,
        n: template.n,
        f: '🏆',
        tg: '⭐ Cán Mốc 5 Sao',
        k: 'cycle0s_' + Date.now() + '_' + i,
        time: Date.now(),
        isMilestoneReset: true
      });
    }
    // Lọc bỏ bớt các review 0 sao cũ của các chu kỳ trước để không làm loãng kẹt điểm
    const existing = (S.reviews || []).filter(x => !x || !x.k || !x.k.startsWith('cycle0s_'));
    S.reviews = [...newItems, ...existing];

    cleanMilestoneResetReviews();
    save();
    head();
    toast(`🎉 Chúc mừng tiệm cán mốc 5 sao (Lần ${S.star5Count})! Hạn mức Bank đã tăng và bắt đầu chu kỳ cày mới! ⭐✨`, 5000, 1);
  }
}

function checkTaxBankPenalty(fromEndDay){
  if(!S) return;
  initBankState();
  // Nếu có nhân viên Me Két Tinh: luôn ưu tiên tự động đóng thuế
  if(S.upg && S.upg.staffMkt){
    checkMktAutoPayTax();
    return;
  }
  // Cho phép quán quá hạn đóng thuế thay vì trừ hết tiền trong bank
  if(isTaxOverdue()){
    if(checkMktAutoPayTax()) return;
    // Khi nợ thuế quá hạn, ngân hàng chỉ tạm ngưng sinh lãi kép, bảo toàn 100% tiền gửi
    if(S.bank && S.bank.balance > 0 && !fromEndDay && (!R || R.mode === 'prep') && !R._taxOverdueWarnShown){
      R._taxOverdueWarnShown = true;
      toast(`🏛️⚠️ Thuế đang quá hạn 72h! Tà Tưa Bank tạm ngưng tính lãi kép đến khi nộp thuế. Tiền gửi (${fmt(S.bank.balance)}) vẫn được bảo toàn nguyên vẹn 100%! 🛡️`, 6000, 1);
    }
  }
}

function openBankDepositDlg(){
  initBankState();
  checkMktAutoPayTax();
  checkTaxBankPenalty();
  const cap = Math.min(BANK_MAX_CAP, S.bank.cap || 10000000);
  const curBal = S.bank.balance || 0;
  const remCap = Math.max(0, cap - curBal);
  const maxDeposit = Math.min(S.money, remCap);
  if(maxDeposit <= 0){
    if(S.money <= 0) return toast('Két tiền quán hiện không có tiền để gửi tiết kiệm!');
    return toast(`Đã đạt hạn mức tối đa của Tà Tưa Bank (${fmt(cap)})! ${cap >= BANK_MAX_CAP ? 'Đã đạt trần tối đa 99 Tỷ của hệ thống ngân hàng.' : 'Hãy kiếm thêm đánh giá 5★ để mở rộng hạn mức.'}`);
  }
  if(maxDeposit < 10000 && S.money < 10000){
    return toast('Số tiền gửi tiết kiệm tối thiểu là 10.000đ!');
  }

  const hadDeposit = curBal > 0;
  let curTerm = S.bank.termDays || 7;
  let curAmt = Math.min(1000000, maxDeposit);

  const fmtDots = n => {
    if (!n && n !== 0) return '';
    const num = Math.round(Number(String(n).replace(/\D/g, '')) || 0);
    return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '.');
  };

  const renderDlg = () => {
    const dailyRate = getBankDailyRate(curTerm);
    const dailyRateStr = (dailyRate * 100).toFixed(1) + '%';
    ask(`
      <div style="text-align:left;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-size:32px;">🏦</span>
          <div>
            <h2 style="margin:0;font-size:1.15rem;color:#065f46;">GỬI TIẾT KIỆM TÀ TƯA BANK</h2>
            <div style="font-size:0.78rem;color:#047857;">Lãi kép bậc thang ${dailyRateStr}/ngày · Tối đa 99 Tỷ · An toàn 100%</div>
          </div>
        </div>
        <div style="background:#f1f5f9;border-radius:10px;padding:8px 10px;font-size:0.84rem;margin-bottom:10px;">
          <div>💰 Két quán có: <b>${fmt(S.money)}</b></div>
          <div>🏦 Đang gửi: <b>${fmt(curBal)}</b> / Hạn mức: <b style="color:#059669;">${fmt(cap)}</b></div>
          <div>📊 Còn có thể gửi thêm: <b style="color:#2563eb;">${fmt(remCap)}</b></div>
          ${hadDeposit ? `<div style="color:#059669;font-weight:700;margin-top:2px;">⏳ Tiến độ đang tích luỹ: <b>${S.bank.daysPassed || 0}/${S.bank.termDays || 7} ngày</b> (giữ nguyên kỳ hạn cam kết, tiếp tục tích luỹ)</div>` : ''}
          ${S.money >= getSafeCashCeiling(S.day) && remCap < S.money && cap < BANK_MAX_CAP ? `<div style="color:#b91c1c;background:#fef2f2;border:1px dashed #fca5a5;padding:6px 8px;border-radius:8px;margin-top:6px;font-size:0.78rem;line-height:1.4;">
            🚨 <b>Két vượt trần an toàn (${fmt(getSafeCashCeiling(S.day))}):</b> Tỉ lệ trộm cắp &amp; lừa đảo đang rất cao! Hãy cày <b>đạt 5.0★ TỔNG ĐÁNH GIÁ</b> để Tà Tưa Bank tự động mở rộng hạn mức gửi tiền!
          </div>` : ''}
        </div>
        <label style="font-weight:700;font-size:0.84rem;">Số tiền muốn gửi tiết kiệm:</label>
        <div style="display:flex;gap:6px;align-items:center;margin:4px 0 8px;">
          <input type="text" inputmode="numeric" id="bankInpAmt" value="${fmtDots(curAmt)}" placeholder="0" style="flex:1;padding:8px 12px;border:1.5px solid #cbd5e1;border-radius:8px;font-size:1.05rem;font-weight:800;color:#0f172a;letter-spacing:0.4px;">
          <button type="button" class="sbtn ghost" id="btnBankMaxAmt" style="padding:8px 12px;font-weight:800;">Tối đa</button>
        </div>
        <label style="font-weight:700;font-size:0.84rem;">Đặt mốc kỳ hạn rút tiền &amp; Lãi suất:</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:6px 0 10px;">
          ${BANK_TERMS.map(t => {
            const isSelected = curTerm === t.days;
            // Nếu đã có sổ gửi đang chạy: không cho chọn kỳ hạn ngắn hơn kỳ hạn cam kết đang có (chống exploit hạ kỳ hạn)
            const isLockedLower = hadDeposit && t.days < (S.bank.termDays || 7);
            return `
              <button type="button" class="sbtn ${isSelected ? 'pri' : 'ghost'}" data-bank-term="${t.days}" ${isLockedLower ? 'disabled style="opacity:0.4;cursor:not-allowed;" title="Không thể hạ xuống mốc ngắn hơn kỳ hạn cam kết hiện tại"' : ''} style="padding:7px;font-size:0.78rem;font-weight:700;">
                ${t.label}
              </button>
            `;
          }).join('')}
        </div>
        <div style="font-size:0.75rem;color:#64748b;line-height:1.4;">
          ⚠️ <b>Quy tắc kỳ hạn:</b> Lãi suất được tính theo bậc kỳ hạn (từ 0.5% đến 1.5%/ngày). Rút trước mốc kỳ hạn đã đặt sẽ <b>mất toàn bộ tiền lãi</b> và chỉ nhận lại tiền gốc!<br>
          ${hadDeposit ? `🔒 <b>Đang có sổ tiết kiệm:</b> Tiền gửi thêm sẽ tiếp tục duy trì kỳ hạn tối thiểu <b>${S.bank.termDays || 7} ngày</b> của sổ hiện tại, không thể chọn kỳ hạn ngắn hơn để lách luật.` : '💡 <b>Mẹo:</b> Kỳ hạn càng dài thì lãi kép mỗi ngày càng cao (tối đa +1.5%/ngày)!'}
        </div>
      </div>
    `, [
      ['Xác nhận gửi tiền', () => {
        const inp = $('bankInpAmt');
        const rawVal = inp ? inp.value.replace(/\D/g, '') : '';
        let amt = rawVal ? Math.round(+rawVal) : curAmt;
        const minDep = Math.min(10000, maxDeposit);
        amt = Math.max(minDep, Math.min(amt, maxDeposit));
        if(amt > S.money) return toast('Két quán không đủ tiền!');
        S.money -= amt;
        S.bank.balance = (S.bank.balance || 0) + amt;
        S.bank.principal = (S.bank.principal || 0) + amt;
        if(hadDeposit){
          // Vá lỗ hổng: Tuyệt đối không cho phép hạ kỳ hạn để lách luật rút trước hạn
          curTerm = Math.max(S.bank.termDays || 7, curTerm);
          S.bank.termDays = curTerm;
        } else {
          S.bank.termDays = curTerm;
          S.bank.daysPassed = 0;
        }
        save();
        head();
        paneThue();
        sfx('coin');
        const rateNow = (getBankDailyRate(S.bank.termDays) * 100).toFixed(1) + '%';
        toast(hadDeposit 
          ? `Đã gửi thêm ${fmt(amt)} vào sổ tiết kiệm! Kỳ hạn ${S.bank.termDays} ngày (Lãi ${rateNow}/ngày), tiến độ tiếp tục: ${S.bank.daysPassed || 0}/${S.bank.termDays} ngày! 🎉`
          : `Đã gửi ${fmt(amt)} vào Tà Tưa Bank kỳ hạn ${curTerm} ngày (Lãi kép ${rateNow}/ngày)! 🎉`);
      }, 1],
      ['Hủy', () => {}]
    ]);

    setTimeout(() => {
      const inp = $('bankInpAmt');
      if (inp) {
        inp.addEventListener('input', () => {
          const orig = inp.value;
          const oldSel = inp.selectionEnd != null ? inp.selectionEnd : orig.length;
          const digitsBefore = (orig.slice(0, oldSel).match(/\d/g) || []).length;

          let raw = orig.replace(/\D/g, '');
          if (!raw) {
            inp.value = '';
            curAmt = 0;
            return;
          }
          if (raw.length > 12) raw = raw.slice(0, 12);
          const num = Math.round(+raw);
          curAmt = num;
          const formatted = fmtDots(num);
          inp.value = formatted;

          let newSel = formatted.length;
          let count = 0;
          for (let i = 0; i < formatted.length; i++) {
            if (/\d/.test(formatted[i])) count++;
            if (count >= digitsBefore) {
              newSel = i + 1;
              break;
            }
          }
          try { inp.setSelectionRange(newSel, newSel); } catch (_) {}
        });

        inp.addEventListener('blur', () => {
          let val = Math.round(+(inp.value.replace(/\D/g, '')) || 0);
          const minDep = Math.min(10000, maxDeposit);
          if (val > 0) {
            val = Math.max(minDep, Math.min(val, maxDeposit));
            curAmt = val;
            inp.value = fmtDots(val);
          }
        });
      }

      const maxBtn = $('btnBankMaxAmt');
      if(maxBtn){
        maxBtn.onclick = () => {
          const inp = $('bankInpAmt');
          curAmt = maxDeposit;
          if(inp){ inp.value = fmtDots(maxDeposit); }
        };
      }
      document.querySelectorAll('[data-bank-term]').forEach(b => {
        b.onclick = () => {
          if(b.disabled) return;
          curTerm = +b.dataset.bankTerm;
          const inp = $('bankInpAmt');
          if (inp) {
            const raw = inp.value.replace(/\D/g, '');
            if (raw) curAmt = Math.round(+raw);
          }
          renderDlg();
        };
      });
    }, 50);
  };

  renderDlg();
}

function openBankWithdrawDlg(){
  initBankState();
  checkTaxBankPenalty();
  if(!S.bank || !S.bank.balance || S.bank.balance <= 0){
    return toast('Sổ tiết kiệm hiện không có số dư để rút!');
  }
  const bal = S.bank.balance;
  const prin = S.bank.principal || bal;
  const interest = Math.max(0, bal - prin);
  const isMatured = (S.bank.daysPassed || 0) >= (S.bank.termDays || 7);

  if(isMatured){
    ask(`
      <div style="text-align:left;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-size:32px;">🎉🏦</span>
          <div>
            <h2 style="margin:0;font-size:1.15rem;color:#15803d;">RÚT TIẾT KIỆM TỚI HẠN</h2>
            <div style="font-size:0.78rem;color:#16a34a;">Đã hoàn thành kỳ hạn ${S.bank.termDays} ngày bán nước</div>
          </div>
        </div>
        <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;padding:10px;font-size:0.86rem;line-height:1.5;margin:8px 0;">
          💰 <b>Tiền gốc:</b> ${fmt(prin)}<br>
          ✨ <b>Lãi kép tích luỹ (${(getBankDailyRate(S.bank.termDays||7)*100).toFixed(1)}%/ngày):</b> <b style="color:#15803d;">+${fmt(interest)}</b><br>
          💵 <b>Tổng tiền nhận về két:</b> <b style="color:#d97706;font-size:1.05rem;">${fmt(bal)}</b>
        </div>
        <div style="font-size:0.8rem;color:#475569;">
          Bạn có muốn rút toàn bộ số tiền tiết kiệm và lãi kép này về két quán không?
        </div>
      </div>
    `, [
      ['Rút trọn vẹn về két', () => {
        S.money += bal;
        S.bank.balance = 0;
        S.bank.principal = 0;
        S.bank.daysPassed = 0;
        save();
        head();
        paneThue();
        sfx('coin');
        sfx('lvup');
        toast(`🎉 Đã rút ${fmt(bal)} (bao gồm lãi kép ${fmt(interest)}) về két quán!`);
      }, 1],
      ['Để lại tiếp tục sinh lời', () => {}]
    ]);
  } else {
    ask(`
      <div style="text-align:left;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span style="font-size:32px;">⚠️⏳</span>
          <div>
            <h2 style="margin:0;font-size:1.15rem;color:#dc2626;">CẢNH BÁO RÚT TRƯỚC HẠN</h2>
            <div style="font-size:0.78rem;color:#b91c1c;">Chưa đạt mốc kỳ hạn đã cam kết</div>
          </div>
        </div>
        <div style="background:#fef2f2;border:1.5px solid #fca5a5;border-radius:10px;padding:10px;font-size:0.86rem;line-height:1.5;margin:8px 0;">
          ⏳ <b>Tiến độ kỳ hạn:</b> Mới được <b>${S.bank.daysPassed || 0}/${S.bank.termDays || 7} ngày bán nước</b>.<br>
          💰 <b>Tiền gốc hoàn trả:</b> <b style="color:#0f172a;">${fmt(prin)}</b><br>
          ❌ <b>Tiền lãi bị huỷ (0% lãi suất):</b> <b style="color:#dc2626;">-${fmt(interest)}</b> (mất toàn bộ lãi kép)
        </div>
        <div style="font-size:0.8rem;color:#64748b;">
          Theo quy định Tà Tưa Bank, rút trước hạn sẽ <b>không có lãi suất</b>. Bạn chỉ nhận lại đúng số tiền gốc ban đầu. Bạn có chắc chắn muốn rút không?
        </div>
      </div>
    `, [
      ['Xác nhận rút gốc (Mất lãi)', () => {
        S.money += prin;
        S.bank.balance = 0;
        S.bank.principal = 0;
        S.bank.daysPassed = 0;
        save();
        head();
        paneThue();
        sfx('coin');
        toast(`Đã rút ${fmt(prin)} tiền gốc về két (mất lãi trước hạn).`);
      }, 1],
      ['Hủy, tiếp tục gửi', () => {}]
    ]);
  }
}

/* ===== HỆ THỐNG BẠN THÂN HÙA THEO ĐÁNH GIÁ 1 SAO ===== */
function triggerFriendBadReview(origRev){
  if(!origRev || origRev._friendCalled) return;
  origRev._friendCalled = true;
  const friendFirstNames = ['Linh', 'Trang', 'Huy', 'Tú', 'Khánh', 'Minh', 'Ngân', 'Bảo', 'Khoa', 'Vy', 'Châu', 'Đạt', 'Phương', 'Hoàng'];
  const friendFaces = ['👩‍🦰', '🧑‍🦱', '👩‍🦳', '👱‍♂️', '👩', '🧑', '👧', '👦'];
  const origName = origRev.n || 'Khách';
  const fName = rnd(friendFirstNames) + ' (Bạn của ' + origName + ')';
  const fFace = rnd(friendFaces);
  const friendQuotes = [
    `Nghe con bạn mình (${origName}) đi uống về kể bị quán phục vụ tệ bạc/chửi bới, tức giùm bạn luôn á! Vô đây chấm 1★ cùng bạn tẩy chay quán này! 😡👎`,
    `Bạn thân tui (${origName}) vừa ghé quán về khóc lóc vì nước dở tệ mà chủ quán còn thái độ! Hùa theo tặng 1★ cho tiệm sáng mắt ra! 😤🧋`,
    `Hội bạn tụi tui chính thức phong sát quán này! Nghe ${origName} mách làm ăn tắc trách, kéo nhau vô đây chấm 1★ cảnh cáo! 🚫🔥`,
    `Thấy bạn thân mình (${origName}) uất ức lên mạng bóc phốt là tui phải nhảy vô chấm 1★ phụ bạn liền! Làm ăn kiểu gì vậy trời?! 🤬💢`,
    `Bảo vệ quyền lợi bạn iu (${origName})! Nghe kể trải nghiệm kinh hoàng ở đây là tui cạch mặt luôn, 1★ xứng đáng! 🤮💩`,
    `Nhỏ bạn tui (${origName}) hiền lành mà đi uống về tức anh ách, cả hội bạn tụi tui kéo vô đây vote 1★ tiễn vong! 💩🚫`
  ];
  const fText = rnd(friendQuotes);
  const friendReview = {
    s: 1,
    t: fText,
    k: 'chime_' + Date.now() + '_' + Math.random(),
    d: S.day,
    o: false,
    n: fName,
    f: fFace,
    tg: '👥 Hùa theo bạn bè',
    isFriendChimeIn: true,
    targetFriendName: origName
  };
  S.reviews.unshift(friendReview);
  S.revTotal = Math.max(S.revTotal || 0, S.reviews.length - 1) + 1;
  if(S.reviews.length > 2500) S.reviews.length = 2500;
  R.today.stars.push(1);
  save();
  head();
  toast(`🚨 Khách ${origName} rủ bạn đánh giá 1★ hùa theo! 😠`, 3000, 1);
}
function getStaffSpeedBuff(id){
  if(!S) return 0;
  // Hiện tại chỉ buff tốc độ duy nhất ở mục đóng thuế
  const taxBuff = typeof getTaxSpeedBuff === 'function' ? getTaxSpeedBuff() : 0;
  // Nhân viên Me két tinh: Giảm 20% thời gian pha của nhân viên (tăng tốc độ lên 1.25x: Gen Z 200ms còn 160ms)
  const mktBuff = (S.upg && S.upg.staffMkt) ? 0.25 : 0;
  const specBuff = (window.R && window.R.slots && window.R.slots.some(s => s && s.isSpecialCust && s.specialEffect && s.specialEffect.id === 'buff_speed')) ? 0.40 : 0;
  // Buff tốc độ từ KPI: Xuất sắc (-3% thời gian pha chế), Đạt chuẩn (-1% thời gian pha chế)
  let kpiBuff = 0;
  if(S.staffKpi){
    if(id && S.staffKpi[id]){
      kpiBuff = S.staffKpi[id].speedBuff || 0;
    } else {
      let sum = 0, count = 0;
      if(typeof STAFF !== 'undefined' && Array.isArray(STAFF)){
        STAFF.forEach(u => {
          if(S.hired && S.hired[u.id] && S.upg && S.upg[u.id] && S.staffKpi[u.id] && S.staffKpi[u.id].speedBuff){
            sum += S.staffKpi[u.id].speedBuff;
            count++;
          }
        });
      }
      kpiBuff = count > 0 ? (sum / count) : 0;
    }
  }
  const cupBuff = (typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
  const cupSpdBuff = (cupBuff && cupBuff.speedBonus) ? cupBuff.speedBonus : 0;
  return taxBuff + mktBuff + specBuff + kpiBuff + cupSpdBuff;
}
function getStaffKpiSpeedBuffTotal(){
  if(!S || !S.staffKpi) return 0;
  return STAFF.reduce((acc, u) => {
    if(S.hired && S.hired[u.id] && S.upg && S.upg[u.id]){
      return acc + ((S.staffKpi[u.id] && S.staffKpi[u.id].speedBuff) || 0);
    }
    return acc;
  }, 0);
}
function getStaffBillBonusTotal(){
  if(!S) return 0;
  return STAFF.reduce((acc, u) => {
    if(S.hired && S.hired[u.id] && S.upg && S.upg[u.id]){
      const baseBonus = (S.staffKpi && S.staffKpi[u.id] && S.staffKpi[u.id].billBonus) || 0;
      const trainBonus = (typeof getStaffTrainKpiExtraRate === 'function') ? getStaffTrainKpiExtraRate(u.id) : 0;
      return acc + baseBonus + trainBonus;
    }
    return acc;
  }, 0);
}
const DEFAULT_STAFF_NAMES = {
  staff0: 'Hồ Khải',
  staff1: 'Lâm Phước',
  staff2: 'Lý Gia Huy',
  staffOn: 'Hoàng Minh',
  staff3: 'Đinh Nhàn',
