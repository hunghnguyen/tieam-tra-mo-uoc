const NM_NU=["An", "Anh", "Ánh", "Bảo Anh", "Bảo Châu", "Bảo Ngọc", "Bích", "Cẩm", "Cát Tường", "Châu", "Chi", "Diệp", "Diệu", "Diễm", "Dung", "Duyên", "Gia Hân", "Giang", "Hà", "Hạ", "Hải Yến", "Hân", "Hằng", "Hạnh", "Hiền", "Hoa", "Hoài", "Hồng", "Huệ", "Hương", "Huyền", "Khánh Linh", "Khánh Vy", "Khuê", "Kiều", "Kim", "Lam", "Lan", "Lan Anh", "Liên", "Linh", "Loan", "Ly", "Mai", "Mai Anh", "Minh Thư", "My", "Mỹ", "Nga", "Ngân", "Nghi", "Ngọc", "Ngọc Hân", "Nguyệt", "Nhã", "Nhàn", "Nhi", "Nhung", "Như", "Oanh", "Phương", "Phương Anh", "Quế", "Quyên", "Quỳnh", "Quỳnh Anh", "Sa", "Tâm", "Thanh", "Thảo", "Thi", "Thơ", "Thu", "Thùy", "Thủy", "Thư", "Thy", "Tiên", "Trà My", "Trâm", "Trang", "Trinh", "Trúc", "Tuyết", "Uyên", "Vân", "Vi", "Việt Hà", "Vy", "Xuân", "Yến", "Ý", "Hoàng Anh", "Thục Anh", "Khả Hân", "Minh Châu", "Tường Vy", "Hồng Nhung", "Thanh Hà", "Thu Trang", "Bích Ngọc", "Ngọc Trâm", "Diễm My", "Thảo Vy", "An Nhiên", "Hạ Vy", "Hải Đường", "Mộc Miên", "Thiên Kim", "Kim Ngân", "Như Ý", "Bảo Vy", "Tú Anh", "Tố Như", "Thanh Trúc", "Phương Linh", "Yến Nhi", "Mỹ Duyên", "Ngọc Diệp", "Quế Anh", "Lệ Quyên", "Hoàng Yến"],NM_NAM=["An", "Bảo", "Bình", "Cường", "Công", "Danh", "Đạt", "Dũng", "Duy", "Dương", "Đăng", "Đông", "Đức", "Gia Bảo", "Hải", "Hào", "Hậu", "Hiếu", "Hiển", "Hòa", "Hoàng", "Huy", "Hùng", "Hưng", "Khang", "Khải", "Khánh", "Khoa", "Khôi", "Kiên", "Kiệt", "Lâm", "Lộc", "Long", "Luân", "Mạnh", "Minh", "Nam", "Nghĩa", "Nguyên", "Nhân", "Nhật", "Phát", "Phong", "Phúc", "Phước", "Quân", "Quang", "Quốc", "Sang", "Sơn", "Tài", "Tâm", "Tân", "Thái", "Thắng", "Thành", "Thiện", "Thịnh", "Thông", "Tiến", "Toàn", "Trí", "Trọng", "Trung", "Tú", "Tuấn", "Tùng", "Văn", "Việt", "Vinh", "Vũ", "Minh Khang", "Gia Huy", "Đức Anh", "Hoàng Nam", "Quốc Bảo", "Thành Đạt", "Minh Quân", "Tuấn Kiệt", "Nhật Minh", "Hải Đăng", "Anh Khoa", "Bảo Long", "Thiên Ân", "Trung Kiên", "Việt Hoàng", "Quang Huy", "Đình Phong"],NM_BE=["Bé Na", "Bơ", "Mít", "Sữa", "Su Su", "Bin", "Tôm", "Cún", "Mèo Mun", "Kem", "Na Na", "Gấu", "Bống", "Bi", "Xoài", "Chuối", "Heo", "Cà Rốt", "Bắp", "Ốc", "Nấm", "Mochi", "Khoai", "Đậu", "Sóc", "Thỏ", "Kẹo", "Bánh Bao", "Cốm", "Gạo", "Nếp", "Tí", "Tèo", "Bo", "Ken", "Ben", "Bông", "Mận", "Dâu", "Chôm Chôm", "Cam", "Quýt", "Mơ", "Táo", "Nho", "Ruby", "Coca", "Pepsi", "Sushi", "Pudding", "Bột", "Mì", "Tủn", "Hạt Tiêu", "Gừng", "Sả", "Bắp Cải", "Củ Cải", "Su Hào", "Xíu"],NM_CHU=["Hùng", "Tâm", "Phong", "Lâm", "Thành", "Dũng", "Sơn", "Bình", "Tư", "Năm", "Sáu", "Bảy", "Tám", "Hai", "Ba", "Lực", "Quý", "Phúc", "Lộc", "Thọ", "Tài", "Nghĩa", "Trung", "Hiếu", "Hậu", "Đức", "Thắng", "Lợi", "Kha", "Minh", "Hòa", "Thuận", "Vĩnh", "Khương", "Tùng", "Bách", "Trường", "Cảnh", "Toàn", "Chiến"],NM_BA=["Hai", "Ba", "Tư", "Năm", "Sáu", "Bảy", "Tám", "Chín", "Mười", "Út", "Lan", "Cúc", "Mai", "Đào", "Hồng", "Huệ", "Sen", "Thơm", "Tý", "Nhàn", "Hạnh", "Phúc", "Xuân", "Thu", "Liên", "Mận", "Na", "Sương", "Hiền", "Tâm"];
const NM_HO=['Nguyễn','Trần','Lê','Phạm','Hoàng','Huỳnh','Phan','Vũ','Võ','Đặng','Bùi','Đỗ','Hồ','Ngô','Dương','Lý','Trương','Đinh','Lâm','Mai'];
function uniqName(gen){const h=S.nameLog||(S.nameLog=[]),used=new Set([...h,...(R&&R.slots?[...R.slots.filter(Boolean),...(R.online||[])].map(c=>c.name):[])]);
  let n=gen();for(let t=0;t<40&&used.has(n);t++)n=gen();h.push(n);if(h.length>380)h.splice(0,h.length-380);return n}
const HN=L=>rnd(NM_HO)+' '+rnd(L);
const PNAME={0:()=>uniqName(()=>Math.random()<.5?rnd(NM_NU):HN(NM_NU)),1:()=>uniqName(()=>Math.random()<.5?rnd(NM_NU):rnd(NM_BE)),3:()=>uniqName(()=>'Chị '+rnd(NM_NU)),
  4:()=>uniqName(()=>Math.random()<.6?rnd(NM_BE):'Bé '+rnd(Math.random()<.5?NM_NU:NM_NAM)),7:()=>uniqName(()=>rnd(NM_NU)),8:()=>uniqName(()=>HN(NM_NU)),
  2:()=>uniqName(()=>Math.random()<.5?'Anh '+rnd(NM_NAM):HN(NM_NAM)),5:()=>uniqName(()=>'Chú '+rnd(Math.random()<.4?NM_CHU:NM_NAM)),6:()=>uniqName(()=>'Bà '+rnd(Math.random()<.3?NM_BA:NM_NU))};
const OPEN=['Cho mình','Em ơi, cho chị','Bán cho anh','Làm giúp mình','Cho em','Cho tui'],ENDS=[' nha!',' nhé!','.',' nha, cảm ơn!',' nhé em!'];
const N_LAST=['Anh','Trâm','Vy','Linh','Hân','Nhi','My','Thảo','Ngân','Trang','Hương','Uyên','Quyên','Hà','Châu','Duyên','Khuê','Yến','Tú','Nam','Huy','Khoa','Phúc','Bảo','Tuấn','Long','Khang','Đạt','Minh','Hiếu','Quân','Thịnh','Sơn','Tài','Vinh','Kiệt','Duy','Lộc','Toàn','Trí','Ngọc','Thư','Giang','Phương','Nga','Loan','Quang','Tâm','Hưng','Phát'];
const N_MID=['Minh','Ngọc','Thu','Gia','Bảo','Khánh','Hoàng','Thanh','Quỳnh','Tuấn','Hải','Phương','Mai','Đức','Kim','Nhật','Tường','Hồng','Diệu','Anh','Thiên','Xuân','Như','Cát'];
const N_NICK=['Bé Na','Bơ','Mít','Sữa','Su Su','Bin','Tôm','Cún','Mèo Mun','Kem','Na Na','Gấu','Bống','Bi','Xoài','Chuối','Heo Hồng','Cà Rốt','Bắp','Ốc','Nấm','Mochi','Tiểu Muội','Khoai','Đậu'];
function genName(){return uniqName(()=>Math.random()<.5?rnd(NM_HO)+' '+rnd(NM_NU):rnd(NM_HO)+' '+rnd(NM_NAM))}
const SAVE='tsShop2', OWNER_SAVE='tsOwner';
// GAME_VERSION = '12.47.245' (khai báo tại dòng 1 đầu file)
const CHANGELOG=[
  {v:'12.47.588',d:'15/10/2026',items:[
    '🛡️ MIỄN TRỪ 100% DOANH THU TRONG CA KHỎI RỦI RO KÉT & NÂNG TRẦN KÉT AN TOÀN LÊN 3 TỶ ➔ 30 TỶ (v12.47.588):',
    '  • Miễn Trừ Doanh Thu Trong Ca (getEffectiveHoardCash): Khi đang mở bán trong ca hoặc lúc chốt sổ cuối ngày (finishEndDay), hệ thống an ninh két CHỈ xét lượng tiền mặt tồn từ ĐẦU CA (startCash). Toàn bộ doanh thu kiếm được trong ca hôm đó (3 Tỷ - 5 Tỷ+ từ Quầy chính, Hợp đồng Tiệc, Sảnh Trà, Chi nhánh & Nhượng quyền) được miễn trừ 100% để chủ quán thoải mái sang ngày mới gửi vào Tà Tưa Bank.',
    '  • Nâng Trần Két Tiền Mặt An Toàn (3 Tỷ ➔ 30 Tỷ): Nâng ngưỡng két an toàn khởi điểm từ 3 Tỷ (Ngày 1) cộng thêm +20 Triệu/ngày (hoặc 1.5x kỷ lục doanh thu ngày) lên tối đa 30 Tỷ; mốc cảnh báo trung bình tối thiểu từ 6 Tỷ trở lên.',
    '  • Triệt Tiêu Phạt Nhầm & Tự Động Khôi Phục Chuỗi (loadFrom): Gỡ bỏ cơ chế dùng cờ _shadowbanned/_banned để kích hoạt phạt két (isVerifiedHoardCheater), đồng thời tự động khôi phục các Chi nhánh / Nhượng quyền từng bị đóng cửa oan khi tải game.',
    '  • Đồng bộ Triple-Version Parity v12.47.588 giữa game.js, version.json và index.html theo GEMINI.md.'
  ]},
  {v:'12.47.587',d:'15/10/2026',items:[
    '📈 NÂNG TRẦN DOANH THU NGÀY & TRẦN KÉT TIỀN MẶT AN TOÀN TĂNG ĐỘNG THEO NGÀY CHƠI (v12.47.587):',
    '  • Trần Doanh Thu Ngày Tăng Động Theo Ngày Chơi: Đơn giá trần ngày tự động mở rộng từ 300.000đ/ly (Ngày 1) cộng thêm +60đ/ly mỗi ngày lên tối đa 420.000đ/ly (Ngày 2.000+), kết hợp cùng trần sản lượng 7.000 ly/ngày nâng Trần Doanh Thu Ngày tối đa lên 2,94 Tỷ/ngày (~3 Tỷ/ngày).',
    '  • Trần Két Tiền Mặt An Toàn Tăng Động Theo Ngày Chơi: Mở rộng ngưỡng két an toàn từ 2 Tỷ (Ngày 1) cộng thêm +10 Triệu/ngày lên tối đa 20 Tỷ (Ngày 1.801+), đồng thời giãn nở tương ứng 4 tầng cảnh báo an ninh két (An toàn ➔ Trung bình ➔ Cao ➔ Siêu cấp) giúp chủ quán kỳ cựu thoải mái giữ vốn lưu động lớn mà không lo bị phạt nhầm.',
    '  • Đồng Bộ Anti-Cheat 3 Lớp (Client - Admin Tool - Supabase SQL): Cập nhật công thức trần đơn giá ngày động vào bộ chấm điểm Rule 3 và giữ tương thích 100% với ràng buộc CHECK (420k/ly) trên PostgreSQL.',
    '  • Đồng bộ Triple-Version Parity v12.47.587 giữa game.js, version.json và index.html theo GEMINI.md.'
  ]},
  {v:'12.47.586',d:'15/10/2026',items:[
    '💰 NÂNG GIÁ TRẦN ĐƠN GIÁ NGÀY LÊN 300.000Đ/LY & ĐỒNG BỘ ANTI-CHEAT v12.47.586:',
    '  • Nâng Trần Đơn Giá Ngày (300.000đ/ly): Mở rộng trần doanh thu ngày hợp lệ từ 255k/ly lên 300k/ly để phản ánh trọn vẹn giá trị Sảnh Trà Thượng Lưu, Hợp đồng Tiệc, Quản Gia, Pet Shiba/Mèo và Cáp Pi, giúp phân hóa rõ bảng xếp hạng DT Ngày và Ly Ngày.',
    '  • Chuẩn Hóa Thang Điểm Anti-Cheat Rule 3: Đồng bộ ngưỡng đơn giá ngày trên cả Client, Admin Tool và Supabase SQL Trigger (<= 300k/ly đạt 0 điểm Hợp lệ tuyệt đối; > 300k/ly +15; > 360k/ly +25; > 420k/ly +50 Ẩn BXH; > 600k/ly +100 Ban).',
    '  • Khắc Phục Nút Đồng Bộ BXH & Tối Ưu Trigger SQL: Sửa lỗi ghi sớm biến cooldown làm nghẽn nút Đồng bộ thủ công (#lbSyncBtn); nâng trần ngày lên 10.000 ngày và ép kiểu bigint chống tràn số 32-bit trên PostgreSQL.',
    '  • Đồng bộ Triple-Version Parity v12.47.586 giữa game.js, version.json và index.html theo GEMINI.md.'
  ]},
  {v:'12.47.569',d:'14/10/2026',items:[
    '🗺️ ĐẠI TU CÂN BẰNG 12 ĐỊA ĐIỂM KHỞI NGHIỆP & HỆ THỐNG NÂNG CẤP ĐẾ CHẾ VÙNG MIỀN (CẤP 1 ➔ CẤP 5):',
    '  • Nâng Cấp Đế Chế Khởi Nghiệp 5 Cấp: Từ Quán Khởi Đầu (Cấp 1) lên Biểu Tượng Quốc Gia (Cấp 5), khuếch đại toàn bộ Buff vùng miền lên tới 2.10x và xóa bỏ hoàn toàn 100% điểm trừ / thách thức địa phương ở Cấp 5.',
    '  • Tái Cân Bằng 12 Tỉnh Thành & Đảo Hoàng Sa: Tăng sức mạnh đặc sản vùng miền (Huế +25% giá trà lá & +15% cơ hội lên 5★, Buôn Ma Thuột giảm 15% giá vốn trà/sữa, Cần Thơ giảm 25% giá vốn topping, Vũng Tàu giảm phạt ngày thường, Cà Mau giảm 50% phạt mưa bão, Hoàng Sa tăng trợ cấp theo cấp Đế Chế...).',
    '🐕 TÁI CÂN BẰNG THÚ CƯNG: TÓ SHIBA VÀNG (ĐẠI SỨ QUÁN CHÍNH) VS. MÈO MƯỚP CHIÊU TÀI (BÀ TRÙM ĐẾ CHẾ CHUỖI):',
    '  • Tó Shiba Vàng (Bá Chủ Quán Chính, Đông Khách, Sảnh Trà & Bảo Vệ): Tăng hóa đơn quán chính (+15% ➔ +65%), Tiền bo (+18% ➔ +85%), Lượng khách ghé quán (+20% ➔ +50%), Thưởng Hợp Đồng Tiệc & Sảnh Trà (+15% ➔ +35%), Vệ sĩ giữ quán (-60% tiền giả/giật két/khách quỵt), Khách kiên nhẫn độc quyền (+20% thời gian chờ, gấp đôi thời gian đợi hết món 9.0s) & +12% cơ hội nâng đánh giá 4★ lên 5★.',
    '  • Mèo Mướp Chiêu Tài (Nữ Hoàng Đế Chế Chuỗi & Nhượng Quyền): Tăng doanh thu Chi nhánh (+20% ➔ +45%), Phí bản quyền Royalty Nhượng quyền (+15% ➔ +35%), giảm 50% nguy cơ chi nhánh thua lỗ phá sản, cùng buff hóa đơn (+12% ➔ +45%) & tiền bo (+15% ➔ +55%).',
    '  • Đồng bộ Triple-Version Parity v12.47.569 giữa game.js, version.json và index.html theo GEMINI.md.'
  ]},
  {v:'12.47.553',d:'14/10/2026',items:[
    '🎓 HỌC VIỆN ĐÀO TẠO NHÂN VIÊN (STAFF TRAINING LV.1 ➔ LV.5) & PHỤ PHÍ +1% DOANH THU KPI:',
    '  • Hệ Thống Chứng Chỉ Nghề Nghiệp 5 Cấp: Đào tạo từng nhân viên từ Học Việc Nâng Cao (Lv.1) lên Đại Sư Tinh Hoa (Lv.5) bằng Tiền mặt + Sao 5★ tích lũy.',
    '  • Khắc Phục Tật Xấu & Mở Kỹ Năng Ultimate: Giảm 25%/cấp tật xấu (xóa 100% ở Lv.4) và mở khóa Kỹ năng Đặc quyền ở Lv.5 (Gen Z miễn nhiễm dỗi/đá bill +10% Tip, Sinh viên không bán đồ + Auto Upsize L 5★, Đi chợ 0% khai gian + giảm 20% hóa đơn, Bảo vệ làm xuyên ngày thứ 4 không cần ngủ...).',
    '  • Cơ Chế Đánh Đổi +1% Doanh Thu KPI / Cấp Đào Tạo: Mỗi cấp Training cộng thêm +1% tổng doanh thu chu kỳ 7 ca vào tiền thưởng KPI phải trả (từ 0.5% gốc lên tối đa 5.5% ở Cấp 5), áp dụng đồng bộ cho cả xét duyệt thủ công lẫn Quản Gia tự động thanh toán.',
    '  • Đồng bộ lưu trữ mã sao lưu rút gọn (TTN2/TTN3) và Triple-Version Parity v12.47.553 theo GEMINI.md.'
  ]},
  {v:'12.47.545',d:'13/10/2026',items:[
    '🏮 NÚT TRỰC TIẾP QUAY LẠI SẢNH (VỪA BÁN VỪA NÂNG CẤP) & CẢNH BÁO HẠN CHÓT KPI:',
    '  • Nút Trực Tiếp Về Sảnh (🏮): Bổ sung nút lồng đèn trực tiếp trên thanh công cụ bán hàng, cho phép chủ tiệm quay lại sảnh chuẩn bị bất cứ lúc nào trong ca để mua nguyên liệu, nâng cấp quán hoặc gửi ngân hàng.',
    '  • Giữ Nguyên Mốc Thời Gian Ca Bán: Khi quay lại sảnh, game bảo lưu chính xác thời gian thực của ca (ví dụ 11:05) thay vì bị reset về 11:00. Nút dưới sảnh hiển thị rõ \"▶ Tiếp tục ca bán (11:05 · Còn Xs)\" và tiếp tục trơn tru mốc thời gian đó khi bấm vào.',
    '  • Khóa An Toàn Chuyển Điểm Khởi Nghiệp: Khóa tính năng dọn quán/chuyển địa điểm tỉnh thành khi đang trong ca bán để tránh làm xung đột trạng thái bàn khách và hiệu ứng vùng miền.',
    '  • Banner Cảnh Báo Hạn Chốt KPI 7 Ngày: Tự động tính toán ước tính tiền thưởng KPI (~X đ) và hiển thị banner cảnh báo tại Sảnh khi đến ngày 6-7, nhắc nhở chủ quán dự trữ tiền két hoặc rút từ Tà Tưa Bank để tránh nhân viên đình công.',
    '  • Đồng bộ Triple-Version Parity v12.47.545 theo GEMINI.md.'
  ]},
  {v:'12.47.544',d:'13/10/2026',items:[
    '🛡️ KHẮC PHỤC TRIỆT ĐỂ BUG BÁN HÀNG TÀNG HÌNH & TÍNH NĂNG TẠM DỪNG VỀ SẢNH / CẤT TIỀN BANK:',
    '  • Khắc Phục Triệt Để Bug Ghost Selling Loop (Bán Hàng Tàng Hình): Chặn đứng vĩnh viễn lỗ hổng khôi phục bản sao lưu cũ giữa ca bán khiến vòng lặp bán ngầm tick() tiếp tục chạy trong sảnh gây cộng dồn tiền và vượt ngày không tốn chi phí.',
    '  • Khóa An Toàn Đa Tầng stopShift(): Tự động dừng sạch sẽ timer bán hàng, hàng đợi khách, reset trạng thái khi khôi phục dữ liệu hoặc chơi lại từ đầu.',
    '  • Tính Năng Mới: Tạm Dừng Ca & Về Sảnh Chuẩn Bị (Pause To Prep): Cho phép người chơi tạm dừng ca bán giữa chừng để về sảnh mua nguyên liệu, nâng cấp quán hoặc quản lý cửa hàng mà không bị mất tiến trình ca.',
    '  • Thanh Điều Khiển Nổi & Nút Trở Lại Ca Bán: Banner thông báo thời gian còn lại của ca bán và nút to màu xanh ' + '\"▶ Trở lại ca bán ngày X\"' + ' giúp quay lại quầy phục vụ khách bất cứ lúc nào.',
    '  • Nút Cất Tiền Tà Tưa Bank Nhanh: Bổ sung tùy chọn gửi tiền vào ngân hàng ngay trong popup tạm dừng hoặc sảnh, bảo vệ két tiền an toàn 100% trước nguy cơ bị trộm cướp, giật két hoặc khách trả tiền giả.',
    '  • Đồng bộ Triple-Version Parity v12.47.544 theo GEMINI.md.'
  ]},
  {v:'12.47.543',d:'13/10/2026',items:[
    '🏰 MIỄN PHÍ HOÀN TOÀN MẶT BẰNG & ĐIỆN NƯỚC KHI MUA ĐỨT BẤT ĐỘNG SẢN:',
    '  • Miễn trừ 100% tiền thuê mặt bằng (0đ/ngày) và chi phí điện nước vận hành chuỗi khi mua đứt mặt bằng chi nhánh.',
    '  • Khắc phục triệt để lỗi cộng dồn chi phí mặt bằng & điện nước Flagship (4.5% và 2.5%) khi đã sở hữu Sổ Đỏ Flagship.',
    '  • Chuẩn hóa hiển thị tab Chi Nhánh và báo cáo P&L cuối ca rõ ràng: \"Đã mua đứt BĐS (0đ)\".',
    '  • Đồng bộ Triple-Version Parity v12.47.543 theo GEMINI.md.'
  ]},
  {v:'12.47.542',d:'13/10/2026',items:[
    '🏆 KHẮC PHỤC LỖI XÁC THỰC BẢNG XẾP HẠNG & NẠP 50 CAO THỦ SERVER:',
    '  • Sửa lỗi NaN trong chữ ký HMAC SHA-256 xác thực khi tải/gửi điểm Bảng Xếp Hạng.',
    '  • Nạp sẵn 50 cao thủ hàng đầu toàn quốc vào bộ đệm SEED_LEADERBOARD hiển thị ngay cả khi offline.',
    '  • Thiết lập proxy Cloudflare /api/* trong file cấu hình _redirects.',
    '  • Đồng bộ Triple-Version Parity v12.47.542 theo GEMINI.md.'
  ]},
  {v:'12.47.541',d:'13/10/2026',items:[
    '⭐ ĐẠI TU CƠ CHẾ SAO 5★ & NÂNG TRẦN DANH VỌNG BẢNG XẾP HẠNG (ANTI-CHEAT 2.0):',
    '  • Nâng Trần Sao Danh Vọng Thích Ứng Meta Hiện Đại: Nâng trần kiểm soát từ công thức cũ (4.500 sao) lên tối đa 80.000 sao theo công thức min(80000, 200 + Ngày * 250). Bao trọn hoàn toàn năng lực cày cuốc đỉnh cao của người chơi bán 1.000+ ly/ngày farm 200 sao/ngày (như Ngày 386 đạt 20k - 50k sao hoàn toàn hợp lệ).',
    '  • Cơ Chế Kiểm Soát Trần Thời Gian Thực (Real-time Ceiling Guard): Khi đạt trần sao tối đa trong ngày, game tự động chốt chặn an toàn và thông báo rõ ràng cho người chơi, tuyệt đối chấm dứt hiện tượng sao tăng trong ca bán nhưng bị kéo tụt khi F5 / tải lại trang.',
    '  • Khôi Phục & Bảo Toàn Trọn Vẹn Sao Người Chơi: Nâng cấp bộ lọc nạp bản sao lưu (normalizeBackupData) và bảng xếp hạng, loại bỏ hoàn toàn tình trạng ném lỗi Anti-Cheat oan hoặc gọt sao về 3697.',
    '  • Mở Rộng Hạn Mức Server Cloudflare Worker: Đồng bộ trần safeStar5 lên 80.000 sao trên toàn bộ hệ thống máy chủ Bảng Xếp Hạng.',
    '  • Đồng bộ Triple-Version Parity v12.47.541 theo GEMINI.md.'
  ]},
  {v:'12.47.534',d:'12/10/2026',items:[
    '🚀 ĐỒNG BỘ THỜI GIAN THỰC & CHỐNG NGHẼN BẢNG XẾP HẠNG SERVER:',
    '  • Cơ chế Đồng bộ Thông minh: Triệt tiêu tình trạng spam gửi điểm làm cạn hạn ngạch Cloudflare KV (1.000 lượt/ngày). Chỉ tự động gửi ngầm khi PHÁ KỶ LỤC CÁ NHÂN (giãn cách tối thiểu 10 phút).',
    '  • Nút Đồng bộ Có Hồi Chiêu 5 Phút: Hiển thị thời gian đếm ngược chính xác, phản hồi cảnh báo rõ ràng khi máy chủ quá tải và chỉ cập nhật dữ liệu khi máy chủ xác nhận thành công.',
    '  • Bộ Lọc Thông Minh Phía Worker: Bỏ qua lệnh ghi đè KV nếu dữ liệu không có điểm cải thiện hoặc gửi liên tiếp dưới 2 phút, tiết kiệm 80% hạn ngạch server.',
    '  • Đồng bộ Triple-Version Parity v12.47.534.'
  ]},
  {v:'12.47.533',d:'12/10/2026',items:[
    '🛡️ BẢO MẬT CẤP CAO ĐA TẦNG & CHỐNG HACK TOÀN DIỆN:',
    '  • Mở trần Đột phá Cấp 100 (Level Cap 100): Kẹp trần và hỗ trợ nâng cấp tới Level 100; tiêu tốn 1 Tỉ VNĐ + 10% két tiền + 10% tổng sao tích lũy (min 50⭐) cho các cấp > 50.',
    '  • Tỷ lệ kiểm tra bất thường (Sanity Ratio): Đối soát số ly kỷ lục động theo công thức min(5000, 300 + Ngày * 2), mở khóa cho tiệm lâu năm vượt trần 600 ly an toàn tuyệt đối.',
    '  • Kẹp trần giá bán đơn online 85.000đ/ly: Đồng bộ giá bán đơn online với quán chính, chặn đứng nguy cơ lạm phát doanh số ảo.',
    '  • Phân lập độc lập Tab ⭐ 1 Sao: Tách bạch hoàn toàn đánh giá 1 sao (oneStarReviews) trên BXH với quỹ sao 5★ tích lũy (S.star5Count).',
    '  • Chữ ký HMAC SHA-256 bảo vệ POST /leaderboard/submit và Triple-Version Parity v12.47.533.'
  ]},
  {v:'12.47.524',d:'12/10/2026',items:[
    '🏆 BẢNG XẾP HẠNG TOÀN SERVER (CỘNG ĐỒNG TOÀN QUỐC):',
    '  • Khắc phục triệt để lỗi chỉ hiện 1 người chơi: Tích hợp đầy đủ mạng lưới Top Tiệm Trà toàn Server từ Hà Nội, TP.HCM, Đà Nẵng, Cần Thơ, Hải Phòng, Đà Lạt...',
    '  • Hiển thị trọn vẹn Bục Vinh Danh Top 1-3 và Top 4-10 cùng bộ khung viền vương miện hoàng gia frames cao cấp.',
    '  • Đồng bộ 2 chiều dữ liệu người chơi thật và mạng lưới Server khi triển khai trên tensorship.tech.'
  ]},
  {v:'12.47.523',d:'12/10/2026',items:[
    '🏆 KHUNG VIỀN TOP BẢNG XẾP HẠNG (FRAMES):',
    '  • Tích hợp bộ khung viền cao cấp độc quyền (img/frames/) cho Bảng xếp hạng toàn Server.',
    '  • Top 1-3 vinh danh theo từng tiêu chí: top-revenue-1..3 (Lợi nhuận), top-days-1..3 (5 Sao ⭐), top-store-1..3 (Ly bán 🧋).',
    '  • Top 4-10 nhận khung vương miện VIP độc quyền (vip-04..vip-10).',
    '🛵 BỔ SUNG AVATAR SHIPPER MỚI (SHIP2.WEBP):',
    '  • Bổ sung 4 diện mạo shipper phong cách mới từ ship2.webp, mở rộng tổng số shipper lên 6 nhân vật đa dạng cho các app giao hàng.',
    '🏮 NÂNG CẤP BÀN GHẾ & SẢNH TIỆM TOÀN DIỆN:',
    '  • Mở rộng 6 bàn ghế mỗi phòng (tổng 24 bàn trên 4 phòng sảnh), tích hợp trọn bộ hình ảnh bàn ghế phong cách riêng từng phòng (Classic, Soft Pastel, Solid Wood, Royal).',
    '  • Hệ thống nâng cấp chuyên sâu Sảnh Tiệm: Tăng lưu lượng khách vào sảnh (+15%/cấp), Tối ưu xoay vòng bàn nhanh (giảm % khách ngồi lại 12%/cấp), và Nghệ thuật bo sảnh (tăng +25%/cấp tiền bo).',
    '  • Phân tách rành mạch doanh thu bán lẻ tại quầy và Doanh thu Sảnh Tiệm (+30%) cùng Tiền bo sảnh trong sổ cái P&L và tổng kết ca.'
  ]},
  {v:'12.47.522',d:'12/10/2026',items:[
    '❄️ QUY CHUẨN TỦ LẠNH CHỈ BẢO QUẢN ĐÁ VIÊN & GIỮ NGUYÊN HẠN DÙNG CÁC NGUYÊN LIỆU KHÁC:',
    '  • Tủ Lạnh Chỉ Bảo Quản Duy Nhất Đá Viên: Trang bị Tủ lạnh (❄️) chỉ áp dụng bảo quản vĩnh viễn cho Đá viên. Mọi nguyên liệu khác (Trà, Hương siro, Topping...) không được tủ lạnh bảo quản mà vẫn tính hạn sử dụng và hết hạn bình thường theo ngày.',
    '  • Duy Trì Tỉ Lệ Khách Chuộng Hương 85%: Tiếp tục giữ tỉ lệ 85% khách hàng thích gọi hương vị trái cây giúp đẩy nhanh lượng hương bán ra trong ngày, giải quyết triệt để vấn đề tồn đọng hương.',
    '  • Giữ Vững Bộ Quy Tắc Bất Biến: Tuyệt đối giữ nguyên tính toàn vẹn kinh tế, cơ chế tiền bo, KPI và tốc độ pha chế của nhân viên theo GEMINI.md.'
  ]},
  {v:'12.47.521',d:'12/10/2026',items:[
    '🍓 CÂN BẰNG TIÊU THỤ HƯƠNG (SIRO TRÁI CÂY) & TỦ LẠNH BẢO QUẢN TOÀN DIỆN:',
    '  • Tăng Tỉ Lệ Khách Chọn Hương Lên 85%: Nâng tỉ lệ khách gọi kèm hương siro trái cây từ 60% lên 85%, giúp giải phóng lượng hương tồn kho nhanh chóng, kích cầu tiêu thụ và tăng doanh thu từ các món trà trái cây.',
    '  • Tủ Lạnh Bảo Quản Hương Vĩnh Viễn: Trang bị Tủ lạnh (❄️) giờ đây bảo quản toàn diện cả Đá, Trà, Topping và toàn bộ các chai Hương (siro). Không còn nỗi lo chai hương hết hạn 7 ngày bị hủy bỏ hao hụt chi phí.',
    '  • Hiển Thị Trực Quan: Thẻ hạn sử dụng của Hương trong Kho và Nâng cấp hiển thị rõ ràng \"Tủ lạnh bảo quản vĩnh viễn (♾)\" khi quán sở hữu Tủ lạnh.',
    '  • Giữ Vững Bộ Quy Tắc Bất Biến: Tuyệt đối giữ nguyên tính toàn vẹn kinh tế, cơ chế tiền bo, KPI và tốc độ pha chế của nhân viên theo GEMINI.md.'
  ]},
  {v:'12.47.520',d:'12/10/2026',items:[
    '✨ TINH GỌN GIAO DIỆN BẢNG XẾP HẠNG TOÀN SERVER:',
    '  • Loại Bỏ Hoàn Toàn Các Dòng Chữ Thông Báo Thừa: Bỏ hoàn toàn các dòng banner nhắc lại về tài khoản ảo / người chơi thật trên Bảng Xếp Hạng theo đúng yêu cầu, giữ giao diện sạch sẽ, chuyên nghiệp và tối giản.',
    '  • Tối Ưu Độ Cao & Trực Quan: Dành trọn vẹn không gian hiển thị cho Bục Vinh Danh và Danh Sách Thứ Hạng của các chủ tiệm.',
    '  • Giữ Vững Bộ Quy Tắc Bất Biến: Tuyệt đối giữ nguyên tính toàn vẹn kinh tế, cơ chế tiền bo, KPI và tốc độ pha chế của nhân viên theo GEMINI.md.'
  ]},
  {v:'12.47.519',d:'12/10/2026',items:[
    '📱 TỐI ƯU TOÀN DIỆN GIAO DIỆN BẢNG XẾP HẠNG - KHẮC PHỤC TRIỆT ĐỂ LỖI BỊ CHE KHÔNG ĐẦY ĐỦ:',
    '  • Cố Định Tiêu Đề & Tabs Trên Cùng (Sticky Header): Tiêu đề Bảng Xếp Hạng và 3 Tab chuyển đổi được ghim cố định ở đỉnh Modal, không bao giờ bị cuộn trôi mất khi xem các thứ hạng thấp hơn; bổ sung nút đóng nhanh (✕) ở góc trên bên phải.',
    '  • Tối Ưu Bục Vinh Danh Di Động (Non-Clipping Responsive Podium): Tinh chỉnh chiều rộng và tỉ lệ bục Top 1-2-3 linh hoạt 100% theo màn hình điện thoại, chống hoàn toàn tình trạng bục Top 2 (trái) và Top 3 (phải) bị tràn mép cắt mất chữ và huy hiệu.',
    '  • Cuộn Độc Lập Mượt Mà & Chân Trang Cố Định (Fixed Footer): Chỉ vùng nội dung danh sách xếp hạng ở giữa cuộn mượt mà; thanh \"Hạng của bạn\" và nút \"Đóng\" lớn luôn hiển thị vững chắc ở chân modal, không còn bị cắt nửa dòng hay che khuất danh sách.',
    '  • Giữ Vững Bộ Quy Tắc Bất Biến: Tuyệt đối giữ nguyên tính toàn vẹn kinh tế, cơ chế tiền bo, KPI và tốc độ pha chế của nhân viên theo GEMINI.md.'
  ]},
  {v:'12.47.518',d:'12/10/2026',items:[
    '🏆 BẢNG XẾP HẠNG 100% NGƯỜI CHƠI THẬT (TENSERSHIP.TECH):',
    '  • Xóa Bỏ Hoàn Toàn 100% Bot/Tài Khoản Ảo: Loại bỏ triệt để danh sách dữ liệu hạt giống (seed bots) khỏi hệ thống bảng xếp hạng ở cả client và backend worker. Bảng xếp hạng giờ đây chỉ ghi nhận và vinh danh những người chơi thật đang vận hành tiệm trà trên http://tiemtramouoc.tensorship.tech.',
    '  • Bục Vinh Danh & Giao Diện Linh Hoạt (Dynamic Podium): Bục vinh danh Top 1-2-3 tự động điều chỉnh hiển thị mượt mà dù bảng xếp hạng có 1, 2 hay hàng trăm người chơi thật; tích hợp huy hiệu chứng thực người chơi thật và trạng thái xếp hạng tức thì.',
    '  • Cơ Chế Đồng Bộ & Dự Phòng Đa Tuyến Thông Minh: Tự động điều hướng giữa API domain tensorship.tech và Cloudflare Worker dự phòng, chống lỗi khi máy chủ tĩnh trả về trang HTML; lưu trữ bộ nhớ người chơi thật an toàn.',
    '  • Giữ Vững Bộ Quy Tắc Bất Biến: Tuyệt đối giữ nguyên tính toàn vẹn kinh tế, cơ chế tiền bo, KPI và tốc độ pha chế của nhân viên theo GEMINI.md.'
  ]},
  {v:'12.47.517',d:'12/10/2026',items:[
    '⚖️ CHUẨN HÓA CÔNG THỨC 5 SAO KHOA HỌC & BẢO VỆ CÔNG BẰNG BẢNG XẾP HẠNG:',
    '  • Khóa Chặt Lỗ Hổng Cheat Sao Bảng Xếp Hạng: Thay thế hoàn toàn trần lỏng bằng công thức kiểm định khoa học đa tầng gắn liền với tiến trình chơi thực tế: maxFeasibleStar5 = Math.min(4500, 30 + dayNum * 9.5). Cheater hoàn toàn không thể lợi dụng ngày thấp để bơm hàng ngàn sao.',
    '  • Bảo Vệ Tuyệt Đối Người Chơi Tích Lũy 5 Sao Chân Chính: Người chơi tích lũy tự nhiên (như Ngày 156 x1133 sao) đạt tỉ lệ xuất sắc ~7.26 sao/ngày, hoàn toàn nằm trong biên độ an toàn (< 1512 sao) và khôi phục 100% trơn tru.',
    '  • Lọc Dữ Liệu Leaderboard & Chống Hack Điểm Online: Cơ chế tự động kẹp trần công bằng cả khi hiển thị và trước khi gửi điểm lên server (/leaderboard/submit), ngăn chặn triệt để tình trạng cheater chiếm Top 1 Bảng Xếp Hạng.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và tuân thủ các nguyên tắc P&L, dòng tiền và tốc độ phục vụ theo GEMINI.md.'
  ]},
  {v:'12.47.516',d:'12/10/2026',items:[
    '🛡️ SỬA LỖI BẢO VỆ KÉT TIỀN (< 2 TỶ) & NÂNG TRẦN 5 SAO ANTI-CHEAT (TÍCH LŨY TỰ NHIÊN):',
    '  • Khắc Phục Triệt Để Sự Cố Cạy Két Khi Két Dưới 2 Tỷ: Tuyệt đối không kích hoạt trộm cạy két hay trừ tiền khi số tiền mặt thực tế trong két dưới 2 tỷ đồng. Hệ thống tự động phát hiện, thu hồi và hoàn trả 100% số tiền bị trừ nhầm về két quán nếu file lưu cũ có sự cố ảo.',
    '  • Nâng Trần Tích Lũy 5 Sao Chân Chính (Anti-Cheat): Người chơi chân chính tích lũy số lần 5 Sao tự nhiên qua nhiều ngày (do không/ít dùng để mở gói sưu tầm Pack) được bảo vệ tuyệt đối. Trần kiểm tra được mở rộng lên Math.max(5000, dayNum * 40), khôi phục trơn tru các bản lưu x1000+ sao ở ngày 156+ mà không bị chặn.',
    '  • Tự Động Làm Sạch & Phục Hồi An Toàn: Tự động loại bỏ mọi cờ sự cố trộm két bất hợp lý trong cả bản chính và bản sao lưu, giữ an toàn tuyệt đối cho dòng tiền tiệm.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và tuân thủ các nguyên tắc P&L, dòng tiền và tốc độ phục vụ theo GEMINI.md.'
  ]},
  {v:'12.47.506',d:'11/10/2026',items:[
    '🤵 CƠ CHẾ QUẢN GIA TỪ CHỐI TIP & HIỂN THỊ TỐC ĐỘ PHA CHẾ KPI:',
    '  • Nhân Viên Từ Chối Tip Nhường Chủ (Quản Gia): Khi có Quản gia, nhân viên có 35% xác suất từ chối 20% tiền bo để nhường trọn vẹn 100% tiền bo vào két chủ tiệm.',
    '  • Hiển Thị % Giảm Tốc Độ Pha Chế Ở KPI: Bổ sung chỉ số giảm tốc độ pha trên thanh tổng quan KPI, dải avatar, bảng đánh giá chi tiết và hiển thị xem trước chỉ số sau khi xét duyệt.',
    '  • Tự Động Hóa Chuẩn F&B G&A: Giai đoạn đầu mặc định chế độ Casual (0đ phí văn phòng chuỗi), tự động kích hoạt chi phí G&A khi đạt quy mô từ 3 cơ sở trở lên, ẩn nút cài đặt thủ công.',
    '  • Khắc Phục Lỗi Nhân Viên Dừng Pha Chế Ca 6h: Đảm bảo nhân viên pha chế liên tục tới hết ca mà không bị reset hàng đợi ly giữa chừng.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và tuân thủ các nguyên tắc P&L, dòng tiền và tốc độ phục vụ theo GEMINI.md.'
  ]},
  {v:'12.47.503',d:'11/10/2026',items:[
    '🛵 NÂNG CẤP TỶ LỆ ĐƠN ONLINE & TINH CHỈNH GIAO DIỆN HÀNG CHỜ KHÔNG BỊ CHE:',
    '  • Tối Ưu Hóa Tỷ Lệ Đơn Online (App Delivery): Tăng sức chứa tối đa đơn online (onCap), tính chuẩn hệ số cộng hưởng nhiều ứng dụng (onMul), rút ngắn chu kỳ sinh đơn online từ 22-30s xuống 7.5-11.5s (giãn cách tối thiểu 1.6-2.2s). Khởi đầu ca chỉ sau 2s đã có đơn đầu tiên.',
    '  • Cơ Chế Đơn Hàng Giao Nhiều Ly (Multi-cup Delivery): Thêm 35% tỉ lệ phát sinh đơn 2 ly cùng lúc (lên tới 55% khi kích hoạt Shipper Thần Tốc), mở rộng khả năng tạo đơn thử lại (retry 3 lần) chống hụt đơn do nguyên liệu tạm thời thiếu.',
    '  • Khắc Phục Triệt Để Khung Avatar Đơn Online Bị Che: Điều chỉnh vị trí hàng chờ 2 tầng (.q3lane) xuống dưới rèm mái hiên quầy (top: 76px, height: 104px), tách biệt hoàn toàn khỏi các nút điều khiển đỉnh và mái hiên xanh-trắng.',
    '  • Tối Ưu Tọa Độ Khung Avatar Khách & Bong Bóng Thoại: Cân chỉnh .q3face và .q3bub xuống top: 187px, tạo khoảng đệm thoáng đãng 7px so với thanh hàng chờ, hiển thị trọn vẹn 100% không bị che khuất.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.502',d:'11/10/2026',items:[
    '🤵 TỰ ĐỘNG ĐƯA VỀ GIÁ TỐI ƯU LÃI & GIÁ AN TOÀN ĐỈNH QUẢN GIA:',
    '  • Khắc Phục Triệt Để Lỗi 45k Vượt Trần Quản Gia: Sửa lỗi công thức nhân dồn +50% khiến món buff (như Xoài) bị vọt lên 45k và báo "vượt trần Quản gia". Nay 3 món nhận buff ngẫu nhiên luôn được khống chế chuẩn xác ở giá an toàn đỉnh Buff (Topping/Trái cây/Hương: 30k; Trà: 60k; Matcha: 75k; Size L: 30k).',
    '  • Tự Động Thiết Lập Giá Tối Ưu Lãi Khi Reset Ngày: Mỗi khi sang ngày mới, Quản gia tự động đưa toàn bộ các món không buff (hoặc hết buff từ hôm qua) về mức giá an toàn đỉnh tối ưu lãi chuẩn F&B (Topping/Trái cây/Hương: 20k; Trà: 40k; Matcha: 50k; Size L: 20k).',
    '  • 100% Khách Hài Lòng & Không Chê Đắt: Quản gia bảo chứng giá tuyệt đối, xóa bỏ hoàn toàn các cảnh báo "đắt/khách chê mắc" và "vượt trần", tối đa hóa doanh thu và lợi nhuận cho quán.',
    '  • Tự Động Phục Hồi & Làm Sạch Dữ Liệu Lưu Cũ: Tự động phát hiện và hạ ngay các món đang bị lưu giá vượt trần 45k về chuẩn an toàn đỉnh ngay khi nạp game hoặc mở cài đặt giá.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.501',d:'11/10/2026',items:[
    '✨ PHÂN TÁCH GIAO DIỆN HÀNG CHỜ KHÁCH 2 TẦNG (ONLINE & TẠI QUẦY):',
    '  • Hàng 1 (Trên - Tím Pastel): Chuyên dành riêng cho các đơn đặt giao hàng Online (🛵 Online), cuộn ngang độc lập, có nhãn chỉ thị số lượng đơn online đang chờ.',
    '  • Hàng 2 (Dưới - Xanh Lục Pastel): Chuyên dành cho khách mua trực tiếp tại quầy quán (🧋 Tại quầy), cuộn ngang độc lập, không còn bị đơn online dồn ép hay che khuất.',
    '  • Thiết Kế Tinh Chỉnh Chuẩn Giao Diện Mobile: Kích thước avatar thu gọn vừa vặn, không đè lên mái hiên (awning) phía trên và không đè lên khung đối thoại nhân vật bên dưới.',
    '  • Tương Tác & Hiệu Ứng Hoàn Hảo: Giữ trọn vẹn vòng đếm thời gian kiên nhẫn, bong bóng cảnh báo/phục vụ của nhân viên, click chọn khách mượt mà.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.500',d:'11/10/2026',items:[
    '🛡️ BẢN VÁ BẢO MẬT & HỆ THỐNG PHÒNG THỦ CHỐNG GIAN LẬN (ANTI-CHEAT SUITE V2):',
    '  • Vô Hiệu Hóa Triệt Để Tool Hack Bên Thứ Ba (Catvio Tools): Cập nhật mã băm bảo mật đa tầng (BAK_SALT_V2), kích hoạt cơ chế nhận diện chữ ký giả mạo và từ chối 100% các file save được can thiệp sửa đổi trái phép.',
    '  • Bộ Lọc Kiểm Định Tính Toàn Vẹn Đa Chiều (Plausibility Validation): Chặn đứng việc can thiệp bơm tiền ảo (hàng chục ngàn tỉ), bơm 5 sao vô hạn (1.000.000 sao) và tạo chi nhánh ma (hàng triệu chi nhánh) bằng các trần kiểm soát logic chặt chẽ.',
    '  • Triệt Tiêu Chiêu Trò Né Trộm CheatHit: Cắt bỏ vĩnh viễn việc dùng cấp Trang Bị (equipRed) để giữ lại tiền gian lận khi phát hiện cheat két.',
    '  • Bảo Vệ Tuyệt Đối Người Chơi Chân Chính: Tương thích ngược an toàn cho toàn bộ mã sao lưu và file tiến trình hợp lệ từ các phiên bản trước.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.499',d:'11/10/2026',items:[
    '✨ TỐI ƯU TRẦN GIÁ AN TOÀN QUẢN GIA CHO MÓN ĐƯỢC BUFF (+50%):',
    '  • Sửa Lỗi Ngược Đời Trần Giá Quản Gia: Khắc phục triệt để tình trạng món được Quản gia Buff tăng giá +50% (như Trân châu trắng) bị khống chế tối đa chỉ 12k, trong khi món bình thường không buff (như Trân châu 3Q) lại được đặt tới 20k.',
    '  • Mở Rộng Trần An Toàn Cho Món Buff: Món được Quản gia bảo chứng buff +50% được nâng trần cho phép linh hoạt (tối thiểu bằng trần chuẩn 20k và mở rộng lên đến 30k cho topping / 60k cho trà), giúp chủ quán thoải mái tối ưu doanh thu và lợi nhuận.',
    '  • Khách 100% Không Bao Giờ Chê Đắt: Quản gia tiếp tục bảo chứng giá tuyệt đối, khách uống vui vẻ không bỏ về và không đánh giá xấu.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.498',d:'11/10/2026',items:[
    '💰 CƠ CHẾ CHIA TIỀN BO MỚI: CHỦ TIỆM NHẬN 80% - NHÂN VIÊN NHẬN 20%:',
    '  • Chia Tỷ Lệ Tiền Tip Minh Bạch & Công Bằng: Khi quán có nhân viên phục vụ, toàn bộ tiền bo (tip) từ khách hàng được phân bổ công bằng: Chủ tiệm nhận 80% nạp thẳng vào két quán (S.money) và doanh thu ngày; Nhân viên nhận 20% tiền bo tích lũy làm phần thưởng phục vụ.',
    '  • Quán Chưa Thuê Nhân Viên: Chủ tiệm tự tay phục vụ hưởng trọn 100% tiền bo vào két quán.',
    '  • Đồng Bộ Sổ Sách & Báo Cáo Tài Chính P&L: Cập nhật chi tiết sổ cái và bảng tổng kết ca/ngày rõ ràng (Chủ tiệm nhận 80% tiền bo, Nhân viên giữ 20%), không còn hiện tượng trừ kép hay lệch sổ.',
    '  • Hiệu Ứng Bay Trực Quan: Khi nhận tiền bo hiển thị trực tiếp số tiền Chủ tiệm nhận (Bo két 80%) và số tiền Nhân viên nhận (NV 20%).',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.497',d:'11/10/2026',items:[
    '💎 TỐI ƯU TOÀN DIỆN KINH TẾ QUÁN: FIX TRỪ KÉP BAO BÌ, QUẢN GIA BẢO CHỨNG GIÁ & HÒA VỐN BÁN LẺ:',
    '  • Xóa Bỏ Hoàn Toàn Trừ Kép Bao Bì & Giá Vốn Ảo: Triệt tiêu việc trừ tiền kép cuối ca (S.money -= packagingCost & rawIngNeeded); loại bỏ dòng bao bì trùng lặp (Ly nắp bao bì 4.5k/ly). Chi phí nguyên vật liệu được tính đúng và minh bạch 100% theo các món thực mua.',
    '  • Quản Gia Bảo Chứng Giá Tuyệt Đối & Tự Động Phục Hồi: Khi có Quản gia, khách 100% không bao giờ chê đắt hay đánh giá xấu. Hết ngày buff +50%, Quản gia tự động trả giá các món về đúng giá ban đầu mà người chơi đã cài đặt (userBasePrice), không còn lo bị quên set lại giá.',
    '  • Cân Bằng Mèo Chiêu Tài Cho Quán Chính: Mèo không chỉ buff chi nhánh/nhượng quyền mà nay vẫy khách may mắn tăng trực tiếp +10% đến +25% doanh thu và +12% đến +30% tiền Tip cho Quán Chính, giúp quán chính kinh doanh siêu thịnh vượng.',
    '  • Chuẩn Hóa Điểm Hòa Vốn Bán Lẻ (BEP): Công thức điểm hòa vốn bán lẻ tại quầy khấu trừ thu nhập thụ động từ chi nhánh và nhượng quyền, chấm dứt cảnh báo vô lý "thiếu 3.000 ly" khi chuỗi đang có lãi ròng.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.496',d:'11/10/2026',items:[
    '🚀 TỐI ƯU TOÀN DIỆN TRẢI NGHIỆM CHỦ QUÁN: CƠ CHẾ GIÁ TỰ NHIÊN, 5 SAO & KPI CÔNG BẰNG, MƯỢT MÁ MÁY:',
    '  • Xoá Bỏ Giới Hạn Cứng Đồng Giá (85k/65k/50k): Cho phép giá bán phản ánh đúng giá trị công thức món, topping phối hợp, size ly và buff danh tiếng. Đầu tư nâng cấp công thức và nguyên liệu mang lại doanh thu xứng đáng.',
    '  • Khôi Phục Đánh Giá 5★ Chuẩn Xác: Loại bỏ hoàn toàn tỉ lệ trừ điểm ngẫu nhiên khi pha đúng, hạ ngưỡng kích hoạt mốc 5★ về 4.80 để quán đạt 5 sao đều đặn và hào hứng như trước.',
    '  • Cân Bằng Chi Phí Trộm Cắp / Két Tiền: Giới hạn tối đa 2 vụ giật két/ngày, mức thiệt hại hợp lý (4tr - 8tr) thay vì bị giật hàng chục lần âm hàng trăm triệu.',
    '  • Quản Gia Chấm KPI Công Bằng Tuyệt Đối: Nhân viên không đi làm ca nào trong chu kỳ 7 ngày (0 ca) nhận 0đ thưởng KPI (Nghỉ ca), không còn bị rút két vô lý.',
    '  • Khắc Phục Nóng Máy & Lag Cảm Ứng (0ms Touch): Giãn tần suất lưu LocalStorage (tối đa 1 lần/2.5s) giảm tải CPU; bổ sung bắt sự kiện pointerdown tức thì cho nút Bắt Quả Tang Gen Z và Dọn Bàn Sảnh Trà, bấm 1 lần ăn ngay.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.485',d:'10/10/2026',items:[
    '📊 ĐỐI SOÁT DÒNG TIỀN P&L TOÀN DIỆN, ĐỒNG BỘ DOANH THU SẢNH TRÀ & CÂN BẰNG LABOR COST:',
    '  • Tận Gốc Nguyên Nhân Lệch Dòng Tiền Ngoài Ca: Đồng bộ 100% doanh thu và tiền tip từ khách dùng nước tại Sảnh Trà (lobby.js) vào sổ kế toán P&L (S.cur.sales & S.cur.tips), chấm dứt hoàn toàn tình trạng tiền vào két nhưng P&L không ghi nhận.',
    '  • Khôi Phục Hiển Thị Thuế NQ 5% Trong Summary: Khắc phục dòng Thuế thu nhập chuỗi nhượng quyền (5%) bị thiếu trong bảng chi tiết chi phí tab Tổng Kết (paneSum).',
    '  • Cân Bằng Chuẩn F&B Labor Cost: Nâng trần thưởng KPI sản lượng nhân viên từ 6% lên 8% doanh thu theo chuẩn F&B thực tế, tăng phúc lợi nhân sự.',
    '  • Ghi Nhận Lãi Tiết Kiệm Tà Tưa Bank: Ghi nhận r.bankInterest vào báo cáo ca để theo dõi minh bạch tiến trình tích luỹ lãi kép.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.484',d:'10/10/2026',items:[
    '🌙 BÙNG NỔ LƯỢNG KHÁCH CA ĐÊM CHO QUÁN NÂNG TẦNG (10 KHÁCH) & MỞ RỘNG QUẦY (6 KHÁCH):',
    '  • Đồng Bộ Nhịp Độ Spawn Ca Đêm Tương Xứng Quy Mô Quầy: Khắc phục triệt để lỗi ca đêm bị giới hạn cứng tốc độ cũ (delay 3.2s, sàn 2.0s). Quán 10 khách giảm delay cơ sở xuống 1.2s (sàn 0.6s / 0.35s cao điểm), quầy 6 khách giảm xuống 1.8s, khách ra vào tấp nập tương xứng công suất quầy.',
    '  • Cơ Chế Khách Cú Đêm Đi Theo Nhóm: Kích hoạt nhóm khách cú đêm (sinh viên thức khuya ôn bài, nhóm bạn đi chơi đêm, đồng nghiệp tăng ca) spawn cùng lúc 2–3 khách khi quầy còn nhiều chỗ trống.',
    '  • Đón Khách Ngay Khi Vào Ca Đêm (22:00): Đúng 22:00 khi Sinh viên ca đêm vào ca, lập tức đón đợt khách cú đêm 4–6 người (quán 10 khách) hoặc 2–4 người (quầy 6 khách) vào quầy ngay.',
    '  • Giờ Cao Điểm Cú Đêm (00:00 - 02:00 Sáng): Kích hoạt Giờ Cao Điểm Cú Đêm (x1.5 Bill & Tip) giữa đêm, hội cú đêm đổ về nườm nượp giúp ca đêm luôn sôi động.',
    '  • Chuẩn Hóa rushMul Ca Đêm: Tính toán chuẩn xác chu kỳ sóng khách (el) theo thời gian ca đêm thay vì bị kẹt trần.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.483',d:'10/10/2026',items:[
    '🤵 TỐI ƯU CƠ CHẾ QUẢN GIA: XOÁ BỎ TỰ DUYỆT ĐƠN & CHỈ TỰ ĐỘNG GỌI ĐI LÀM VÀO NGÀY HÔM SAU:',
    '  • Xoá Bỏ Hoàn Toàn Tự Duyệt Đơn: Quản gia không còn tự ý duyệt các đơn xin nghỉ phép, đơn thôi việc hay đòi quyền lợi (thưởng/tạm ứng/nghỉ ca/đến trễ). Toàn bộ quyền quyết định thông qua hộp thoại (modal) được trả về 100% cho chủ quán.',
    '  • Tự Động Gọi Đi Làm Chu Đáo Vào Ngày Hôm Sau: Khi nhân viên tạm nghỉ hoặc nghỉ phép trong ngày hôm nay, Quản gia tuyệt đối không gọi lại trong ngày. Chỉ khi bước sang ngày mới hôm sau (S.day mới), Quản gia mới tự động gọi nhân viên đi làm lại chu đáo.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.482',d:'10/10/2026',items:[
    '🤵 TỐI ƯU QUẢN GIA TOÀN DIỆN: TỰ ĐỘNG DUYỆT ĐƠN MỞ CỬA & GỌI NHÂN VIÊN ĐÚNG NGÀY HÔM SAU:',
    '  • Tự Động Duyệt Mọi Đơn Mở Cửa: Quản gia tự động duyệt toàn bộ đơn xin nghỉ phép (CTV online), đơn đến hạn nghỉ việc và các drama nhân sự (thưởng nóng/tạm ứng/nghỉ 1 ca/đến trễ), giúp mở quán tức thì không bị treo hoặc kẹt modal.',
    '  • Gọi Đi Làm Đúng Ngày Hôm Sau: Nhân viên tạm nghỉ ca hoặc được duyệt nghỉ phép trong ngày hôm nay sẽ được nghỉ trọn vẹn ca hôm nay (Quản gia không gọi đi làm trong ngày). Khi bước sang ngày mới (S.day mới), Quản gia mới tự động gọi nhân viên đi làm lại chu đáo.',
    '  • Chăm Sóc Thú Cưng Nguy Cấp: Tự động hồi phục chỉ số thú cưng trước khi mở bán, ngăn chặn triệt để cảnh báo đỏ thú cưng bỏ đi.',
    '  • Bảo Lưu Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.481',d:'10/10/2026',items:[
    '🤵 NÂNG CẤP ĐẶC QUYỀN QUẢN GIA: BẢO CHỨNG GIÁ BÁN CHUẨN & TỰ ĐỘNG GỌI NHÂN VIÊN ĐI LÀM:',
    '  • Bảo Chứng Giá Bán Chuẩn Xác: Quản gia tối ưu kịch trần +30% cho 3 món Best Seller & giảm giá 30% (-30%) cho 3 món tồn kho nhiều nhất để kích cầu xả kho. Khách 100% không bao giờ chê đắt cho các món này!',
    '  • Món Thông Thường Giữ Giá Chuẩn: Giữ nguyên mức giá chuẩn mặc định (DEF_SELL). Nếu người chơi tăng cao hơn giá chuẩn, khách vẫn chê mắc như bình thường và hiện cảnh báo đắt rõ ràng.',
    '  • Khắc Phục Lỗi Giá Bất Thường (Size L 56.5k): Triệt tiêu lỗi kẹt trần giá cũ, khôi phục phụ thu Size L về giá chuẩn và cap theo quy tắc chuẩn.',
    '  • Quản Gia Chu Đáo Tự Động Gọi Đi Làm: Khi có nhân viên đang nghỉ việc / hiện nút "Gọi đi làm" / "Gọi lại", Quản gia sẽ tự động gọi nhân viên đi làm lại ngay lập tức mà không cần bấm thủ công.',
    '  • Giữ Nguyên 100% Cơ Chế Pha Chế: Toàn bộ logic pha chế, công thức độc bản và phục vụ của nhân viên được bảo toàn nguyên vẹn.'
  ]},
  {v:'12.47.480',d:'10/10/2026',items:[
    '📊 FIX TOÀN DIỆN BÁO CÁO TÀI CHÍNH F&B, ĐỐI SOÁT KÉT TIỀN & HIỂN THỊ CHI TIẾT:',
    '  • Khắc Phục Bị Khuất Khi Xem Chi Tiết Tổng Kết: Cố định thanh điều hướng (sticky action row), giới hạn chiều cao cuộn thông minh cho hộp chi tiết giúp xem toàn bộ sổ cái mà không bị khuất nút bấm hoặc tràn khung hình.',
    '  • Sửa Bug #1 - renderFnbFinancialReport & paneSum Bổ Sung franchiseIncomeTax: Khớp 100% chi phí thuế thu nhập chuỗi nhượng quyền (5%) giữa báo cáo tóm tắt (Summary) và báo cáo tài chính chuyên sâu (Detailed P&L), triệt tiêu hoàn toàn độ lệch 4.1tr.',
    '  • Sửa Bug #2 - Đối Soát Két Tiền Động & Chống Cộng Trùng Dòng Tiền: Kiểm tra chính xác dòng tiền thực tế Két Đầu + Lợi Nhuận - Trả Nợ = Két Cuối; cảnh báo minh bạch nếu có biến động ngoài ca; chống cộng lặp doanh thu nhượng quyền/chi nhánh.',
    '  • Bảo Lưu Tuyệt Đối 100%: Toàn bộ cơ chế pha chế và công thức của nhân viên được giữ nguyên vẹn không can thiệp.'
  ]},
  {v:'12.47.479',d:'10/10/2026',items:[
    '🛑 SỬA TRIỆT ĐỂ LỖI KHÔNG THỂ BÁO KẾT CA / KẾT THÚC NGÀY:',
    '  • Giải Phóng Cờ Khóa finishEndDay._running: Đặt khối finally { finishEndDay._running = false; } giải phóng khóa hoàn toàn sau khi tính toán xong, khắc phục triệt để lỗi bị chặn vĩnh viễn ở các ngày tiếp theo.',
    '  • Xóa Bỏ S._lastFinishedDay Gây Xung Đột Lưu Trữ: Chuyển sang biến runtime R._finishedDay trong phiên bán; tự động dọn sạch biến cũ trong save giúp tài khoản bị kẹt có thể kết ca ngay tức thì.',
    '  • Khôi Phục Nút "🛑 Kết Ca Ngay" An Toàn Tuyệt Đối: Bảo đảm đóng ca khẩn cấp luôn gọi thẳng finishEndDay() và hiển thị bảng tổng kết doanh thu, không bao giờ bị đứng hình hay mất tiến trình.',
    '  • Dỗ Lích Đờ 1-Click Ngay Khi Hết Giờ: Bổ sung tùy chọn thưởng nóng dỗ Lích Đờ trực tiếp trong popup cảnh báo, đóng ca liền mạch mà không bị kẹt dở giữa màn hình.',
    '  • Cam Kết Tuyệt Đối: Giữ nguyên vẹn 100% toàn bộ cơ chế pha chế và phục vụ của nhân viên.'
  ]},
  {v:'12.47.478',d:'10/10/2026',items:[
    '🏢 TỐI ƯU CÔNG SUẤT PHỤC VỤ KHI MỞ RỘNG QUẦY (6 KHÁCH) & NÂNG TẦNG (10 KHÁCH):',
    '  • Tăng Lưu Lượng Khách Đến (Traffic): Mở rộng quầy tăng +90% traffic (trần 3.5x + 1.5x), Nâng tầng tăng +180% traffic (trần 3.5x + 2.5x).',
    '  • Đón Khách Ngay Đầu Ca: Mở cửa ca bán tự động đón 3–5 khách (khi mở rộng quầy 6 chỗ) hoặc 5–7 khách (khi nâng tầng 10 chỗ) xếp hàng sẵn sàng phục vụ.',
    '  • Cơ Chế Khách Đến Theo Nhóm: Tự động spawn theo nhóm 2–3 khách khi quầy còn nhiều chỗ trống, giúp quầy luôn tấp nập tương xứng quy mô quán.',
    '  • Tăng Độ Kiên Nhẫn Khách Hàng: Quán có quầy rộng và tầng lầu thoáng mát giúp khách thư thái chờ (+18% đến +35% max patience, giảm 8%–15% tốc độ tụt kiên nhẫn khi đứng chờ).'
  ]},
  {v:'12.47.471',d:'10/10/2026',items:[
    '🎯 TRIỂN KHAI LỘ TRÌNH FIX TOÀN DIỆN — CHỐNG LẠM PHÁT & ẢO GIÁ:',
    '  • Bước 1 - Fix Bug Kế Toán Sổ Cái: recCost bổ sung r.gzStolen và r.fakeLoss, đảm bảo công thức Thu - Chi = Lãi khớp 100% không lệch 1 đồng.',
    '  • Bước 2A - Xóa Sàn Lương Cưỡng Ép & Cap KPI 6%: Bỏ hoàn toàn sàn chi phí lương nhân viên ép buộc tránh bơm tiền ảo, thay bằng trần thưởng KPI tối đa 6% doanh thu thực.',
    '  • Bước 2B - Kiến Trúc Giá Additive & Final Hard Cap: Chuyển toàn bộ buff giá sang additive (+80% max), Hard Cap sau tất cả buff (50k/65k/85k) và giới hạn tuyệt đối buff thụ động (chỉ cho phép vượt tối đa 1.4x cap khi trong giờ cao điểm Rush Hour), đưa giá TB/ly về chuẩn 60k-75k.',
    '  • Bước 3 - Additive Traffic & Cap 6.0x: Loại bỏ chuỗi nhân cấp số mũ traffic (23x), chuyển sang additive cap +500% (tối đa 6.0x, có Ads tối đa 8.0x), đưa sản lượng về thực tế 700-750 ly/ngày.',
    '  • Bước 4 - Lãi Suất Tiết Kiệm Lũy Tiến Từng Bậc: Tính lãi cộng dồn từng bậc (Bracket-based) triệt tiêu vách đá lãi suất, số dư càng cao lãi tuyệt đối luôn tăng, không bao giờ bị giảm khi gửi nhiều hơn.',
    '  • Bước 5 - Cap Recipe & Tách Buff Nhượng Quyền: Cap recipe multiplier tối đa x2.0; Ads & Pet buff chỉ áp lên Royalty của quán mẹ, không thổi phồng doanh thu cơ sở nhượng quyền.',
    '  • Bước 6 - Tip Additive & Thuế TNCN Tip: Tip chuyển sang additive (cap +80%); khấu trừ thuế TNCN 4.5% trực tiếp trên tip nhân sự (két quán không bị trừ).',
    '  • Bước 7 - G&A Văn Phòng Chuỗi Có Điều Kiện: Tự động kích hoạt chi phí G&A văn phòng điều hành (3%-7% doanh thu chuỗi) khi quy mô đạt chuẩn chuỗi lớn (≥3 cơ sở, doanh thu chuỗi >300tr/ngày, >200 ngày), hoàn toàn không ảnh hưởng đến người chơi giai đoạn đầu và giữa game.',
    '  • Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên.'
  ]},
  {v:'12.47.470',d:'09/10/2026',items:[
    '📊 TÁI CẤU TRÚC KINH TẾ F&B CHUẨN HÓA TRÁNH LẠM PHÁT & KHỚP 100% SỔ CÁI:',
    '  • Tách Biệt Rạch Ròi Giá Vốn & Bao Bì (COGS ~32%): Chi phí bao bì, ly nắp, ống hút, đá sạch cố định thực tế 4.500đ/ly (packaging_wastage); xuất kho nguyên liệu cốt trà, sữa, topping (raw_ingredient_cogs) bảo đảm tỷ lệ COGS 30%–35% doanh thu bán đồ uống.',
    '  • Khớp Tuyệt Đối 100% Bảng Tổng Chi Phí: Loại bỏ chi phí mặt bằng, lương NV và nhập NL của đối tác nhượng quyền khỏi danh sách chi phí của quán mẹ (vì do đối tác tự thanh toán từ két riêng); bổ sung đầy đủ chi phí sự cố phát sinh vào tổng chi phí.',
    '  • Báo Cáo P&L Đánh Giá Chuẩn Xác Tỷ Lệ Vàng F&B: Chỉ số COGS (28%–32%) và Quỹ lương nhân sự (15%–20%) được tính trên doanh thu bán lẻ trực tiếp của hệ thống cửa hàng, không bị pha loãng bởi phí nhượng quyền chuỗi khổng lồ.',
    '  • Cân Bằng Trần Doanh Thu Chuỗi Nhượng Quyền Thực Tế: Doanh thu mỗi đối tác giới hạn hợp lý theo quy mô (14tr–35tr/ngày), lợi nhuận bán sỉ nguyên liệu tính đúng trên chênh lệch giá vốn, tránh lạm phát kinh tế ảo.',
    '  • Cam Kết Bất Biến: Tuyệt đối giữ nguyên và không can thiệp bất kỳ cơ chế pha chế hay phục vụ nào của nhân viên; 100% tiền tip bo thuộc về nhân sự.'
  ]},
  {v:'12.47.469',d:'09/10/2026',items:[
    '💵 ĐỒNG BỘ CƠ CHẾ TIỀN TIP BO NHÂN VIÊN & BỎ TRẢ LẠI TIỀN BO:',
    '  • Nhân Viên Hưởng Trọn Vẹn 100% Tiền Tip: Khi tiệm có nhân viên, toàn bộ tiền tip/bo của khách sẽ thuộc về nhân viên giữ hết (quán không nhận bất kỳ % tiền bo nào).',
    '  • Bỏ Hoàn Toàn Cơ Chế Trả Lại Tiền Bo: Loại bỏ vĩnh viễn việc nhân viên trả lại / nộp lại tiền bo vào két quán, thu nhập tip được nhân sự giữ trọn vẹn.',
    '  • Giữ Nguyên 100% Cơ Chế Vận Hành Quán: Mọi logic hoạt động, pha chế, phục vụ của nhân viên được bảo lưu tuyệt đối không can thiệp.'
  ]},
  {v:'12.47.468',d:'09/10/2026',items:[
    '🦫 TỐI ƯU CHI PHÍ NÂNG CẤP CÁP BI & LÀM GỌN HOẠT ẢNH THÚ CƯNG:',
    '  • Điều Chỉnh Chi Phí Cáp Bi Chuẩn Định Mức: Nâng cấp chuyển đổi từ 1tr thành (−10.000.000đ − 1% két tiền − 10 Tổng Sao x10 ⭐), tương xứng với tầm vóc thú cưng độc bản quý hiếm.',
    '  • Tinh Giản Hiệu Ứng Hoạt Ảnh: Bỏ kích hoạt hoàn toàn hiệu ứng emoji bay bộc phát (tim, sao, dưa hấu, cáp pi), giữ trọn vẹn nét điềm đạm, thư thả tự nhiên của Cáp Bi và không gian quán.'
  ]},
  {v:'12.47.467',d:'09/10/2026',items:[
    '🦫 ĐỒNG BỘ CƠ CHẾ NÂNG CẤP CẤP ĐỘ CỦA CÁP BI CHUẨN XÁC GIỐNG TÓ VÀ MÈO:',
    '  • Chi Phí Nâng Cấp Chuẩn Thú Cưng: Chuyển đổi từ chi phí tượng trưng 10.000đ sang công thức rèn luyện chuẩn mực giống Tó & Mèo: (−1.000.000đ + 0.5% két tiền + tiêu hao 1 Tổng Sao x1 ⭐).',
    '  • Cơ Chế Tích Lũy EXP Chuyên Sâu: Mỗi lần rèn luyện/nâng cấp nhận ngẫu nhiên từ +5 EXP đến tối đa 10% EXP yêu cầu của cấp độ hiện tại (thay vì cố định +5 EXP), gia tăng +4 điểm Vui vẻ.',
    '  • Tăng Trưởng Sức Mạnh Toàn Diện (Buff Scaling): Mỗi cấp độ nâng cấp Cáp Bi mở rộng dung lượng các thanh chỉ số và tăng thêm sức mạnh cho cả 4 siêu buff (+0.5% Doanh thu, +0.5% Tip, +0.5% Doanh thu chi nhánh, +1% giảm nguy cơ thua lỗ chi nhánh, +0.5% giá bán nguyên liệu thừa).',
    '  • Đồng Bộ Giao Diện & Thao Tác 1 Chạm: Thẻ thông tin, huy hiệu Cấp độ và sân khấu Cáp Bi hiển thị rõ chi phí nâng cấp (−1tr, −0.5% két, −1⭐) và hiệu ứng tim bay bộc phát sống động.'
  ]},
  {v:'12.47.466',d:'09/10/2026',items:[
    '⚖️ TÁI CẤU TRÚC KINH TẾ CHUẨN F&B THỰC TẾ (REALISTIC REBALANCE & CHAIN MONOPOLY):',
    '  • Chuẩn Hóa Giá Vốn & Hao Hụt (COGS Floor 22% - 26%): Tính toán chi phí ly ép màng, túi, ống hút bọc giấy, đá sạch & phụ gia (4.500đ/ly) cùng sàn giá vốn tối thiểu 24% doanh thu đồ uống, phản ánh chân thực chi phí bao bì & hao hụt trong vận hành F&B quy mô lớn.',
    '  • Lương & Thưởng Nhân Viên Lũy Tiến (Labor Cost 15% - 18%): Quỹ lương tự động scale theo sản lượng thực tế với cơ chế thưởng KPI (+3.800đ/ly từ ly thứ 201) và thưởng hoa hồng vượt chỉ tiêu (+6.5% khi bán trên 1.000 ly), sàn lương tối thiểu 16.5% doanh thu ở quy mô lớn.',
    '  • Mặt Bằng & Điện Nước Tăng Theo Quy Mô (Rent & Overhead 6% - 8%): Tiền thuê mặt bằng Flagship và điện nước tủ đông công nghiệp scale lũy tiến theo doanh thu (tối đa +50tr mặt bằng, +30tr điện nước).',
    '  • Mạng Lưới Chuỗi & Nhượng Quyền Hưởng Lợi Từ Công Thức Độc Quyền (+5%/món): Doanh thu chi nhánh & đối tác nhượng quyền tăng trưởng theo số lượng công thức độc quyền sáng chế.',
    '  • Bảng Tổng Kết Cuối Ngày Nổi Bật Doanh Thu Chuỗi: Hiển thị trực quan Phí bản quyền Royalty, Lợi nhuận bán sỉ nguyên liệu chuỗi cung ứng và Phí hệ thống POS của toàn bộ mạng lưới cơ sở.'
  ]},
  {v:'12.47.465',d:'09/10/2026',items:[
    '🛠️ SỬA TRIỆT ĐỂ LỖI TRANG BỊ NÂNG CẤP 1 2 3 (MÁY DÁN NẮP, BÌNH RÓT, KHAY TOPPING, LY ĐƯỜNG ĐÁ) BỊ HƯ KHÔNG THỂ SỬA:',
    '  • Cơ Chế Sửa Chữa Trực Tiếp (Repair Button): Bổ sung nút "Sửa ngay" nổi bật và nút "Sửa tất cả" trực tiếp trên từng thẻ trang bị cấp 1, 2, 3 khi bị hỏng với chi phí sửa chữa hợp lý (500k cho C1, 1.5tr cho C2, 3tr cho C3). Khi đạt Cấp 3 tối đa vẫn sửa chữa thoải mái mà không bị kẹt.',
    '  • Trạng Thái Hư Hỏng Trực Quan: Thẻ trang bị hư hỏng hiển thị viền đỏ cảnh báo, huy hiệu "⚠️ HỎNG" nhấp nháy, gạch ngang tên và ghi rõ mất hiệu ứng để người chơi nhận biết ngay.',
    '  • Sửa Tự Động Khi Nâng Cấp: Nếu thiết bị đang hỏng mà người chơi bấm nâng cấp lên cấp cao hơn, hệ thống tự động sửa chữa và hồi phục thiết bị song song.',
    '  • Tương Thích & Khôi Phục Lưu Game: Tự động phát hiện các máy dán nắp đang bị hư trong save cũ và bật ngay nút sửa chữa; Quản gia (Butler) tự động sửa chữa bảo dưỡng toàn bộ 4 trang bị cấp 1 2 3 đầu mỗi ngày mới.'
  ]},
  {v:'12.47.464',d:'09/10/2026',items:[
    '🚀 ĐẠI NÂNG CẤP HỆ THỐNG NHƯỢNG QUYỀN CHUỖI F&B ĐỜI THỰC (60M - 100M+/NGÀY):',
    '  • Trụ Cột 1 - Sức Mạnh Thương Hiệu Chuỗi (Brand Power Scaling): Doanh thu chi nhánh nhượng quyền không còn cố định 5-7tr mà tỉ lệ thuận 15%-26% quy mô Quán Chính + thưởng danh tiếng MXH (+10% mỗi 50k Followers). 8 chi nhánh mang về ngay +40tr đến +60tr/ngày tiền phí bản quyền Royalty!',
    '  • Trụ Cột 2 - Độc Quyền Cung Ứng Chuỗi (Supply Chain Monopoly): Tất cả chi nhánh nhượng quyền bắt buộc nhập 100% nguyên liệu cốt trà, sữa, topping, ly độc quyền từ Tổng Kho Mẹ. Chủ tiệm hưởng 40% - 50% biên lợi nhuận bán sỉ, két thu thêm ngay +15tr đến +40tr+/ngày!',
    '  • Trụ Cột 3 - Nâng Cấp Hợp Đồng & Thưởng Doanh Số (Tiered Royalty & POS Cloud Fee): Hệ thống 4 cấp hợp đồng Tiêu Chuẩn (10%), Bạc (12%), Vàng (14%), Kim Cương (16%) kèm phí duy trì hệ thống POS & bản quyền công thức định kỳ lên đến 5.000.000đ/cơ sở/ngày!'
  ]},
  {v:'12.47.463',d:'09/10/2026',items:[
    '👥 Đồng Bộ Tuyệt Đối Cơ Chế Nhận Khách Của Gen Z Giống Quản Lý Tập Sự (Phụ Quầy 2):',
    '  • Khách Đầu Tiên Luôn Là Tiêu Điểm Bất Biến (sortedSlots[0]): Giống 100% cơ chế Quản lý tập sự (staff3) và Nhân viên phụ quầy 2, Gen Z luôn ưu tiên phục vụ khách đầu tiên tại quầy thu ngân (firstSlotCust). Tuyệt đối không bỏ khách đầu để nhảy sang khách khác.',
    '  • pSlots() Không Bao Giờ Ẩn Khách Đầu Tiên: Khách đầu tiên tại quầy luôn giữ nguyên trong pSlots() và không bao giờ bị đánh dấu null, bảo đảm focusCust() luôn luôn trả về khách đầu tiên.',
    '  • Thợ Pha Chế Tuyệt Đối Chỉ Nhận Từ Khách Thứ 2 Trở Đi (sortedSlots.slice(1)): Thợ pha chế (staff2) chỉ chọn khách từ vị trí số 2 trở đi trong hàng đợi, triệt tiêu 100% khả năng tranh hay đẩy khách đầu của Gen Z.',
    '  • Tự Động Huỷ Tác Vụ Sai Lệch Nếu Có: Nếu phát hiện công việc dở dang không thuộc khách đầu tiên, Gen Z lập tức dọn thớt và quay về phục vụ ngay khách đầu tiên.'
  ]},
  {v:'12.47.462',d:'09/10/2026',items:[
    '🎧 Hiển Thị & Khóa Tiêu Điểm Khách Đầu Tiên Cho Gen Z (Chuẩn Quản Lý Tập Sự):',
    '  • Khóa Cố Định Khách Đầu Tiên (firstSlotCust Lock): focusCust() luôn luôn ghim chặt khách đầu tiên đang xếp hàng tại quầy (sortedSlots[0]), đảm bảo Gen Z luôn phục vụ khách đầu tiên, triệt để ngăn chặn tình trạng bị thợ pha chế đẩy sang khách số 5.',
    '  • Luôn Hiển Thị Biểu Tượng Gen Z (🎧) Trên Khách Đầu Tiên: Giống như Quản lý tập sự & Nhân viên phụ quầy 2 luôn thường trực tại quầy, biểu tượng tai nghe tím 🎧 được hiển thị liên tục trên khách đầu tiên Gen Z đang phục vụ trong hàng đợi.',
    '  • Tự Động Dọn Thớt Thông Minh: Nếu trên bàn có ly dở dang sai size hoặc sai cốt trà do thao tác trước, Gen Z tự động dọn ly cũ và lấy ly chuẩn xác cho khách mới mà không bị đơ.'
  ]},
  {v:'12.47.461',d:'09/10/2026',items:[
    '⚡ Khắc Phục Triệt Để Lỗi Đơ Quầy & Khách Đợi Không Bán Được:',
    '  • Khôi Phục needs(o) Chuẩn Nguồn TiemTraNho: Loại bỏ kiểm tra tồn kho đá & nước đường trong needs(o) vì đá và đường là tiện ích quầy vô hạn. Trả về đúng danh mục: [cốt trà, siro hương, topping, cheese, ly], giúp Gen Z, Thợ pha chế và Sinh viên pha chế liên tục không bao giờ bị nghẽn đơ.',
    '  • Gen Z & Quản Lý Luôn Nhận Đúng Khách Đầu Tiên (firstCust): Khắc phục lỗi kiểm tra R.slots[0] theo mảng vật lý thay vì theo hàng chờ (arrival order). focusCust() luôn ưu tiên khách có ID nhỏ nhất (khách đến sớm nhất đang chờ ở quầy) thay vì nhảy sang khách mới đến.',
    '  • Bảo Vệ Tuyệt Đối Khách Đầu Tiên Khỏi Thợ Pha Chế: Thợ pha chế (staff2) tuyệt đối không nhận khách đầu tiên trong hàng đợi (sortedSlots[0]), đảm bảo khách đầu tiên luôn được Gen Z / Quản lý phục vụ ngay lập tức.'
  ]},
  {v:'12.47.460',d:'09/10/2026',items:[
    '👥 Chuẩn Hóa Cơ Chế Nhận Khách Của Gen Z Theo Chuẩn Nhân Viên Phụ Quầy 2 (Quản Lý Tập Sự):',
    '  • Nhận Khách Trực Tiếp Tại Quầy (focusCust): Gen Z và Sinh viên ca đêm nhận khách tại quầy chuẩn xác như Nhân viên phụ quầy 2 (Quản lý tập sự / staff3), luôn phục vụ trực tiếp khách hàng đang focus tại quầy pha chế.',
    '  • Thêm Bước Lấy Ly Tự Động (Tự Lấy Ly): Khác với Quản lý tập sự (phải đợi người chơi bấm lấy ly), Gen Z và Sinh viên tự động lấy ly từ chồng ly (size M/L) đặt lên thớt khi quầy trống, sau đó tiến hành pha chế trọn gói A-Z.',
    '  • Tự Động Tiếp Quản Ly Tiếp Theo Của Cùng Khách: Sau khi giao ly 1, nhân viên lập tức lấy ly tiếp theo cho khách hiện tại cho tới khi khách xong toàn bộ số ly, sau đó tự động chuyển sang khách kế tiếp.',
    '  • Kích Hoạt Shipper Mua Hàng Tức Thì Khi Thiếu Đồ: Nếu khách đang phục vụ thiếu nguyên liệu hoặc ly, nhân viên lập tức gọi Shipper mua hàng tức thì và chờ hàng, tuyệt đối không nhảy loạn xạ giữa các slot làm lộn xộn thớt quầy.',
    '  • Phối Hợp Tuyệt Đối Không Xung Đột Với Quản Lý Tập Sự: Ngăn chặn xung đột thao tác khi thuê đồng thời Quản lý tập sự và Gen Z, giữ vững luồng pha chế mượt mà 100%.'
  ]},
  {v:'12.47.459',d:'09/10/2026',items:[
    '⚡ Khắc Phục Triệt Để Lỗi Gen Z & Sinh Viên Cuối Tháng Không Tự Động Pha Chế:',
    '  • Tự Động Lấy Ly Mọi Lúc (Empty Board Fix): Cải tiến điều kiện lấy ly linh hoạt, Gen Z và Sinh viên cuối tháng tự động lấy đúng size ly ngay khi chưa có ly hoặc ly rỗng trên thớt quầy, triệt tiêu 100% tình trạng đứng im hay bị kẹt khi đổi ly.',
    '  • Không Hủy Đơn Đang Pha Dở: Loại bỏ việc hủy việc vô cớ khi tiêu điểm đổi khách, bảo đảm Gen Z hoàn thành trọn vẹn ly nước đang làm trước khi chuyển sang ly tiếp theo.',
    '  • Tự Động Tìm Khách Đang Chờ Tại Quầy (FIFO): Nếu khách đang focus đã làm xong hoặc thiếu nguyên liệu, Gen Z tự động quét và phục vụ ngay khách đang chờ đầu tiên tại quầy chưa có Barista nhận.',
    '  • Khởi Tạo Ngay Khi Vừa Thuê: Đảm bảo khi người chơi vừa thuê Gen Z hoặc Sinh viên cuối tháng, nhân viên lập tức nhận việc và vào guồng pha chế ngay trong ca làm việc.'
  ]},
  {v:'12.47.458',d:'09/10/2026',items:[
    '👥 Khắc Phục Triệt Để Lỗi Tranh Khách & Tranh Ly Sai Khi Thuê Quản Lý (Không Thuê Gen Z):',
    '  • Khách 1 (Slot 0) Độc Quyền Của Quản Lý: Thợ pha chế (staff2) tuyệt đối không chạm hay nhận khách đứng ở vị trí Khách 1 (R.slots[0]) hoặc khách Quản lý đang chọn/pha chế, triệt tiêu hoàn toàn tình trạng tranh khách.',
    '  • Ly Riêng Cho Thợ Pha Chế (Worker Cup Isolation): Thợ pha chế và nhân viên đơn online pha chế trên đối tượng ly riêng độc lập (workerCup), tuyệt đối không hoán đổi, ghi đè hoặc can thiệp vào ly đang pha trên thớt của Quản lý.',
    '  • Quản Lý Tập Sự (staff3) Pha Chế Chuẩn 100%: Loại bỏ ảnh hưởng sai bill (s1bad) chỉ dành cho Thử việc chính thức, Quản lý tập sự luôn múc đầy đủ topping (chuẩn hóa mã alias), đường đá chuẩn xác không bao giờ bị báo "Ly bị sai" hay "Ly bị dư hoặc sai món".',
    '  • Khóa Tiêu Điểm Quản Lý: focusCust luôn giữ vững tiêu điểm Khách 1 ở quầy, không bị giật hay đổi tiêu điểm sang khách khác khi thợ pha chế đang làm việc.'
  ]},
  {v:'12.47.457',d:'09/10/2026',items:[
    '🍬 Tối Ưu Toàn Diện Giao Diện Minigame Trà Sữa Crush Trên Điện Thoại:',
    '  • Khung Gameplay Chuẩn Vừa Mọi Màn Hình Điện Thoại: Cân đối và thu gọn thanh thống kê, thông tin mục tiêu, thanh tự động bán nước và kích thước bàn cờ 7x7 giúp toàn bộ trò chơi hiển thị 100% trọn vẹn, không cần cuộn dọc.',
    '  • Khắc Phục Lỗi Khuất Nút "Chơi Tiếp": Tối ưu bảng kết quả và bảng giới thiệu màn chơi gọn gàng, tăng cường cuộn an toàn và hiển thị nổi bật nút hồng "▶ Chơi Tiếp (Màn X) ➜" ngay trong tầm mắt, dễ bấm, không bị che bởi thanh điều hướng điện thoại.',
    '  • Ẩn Footer Mẹo Trên Màn Hình Nhỏ: Tự động ẩn thanh mẹo chân trang trên màn hình điện thoại để nhường tối đa không gian cho bàn cờ xếp kẹo mượt mà.'
  ]},
  {v:'12.47.456',d:'09/10/2026',items:[
    '🧋 Khắc Phục Lỗi Nhân Viên Tranh Khách 1 Của Quản Lý & Tối Ưu Cơ Chế Phụ Quầy:',
    '  • Khách 1 Là Của Quản Lý (Chuẩn TiemTraNho): Thợ pha chế (staff2) tuyệt đối không chạm vào Khách 1 hoặc khách mà Quản lý đang chọn (focusCust). Chỉ nhận pha khi có từ 2 khách trở lên và chỉ làm các khách từ vị trí số 2 trở đi.',
    '  • Tối Ưu Gen Z & Sinh Viên Cuối Tháng Như Quản Lý Tập Sự: Hoạt động đồng hành cùng Quản lý tại quầy (focusCust), tối ưu tự động lấy ly chuẩn size ngay khi quầy trống mà Quản lý không cần bấm vào size ly.',
    '  • Phối Hợp Pha Chế Không Xung Đột: Nhân viên tự động rót trà, thêm hương, múc topping còn thiếu, đường đá và dán nắp; Quản lý có thể tham gia bấm nguyên liệu bất kỳ lúc nào mà không bị chặn, không bị đổ ly hay đứt Combo.',
    '  • Khôi Phục Tiêu Điểm Chuẩn (focusCust): Tuyệt đối không để nhân viên tự ý cướp hoặc đổi R.focus của Quản lý.'
  ]},
  {v:'12.47.455',d:'09/10/2026',items:[
    '🏎️ Sửa Lỗi Chiến Thần Xa Lộ & Nhân Viên Đi Chợ Không Mua Đồ Bổ Sung Nguyên Liệu:',
    '  • Chuẩn Hóa Khóa Nguyên Liệu: Chuẩn hóa toàn bộ tên gọi/alias (thạch 3Q, trân châu hoàng kim, pudding, kem trứng...) giúp nhân viên luôn nhận diện chính xác nguyên liệu cần mua thay vì bị trả về null.',
    '  • Tự Động Quét & Bổ Sung Mọi Nguyên Liệu: Tự động phát hiện và mua bổ sung nguyên liệu thiếu từ đơn hàng chờ (quầy & online), trà cốt, topping, vật tư (ly, đường, đá) và các loại siro đã từng mở/dùng hoặc có trong công thức đặc biệt.',
    '  • Khắc Phục Kẹt Chuyến Ảo (Ghost Trips): Dọn dẹp dứt điểm tình trạng kẹt chuyến đi chợ khiến nhân viên bị khóa vĩnh viễn không khởi hành được chuyến mới.',
    '  • Hỗ Trợ Ca Tăng Giờ (Sau 22h): Cho phép nhân viên đi chợ tiếp tục mua đồ bổ sung nếu còn khách chờ tại quán hoặc đơn online cho đến khi hoàn thành xong ca.',
    '  • Cập Nhật Tức Thì Cho Chiến Thần Xa Lộ: Chiến thần xa lộ hoàn thành mua hàng siêu tốc 0s, tự động cập nhật ngay lập tức kho hàng và giao diện pha chế để phục vụ khách hàng liền mạch.'
  ]},
  {v:'12.47.454',d:'09/10/2026',items:[
    '💾 Khắc Phục Lỗi Tải Tệp Sao Lưu (.txt) Thành Menu Chia Sẻ (Share):',
    '  • Lưu Tệp Trực Tiếp Vào Máy (Downloads): Nút "Lưu tệp về máy (.txt)" tải thẳng file .txt vào thư mục Download/Tải về của trình duyệt, không còn tự ý kích hoạt bảng chia sẻ Windows/Web Share.',
    '  • Tách Biệt Nút "Chia Sẻ": Bổ sung nút "📤 Chia sẻ" riêng biệt bên cạnh nếu người chơi muốn gửi file qua Zalo, Messenger, Mail hoặc Nearby Sharing.',
    '  • Khôi Phục Nhanh Chóng & Thuận Tiện: Tệp đã tải về máy có thể nạp ngay lập tức thông qua nút "📂 Chọn file sao lưu" trong bảng Khôi phục.'
  ]},
  {v:'12.47.453',d:'09/10/2026',items:[
    '👮‍♂️ Điều Chỉnh Cơ Chế Chú Bảo Vệ Chặn 90% Sự Cố (Không Tuyệt Đối 100%):',
    '  • Tỉ Lệ Phòng Vệ Chuẩn 90%: Chú Bảo Vệ ngăn chặn 90% các hành vi xấu và nguy cơ thất thoát (tiền giả, bùng tiền bỏ chạy, quỵt tiền ly sai order, mặc cả, trả thiếu, trộm móc két tiền trên 2 tỷ, nhân viên lobby thụt két, gian lận buôn bán).',
    '  • 10% Rủi Ro Thách Thức Thực Tế: 10% rủi ro kẻ gian tinh vi hoặc lách qua tầm mắt bảo vệ, tạo sự kịch tính và chân thực cho tiệm trà.',
    '  • Thông Báo & Phản Hồi Rõ Ràng: Hệ thống hiển thị chi tiết khi Chú Bảo Vệ tóm gọn/ngăn chặn thành công (90%) hoặc khi đối tượng lọt qua bảo vệ (10%).'
  ]},
  {v:'12.47.451',d:'08/10/2026',items:[
    '👥 Khôi Phục 100% Nguyên Bản Toàn Bộ Nhân Viên Từ Bản Update 5.10:',
    '  • Đồng Bộ Tuyệt Đối Logic Pha Chế Chuẩn: Phục hồi nguyên bản 100% các hàm staffGzTick, staffGzStep, staffSvTick, staffSvStep và staffStepWorker từ update5.10 hoạt động ổn định và chính xác.',
    '  • Khắc Phục Triệt Để Lỗi Bỏ Qua Khách Đầu Hàng: Phục hồi điều kiện lọc chuẩn R.st2 && R.st2.id === c.id, loại bỏ hoàn toàn các rào cản nhân tạo khiến Gen Z bỏ qua khách đứng đầu quầy.',
    '  • Phục Vụ Đúng Thứ Tự Đến Trước Làm Trước (FIFO): Gen Z tự động lấy ly, rót trà, thêm hương, múc topping, đường đá và dán nắp giao ngay cho khách theo đúng thứ tự đến trước từ trái qua phải.'
  ]},
  {v:'12.47.450',d:'08/10/2026',items:[
    '👥 Đồng Bộ 100% Logic Nhân Viên Chuẩn Từ Bản Update 5.10 (Khắc Phục Triệt Để Lỗi Bỏ Qua Khách Đầu Tiên):',
    '  • Loại Bỏ Hoàn Toàn Quy Tắc Chặn Thợ Pha Chế Làm Khách Đầu: Xóa bỏ triệt để biến isTargetFirstCust và điều kiện chặn thợ pha chế nhận đơn của khách đứng đầu quầy, giúp thợ pha chế tự do hỗ trợ khách đầu tiên ngay lập tức.',
    '  • Phục Hồi Cơ Chế Chọn Đơn FIFO & Cứu Khách Khẩn Cấp: Gen Z và Sinh viên ca đêm ưu tiên người đến trước phục vụ trước (id nhỏ nhất đứng đầu hàng), kết hợp cứu khách sắp hết kiên nhẫn (pat <= 50%), tự động chuyển giao focus chính xác cho quầy pha chế.',
    '  • Phối Hợp Nhịp Nhàng 100% Giữa Các Nhân Viên: Khi Gen Z tập trung cứu khách khẩn cấp, Thợ pha chế sẽ tự động tiếp quản pha chế cho khách đứng đầu quầy, tuyệt đối không còn hiện tượng khách đầu hàng bị bỏ quên.'
  ]},
  {v:'12.47.449',d:'08/10/2026',items:[
    '🛡️ Bảo Hộ 100% Tiền Gửi Tiết Kiệm Tà Tưa Bank (Khắc Phục Triệt Để Lỗi Thất Thoát Số Dư):',
    '  • Sửa Lỗi Tự Động Tất Toán Cuối Ngày: Khi kết ca két tiền âm, hệ thống chỉ giải ngân đúng số tiền thâm hụt (Math.min(S.bank.balance, deficit)), tuyệt đối không còn rút sạch toàn bộ sổ tiết kiệm về 0đ; số dư còn lại và tiến độ kỳ hạn (0/7 ngày) được bảo lưu nguyên vẹn 100%.',
    '  • Khóa Chặt Tiền Gửi Trước Quản Gia & Trả Lương: Quản gia tự động trả KPI và hộp thoại thanh toán lương nhân viên chỉ chi trả từ két quán, tuyệt đối không được tự ý trừ lén hay tất toán sổ tiết kiệm ngân hàng của người chơi.',
    '  • Đồng Bộ Đầy Đủ Mã Sao Lưu Rút Gọn (TTN2/TTN3): Lưu và khôi phục trọn vẹn 100% số dư tiết kiệm (bal), tiền gốc (prin), hạn mức (cap), kỳ hạn (term), tiến độ ngày (days) và tổng lãi kép trong mã sao lưu nén.'
  ]},
  {v:'12.47.448',d:'08/10/2026',items:[
    '⚡ Khắc Phục Triệt Để Lỗi Gen Z & Sinh Viên Cuối Tháng Không Pha Chế:',
    '  • Tối Ưu Kiểm Tra Nguyên Liệu: Chỉ kiểm tra tồn kho ở bước khởi tạo ly (step: cup), loại bỏ hoàn toàn cơ chế kiểm tra thừa ở các bước sau (tea, flav, tops, sugar_ice, seal) vốn làm huỷ đơn giữa chừng khi nguyên liệu đã được tiêu hao vào ly.',
    '  • Fallback Giao Ly An Toàn 100% Cho Sinh Viên Cuối Tháng: Bổ sung cơ chế Fallback chống đứng đơn tuyệt đối sau khi dán nắp (tương tự Gen Z), bảo đảm đơn luôn được tính hoàn tất ngay cả khi xảy ra độ lệch ly ngái ngủ.',
    '  • Huy Hiệu Mũ Cử Nhân (🎓) Trên Hàng Đợi: Hiển thị biểu tượng 🎓 rõ ràng trên đầu khách đang được Sinh viên cuối tháng phục vụ trong ca đêm.',
    '  • Khiên Bảo Vệ Try-Catch & Chuẩn Hoá Bộ Đếm Ca Đêm: Bọc khiên an toàn cho staffGzStep và đồng bộ bộ đếm ca đêm (nightT) trong isStaffActive, ngăn chặn hoàn toàn lỗi đóng băng luồng nhân viên.'
  ]},
  {v:'12.47.447',d:'08/10/2026',items:[
    '🍬 Tinh Chỉnh Vị Trí Kẹo Ngọt & Khắc Phục Triệt Để Lỗi Che Màn Hình Minigame:',
    '  • Đặt Kẹo Ngang Hàng Bên Cạnh Điện Thoại: Di chuyển nút Kẹo (#q3CrushBtn) xuống ngang hàng (top: 638px, left: 124px) ngay bên phải điện thoại (left: 48px), hoàn toàn giải phóng khoảng không chân ly L.',
    '  • Triệt Tiêu Toàn Bộ Thông Báo & Thanh Nhân Viên Che Màn Hình: Tăng z-index của Milk Tea Crush lên 300.000, đồng thời tự động ẩn sạch thông báo Toast và thanh nhân viên (staffBarWrap) trong suốt thời gian chơi kẹo.',
    '  • Trải Nghiệm Match-3 Hoàn Hảo: Bàn cờ kẹo thông thoáng 100%, không còn bất kỳ khung chữ hay bảng x2 bill nào đè lên các hàng kẹo phía dưới.'
  ]},
  {v:'12.47.446',d:'08/10/2026',items:[
    '🍬 Ra Mắt Nút Kẹo Milk Tea Crush & Chế Độ Tự Động Bán Nước Song Song:',
    '  • Biểu Tượng Kẹo Ngọt Nổi Bật Trên Quầy (q3CrushBtn): Đặt cạnh/phía trên điện thoại thông minh, hoạt ảnh kẹo bồng bềnh 3D cùng huy hiệu AUTO.',
    '  • Tự Động Bán Nước Trong Lúc Chơi Kẹo: Mở Milk Tea Crush trực tiếp từ quầy pha chế; hệ thống Auto-Barista tự động pha chế phục vụ từng lượt khách và đơn online (1.6s/ly).',
    '  • Bảng Thống Kê Trực Tuyến Trong Game Kẹo: Theo dõi trực tiếp số ly nước và doanh thu tự động tăng lên (+X ly, +Yđ) ngay trong khung chơi kẹo.',
    '  • Bảo Toàn Khách Hàng Tuyệt Đối: Giảm 60% tốc độ tụt kiên nhẫn khi đang xếp kẹo, đảm bảo khách luôn được phục vụ trọn vẹn và nhận đánh giá tích cực.'
  ]},
  {v:'12.47.445',d:'08/10/2026',items:[
    '🧋 Cân Đối Đồng Nhất 50-50 Khung Gợi Ý & Khung Ra Mắt Món Trend (R&D):',
    '  • Khắc Phục Lỗi Lệch Chiều Cao & Độ Rộng: Thiết lập cấu trúc mix-actions-row đồng đều tuyệt đối 50-50, chia đều 2 cột cân đối bằng chằn chặn.',
    '  • Đồng Bộ Chiều Cao & Cạnh Đáy Chuẩn Xác: Khung Xem Gợi Ý và Khung Ra Mắt Món luôn có cùng chiều cao (align-items: stretch), viền 1.5px và bo góc 14px đồng nhất.',
    '  • Tối Ưu Bố Cục 2 Dòng Rõ Ràng: Tên thao tác nổi bật ở dòng 1 (💡 Xem Gợi Ý / 🚀 Ra Mắt Món) và chi phí ở dòng 2 (5% két / Phí R&D), loại bỏ hoàn toàn hiện tượng chữ bị vỡ thành nhiều dòng hẹp.'
  ]},
  {v:'12.47.444',d:'08/10/2026',items:[
    '🚨 Khắc Phục Triệt Để Lỗi Nút Báo Công An Bị Banner Che Khuất:',
    '  • Xóa Bỏ Toast Cảnh Báo Đè Nút: Loại bỏ hoàn toàn toast cảnh báo két tiền 1 Tỷ xuất hiện đè lên nút "Báo C.An" trong 10 giây vàng khi phát hiện tiền giả.',
    '  • Dọn Dẹp Toast Tức Thì Khi Báo Án: Ngay khi kích hoạt nút Báo Công An, toàn bộ toast cũ đang hiển thị sẽ lập tức được ẩn sạch để quầy rõ ràng 100%.',
    '  • Chặn Toast Che Màn Hình Trong Giờ Báo Án: Trong 10 giây đếm ngược Báo Công An, vô hiệu hóa mọi popup toast phụ để người chơi quan sát và bấm báo án chuẩn xác.',
    '  • Nâng Cao Z-Index & Tọa Độ Staff-Bar: Thanh công cụ staff-bar-wrap và nút Báo C.An luôn có z-index cao hơn toast (100010 vs 100000), đồng thời đẩy vị trí hiển thị của toast lên cao an toàn (72px / 125px) tránh đè quầy.'
  ]},
  {v:'12.47.443',d:'08/10/2026',items:[
    '⚡ Sửa Dứt Điểm Lỗi Gen Z Không Phục Vụ Khách Đầu Tiên:',
    '  • Loại Bỏ Điều Kiện Chặn Khách Nhầm Lẫn: Gỡ bỏ hoàn toàn bộ lọc playerTargetId gây khóa nhầm khách số 1 đứng đầu hàng khi người chơi có tiêu điểm mặc định.',
    '  • Phục Vụ Chuẩn FIFO Tuyệt Đối: Gen Z luôn phục vụ khách số 1 trước nhất, kết hợp cơ chế triage cứu hộ khẩn cấp khi có khách sắp hết kiên nhẫn (<= 40%).',
    '  • Độc Lập Hóa Quầy Pha Chế & Ly Của Nhân Viên (useStaffCup): Nhân viên tự tiêu thụ ly từ kho và gắn nhãn staff độc lập, không làm biến đổi trạng thái ly thủ công trên bàn.',
    '  • Nhận Diện Pha Thủ Công Chuẩn Xác (isPlayerCraftingCup): Quầy người chơi chỉ tính là đang pha khi có nguyên liệu thực tế (trà, hương, topping, đường, đá). Khi người chơi rảnh tay, toàn bộ hoạt ảnh của Gen Z hiển thị sống động trên quầy.',
    '  • Khóa Giữ Tiêu Điểm Bền Vững (playerSelectedCustId): Khách người chơi chủ động bấm chọn sẽ được giữ chắc chắn 100% đến khi hoàn tất đơn, không bị nhảy giật giao diện.'
  ]},
  {v:'12.47.442',d:'08/10/2026',items:[
    '🧋 Khắc Phục Triệt Để Lỗi Gen Z & Sinh Viên Bỏ Qua Khách Đầu Quầy:',
    '  • Ưu Tiên Chuẩn FIFO Theo Thứ Tự Đến: Nhân viên Gen Z và Sinh viên luôn ưu tiên phục vụ khách đứng đầu quầy từ trái sang phải (c.id nhỏ nhất đến trước).',
    '  • Triage Cứu Hộ Khẩn Cấp (Kiên Nhẫn <= 40%): Nếu có bất kỳ khách nào sắp hết kiên nhẫn (thanh màu cam/đỏ), nhân viên lập tức chuyển ưu tiên cấp cứu để tránh bị mất khách và trừ sao đánh giá.',
    '  • Tự Động Kích Hoạt NV Đi Chợ: Nếu khách thiếu nguyên liệu, nhân viên tự động tìm ly khác khả dụng trong đơn hoặc kích hoạt NV Đi chợ mua nguyên liệu tức thì.',
    '🎯 Sửa Lỗi Nhảy Đơn Sai Ly & Bảo Vệ Tuyệt Đối Ly Người Chơi Đang Pha:',
    '  • Khóa Giữ Tiêu Điểm Người Chơi (R.focus Lock): Khi người chơi bấm chọn khách hoặc chọn ly bất kỳ, hệ thống khóa cố định tiêu điểm và không bao giờ bị nhân viên cướp mất focus.',
    '  • Tách Biệt Độc Lập Quầy Thủ Công: Nhân viên pha chế trên không gian riêng, tuyệt đối không ghi đè hay xóa ly mà người chơi đang pha dở trên quầy.',
    '  • Khớp Đơn Chính Xác Tuyệt Đối (targetOrder): Đảm bảo ly người chơi pha luôn được so khớp với đúng khách hàng và đúng ly đang chọn, loại bỏ hoàn toàn việc bị phạt nhầm ly.'
  ]},
  {v:'12.47.441',d:'08/10/2026',items:[
    '💬 Sửa Lỗi Khách Hàng Không Trả Lời Phản Hồi Của Chủ Tiệm:',
    '  • Khai Báo Biến Phân Tích Cảm Xúc Đầy Đủ (isThanks, isApology, isFix, isPositive): Khắc phục triệt để lỗi ReferenceError khiến hàm tạo câu trả lời của khách (genCustomerReply) bị gián đoạn và bỏ trống Lượt 4 (Khách phản hồi lại).',
    '  • Cơ Chế Tự Động Phục Hồi & Bù Đắp Lượt 4: Khi mở tab Đánh giá, hệ thống sẽ tự động quét và tạo ngay câu trả lời cho toàn bộ các đánh giá mà chủ tiệm đã phản hồi trước đây nhưng khách chưa kịp rep.',
    '  • Bảo Vệ An Toàn Tuyệt Đối (Try-Catch & Fallback Response): Bọc khối lệnh an toàn trong hộp thoại gửi phản hồi và thiết lập câu thoại dự phòng chuẩn, đảm bảo khách hàng luôn phản hồi lại 100% trong mọi tình huống.'
  ]},
  {v:'12.47.440',d:'08/10/2026',items:[
    '✨ Khắc Phục Triệt Để Lỗi Text Nguyên Liệu Đứng Dọc (R&D Studio):',
    '  • Layout Thẻ Nút Thông Minh (Icon Trên, Tên Dưới): Tối ưu hóa các nút chọn Siro và Topping theo bố cục dọc (column layout) chuẩn game di động. Icon nằm giữa phía trên, tên nguyên liệu hiển thị ngang ngay bên dưới cân xứng tuyệt đẹp.',
    '  • Khóa Ngắt Dòng Ký Tự (word-break: keep-all): Loại bỏ hoàn toàn lỗi ngắt từng ký tự đơn lẻ (N-g-u-y-ê-n, Đ-à-o, C-h-o-c-o-l-a-t-e), văn bản luôn giữ nguyên vẹn từ ngữ trên mọi độ phân giải màn hình máy tính và điện thoại.',
    '  • Chiều Cao Đồng Bộ Chuẩn 56px: Đồng bộ chiều cao tất cả các nút trong lưới nguyên liệu giúp quầy R&D bắt trend vuông vức, thẩm mỹ và dễ thao tác.'
  ]},
  {v:'12.47.439',d:'08/10/2026',items:[
    '💡 Phí Gợi Ý Công Thức Bằng 5% Tiền Trong Két:',
    '  • Chi Phí Tư Vấn Động Theo Quy Mô Tiệm: Mỗi lần xem gợi ý công thức chuẩn sẽ tính phí bằng đúng 5% số dư két tiền hiện tại (Math.round(S.money * 0.05)), tạo tính chiến thuật và giá trị cho công sức nghiên cứu.',
    '  • Xác Nhận Minh Bạch & An Toàn: Hệ thống hiển thị rõ ràng số tiền 5% tương ứng trước khi người chơi quyết định mở khoá công thức.',
    '🔥 Mở Rộng Kho Món Hot Trend Siêu Khủng (Gấp Đôi Số Lượng):',
    '  • Bổ Sung 11 Món Trend Mới (Tổng cộng 22 Món): Trà Thái Xanh Thạch Phô Mai, Trà Ổi Hồng Kem Cheese, Trà Xoài Nhiệt Đới Trân Châu Nổ, Ô Long Nướng Kem Khoai Môn, Trà Dâu Tây Phô Mai Tươi, Trà Sữa Thạch Cà Phê, Lục Trà Vải Củ Năng, Trà Me Đá Tuyết Sương Sáo, Trà Sữa Socola Phô Mai Viên, Trà Dưa Gang Kem Muối, Hồng Trà Nho Đen Trân Châu Hoàng Kim.',
    '  • Đa Dạng Tệp Khách & Mùa Thời Tiết: Bổ sung câu chuyện viral, trích dẫn khách hàng, hashtag TikTok và hiệu ứng kích cầu thời tiết phong phú.'
  ]},
  {v:'12.47.438',d:'08/10/2026',items:[
    '🧹 Xóa Bỏ Hoàn Toàn Dòng Radar Trend Trùng Lặp Trên Bảng Menu:',
    '  • Tối Giản Bảng Menu Hôm Nay: Đã loại bỏ dòng widget "RADAR TREND: ... Bùng Nổ Viral ...", giữ lại duy nhất thẻ món Trend trực quan nằm gọn gàng trên bảng phấn Chalkboard.',
    '✨ Cân Xứng Hoàn Hảo Text & Icon Bàn Pha Chế R&D:',
    '  • Đồng Bộ Kích Thước & Căn Lề Trực Quan: Đổi tên nút thành "Kem môn" (chuẩn 2 từ như Kem cheese, Kem matcha, Kem muối) để triệt tiêu tình trạng vỡ dòng 3 tầng, đồng bộ chiều cao toàn bộ các nút trong lưới (44px).',
    '  • Chuẩn Hóa Cặp Icon Đôi: Bổ sung biểu tượng đôi đồng bộ cho tất cả các loại Kem (🟡🟡, 🟢🟢, ⚪⚪, 🟣🟣) và Thạch PM (🟨🟫), giúp chiều rộng icon cố định 25px và văn bản căn lề trái thẳng tắp, cân xứng tuyệt đối.'
  ]},
  {v:'12.47.437',d:'08/10/2026',items:[
    '📋 Áp Món Trend Mới Vào Bảng Menu Hôm Nay (menuBoard):',
    '  • Hiển Thị Món Trend Trực Quan Trên Menu Quán: Bảng phấn Menu Hôm Nay hiển thị món Hot Trend với huy hiệu nổi bật, nguyên liệu công thức chuẩn, và tình trạng (ĐÃ ÁP VÀO MENU · ★★★★★ hoặc CHƯA R&D).',
    '  • Chạm Trực Tiếp Để Mở R&D: Người chơi có thể bấm trực tiếp vào thẻ món Trend trên Bảng Menu để mở ngay Bàn Pha Chế R&D hoặc quản lý cơn sốt thị trường.',
    '  • Khách Hàng Gọi Món Trend: Sau khi hoàn tất R&D áp vào Menu, khách hàng đến quán sẽ bắt đầu gọi món Trend mới (tỷ lệ 25-40%), tính đúng giá niêm yết của ly nước.',
    '💰 Phí R&D Bằng Chính Giá Bán Của Ly Nước:',
    '  • Chi Phí Nghiên Cứu & Phát Triển Chuẩn Xác: Phí R&D khi ra mắt món mới bằng đúng tổng giá bán niêm yết của ly đó trên bảng giá (thay cho mức cố định 30k hay 0đ).',
    '  • Kiểm Tra Két Tiền & Ghi Nhận Chi Phí: Hệ thống kiểm tra số dư két trước khi ra mắt món, trừ đúng số tiền phí R&D và hạch toán vào chi phí trong ngày (R.today.fee).'
  ]},
  {v:'12.47.436',d:'08/10/2026',items:[
    '🥛 Chuẩn Hóa Tên Gọi "Kem" (Thay Cho "Kem Sữa", "Foam" & "ube"):',
    '  • Đổi "Kem Sữa" Thành "Kem": Rút gọn tên gọi trên toàn bộ hệ thống từ "Kem Sữa cheese" ➔ "Kem cheese", "Kem Sữa matcha" ➔ "Kem matcha", "Kem Sữa muối" ➔ "Kem muối", "Kem Sữa khoai môn" ➔ "Kem khoai môn".',
    '  • Khắc Phục Triệt Để Tên "Foam" & "ube" Tại Bàn Pha Chế R&D: Danh mục "3. Topping & Foam" đổi thành "3. Topping & Kem"; các nút nguyên liệu hiển thị chuẩn tiếng Việt thuần "Kem cheese", "Kem matcha", "Kem muối", "Kem khoai môn" (thay cho F.cheese, F.matcha, F.muối, F.ube).',
    '  • Đồng Bộ Nhãn Quầy Pha Chế & Hướng Dẫn: Các khay rót kem quầy pha chế hiển thị nhãn KEM CHEESE, KEM MATCHA, KEM MUỐI, KEM KHOAI MÔN chuẩn chỉnh, đồng bộ trên toàn bộ game.'
  ]},
  {v:'12.47.435',d:'08/10/2026',items:[
    '💰 Giá Đề Xuất Bằng Tổng Giá Nguyên Liệu Trên Bảng Giá (S.sell / DEF_SELL):',
    '  • Tính Chuẩn Xác Theo Bảng Giá Của Quán: Giá đề xuất của ly nước R&D tự động tính bằng tổng giá bán niêm yết của Cốt trà nền, Hương vị siro và Topping trên bảng giá của tiệm (thay vì công thức nhân vốn cũ).',
    '  • Phản Ánh Trực Quan Mọi Tùy Chỉnh Giá: Người chơi điều chỉnh giá bán trong tab Giá Bán thì giá đề xuất của món Trend sẽ tự động cập nhật chuẩn xác theo thời gian thực.',
    '🚀 Ra Mắt Món Hoàn Toàn Miễn Phí (Bỏ Phí R&D 30k):',
    '  • Xóa Bỏ Hoàn Toàn Phí R&D 30k: Người chơi thỏa sức sáng tạo công thức và đưa món hot trend lên Menu bán hàng với chi phí 0đ (hoàn toàn miễn phí).',
    '  • Tối Ưu Nút & Hộp Thoại Ra Mắt: Nút "🚀 Ra Mắt Món" tinh gọn, thân thiện, không còn rào cản tài chính làm gián đoạn trải nghiệm bắt trend.'
  ]},
  {v:'12.47.434',d:'08/10/2026',items:[
    '💡 Cảnh Báo Chưa Đúng Món & Gợi Ý Nguyên Liệu Món Trend (R&D Studio):',
    '  • Cảnh Báo Thông Minh Khi Chưa Đúng Món: Khi thử nghiệm công thức chưa khớp chuẩn món Trend, hệ thống dừng lại thông báo rõ ràng "Chưa chế tạo đúng món, có muốn xem gợi ý hay không?" thay vì tự ý trừ tiền hay ra mắt công thức lỗi.',
    '  • Bảng Gợi Ý Chi Tiết 3 Tầng Nguyên Liệu: Nhấn vào xem gợi ý sẽ hiển thị chính xác Cốt trà nền, Hương vị siro và Topping cần thiết cho món Trend.',
    '  • Nút "Tự Động Chọn Đúng Nguyên Liệu": Hỗ trợ chọn nhanh toàn bộ nguyên liệu chuẩn chỉ với 1 chạm, đưa độ Hype lên 100% để ra mắt món 5★ hoàn hảo.',
    '  • Bổ Sung Nút "Gợi Ý" Tại Bàn Pha Chế: Người chơi có thể tra cứu gợi ý nguyên liệu món Trend bất kỳ lúc nào ngay trên thanh tiêu đề và thẻ xem trước.',
    '🧴 Nhân Viên Gen Z Tự Động Gợi Ý & Mua Hương Siro:',
    '  • Gợi Ý Mua Hương Siro Trong Tab Kho: Nhân viên Gen Z tự động phân tích nhu cầu và gợi ý đặt hàng các loại hương siro / mứt đang kinh doanh hoặc hương cần thiết cho món Trend đang sốt.',
    '  • Áp Dụng 1 Chạm Tự Động Đặt Hàng: Bấm "Áp dụng gợi ý Gen Z" sẽ tự động lên kế hoạch mua đầy đủ cả Trà, Topping, Ly, Đá, Đường và Hương siro.',
    '  • Tự Động Đi Chợ Mua Hương Khi Sắp Hết (<= 2 ly): Khắc phục lỗi đội đi chợ bỏ quên hương siro, tự động xuất phát đi mua bổ sung ngay khi phát hiện đơn hàng cần hương.'
  ]},
  {v:'12.47.433',d:'08/10/2026',items:[
    '✨ Tối Ưu Toàn Diện Typography & Ngắt Dòng Trên Giao Diện Bắt Trend Mobile:',
    '  • Sửa Triệt Để Lỗi Chèn Icon & Gãy Tiêu Đề: Tiêu đề Bàn Pha Chế R&D được tinh chỉnh ngắn gọn, cố định icon ly trà 🧋 luôn đứng đầu dòng, hoàn toàn không còn hiện tượng chữ gãy 3 hàng hay icon rớt lơ lửng giữa câu.',
    '  • Thiết Kế Lại Banner Đã Ra Mắt & Tệp Khách: Tách biệt rõ ràng huy hiệu trạng thái, tên món trà và lời thoại thành các dòng thông tin chuyên nghiệp; loại bỏ hiện tượng rớt chữ (như "🍋 Trà / Chanh Giã Tay" hay "Học sinh - / Sinh viên").',
    '  • Tinh Gọn Tiêu Đề Danh Mục Nguyên Liệu: Tiêu đề Cốt trà, Hương vị, Topping được bổ sung nhãn huy hiệu (Chọn 1, Tuỳ chọn, Tối đa 3) căn lề tự nhiên, không còn bị ngắt dòng cụt lủn.',
    '  • Thanh Mini HUD Chống Ép Khung: Cố định kích thước thanh tiến độ Hype trên điện thoại, đảm bảo luôn hiển thị sắc nét và thoáng đãng.'
  ]},
  {v:'12.47.432',d:'08/10/2026',items:[
    '👥 Cân Bằng Lại Tỉ Lệ Drama Nhân Viên (Tối Thiểu 10%, Tối Đa 20%):',
    '  • Giảm Đáng Kể Tần Suất Nổ Drama: Giảm mạnh tỉ lệ phát sinh sự kiện drama nhân sự từ mức cũ (20% - 50%) xuống khoảng dễ chịu: Tối thiểu 10% khi có 1 nhân viên và tối đa 20% khi tuyển đông nhân sự.',
    '  • Ổn Định Vận Hành & Hạn Chế Nghỉ Đột Xuất: Giúp quán vận hành êm ả, dòng tiền và năng suất bán hàng ổn định, nhân sự gắn bó dài lâu hơn.',
    '  • Đồng Bộ Giao Diện & Bảng Mô Tả Nâng Cấp: Cập nhật thông tin hướng dẫn trong tab Nâng Cấp Nhân Viên chính xác theo tỉ lệ mới (Nền 10%, mỗi nhân sự +2%, tối đa 20%).'
  ]},
  {v:'12.47.431',d:'08/10/2026',items:[
    '📱 Tối Ưu Trải Nghiệm R&D Bắt Trend Trên Điện Thoại (Xem Trực Tiếp Ly Nước & Độ Hype):',
    '  • Thanh Sticky Live Hype & Cup HUD Ghim Nổi Đầu Trang: Khi cuộn chọn Cốt trà, Hương vị hay Topping trên điện thoại, thanh Live HUD luôn ghim nổi ở đỉnh khung; cập nhật trực tiếp màu nước trà, lớp kem foam, trân châu và thanh Hype % theo thời gian thực (Real-time) trên từng cú chạm.',
    '  • Nút "Xem Ly 🔍" Mở Modal Phóng To Tức Thì: Bấm vào ly nước mini hoặc nút "Xem ly" trên thanh HUD để bật cửa sổ phóng to ly nước 3D cùng nút "Ra mắt món" ngay tại chỗ mà không cần phải cuộn lên cuộn xuống.',
    '  • Giữ Vững Vị Trí Cuộn (Scroll Anchor): Tự động bảo lưu tọa độ cuộn màn hình khi đổi nguyên liệu, loại bỏ hoàn toàn hiện tượng giật nảy trang trên điện thoại.',
    '  • Cố Định Cột Xem Trước Trên Máy Tính (Desktop Sticky): Khung ly nước lớn bên cột phải tự động bám theo tầm mắt khi cuộn nguyên liệu bên trái.'
  ]},
  {v:'12.47.430',d:'08/10/2026',items:[
    '🗺️ Khắc Phục Triệt Để Hiện Tượng Chồng Chữ & Lệch Ghim Trên Bản Đồ Khởi Nghiệp Việt Nam (mapvn):',
    '  • Định Vị Nhãn Đa Hướng (Top / Bottom / Left / Right): Thiết lập hướng bung nhãn địa điểm thông minh theo từng vùng miền (Đà Lạt hướng phải ra biển, Buôn Ma Thuột hướng lên, TP.HCM hướng trái, Vũng Tàu hướng phải, Cố đô Huế hướng trái, Đà Nẵng hướng phải...).',
    '  • Tách Biệt Tuyệt Đối Các Cặp Điểm Gần Nhau: Buôn Ma Thuột & Đà Lạt, TP.HCM & Vũng Tàu, Huế & Đà Nẵng được cân chỉnh tọa độ và hướng nhãn chính xác với tranh minh họa bản đồ, khoảng cách dãn rộng an toàn, hoàn toàn không còn va chạm hay che khuất.',
    '  • Cố Định Tâm Ghim & Tương Tác Nhạy Bén: Tâm ghim tròn luôn cố định chuẩn xác tại tọa độ tỉnh thành, hỗ trợ bấm trực tiếp vào cả ghim lẫn nhãn tên để lướt ngay tới thẻ địa điểm kinh doanh tương ứng.'
  ]},
  {v:'12.47.429',d:'08/10/2026',items:[
    '💰 Chuẩn Hóa Toàn Diện Đơn Vị Tiền Tệ Trong Toàn Bộ Game (1.000k ➔ 1tr, 1.000tr ➔ 1 tỉ):',
    '  • Triệt Tiêu Lỗi Định Dạng Hàng Triệu K (58.060,6k & 7.653.335k): Sửa triệt để cách định dạng trong Báo Cáo P&L Chuẩn F&B và tab Tổng Kết Ngày/Tuần/Tháng; loại bỏ hoàn toàn việc chia 1.000 rồi ghép cứng đuôi "k".',
    '  • Cơ Chế Rollover Tự Động: Đảm bảo mọi con số khi làm tròn đạt 1.000k tự động chuyển sang đơn vị "tr", đạt 1.000tr tự động chuyển sang đơn vị "tỉ", và 1.000 tỉ tự động chuyển sang "k tỉ".',
    '  • Hiển Thị Chuẩn Xác Từng Khoản Mục: Doanh thu, chi phí, lãi lỗ, COGS, lương nhân sự, CAPEX và két tiền đều hiển thị đơn vị trực quan, dễ đọc (ví dụ: 58,06tr; −7,65 tỉ; 150k; 500đ).'
  ]},
  {v:'12.47.428',d:'08/10/2026',items:[
    '📖 Bổ Sung Mục "Mở Khoá Công Thức" Cho Nhân Viên Yêu Cầu Công Thức Độc Bản:',
    '  • Hiển Thị Khung Mở Khoá Trực Quan: Thêm mục "Mở khoá công thức" ngay bên dưới ô nhân viên (Chú bảo vệ, Chiến thần xa lộ, Quản gia, Nhân diên zọn zẹp) yêu cầu công thức độc bản.',
    '  • Theo Dõi Tiến Độ Sưu Tầm: Hiển thị rõ số lượng công thức đã mở / số lượng cần mở (1, 3, 5, 10 công thức) kèm trạng thái Đủ điều kiện / Chưa đủ.',
    '  • Truy Cập Nhanh Sưu Tầm: Bấm trực tiếp vào nút "Mở khoá công thức" hoặc khung thông tin sẽ mở ngay Bộ Sưu Tập Nguyên Liệu & Công Thức Độc Bản để quay gacha và ghép công thức tiện lợi.'
  ]},
  {v:'12.47.427',d:'08/10/2026',items:[
    '📱 Tinh Gọn Báo Cáo Hết Ngày Vừa Khít 1 Khung Hình (Zero-Scroll Fit):',
    '  • Tối Ưu Bố Cục Không Cần Cuộn: Toàn bộ bảng kết ca vừa khít hoàn hảo trong một màn hình (kể cả trên điện thoại và laptop), không cần kéo hay cuộn trang.',
    '  • Hợp Nhất Dải Dòng Tiền & P&L F&B: Thay thế bảng tóm tắt rời rạc cũ bằng dải 4 chỉ số dòng tiền hiện đại (Thu, Chi, Lãi/Lỗ, Két) tích hợp trực tiếp trên đầu Báo Cáo P&L.',
    '  • Thẻ Chỉ Số & Bác Sĩ F&B Siêu Tinh Gọn: Thiết kế lại 3 ô KPI (COGS, Nhân sự, Hòa vốn) và hộp chẩn đoán bác sĩ F&B dạng thanh gọn gàng, trực quan.',
    '  • Nút Bấm Kết Ca Xếp Ngang: Hai nút "Tổng kết" và "Ngày tiếp theo ➜" được sắp xếp song song nằm gọn gàng ở đáy khung.'
  ]},
  {v:'12.47.426',d:'08/10/2026',items:[
    '📊 Đưa Báo Cáo P&L Chuẩn F&B Lên Vị Trí Nổi Bật Báo Cáo Hết Ngày:',
    '  • Hiển Thị Ngay Khi Kết Ca: Báo Cáo Phân Tích Lỗ Lãi P&L Chuẩn F&B (với thanh cơ cấu doanh thu, tỷ lệ COGS nguyên liệu, chi phí nhân sự, điểm hòa vốn và chẩn đoán bác sĩ F&B) được đưa thẳng ra màn hình báo cáo hết ca thay vì bị ẩn trong menu thu gọn.',
    '  • Tách Biệt CAPEX (Đầu Tư Tài Sản) Khỏi OPEX Vận Hành: Khoản mua sắm thiết bị, máy móc và mở rộng cơ sở (CAPEX) được tách riêng độc lập, không còn bị cộng dồn làm méo mó phần trăm chi phí Khác (sửa triệt để lỗi Khác nhảy 18327%).',
    '  • Tinh Chỉnh Đánh Giá & Chẩn Đoán F&B: Hiển thị chuẩn xác khi COGS = 0% ("Chưa tốn nguyên liệu") hoặc nhân sự tự vận hành, bác sĩ F&B chẩn đoán thông minh dựa trên doanh số và sản lượng hòa vốn.',
    '🔥 Xóa Bỏ Biểu Tượng Lửa Trùng Lặp Ở Dưới Thanh Menu Radar Trend:',
    '  • Loại bỏ icon ngọn lửa thừa nằm dưới chữ "Radar Trend" trong thanh menu điều hướng tab.'
  ]},
  {v:'12.47.425',d:'08/10/2026',items:[
    '🤵 Sửa Triệt Để Cảnh Báo "1 Ly Quá 120k" Khi Đã Thuê Quản Gia:',
    '  • Khắc Phục Lỗi Cảnh Báo 120k: Khi có Quản Gia, xoá bỏ hoàn toàn cảnh báo "Một ly trên 120k thì 60% khách bỏ đi", thay bằng huy hiệu xanh bảo chứng: "Quản gia bảo chứng toàn diện: Mức ly đắt nhất hiện tại đã được bảo trợ hoàn toàn — khách 100% không chê đắt hay bỏ đi!".',
    '  • Bảo Trợ Toàn Bộ Menu & Khắc Phục Khách Bỏ Đi: Đảm bảo mọi món trong menu khi có Quản gia (kể cả món thông thường và món Best Seller/ngẫu nhiên) đều được Quản gia bảo trợ miễn nhiễm phạt giá nếu đặt trong trần cho phép sellMax, khách không còn bỏ về và không đánh giá 1★-2★ do giá.',
    '  • Hiển Thị Nhãn "Quản gia bảo trợ" Rõ Ràng: Trong tab Định Giá, từng dòng cốt trà, hương vị, topping và Size L đều hiển thị nhãn xác nhận Quản gia bảo trợ màu xanh lá uy tín.',
    '🧹 Tối Ưu Hóa & Dọn Dẹp Mã Nguồn Toàn Diện (Làm Nhẹ Giảm Lag):',
    '  • Dọn Sạch Hơn 3.5MB Tệp Tin Trùng Lặp & Dư Thừa: Loại bỏ 13 file ảnh nền địa phương trùng lặp ngoài thư mục gốc, dọn dẹp các tệp stub rác, tối ưu cây thư mục sạch đẹp.',
    '  • Triệt Tiêu Vòng Lặp Rò Rỉ CPU: Bổ sung cơ chế tự ngắt animation vòng lặp xe shipper và bộ đếm tiền giả khi đóng cửa sổ hoặc hết ca, giảm giật lag triệt để.',
    '  • Đồng Bộ Bộ Nhớ Đệm Toàn Diện (Cache-Busting): Chuẩn hoá 100% phiên bản tệp tin script và stylesheet về cùng bản 12.47.425, triệt tiêu mọi xung đột bộ nhớ đệm trình duyệt.'
  ]},
  {v:'12.47.424',d:'08/10/2026',items:[
    '🧋 Ra Mắt Bàn Pha Chế Thí Nghiệm (Mix & Match) Sáng Tạo Đu Trend:',
    '  • Thay Thế Hệ Thống Chọn 2 Nút Cũ: Thay thế 2 nút R&D Cấp Tốc / Chuyên Nghiệp bằng bàn pha chế thí nghiệm trực quan, cho phép người chơi tự tay tuyển chọn nguyên liệu sáng tạo món.',
    '  • Tự Do Phối Trộn 3 Tầng Nguyên Liệu: Lựa chọn 6 Cốt trà nền, 13 Hương vị trái cây & đặc biệt, 16 loại Topping & Kem Sữa Foam phong phú.',
    '  • Khung Xem Trước Ly Nước Trực Quan: Đổi màu nước trà theo cốt nền, hiển thị bọt kem foam bồng bềnh, đá viên, topping trân châu và tem dán Solomomo đáng yêu.',
    '  • Máy Tính Độ Hype & Định Giá Thị Trường: Dự báo độ sốt trend từ 30% COLD đến 100% VIRAL PEAK, tự động tính giá vốn và giá bán đề xuất.',
    '  • Ra Mắt Món (Phí R&D 30k): Đạt 100% khớp chuẩn vị 5 sao hoàn hảo (+20% khách ghé quán), đạt 70-90% mở khóa 3 sao nhạy trend.'
  ]},
  {v:'12.47.423',d:'08/10/2026',items:[
    '🔥 Sửa Lỗi Không Mở Được Radar Trend & R&D Menu Lab:',
    '  • Khắc Phục Triệt Để Sự Cố Bấm Vào Radar Trend Không Phản Hồi: Tích hợp đầy đủ bộ điều hướng trend vào hệ thống chuyển tab switchTab.',
    '  • Hỗ Trợ Mở Toàn Diện: Nhấp vào nút \"Mở Radar\" hoặc bảng hiệu Radar Trend trên Quầy Menu Board tự động chuyển tab và cuộn mượt (smooth scroll) đến khu vực R&D Lab.',
    '  • Mở Tra Cứu Radar Trend Trong Ca Bán Hàng: Người chơi có thể tra cứu thông tin món Trend, nhiệt độ và R&D ngay trong quầy tra cứu giữa giờ mở tiệm.'
  ]},
  {v:'12.47.422',d:'08/10/2026',items:[
    '🔥 Nâng Cấp Hệ Thống Bắt Trend Món Hot F&B & Radar Thị Trường (R&D Menu Lab):',
    '  • Sửa Triệt Để Lỗi Vào Game: Tối ưu hoá luồng khởi tạo Radar Trend, xử lý chống đệ quy và bảo toàn hiển thị khu vực pha chế.',
    '  • Bổ Sung Đầy Đủ 4 Mục Marketing Kích Cầu: Treo Standee Món Hot (+25% khách), Booking Food Reviewer (+15% nhiệt & viral), Combo Đu Trend (xả kho cũ), Livestream TikTok Giờ Vàng (+35% đơn Online).',
    '  • Mở Rộng Kho 11 Món Hot Trend F&B: Bổ sung Matcha Latte, Trà Sữa Cốm Dẻo, Trà Măng Cụt, Trà Dâu Tằm, Trà Đào Cam Sả và đổi Trà Sữa Hành Lá thành Trà Sữa Chuối Chiên thơm béo giòn rụm.',
    '  • Cân Bằng Chu Kỳ 4 Giai Đoạn & Xả Kho Thanh Lý: Vận hành trơn tru chu kỳ từ Chớm nở ➔ Bùng nổ Viral ➔ Bão hòa ➔ Sập trend cùng tính năng thanh lý 50% vốn chống ôm bom.'
  ]},
  {v:'12.47.420',d:'08/10/2026',items:[
    '🎭 Tối Ưu Chuẩn Xác Tỉ Lệ Drama Nhân Viên (Nền 20%, Mỗi NV +5%, Tối Đa 50%):',
    '  • Tỉ lệ drama được cân bằng chuẩn xác: Nền 20% + 5% cho mỗi nhân viên đã tuyển (tối đa đạt 50%).',
    '  • Toàn bộ nhân viên đã thuê đều có hệ thống drama phong phú, đặc biệt bổ sung bộ drama riêng cho Chú Bảo Vệ, Quản Gia và Nhân Diên Zọn Zẹp.',
    '  • Quản gia không còn tự động xóa bỏ biến cố drama trong ngày, đảm bảo mọi nhân sự đều có cơ hội xuất hiện tương tác hài hước.'
  ]},
  {v:'12.47.419',d:'08/10/2026',items:[
    '🎭 Tăng Mạnh Tỉ Lệ Xuất Hiện Drama Nhân Viên (Khởi điểm 35% – Tối đa 70%):',
    '  • Tăng vọt tỉ lệ nổ drama nhân sự (nộp đơn xin nghỉ việc báo trước, vòi tiền tạm ứng nạp game/hẹn hò, đòi thưởng nóng khi quán đông, xin nghỉ phép độc lạ, xin đến trễ...).',
    '  • Tỉ lệ cơ bản khởi điểm từ 35% khi có 1 nhân viên và tăng thêm 10% với mỗi nhân viên làm việc (tối đa lên đến 70%).',
    '  • Đảm bảo ngay cả khi có Quản gia, các tương tác drama hài hước của nhân sự và bản thân Quản gia vẫn có thể diễn ra đầy thú vị.'
  ]},
  {v:'12.47.418',d:'07/10/2026',items:[
    '🛡️ Điều Chỉnh Cơ Chế Bảo Vệ & Trộm Két Tiền Vượt Mức:',
    '  • Chú bảo vệ cam kết 100% chặn đứng mọi hành vi trộm cắp, ôm ly bùng tiền, trả thiếu, mặc cả và tiền giả trong suốt ca bán hàng.',
    '  • Khi số tiền mặt trong két vượt mức quy định hoặc vượt ngưỡng an toàn ban đêm, nguy cơ trộm cắp, cạy két vẫn diễn ra bình thường (chú bảo vệ chỉ làm việc trong giờ bán hàng).'
  ]},
  {v:'12.47.417',d:'07/10/2026',items:[
    '🎲 Cân Bằng Chuẩn Xác Tỉ Lệ Trùng Mở Túi Bộ Sưu Tập (50% – 70%):',
    '  • Điều chỉnh tỉ lệ mở ra thẻ trùng khớp hoàn hảo theo khoảng 50% – 70% (tỉ lệ ra thẻ mới tương ứng 30% – 50%).',
    '  • Giữ nguyên cơ chế chống xuất hiện các thẻ giống nhau trong cùng 1 túi quà 3 thẻ.'
  ]},
  {v:'12.47.416',d:'07/10/2026',items:[
    '🎁 Tối Ưu Cơ Chế Mở Túi Bộ Sưu Tập Nguyên Liệu (Giảm Tỉ Lệ Trùng):',
    '  • Tăng vọt tỉ lệ ra thẻ MỚI (chưa sở hữu) lên 75% – 95% khi bậc hiếm tương ứng còn nguyên liệu chưa mở.',
    '  • Loại bỏ hoàn toàn tình trạng mở ra các thẻ giống hệt nhau trong cùng một túi quà 3 thẻ.',
    '  • Cơ chế bảo hiểm thẻ mới (New Card Pity Shield): Đảm bảo chắc chắn nhận ít nhất 1 nguyên liệu mới tinh trong mỗi túi quà nếu bộ sưu tập còn nguyên liệu chưa mở.'
  ]},
  {v:'12.47.415',d:'07/10/2026',items:[
    '✨ Cập Nhật Tên Gọi Topping & Kem Sữa Chuẩn Phong Vị:',
    '  • Đổi tên danh mục "Foam" thành "Kem Sữa" trên toàn bộ giao diện và quầy pha.',
    '  • Đổi tên các loại kem phủ: Kem Sữa cheese, Kem Sữa matcha, Kem Sữa muối, Kem Sữa khoai môn (trước là Foam ube).',
    '  • Đổi tên topping "Trân châu nổ" thành "Trân châu 3Q".',
    '  • Đổi tên topping "Trân châu sợi" thành "Trân châu mini".',
    '  • Đồng bộ nhãn thùng nguyên liệu quầy pha: KEM SỮA CHEESE, KEM SỮA MATCHA, KEM SỮA MUỐI, KEM SỮA KHOAI MÔN.'
  ]},
  {v:'12.47.414',d:'07/10/2026',items:[
    '🗺️ Cân Bằng Chuẩn Xác Ưu & Nhược Điểm Các Địa Điểm Khởi Nghiệp Bản Đồ Việt Nam:',
    '  • Hà Nội: Lượng khách ghé quán +12%, Tiền boa +12%; Khách sành điệu, khó tính +5% tỷ lệ khách khó tính (bỏ phạt -1★ ly hỏng).',
    '  • Đà Nẵng: 0% tiền giả, Khách hàng ổn định, ít rủi ro gian lận, khách mua nhiều ly (2–4 ly); Khách nhạy cảm với giá: tăng giá bán → -10% khả năng mua.',
    '  • Vũng Tàu: Cuối tuần +20% lượng khách, Khách du lịch +15% tiền boa; Mưa → -20% lượng khách, Ngày thường -8% lượng khách.',
    '  • Đà Lạt: Không đá +20% giá trị đơn, Khách VIP +20% tiền boa; 100% đá -15% tiền boa, Mưa → -15% lượng khách, Nguyên liệu đặc sản +10% giá vốn.',
    '  • Phú Quốc: Khách cao cấp +25% tiền boa, Khách khu nghỉ dưỡng +20% giá trị đơn, Khách ngôi sao quốc tế x1,5 tần suất; Giá vốn nguyên liệu +15%, Khách địa phương -10%, Đơn trực tuyến -15%.'
  ]},
  {v:'12.47.413',d:'07/10/2026',items:[
    '🏮 Thêm Thông Báo Trạng Thái Sảnh Trà Đóng Cửa:',
    '  • Thêm thông báo rõ ràng khi sảnh trà chưa vào ca: "Sảnh trà chỉ mở cửa khi vào ngày mới, hiện sảnh trà đang đóng cửa".',
    '  • Hiển thị thông báo tức thì qua Toast và Banner cảnh báo nổi bật ngay đầu Sảnh Tiệm khi người chơi truy cập Sảnh Trà trong thời gian quán chưa mở cửa ngày mới.',
    '  • Cập nhật huy hiệu trạng thái quầy và thanh hướng dẫn tại khu vực hàng chờ quầy sảnh trà.'
  ]},
  {v:'12.47.412',d:'07/10/2026',items:[
    '🤵 Nâng Cấp Toàn Diện Cơ Chế Giá Quản Gia (Bác Phúc) - Kịt Trần & Không Chê Đắt:',
    '  • Bỏ tăng giá 10% toàn bộ menu: Quản gia không còn tự ý tăng giá 10% tràn lan toàn bộ các món. Các món thông thường giữ nguyên giá chuẩn (DEF_SELL) an toàn, khách hàng không chê đắt.',
    '  • Tối ưu kịt trần +30% cho 3 món Best Seller & 3 món ngẫu nhiên mỗi ngày: Chỉ 3 món bán chạy nhất và 3 món được chọn ngẫu nhiên mỗi ngày mới được Quản gia nâng giá kịt trần (+30%), khách hàng 100% không bao giờ phàn nàn giá.',
    '  • Giữ nguyên giá người chơi tùy chỉnh: Quản gia bảo vệ mức giá người chơi đã tự điều chỉnh trong mục Giá Bán, không tự ý ghi đè hay reset về giá gốc.'
  ]},
  {v:'12.47.411',d:'07/10/2026',items:[
    '🏮 Sửa Ô Màu Trắng Tại Sảnh Trà & Tự Do Khởi Nghiệp:',
    '  • Khắc phục triệt để ô màu trắng ở Sảnh Trà: Mặc định ẩn hoàn toàn ô Live Barista HUD khi quầy chưa pha chế hoặc chưa vào ca bán, trả lại bức tranh minh họa quầy pha chế và sảnh tiệm trọn vẹn, không bị che khuất.',
    '  • Tắt toàn bộ điều kiện mở Full Menu ở Khởi Nghiệp Xuyên Việt: Người chơi có thể tự do dọn quán và khởi nghiệp tại bất kỳ tỉnh thành nào trên bản đồ Việt Nam mà không bị ràng buộc mở khóa 100% menu.'
  ]},
  {v:'12.47.410',d:'07/10/2026',items:[
    '🎩 Sửa Chuẩn Xác Cơ Chế Giá Quản Gia & Khắc Phục Lỗi Hoàn Tác Giá:',
    '  • Bỏ mức giá ảo 250k: Sửa toàn diện trần giá Quản Gia bảo chứng theo đúng bản chất nguyên liệu thực tế (Trà 40k-50k, Topping/Hương 30k, Size L 50k, Ly trà 120k).',
    '  • Chuẩn quy tắc giá Quản Gia: Toàn bộ các món tăng +10% giá mắc (giá bảo chứng không phàn nàn), riêng Best Seller tăng +30% giá mắc.',
    '  • Khắc phục triệt để lỗi không thể tăng giá / bị quay lại giá cũ: Hệ thống ghi nhận và bảo vệ vĩnh viễn mức giá người chơi đã tự điều chỉnh, Quản Gia không còn tự ý ghi đè hay reset về giá gốc.',
    '  • Cập nhật thông báo và nhãn hiển thị tại Tab Giá Bán & Menu Board: Hiển thị nhãn bảo chứng rõ ràng (+10% / +30%), thông báo cảnh báo giá mắc minh bạch.'
  ]},
  {v:'12.47.409',d:'07/10/2026',items:[
    '👥 Nâng Cấp Toàn Diện Cơ Chế Cho Nghỉ Việc & Sa Thải Nhân Viên:',
    '  • Khắc phục triệt để lỗi không cho nhân viên nghỉ việc được: Sửa xung đột với Quản Gia (Bác Phúc tự động ép nhân viên đi làm lại mỗi frame), Quản Gia giờ đây tuyệt đối tôn trọng quyết định cho nghỉ của chủ quán.',
    '  • Phân định rõ ràng giữa "Tạm nghỉ ca" và "Cho nghỉ việc hẳn (Sa thải)": Hộp thoại trực quan cho phép chọn Tạm nghỉ ca (không tính lương ca, giữ slot, có thể gọi lại miễn phí bất kỳ lúc nào) hoặc Sa thải hẳn (chấm dứt hợp đồng, rời khỏi tiệm hoàn toàn).',
    '  • Bổ sung nút "Sa thải" tiện lợi cạnh nút "Gọi đi làm": Xuất hiện khi nhân viên đang nghỉ tại Tab Quản Lý Nhân Sự, Tab Nâng Cấp và Bảng Xét Lương KPI.'
  ]},
  {v:'12.47.408',d:'07/10/2026',items:[
    '📱 Tối Ưu Hóa Giao Diện Quầy Pha Chế Thu Nhỏ Trên Điện Thoại: Ly trà, topping và thớt gỗ hiển thị vừa vặn sắc nét 100%, không bị cắt góc hay tràn viền màn hình.'
  ]},
  {v:'12.47.406',d:'07/10/2026',items:[
    '🇻🇳 Thuần Việt Hóa Ưu & Nhược Điểm Khởi Nghiệp: Dịch trọn vẹn 100% các thuật ngữ tiếng Anh và viết tắt (COGS, Traffic, Resort, VIP, Big Order, International Star...) sang tiếng Việt rõ ràng, dễ hiểu.',
    '🌐 Tối Ưu Triệt Để Chống Lỗi Cập Nhật & "Site Not Found": Chuẩn hóa cơ chế làm sạch URL không dùng query params rác, tích hợp trang chuyển hướng 404.html thông minh, sẵn sàng đưa lên mọi nền tảng web hosting an toàn tuyệt đối.'
  ]},
  {v:'12.47.405',d:'07/10/2026',items:[
    '🗺️ Điều Kiện Khởi Nghiệp Xuyên Việt (Full Menu): Tiệm cần mở khóa đủ 100% toàn bộ Trà, Hương siro và Topping để có thể chuyển địa điểm khởi nghiệp tới 10 tỉnh thành; bổ sung bảng tiến độ trực quan và hướng dẫn chi tiết.',
    '🥄 Hiệu Ứng Bỏ Topping Của Nhân Viên Gen Z: Đồng bộ chuyển động muỗng múc topping, hạt trân châu/thạch rơi nảy vào ly và bơm siro sống động tương tự Sinh Viên Ca Đêm (áp dụng cả quầy pha chính và Sảnh Trà Live Barista).',
    '✨ Xóa Bỏ Dải Mờ Background Quán: Tinh chỉnh hiệu ứng thời tiết mưa bằng CSS Mask hiện đại, loại bỏ hoàn toàn dải mờ beige ở chân quầy giúp hình nền các vùng miền luôn trong trẻo, sắc nét.'
  ]},
  {v:'12.47.404',d:'07/10/2026',items:[
    '🍯 Nhập Số Lượng Hương & Bỏ Cài Đặt +45 Ly Sẵn: Tự do nhập số lượng chai hương cần mua hoặc dùng nút tăng giảm (+/−) nhanh chóng; loại bỏ nút mua +45 ly cố định.',
    '👤 Khắc Phục Lỗi Mất Avatar Khách Hàng: Sửa triệt để lỗi không hiện ảnh đại diện khách; tối ưu nạp ảnh faces2.webp tương thích tuyệt đối mọi nền tảng.',
    '🎯 Cân Đối Thẻ Điểm Hòa Vốn Chuẩn F&B: Tinh chỉnh bố cục 3 thẻ báo cáo P&L giúp thẻ Điểm Hòa Vốn hiển thị vừa vặn bên trong khung, không tràn viền.',
    '🏮 Tối Ưu Bảng Hiệu & Hàng Thú Cưng: Ẩn huy hiệu Sảnh Trà trên bảng hiệu tiệm, đưa avatar thú cưng lên cùng hàng ngang hiển thị gọn gàng, liền mạch.'
  ]},
  {v:'12.47.403',d:'07/10/2026',items:[
    '🧑‍🍳 Khắc Phục Lỗi Mất Khung Pha Chế Tại Sảnh Trà: Sửa triệt để lỗi khung Live Barista HUD bị trống trắng khi ở sảnh tiệm trà; hiển thị trọn vẹn mô hình quầy pha chế mini, ly trà sữa, dòng rót trà, muỗng múc topping và tiến độ pha chế trực quan.'
  ]},
  {v:'12.47.402',d:'07/10/2026',items:[
    '👥 Cập Nhật Tên Nhân Viên: Đổi tên nhân viên "Zọn Zẹp" thành "Nhân Diên Zọn Zẹp" chuẩn phong cách hóm hỉnh, thân thiện.',
    '💬 Nền Thoại Đơn Hàng Mới (bgoder.png): Phủ nền khung thoại order khi khách gọi món với độ mờ 80%, giúp chữ order rõ ràng, nổi bật trên mọi hình nền background quán.',
    '🎨 Bổ Sung 20 Mẫu Khách Hàng Mới (faces2.webp): Tích hợp trọn bộ 20 gương mặt khách hàng mới sinh động (đủ sắc thái biểu cảm bình thường, hài lòng, cáu kỉnh), mở rộng thế giới khách hàng phong phú hơn.'
  ]},
  {v:'12.47.401',d:'07/10/2026',items:[
    '📱 Tinh Gọn Tổng Kết Ngày & Sổ Xuống Chi Tiết: Triệt tiêu triệt để lỗi bảng tổng kết ngày tràn màn hình; giao diện mặc định chỉ hiển thị Tổng tiền (+), Tổng chi (−), Lợi nhuận và Tiền két; bấm Sổ xuống để xem chi tiết Báo Cáo P&L Chuẩn F&B và danh sách thu chi.',
    '🏮 Nâng Cấp Hàng Chờ Sảnh Tiệm (10 Khách Chờ) & Xếp Bàn Tức Thì: Mở rộng giới hạn khách chờ tại quầy từ 5 lên đến 10 khách khi sở hữu trang bị Nâng Tầng (floor2); khắc phục lỗi nhóm 5 khách/khách thứ 5 không vào bàn ngồi, tự động xếp kín mọi bàn sạch trong các phòng sảnh ngay lập tức.'
  ]},
  {v:'12.47.400',d:'07/10/2026',items:[
    '🚨 Sửa Triệt Để Lỗi Cảnh Báo Thú Cưng Hiển Thị "undefined": Khắc phục tên bé và các chỉ số sụt giảm Độ No/Vui Vẻ/Sức Khỏe khi mở ca bán hiển thị chính xác % thực tế thay vì undefined.',
    '🗺️ Tối Ưu Tự Động Làm Mới Ảnh Nền Bản Đồ (Cache-Busting): Tự động nạp mới 100% hình ảnh bản đồ khởi nghiệp và background địa phương (Vũng Tàu, Đà Lạt, Phú Quốc...) ngay khi ấn cập nhật bản mới hoặc chuyển địa điểm.'
  ]},
  {v:'12.47.399',d:'07/10/2026',items:[
    '💾 Nâng Cấp Toàn Diện Mã Sao Lưu Rút Gọn: Khắc phục triệt để lỗi thiếu dữ liệu trong mã rút gọn; lưu trọn vẹn 100% mọi tiến trình: Công thức độc bản Sưu Tầm (craftedRecipes), 4 phòng Sảnh Tiệm Trà (LobbyRooms), Tiền tiết kiệm ngân hàng, Cấp độ máy móc trang thiết bị, Đồ trang trí quán, Bạn bè, Danh hiệu, KPI nhân viên...',
    '🛡️ Nén Siêu Tinh Gọn 1 Dòng (TTN2 v3): Mã sao lưu nén chuẩn GZIP URL-safe chỉ vài trăm ký tự, hiển thị gọn gàng trong 1 ô, sao chép 1 chạm và gửi qua Zalo, Messenger, SMS cực kỳ an toàn mà không lo mất dữ liệu.'
  ]},
  {v:'12.47.398',d:'07/10/2026',items:[
    '🧹 Thêm Nhân Viên Mới: Zọn Zẹp: Tự động dọn dẹp sảnh tiệm trà (dọn sạch bàn dơ 4 phòng), tăng tỉ lệ khách bo (+25% bo quầy, +50% bo sảnh tiệm), thu hút khách ghé thăm sảnh trà đông đúc hơn.',
    '📖 Điều Kiện Mở Khóa: Cần sưu tầm & mở khóa thành công 10 công thức độc bản trong mục Sưu Tầm.'
  ]},
  {v:'12.47.397',d:'07/10/2026',items:[
    '🏖️ Thêm Địa Điểm Vũng Tàu (Bà Rịa - Vũng Tàu): Cuối tuần +25% Traffic, du lịch +20% Tip, nhóm +15% 2–4 ly, đồ lạnh +10% giá trị đơn. Nhược điểm: Mưa -25% Traffic, trái cây/topping +10% COGS, ngày thường -10% Traffic.',
    '🌸 Thêm Địa Điểm Đà Lạt (Lâm Đồng): Đồ nóng +25% giá trị đơn, Check-in +25% Tip, Gen Z +15% món đặc biệt, +10% gọi thêm. Nhược điểm: Đồ lạnh -15% Tip, mưa -15% Traffic, đồ nóng/đặc sản +10% COGS.',
    '🏝️ Thêm Địa Điểm Phú Quốc (Kiên Giang): Du lịch/VIP +30% Tip, resort +25% giá trị đơn, International Star x2, Big Order +15% giá trị. Nhược điểm: COGS +20%, Traffic -15%, Online -20%.'
  ]},
  {v:'12.47.396',d:'07/10/2026',items:[
    '🧹 Bỏ 3 Lọ Thủy Tinh: Loại bỏ hoàn toàn 3 lọ nguyên liệu phía trên quầy pha chế mini trong Live Barista HUD, giúp không gian sạch sẽ, thanh thoát và làm nổi bật ly trà sữa.',
    '🥄 Bỏ Topping Duy Nhất 1 Loại: Text trạng thái chỉ báo đúng 1 loại topping đang được bỏ vào ly (tránh hiển thị dấu +), hạt topping rơi khớp màu chính xác.',
    '💵 Hiển Thị Giá Tiền Sau Tên Món: Bổ sung giá bán chi tiết ngay sau tên món trà sữa (ví dụ: Trà sữa dưa gang · 35.000đ).'
  ]},
  {v:'12.47.395',d:'07/10/2026',items:[
    '🧋 Mô Hình Quầy Pha Chế Thu Nhỏ (Mini Barista Workbench): Bổ sung thớt gỗ caramel, kệ lọ topping thủy tinh (Trân châu đen, Hoàng kim, Phô mai) và chai siro phía sau.',
    '✨ Ly Trà Pha Chế Trực Quan: Hiển thị ly thuỷ tinh trong suốt với màu nước trà chuẩn theo công thức (Dưa gang, Ô long, Thái...), đá viên, bọt kem cheese và vạch chia định lượng.',
    '🥄 Hiệu Ứng Bỏ Topping Vào Ly: Muỗng múc topping nghiêng góc, các hạt trân châu/thạch rơi tuần tự vào ly với hiệu ứng nảy (bounce physics) và tạo sóng gợn trên mặt nước cực sống động.'
  ]},
  {v:'12.47.394',d:'07/10/2026',items:[
    '📊 Giao Diện Quầy Pha Chế Trực Quan Tại Sảnh (Live Barista HUD): Hiển thị trực tiếp đơn khách, ly trà đang pha, thanh tiến độ và nhân viên làm việc tại vị trí khung đỏ góc quầy thu ngân trong sảnh.',
    '🎨 Thiết Kế Lại Nút Ra Sảnh: Màu tone gỗ ấm tiệm trà (nâu cánh gián sang trọng), số lượng bàn to rõ nét dễ nhìn (font 14px đậm), bấm chuyển cảnh mượt mà.'
  ]},
  {v:'12.47.393',d:'07/10/2026',items:[
    '👥 Sửa Lỗi Bàn 5 Khách Bị Cắt Đầu: Khôi phục trọn vẹn 100% phần đầu, mũ lưỡi trai và tóc của toàn bộ 5 bạn nhỏ từ ảnh gốc, căn chỉnh vị trí chân ghế chạm sàn chuẩn xác và nâng cao bong bóng thoại.'
  ]},
  {v:'12.47.392',d:'07/10/2026',items:[
    '🏮 Sửa Dứt Điểm Lỗi Không Ấn Được Sảnh Trà: Khai báo hàm openLobbyView() và closeLobbyView() toàn cục, đồng bộ selector ID modal, đảm bảo bấm vào Sảnh Trà ở mọi vị trí (bảng hiệu quán, thanh menu tab, quầy pha chế) đều mở tức thì.',
    '🐾 Ngẫu Nhiên Nhận EXP Thú Cưng: Mỗi lần nâng cấp pet sẽ nhận ngẫu nhiên từ +5 EXP đến 10% EXP của cấp độ hiện tại (chi phí: trừ 1tr kèm 0.5% két tiền kèm 1 Tổng Sao, tăng +4 Vui vẻ).'
  ]},
  {v:'12.47.391',d:'07/10/2026',items:[
    '🏮 Sảnh Tiệm 4 Phòng Kéo Xuống Xem Toàn Bộ: 4 phòng riêng biệt với 4 background độc quyền (bg, bg2, bg3, bg4) được xếp nối tiếp nhau cuộn dọc xem liền mạch. Mở khoá lần lượt 10tr (P1), 20tr (P2), 30tr (P3), 40tr (P4).',
    '🪑 Sức Chứa 16 Bàn Khách (+30% Phụ Thu): Mỗi phòng 4 bàn riêng biệt, khách ngồi sảnh tự động phụ thu +30% vào hóa đơn; nút "Dọn bàn dơ" dọn toàn bộ các phòng.',
    '🐱 Nâng Cấp Thú Cưng Chuẩn: Mỗi lần bấm luôn tăng +4 Vui vẻ, +5 EXP, trừ 1.000.000đ kèm 0.5% két tiền kèm 1 Tổng Sao (x1 ⭐).',
    '💖 Hiệu Ứng Tim Bay & EXP Nhảy Liên Tục: Bắn chùm tim bay rực rỡ và thanh tiến độ EXP nảy nở nhịp nhàng theo từng lần bấm.'
  ]},
  {v:'12.47.390',d:'07/10/2026',items:[
    '📦 Nhập Số Lượng Hương Trong Kho Hàng: Bổ sung thanh chỉnh số lượng với ô nhập số, nút tăng giảm (-/+) và nút tiện ích "+45 ly" (1 chai), cho phép nhập hương linh hoạt như các nguyên liệu khác.',
    '🤵 Quản Gia Tối Ưu Giá Best Seller Chuẩn: Tăng 25% cho các món cốt trà và tăng 10% cho các nguyên liệu (topping, hương); cố định giá dựa trên giá chuẩn DEF_SELL, ngăn chặn hoàn toàn tình trạng tăng giá vô hạn và khách không bao giờ chê đắt.',
    '📞 Quản Gia Tự Động Gọi Nhân Sự Đi Làm: Tự động xóa sạch mọi đơn xin nghỉ việc/nghỉ phép, triệu tập 100% nhân viên vắng mặt trở lại làm việc mà không làm gián đoạn ca bán.',
    '🌟 Quản Gia Tự Động Quyết Toán KPI Tối Đa: Tự động thanh toán lương thưởng KPI kỳ 7 ngày ở mức Xuất sắc (+5% khách gọi món) cho toàn bộ nhân sự, triệt tiêu 100% nguy cơ đình công.'
  ]},
  {v:'12.47.389',d:'07/10/2026',items:[
    '🍓 Sửa Dứt Điểm Lỗi Không Mua Được Hương: Khai báo đầy đủ hàm syncFlav() đồng bộ trạng thái nguyên liệu hương siro, sửa triệt để lỗi ReferenceError khi ấn "Mua chai" trong tab Hương và Kho hàng.',
    '📦 Bổ Sung Tab Hương Trực Tiếp Trong Kho Hàng: Cho phép kiểm tra số chai, hạn dùng và mua thêm chai hương tiện lợi ngay tại màn hình chuẩn bị kho hàng.',
    '🛡️ Triệt Tiêu Lỗi Đang Chơi Bị Văng Game: Bọc khiên bảo vệ try-catch độc lập cho từng nhân viên trong vòng lặp bán hàng (staffBuyer, staff2, staffGz, staffSv, staffOn), ngăn chặn crash luồng tick game.',
    '⚡ Chống Tự Động Tải Lại (Reload) Gián Đoạn Ca Bán: Khóa tuyệt đối cơ chế reload phiên bản mới nếu người chơi đang trong ca bán hoặc đang thao tác, bảo toàn tiến trình chơi mượt mà 100%.'
  ]},
  {v:'12.47.388',d:'07/10/2026',items:[
    '🐕 Cân Đối Tỉ Lệ Thú Cưng Ở Sảnh: Thu gọn kích thước bé Cún Shiba / Mèo / Cáp Bi về 32px vừa vặn, chuẩn tỉ lệ hài hòa bên cạnh khách ngồi, không còn to khổng lồ lấn át khách.',
    '💬 Di Chuyển Thanh Thông Báo Lên Đỉnh Sảnh (Top Position): Khi mở Sảnh bàn ghế, thông báo tự động ghim ở đỉnh (dưới thanh điều hướng), triệt tiêu hoàn toàn lỗi che khuất bàn ghế và khách hàng.',
    '👆 Chạm Thông Báo Để Đóng Tức Thì: Rút ngắn thời gian hiển thị thông báo dọn bàn (1.8s) và cho phép chạm trực tiếp vào thông báo để tắt ngay lập tức.'
  ]},
  {v:'12.47.387',d:'07/10/2026',items:[
    '📊 Báo Cáo Phân Tích Lỗ Lãi P&L Chuẩn F&B (Financial Statement): Tích hợp trực tiếp vào Báo cáo cuối ca ngày và Tab Tổng Kết.',
    '🧪 Phân Tích Tỷ Lệ Giá Vốn COGS Chuẩn 28% – 32%: Đánh giá chi phí nguyên liệu so với doanh thu, cảnh báo sớm nếu vượt ngưỡng lãng phí (>32% hoặc >38%).',
    '👥 Kiểm Soát Chi Phí Nhân Sự Labor Cost Chuẩn 15% – 20%: Theo dõi tỷ lệ tiền lương nhân viên trên doanh thu, tối ưu hóa năng suất vận hành quán.',
    '🎯 Điểm Hòa Vốn (Break-Even Cups): Tính toán chính xác số ly trà cần bán tối thiểu mỗi ngày để bù đắp toàn bộ chi phí cố định (Mặt bằng + Điện nước + Lương nhân viên).',
    '📊 Biểu Đồ Thanh Phân Bổ Chi Phí & Bác Sĩ F&B Chẩn Đoán: Trực quan hóa cấu trúc chi phí (Nguyên liệu, Nhân sự, Mặt bằng, Khác, Lợi nhuận) kèm lời khuyên tài chính thông minh.'
  ]},
  {v:'12.47.386',d:'07/10/2026',items:[
    '🐕 Sửa Triệt Để Lỗi Ảnh Bé Cún Shiba / Mèo Ở Sảnh: Ánh xạ chuẩn các tư thế chạy nhảy (Play) và ngồi (Sit), bổ sung cơ chế tự phục hồi chống vỡ ảnh.',
    '🏮 Bổ Sung Nút "Sảnh Trà" Cạnh Nút "Khởi Nghiệp": Hiện diện trực quan ở cả bảng hiệu đầu trang và thanh tab điều hướng chính, nhấn là mở ngay sảnh bàn ghế.',
    '📐 Triệt Tiêu Hoàn Toàn Lỗi Trống 2 Bên & Trống Trên Dưới: Quầy pha chế và sảnh bàn ghế tự động tràn viền 100% theo tỷ lệ 1024x572, vừa vặn tuyệt đối không còn viền thừa.',
    '⚡ Tăng Tốc Độ & Tỷ Lệ Khách Ghé Sảnh: Khách ghé quầy nhộn nhịp mỗi 2.2 - 2.5s, rút ngắn thời gian dùng nước để lượt khách mới liên tục vào bàn.'
  ]},
  {v:'12.47.385',d:'07/10/2026',items:[
    '✨ Nổi Bật Nút "Ra Sảnh ➔": Phối màu xanh ngọc lục bảo rực rỡ, viền vàng kim sắc nét, tự động nhấp nháy báo động cam khi có bàn dơ cần dọn.',
    '📐 Khung Sảnh Vừa Vặn & Phóng To Bàn Ghế: Khắc phục quầy pha chế bị cắt đáy, phóng to khu vực bàn ghế khách ngồi & thú cưng, loại bỏ hoàn toàn khoảng trắng dư thừa.',
    '🧹 Tắt Dọn Bàn Tự Động: Yêu cầu chủ tiệm chủ động dọn bàn dơ (chạm vào bàn dơ hoặc bấm Dọn bàn) để đón khách mới.',
    '🏷️ Phụ Thu +10% Tiền Bill Khi Ngồi Quán: Khách dùng món tại sảnh tự động cộng thêm 10% phí dịch vụ vào hóa đơn, hiển thị minh bạch và nộp thẳng vào két.'
  ]},
  {v:'12.47.384',d:'07/10/2026',items:[
    '🏮 Ra Mắt Sảnh Tiệm Trà Sữa (Hàng Chờ & Sảnh Bàn Ghế Khách Ngồi): Tích hợp trực tiếp sảnh bàn ghế tự động vào ca bán hàng (R.mode === sell), có nút "Ra sảnh ➔" ngay dưới dòng % đường - ít đá.',
    '🪑 Khách Sảnh Gọi Món Thật Theo Menu Quán & Dọn Bàn Để Đón Khách: Từng nhóm khách tại bàn gọi món trà sữa thực tế theo thực đơn tiệm, thưởng thức và để lại tiền bill + tip. Khách rời bàn để lại bàn dơ, chủ tiệm dọn sạch sẽ để lượt khách tiếp theo vào ngồi.',
    '🐾 Thú Cưng Chạy Vui Vẻ Ở Sảnh Khách Ngồi: Bé cún Shiba / mèo chiêu tài tung tăng chạy nhảy trên sàn sảnh tiệm, nựng bé cưng nhận ngay EXP và tăng tiền tip cho khách ngồi bàn.'
  ]},
  {v:'12.47.383',d:'07/10/2026',items:[
    '👥 Đổi Tên Tab "KPI Nhân Viên" → "Quản Lý Nhân Sự" & Tối Ưu Hiển Thị: Căn chỉnh cỡ chữ, ngắt dòng chữ cân đối, không bị che khuất hay tràn khung trên mọi kích cỡ màn hình.',
    '⚖️ Cân Bằng Toàn Diện Bảng Lương Nhân Viên: Cập nhật mức lương chuẩn xác: Gen Z 300k/ngày, Ngô Diễm My 350k/ngày, Chú Ba 300k + 1% DT, Tuấn Xa Lộ 1m + 0.5% DT, Bác Phúc 500k + 2% DT, Đặng Mai 300k/ca, Hoàng Minh 250k, Gia Huy 200k, Đinh Nhàn 200k, Võ Phong 180k, Lâm Phước 165k.',
    '🗺️ Cân Bằng Chỉ Số Khởi Nghiệp 10 Tỉnh Thành: Hà Nội (+15% Traffic / +15% Tip), TP.HCM (+25% giá trị đơn sau 20h / +20% Online), Đà Nẵng (0% tiền giả / x2 điểm combo nhanh), Huế (+25% kiên nhẫn / +20% giá trị trà đặc sản), Sa Pa (+20% giá trị trà nóng / +20% kiên nhẫn), Hạ Long (+25% Tip du lịch / +10% Big Order du lịch), Buôn Ma Thuột (+20% giá trị đồ uống béo / -25% mặt bằng), Cần Thơ (-25% COGS topping / +20% Tip địa phương), Cà Mau (+40% cơ hội 3–5 cốc / +10% đơn gia đình), Hoàng Sa–Trường Sa (+300k/ngày / 100% 5★ / 0% tiền giả).'
  ]},
  {v:'12.47.382',d:'07/10/2026',items:[
    '⭐ Cố Định Modal Đánh Giá & Tra Cứu Ca Pha Chế (card-sell-modal):',
    '  • Khóa khung vừa vặn hoàn hảo trong màn hình (chiều cao 84vh), triệt tiêu lỗi cuộn lồng nhau làm trôi card.',
    '  • Nút "Đóng lại tiếp tục pha chế 🧋" luôn ghim cố định ở đáy modal, không bao giờ bị che hay lọt mép màn hình.',
    '  • Tiêu đề số sao ghim chắc ở đỉnh, vuốt lướt danh sách nhận xét mượt mà ở giữa.'
  ]},
  {v:'12.47.381',d:'07/10/2026',items:[
    '💬 Tinh Chỉnh Thanh Thông Báo (Toast):',
    '  • Giảm kích thước chữ và khoảng đệm (padding) vừa vặn thanh thoát, không bị to choán màn hình.',
    '  • Tự động ngắt dòng linh hoạt (white-space: normal), hiển thị trọn vẹn 100% nội dung, không còn bị cắt đuôi thành "..."!',
    '  • Rút gọn câu chữ thông báo của bảo vệ bắt quỵt tiền: rõ ràng, súc tích và dễ theo dõi hơn.'
  ]},
  {v:'12.47.380',d:'07/10/2026',items:[
    '🔥 Ra Mắt Cơ Chế "Giờ Cao Điểm" (Rush Hour) Thực Thụ:',
    '  • Xuất hiện chắc chắn mỗi ca ban ngày khi qua giữa ca (còn ~55% thời gian): Rung chuông cảnh báo leng keng, banner rực lửa đếm ngược 35 giây.',
    '  • Khách tới dồn dập: Tốc độ khách tại quầy và đơn online đổ về nhanh gấp x2.2 lần!',
    '  • Thưởng lớn: Nhân x1.5 toàn bộ Hóa đơn (Bill) và x1.5 Tiền boa (Tip) cho cả đơn tại quầy và online!',
    '🌦️ Điều Chỉnh Khí Hậu & Thời Tiết Thực Tế Theo Từng Vùng Miền (10 Địa Điểm):',
    '  • Sa Pa: Cận ôn đới quanh năm se lạnh (11°C - 20°C), sương mù dày, không còn nắng nóng oi bức.',
    '  • TP.HCM, Cần Thơ, Cà Mau: Nam Bộ 2 mùa Mưa - Nắng ấm áp (29°C - 35°C), mưa rào mát mẻ, không rét lạnh.',
    '  • Cố đô Huế: Tăng tỉ lệ Mưa dầm xứ Huế êm đềm, sương mờ cổ kính.',
    '  • Đà Nẵng, Hạ Long, Hoàng Sa – Trường Sa: Khí hậu biển đảo chan hòa nắng gió, mùa bão dông ngoài khơi.',
    '  • Buôn Ma Thuột: Cao nguyên đất đỏ ban ngày nắng trong, chiều tối se lạnh trong lành.'
  ]},
  {v:'12.47.379',d:'07/10/2026',items:[
    '💰 Khôi Phục Toàn Diện Cơ Chế Giá Bán Chuẩn Tiệm Trà Nhỏ (Classic):',
    '  • Khôi phục trần giá chuẩn: Trà max 40k-50k, 1 món max 50k, 1 ly max 120k, Size L cảnh báo 20k, max 50k.',
    '  • Hương & Topping: Trên 20.000đ thì 80% khách không gọi, trên 30.000đ thì không ai gọi.',
    '  • Khách hàng nhạy cảm với giá: Ly > 120k bỏ đi 60%, món > 50k quán vắng 80%, món đắt (>130% giá gợi ý) khách chê đắt bỏ đi và đánh giá kém (1★ - 2★).',
    '  • Đặc quyền Quản Gia (staffButler): Chỉ khi sở hữu Quản Gia, quán mới được quyền tăng giá bán thoải mái mà khách 100% không chê đắt, không bỏ về và không bị trừ sao!'
  ]},
  {v:'12.47.378',d:'07/10/2026',items:[
    '🗺️ Tối Ưu Hóa & Cân Bằng Chuẩn Xác Chỉ Số 10 Địa Điểm Khởi Nghiệp:',
    '  • Hà Nội: Lượng khách ghé quán +15%, Tiền boa nhận được +15% (loại bỏ Giờ cao điểm và Khách sành điệu tỉ lệ ít).',
    '  • Đà Nẵng: 0% tiền giả, Tỉ lệ đánh giá 5★ +15% (loại bỏ Chuỗi phục vụ nhanh).',
    '  • Huế: Trà olong +25% giá trị đơn (thay thế Trà sen/nhài/thảo mộc).',
    '  • Sa Pa: Hồng trà, Lục trà, Các món ít đá +25% giá trị đơn (thay thế Trà nóng/thảo mộc).',
    '  • Buôn Ma Thuột: Trà sữa, Trà sữa Thái / Foam cheese / Trân châu đen +20% giá trị đơn (thay thế Trà sữa/Kem phô mai/Socola).',
    '  • Cần Thơ: Thạch / Phô mai -30% chi phí nguyên liệu (thay thế Trái cây/Siro/Topping).'
  ]},
  {v:'12.47.377',d:'07/10/2026',items:[
    '🇻🇳 Thuần Việt Hóa Toàn Diện Các Buff & Chỉ Số Vùng Miền:',
    '  • Chuyển ngữ toàn bộ các thuật ngữ tiếng Anh sang tiếng Việt dễ hiểu và gần gũi:',
    '    + Rush Hour → Giờ cao điểm; Traffic → Lượng khách.',
    '    + Tip → Tiền boa; Bill → Hóa đơn.',
    '    + COGS → Chi phí nguyên liệu; Big Order → Đơn lớn / Đoàn khách du lịch.',
    '    + Online → Đơn trực tuyến; Combo → Chuỗi phục vụ nhanh.',
    '    + Milk Tea / Cheese / Chocolate / Syrup → Trà sữa / Kem phô mai / Socola / Siro.',
    '  • Cập nhật thông điệp hiển thị banner trong ca bán: "🔥 GIỜ CAO ĐIỂM (x1.5 Hóa đơn · x2 Tiền boa)".'
  ]},
  {v:'12.47.376',d:'07/10/2026',items:[
    '🚀 Sửa Triệt Để Lỗi "Site not found" Khi Bấm Nút Cập Nhật:',
    '  • Khắc phục hoàn toàn lỗi khi cập nhật trên hosting/proxy (loại bỏ query param ?_v=... gây lỗi 404/Site not found), xoá sạch cache bộ nhớ đệm và tải lại trang mượt mà tại chỗ.',
    '🧋 Bỏ Giới Hạn Cốc Chuẩn 50k - Người Chơi Tự Do Định Giá:',
    '  • Người chơi được toàn quyền tăng giảm giá bán đồ uống tự do theo chiến lược riêng, không bị ép trần 50k (nâng trần itemCap lên 250k, cả ly priceCap lên 350k, phụ thu size L lên 150k).',
    '  • Khách hàng không còn ồ ạt bỏ về (vắng 80%) hay trừ sao chê đắt khi người chơi định giá đồ uống trên 50k.'
  ]},
  {v:'12.47.375',d:'07/10/2026',items:[
    '🗺️ Cân Bằng Chuẩn Xác 10 Điểm Khởi Nghiệp (Sau Phân Tích Dữ Liệu Ngày 2394):',
    '  • Hà Nội: Rush Hour +15% Traffic, Khách sành điệu +15% Tip. Nhược điểm: Khách khó tính +5%, Cốc cháy/hỏng -1★. (Bỏ phạt tiền mặt bằng & điện nước).',
    '  • TP.HCM: Sau 20h bill +25%, Đơn Online +25%. Nhược điểm: Sau 20h khách khó tính +10%, Điện nước +20%. (Bỏ phạt mặt bằng x1.6).',
    '  • Đà Nẵng: 0% tiền giả, Combo phục vụ nhanh x2 điểm. Nhược điểm: Khách nhạy giá (tăng giá → -10% khả năng mua), Không bonus doanh thu trực tiếp.',
    '  • Huế: Khách kiên nhẫn +25%, Trà sen/lài/thảo mộc +25% bill. Nhược điểm: Mưa -20% Traffic, Mưa -20% Online.',
    '  • Sa Pa: Trà nóng/thảo mộc +25% bill, Khách ngắm cảnh +20% kiên nhẫn. Nhược điểm: COGS vận chuyển +15%, Đồ uống lạnh -15% Tip.',
    '  • Hạ Long: Khách du lịch +25% Tip, Big Order du lịch +10% giá trị. Nhược điểm: Mưa/bão -25% Traffic, Lượng khách phụ thuộc mùa du lịch. (Bỏ tăng giá nguyên liệu).',
    '  • Buôn Ma Thuột: Milk Tea/Cheese/Chocolate +20% bill, Mặt bằng -25%. Nhược điểm: Online -30%, Khách chủ yếu mua trực tiếp.',
    '  • Cần Thơ: Trái cây/Syrup/Topping -30% COGS, Khách địa phương +20% Tip. Nhược điểm: Khách nhạy giá -10%, Cạnh tranh cao (-10% khách mới).',
    '  • Cà Mau: Khách có +40% cơ hội gọi nhóm 3–5 cốc, Đơn gia đình +15% giá trị. Nhược điểm: COGS đơn nhóm +10%, Điện nước +10%.',
    '  • Hoàng Sa – Trường Sa: Trợ cấp +300k/ngày, 100% 5★, 0% tiền giả. Nhược điểm: Không Online, COGS +20%, Traffic phụ thuộc sự kiện.'
  ]},
  {v:'12.47.374',d:'07/10/2026',items:[
    '⚖️ Cân Bằng Kinh Tế Toàn Diện Theo Dữ Liệu Ngày 2394 (Chuẩn Hoá Quán Chính, Chi Nhánh & Nhượng Quyền):',
    '  • Giảm 20% Hiệu Quả Doanh Thu Chi Nhánh & Nhượng Quyền từ Quảng Cáo: Điều chỉnh tỉ lệ Ads toàn chuỗi xuống mức bền vững (Facebook Ads: 12%, TikTok Ads: 28%, KOL Review: 48%, Billboard: 72%), kiểm soát lạm phát mà vẫn giữ sức hút kéo khách.',
    '  • Thuế Doanh Thu Chuẩn Hoá 3%: Đưa tổng mức thuế suất hàng năm từ 4.5% về đúng 3.0% doanh thu (2% Thuế GTGT + 1% Thuế TNCN), giảm nhẹ gánh nặng thuế cho tiệm ở giai đoạn siêu quy mô.',
    '  • Tối Ưu Tỷ Lệ Chia Tiền Tip: Tiệm trà giữ 88% tiền bo để trang trải chi phí và tái đầu tư, nhân viên nhận 12% (nhân viên thử việc 0 lương nhận 25%), giúp chủ quán thu hồi thêm hàng chục triệu tiền tip mỗi ngày.',
    '  • Khóa Chuẩn COGS Chi Nhánh & Nhượng Quyền 28% - 30%: Khống chế tỷ lệ giá vốn nguyên liệu chi nhánh và đối tác nhượng quyền ở mức đẹp 28% (khi có Lích Đờ) ~ 30% (khi chưa có Lích Đờ).',
    '  • Phí Bản Quyền Nhượng Quyền (Royalty) Cố Định 10%: Đối tác nhượng quyền nộp phẳng 10% doanh thu mỗi ngày vào két quán chính.',
    '  • Giữ Nguyên Giá Bán Cốc Chuẩn (50k), Mặt Bằng (40k/ngày) & Điện Nước (10k/h): Bảo toàn sự cân bằng tự nhiên và bản sắc riêng của 10 địa điểm khởi nghiệp.'
  ]},
  {v:'12.47.373',d:'07/10/2026',items:[
    '🎨 Sửa Triệt Để Lỗi Tràn & Chèn Chữ Tại Bảng Cài Đặt:',
    '  • Tối ưu cấu trúc thẻ nút Cài đặt (Button Flex Column Layout): Tách bạch Tiêu đề và Mô tả chi tiết thành dạng khối dọc thông minh (.setb-text), ngăn ngừa hoàn toàn tình trạng chữ bị co cụm, bẻ dòng lộn xộn hay đè lên nút bên dưới.',
    '  • Chuẩn hóa độ cao và khoảng cách (.setb & .setl): Tự động giãn cách thoáng đãng, căn chỉnh icon và nhãn phụ tinh tế, hiển thị hoàn hảo trên mọi kích thước màn hình điện thoại.'
  ]},
  {v:'12.47.372',d:'07/10/2026',items:[
    '⚡ Đột Phá Mã Sao Lưu Siêu Rút Gọn 1 Dòng (TTN3 ~70 Ký Tự):',
    '  • Chuẩn nén nhị phân siêu tinh gọn: Rút ngắn mã tiến trình từ hàng trăm ký tự xuống chỉ còn đúng 1 dòng duy nhất (~70-75 ký tự), hiển thị trong ô nhập liệu thanh lịch, chép 1 chạm gửi qua Zalo/SMS cực nhanh.',
    '  • Bảo toàn 100% dữ liệu cốt lõi: Gói gọn trọn vẹn Ngày, Tiền, Cấp độ, Điểm khởi nghiệp, Giao diện, Nhân viên, Kho hàng, Thú cưng, Cáp bi và Vườn cây.',
    '  • Tương thích ngược toàn diện: Đọc và phục hồi mượt mà cả mã TTN3 mới, mã TTN2, mã TTN1, file .txt, file .json và mã 8 số máy chủ.'
  ]},
  {v:'12.47.371',d:'07/10/2026',items:[
    '📦 Nâng cấp Hệ Thống Sao Lưu 2 Dạng Tiện Lợi (Rút Gọn & Tệp Tin):',
    '  • Dạng 1 - Tệp sao lưu đầy đủ (.txt): Giữ nguyên trọn vẹn toàn bộ lịch sử chi tiết, đánh giá và tài sản tiệm trà. Tích hợp nút tải file về máy một chạm, không gây tràn màn hình bởi chuỗi văn bản quá dài.',
    '  • Dạng 2 - Mã rút gọn siêu ngắn (TTN2): Chuẩn nén mới cô đọng toàn bộ tiến trình cốt lõi (Ngày, Tiền, Cấp độ, Nhân viên, Kho hàng, Thú cưng, Cáp bi, Vườn...) thành chuỗi ngắn gọn (~250-280 ký tự), dễ dàng sao chép và gửi qua tin nhắn Zalo, Messenger, SMS.',
    '  • Tương thích ngược thông minh: Khôi phục trơn tru mọi định dạng (mã rút gọn TTN2, mã đầy đủ TTN1, file .txt, file .json, chuỗi Base64 và mã 8 số máy chủ).'
  ]},
  {v:'12.47.370',d:'07/10/2026',items:[
    '🛡️ Sửa Triệt Để Lỗi Mất Dữ Liệu & Khôi Phục File Lưu Trữ:',
    '  • Cơ chế Đa tầng cứu hộ dữ liệu (Multi-layer Save Rescue): Không bao giờ tự ý xoá các bản lưu cũ hay bản lưu cứu hộ. Tự động sao lưu tsShop2_rescue và tsShop2_before_restore.',
    '  • Trình đọc file sao lưu đa định dạng (Universal Backup Parser): Hỗ trợ đọc cả mã TTN1 nén, mã TTN1 thuần, file văn bản (.txt), file dữ liệu JSON (.json), chuỗi Base64 và tự động làm sạch ký tự BOM (\\uFEFF) hay dấu ngoặc kép.',
    '  • Phục hồi bỏ qua lỗi mã băm (Hash Checksum Bypass): Khi file lưu trữ bị lệch mã băm do định dạng hệ điều hành hay ký tự xuống dòng, hệ thống tự động giải mã và phục hồi trọn vẹn dữ liệu thay vì từ chối khôi phục.',
    '  • Nâng cấp giao diện Khôi phục từ File: Mở rộng bộ lọc cho phép chọn cả file .txt và .json, tự động đọc trước và hiển thị thẻ thông tin quán (Tên quán, Số ngày, Số tiền) ngay khi tải file lên.',
    '  • Liên kết nhanh Bản tự lưu: Bổ sung nút truy cập nhanh các bản tự lưu (Cuối ngày gần nhất, Bản cứu hộ, Bản lưu trước đó) ngay trên popup khôi phục.'
  ]},
  {v:'12.47.369',d:'07/10/2026',items:[
    '🗺️ Cân bằng & Chuẩn hóa toàn diện Ưu - Nhược Điểm 10 Điểm Khởi Nghiệp:',
    '  • Hà Nội: Giờ cao điểm đông đúc +20% khách, khách sành điệu bill cao & tip +15%. Bù lại mặt bằng & điện nước x1.4; khách khó tính: ly hỏng/cháy bị phạt -1★.',
    '  • TP. Hồ Chí Minh: Kinh tế đêm phát triển (sau 20h bill +25%, đơn online +30%). Bù lại chi phí mặt bằng & vận hành x1.6, sau 20h chi phí vận hành tăng thêm +10%.',
    '  • Đà Nẵng: Tỷ lệ tiền giả 0%, combo phục vụ nhanh x2 điểm tích lũy. Bù lại khách chuộng giá ổn định: giá bán cao làm giảm -10% tỷ lệ mua.',
    '  • Cố đô Huế: Khách kiên nhẫn +25%, trà sen/lài/thảo mộc cung đình bill +30%. Bù lại ngày mưa khách & online -20%, nhịp khách thong thả: tốc độ đơn -15%.',
    '  • Sa Pa: Khí hậu lạnh (trà nóng & thảo mộc bill +25%, khách thưởng cảnh kiên nhẫn +20%). Bù lại vận chuyển đèo dốc +15% giá vốn, trà đá ít chuộng (-15% tip món trà đá).',
    '  • Hạ Long: Khách du lịch vịnh hào sảng (tiền tip +30%). Bù lại mùa mưa bão khách ghé quán -30%, chi phí nguyên liệu mùa cao điểm +10%.',
    '  • Buôn Ma Thuột: Mặt bằng rẻ -25%, trà sữa, cheese, choco bill +25%. Bù lại khách chuộng ngồi tại quán (đơn online -30%, tốc độ quay vòng bàn -10%).',
    '  • Cần Thơ: Nguồn trái cây dồi dào (hoa quả, siro, topping -30% giá vốn, khách miền Tây tip +25%). Bù lại chuộng giá bình dân (giá bán tối đa -10%), cạnh tranh cao (khách mới -10%).',
    '  • Cà Mau: Khách gia đình chuộng combo 3-5 ly (+25% giá trị đơn trung bình, tỷ lệ đánh giá 5★ +20%). Bù lại điện nước & vận hành xa đất liền +15%, topping combo +10% giá vốn.',
    '  • Hoàng Sa – Trường Sa: Trợ cấp biển đảo 300.000đ/ngày, tình quân dân (100% đánh giá 5★, thú cưng x1.5 EXP, tiền giả 0%). Bù lại không mở bán online, nguồn hàng hạn chế (+20% giá vốn, thời gian nhập hàng +25%).'
  ]},
  {v:'12.47.368',d:'06/10/2026',items:[
    '🤵 Hoàn thiện & Kích hoạt toàn diện cơ chế Bác Phúc Quản Gia (staffButler):',
    '  • Tự động tăng giá Menu (+25%): Quản gia tự động định giá tăng +25% cho tất cả nguyên liệu Best Seller. Gắn huy hiệu "🤵+25%" trực quan trên Bảng Menu và Giá bán. Khách thưởng thức 100% không bao giờ chê đắt.',
    '  • Tự động làm vườn khép kín (Thu hoạch → Gieo hạt → Tưới nước): Tự động thu hoạch toàn bộ nông sản chín, mua và gieo hạt vào mọi ô đất trống, tưới nước toàn bộ vườn cây kèm 10% tỉ lệ đột biến Cây Sao Bội Thu.',
    '  • Chu đáo chăm sóc thú cưng: Tự động hồi phục 100% tất cả chỉ số (Độ no, Sạch sẽ, Vui vẻ, Năng lượng) cho cả Thú Cưng chính (Shiba/Mèo) và Cáp Bi Điềm Đạm, cộng EXP mỗi ngày, không bao giờ lo thú cưng bỏ đi.',
    '  • Tự động kích hoạt thông minh: Quản gia thực thi nhiệm vụ tức thì khi vào game, ở sảnh chính, khi chuyển tab và sau mỗi ca bán hàng.'
  ]},
  {v:'12.47.367',d:'06/10/2026',items:[
    '🚨 Siết chặt an ninh két tiền trên 1 Tỷ Đồng: Khi tích trữ hơn 1.000.000.000đ tiền mặt tại quán, nguy cơ trộm cắp và các thủ đoạn lừa đảo két tiền tăng vọt nhằm khuyến khích chủ tiệm gửi tiết kiệm hoặc tăng cường bảo an:',
    '  • Trộm cạy két đêm & Lừa đảo viễn thông: Tỉ lệ xảy ra tăng lên 45% ~ 65% mỗi đêm (đặc biệt vọt lên 75% ~ 88% khi Bác bảo vệ xin nghỉ ngủ lấy sức). Thiệt hại mỗi vụ từ 8% đến 15% tổng két (tối thiểu 50.000.000đ). Mở rộng các kịch bản lừa đảo công nghệ cao mạo danh thanh tra, giật tiền lúc kiểm két và mã độc hacker.',
    '  • Tội phạm tiền giả tại quầy: Tỉ lệ khách tuồn tiền giả tăng vọt từ 3.5% lên 8.5% ~ 15% (lên tới 22% khi vắng bảo vệ).',
    '  • Trộm giật & móc két quầy thu ngân: Kẻ gian xuất hiện dàn cảnh hỏi đường / gây rối để móc trộm tiền trực tiếp từ két khi quán không có bảo vệ.',
    '  • Khách xấu bùng tiền & trả thiếu: Tỉ lệ khách ôm ly chạy, mặc cả, trả thiếu tiền lẻ tăng cao rõ rệt khi phát hiện quán giữ két tiền tỷ sơ hở.',
    '  🛡️ Biện pháp an toàn: Gửi bớt tiền vào Tà Tưa Bank (đạt 5.0★ tổng để mở rộng hạn mức gửi) hoặc thuê Bác Bảo Vệ để triệt tiêu 100% mọi nguy cơ trộm cắp, tiền giả và bùng tiền!'
  ]},
  {v:'12.47.366',d:'06/10/2026',items:[
    '🦫 Cân bằng chỉ số Thú cưng Cáp Bi Điềm Đạm: Giảm nguy cơ thua lỗ của chuỗi chi nhánh từ 50% xuống 30%.',
    '📊 Cập nhật công thức tính toán và bảng hiển thị chi tiết chỉ số trong giao diện Cáp Bi:',
    '  • Quán chính: Tăng +7% doanh thu và +10% tiền Tip trên mỗi bill bán trực tiếp.',
    '  • Chuỗi chi nhánh: Tăng +10% doanh thu chi nhánh & giảm 30% rủi ro/nguy cơ thua lỗ của chi nhánh.',
    '  • Bán nguyên liệu thừa: Tăng +10% giá bán nguyên liệu, khách vãng lai không còn chê mắc.',
    '  • Vận may ly trà: Tăng +2% tỉ lệ bộc phát ×2∼×5 giá trị ly mỗi khi khách thưởng thức tại quán.'
  ]},
  {v:'12.47.365',d:'06/10/2026',items:[
    '🤵 Cơ chế Nộp Đơn Nghỉ Việc cho Quản Gia, Bác Bảo Vệ & Chiến Thần Xa Lộ: Cả 3 nhân sự đặc biệt giờ đây cũng nộp đơn xin nghỉ việc báo trước 1~3 ngày với lý do phong phú, chuẩn tính cách từng vị trí (Quản gia về dưỡng lão/quản lý trang viên lớn, Bác bảo vệ về vui thú điền viên/cố vấn an ninh, Chiến thần xa lộ gia nhập giải đua Grand Prix).',
    '💵 Thuê lại bằng Tiền Lương Ngày kèm % Doanh Thu: Khi Quản gia (500k + 2% DT), Bác bảo vệ (300k + 1% DT), hoặc Chiến thần xa lộ (1tr + 0.5% DT) nghỉ việc, chủ quán có thể ký hợp đồng thuê lại ngay trên popup bàn giao hoặc tuyển lại từ mục Nâng cấp / KPI với mức chi phí đúng bằng tiền lương ngày kèm % doanh thu quán.'
  ]},
  {v:'12.47.364',d:'06/10/2026',items:[
    '💵 Khôi phục yêu cầu 100tr tiền két khi mở Pack Sưu Tầm: Mở gói pack nguyên liệu bí mật giờ đây yêu cầu đủ 100.000.000đ tiền mặt trong két, đồng thời tiêu tốn 10 lần 5 sao tổng và 10% hạn mức gửi ngân hàng (Bank Cap). Hiển thị trực quan trạng thái tiền két / 100tr ngay trên giao diện.'
  ]},
  {v:'12.47.363',d:'06/10/2026',items:[
    '🤝 Thuê song hành Quản Lý Tập Sự và Gen Z: Cho phép chủ quán thuê cùng lúc Quản lý tập sự và nhân viên Gen Z. Quản lý tập sự sẽ luôn túc trực hỗ trợ quầy chính, đặc biệt gánh vác việc pha chế khi Gen Z dỗi, đình công hay nghỉ việc.',
    '🎁 Khắc phục lỗi Mốc Ly Hộp Quà Sưu Tầm (>100k ly): Loại bỏ giới hạn 100k ly cũ, mốc nhận hộp quà sưu tầm nguyên liệu giờ đây mở rộng không giới hạn (cứ mỗi 1.000 ly nhận 1 hộp). Hệ thống tự động bù phát đầy đủ tất cả hộp quà còn thiếu cho các chủ quán đã bán tới 100k-400k+ ly ngay khi vào game!',
    '📦 Tinh chỉnh tỉ lệ mở Thẻ Nguyên Liệu Sưu Tầm: Gia tăng tỉ lệ ra nguyên liệu đã sở hữu (lên tới 75% - 96%) khi mở pack, giúp việc sưu tập trọn bộ các nguyên liệu mới trở nên kịch tính, thử thách và giá trị hơn.'
  ]},
  {v:'12.47.362',d:'06/10/2026',items:[
    '🎁 Mở Pack Sổ Tay Sưu Tầm tốn 10 lần 5 sao và 10% Bank Cap: Mỗi lần mở gói pack nguyên liệu bí mật sẽ tiêu tốn 10 lần đạt 5 sao tổng và 10% hạn mức gửi ngân hàng, mở trực tiếp túi quà và trao ngay 3 thẻ nguyên liệu.',
    '🍬 Buff Doanh Thu Milk Tea Crush tăng VĨNH VIỄN (+1% mỗi cấp): Không còn bị reset về 0% khi thua hay khi vào ca bán hàng mới! Mỗi cấp độ đã vượt qua sẽ cộng vĩnh viễn +1% Doanh Thu cho quán (vượt 10 màn = +10% vĩnh viễn).'
  ]},
  {v:'12.47.361',d:'06/10/2026',items:[
    '🐾 Thú cưng từ chối ăn, tắm, chơi hay ngủ khi đã đầy thanh chỉ số: Khi độ no, sạch sẽ, vui vẻ hay năng lượng đã đạt mức tối đa (100% ~ 235% tùy cấp độ), thú cưng (Mèo Chiêu Tài, Tó Shiba, Cáp Bi) sẽ từ chối nhận thêm hành động tương ứng, hiển thị lời thoại/thông báo giải thích dễ thương và hoàn toàn KHÔNG trừ tiền hay tiêu hao năng lượng của chủ quán.',
    '✨ Cập nhật nhãn trạng thái nút chăm sóc thông minh: Hiển thị trực quan "✅ Đã no tối đa", "✅ Đã sạch tối đa", "✅ Đã vui tối đa", "✅ Đã đầy năng lượng" cả khi mới mở giao diện lẫn khi tương tác trong thời gian thực.'
  ]},
  {v:'12.47.360',d:'06/10/2026',items:[
    '🍬 Cân bằng lại toàn diện Milk Tea Crush: Số lượt đi (moves) tăng dần theo các màn chơi (lên tới 40-50 lượt), giảm mạnh điểm yêu cầu (target score) giúp màn 10 và các màn cao hoàn toàn vượt qua được.',
    '🍒 Khắc phục Màn 10 (Thu hoạch Cherry): Điều chỉnh điểm yêu cầu về mức vừa sức (3.400đ thay vì hơn 13.500đ) kết hợp 36 lượt đi thoải mái, chinh phục dễ dàng.',
    '🐾 Rèn luyện & Nâng cấp Thú Cưng có phí 10k: Chạm vào thú cưng hoặc nút Nâng cấp trong phòng riêng sẽ chi 10.000đ/lần (+5 EXP, +4 Vui vẻ) thay vì miễn phí, giúp trải nghiệm nuôi dưỡng chân thực và ý nghĩa hơn.'
  ]},
  {v:'12.47.359',d:'06/10/2026',items:[
    '🍊 Cáp Bi đi dạo sống động tại Quầy Pha Chế và Vườn Cây: Cáp Bi có thể tự do đi dạo, ngồi chill, nằm nghỉ trên cỏ, ngủ khi mệt và tương tác cưng nựng vui vẻ hệt như Chó Shiba & Mèo Chiêu Tài.',
    '⚖️ Cân bằng chỉ số Buff của Cáp Bi đúng chuẩn: Tăng +7% doanh thu và +10% tiền Tip bill trực tiếp tại quán chính.',
    '🏢 Tăng +10% doanh thu chuỗi chi nhánh và giảm 50% nguy cơ thua lỗ của chi nhánh.',
    '🌿 Tăng +10% giá bán nguyên liệu dư thừa, khách không còn chê mắc.',
    '✨ Tăng +2% tỉ lệ x2 ~ x5 giá trị ly mỗi ly khi khách uống tại quán.'
  ]},
  {v:'12.47.358',d:'06/10/2026',items:[
    '🛵 Nâng cấp độ bền Xe Máy vượt trội: Giảm 80% nguy cơ hỏng hóc, miễn nhiễm hao mòn trong 9 cuốc đầu tiên mỗi ngày (chỉ tính tỉ lệ cực nhỏ từ cuốc thứ 10 trở đi, tối đa 8%), tỉ lệ hỏng ngẫu nhiên qua đêm giảm xuống chỉ còn 0.5%.'
  ]},
  {v:'12.47.357',d:'06/10/2026',items:[
    '📦 Khắc phục triệt để lỗi thanh Nhập Hàng che khuất nguyên liệu ở đáy Kho: Tăng khoảng đệm an toàn chân trang (125px + safe-area) và tối ưu lớp cảm ứng, giúp cuộn mượt mà và thao tác nhập trà, topping, ly, đá, đường dễ dàng trên mọi dòng điện thoại.'
  ]},
  {v:'12.47.356',d:'06/10/2026',items:[
    '📳 Tối ưu cảm giác vuốt kẹo Milk Tea Crush: Loại bỏ hoàn toàn rung màn hình khi kết hợp 3-4 kẹo thông thường, giữ khung hình ổn định, mượt mà và không gây mỏi mắt.',
    '⚡ Rung màn hình chọn lọc & sảng khoái: Chỉ rung khi kết hợp 5 kẹo (tạo Cầu Vồng 7 Màu, Kẹo Bọc Bom) hoặc khi bùng nổ chuỗi Combo liên hoàn, chơi lâu không bị rối.'
  ]},
  {v:'12.47.355',d:'06/10/2026',items:[
    '⏱️ Nâng thời gian mỗi lượt Milk Tea Crush lên 30s: Thoải mái suy tính và xếp chuỗi combo đỉnh cao ở tất cả các màn chơi.',
    '📱 Khắc phục lỗi thông báo chuỗi tràn viền trên điện thoại: Tối ưu banner combo co giãn linh hoạt vừa vặn màn hình dọc, chữ rõ nét không bị cắt chữ.',
    '🌈 Bùng nổ Sugar Crush Siêu Tốc: Khi thắng màn mà vẫn còn lượt, toàn bộ lượt thừa lập tức hoá thành Kẹo 7 Màu Cầu Vồng và kích hoạt bão chuỗi nổ liên hoàn cực nhanh!'
  ]},
  {v:'12.47.354',d:'06/10/2026',items:[
    '🦫 Kích hoạt trọn vẹn 4 Đại Đặc Quyền của Thú cưng Cáp Pi Điềm Đạm:',
    '🏪 Quán chính: Tăng +10% ~ +25% doanh thu & +12% ~ +30% tiền Tip bill trực tiếp tại quán chính.',
    '🏢 Chuỗi chi nhánh: Tăng +20% ~ +35% doanh thu chi nhánh & giảm 50% nguy cơ thua lỗ.',
    '🏷️ Giá bán nguyên liệu: Tăng +12% ~ +30% giá bán của nguyên liệu, khách không còn chê mắc.',
    '✨ Vận may nhân bill: Tăng +2% ~ +5% tỉ lệ x2 ~ x5 giá trị ly mỗi ly.'
  ]},
  {v:'12.47.353',d:'06/10/2026',items:[
    '⚡ Đột phá hiệu năng Milk Tea Crush 60FPS: Khắc phục triệt để hiện tượng giật lag, đơ cảm ứng trên điện thoại di động.',
    '👆 Phản hồi cảm ứng vuốt kẹo siêu nhạy: Bắt cử chỉ vuốt tức thì (14px) ngay khi ngón tay di chuyển, không còn độ trễ thả tay.',
    '🚀 Thuật toán DOM In-Place Update: Tái sử dụng toàn bộ 49 ô kẹo trên bàn cờ, loại bỏ 100% tình trạng huỷ và dựng lại DOM gây giật màn hình.',
    '📱 Tối ưu hóa GPU di động: Loại bỏ triệt để layer GPU thừa, chuyển thanh thời gian sang tăng tốc phần cứng GPU Transform (scaleX), mượt mà bền bỉ.'
  ]},
  {v:'12.47.352',d:'06/10/2026',items:[
    '🎨 Tối ưu độ tương phản & Sắc nét giao diện Cáp Bi: Khắc phục triệt để lỗi màu chữ bị chìm trên banner giới thiệu Cáp Bi, chuyển toàn bộ tiêu đề, mô tả và card hiệu ứng sang màu chữ đậm, độ tương phản AAA sắc nét dễ đọc.'
  ]},
  {v:'12.47.351',d:'06/10/2026',items:[
    '🎁 Thưởng lớn Milk Tea Crush: Cứ mỗi 5 màn vượt qua (Màn 5, 10, 15, 20...) nhận ngay 1 Túi Quà 3 Nguyên Liệu Bí Mật vào mục Sổ tay Sưu Tầm.',
    '💰 Giảm 90% giá mua Túi Nguyên Liệu: Giá mua túi pack nguyên liệu trong mục Sưu tầm giảm từ 1 Tỷ xuống chỉ còn 100 Triệu đồng két.',
    '🦫 Dễ dàng đón Cáp Bi về tiệm hơn: Giảm yêu cầu sáng tạo từ 10 công thức độc bản xuống chỉ còn 7 công thức độc bản là nhận nuôi Cáp Bi Điềm Đạm miễn phí!'
  ]},
  {v:'12.47.350',d:'06/10/2026',items:[
    '🦫 Ra mắt Thú cưng độc bản mới: Cáp Bi Điềm Đạm (Capybara Mascot)! Mở khóa miễn phí ngay khi sáng tạo đủ 7 công thức độc bản tại Sổ tay Sưu tầm.',
    '🐾 Đặc quyền Nuôi Chung độc nhất: Nuôi song song Cáp Bi cùng Chó hoặc Mèo mà không sợ xung đột, không reset cấp độ hay điểm thân thiết của thú cưng hiện tại.',
    '✨ Kết hợp trọn vẹn sức mạnh Tó & Mèo: Tăng đồng thời doanh thu quán chính (+10% ~ +25%), tăng tiền tip (+12% ~ +30%), buff doanh thu chi nhánh (+20% ~ +35%) và giảm 50% nguy cơ thua lỗ chi nhánh.',
    '🍉 Chế độ chăm sóc & Tương tác chuyên biệt: Đổi tên theo ý thích, thưởng thức dưa hấu mát lạnh, ngâm suối nước nóng Yuzu, gãi cằm lim dim và nệm ngủ êm ái với loạt biểu cảm siêu cưng.',
    '🏪 Đồng hành trên Quầy pha chế: Cáp Bi đứng cùng Thú cưng chính tại quầy, sẵn sàng bấm vuốt ve, thoại độc quyền và cùng nhảy múa cổ vũ mỗi khi hoàn thành ly trà.'
  ]},
  {v:'12.47.328',d:'06/10/2026',items:[
    '🤵 Thêm nhân sự mới: Quản gia (staffButler): Lương 500k/ngày + 2% doanh thu, mở khoá khi đạt 5 công thức độc bản ở mục Sưu tầm.',
    '🌱 Tự động chăm sóc khu vườn Organic: Mua hạt giống và gieo trồng phủ xanh mọi ô đất trống, tưới nước và thu hoạch nông sản chín.',
    '🐾 Chu đáo chăm sóc thú cưng: Tự động cho ăn ngon, tắm sạch, chơi đùa, nghỉ ngơi và cộng EXP liên tục, không bao giờ lo thú cưng đói hay bỏ nhà đi.',
    '🛠️ Bảo trì & Sửa chữa trang bị tức thì: Phát hiện và sửa xong ngay mọi hỏng hóc (tủ lạnh, máy dán nắp, xe máy, bàn ghế, đèn LED) mà không cần tốn tiền mua lại.',
    '📈 Tối ưu giá Best Seller & Khách không chê mắc: Tự động tăng giá 25% cho các nguyên liệu bán chạy nhất, khách hàng thưởng thức vui vẻ và không bao giờ chê đắt hay bỏ về.'
  ]},
  {v:'12.47.327',d:'06/10/2026',items:[
    '🛵 Thêm trang bị Xe máy (1.000.000đ): Trang bị độc quyền cho Chiến thần xa lộ & NV đi chợ. 10% trả giá không mất tiền mua hàng (0đ), 5% nhận x2 số lượng hàng nhập. Đi chợ quá nhiều cuốc trong ngày sẽ tăng tỉ lệ hỏng xe.',
    '🚫 Ràng buộc tuyển dụng: Chiến thần xa lộ không thể thuê cùng lúc với Nhân viên đi chợ.',
    '👥 Quy tắc nhân sự đối kháng: Gen Z và Sinh viên ca đêm không thể làm việc cùng lúc với Quản lý tập sự hoặc Thử việc chính thức (và ngược lại).'
  ]},
  {v:'12.47.326',d:'06/10/2026',items:[
    '🎵 Sửa triệt để lỗi mất nhạc nền: Loại bỏ MediaElementAudioSourceNode gây nghẽn/tắt tiếng, phục hồi đường truyền phát HTML5 Audio trực tiếp giúp nhạc nền Lofi và nhạc theo mùa luôn vang lên êm dịu, chuẩn xác.',
    '🔊 Khôi phục cơ chế chỉnh âm lượng tự nhiên: Điều khiển âm lượng mượt mà qua audio.volume, tự động tạm dừng phát khi tắt tiếng hoặc kéo về 0%.',
    '⚡ Tối ưu hiệu năng âm thanh: Giải phóng hoàn toàn các node trung gian, app khởi động nhanh và ổn định tuyệt đối.'
  ]},
  {v:'12.47.325',d:'06/10/2026',items:[
    '🐟 Ghép 4 cục hình vuông 2x2 biến thành Con Cá (Jelly Fish): Cơ chế độc đáo chuẩn Candy Crush Saga, khi ghép 4 topping cùng loại tạo thành hình vuông 2x2 sẽ sinh ra một chú Cá đặc biệt.',
    '🌊 Con Cá bơi bay 3D ngẫu nhiên đến 1 ô: Khi kích hoạt, chú cá vọt lên bơi theo đường vòng cung 3D cùng vệt bong bóng nước lấp lánh và đáp xuống phá tan một ô ngẫu nhiên trên bàn cờ.',
    '💦 Hiệu ứng sóng nước & nổ tung bọt nước: Đồ hoạ sóng nước bung toả 3D, bọt nước và hạt lấp lánh tung toé kèm phản ứng nổ dây chuyền mãn nhãn.'
  ]},
  {v:'12.47.324',d:'06/10/2026',items:[
    '💡 Xoá bỏ tính năng Gợi ý: Loại bỏ nút Gợi ý khỏi giao diện, tối ưu thanh tiêu đề và nâng cao tính tư duy thử thách của minigame.',
    '🔄 Tự động xáo trộn vị trí khi hết nước đi: Thuật toán kiểm tra liên tục bàn cờ, tự động kích hoạt hiệu ứng xoay 3D (shuffle spin) và đảo vị trí topping khi không còn nước đi khả thi.',
    '⏳ Thanh thời gian đếm ngược giảm dần từng lượt: Bổ sung thanh đếm ngược 12 giây mượt mà cho mỗi lượt đi, chuyển sắc đỏ rực cảnh báo khi dưới 3.5s, tự động trừ 1 lượt đi nếu để hết giờ.'
  ]},
  {v:'12.47.323',d:'06/10/2026',items:[
    '🛑 Khắc phục triệt để lỗi giao diện bị khuất: Sửa lỗi flexbox overflow đẩy trôi phần đầu (Header & Dashboard), tinh chỉnh kích thước bàn chơi thích ứng tự động theo chiều cao màn hình (calc(100dvh - 185px)), đảm bảo hiển thị trọn vẹn 100% trên mọi thiết bị.',
    '💥 Bổ sung hiệu ứng 3D Nổ kẹo vỡ tung: Sinh các hạt lấp lánh 3D (sparks & particles) bung tỏa nhiều hướng khi nổ kẹo, kết hợp vệt sáng bừng mặt kính và hiệu ứng vỡ tan sống động.',
    '🌈 Hiệu ứng Bay Bay Combo 3D: Biểu ngữ 3D bay bổng hoành tráng cho từng mốc Combo x2, Ngọt Ngào x3, Bùng Nổ x4, Siêu Crush x5 kèm điểm thưởng vàng bay bổng.',
    '⚡ Kỹ xảo Kẹo đặc biệt bùng nổ: Tia sét laser quét ngang/dọc bảng cờ, sóng xung kích nổ bom 3x3 và rung chấn bàn chơi chân thực chuẩn phong cách Candy Crush Saga.'
  ]},
  {v:'12.47.322',d:'06/10/2026',items:[
    '✨ Nâng cấp toàn diện đồ hoạ TRÀ SỮA CRUSH siêu nét, rực rỡ chuẩn phong cách Candy Crush Saga:',
    '🎨 Thiết kế 6 hình dạng (Silhouette) & bảng màu tương phản độc nhất: Trân Châu đen tròn xoe 🧋, Dâu Tây hình trái tim đỏ mọng 🍓, Matcha viên ngọc vuông lục bảo 🍵, Xoài Cát dáng lá vàng cam rực 🥭, Việt Quất viên tím hoàng gia 🫐, Pudding flan vòm vàng chanh tươi sáng 🍮; triệt tiêu hoàn toàn tình trạng trùng màu hay khó nhìn.',
    '🍬 Hiệu ứng 3D Candy Glossy & Pockets: Mỗi viên topping sở hữu lớp đổ bóng 3D, vệt phản quang bóng bẩy, nằm gọn trong từng ô khay tráng gương sắc nét.',
    '🔍 Icon phóng to cực đại & Viền Sticker tương phản: Tăng kích thước biểu tượng lên 135%, phủ viền phát sáng và bóng nổi đa lớp giúp nhận diện tức thì trong 0.1 giây.',
    '⚡ Huy hiệu Kẹo đặc biệt nổi bật: Huy hiệu nổi 3D động cho Tia Sét ⚡, Bom Nổ 💣 và Quả cầu Disco Cầu Vồng 🌈 chuyển sắc huyền ảo.'
  ]},
  {v:'12.47.321',d:'06/10/2026',items:[
    '🍬 Ra mắt Minigame TRÀ SỮA CRUSH (Candy Crush Saga phiên bản Trà Sữa): Thay thế hoàn toàn trò Cờ Vật cũ bằng minigame xếp 3 bùng nổ hương vị với 6 loại topping trà sữa (Trân châu, Dâu tây, Matcha, Xoài, Việt quất, Pudding).',
    '⚡ Kẹo đặc biệt bùng nổ hiệu ứng: Ghép 4 tạo Ly Sọc Siêu Cấp ⚡ quét nguyên hàng/cột, ghép L/T tạo Kem Cheese Nổ Bung 💣 nổ 3x3 hai lần, ghép 5 tạo Cầu Vồng Hoàng Gia 🌈 hút sạch toàn bộ một loại topping trên bàn.',
    '🏆 Cơ chế Combo liên hoàn & Thưởng két quán: Đạt mốc 1 ⭐, 2 ⭐⭐, 3 ⭐⭐⭐ để nhận thưởng nóng tiền két quán (+30k, +60k, +100k) và tăng điểm uy tín!'
  ]},
  {v:'12.47.320',d:'06/10/2026',items:[
    '🔊 Sửa triệt để lỗi không tăng giảm được âm lượng trên iOS / Safari Web: Tích hợp Web Audio API (MediaElementAudioSourceNode + GainNode) điều khiển trực tiếp biên độ âm thanh cho nhạc nền và hiệu ứng, vượt qua hoàn toàn cơ chế khoá thuộc tính audio.volume trên iOS.',
    '📱 Tối ưu thanh điều chỉnh âm lượng trên màn hình cảm ứng: Cập nhật touch-action: none và mở rộng kích thước nút trượt (thumb), giúp thao tác vuốt trượt và bấm tăng giảm ➖/➕ mượt mà, tức thì trên iPhone/iPad.',
    '🎵 Đồng bộ mức âm lượng thời gian thực: Cân bằng tuyến tính âm lượng SFX và nhạc nền, triệt tiêu hiện tượng khuếch đại âm kép khi thao tác.'
  ]},
  {v:'12.47.319',d:'06/10/2026',items:[
    '🛑 Sửa triệt để lỗi không ấn kết ca, không kết thúc ngày: Bổ sung định nghĩa upgCount() còn thiếu trong fixed(), sửa lỗi phạm vi biến r trong khối catch của finishEndDay(), giúp kết ca đóng ngày và hiển thị bảng tổng kết tức thì.',
    '🚨 Đồng bộ chuyển ca sau điều tra Tiền Giả / Công An: Đảm bảo sau khi xử lý vụ án tiền giả (hoặc khi hết giờ ca bán 22h/06h sáng), game chuyển tiếp trơn tru sang đóng sổ kết toán ngày mới.',
    '🛡️ Gia cố an toàn kết ca đa lớp: Đảm bảo dữ liệu ca bán và tiến trình qua ngày tiếp theo luôn được lưu trữ vững chắc ngay cả trong trường hợp phát sinh ngoại lệ giao diện.'
  ]},
  {v:'12.47.318',d:'06/10/2026',items:[
    '🛑 Sửa triệt để lỗi đứng game lúc 13h40: Khắc phục lỗi biến phạm vi (TDZ) trong vòng lặp thời gian tick() khi kích hoạt sự kiện Giờ cao điểm / Tiktoker lúc 13h40 khiến game bị đóng băng toàn bộ hoạt động.',
    '👥 Khắc phục dứt điểm xung đột Nhân viên Pha chế & Gen Z: Đảm bảo Gen Z luôn nhận khách số 1 (slot 0 đầu hàng); Thợ pha chế chỉ hỗ trợ khi có từ 2 khách trở lên và tuyệt đối chỉ nhận khách từ người số 2 có thanh kiên nhẫn tuột nhanh nhất, không tranh khách hay khóa khay ly của Gen Z.',
    '🛡️ Gia cố an toàn vòng lặp sự kiện: Thêm khối try-catch bảo vệ banner Giờ cao điểm và chu trình pha chế đa khách.'
  ]},
  {v:'12.47.317',d:'06/10/2026',items:[
    '🧹 Nâng cấp triệt để cơ chế Xoá Cache & Cập nhật bản mới: Khi bấm nút Cập nhật bản mới (hoặc khi mở web phát hiện code mới), hệ thống tự động dọn sạch CacheStorage, ServiceWorker, SessionStorage và ép tải 100% mã nguồn mới nhất từ máy chủ.',
    '👥 Phân luồng ưu tiên chuẩn xác Nhân viên Gen Z & Pha chế: Nhân viên Gen Z luôn ưu tiên đảm nhận khách số 1 (đứng đầu hàng tại quầy); Thợ pha chế chỉ nhận việc khi có từ 2 khách trở lên và chỉ pha chế cho khách từ người thứ 2 có thanh kiên nhẫn tuột nhanh nhất, triệt tiêu hoàn toàn xung đột ly và lỗi đứng game.',
    '⚡ Tối ưu chu trình lấy ly & pha chế: Bảo vệ trạng thái khay ly tại quầy, đảm bảo Gen Z ấn ly và pha liên tục không gián đoạn.'
  ]},
  {v:'12.47.316',d:'06/10/2026',items:[
    '👥 Khôi phục đồng bộ Nhân viên pha chế & Gen Z theo chuẩn update5.10: Giải quyết triệt để lỗi thợ pha chế bị treo ở khách đầu tiên và nhân viên Gen Z không ấn ly lấy đồ uống.',
    '⚡ Thao tác mượt mà: Đảm bảo chu trình pha chế tự động A-Z của Gen Z và phân bổ đa thợ pha chế (multi-worker) hoạt động độc lập, không bị khóa trạng thái lẫn nhau.',
    '📜 Huy hiệu Sổ Tay Công Thức: Tự động hiển thị số lượng công thức bí truyền đã đủ nguyên liệu chế tạo nhưng chưa mở khóa.'
  ]},
  {v:'12.47.300',d:'04/10/2026',items:[
    '🌾 Bộ Ảnh Cây Trồng Nghệ Thuật: Thay thế biểu tượng cũ bằng bộ ảnh vẽ thực tế cho từng loại cây chín (Dâu tây, Đào tiên, Xoài cát, Búp trà xanh, Bạc hà, Chanh vàng)',
    '🌱 Sinh Trưởng Trực Quan: Hiển thị mầm cây khi vừa gieo và cây non đang lớn trên từng luống đất nông trại',
    '🛒 Đồng Bộ Ảnh Nông Sản: Cửa hàng hạt giống, popup gieo hạt và kho hạt giống đồng bộ thumbnail cây trồng thực tế đẹp mắt'
  ]},
  {v:'12.47.299',d:'04/10/2026',items:[
    '🐕 Cơ Chế Chống Spam Click Thú Cưng: Nhấp quá nhanh/spam liên tục khiến cún/mèo mệt lả và buồn bã (Sad sprite), bị tuột điểm vui vẻ (-8 hoặc -5) và không nhận EXP',
    '📈 Mỗi Cấp Tăng 20% Mốc EXP Đạt Lần Sau: Công thức mốc EXP lên cấp chuẩn xác: Cấp 1: 100, Cấp 2: 120, Cấp 3: 144, Cấp 4: 173... giúp cân bằng trải nghiệm nuôi thú cưng'
  ]},
  {v:'12.47.298',d:'04/10/2026',items:[
    '🍓 Dâu Tây Đà Lạt: Thu hoạch +50 phần mứt trái cây ngẫu nhiên chuyển thẳng vào kho hoàn toàn miễn phí',
    '🍑 Đào Tiên Giòn Ngọt: Thu hoạch +50 phần hương thơm/siro ngẫu nhiên chuyển thẳng vào kho',
    '🥭 Xoài Cát Hòa Lộc: Thu hoạch +50 phần topping thơm ngon ngẫu nhiên chuyển thẳng vào kho',
    '🍵 Búp Trà Xanh Cổ Thụ: Thu hoạch +50 phần cốt trà thượng hạng ngẫu nhiên chuyển thẳng vào kho',
    '🌿 Bạc Hà Thơm (10.000đ/túi): Lớn nhanh trong 1 ngày, kích hoạt Buff Organic tăng +20% giá bán mọi ly Hồng trà, Lục trà, Trà Ô long',
    '🍋 Chanh Vàng Quý Tộc (15.000đ/túi): Thu hoạch Tinh dầu chanh, giảm 20% chi phí hao phí đường đá cho cả quán'
  ]},
  {v:'12.47.297',d:'04/10/2026',items:[
    '🎯 Bỏ Hoàn Toàn Cá Cược Tại Ô Ăn Quan & Cờ Nhảy: Xoá bỏ màn hình đặt cược và rủi ro mất tiền két, biến các minigame thành sân chơi giao lưu giải trí dân gian lành mạnh 100%',
    '⚡ Chơi Ngay Lập Tức Khi Nhấn: Mở minigame là vào thẳng ván cờ (Oẳn tù tì phân định lượt đi), bổ sung nút "🎲 Đổi khách" để linh hoạt đổi bạn đấu mới bất cứ lúc nào',
    '🎁 Thắng Trận Vui Vẻ Nhận Quà Tip: Người chơi thắng trận được khách hàng vui vẻ bo tặng +30.000đ tiền tip mà không phải chịu bất kỳ rủi ro trừ tiền nào khi thua'
  ]},
  {v:'12.47.296',d:'04/10/2026',items:[
    '⏳ Hiển Thị Thời Gian Sinh Trưởng Trực Tiếp: Từng mảnh đất hiện rõ nhãn đếm ngược thời gian chín (⏳ Mai chín, ⏳ 2 ngày, 🧺 Chín rồi!) giúp bạn nắm bắt thời điểm thu hoạch tức thì',
    '🎒 Kho Hạt Giống Tự Động Xuống Dòng: Bỏ hoàn toàn thanh cuộn ngang, các túi hạt giống tự xếp thành lưới gọn gàng dễ chọn lựa trên cả điện thoại và máy tính',
    '✨ Thiết Kế Nút Thao Tác 3D Hiện Đại: Nâng cấp cụm nút "Tưới Nước", "Thu Hoạch", "Cửa Hàng" với phong cách 3D nổi khối bắt mắt, hiển thị số lượng cây cần tưới/chín rõ ràng và hiệu ứng lấp lánh'
  ]},
  {v:'12.47.295',d:'04/10/2026',items:[
    '🌱 Thoát Modal Ngay Sau Khi Gieo Hạt: Tự động đóng tab thông báo chọn hạt giống ngay khi bấm gieo hạt, trả về giao diện nông trại trực quan để người chơi chăm sóc cây thuận tiện',
    '💤 Ưu Tiên Nghỉ Ngơi Nhanh Cho Thú Cưng: Đưa lựa chọn "Ngủ tĩnh dưỡng (Nhanh)" lên đầu và highlight nổi bật màu hồng, chuyển minigame "Giấc Mơ Chạy Bộ" xuống dưới'
  ]},
  {v:'12.47.294',d:'04/10/2026',items:[
    '💧 Căn Chỉnh Giọt Nước Ôm Sát Cây Trồng: Gắn trực tiếp giọt nước tưới cây 💧 vào ngay bên cạnh thân/lá cây mầm, triệt tiêu hiện tượng giọt nước bị lệch trôi ra tận rìa góc luống đất',
    '👆 Tưới Nước Trực Tiếp Bằng Cách Chạm: Ngoài nút "Tưới nước tất cả", giờ đây bạn có thể nhấn trực tiếp vào bất kỳ cây nào đang khát nước để tưới riêng cho cây đó ngay lập tức',
    '🖼️ Cập Nhật & Đồng Bộ Ảnh Nền Farm.jpg: Đồng bộ chuẩn hóa tập tin farm.jpg mới nhất kèm cơ chế chống lưu cache trình duyệt, đảm bảo hình ảnh đất đai và hàng rào hiển thị sắc nét nhất'
  ]},
  {v:'12.47.293',d:'04/10/2026',items:[
    '✨ Tối Giản Giao Diện Nông Trại: Gỡ bỏ hoàn toàn các khung nền đen và viền che chắn ô đất, trả lại toàn bộ vẻ đẹp mộc mạc của từng luống đất trong ảnh farm.jpg',
    '🔒 Biểu Tượng Nhỏ Gọn & Tinh Tế: Ô khóa chỉ hiển thị icon ổ khóa nhỏ gọn 🔒, ô trống hiển thị dấu ＋ nhỏ xinh; giá mở ô và tên cây chỉ hiện dạng tooltip nhẹ nhàng khi rê chuột/chạm vào',
    '🌿 Trải Nghiệm Tự Nhiên & Thoáng Mắt: Giữ trọn góc nhìn nông trại xanh mát, cây trồng nhú mầm và ra quả tự nhiên ngay trên nền đất'
  ]},
  {v:'12.47.292',d:'04/10/2026',items:[
    '🌾 Bản Đồ Nông Trại Trực Quan (farm.jpg): Đưa bản đồ nông trại isometric xinh xắn với hàng rào gỗ vào game',
    '🪴 16 Mảnh Đất Chuẩn Xác Từng Tọa Độ: Tích hợp 16 luống đất định vị chính xác 100% theo ảnh farm.jpg, nhấp trực tiếp vào từng luống để gieo hạt, tưới nước và thu hoạch nông sản tươi rói',
    '⛏️ Khai Hoang Mở Rộng: Mở sẵn 6 mảnh đất ban đầu, cho phép dùng tiền két tiệm trà để khai hoang mở rộng toàn bộ 16 luống đất hữu cơ màu mỡ'
  ]},
  {v:'12.47.291',d:'04/10/2026',items:[
    '☀️ Hệ Thống Thời Tiết & Chu Kỳ 4 Mùa (Dynamic Weather & Seasons): Tái hiện trọn vẹn 4 mùa Xuân - Hạ - Thu - Đông sống động, nhiệt độ và thời tiết từng ngày (nắng gắt, mưa rào, se lạnh...) tác động trực tiếp đến thói quen uống trà & lượng khách của quán',
    '🎬 Food TikToker & Reviewer Triệu View (Sự Kiện Đột Xuất): Các kênh ẩm thực triệu follow bất ngờ ghé quán quay livestream, phục vụ chuẩn xác để clip lên Top 1 Trending, nhận tiền tài trợ nóng và bùng nổ +35% khách!',
    '🪴 Khu Vườn Trồng Thảo Mộc / Trái Cây Quán (Mini Garden): Góc ban công sân thượng tiệm trà cho phép gieo hạt Bạc Hà, Dâu Tây, Chanh Vàng, Đào, Xoài... tưới nước chăm sóc và thu hoạch nông sản Organic hoàn toàn miễn phí vào kho'
  ]},
  {v:'12.47.290',d:'04/10/2026',items:[
    '🌙 Giảm mạnh tỉ lệ lấy nhầm size ca đêm: Điều chỉnh tỉ lệ ngái ngủ lấy nhầm size ly của Sinh viên cuối tháng từ 25% xuống còn 5% (giảm gấp 5 lần), giúp đêm bán mượt mà không còn bị tụt điểm đánh giá oan',
    '🐾 Thú cưng tiếp sức ca đêm: Khi thú cưng vui vẻ (Hạnh phúc ≥ 50%), sự hiện diện đáng yêu của bé giúp bạn sinh viên tỉnh táo hơn, tỉ lệ nhầm size giảm sâu chỉ còn 2.5%'
  ]},
  {v:'12.47.289',d:'04/10/2026',items:[
    '🏆 Tách Biệt Icon KPI Nhân Viên & Bạn Bè: Tab "KPI nhân viên" và mục Nhân viên dùng biểu tượng Cúp vàng vinh danh lấp lánh (ic_trophy.png), tách biệt hoàn toàn với biểu tượng 2 bạn nhỏ chibi (ic_people.png) dành riêng cho mục "Bạn bè"',
    '👥 Mở Rộng Bạn Bè Vô Hạn: Gỡ bỏ triệt để giới hạn 5 người, thoải mái kết bạn qua mã/link và thêm bạn bè mẫu không giới hạn số lượng'
  ]},
  {v:'12.47.288',d:'04/10/2026',items:[
    '👥 Cân Bằng Chuẩn Xác Dự Báo Khách (expected): Khắc phục triệt để lỗi tỷ lệ lệch lạc (ban ngày gợi ý ~10 ly, ca đêm ~197 ly), tính chuẩn công suất pha chế thực tế của Thợ pha chế (staff2), Gen Z, máy dán và nâng tầng',
    '🌙 Chuẩn Hóa Phân Bổ Ca Ngày & Ca Đêm: Cân đối hợp lý giữa Khách tại quán ban ngày (~60-65%), Đơn online (~15-20%) và Khách ca đêm sinh viên (~20-25%), giúp Gen Z gợi ý nhập kho chính xác hoàn hảo'
  ]},
  {v:'12.47.287',d:'04/10/2026',items:[
    '🌙 Minigame Giấc Mơ Của Bé: Khi cho thú cưng Đi Ngủ Nệm Ấm, bạn có thể tham gia minigame chạy bộ né chướng ngại vật cùng bé Cún (dog_run) hoặc bé Mèo (cat_run) chạy lon ton về nhà ấm áp',
    '⚡ Cân Chỉnh Nhịp Độ & Tăng Thử Thách: Kéo dài thời gian chạy lên 25s–65s (chuẩn nhịp độ), chướng ngại vật xuất hiện dồn dập và chặn 2 làn liên hoàn, bổ sung cơ chế nhặt Ngôi Sao Mơ Ước (⭐) và Đồ Ăn (🐟/🦴) cộng dồn EXP & tiền két'
  ]},
  {v:'12.47.286',d:'04/10/2026',items:[
    '⚡ Siêu tối ưu dung lượng Web Deploy: Nén nhạc nền Lofi và toàn bộ kho hình ảnh thú cưng/khách hàng, giảm dung lượng dự án từ 58.9MB xuống còn 14.6MB (giảm hơn 75%), tải game siêu nhanh và upload mượt mà lên mọi nền tảng web'
  ]},
  {v:'12.47.285',d:'04/10/2026',items:[
    '🌙 Tính đủ lượng khách ca đêm: Khi đã thuê Sinh viên cuối tháng ở bản Mơ Ước, hệ thống dự báo expected() và thanh thông tin kho hàng sẽ tính đủ cả lượng khách ghé quán ca đêm (22h–6h sáng)',
    '💡 Gen Z gợi ý đặt hàng chuẩn xác: Thuật toán gợi ý nhập nguyên liệu (trà, topping, ly, đá, đường) tính toán dựa trên tổng công suất phục vụ cả ngày lẫn đêm, không còn bị thiếu hụt nguyên liệu khi vào ca đêm'
  ]},
  {v:'12.47.284',d:'04/10/2026',items:[
    '✨ Tối giản biểu tượng hiệu ứng: Tắt toàn bộ biểu tượng bay nổi (🍖, 🍲, 🐟, 😋, ❤️...) khi chăm sóc và tương tác, giữ căn phòng thú cưng trong trẻo và tập trung 100% vào hoạt ảnh nguyên bản sống động của cún và mèo'
  ]},
  {v:'12.47.283',d:'04/10/2026',items:[
    '📈 EXP tăng theo cấp: Mỗi cấp độ mới yêu cầu lượng kinh nghiệm cao hơn (Cấp 1: 100, Cấp 2: 130, Cấp 3: 160...), tạo trải nghiệm nuôi dưỡng thú cưng bền vững',
    '✨ Buff cộng dồn +0.5% mỗi cấp: Lên cấp tăng thêm +0.5% chỉ số buff cho từng bé (Mèo: +2.5%/cấp doanh thu chi nhánh & nhượng quyền; Cún: +2.0%/cấp doanh thu quán & +2.5%/cấp tiền tip)',
    '📱 Tối ưu vừa vặn màn hình: Thu gọn chiều cao sân khấu và bố trí 4 nút chăm sóc trực tiếp trong thẻ thông tin, thao tác cho ăn/tắm/chơi/ngủ vẫn quan sát trọn vẹn hoạt ảnh bé cưng mà không cần cuộn trang',
    '📊 Tích hợp thanh dự báo & cảnh báo: Hợp nhất dự báo sức khỏe và cảnh báo bỏ nhà thành 1 dải thông tin tinh tế, tiết kiệm tối đa diện tích'
  ]},
  {v:'12.47.282',d:'04/10/2026',items:[
    '🍖 Hoạt ảnh hành động tức thì khi chăm sóc: Nhấn Cho Ăn là bé cưng lập tức cúi đầu ăn bát hạt/đĩa pate ngon lành kèm hiệu ứng thức ăn bay lên sống động, không bị đơ hoặc đứng yên',
    '✨ Hoàn thiện hoạt ảnh toàn diện: Tắm bọt bồn gỗ thơm ngát ngập bong bóng, ném bóng/vờn len đuổi bắt rộn ràng, đi ngủ cuộn tròn trên nệm ấm với Zzz khò khò',
    '💖 Chăm sóc linh hoạt: Dù đã đầy no hay sạch sẽ vẫn có thể cho ăn vặt hoặc spa massage nhận phản ứng thích thú và điểm kinh nghiệm'
  ]},
  {v:'12.47.281',d:'04/10/2026',items:[
    '⏳ Dự báo sức khỏe & Thời gian cạn: Hiển thị chi tiết từng chỉ số còn trụ được bao nhiêu ca an toàn, kèm huy hiệu báo động 🚨/⚠️ và thông báo khẩn cấp trước khi mở quán để thú cưng không bao giờ bị bỏ đi bất ngờ',
    '📈 Nâng cấp tăng giới hạn thanh %: Thú cưng lên level càng cao thì giới hạn thanh % càng mở rộng (+15% mỗi cấp độ: Lv1 = 100%, Lv2 = 115%, Lv3 = 130%...), cho phép chăm sóc tích trữ nhiều % hơn để hoạt động bền bỉ'
  ]},
  {v:'12.47.280',d:'04/10/2026',items:[
    '🐾 Vị trí thú cưng mới: Chuyển vị trí bé cún/mèo xuống khoảng giữa đáy bình trà và khay topping, phóng to kích thước lên 72px giúp bé cưng nổi bật, sống động',
    '🛠️ Sửa lỗi nút mua lại trang bị hỏng: Bấm nút "Vào Nâng cấp mua lại" lập tức chuyển chính xác đến tab Nâng cấp > Trang bị'
  ]},
  {v:'12.47.279',d:'04/10/2026',items:[
    '🐾 Thú cưng trên quầy trà: Khi pha chế và bán hàng, cún Shiba hoặc mèo Chiêu Tài sẽ xuất hiện tung tăng đi lại ở khoảng trống giữa bóng thoại order và hàng bình trà',
    '✨ Hoạt ảnh & Tương tác sống động: Thú cưng tự do đi lại, đổi hướng, nằm thư giãn, hoặc chạm để nựng cưng nghe tiếng kêu dễ thương và nhận lời cổ vũ',
    '🎉 Nhảy múa hoan hô: Mỗi khi hoàn thành và giao ly trà cho khách, thú cưng sẽ nhảy cẫng lên reo hò chúc mừng chủ quán',
    '⏳ Cân bằng kiên nhẫn & Sửa lỗi kết ca: Khách chờ giảm 60% tốc độ tụt kiên nhẫn, có 5s ngắm menu, cho phép làm nốt toàn bộ đơn đang đợi trước khi đóng cửa'
  ]},
  {v:'12.47.270',d:'04/10/2026',items:[
    '👥 Khôi phục hệ thống khách hàng gốc: Loại bỏ hoàn toàn hình ảnh khách vẽ ngoài, sử dụng lại 100% khách hàng kinh điển faces.webp, khách ngôi sao star.webp và shipper ship.webp cùng đầy đủ hiệu ứng cảm xúc',
    '⚡ Chuyển đổi trực tiếp mượt mà từ Bản Trà Nhỏ sang Tiệm Trà Mơ Ước không hiện thông báo dev'
  ]},
  {v:'12.47.253',d:'04/10/2026',items:[
    '🍵 Kết Hợp Trực Tiếp Tiệm Trà Nhỏ (Bản Hoài Niệm): Tích hợp trực tiếp bản Tiệm Trà Nhỏ gốc của Dư vị của cơn say từ Lời nhắn từ DEV để quay lại cảm giác hoài niệm (không tự động, không đóng thuế, không nâng cấp, chỉ có kinh doanh trà sữa)',
    '💰 Đồng Nhất Két Tiền 2 Chiều: Tiền trong két được đồng bộ tức thì và dùng chung giữa Tiệm Trà Mơ Ước và Tiệm Trà Nhỏ; nguyên liệu và công thức độc lập hoàn toàn'
  ]},
  {v:'12.47.245',d:'03/10/2026',items:[
    '💰 Cơ Chế Đặt Cược Tiền Đấu Trí Trân Châu: Cho phép đặt cược tiền (0đ giao lưu, 10k, 20k, 50k, 100k, 200k, 500k, 1tr hoặc Tất tay) trước mỗi ván đấu. Thắng nhận gấp đôi tiền cược, thua mất cược, hoà hoàn tiền!',
    '🥤 Đối Thủ Là Khách Hàng Từng Mua Trà Sữa: Mỗi lần chơi là 1 khách hàng hoàn toàn khác nhau. Hệ thống tự động mời các khách quen từng mua trà sữa và để lại đánh giá (kèm đánh giá thực tế) đến quán thách đấu!',
    '🎲 Nút Đổi Khách: Cho phép đổi sang khách hàng khác trước khi cược nếu muốn so tài cùng đối thủ khác'
  ]},
  {v:'12.47.244',d:'03/10/2026',items:[
    '🧋 Đổi Mới Toàn Bộ Thuật Ngữ Đấu Trí Trân Châu: Chuyển đổi toàn bộ tên quan, dân, quan non thành thuật ngữ tiệm trà sữa (Đại Trân Châu Hoàng Kim 5đ, Trân Châu Đen 1đ)',
    '🍯 Bỏ Hoàn Toàn Từ Ngữ Phong Kiến (Quan Non, Chững Quan): Thay bằng Nồi Trân Châu Trái/Phải, Khay Topping 0..10, Nồi đang ủ mật (<5 hạt), Chạm Nồi Trân Châu, bốc rải hạt trân châu',
    '💼 Cập Nhật Đối Thủ & Bảng Điểm: Chị Khách Văn Phòng, bốc rải liên hoàn, giỏ điểm Đại Trân Châu & Trân Châu Đen'
  ]},
  {v:'12.47.243',d:'03/10/2026',items:[
    '🧋 Bổ Sung Trò Chơi Mới: Ô Ăn Quan - Bản Trà Sữa: Trò chơi dân gian Việt Nam với quân Dân là Trân Châu Đen (1đ), quân Quan là Hoàng Kim Đại Quan (5đ)',
    '✊ Oẳn Tù Xì Giành Lượt Đi: Minigame Kéo Búa Bao quyết định bên đi trước giữa Chủ Quán và Khách Hàng',
    '🔄 Cơ Chế Rải Quân & Ăn Quân Chuẩn Dân Gian: Bốc rải liên hoàn, ăn cách 1 ô trống, ăn liên hoàn nhiều ô, quy định chống ăn Quan non (< 5 dân), và tự động chêm 5 quân khi hết quân ở 5 ô'
  ]},
  {v:'12.47.242',d:'03/10/2026',items:[
    '🎲 Khoá Bầu Cua & Xì Dách: Tạm khoá và ẩn toàn bộ các trò chơi Bầu Cua, Xì Dách ra khỏi giao diện game; khoá mã nguồn an toàn (có thể bật lại bất cứ lúc nào)',
    '🏦 Vá Lỗ Hổng Kỳ Hạn Tà Tưa Bank: Khóa triệt để lỗ hổng nạp thêm tiền đổi kỳ hạn ngắn hơn để né phạt rút trước hạn; bảo toàn nguyên vẹn kỳ hạn cam kết ban đầu',
    '📈 Cân Bằng Lãi Suất Tà Tưa Bank Theo Kỳ Hạn: Phân bậc lãi suất hấp dẫn tăng dần theo độ dài kỳ hạn (1 ngày: 0.5%/ngày; 7 ngày: 1.0%/ngày; 14 ngày: 1.2%/ngày; 21 ngày: 1.3%/ngày; 28 ngày: 1.4%/ngày; 35 ngày: 1.5%/ngày)',
    '💎 Giới Hạn Tối Đa Tà Tưa Bank 99 Tỷ: Thiết lập trần hạn mức gửi tiết kiệm tối đa lên đến 99 Tỷ đồng'
  ]},
  {v:'12.47.241',d:'03/10/2026',items:[
    '🐱 Cơ Chế Thuế Me Két Tinh: Đã thuê Me Két Tinh thì quán không bị tính quá hạn/giảm thời gian đóng thuế; chuyển toàn bộ thành thời gian tồn tại buff thuế là 72h và tự động trích két duy trì buff liên tục'
  ]},
  {v:'12.47.240',d:'03/10/2026',items:[
    '🍹 Chuẩn Hóa Logic Thợ Pha Chế (staff2): Loại bỏ triệt để lỗi tranh khách người chơi đang pha. Ưu tiên tuyệt đối khách chờ lâu nhất (thanh kiên nhẫn thấp nhất), đồng bộ chuẩn xác theo mã nguồn gốc',
    '🏛️ Cho Phép Quá Hạn Thuế 72h An Toàn: Loại bỏ hoàn toàn hình thức tịch thu số dư Tà Tưa Bank khi nợ thuế. Tiền gửi được bảo toàn 100% (chỉ tạm ngưng tính lãi kép cho đến khi nộp thuế)',
    '📈 Tinh Chỉnh Giá Nâng Cấp Cấp Độ (Level): Khống chế mức giá tăng phi mã, chạm trần tối đa 500 triệu ở Cấp 20 và cố định chỉ 500 triệu/cấp từ Cấp 20 trở đi'
  ]},
  {v:'12.47.239',d:'03/10/2026',items:[
    '🐱 Tự Động Đóng Thuế Chuẩn Xác (Me Két Tinh): Khắc phục triệt để lỗi Me Két Tinh không tự động đóng thuế khi được thuê. Bỏ hoàn toàn ràng buộc chờ quá hạn 12h và tỉ lệ hên xui 35%',
    '🛡️ Bảo Vệ Sổ Tiết Kiệm Tà Tưa Bank 100%: Me Két Tinh tự động trích 15% két đóng thuế 72h khi sắp hết hạn (còn dưới 2h) hoặc khi đã hết hạn, đảm bảo sổ tiết kiệm không bao giờ bị ngân hàng tịch thu'
  ]},
  {v:'12.47.238',d:'03/10/2026',items:[
    '📏 Tự Động Fix Vừa Chiều Cao Khung Order: Áp dụng thuật toán co giãn font thông minh cho khung lời thoại order (#q3say), giới hạn an toàn max-height 68px, đảm bảo câu thoại dài nhiều ly topping luôn hiển thị trọn vẹn, không bao giờ tràn khung hay đè lên thanh Kiên Nhẫn'
  ]},
  {v:'12.47.237',d:'03/10/2026',items:[
    '✨ Thu Gọn Kích Thước Tiền Bill & Ngôi Sao Đánh Giá: Đưa phần tử float vào thẳng stage để scale đồng bộ theo màn hình, giảm kích thước font (15px), padding gọn gàng (2px 8px), không còn bị to thô hay che hũ trà'
  ]},
  {v:'12.47.236',d:'03/10/2026',items:[
    '🎨 Logo Quán Đồng Bộ & Tải Ảnh Cá Nhân: Bổ sung logo quán ngay trước tên tiệm (biển hiệu) và trên trang Mạng Xã Hội, đồng bộ chuẩn xác với tem ly trà sữa; hỗ trợ tải trực tiếp ảnh cá nhân từ máy lên làm logo',
    '🎬 Cơ Chế Quay & Đăng Video MXH: Số lượt quay video trong ngày gắn liền với chiến dịch quảng cáo đang chạy (tối đa theo số bài đăng/ngày của gói ads); mỗi lần ấn quay nhận ngẫu nhiên % Buff khách quán chính (reset sau mỗi lần nhấn)',
    '⭐ Tối Ưu Vị Trí Tiền Bill & Ngôi Sao Đánh Giá: Chuyển vị trí hiển thị tiền bill và đánh giá xuống dưới khung order, hoàn toàn tránh che avatar khách và khung order; ngôi sao đánh giá đổi sang màu vàng rực rỡ',
    '🧋 Khung Order Vừa Vặn & Nét Rõ: Tối ưu kích thước chữ và khoảng cách trong khung order (q3say), giúp text hiển thị to rõ, cân đối hoàn hảo trong bubble hội thoại'
  ]},
  {v:'12.47.235',d:'03/10/2026',items:[
    '🚶‍♂️ Xoá Bỏ Hoàn Toàn Người Đi Bộ Ngoài Phố: Dọn sạch toàn bộ hoạt ảnh, spawn, tick di chuyển và tiến trình ngầm của khách đi bộ trên vỉa hè trước tiệm',
    '🧋 Đồng Bộ Pha Chế Ca Đêm Giống Gen Z: Ẩn toàn bộ dòng trạng thái chi tiết nguyên liệu pha chế (đang dùng topping gì, pha trà gì, siro gì...) của nhân viên ca đêm, chuyển về thông báo tự động gọn gàng "Tự động pha chế A-Z... ✨" và loại bỏ re-render widget liên tục'
  ]},
  {v:'12.47.234',d:'03/10/2026',items:[
    '⚡ Tối Ưu Hiệu Năng & Triệt Tiêu Giật Lag Khi Chơi: Loại bỏ vòng lặp kiểm tra bản quyền ngầm chạy mỗi 100ms trong tick game, giải phóng hoàn toàn gánh nặng CPU cho máy',
    '🛠️ Tinh Chỉnh DOM & Render Widget: Giảm 90% tần suất cập nhật DOM widget nhân viên đi chợ trong lúc bán, chỉ cập nhật khi thay đổi số giây còn lại',
    '🧹 Tự Động Dọn Dẹp Interval Người Đi Bộ: Ngăn chặn triệt để tiến trình chạy ngầm người đi bộ ngoài phố khi đang ở trong quầy pha chế',
    '🚀 Kích Hoạt GPU Hardware Compositing: Bổ sung will-change, contain layout và dọn sạch các bộ lọc CSS drop-shadow gây nghẽn tốc độ khung hình (FPS), mang lại trải nghiệm mượt mà 60fps chuẩn như bản gốc'
  ]},
  {v:'12.47.233',d:'03/10/2026',items:[
    '🍵 Giảm Âm Lượng Tiếng Rót Trà Xuống 10%: Tinh chỉnh mức âm lượng của hiệu ứng rót trà (pour.wav) từ 30% xuống còn 10% (0.1), mang lại không gian êm dịu, dễ chịu và không bị ồn ào khi liên tục pha chế'
  ]},
  {v:'12.47.232',d:'03/10/2026',items:[
    '📢 Tăng Doanh Thu Chi Nhánh & Nhượng Quyền Khi Chạy Ads: Tự động cộng hưởng doanh thu toàn chuỗi khi kích hoạt chiến dịch quảng cáo (+15% với Facebook Ads, +35% với TikTok Ads, +60% với KOL Review, +90% với Billboard Ngã Tư)',
    '🏢 Hiển Thị Chi Tiết Buff Doanh Thu Ads: Bổ sung huy hiệu phần trăm tăng trưởng từ quảng cáo trực tiếp trên thẻ Chi nhánh và Nhượng quyền',
    '📊 Thống Kê Chuẩn Khớp Lợi Nhuận Toàn Chuỗi: Cập nhật doanh thu thực tế và phí bản quyền nhượng quyền thu về két tăng mạnh tương ứng theo từng loại quảng cáo'
  ]},
  {v:'12.47.231',d:'03/10/2026',items:[
    '⚖️ Cân Bằng Toàn Diện Quỹ Thưởng KPI Nhân Viên: Khống chế tổng quỹ thưởng KPI cả đội ngũ ở mức an toàn 5% - 8% tổng doanh thu tuần (Xuất sắc: +150k + 0.8% DT, Đạt chuẩn: +50k + 0.3% DT), chấm dứt hoàn toàn tình trạng bị âm tiền két hay phải bù bank',
    '🛡️ Điều Chỉnh Lương Chú Bảo Vệ Hợp Lý: Đổi từ 10% doanh thu mỗi ngày xuống 300k/ngày + 1% doanh thu, tiết kiệm hàng triệu đồng chi phí mỗi ngày cho chủ tiệm',
    '👮‍♂️ Bảo Vệ Chặn Đứng 100% Khách Ăn Quỵt 0đ: Khi có Chú bảo vệ, tuyệt đối không bao giờ bị khách ăn quỵt 0đ ly sai món; chú bảo vệ sẽ lập tức đòi đủ 100% tiền bill về két',
    '💰 Trả Lại 70% Tiền Tip Cho Chủ Tiệm: Tiền bo của khách được nạp thẳng 70% vào két doanh thu của tiệm (thay vì bị nhân viên nuốt trọn 90%-100%)',
    '🚀 Bùng Nổ Hiệu Quả Chiến Dịch Ads: Mở bung trần traffic lên 10.0x khi chạy Ads, tăng mạnh tỉ lệ khách gọi nhiều ly (2-4 ly) và đơn online nổ liên tục'
  ]},
  {v:'12.47.230',d:'03/10/2026',items:[
    '👥 Sửa Lỗi Hiển Thị "Phát Lương (0 NV)" Trong Chi Nhánh: Đồng bộ chuẩn xác trường đếm số lượng nhân viên thực tế của chi nhánh (staff/staffCount) trong bảng kết quả ca trước',
    '📊 Chuẩn Hoá Thống Kê Nhân Sự Chi Nhánh: Đảm bảo số lượng nhân viên tự tuyển và lương quản lý Lích đờ hiển thị chuẩn khớp 100% với số tiền phát lương thực tế'
  ]},
  {v:'12.47.229',d:'03/10/2026',items:[
    '🌙 Phục Vụ Hết Khách Mới Kết Ca Sau 10h (22:00): Quán ngừng nhận thêm khách mới sau 10h, nhưng tất cả khách đang chờ tại quầy và đơn online sẽ được làm nốt trọn vẹn',
    '🚫 Bỏ Hạn Giờ 8s Huỷ Đơn Cưỡng Ép: Xoá bỏ hoàn toàn cơ chế tự huỷ đơn sau 8s đóng cửa, giúp chủ tiệm và nhân viên thoải mái pha chế nhận trọn doanh thu và đánh giá tốt',
    '🛑 Nút Đóng Ca Chủ Động: Chủ tiệm vẫn có thể chủ động bấm "Đóng ca & Tổng kết ngay" bất cứ lúc nào nếu không muốn tiếp tục làm thêm giờ'
  ]},
  {v:'12.47.228',d:'03/10/2026',items:[
    '☕ Bổ Sung Nhạc Nền "Lofi Chill Quán Cafe 2026": Thưởng thức tuyển tập những ca khúc Lofi nhẹ nhàng, thư giãn dành riêng cho không gian quán trà',
    '🎵 Chế Độ Tự Động Chuyển Bài Sau Khi Hết: Mặc định phát trọn vẹn tuyển tập Lofi Chill, khi bài Lofi kết thúc sẽ tự động chuyển tiếp sang nhạc nền theo mùa (Thu, Đông, Xuân, Hè)',
    '🎛️ Nút Cài Đặt Nhạc Nền & Mùa Linh Hoạt: Dễ dàng chuyển đổi trực tiếp giữa Nhạc Lofi Chill Quán Cafe, Nhạc Tự Động Theo Mùa và từng mùa riêng biệt'
  ]},
  {v:'12.47.227',d:'03/10/2026',items:[
    '👥 Sửa Triệt Để Lỗi "countLabel is not defined" Trong Tab KPI: Khắc phục lỗi phạm vi biến khiến bảng KPI nhân viên bị lỗi không thể hiển thị',
    '📊 Hiển Thị Chuẩn Xác Thông Tin Đội Ngũ: Đảm bảo số lượng thợ, nhân viên đi chợ và trạng thái báo nghỉ của nhân viên online hiển thị đầy đủ, sắc nét'
  ]},
  {v:'12.47.226',d:'03/10/2026',items:[
    '📱 Quy Định Báo Trước 1 Ngày Cho Nhân Viên Online: Nhân viên đơn online xin nghỉ phép hoặc nghỉ việc bắt buộc phải nộp đơn báo trước 1 ngày, chấm dứt hoàn toàn tình trạng nghỉ ngang đột xuất làm các đơn online bị bỏ rơi',
    '🧋 Hoàn Thành Trọn Vẹn Ca Làm Hôm Đó: Trong ngày nộp đơn báo trước, nhân viên online vẫn đi làm bình thường và xử lý đầy đủ 100% tất cả các đơn online cho đến khi hết ca',
    '🛵 Điều Phối Ca Nghỉ Thông Minh: Vào ngày nhân viên online nghỉ phép, chủ tiệm có thể chọn thuê CTV thời vụ trực thay (-100k) để đơn online chạy mượt mà, hoặc tạm đóng nhận đơn online hôm đó để tránh bị trễ đơn'
  ]},
  {v:'12.47.225',d:'02/10/2026',items:[
    '🪟 Căn Giữa Hoàn Hảo Chế Độ Cửa Sổ Nhỏ: Tối ưu bộ định vị Flexbox và ma trận scale đối xứng, đảm bảo khung game luôn nằm chính giữa 100% cửa sổ thu nhỏ, không bao giờ bị lệch góc hay trôi khỏi tầm nhìn',
    '🖼️ Triệt Tiêu Hình Nền Thừa Phía Sau: Ẩn triệt để hình nền kệ gỗ khi ở chế độ cửa sổ nhỏ, thay bằng phông nền gỗ trà tối sang trọng giúp làm nổi bật khung game',
    '📐 Scale Tỉ Lệ Chéo Mượt Mà: Co giãn khung hình theo tỉ lệ điện thoại di động (430 × 860) siêu nét khi phóng to hoặc thu nhỏ cửa sổ trình duyệt'
  ]},
  {v:'12.47.220',d:'02/10/2026',items:[
    '🛡️ Sửa Triệt Để Lỗi Báo Chặn Lưu Tiến Trình Trên iPhone/Safari: Loại bỏ vĩnh viễn việc nhân đôi dung lượng lưu trữ (SAVE_persist) và xoá sạch dữ liệu backup rác làm tràn hạn mức 5MB của Safari',
    '⚡ Cơ Chế Tự Động Nén & Chống QuotaExceededError Thông Minh: Tự động dọn dẹp các mẩu đánh giá/lịch sử cũ nếu bộ nhớ máy đầy, đảm bảo luôn lưu thành công 100%',
    '✅ Không Báo Lỗi Giả Khi Đã Có Dữ Liệu: Khắc phục lỗi storeCheck() hiển thị cảnh báo vô lý đối với tài khoản đã có dữ liệu chơi lâu ngày (như Ngày 111)'
  ]},
  {v:'12.47.219',d:'02/10/2026',items:[
    '🧋 Cân Bằng Tỉ Lệ Khách Vãng Lai Gọi Món Độc Bản: Giảm tỉ lệ khách vãng lai thông thường ghé quán gọi các món trà sữa độc bản đã chế tạo từ 35% xuống chuẩn 5%',
    '✨ Giữ Tính Độc Đáo & Hiếm Có Của Đồ Uống Đặc Biệt: Đảm bảo khách quầy đa phần thưởng thức menu trà sữa truyền thống thông thường, món độc bản chỉ xuất hiện như những điểm nhấn tinh hoa bất ngờ trong ca bán'
  ]},
  {v:'12.47.218',d:'02/10/2026',items:[
    '📊 Khôi Phục Hoàn Toàn Bảng Tổng Kết Doanh Thu Cuối Ngày: Khắc phục triệt để lỗi phạm vi biến (ReferenceError guardRestAlert) khiến bảng tổng kết bị văng lỗi vào fallback rút gọn, khôi phục lại nguyên vẹn 100% bảng tổng kết doanh thu, chi phí, lợi nhuận, đánh giá sao và két tiền như bản gốc',
    '🔍 Khắc Phục Nút "Tổng Kết" (seeSum): Chuyển hướng chính xác vào tab "Tổng Kết" (tongket/paneSum) với đầy đủ bảng chi tiết doanh thu từng món, tỉ trọng %, chi phí cố định & biến đổi, lãi gộp và lợi nhuận ròng'
  ]},
  {v:'12.47.217',d:'02/10/2026',items:[
    '⭐ Giảm Tần Suất Khách Chuyên Gia Michelin Về Mức Cân Bằng Hợp Lý: Giảm tỉ lệ xuất hiện ngẫu nhiên từ 25% xuống 5%, đồng thời giới hạn tối đa 1 lượt chuyên gia ghé quán mỗi ca bán để giữ tính quý giá, danh giá',
    '🛡️ Sửa Triệt Để Lỗi Chuyên Gia Gọi Món Chưa Mở Khóa: Khách Chuyên Gia chỉ gọi các món độc bản mà người chơi ĐÃ CHẾ TẠO / MỞ KHÓA thành công trong Sổ Tay Công Thức (craftedRecipes)',
    '✅ Kiểm Tra Mở Khóa & Menu Chặt Chẽ: Mọi nguyên liệu của công thức phải được mở khóa thực tế trong quán (unlocked), không bị tắt bán khỏi menu và còn đầy đủ tồn kho mới được phục vụ'
  ]},
  {v:'12.47.216',d:'02/10/2026',items:[
    '🧋 Khắc Phục Triệt Để Lỗi Báo Hết Món Dù Kho Còn Hàng: Chuẩn hóa 25 công thức món mới độc bản khớp hoàn toàn 100% với danh mục nguyên liệu thực tế trong quầy (thay thế triệt để các alias tên ảo, số hóa định lượng đường và chuẩn hóa định mức đá)',
    '🛡️ Cơ Chế Kiểm Tra Tồn Kho Thông Minh canMakeRecipe: Khách gọi món độc bản và Khách Thẩm Định Michelin chỉ xuất hiện khi tiệm đã mở khóa và còn đầy đủ nguyên liệu trong quầy để pha chế',
    '🤝 Tối Ưu Linh Hoạt Đổi Món: Khách vào tiệm sẽ ưu tiên đổi sang các vị trà và topping còn hàng nếu loại ngẫu nhiên bị thiếu, chấm dứt hoàn toàn tình trạng vô lý bỏ về khi quán vẫn còn ngập tràn nguyên liệu',
    '🎨 Tinh Chỉnh Giao Diện Nút Hủy Đơn: Thu gọn nút × và nhãn "Hết" trên avatar hàng chờ vừa vặn, không còn bị phóng to đè lấn sang khách bên cạnh'
  ]},
  {v:'12.47.215',d:'02/10/2026',items:[
    '📢 Khôi Phục & Tối Ưu Mục Chạy Quảng Cáo Mạng Xã Hội: Đổi mới toàn bộ tên định danh CSS sang chuẩn mxh-campaigns nhằm ngăn chặn 100% việc các tiện ích AdBlock (uBlock, AdGuard, Brave Shields) vô tình chặn hiển thị 4 gói quảng cáo',
    '✨ Hiển Thị Trực Quan Cả 4 Chiến Dịch Toàn Chuỗi: Luôn hiển thị đầy đủ 4 gói chiến dịch (Facebook Ads, TikTok Ads, KOL Review, Treo Billboard) kèm trạng thái trực quan rõ ràng (Đang chạy / Chờ hết đợt cũ / Kích hoạt)',
    '🛡️ Tự Động Làm Sạch & Đồng Bộ Dữ Liệu Quảng Cáo: Tự động loại bỏ các chiến dịch hết hạn hoặc rác dữ liệu, bảo đảm trải nghiệm kích hoạt và cộng buff khách hàng mượt mà'
  ]},
  {v:'12.47.214',d:'02/10/2026',items:[
    '⭐ Cập Nhật Quy Chế Thưởng KPI Nhân Viên: Xuất sắc (+1tr thưởng nóng + 5% tổng doanh thu chu kỳ 7 ca, +5% khách); Đạt chuẩn (+500k thưởng nóng + 2% tổng doanh thu chu kỳ 7 ca, +2% khách); Không đạt (Trừ 20% lương ca hoàn két, làm không lương 1 ngày). Lương ca đã trừ vào bill mỗi ngày',
    '📊 Chuẩn Hóa Phương Diện Tính Tổng Doanh Thu KPI: Doanh thu tính thưởng KPI được ghi nhận chính xác theo tổng doanh thu bán hàng thực tế tích lũy của tiệm xuyên suốt chu kỳ 7 ca bán'
  ]},
  {v:'12.47.213',d:'02/10/2026',items:[
    '🏛️ Sửa triệt để lỗi đường đen trên tab "Thuế & Bank": Bổ sung cơ chế cache-busting (?v=...) bắt buộc tải mới toàn bộ icon đồ họa chuẩn hóa, xóa vĩnh viễn vệt đen cũ tồn lưu trong bộ nhớ đệm trình duyệt',
    '🏦 Giảm 5% tổng hạn mức gửi Tà Tưa Bank khi trừ 1 lần 5 sao tổng: Khi mua Túi Quà (1 Tỷ + 1 Lần 5★), tổng hạn mức gửi tiết kiệm ngân hàng sẽ giảm 5% tương ứng với điểm mốc 5 sao tiêu hao',
    '🛡️ Cố định đồng bộ hạn mức ngân hàng: Đảm bảo hạn mức sau khi trừ 5% được bảo lưu chuẩn xác trong toàn bộ phiên chơi'
  ]},
  {v:'12.47.212',d:'02/10/2026',items:[
    '🏦 Rút Trước Hạn Tiền Gửi Bank Khi Két Không Đủ Trả Lương: Khi két thiếu tiền thanh toán thưởng KPI ngày thứ 7, hệ thống tự động hiển thị số dư tiền gửi Tà Tưa Bank để chi trả bù (rút trước hạn), bảo vệ nhân viên không bị đình công hay nghỉ việc',
    '🛡️ Bảo Vệ Phá Sản Bằng Tiền Gửi Bank: Tự động tất toán nguồn tiền gửi ngân hàng cứu nguy nếu cuối ngày phát sinh chi phí khiến két âm'
  ]},
  {v:'12.47.211',d:'02/10/2026',items:[
    '🏛️ Đổi Tên Tab "Thuế & Bank": Cập nhật chuẩn tên tab tại quầy chuẩn bị thành "Thuế & Bank" bao quát toàn bộ tài chính ngân hàng và thuế tiệm',
    '✨ Hiệu Ứng Mở Túi Quà Sinh Động: Hiệu ứng rung lắc túi bí mật, phát nổ ánh sáng hào quang và lật thẻ 3D hồi hộp kèm âm thanh độ hiếm',
    '🛒 Mở Bán Gói Pack 1 Tỷ + 1 Lần 5★: Người chơi có thể dùng 1.000.000.000đ két + 1 lần đạt 5 sao tổng để mua ngay 1 Túi Quà 3 nguyên liệu',
    '📦 Tăng 20% Tỉ Lệ Trùng Nguyên Liệu Đã Có: Hạn chế mở full bộ sưu tập quá nhanh, tăng tính thử thách và giá trị cho các thẻ SSR hiếm',
    '👮‍♂️ Chú Bảo Vệ Nghỉ 1 Ngày Bán Hàng: Sau 3 ca làm liên tục, chú bảo vệ nghỉ trọn 1 ngày bán hàng (1 ca bán) thay vì đếm 24h thời gian thực'
  ]},
  {v:'12.47.210',d:'02/10/2026',items:[
    '🏆 Tinh Giản Đánh Giá Reset 5 Sao: Bỏ hoàn toàn chuỗi phản hồi không cần thiết (không rep Me Két Tinh, chủ tiệm hay khách), dọn sạch phản hồi thừa cũ và hiển thị banner vinh danh trang trọng',
    '🧋 Khách Hàng Gọi Món Đồ Uống Đặc Biệt: Khách ghé tiệm có tỉ lệ gọi các món công thức độc bản người chơi đã chế tạo trong Sổ Tay Công Thức',
    '✨ Đánh Giá Khách Hàng Mua Đồ Uống Đặc Biệt: Khi thưởng thức món độc bản, khách luôn để lại đánh giá 5★ chất lượng gắn nhãn tím lấp lánh "Đồ Uống Đặc Biệt"',
    '🎉 Tự Động Đồng Bộ Đánh Giá Món Đặc Biệt: Tự động ghi nhận đánh giá của các món trà sữa độc bản đã chế tạo ngay khi vào mục Đánh Giá'
  ]},
  {v:'12.47.209',d:'02/10/2026',items:[
    '♾️ Ly + Ống Hút Sử Dụng Vĩnh Viễn: Gỡ bỏ hạn sử dụng 1 ngày của Ly + ống hút, vật phẩm không bao giờ bị hỏng hay hết hạn',
    '🏢 Tinh Gọn Nút Chi Nhánh: Bỏ icon 🏢 trước chữ Chi Nhánh và thu gọn nút để không đè vào nút Bộ Sưu Tầm hay số dư tiền',
    '👮‍♂️ Nhân Viên Mới "Chú Bảo Vệ": Điều kiện mở sở hữu ít nhất 1 công thức độc bản. Lương 10% doanh thu/ngày. 100% không bao giờ bị tiền giả, trộm cắp, lừa đảo (không mặc cả, không trả thiếu, tóm 100% khách ôm ly chạy)',
    '📉 Giảm 50% Tỉ Lệ Sai Sót Của Nhân Viên: Giảm một nửa lỗi pha chế đổ vỡ, sai ly của thử việc, lỗi ca đêm và rủi ro nhập nguyên liệu hỏng',
    '😴 Chu Kỳ Nghỉ 24H: Sau 3 ngày làm việc liên tục, chú bảo vệ phải nghỉ 1 ngày (khóa gọi làm trong 24h). Trong ngày nghỉ, các nguy cơ xấu sẽ tăng cao'
  ]},
  {v:'12.47.208',d:'02/10/2026',items:[
    '📅 Sửa Lỗi Hết Ca Không Qua Ngày Mới: Đã khai báo hàm upgCount tính chi phí nâng cấp, kết thúc ca mượt mà và chuyển ngày tức thì',
    '💾 Cơ Chế Tự Động Lưu & Tăng Ngày An Toàn: Bảo đảm dữ liệu ngày mới luôn được lưu trữ chính xác ngay khi kết thúc ca',
    '🛡️ Chặn Tự Động Tải Lại Khi Bán Hàng: Đảm bảo không bị gián đoạn hay mất tiến trình khi đang chơi ca bán'
  ]},
  {v:'12.47.207',d:'02/10/2026',items:[
    '🍁 Đổi Mùa Đổi Nhạc Lập Tức: Sửa lỗi đổi mùa trong Cài đặt, tự động chuyển ngay bài nhạc nền tương ứng (Xuân, Hạ, Thu, Đông, Tự động)',
    '🎵 Nhạc Nền Độc Lập Hoàn Toàn: Tắt nút Âm thanh hiệu ứng không làm ảnh hưởng đến Nhạc nền, nhạc nền vẫn du dương êm ái',
    '🔉 Cân Bằng Âm Lượng Hiệu Ứng 30%: Điều chỉnh toàn bộ chuông bell.mp3, két tiền cash.mp3, rót nước pour.wav và thăng cấp levelup.mp3 về chuẩn 30%',
    '🔇 Triệt Tiêu 100% Âm Bíp Giả Lập: Gỡ bỏ hoàn toàn bộ tổng hợp Web Audio oscillator giả lập, giữ cho trải nghiệm âm thanh thuần khiết từ snd/'
  ]},
  {v:'12.47.206',d:'02/10/2026',items:[
    '🚀 Đột Phá Bộ Phát Âm Thanh Kép (HTML5 Audio + Web Audio): Khắc phục dứt điểm lỗi không nhận âm thanh snd/ khi chạy trên môi trường chặn fetch/CORS',
    '🎵 Nhạc Nền Mùa Thu Thật: Nhạc nền m_thu.mp3 phát trực tiếp êm dịu, loại bỏ 100% tiếng nhạc bíp điện tử oscillator',
    '🔔 Chuông Cửa Thật & Két Tiền Thật: bell.mp3 vang lên khi khách đến và cash.mp3 giòn giã khi thanh toán đơn hàng',
    '🍵 Tiếng Rót Nước Thật (pour.wav): Âm thanh rót trà và nước sữa thực tế phát trực tiếp mượt mà',
    '🔇 Vô Hiệu Hóa Âm Topping: Hoàn toàn im lặng khi múc topping, bơm siro/đường và gắp đá'
  ]},
  {v:'12.47.205',d:'02/10/2026',items:[
    '🎵 Nhạc Nền Mùa Thu (m_thu.mp3): Cấu hình bài nhạc nền mặc định của tiệm là m_thu.mp3 nhẹ nhàng, êm dịu',
    '🔔 Âm Thanh Khách Vào Quán: Sử dụng chuẩn chuông bell.mp3 khi khách ghé tiệm hoặc khách đặc biệt xuất hiện',
    '💰 Âm Thanh Khách Tính Tiền: Phát âm cash.mp3 giòn giã khi nhận tiền thanh toán đơn hàng',
    '🍵 Âm Thanh Rót Trà: Sử dụng âm thanh thực tế pour.wav khi rót trà và nước sữa vào ly',
    '🔇 Tắt Âm Thao Tác Topping: Tắt hoàn toàn âm thanh khi múc trân châu, topping, bơm siro/đường và gắp đá'
  ]},
  {v:'12.47.204',d:'02/10/2026',items:[
    '🌸 Nhạc Nền 4 Mùa (snd/): Tích hợp đầy đủ vào mã nguồn 4 bài nhạc nền 4 mùa m_xuan.mp3, m_he.mp3, m_thu.mp3, m_dong.mp3',
    '🔔 Bộ Âm Thanh Độc Quyền Chuẩn: Bao gồm trọn vẹn 5 hiệu ứng âm thanh (bell, cash, levelup, pour, rain) và 4 bài nhạc nền 4 mùa',
    '🎛️ Nút Chọn Mùa Trực Quan: Thêm nút "Nhạc theo mùa" trong Cài đặt (Tự động / Xuân / Hạ / Thu / Đông)'
  ]},
  {v:'12.47.203',d:'02/10/2026',items:[
    '🔔 Bộ Hiệu Ứng Âm Thanh Chuẩn Xác: Chỉ nạp và sử dụng duy nhất 5 file hiệu ứng âm thanh cốt lõi (bell.mp3, cash.mp3, levelup.mp3, pour.wav, rain.mp3)',
    '☕ Tối Giản Nhạc Nền: Giữ nguyên âm nhạc nền Lofi nhẹ nhàng và loại bỏ toàn bộ các file âm thanh ngoài lề khác'
  ]},
  {v:'12.47.202',d:'02/10/2026',items:[
    '⚡ Khắc Phục Lỗi Đứng Game Khi Đổi Phút Bán: Sửa triệt để lỗi đứng game sau khi đổi thời gian bán mỗi ngày (4p/5p/6p), tiếp tục ca bán mượt mà ngay khi đóng Cài đặt',
    '🎵 Thêm Lại Bộ Tài Nguyên Âm Thanh Chuẩn: Tích hợp đầy đủ các hiệu ứng âm thanh từ snd/ (bell.mp3, cash.mp3, levelup.mp3, pour.wav, rain.mp3)',
    '🌸 Nhạc Nền 4 Mùa & Trời Mưa: Thêm lại trọn bộ nhạc nền 4 mùa (m_xuan.mp3, m_he.mp3, m_thu.mp3, m_dong.mp3) cùng nút đổi mùa (Tự động / Xuân / Hạ / Thu / Đông) trong Cài đặt'
  ]},
  {v:'12.47.201',d:'02/10/2026',items:[
    '📅 Sửa Lỗi Kết Ca Sang Ngày Mới: Sửa dứt điểm lỗi ấn kết ca bị reload lại game vào ngày cũ. Tự động chuyển mượt sang ngày tiếp theo và vào kho chuẩn bị',
    '⏱️ Chỉnh Thời Gian Bán Mỗi Ngày 4p/5p/6p: Chuyển đổi chính xác và xoay vòng ổn định giữa các mốc 4 phút, 5 phút, 6 phút trong Cài đặt quán',
    '🏛️ Khôi Phục Tính Thuế & Phí Chuẩn Xác: Khắc phục biến số thuế r.tax bị thiếu gây lỗi số liệu trong sao kê kết ca cuối ngày'
  ]},
  {v:'12.47.200',d:'02/10/2026',items:[
    '🍹 Sửa Lỗi Thợ Pha Chế Tăng Ca Đêm: Khắc phục triệt để lỗi thợ pha chế bị dừng hoạt động trong ca đêm (22h - 6h), phục vụ mượt mà kể cả khi có 1 khách',
    '🤝 Phối Hợp Nhịp Nhàng Ca Đêm: Thợ pha chế và Sinh viên ca đêm chạy song song cực kỳ ăn ý, không trùng đơn, tối ưu tốc độ phục vụ xuyên đêm',
    '💰 Hạch Toán Lương OT Ca Đêm: Tích lũy đủ thời gian tăng ca đêm (+40k/h/người sau 22h) và trả lương OT chuẩn xác theo số lượng thợ trong bảng sao kê cuối ngày'
  ]},
  {v:'12.47.199',d:'02/10/2026',items:[
    '🛡️ Giảm Mạnh Tỉ Lệ Tiền Giả: Giảm sâu tỉ lệ tiền giả xuống 4-5 lần (két >1 tỷ chỉ còn 3.5%, két thường 0.3%)',
    '👑 Miễn Nhiễm Tiền Giả Hoàn Toàn: Khách thẩm định món đặc biệt, Food Reviewer VIP, Bạn bè, Khách nhận ly Free và Khách ngoại quốc 100% không dùng tiền giả',
    '🐱 Me Két Tinh Siêu Cấp Buff Sao: Tăng tỉ lệ Me két tinh phản hồi ngọt ngào buff nâng sao lên đến 70%, quét 30 review gần nhất, nâng sao thấp vọt +2★',
    '⭐ Kích Hoạt Tăng 5 Sao Tổng: Khi Me két tinh buff đánh giá tiệm chạm mốc xuất sắc 5 sao, lập tức tăng 1 lần 5 sao tổng và nâng hạn mức Tà Tưa Bank'
  ]},
  {v:'12.47.198',d:'02/10/2026',items:[
    '📜 Trọn Bộ 25 Công Thức Kết Hợp: Mở khóa 25 công thức sáng tạo từ 100% nguyên liệu đã có (Cấp 1, Cấp 2, Cấp 3 và Cấp SSR thượng hạng)',
    '👑 Khách Hàng Thẩm Định Đặc Biệt: Xuất hiện ghé quầy order các món kết hợp độc quyền kèm hiệu ứng huy hiệu hoàng gia',
    '⭐ Tăng 1 Lần 5 Sao Tổng & Hạn Mức Bank: Mỗi khách thẩm định hoàn thành chuẩn vị tặng ngay cho tiệm 1 lần 5 sao tổng và nâng hạn mức gửi Tà Tưa Bank (+10%)',
    '👥 Cập Nhật Nhân Sự Mỗi 10 Cấp: Nâng cấp nhân viên mỗi 10 cấp tuyển thêm 1 thợ pha chế + 1 nhân viên đi chợ chạy song song'
  ]},
  {v:'12.47.197',d:'02/10/2026',items:[
    '👥 Nâng Cấp Nhân Sự Mỗi 10 Cấp: Cứ mỗi 10 cấp Nâng cấp Nhân viên được mở thêm 1 Thợ pha chế (staff2) VÀ 1 Nhân viên đi chợ (staffBuyer)',
    '🛵 Đội Ngũ Đi Chợ Chạy Song Song: Cho phép nhiều nhân viên đi chợ cùng khởi hành mua nhiều nguyên liệu khác nhau đồng thời, giải quyết cạn kho siêu tốc',
    '➕ Nút Thuê Thêm & Giảm Bớt Đi Chợ: Bổ sung nút bấm trực tiếp trong tab Nhân viên (Nâng cấp) cho cả thợ pha chế và nhân viên đi chợ',
    '💼 Hạch Toán Lương & KPI Chuẩn Xác: Tính lương ngày và tổng kết KPI theo đầu người cho toàn bộ thợ pha chế và nhân viên đi chợ'
  ]},
  {v:'12.47.196',d:'02/10/2026',items:[
    '🎁 Mốc Pha Chế Chuẩn 1000 Ly: Cứ đạt mỗi 1000 ly pha chế (1000, 2000, 3000, 4000...) sẽ được tặng ngay 1 Túi Quà 3 nguyên liệu ngẫu nhiên',
    '✨ Chuẩn Hóa Tỉ Lệ Gacha: N (Common 70%), R (Rare 24.5%), SR (Super Rare 5%), SSR (Super Super Rare 0.5%)',
    '⚡ Khắc Phục Triệt Để Lỗi Kẹt Kết Ca: Tự động phát hiện khi quầy hết khách và hết giờ để chuyển ngay sang tổng kết ngày, không còn bị đứng hình "đang làm nốt đơn"',
    '🛑 Nút Đóng Ca & Tổng Kết Ngay: Bổ sung nút cứu nguy trực tiếp tại khung đối thoại khi quầy vãn khách giúp đóng ca lập tức',
    '🏦 Kỳ Hạn 1 Ngày Tà Tưa Bank: Bổ sung thêm lựa chọn kỳ hạn 1 ngày (+1.0% lãi kép) gửi rút linh hoạt mỗi ngày'
  ]},
  {v:'12.47.195',d:'02/10/2026',items:[
    '🏆 Bộ Sưu Tập 100 Nguyên Liệu: Hệ thống 5 nhóm nguyên liệu chuẩn gu Việt Nam (Cốt trà, Sữa ngậy, Topping, Sốt & Tạo ngọt, Kem & Decor)',
    '🎁 Mốc Pha Chế Nhận Quà (10, 100, 1000, 2000... ly): Cán mốc nhận ngay 1 Túi Quà 3 nguyên liệu ngẫu nhiên (bảo hiểm ít nhất 1 Rare+)',
    '✨ Gacha & Độ Hiếm (N, R, SR, SSR): Quay gacha mở túi nhận nguyên liệu bí mật kèm hiệu ứng mở thẻ quà sinh động',
    '📜 Sáng Tạo Công Thức Món Mới: Thu thập nguyên liệu để chế tạo các món trà sữa độc quyền nhận tiền thưởng lớn và buff vĩnh viễn',
    '📅 Biểu Tượng Lịch ic_calendar.png: Đặt tại thanh Header giữa Tổng Tiền và Chi Nhánh kèm huy hiệu thông báo túi quà chưa mở'
  ]},
  {v:'12.47.194',d:'02/10/2026',items:[
    '🤝 Giao Diện Chi Nhánh Nhượng Quyền: Nâng cấp bảng thông số đầy đủ Phát lương (4 NV), Nhập liệu (28% DT), Mặt bằng và Doanh thu tự động',
    '📊 Sao Kê Cuối Ngày & Két Tiền: Hạch toán và hiển thị rõ ràng các dòng chi phí Lương NV và Tiền nhập nguyên liệu của Chi nhánh Nhượng Quyền',
    '📈 Báo Cáo Tài Chính & Tổng Kết: Bổ sung chi phí vận hành chi nhánh nhượng quyền vào Analytics chuỗi và sổ thống kê định kỳ'
  ]},
  {v:'12.47.193',d:'02/10/2026',items:[
    '👥 Lích Đờ Tự Tuyển & Nhập Liệu: Lích đờ chi nhánh và đối tác nhượng quyền tự động tuyển nhân sự theo cấp độ và tự động nhập liệu nguyên liệu',
    '💸 Phát Lương & Trừ Chi Phí Cuối Ngày: Hạch toán đầy đủ trừ chi phí phát lương nhân viên và tiền nhập nguyên liệu cho chi nhánh & nhượng quyền',
    '💥 Cơ Chế Phá Sản / Vỡ Nợ: Khi doanh thu thấp thua lỗ (thu không bù chi), cơ sở chi nhánh / nhượng quyền có nguy cơ phá sản đóng cửa',
    '🔄 Tái Cơ Cấu & Đối Tác Mới: Chi nhánh hoặc đối tác vỡ nợ có thể tái cơ cấu hoặc tìm đối tác mới khi chủ tiệm có đủ vốn'
  ]},
  {v:'12.47.192',d:'02/10/2026',items:[
    '🖼️ Đổi icon 4 trang bị quầy pha sang ảnh thật: brt.jpg, mdn.jpg, ktp.jpg, ldd.jpg',
    '🍹 Nâng Cấp Nhân Viên: Mỗi 20 level mở thêm slot thuê 1 Nhân viên pha chế (staff2), hỗ trợ đa thợ pha chế làm song song',
    '🎭 Tỉ Lệ Drama Động: Càng nhiều nhân viên đi làm thì cộng % tỉ lệ drama nhân sự càng nhiều (tối đa trần 20%)',
    '📊 Chuẩn Hoá KPI: Loại bỏ hoàn toàn nhân viên thử việc 0 lương (staff0) khỏi hệ thống xét KPI và bảng đánh giá lương'
  ]},
  {v:'12.47.191',d:'02/10/2026',items:[
    '🚨 An Ninh Két Trên 1 Tỷ: Tăng mạnh tỉ lệ trộm cắp, khách bùng tiền và lừa đảo tiền giả (15%)',
    '🏦 Cảnh Báo Khẩn Cấp Gửi Tà Tưa Bank: Xuất hiện Popup & Banner yêu cầu chủ tiệm cất tiền vào ngân hàng bảo vệ an toàn 100%',
    '⭐ Mục Tiêu Cày 5 Sao: Hướng dẫn chủ tiệm đạt 5.0★ Tổng đánh giá để tự động mở rộng hạn mức gửi tiền Tà Tưa Bank'
  ]},
  {v:'12.47.190',d:'02/10/2026',items:[
    '⭐ Hệ Thống Trang Bị 3 Cấp Độ: Nâng cấp quầy pha chế chuyên nghiệp (Cấp 2: 10tr, Cấp 3: 50tr)',
    '🫖 Bình rót trà: C1 rót nhanh hơn 10%, C2 rót nhanh hơn 20%, C3 rót nhanh hơn 40%',
    '🥤 Máy dán nắp: Nhận thêm tip 30% (C1), 40% (C2), 50% (C3) khi pha đúng món',
    '🧊 Khay topping: Tăng hạn sử dụng nguyên liệu topping lên thêm 1/2/3 ngày',
    '🥄 Ly, đường, đá: Khách hàng tăng 5%/7%/10% tỉ lệ chọn nhiều nguyên liệu và siro hơn',
    '🔒 Bảo mật khám phá: Ẩn chỉ số của cấp 2 và cấp 3, chỉ hiển thị sau khi nâng cấp'
  ]},
  {v:'12.47.189',d:'02/10/2026',items:[
    '⚡ Cân bằng Traffic tổng: Sàn 1.35x, Trần 5.0x, Hệ số nhân chung 1.55x',
    '⏱️ Khách đến tuần tự mượt mà: R.spawnT = 3.2s / traffic'
  ]},
  {v:'12.47.187',d:'02/10/2026',items:[
    '🚨 Hotfix Sửa Lỗi Đứng Game: Khắc phục triệt để lỗi ReferenceError: viralBoost is not defined gây dừng vòng lặp game',
    '🧋 Vận Hành Trơn Tru 10 Khách: Khách kéo vào nườm nượp, luồng phục vụ quầy thông suốt 100%'
  ]},
  {v:'12.47.186',d:'01/10/2026',items:[
    '🚀 Bùng Nổ Lượng Khách Hàng Ghé Quán: Tăng mạnh hệ số traffic cơ sở, mở rộng giới hạn trần traffic lên 9.5x khi có đầy đủ buff (Biển hiệu, Ads, Mascot, Viral, Bạn bè, Sao 5★)',
    '🏢 Siêu Buff Tầng & Quầy: Nâng tầng (10 khách) tăng gấp đôi lượng khách ghé quán (+100%), Mở rộng quầy (6 khách) tăng +50% khách',
    '⚡ Cơ Chế Lấp Đầy Chỗ Trống Thần Tốc: Khi quầy còn chỗ trống, khách tiếp theo ghé ngay sau 0.15s - 0.3s, tự động lấp đầy liên tục 6 đến 10 khách chật kín quầy',
    '⏱️ Cân Bằng Giờ Bán Nước: Giờ thấp điểm không bị sụt giảm khách, mở cửa đầu ca tự động đón khách đứng kín toàn bộ hàng ghế quầy'
  ]},
  {v:'12.47.185',d:'01/10/2026',items:[
    '🌟 Cập Nhật Quy Chế KPI Mới: Xuất sắc (+1tr thưởng nóng + 20% tổng doanh thu), Đạt chuẩn (+500k thưởng nóng + 10% tổng doanh thu)',
    '⚠️ Chế Tài Không Đạt Chuẩn Xác: Trừ 20% lương ca chu kỳ hoàn két quán, đồng thời phạt làm việc không lương 1 ca (0đ tiền lương) cho ca làm việc tiếp theo',
    '📊 Hiển Thị Huy Hiệu & Minh Bạch Tài Chính: Bổ sung huy hiệu "⚠️ Phạt làm 0đ lương (1 ca)" trên thẻ nhân sự, đồng bộ chi tiết thưởng nóng và chia % doanh thu trên toàn bộ giao diện xét duyệt'
  ]},
  {v:'12.47.184',d:'01/10/2026',items:[
    '🏢 Nâng Tầng Phục Vụ Cùng Lúc 10 Khách: Nâng quy mô phục vụ tại quán tối đa lên đến 10 khách cùng lúc (tỉ lệ max 10 khách vào quán), buff thêm +40% khách ghé tiệm để quầy luôn đông đúc tấp nập',
    '🧱 Mở Rộng Quầy Phục Vụ 6 Khách: Tăng sức chứa Mở rộng quầy từ 4 lên 6 khách phục vụ cùng lúc, tăng +20% khách ghé tiệm',
    '⚡ Đón Khách Siêu Tốc: Tự động lấp đầy 6 hoặc 10 chỗ trống ngay từ đầu ca bán và liên tục bù khách mới siêu tốc (~0.3-0.7s) khi quầy còn chỗ trống, tối ưu hàng hiển thị avatar 10 khách mượt mà'
  ]},
  {v:'12.47.183',d:'01/10/2026',items:[
    '⭐ Quy Chế Hoa Hồng Bill KPI: Chuẩn hóa quyền lợi hưởng % tiền bill chu kỳ 7 ca — Nhân viên Xuất sắc nhận thưởng nóng 100k + hưởng 2% tiền bill (+5% gọi khách), Đạt chuẩn nhận thưởng nóng 50k + hưởng 1% tiền bill (+2% gọi khách)',
    '🐱 Tinh Chỉnh Nhân Viên Marketing (Me Két Tinh): Chuyển đổi buff từ +20% khách sang giảm 20% thời gian thao tác pha chế của toàn bộ nhân viên (ví dụ Gen Z từ 200ms giảm còn đúng 160ms)',
    '📊 Đồng Bộ Giao Diện & Doanh Thu Bill KPI: Cập nhật chuẩn xác nhãn hiển thị hoa hồng bill, đồng bộ doanh thu thực nhận tích lũy chu kỳ 7 ca'
  ]},
  {v:'12.47.182',d:'01/10/2026',items:[
    '👥 Phục Vụ Cùng Lúc Đầy Đủ Khách (4 Khách Mở Rộng Quầy & 6 Khách Nâng Tầng): Khắc phục triệt để hiện tượng quầy chỉ hiện 3 khách; khách xuất hiện đầy đủ 4 khách hoặc 6 khách 1 lượt ngay từ đầu ca và liên tục bù chỗ trống khi phục vụ xong',
    '🏢 Chuẩn Hóa Nâng Tầng: Đồng bộ quy mô Nâng tầng thành phục vụ cùng lúc 6 khách chuẩn xác, tự động mở rộng slot và lấp đầy khách ngay khi nâng cấp',
    '💸 Tăng Tỉ Lệ Khách Mặc Cả & Khách Trả Thiếu Tiền: Tăng vọt xác suất xuất hiện tính cách mặc cả (bớt 15-25% tiền bill) và khách trả thiếu tiền (thiếu 2k-10k tiền lẻ kèm lời nhắn hài hước), bổ sung huy hiệu trực quan trên avatar và quầy'
  ]},
  {v:'12.47.181',d:'01/10/2026',items:[
    '🌟 Chuẩn Hóa & Đồng Bộ Quy Chế Thưởng KPI Nhân Viên: Loại bỏ dứt điểm dòng chữ và cách tính 1% doanh thu / 0.5% doanh thu cũ còn sót lại trên thẻ chọn',
    '📊 Hiển Thị Đúng & Đồng Bộ Quy Chế Thưởng: Nút Xuất sắc hiển thị chuẩn "+100k · +5% bill · +5% khách", Đạt chuẩn "+50k · +2% bill · +2% khách", Không đạt "-20% lương ca hoàn két"',
    '💰 Đồng Bộ Kết Quả & Thông Báo Xét Duyệt KPI: Bảng thông báo và kết quả duyệt thưởng thể hiện rõ ràng tiền thưởng nóng và chỉ số buff nhận được (lương ca đã trừ vào bill mỗi ngày)'
  ]},
  {v:'12.47.180',d:'01/10/2026',items:[
    '👥 Cân Bằng Chuẩn Xác Số Lượng Khách Gợi Ý & Nhập Kho: Tái cấu trúc công thức dự báo expected() và Gen Z gợi ý bám sát công suất phục vụ thực tế của quán (~25-45 ly/ca tùy thời lượng và nhân sự), khắc phục triệt để lỗi gợi ý quá nhiều (trên 100-140 ly) gây thừa mứa lãng phí nguyên liệu',
    '⏱️ Điều Tiết Nhịp Độ Khách Đến Hàng (Pacing): Giãn khoảng cách spawn khách tại quán và đơn online tự nhiên hơn, giúp chủ quán có đủ thời gian pha chế chuẩn xác mà không bị dồn ứ quá tải'
  ]},
  {v:'12.47.179',d:'01/10/2026',items:[
    '🔧 Khắc Phục Triệt Để Lỗi Crash Tab KPI Nhân Viên: Khai báo đầy đủ biến mức lương wageTxt trong danh sách nhân viên đã tuyển, tích hợp hàm tiện ích staffWageTxt đồng bộ toàn diện trên mọi giao diện Kho, KPI và Nâng Cấp'
  ]},
  {v:'12.47.178',d:'01/10/2026',items:[
    '📋 Drama Nhân Sự - Nộp Đơn Báo Trước 1~3 Ngày: Khi phát sinh sự kiện nhân viên xin nghỉ việc, nhân viên sẽ nộp đơn báo trước 1~3 ngày để chủ tiệm chủ động sắp xếp nhân sự thay vì nghỉ đột ngột; nhân viên vẫn đi làm bình thường cho đến đúng ngày hẹn mới chính thức bàn giao và nghỉ việc',
    '⏳ Huy Hiệu & Đếm Ngược Ngày Nghỉ: Hiển thị tag đếm ngược "⏳ Nghỉ sau X ngày" trong mục Kho KPI & Nâng Cấp, cảnh báo rõ ngày rời quán giúp chủ tiệm kịp thời tuyển người thay thế'
  ]},
  {v:'12.47.177',d:'01/10/2026',items:[
    '🕵️‍♂️ Tối Ưu Báo Công An & Soi Camera AI: Loại bỏ khối "Gợi ý ẩn dụ" rườm rà, đổi tiêu đề gợi ý thành "🔍 Sự thật chỉ có 1" dứt khoát và sắc sảo, giúp người chơi nhanh chóng nhận diện chính xác kẻ đưa tiền giả'
  ]},
  {v:'12.47.176',d:'01/10/2026',items:[
    '🏢 Tối Ưu Nút Nâng Cấp Chi Nhánh (Fix Chữ Xuống Hàng & Khung To Thô): Tách thẻ "✓ Đang hoạt động" thành pill trạng thái cố định dòng (white-space: nowrap), co gọn nút Nâng cấp vừa vặn chuẩn 40px, xóa bỏ triệt để hiện tượng nút màu hồng bị kéo cao khổng lồ'
  ]},
  {v:'12.47.175',d:'01/10/2026',items:[
    '🔧 Sửa Lỗi Crash Tab KPI Nhân Viên & Nâng Cấp: Khắc phục triệt để lỗi "wageTxt is not defined" tại danh sách nhân viên đã thuê trong Kho/KPI và "pName is not defined" tại tab Nâng Cấp, mở giao diện mượt mà 100%',
    '⭐ Khắc Phục Lỗi Cày Sao Sau Khi Reset 0 Sao: Hiển thị đồng thời huy hiệu số lần đạt 5 sao (xN) cùng hàng sao động thời gian thực trên thanh tiêu đề, tối ưu mốc reset chu kỳ mới giúp sao tăng trưởng đều đặn theo từng đơn nước hoàn thành',
    '🏦 Tự Động Đồng Bộ & Mở Rộng Hạn Mức Tà Tưa Bank Vô Hạn: Chuẩn hóa công thức tăng hạn mức (+10% dưới 1 tỷ, +5% trên 1 tỷ không giới hạn trần), tự động đồng bộ theo số lần cán mốc 5 sao của quán, khắc phục triệt để lỗi hạn mức bị đứng yên'
  ]},
  {v:'12.47.174',d:'01/10/2026',items:[
    '💖 Tối Ưu Thông Báo Dỗ Dành Gen Z (Fix Lỗi Tràn / Cắt Viền): Chuẩn hóa widget luôn hiển thị chuẩn 2 hàng văn bản tinh gọn khi Gen Z đi chữa lành hoặc làm việc; xử lý triệt để lỗi rò rỉ 3 hàng chữ gây đội khung và cắt cụt viền trên dưới; tăng độ cao thẻ 54px và căn giữa hoàn hảo'
  ]},
  {v:'12.47.173',d:'01/10/2026',items:[
    '👥 Khắc Phục Lỗi Khách Bỏ Về Cao Bất Thường: Xử lý triệt để lỗi cộng tiền thiếu của sinh viên trực đêm vào số lượng khách bỏ về (khiến hiển thị 129.000 khách bỏ về), tách bạch riêng chi phí hao hụt và tự động lọc dọn dữ liệu lịch sử cũ',
    '⭐ Tối Ưu Hiển Thị Sao Đánh Giá Header: Chuẩn hóa hiển thị sao trên thanh tiêu đề gọn gàng (xN ★ khi đạt mốc 5 sao nhiều lần), không còn bị tràn lấn, cắt chữ hay che mất nút Chi Nhánh trên mọi dòng điện thoại',
    '📋 Tối Ưu Giao Diện Nhân Viên (Fix Tràn Khung): Thiết kế lại toàn diện thẻ nhân viên trong tab KPI và Nâng cấp sang dạng thẻ hiện đại; thông tin mô tả hiển thị trải rộng 100% dòng, các nút tuyển dụng và điều kiện không bao giờ bị bóp nghẹt hay rớt dòng'
  ]},
  {v:'12.47.172',d:'01/10/2026',items:[
    '⭐ Đồng Bộ Chuẩn Xác Số Lượng Đánh Giá: Khắc phục lỗi hiển thị 15k đánh giá nhưng các mức sao cộng lại không khớp; hệ thống scale tỷ lệ chuẩn xác 100% để tổng số sao 5★-1★ cộng lại luôn bằng đúng tổng lượt đánh giá toàn thời gian',
    '⚡ Tối Ưu Hiệu Năng Chống Lag Khi Đông Khách: Đặt trần traffic an toàn, ổn định nhịp độ spawn khách và đơn online (giãn cách tối thiểu 1.5s - 3.2s), giảm tải 90% CPU vòng lặp tick, loại bỏ hoàn toàn hiện tượng đơ lag không thao tác được'
  ]},
  {v:'12.47.171',d:'01/10/2026',items:[
    '🏢 Tối Ưu Nút Chi Nhánh Header: Khắc phục triệt để lỗi nút Chi Nhánh che khuất số tiền, đảm bảo số tiền luôn hiển thị rõ ràng, cố định và nổi bật ở vị trí trung tâm trên mọi kích thước màn hình',
    '🚀 Giao Diện Chiến Dịch Quảng Cáo Tinh Gọn: Khi đang chạy chiến dịch quảng cáo, hệ thống tự động ẩn tất cả các chiến dịch khác, chỉ hiển thị dòng chiến dịch đang hoạt động'
  ]},
  {v:'12.47.170',d:'01/10/2026',items:[
    '📢 Lời nhắn từ DEV: Cập nhật thông điệp bản quyền chính thức từ duvicuaconsay (Tiệm Trà Nhỏ) & kisutai_ (Tiệm Trà Mơ Ước) kể từ phiên bản Gen Z, thông báo bản tải Android',
    '🛡️ Chống Đánh Cắp Bản Quyền Mã Nguồn Vĩnh Viễn: Khối mã nguồn Lời nhắn từ Dev được bảo vệ toàn vẹn vĩnh viễn trong code; nếu bị xoá hoặc can thiệp sửa đổi, hệ thống sẽ kích hoạt lỗi nghiêm trọng khiến web không thể chạy'
  ]},
  {v:'12.47.169',d:'01/10/2026',items:[
    '🎵 Âm Thanh & Nhạc Nền: Luôn tự động bật nhạc nền Lofi khi vào game, luôn tắt toàn bộ hiệu ứng âm thanh (rót nước, ấn chọn, múc đá...) khi vào game'
  ]},
  {v:'12.47.168',d:'01/10/2026',items:[
    '🐱 Trợ Lý Me Két Tinh Soi Camera (Chuẩn 100%): Khi đã thuê Me két tinh, bảng trích xuất camera an ninh của Công an phường sẽ hiển thị gợi ý phân tích AI tua chậm 0.25x và quét nhiệt vi cử chỉ tung hint ẩn dụ (nhịp đảo mắt 360 độ, giọng giục giã giấu tiền đáy túi áo, trùm nón né camera, che chắn quầy, tay run tẩu thoát...) chuẩn 100% thay vì chỉ đích danh tên hoặc số thứ tự, mang lại trải nghiệm suy luận chân thực và hấp dẫn'
  ]},
  {v:'12.47.167',d:'01/10/2026',items:[
    '🏢 Nút Chi Nhánh Thay Xuống Phố: Xoá tính năng Xuống Phố, thay bằng nút Chi Nhánh trên Header và trong Quầy Pha; bấm vào chuyển ngay qua mục Chi Nhánh xem và quản lý chuỗi trực thuộc, nhượng quyền, Lích Đờ',
    '📱 Điện Thoại Chuyển MXH Trà Sữa Feed Đọc Tin: Xoá tính năng shipper map khi ấn vào điện thoại dưới size ly, thay bằng mở mục Mạng Xã Hội để đọc tin tức, lướt feed TikTok, thả tim và cmt cứu Lích Đờ dỗi',
    '🚀 Chiến Dịch Ads Tự Động Đăng Bài Lên MXH Hàng Ngày: Facebook Ads (1 bài/ngày), TikTok Ads Viral (2 bài/ngày), Thuê KOL Reviewer (3 bài/ngày), Treo Biển Billboard (4 bài/ngày) tự động phủ sóng Trà Sữa Feed'
  ]},
  {v:'12.47.166',d:'01/10/2026',items:[
    '📢 Giới hạn 1/4 Chiến Dịch Quảng Cáo Ads: Chỉ được chạy tối đa 1 chiến dịch cùng lúc, khóa các chiến dịch còn lại khi đang chạy để tối ưu ngân sách và đảm bảo tính cân bằng',
    '👔 Nhân viên Lích Đờ (Branch Leader): Mỗi Lích Đờ quản lý 1 chi nhánh (trực thuộc hoặc nhượng quyền) giá 1.000.000đ, tự động điều phối nhân viên và nhập liệu, buff +25% doanh thu thụ động',
    '👥 Hiển thị Số Lượng Nhân Viên Trước Biểu Tượng Chi Nhánh: Đặt bộ đếm nhân viên 👥 trước biểu tượng ở mỗi chi nhánh (3, 5, 7, 9 NV theo cấp chi nhánh)',
    '🎬 Lích Đờ Quay Video MXH & Cơ Chế Video Flop Dỗi Nghỉ Việc: Lích Đờ tự quay video quảng bá chi nhánh; khi video flop (12 view 0 tim), Lích Đờ sẽ dỗi nộp đơn nghỉ việc khiến chi nhánh đóng cửa',
    '❤️ Cứu Tương Tác Kéo View: Chủ tiệm thả tim hoặc cmt vào bài đăng flop của Lích Đờ trên Trà Sữa Feed để kéo tương tác bùng nổ, Lích Đờ hết dỗi xé đơn nghỉ việc; hỗ trợ mở lại chi nhánh đóng cửa'
  ]},
  {v:'12.47.165',d:'01/10/2026',items:[
    '🎬 Kho nội dung Video Quảng Bá TikTok & Reviewer Đánh Giá: Mở rộng hơn 50+ kịch bản video ngắn TikTok/Reels triệu view bắt trend cực cuốn hút (thử thách ly khổng lồ, bắt quả tang nhân viên Gen Z, duet idol ẩm thực, ASMR shaker...) cùng bộ đánh giá chuyên sâu của Food Reviewer uy tín',
    '🏢 Nhãn [chi-nhánh] cho khách hàng liên chi nhánh: Khi sở hữu các chi nhánh trực thuộc, khách hàng ghé từ các chi nhánh sang quán chính sẽ hiển thị nhãn [chi-nhánh] cạnh tên, kèm huy hiệu nổi bật và lời thoại ghé thăm đặc trưng',
    '📱 Trà Sữa Feed theo mẫu hội thoại mới _ TikTok: Nâng cấp toàn diện dòng bảng tin thành kịch bản hội thoại POV khách - quán - reviewer sinh động chuẩn phong cách TikTok, tích hợp thanh âm thanh thịnh hành và hashtag trending, tự động đăng bài mỗi ngày và khi kích hoạt Ads'
  ]},
  {v:'12.47.164',d:'01/10/2026',items:[
    '🏢 Hệ thống Quản lý Chuỗi Chi Nhánh Trực Thuộc (Tab "Chi Nhánh"): Mua và mở rộng 4 chi nhánh đắc địa (Cổng Trường Học 15tr, Khu Công Nghệ Cao 35tr, TTTM 60tr, Phố Đi Bộ 120tr), nâng cấp tăng 20% doanh thu mỗi cấp, sinh dòng tiền thụ động và buff lượng khách, đơn online cho quán chính',
    '🤝 Hệ thống Nhượng Quyền Thương Hiệu (Franchise Business): Ký hợp đồng nhượng quyền với đối tác tại 8 tỉnh thành lớn khi đạt 50k Followers & 4.5★, nhận ngay 100tr phí nhượng quyền và 8% phí bản quyền (Royalty) mỗi ngày',
    '📱 Kênh Truyền Thông Mạng Xã Hội Đa Nền Tảng (Tab "Mạng Xã Hội"): Hồ sơ Profile, cấp Tích Xanh 💎 Official, quay và đăng Video ngắn Viral kéo bùng nổ khách ngày hôm sau, tương tác thả tim trả lời bình luận Trà Sữa Feed, chạy chiến dịch Ads Facebook/TikTok/KOL/Billboard'
  ]},
  {v:'12.47.163',d:'01/10/2026',items:[
    '👥 Nâng cấp tiệm hạng mục Nhân viên: Bỏ buff tốc độ pha chế, chỉ giữ lại % x2 bill với mức tăng chuẩn 0.5% mỗi cấp',
    '🐱 Me két tinh hạn chế nổi nóng: Giảm mạnh tỉ lệ phản hồi toxic và tụt sao, bảo vệ điểm đánh giá của quán',
    '💬 Thông báo 1 dòng tinh gọn: Rút gọn các dòng thông báo Toast thành 1 dòng duy nhất, không xuống hàng hay che quầy pha chế',
    '🛵 Nhân viên đi chợ thần tốc: Rút ngắn thời gian chạy chợ từ 5-10s xuống còn 2-5s mỗi chuyến',
    '🕵️‍♂️ Tăng độ khó hồ sơ tiền giả: 4 đối tượng có lời khai tinh vi; Trợ lý Me két tinh cung cấp hint chỉ điểm chính xác 100%'
  ]},
  {v:'12.47.162',d:'01/10/2026',items:[
    '⚡ Bỏ tốc độ pha chế trong xét duyệt KPI nhân viên: Loại bỏ hoàn toàn buff ⚡ +...% tốc độ pha và dòng hiển thị tốc độ thực tế',
    '🏛️ Chuẩn hóa buff tốc độ pha chế: Hiện tại buff tốc độ pha duy nhất trong game chỉ nhận được từ tính năng Đóng thuế trực tuyến',
    '🧹 Xóa sạch chỉ số tốc độ pha dư thừa từ KPI trong toàn bộ dữ liệu lưu game cũ'
  ]},
  {v:'12.47.161',d:'01/10/2026',items:[
    '👥 Cập nhật toàn diện 9 vị trí nhân viên theo bảng quy chuẩn: Đồng bộ chi tiết công việc nhân viên làm, việc chủ quán làm, mức lương, đặc điểm tính cách và tốc độ pha chế',
    '🧋 Thử việc 0 lương (300ms): 10% sai bill, 8% trốn việc, lương 0đ và luôn nhận toàn bộ tiền tip của quán',
    '🥤 Thử việc chính thức (280ms) & Quản lý tập sự (280ms): Chuẩn hóa 10% và 5% sai bill, chủ tiệm tự động rót bù khi thiếu trà',
    '🍹 Nhân viên pha chế (1500ms/ly): Kích hoạt hỗ trợ khi quầy có từ 2 khách trở lên, nhận trọn đơn khách chờ lâu nhất, hưởng toàn bộ tiền tip khi kích hoạt. Lương 200k/ngày + 40k/h sau 22h',
    '🛵 Nhân viên online (1000ms/ly): Tốc độ 1s/ly, 1% làm hỏng ly, lương 250k/ngày',
    '⚡ Nhân viên Gen Z (200ms): Làm liền 100 ly dỗi 10s cần chủ quán dỗ dành nếu không sẽ nghỉ việc. Đá bill 1 lần/ngày, bắt quả tang sẽ hoàn trả tiền bill. Lương 275k/ngày',
    '🌙 Sinh viên cuối tháng (250ms): Chỉ làm 22h–6h, có thể nhầm size, ngăn cản bán trang bị sau 2h sáng, đôi khi nhận thiếu tiền vì buồn ngủ. Lương 300k/ca đêm',
    '🛒 Nhân viên đi chợ (5-10s/lần): Đi chợ mua đồ khi hết nguyên liệu; nếu đi nhiều lần có thể khai gian hóa đơn hoặc mua trúng đồ hết hạn gây ngộ độc 1★. Lương 180k/ngày',
    '🐱 Nhân viên Me két tinh: Tăng 20% khách và +20% tốc độ pha chế. Tự động rep đánh giá & nâng sao; đôi khi nóng giận phản hồi xấu làm tụt 1★. Tự động đóng thuế ngẫu nhiên nếu quá hạn 12h. Lương 200k/ngày'
  ]},
  {v:'12.47.160',d:'01/10/2026',items:[
    '🏛️ Khóa cứng chu kỳ Thuế tối đa 72h: Khắc phục triệt để lỗi nộp thuế cộng dồn vượt 72h. Khi thuế đang có hiệu lực, nút đóng thuế sẽ khóa và đếm ngược; chỉ khi hết 72h mới nộp chu kỳ mới',
    '🏦 Tăng hạn mức Tà Tưa Bank vô hạn: Xóa bỏ trần 1 tỷ. Dưới 1 tỷ tăng +10% mỗi lần đạt 5 sao; khi vượt 1 tỷ tiếp tục tăng +5% mỗi lần đạt 5 sao không giới hạn',
    '⭐ Reset đánh giá về 0 sao sau khi đạt 5 sao: Cán mốc 5.0★ sẽ ghi nhận huy hiệu mốc (x1, x2...) và đặt lại đánh giá về 0 sao (thay vì 4 sao như trước) để bắt đầu chu kỳ thử thách mới'
  ]},
  {v:'12.47.159',d:'01/10/2026',items:[
    '✨ Sửa lỗi icon Đóng thuế bị lệch: Loại bỏ nét gạch thừa trên đầu icon, căn giữa và chuẩn hóa kích thước icon hóa đơn đồng bộ với các icon Kho, KPI, Nâng cấp',
    '📐 Đồng bộ căn chỉnh thanh điều hướng tab: Cố định khung chứa icon chuẩn 30x30px với flexbox căn giữa tuyệt đối, đảm bảo các tab thẳng hàng tăm tắp'
  ]},
  {v:'12.47.158',d:'01/10/2026',items:[
    '📏 Đồng bộ kích thước nút Thanh toán lương & Hoãn trả: Cả hai nút có cùng chiều rộng 100%, bo góc 14px đồng bộ tuyệt đối, căn chỉnh cân xứng hoàn hảo',
    '📜 Cập nhật Quy chế thưởng KPI mới theo yêu cầu: Xuất sắc (+5% bill, +5% khách) · Đạt chuẩn (+2% bill, +2% khách) · Không đạt (Trừ 20% lương nguy cơ bỏ việc). Lương ca đã trừ vào bill mỗi ngày',
    '⚡ Đồng bộ chỉ số buff thực tế: Điều chỉnh chính xác chỉ số buff cộng thêm (+5% bill/khách cho Xuất sắc và +2% bill/khách cho Đạt chuẩn) khi duyệt thưởng KPI'
  ]},
  {v:'12.47.157',d:'01/10/2026',items:[
    '✨ Chế độ Avatar Gọn gàng cho Bảng Xét duyệt KPI: Mặc định chỉ hiển thị dãy Avatar trực quan kèm chấm hạng (🌟, 👍, ⚠️) và số tiền thưởng/phạt, không còn danh sách thẻ dài che kín màn hình',
    '👆 Chạm Avatar để mở chi tiết: Bấm vào avatar của nhân viên bất kỳ để mở thẻ chi tiết riêng của người đó (hiệu suất ca làm, lỗi/dỉm bill, buff, 3 mức thưởng); bấm lại hoặc bấm nút [✕ Đóng] để thu gọn',
    '◀ Chuyển đổi nhân viên mượt mà: Bổ sung 2 nút [◀ Trước] và [Tiếp theo ▶] ngay trong thẻ chi tiết giúp duyệt lần lượt từng nhân sự cực nhanh mà không cần đóng mở nhiều lần'
  ]},
  {v:'12.47.156',d:'01/10/2026',items:[
    '⭐ Tái thiết kế Bảng Xét duyệt KPI & Thưởng Nhân viên (Gen Z & Team): Tối ưu hóa giao diện nhỏ gọn, giảm hơn 55% chiều cao mỗi thẻ nhân sự, không còn cuộn trang mỏi mắt',
    '📊 Thanh Tổng quan Đánh giá & Điều hướng nhanh: Hiển thị bộ đếm tổng số nhân sự theo từng hạng (Xuất sắc / Đạt chuẩn / Kém) kèm thanh Avatar có huy hiệu trực quan, bấm vào để cuộn nhanh đến nhân viên cần xem',
    '⚡ Hai nút phím tắt tiện lợi: "⚡ Theo thực tế" (tự động phân loại thưởng theo kết quả làm việc 7 ca qua) và "🌟 Thưởng hết" giúp xét duyệt tức thì cho cả quán',
    '🎯 Hiển thị chi tiết hiệu suất Gen Z & Từng vị trí: Làm nổi bật trạng thái Gen Z (tốc độ siêu tốc, dỗi, số lần dỉm bill / trung thực 100%), nhân viên đi chợ, thử việc, cảnh báo nguy cơ đố kị đình công nếu chỉ thưởng 1 người'
  ]},
  {v:'12.47.155',d:'01/10/2026',items:[
    '🕵️‍♂️ Khôi phục hoàn toàn tính năng Chỉ điểm đối tượng dùng tiền giả: Mở hồ sơ điều tra trích xuất camera của Công an phường với 4 nghi phạm, lời khai ngoại phạm chi tiết và gợi ý phán đoán hài hước từ Me két tinh',
    '🚨 Tắt sạch 100% nút Báo Công An ngay khi bấm: Loại bỏ triệt để nút báo án trên quầy đơn, tab Gen Z và nhân viên ca đêm sinh viên ngay khi kích hoạt, không bao giờ bị kẹt lại trên màn hình',
    '✨ Trải nghiệm mượt mà không bị treo đơ: Tự động tiếp tục bán hàng trơn tru sau khi chỉ điểm xong hoặc chọn "Để sau", đồng bộ hoàn hảo với nút Tạm dừng và menu Cài đặt'
  ]},
  {v:'12.47.154',d:'01/10/2026',items:[
    '🧊 Trừ đúng đường & đá, foam cho NV pha chế & NV đơn online: Đường, đá và foam kem cheese được tự động trừ chính xác trong kho theo đúng yêu cầu ly trà',
    '💰 Đồng bộ chuẩn 100% doanh thu thực tế ngày và tháng: Ghi nhận đầy đủ tiền thu thực tế kèm hệ số nhân (x2 thuế, x3 ngôi sao VIP, buff bill nhân viên KPI, thưởng hợp đồng tiệc, bảo vệ thu hồi), chấm dứt hiện tượng doanh thu tháng bị âm so với chi phí nâng cấp',
    '⚡ Khắc phục triệt để đơ nút Bắt quả tang, Báo C.An, Cài đặt và Tạm dừng: Bắt quả tang đá bill thu hồi tiền ngay tức thì không dừng game; nút Tạm dừng hỗ trợ bật/tắt linh hoạt; đóng Cài đặt tự động khôi phục nhịp chơi'
  ]},
  {v:'12.47.153',d:'01/10/2026',items:[
    '🚨 Sửa lỗi nút Báo Công An bị dừng và không biến mất: Bấm nút "Báo C.An" trong lúc đang bán hàng sẽ lập tức thu hồi tiền đơn hàng, nhận thưởng nóng +500.000đ và đánh giá 5 sao từ Công An',
    '✨ Nút báo án và cảnh báo tiền giả biến mất lập tức 100%: Quầy trở về trạng thái bình thường ngay khi bấm, không bị kẹt hay đơ lại',
    '⏱️ Không dừng/tạm dừng game: Nhịp phục vụ pha chế tại quầy diễn ra liên tục, chỉ kích hoạt minigame nhận diện 4 nghi phạm camera vào cuối ngày nếu chưa kịp báo án'
  ]},
  {v:'12.47.152',d:'01/10/2026',items:[
    '🚨 Khắc phục triệt để lỗi 3 thông báo đè nhau: Tích hợp trực tiếp thông tin và nút Báo C.An vào trong tab Gen Z (hoặc SV ca đêm), không hiển thị thêm thanh nút đè lên trên',
    '✨ Xóa bỏ Toast tiền giả thừa: Loại bỏ hoàn toàn banner Toast nổi lơ lửng che mất quầy và nút bấm',
    '⬆️ Tự động canh vị trí Toast khi có tab quầy: Các thông báo Toast hệ thống tự động nâng lên trên tab nhân viên (bottom: 70px), tuyệt đối không bao giờ đè lên tab quầy'
  ]},
  {v:'12.47.151',d:'01/10/2026',items:[
    '🎨 Toast chuyển sang màu dịu theo chủ đề: Thay thế màu đỏ gắt sang tông màu dịu êm trùng khớp với Theme đang chọn (var(--panel), var(--ink), var(--line)), chữ nâu êm mắt và viền pastel tinh tế',
    '⬇️ Đẩy Toast xuống sát đáy màn hình: Hạ vị trí Toast xuống sát mép dưới (bottom: 14px), hoàn toàn giải phóng tầm nhìn kệ siro, khay topping và quầy pha chế'
  ]},
  {v:'12.47.150',d:'01/10/2026',items:[
    '🛑 Sửa lỗi Toast nhảy lên đầu: Khôi phục vị trí thông báo hệ thống về đáy màn hình, triệt tiêu lỗi che hàng khách và Header',
    '🛵 Triệt tiêu hoàn toàn Toast chạy chợ: Thông tin mua hàng của NV Đi Chợ luôn hiển thị trong tab quầy (Gen Z hoặc NV Chạy Chợ), tuyệt đối không bắn Toast đỏ'
  ]},
  {v:'12.47.149',d:'01/10/2026',items:[
    '🗑️ Đưa lỗi làm sai bill vào tab Gen Z: Xóa bỏ hoàn toàn thanh banner đỏ che khuất quầy pha chế, thông báo sơ ý hỏng ly được hiển thị tinh tế ngay trong tab Gen Z',
    '🛵 Gộp hoàn toàn tab chạy chợ vào tab Gen Z: Khi có nhân viên tại quầy, ẩn hẳn tab chạy chợ bên trên để tích hợp tiến độ đi chợ và mua hàng vào duy nhất 1 tab gọn gàng',
    '⬆️ Dời vị trí Toast lên đỉnh màn hình: Toàn bộ thông báo hệ thống khi bán hàng chuyển lên mép trên sát Header, không bao giờ che khuất khu vực pha chế và nút Báo C.An',
    '🚨 Khóa dứt điểm nút Báo Công An: Cờ expired khóa chặt nút Báo C.An ngay khi hết 10 giây hoặc khi hết giờ bán'
  ]},
  {v:'12.47.148',d:'01/10/2026',items:[
    '🛵 Thông báo chạy chợ: Tích hợp thông tin mua hàng của NV Đi Chợ hiển thị trực tiếp trong tab Gen Z (hoặc SV ca đêm), không che khuất màn hình',
    '🚨 Sửa lỗi nút Báo Công An: Khắc phục triệt để lỗi nút Báo C.An không tự ẩn khi hết 10s hoặc hết giờ bán',
    '⭐ Cân bằng tỉ lệ 5 sao: Giảm bớt tỉ lệ 5 sao dồn dập, phân bổ điểm sao thực tế theo độ khó và thời gian chờ để việc đạt 5 sao là mục tiêu có giá trị'
  ]},
  {v:'12.47.147',d:'01/10/2026',items:[
    '🧊 Làm mát máy & tiết kiệm pin: Ẩn toàn bộ thông tin chi tiết từng bước pha chế ở widget Gen Z, chống giật lag và nhảy chữ liên tục',
    '🛠️ Sửa lỗi đứng game: Khắc phục triệt để lỗi treo game sau khi phản hồi đánh giá khách hàng trong lúc pha chế'
  ]},
  {v:'12.47.146',d:'01/10/2026',items:[
    '📱 Header tinh gọn: Dàn ngang 4 nút icon góc trái (Tạm dừng, Cài đặt, Bầu cua, Xì dách) trên 1 hàng duy nhất; nút Xuống Phố đặt cùng hàng trước đánh giá sao, thu gọn khoảng trống',
    '📋 Bảng xét KPI & thưởng nhân viên: Cố định hoàn hảo vừa khít khung nhìn điện thoại (Flex Column), danh sách cuộn mượt mà và nút Thanh toán/Hoãn trả luôn nằm cố định bên dưới không cần cuộn',
    '🧋 Pha chế: Khi nhân viên thử việc/quản lý rót thiếu trà (< 0.72), chủ tiệm sẽ chủ động rót thêm cho đủ vạch xanh chuẩn vị',
    '🚨 Nút tố cáo tiền giả: Đặt ở vị trí dưới cùng, nằm ngay phía trên tab của nhân viên Gen Z trong staffBarWrap',
    '📉 Tối ưu tab thông báo: Khi không thuê Gen Z, các tab tự động hạ xuống sát mép dưới cùng màn hình; tinh chỉnh font chữ và avatar vừa vặn, không bị quá to'
  ]},
  {v:'12.47.145',d:'01/10/2026',items:[
    '⚡ Tối ưu hoá toàn diện di động: Triệt tiêu 100% hiện tượng Layout Thrashing (ép reflow liên tục) khi hiển thị lời thoại khách',
    '🛑 Ngừng gọi renderLane() dồn dập mỗi 100ms khi nhân viên Gen Z và Sinh viên đang rót trà, tiết kiệm hàng nghìn lần dựng lại DOM',
    '🎵 Tối ưu nhạc nền BGM: Nén tệp MP3 từ 29.1MB xuống 1.83MB (giảm hơn 93% RAM & CPU giải mã âm thanh), chỉ tải khi người chơi bật nhạc',
    '⏱️ Tối ưu Widget đi chợ: Chỉ cập nhật số giây thay vì xóa và tạo lại toàn bộ thẻ HTML 10 lần/giây',
    '✨ Tối ưu GPU: Chuyển đổi gradient kiên nhẫn thành bậc 4 độ (giảm 75% tải rasterize), khử bỏ mask-image nặng trên layer thời tiết'
  ]},
  {v:'12.47.144',d:'30/09/2026',items:[
    '📢 Me két tinh: Tăng 20% khách ghé quán, pha chế +20% tốc độ toàn tiệm',
    '⭐ Tự động phản hồi mọi đánh giá khách hàng và nâng sao khích lệ',
    '🏦 Tự động trích két ngẫu nhiên tuỳ hứng đóng thuế nếu quá hạn 12h để bảo vệ sổ tiết kiệm Tà Tưa Bank',
    '💵 Cập nhật lương Me két tinh: 200.000đ/ngày (Tự động rep đánh giá, tăng 20% khách & pha siêu nhanh)'
  ]},
  {v:'12.47.143',d:'30/09/2026',items:[
    '⚡ Tối ưu hoá toàn diện di động: Triệt tiêu 100% hiệu ứng làm mờ nền nặng (backdrop-filter: blur), giúp máy chạy mát và tiết kiệm pin',
    '🔇 Mặc định tắt nhạc nền và hiệu ứng âm thanh (người chơi chủ động bật khi có nhu cầu)',
    '🎯 Chuyển đổi các hiệu ứng animation box-shadow phức tạp sang GPU Compositor (transform/opacity)',
    '⏱️ Tối ưu vòng lặp game: Throttle widget nhân viên về 1s, thêm dirty-check cho thanh kiên nhẫn và nhãn thời gian'
  ]},
  {v:'12.47.142',d:'30/09/2026',items:[
    '🏦 Tà Tưa Bank: Sửa triệt để lỗi gửi thêm tiền tiết kiệm bị reset tiến độ về 0; giờ đây số ngày tích lũy kỳ hạn sẽ được tiếp tục bảo lưu nguyên vẹn khi gửi thêm tiền'
  ]},
  {v:'12.47.141',d:'30/09/2026',items:[
    '🤫 Cân bằng tâm lý Gen Z: Khi đá bill thành công sẽ không bao giờ dỗi nữa; mỗi ngày chỉ cần dỗ dành tối đa 1 lần',
    '✨ Tối giản Avatar nhân viên: Chỉ giữ Avatar tròn thuần túy của Gen Z và Sinh viên, gỡ bỏ toàn bộ icon tai nghe, tiền, thùng hàng phủ lên avatar',
    '🎯 Gỡ bỏ khung màu cam (.q3want) nhấp nháy quanh món pha chế khi Gen Z và Sinh viên đang làm việc',
    '🛵 Điều chỉnh vị trí thanh nhân viên: Tab chạy xe (Đi chợ) luôn nằm trên tab Gen Z, tab Gen Z luôn nằm dưới cùng',
    '🧹 Tinh gọn phản hồi đánh giá: Xoá thông báo "Chủ tiệm đã gửi phản hồi! Khách đã phản hồi lại ở lượt 4." và xoá nhãn "(Cố định - Không thể sửa)"'
  ]},
  {v:'12.47.140',d:'30/09/2026',items:[
