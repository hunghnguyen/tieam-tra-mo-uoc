  { name: 'Bé Mai Sinh Viên', face: '👩‍🎓', desc: 'Đưa tiền mặt lấy từ cọc tiền lẻ ăn sáng mẹ cho, vui vẻ nán lại xin thêm ống hút giấy.' },
  { name: 'Chú Hùng Xe Ôm', face: '🛵', desc: 'Trả bằng tờ tiền mặt phẳng phiu vừa thối từ cây xăng, thong thả uống thử ngụm trà đầu tiên.' },
  { name: 'Chị Lan Kế Toán', face: '👩‍💼', desc: 'Thanh toán tiền mặt kẹp trong sổ chi tiêu, kiên nhẫn đứng đợi lấy biên lai tích điểm.' },
  { name: 'Bác Ba Tổ Trưởng', face: '👴', desc: 'Đưa tờ tiền mặt gấp tư cất kỹ trong túi áo, vừa nhận ly vừa khen không gian quán sạch sẽ.' },
  { name: 'Bạn Linh Reviewer', face: '💅', desc: 'Thanh toán tiền mặt mệnh giá lớn, tươi cười cầm ly trà quay video check-in trước quầy.' },
  { name: 'Em Tuấn Học Sinh', face: '🎒', desc: 'Đưa tờ tiền phẳng phiu mẹ vừa đưa, lễ phép chào thu ngân trước khi bước ra bàn ngồi chờ.' },
  { name: 'Cô Hồng Giáo Viên', face: '👩‍🏫', desc: 'Thanh toán tiền mặt rút từ túi xách công sở, cẩn thận vuốt thẳng mép tiền trước khi đưa.' },
  { name: 'Bác Tám Thợ Điện', face: '🧑‍🔧', desc: 'Trả tiền mặt lấy từ ví da sờn cũ, đứng kiểm đếm từng tờ tiền thối rồi mới bước đi.' },
  { name: 'Anh Hoàng Giao Hàng', face: '🚚', desc: 'Thanh toán bằng tiền mặt vừa rút tại cây ATM đối diện tiệm, còn cầm theo biên lai rút tiền.' }
