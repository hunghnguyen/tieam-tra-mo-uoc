/* ---------- KIỂM TRA HỎNG HÓC TRANG BỊ ĐẦU NGÀY MỚI (2% TỈ LỆ) ---------- */
function checkEquipBreakdown(onDone){
  if(!S || !S.upg || S.day <= 1 || S.lastBreakDay === S.day){
    if(onDone) onDone();
    return;
  }
  S.lastBreakDay = S.day;

  const hoardCash = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S && S.money) : (Number(S && S.money) || 0);
  const eqTiers = getSafeCashTiers(S && S.day);
  const verdictEq = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(hoardCash) : { isCheater: false, tier: 0, status: 'CLEAN' };
  const isCheaterEq = !!(verdictEq.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(hoardCash)));
  const eqCheatTier = isCheaterEq ? Math.max(verdictEq.tier || 0, hoardCash >= eqTiers.megaCap ? 4 : (hoardCash >= eqTiers.highCap ? 3 : (hoardCash >= eqTiers.midCap ? 2 : (hoardCash >= eqTiers.lowCap ? 1 : 0)))) : 0;
  const isMegaHoardEq = hoardCash >= eqTiers.megaCap || eqCheatTier >= 4;
  const isHighHoardEq = hoardCash >= eqTiers.highCap || eqCheatTier >= 3;
  const isMidHoardEq = hoardCash >= eqTiers.midCap || eqCheatTier >= 2;
  const isLowHoardEq = hoardCash >= eqTiers.lowCap || eqCheatTier >= 1;

  const BREAKABLE = [
    { id: 'fridge', n: 'Tủ lạnh', icon: '❄️' },
    { id: 'sealer', n: 'Máy dán nắp tự động', icon: ico('upcups') },
    { id: 'sign', n: 'Biển hiệu đèn LED', icon: ico('upbulb') },
    { id: 'seats', n: 'Bàn ghế cho khách ngồi', icon: ico('upchair') },
    { id: 'motorbike', n: 'Xe máy', icon: '🛵' },
    { id: 'binhrot', n: 'Bình rót trà', icon: '🫖' },
    { id: 'khaytop', n: 'Khay topping', icon: '🥣' },
    { id: 'lyduongda', n: 'Bộ ly, đường, đá', icon: '🥤' }
  ];

  const brokenList = [];
  const repairedByButler = [];
  BREAKABLE.forEach(item => {
    let isOwned = false;
    if(item.id === 'sealer'){
      isOwned = !!(S.upg && S.upg.sealer && !isEquip3Broken('sealer'));
    } else if(['binhrot', 'khaytop', 'lyduongda'].includes(item.id)){
      isOwned = !!(S.equipLv && S.equipLv[item.id] && !isEquip3Broken(item.id));
    } else {
      isOwned = !!(S.upg && S.upg[item.id]);
    }

    if(isOwned){
      let breakRate = item.id === 'motorbike' ? 0.005 : 0.02;
      if(isCheaterEq){
        if(isMegaHoardEq) breakRate = 0.85;
        else if(isHighHoardEq) breakRate = 0.55;
        else if(isMidHoardEq) breakRate = 0.30;
        else if(isLowHoardEq) breakRate = 0.12;
      }

      if(Math.random() < breakRate){
        // Người chơi hợp lệ vẫn được Quản gia tự động sửa chữa thiết bị 100%; chỉ vô hiệu hóa khi có căn cứ gian lận
        const butlerCanFix = isStaffActive('staffButler') && (!isCheaterEq || (!isHighHoardEq && (!isMidHoardEq || Math.random() < 0.25)));
        if(butlerCanFix){
          repairedByButler.push(item);
        } else {
          if(['binhrot', 'sealer', 'khaytop', 'lyduongda'].includes(item.id)){
            S.equipBroken = S.equipBroken || {};
            S.equipBroken[item.id] = true;
            if(item.id === 'sealer'){
              S.upg = S.upg || {};
              S.upg.sealer = false;
            }
          } else {
            S.upg[item.id] = false;
            if(item.id === 'fridge'){
              if(S.stock && S.stock.ice){
                S.stock.ice.forEach(b => {
                  if(b.exp >= 99999){
                    b.exp = S.day + (CFG.life.ice || 2) - 1;
                  }
                });
              }
            }
          }
          brokenList.push(item);
        }
      }
    }
  });

  // Chỉ tụt cấp Máy Móc Thiết Bị (S.upgLv.equip) khi có căn cứ gian lận (isCheaterEq)
  let lostEquipLv = 0;
  if(isCheaterEq && (isMegaHoardEq || isHighHoardEq) && S.upgLv && (S.upgLv.equip || 0) > 1){
    lostEquipLv = isMegaHoardEq ? Math.min(S.upgLv.equip - 1, 3 + Math.floor(Math.random() * 4)) : Math.min(S.upgLv.equip - 1, 1 + Math.floor(Math.random() * 3));
    if(lostEquipLv > 0){
      S.upgLv.equip = Math.max(1, S.upgLv.equip - lostEquipLv);
    }
  }

  if(repairedByButler.length > 0){
    S.equipBroken = S.equipBroken || {};
    repairedByButler.forEach(item => {
      S.equipBroken[item.id] = false;
      if(item.id === 'sealer'){
        S.upg = S.upg || {};
        S.upg.sealer = true;
      }
    });
    save();
    sfx('star');
    toast(`🛠️ Quản gia đã phát hiện & bảo dưỡng, sửa chữa xong: ${repairedByButler.map(x => x.n).join(', ')}! Mọi trang bị tiếp tục hoạt động trơn tru! 🤵✨`, 5500, 1);
  }

  if(brokenList.length > 0 || lostEquipLv > 0){
    save();
    sfx('warn');
    ask(`
      <div class="pbig">🛠️💥</div>
      <h2 style="color:#dc2626;margin:4px 0 8px;">${isLowHoardEq ? 'BĂNG ĐẢNG CƯỚP KÉT ĐẬP PHÁ THIẾT BỊ QUÁN!' : 'CẢNH BÁO: TRANG BỊ BỊ HỎNG!'}</h2>
      <div style="background:#fef2f2;border:1.5px solid #fecaca;padding:12px 14px;border-radius:10px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        ${isLowHoardEq ? `<div style="color:#b91c1c;font-weight:700;margin-bottom:6px;">🚨 ${hoardCash >= eqTiers.lowCap ? `Do két tích trữ lượng tiền mặt khổng lồ (${fmt(hoardCash)}) không gửi Tà Tưa Bank` : `Do hệ thống phát hiện chỉ số bất thường (Ngưỡng Phán Quyết ${verdictEq.status || 'CHEAT'})`}, băng nhóm siêu trộm đột nhập đã đập phá tan hoang máy móc thiết bị của quán (Quản gia không thể tự khắc phục)!</div>` : 'Đầu ngày mới, thiết bị sau đã bị <b>hỏng hóc</b> sau thời gian dài hoạt động:'}
        <div style="margin:8px 0 6px;display:flex;flex-direction:column;gap:6px;">
          ${brokenList.map(it => `<div style="font-weight:700;color:#b91c1c;background:#fff;padding:6px 10px;border-radius:6px;border:1px solid #fee2e2;">• ${it.icon} ${it.n} (đã hỏng nặng)</div>`).join('')}
          ${lostEquipLv > 0 ? `<div style="font-weight:800;color:#991b1b;background:#fee2e2;padding:6px 10px;border-radius:6px;border:1px solid #f87171;">• ⚙️ Hệ thống Máy Móc Pha Chế bị đập phá tụt -${lostEquipLv} Cấp (Còn Cấp ${S.upgLv.equip})!</div>` : ''}
        </div>
        ${brokenList.some(x => x.id === 'fridge') ? '<div style="color:#d97706;font-size:0.82rem;margin-top:6px;">⚠️ <b>Lưu ý:</b> Do Tủ lạnh bị hỏng, đá viên trong kho sẽ trở về hạn sử dụng thường (2 ngày)!</div>' : ''}
        ${brokenList.some(x => x.id === 'motorbike') ? '<div style="color:#d97706;font-size:0.82rem;margin-top:6px;">⚠️ <b>Lưu ý:</b> Do Xe máy bị hỏng, NV đi chợ & Chiến thần xa lộ sẽ mất buff trả giá 0đ và x2 món hàng cho đến khi sắm xe mới!</div>' : ''}
        ${brokenList.some(x => x.id === 'sealer') ? '<div style="color:#d97706;font-size:0.82rem;margin-top:6px;">⚠️ <b>Lưu ý:</b> Máy dán nắp bị hỏng, tính năng tự dán nắp & tiền tip cộng thêm tạm ngưng cho đến khi sửa chữa!</div>' : ''}
        ${brokenList.some(x => x.id === 'binhrot') ? '<div style="color:#d97706;font-size:0.82rem;margin-top:6px;">⚠️ <b>Lưu ý:</b> Bình rót trà bị hỏng, tốc độ rót trà trở về mức mặc định!</div>' : ''}
        ${brokenList.some(x => x.id === 'khaytop') ? '<div style="color:#d97706;font-size:0.82rem;margin-top:6px;">⚠️ <b>Lưu ý:</b> Khay topping bị hỏng, hạn sử dụng topping trong kho trở về mặc định!</div>' : ''}
        ${brokenList.some(x => x.id === 'lyduongda') ? '<div style="color:#d97706;font-size:0.82rem;margin-top:6px;">⚠️ <b>Lưu ý:</b> Bộ ly, đường, đá bị hỏng, tỉ lệ khách gọi thêm món trở về mặc định!</div>' : ''}
        <div style="color:#475569;font-size:0.82rem;margin-top:6px;">Chủ tiệm hãy vào mục <b>Nâng cấp > Trang bị</b> để bấm nút <b>Sửa ngay</b> giúp máy móc hoạt động trơn tru.</div>
      </div>
    `, [
      ['Vào Nâng cấp sửa ngay', () => {
        R.tab = 'nangcap';
        R.sub = R.sub || {};
        R.sub.upg = 3;
        renderPrep();
        switchTab('nangcap');
        setTimeout(() => {
          const tabBtn = document.querySelector('[data-st="upg"] [data-si="3"]');
          if(tabBtn) tabBtn.click();
          const targetEl = document.querySelector('.equip3-repair-row, [data-equip3-repair], [data-equip3-up], [data-up]');
          if(targetEl && targetEl.scrollIntoView) {
            targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }, 100);
        if(onDone) onDone();
      }, 1],
      ['Để sau', () => {
        renderPrep();
        if(onDone) onDone();
      }]
    ]);
  } else {
    save();
    if(onDone) onDone();
  }
}

/* ==================== CƠ CHẾ NHÂN VIÊN QUẢN GIA (STAFF BUTLER) ==================== */
function staffButlerAutoGarden(){
  if(!isStaffActive('staffButler')) return;
  if(!window.S) return;
  if(window.Garden && typeof window.Garden.init === 'function') window.Garden.init();
  if(!S.garden || !Array.isArray(S.garden.plots)) return;

  const seedTypes = ['mint', 'strawberry', 'lemon', 'peach', 'mango', 'tea'];
  const seedDefs = (window.Garden && window.Garden.SEED_DEFS) || window.SEED_DEFS || {};
  let boughtCount = 0;
  let plantedCount = 0;
  let harvestedCount = 0;
  let wateredCount = 0;

  if(!S.garden.seeds) S.garden.seeds = {};
  if(!S.garden.lastSeeds) S.garden.lastSeeds = {};

  // 1. Thu hoạch toàn bộ nông sản đã chín trước (để giải phóng ô đất cho gieo trồng mới)
  S.garden.plots.forEach(p => {
    if(!p.locked && p.seed){
      const def = seedDefs[p.seed];
      const maxStage = def ? def.days + 1 : 2;
      if(p.stage >= maxStage){
        const wasStar = !!p.isStar;
        if(def && typeof def.onHarvest === 'function'){
          try { def.onHarvest(S, wasStar); } catch(e){ console.warn('Lỗi thu hoạch cây:', e); }
        }
        p.lastSeed = p.seed;
        S.garden.lastSeeds[p.id] = p.seed;
        p.seed = null;
        p.isStar = false;
        p.stage = 0;
        p.wateredToday = false;
        S.garden.totalHarvests = (S.garden.totalHarvests || 0) + 1;
        harvestedCount++;
      }
    }
  });

  // 2. Tự động gieo trồng hạt giống vào TOÀN BỘ các ô đất trống đã khai hoang (tự mua nếu thiếu)
  S.garden.plots.forEach(p => {
    if(p.locked || p.seed) return;

    // Ưu tiên hạt giống ô này từng gieo trước đây, nếu không có thì gieo xoay vòng các loại hạt
    const targetSeed = p.lastSeed || S.garden.lastSeeds[p.id] || seedTypes[p.id % seedTypes.length];
    let chosenSeed = (S.garden.seeds[targetSeed] && S.garden.seeds[targetSeed] > 0) ? targetSeed : null;

    if(!chosenSeed){
      chosenSeed = seedTypes.find(st => (S.garden.seeds[st] || 0) > 0);
    }

    if(!chosenSeed){
      // Tự động chi tiền két mua hạt giống để gieo
      const buySeed = targetSeed || 'mint';
      let cost = (seedDefs[buySeed] && seedDefs[buySeed].cost) || 10000;
      const butlerTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffButler') : 0;
      if(butlerTrainLv >= 5) cost = Math.round(cost * 0.80);
      if(S.money >= cost + 100000){ // chừa buffer tiền an toàn cho két
        S.money -= cost;
        S.garden.seeds[buySeed] = (S.garden.seeds[buySeed] || 0) + 1;
        boughtCount++;
        chosenSeed = buySeed;
      }
    }

    if(chosenSeed && (S.garden.seeds[chosenSeed] || 0) > 0){
      S.garden.seeds[chosenSeed]--;
      p.seed = chosenSeed;
      p.stage = 1;
      p.isStar = false;
      p.lastSeed = chosenSeed;
      S.garden.lastSeeds[p.id] = chosenSeed;
      p.wateredToday = true; // Quản gia gieo xong tưới nước luôn
      plantedCount++;
    }
  });

  // 3. Tưới nước toàn bộ các luống cây đang lớn chưa được tưới hôm nay (10% tỉ lệ đột biến Cây Sao)
  S.garden.plots.forEach(p => {
    if(!p.locked && p.seed && !p.wateredToday){
      p.wateredToday = true;
      wateredCount++;
      if(!p.isStar && Math.random() < 0.10){
        p.isStar = true;
      }
    }
  });

  // 4. Dự trữ hạt giống: nếu loại nào về 0 thì Quản gia mua bổ sung 1-2 túi nếu két rủng rỉnh
  seedTypes.forEach(st => {
    const qty = (S.garden.seeds && S.garden.seeds[st]) || 0;
    let cost = (seedDefs[st] && seedDefs[st].cost) || 10000;
    const butlerTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffButler') : 0;
    if(butlerTrainLv >= 5) cost = Math.round(cost * 0.80);
    if(qty <= 0 && S.money >= cost * 3 + 200000){
      S.money -= cost * 2;
      S.garden.seeds[st] = (S.garden.seeds[st] || 0) + 2;
      boughtCount += 2;
    }
  });

  if(harvestedCount > 0 || plantedCount > 0 || boughtCount > 0 || wateredCount > 0){
    save();
    if(typeof head === 'function') head();
    if(R && R.tab === 'vuon' && window.Garden && typeof window.Garden.render === 'function'){
      window.Garden.render();
    }
  }
}

function staffButlerAutoPetCare(){
  if(!isStaffActive('staffButler')) return;
  if(!window.S) return;
  let cared = false;

  // 1. Chăm sóc Thú cưng chính (Shiba Vàng / Mèo Chiêu Tài)
  if(S.pet && S.pet.unlocked){
    const maxS = typeof getPetMaxStat === 'function' ? getPetMaxStat(S.pet.level) : 100;
    if((S.pet.hunger || 0) < maxS){
      S.pet.hunger = maxS;
      if(typeof addPetExp === 'function') addPetExp(15);
      cared = true;
    }
    if((S.pet.clean || 0) < maxS){
      S.pet.clean = maxS;
      if(typeof addPetExp === 'function') addPetExp(15);
      cared = true;
    }
    if((S.pet.energy || 0) < maxS){
      S.pet.energy = maxS;
      if(typeof addPetExp === 'function') addPetExp(10);
      cared = true;
    }
    if((S.pet.happiness || 0) < maxS){
      S.pet.happiness = maxS;
      if(typeof addPetExp === 'function') addPetExp(15);
      cared = true;
    }
    S.pet.currentAction = null;
  }

  // 2. Chăm sóc Cáp Bi Điềm Đạm
  if(S.capbi && S.capbi.unlocked){
    const maxCapbi = typeof getPetMaxStat === 'function' ? getPetMaxStat(S.capbi.level) : 100;
    if((S.capbi.hunger || 0) < maxCapbi){
      S.capbi.hunger = maxCapbi;
      if(typeof addCapbiExp === 'function') addCapbiExp(15);
      cared = true;
    }
    if((S.capbi.clean || 0) < maxCapbi){
      S.capbi.clean = maxCapbi;
      if(typeof addCapbiExp === 'function') addCapbiExp(15);
      cared = true;
    }
    if((S.capbi.energy || 0) < maxCapbi){
      S.capbi.energy = maxCapbi;
      if(typeof addCapbiExp === 'function') addCapbiExp(10);
      cared = true;
    }
    if((S.capbi.happiness || 0) < maxCapbi){
      S.capbi.happiness = maxCapbi;
      if(typeof addCapbiExp === 'function') addCapbiExp(15);
      cared = true;
    }
    S.capbi.currentAction = null;
  }

  if(cared){
    save();
    if(typeof updatePetStatusBars === 'function') updatePetStatusBars();
  }
}

function staffButlerAutoRepairEquip(){
  if(!isStaffActive('staffButler')) return;
  if(!window.S) return;
  const BREAKABLE_IDS = ['fridge', 'sealer', 'sign', 'seats', 'motorbike', 'binhrot', 'khaytop', 'lyduongda'];
  S.equipBroken = S.equipBroken || {};
  ['binhrot', 'sealer', 'khaytop', 'lyduongda'].forEach(id => {
    S.equipBroken[id] = false;
  });
  if(S.upg) S.upg.sealer = true;
  if(S.hadEquip && typeof S.hadEquip === 'object'){
    BREAKABLE_IDS.forEach(id => {
      if(S.hadEquip[id] && S.upg && !S.upg[id]){
        S.upg[id] = true;
      }
    });
  }
}

function staffButlerAutoBestSellerPricing(){
  if(!isStaffActive('staffButler')){
    if(S && S.butlerBoosted && Object.keys(S.butlerBoosted).length > 0){
      [...BASE_KEYS, ...FLAV_KEYS, ...TOP_KEYS, 'L'].forEach(k => {
        if(S.butlerBoosted[k]){
          const def = (k === 'L' ? (DEF_SELL.L || 7000) : (DEF_SELL[k] || (ITEMS[k] && ITEMS[k].sell) || 10000));
          const unbuffedCap = (typeof unbuffedSafeMax === 'function') ? unbuffedSafeMax(k) : 20000;
          const baseP = (S.userBasePrice && S.userBasePrice[k] != null) ? Math.min(S.userBasePrice[k], unbuffedCap) : unbuffedCap;
          if(k === 'L') S.sell.L = Math.min(baseP, unbuffedCap);
          else S.sell[k] = Math.min(baseP, unbuffedCap);
          delete S.butlerBoosted[k];
        }
      });
      save();
    }
    return;
  }
  if(!S.sell) S.sell = {};
  S.butlerBoosted = S.butlerBoosted || {};
  S.userCustomPrice = S.userCustomPrice || {};
  S.userBasePrice = S.userBasePrice || {};

  const buffedKeys = new Set(getButlerBuffedKeys());
  let boostedNames = [];

  // Tự động đưa về giá tối ưu lãi - giá an toàn đỉnh sau mỗi ngày reset khi nhận 3 món buff ngẫu nhiên:
  // 1. Đối với 3 món nhận buff +50% ngẫu nhiên hôm nay:
  //    - Đưa về giá an toàn đỉnh Buff: safeMax(k)
  //      (Topping/Trái cây/Hương vị: 30k; Trà nền: 60k, Matcha: 75k; Size L: 30k)
  //    - Tuyệt đối khống chế không bao giờ vượt quá safeMax(k), triệt tiêu hoàn toàn lỗi 45k vượt trần Quản gia.
  //    - Quản gia bảo chứng (+50% Buff), khách 100% không chê đắt.
  // 2. Đối với các món không buff (hoặc hết buff từ hôm qua):
  //    - Tự động đưa về giá tối ưu lãi - giá an toàn đỉnh chuẩn: unbuffedSafeMax(k)
  //      (Topping/Trái cây/Hương vị: 20k; Trà nền: 40k, Matcha: 50k; Size L: 20k)
  //    - Nếu người chơi có đặt custom thấp hơn unbuffedCap thì tôn trọng, nhưng nếu bị vượt trần thì tự động đưa về unbuffedCap.
  //    - Toàn bộ món đều ở trạng thái "tối ưu lãi" (nhãn xanh lá), không bị cảnh báo đắt.
  [...BASE_KEYS, ...FLAV_KEYS, ...TOP_KEYS].forEach(k => {
    if(!ITEMS[k]) return;
    const unbuffedCap = (typeof unbuffedSafeMax === 'function') ? unbuffedSafeMax(k) : 20000;
    
    // Vệ sinh và chuẩn hóa userBasePrice (không để bị lây nhiễm giá buff 30k hay 45k)
    if(S.userBasePrice[k] != null){
      if(S.userBasePrice[k] > unbuffedCap){
        S.userBasePrice[k] = unbuffedCap;
      }
    } else {
      S.userBasePrice[k] = unbuffedCap;
    }

    const baseP = (S.userCustomPrice[k] && S.userBasePrice[k] != null && S.userBasePrice[k] > 0)
      ? Math.min(S.userBasePrice[k], unbuffedCap)
      : unbuffedCap;

    if(buffedKeys.has(k)){
      // Món được buff hôm nay: Đưa về giá an toàn đỉnh buff (+50%)
      const buffCap = safeMax(k);
      const customBuffP = Math.min(buffCap, Math.round((baseP * 1.50) / 500) * 500);
      const finalBuffP = (S.userCustomPrice[k] && S.userBasePrice[k] < unbuffedCap) ? customBuffP : buffCap;
      S.sell[k] = finalBuffP;
      S.butlerBoosted[k] = finalBuffP;
      boostedNames.push(`${ITEMS[k].n} (+50% Buff: ${fmt(finalBuffP)})`);
    } else {
      // Món không buff: Đưa về giá an toàn đỉnh tối ưu lãi chuẩn
      const safeP = (S.userCustomPrice[k] && S.userBasePrice[k] < unbuffedCap) ? baseP : unbuffedCap;
      S.sell[k] = safeP;
      delete S.butlerBoosted[k];
    }
  });

  // Size L
  const lUnbuffedCap = (typeof unbuffedSafeMax === 'function') ? unbuffedSafeMax('L') : 20000;
  if(S.userBasePrice.L != null){
    if(S.userBasePrice.L > lUnbuffedCap) S.userBasePrice.L = lUnbuffedCap;
  } else {
    S.userBasePrice.L = lUnbuffedCap;
  }
  const baseL = (S.userCustomPrice.L && S.userBasePrice.L != null && S.userBasePrice.L > 0)
    ? Math.min(S.userBasePrice.L, lUnbuffedCap)
    : lUnbuffedCap;

  if(buffedKeys.has('L')){
    const lBuffCap = safeMax('L');
    const customBuffL = Math.min(lBuffCap, Math.round((baseL * 1.50) / 500) * 500);
    const finalBuffL = (S.userCustomPrice.L && S.userBasePrice.L < lUnbuffedCap) ? customBuffL : lBuffCap;
    S.sell.L = finalBuffL;
    S.butlerBoosted.L = finalBuffL;
    boostedNames.push(`Size L (+50% Buff: ${fmt(finalBuffL)})`);
  } else {
    const safeL = (S.userCustomPrice.L && S.userBasePrice.L < lUnbuffedCap) ? baseL : lUnbuffedCap;
    S.sell.L = safeL;
    delete S.butlerBoosted.L;
  }

  save();
  if(boostedNames.length > 0 && typeof toast === 'function' && R && R.running){
    toast(`🤵 Quản gia bảo chứng giá: Đã tối ưu giá an toàn đỉnh & Buff +50% hôm nay cho ${boostedNames.join(', ')}! 📈`, 5500);
  }
}

function staffButlerAutoCallStaff(isStartOfDay = false){
  if(!isStaffActive('staffButler')) return;

  // Tự động gọi nhân viên đã nghỉ việc / đang hiện nút "Gọi đi làm" vào NGÀY HÔM SAU
  let recalledNames = [];
  if(typeof STAFF !== 'undefined' && Array.isArray(STAFF)){
    STAFF.forEach(u => {
      if(!u || u.id === 'staff0' || u.id === 'staffButler') return;
      if(!S.hired || !S.hired[u.id]) return; // Chỉ xét nhân viên đã từng tuyển

      const isStaff2 = u.id === 'staff2';
      const isStaffBuyer = u.id === 'staffBuyer';
      const isStaffOn = u.id === 'staffOn';
      const curStaffCount = isStaff2 ? (typeof getStaff2Count === 'function' ? getStaff2Count() : 1) : (isStaffBuyer ? (typeof getStaffBuyerCount === 'function' ? getStaffBuyerCount() : 1) : (isStaffOn ? (typeof getStaffOnCount === 'function' ? getStaffOnCount() : 1) : (S.upg && S.upg[u.id] ? 1 : 0)));
      const isWorking = S.upg && S.upg[u.id] && (!isStaff2 || curStaffCount > 0) && (!isStaffBuyer || curStaffCount > 0) && (!isStaffOn || curStaffCount > 0);

      if(!isWorking){
        // Chú bảo vệ đang ngủ lấy sức theo chu kỳ thì để ngủ đủ giấc
        if(u.id === 'staffGuard' && typeof isGuardResting === 'function' && isGuardResting()){
          return;
        }

        const offDay = (S.staffOffDay && S.staffOffDay[u.id] != null) ? S.staffOffDay[u.id] : null;

        // QUẢN GIA TỰ ĐỘNG GỌI NHÂN VIÊN VÀO NGÀY HÔM SAU, CHỨ KHÔNG PHẢI VÀO NGÀY HÔM ĐÓ:
        // Nếu nhân viên mới cho nghỉ hoặc nghỉ phép trong ngày hôm nay (offDay >= S.day), giữ nguyên cho nghỉ hôm nay, KHÔNG gọi!
        if(offDay != null && offDay >= S.day){
          return;
        }

        // Nếu nhân viên đang không làm việc mà chưa ghi nhận ngày nghỉ:
        // Nếu không phải là sang ngày mới (isStartOfDay === false), tức là vừa được tắt ca trong ngày hôm nay -> Ghi nhận nghỉ hôm nay và KHÔNG gọi!
        if(offDay == null && !isStartOfDay){
          S.staffOffDay = S.staffOffDay || {};
          S.staffOffDay[u.id] = S.day;
          return;
        }

        // Kiểm tra tránh xung đột nhân sự tương khắc (và không tự động gọi lại nhân sự tương khắc đang được chủ tiệm chủ động tắt để dùng bên kia)
        if(u.id === 'staffRacer' && S.upg && S.upg.staffBuyer) return;
        if(u.id === 'staffBuyer' && S.upg && S.upg.staffRacer) return;
        if(u.id === 'staffGz' && S.upg && S.upg.staff1) return;
        if(u.id === 'staffSv' && S.upg && S.upg.staff1) return;
        if(u.id === 'staff3' && S.upg && S.upg.staff1) return;
        if(u.id === 'staff1' && S.upg && (S.upg.staffGz || S.upg.staffSv || S.upg.staff3)) return;
        if(S.staffManualOff && S.staffManualOff[u.id] && S.hired){
          if(u.id === 'staff1' && (S.hired.staff3 || S.hired.staffGz || S.hired.staffSv)) return;
          if((u.id === 'staff3' || u.id === 'staffGz' || u.id === 'staffSv') && S.hired.staff1) return;
          if(u.id === 'staffBuyer' && S.hired.staffRacer) return;
          if(u.id === 'staffRacer' && S.hired.staffBuyer) return;
        }

        // Đã sang ngày hôm sau (S.day > offDay), Quản gia tự động gọi nhân viên đi làm lại!
        S.upg = S.upg || {};
        S.upg[u.id] = true;
        if(isStaff2) S.staff2Count = Math.max(1, S.staff2Count || 1);
        if(isStaffBuyer) S.staffBuyerCount = Math.max(1, S.staffBuyerCount || 1);
        if(isStaffOn) S.staffOnCount = Math.max(1, S.staffOnCount || 1);

        if(S.staffOffDay) delete S.staffOffDay[u.id];
        if(S.staffQuitNotices) delete S.staffQuitNotices[u.id];
        if(S.staffManualOff) delete S.staffManualOff[u.id];

        if(u.id === 'staffGz' && typeof R !== 'undefined' && R){
          R.gzWork = null;
          R.gzSulking = false;
          R.gzSulkTimer = 0;
          R.gzStealCooldown = 0;
        }
        if(u.id === 'staffSv' && typeof R !== 'undefined' && R){
          R.svWork = null;
          R.svStealIntent = false;
          R.svStealTimer = 0;
        }

        const pName = (S.staffNames && S.staffNames[u.id]) || u.n;
        recalledNames.push(pName);
      }
    });
  }

  if(typeof enforceStaffExclusivity === 'function') enforceStaffExclusivity();

  if(recalledNames.length > 0){
    save();
    if(typeof head === 'function') head();
    const msg = `🤵 Quản gia chu đáo: Sang ngày mới ${S.day}, tự động gọi nhân viên nghỉ hôm trước đi làm lại: ${recalledNames.join(', ')}! 🟢`;
    if(typeof toast === 'function') toast(msg, 5000);
  }
}

function staffButlerAutoPayMaxKpi(){
  if(!isStaffActive('staffButler')) return;
  const hiredList = STAFF.filter(u => u.id !== 'staff0' && S.hired && S.hired[u.id]);
  if(!hiredList.length){
    S.staffSalesDays = 0;
    return;
  }

  const periodRev = S.kpiPeriodTotalRev || 0;
  const periodBills = S.kpiPeriodTotalBills || Math.round(periodRev * 0.5);

  let totalPayout = 0;
  const results = [];

  hiredList.forEach(u => {
    const ps = (S.kpiPeriodStats && S.kpiPeriodStats[u.id]) || { daysWorked: 0, served: 0, errors: 0 };
    const daysWorked = ps.daysWorked || 0;

    // Nhân viên không đi làm ca nào trong chu kỳ 7 ngày: Nghỉ ca, 0đ thưởng KPI!
    if(daysWorked <= 0 || (typeof isStaffWorkingThisPeriod === 'function' && !isStaffWorkingThisPeriod(u))){
      results.push({
        name: staffFullName(u),
        paid: 0,
        share: 0,
        isOff: true,
        daysWorked: 0
      });
      return;
    }

    // Tỉ lệ cống hiến thực tế theo số ca đi làm (tối đa 6-7 ca)
    const ratio = Math.min(1.0, daysWorked / 6);
    const trainLv = getStaffTrainLv(u.id);
    const trainRate = getStaffTrainKpiExtraRate(u.id);
    const kpiRate = 0.005 + trainRate;
    const share = Math.round(periodBills * kpiRate * ratio);
    const bonus = Math.round(150000 * ratio);
    const netPayout = bonus + share;
    totalPayout += netPayout;

    S.staffKpi = S.staffKpi || {};
    const kpi = S.staffKpi[u.id] = S.staffKpi[u.id] || { speedBuff: 0, billBonus: 0, level: 0 };
    kpi.speedBuff = (kpi.speedBuff || 0) + 0.03 * ratio;
    kpi.trafficBuff = 0;
    kpi.billBonus = 0.005;
    kpi.level = (kpi.level || 0) + 1;
    if(typeof addKpiFiveStarReviews === 'function') addKpiFiveStarReviews(u, Math.max(1, Math.round(5 * ratio)));

    // Giữ nguyên trạng thái đang làm/tạm nghỉ hiện tại, tuyệt đối không tự ý bật lại nhân sự đã tắt hoặc nhân sự tương khắc
    S.hired[u.id] = true;

    results.push({
      name: staffFullName(u),
      paid: netPayout,
      share,
      trainLv,
      ratePct: ((kpiRate * 100).toFixed(1).replace('.0', '')),
      isOff: false,
      daysWorked
    });
  });

  if(typeof enforceStaffExclusivity === 'function') enforceStaffExclusivity();

  // Trừ tiền thưởng KPI từ két quán, tuyệt đối không xâm phạm tiền gửi tiết kiệm Tà Tưa Bank
  const actualPay = Math.min(S.money, totalPayout);
  S.money -= actualPay;
  if(actualPay < totalPayout){
    toast(`👔 Quản gia: Két chỉ đủ chi ${fmt(actualPay)} tiền KPI (Tiền gửi tiết kiệm Tà Tưa Bank được bảo vệ nguyên vẹn 100%)! 🛡️`, 5000);
  }

  if(S.cur && S.cur.equip){
    const activeStaffCount = results.filter(r => !r.isOff).length;
    S.cur.equip.push({ n: `Quản gia trả KPI Xuất sắc (${activeStaffCount} nhân viên đi làm)`, v: totalPayout });
  }

  // Reset kỳ đánh giá KPI 7 ngày
  S.staffSalesDays = 0;
  S.kpiPeriodStats = {};
  S.kpiPeriodTotalRev = 0;
  S.kpiPeriodTotalBills = 0;
  S.kpiPeriodStaffTips = 0;
  save();
  if(typeof head === 'function') head();
  if(typeof sfx === 'function') sfx('lvup');

  const activeStaffCount = results.filter(r => !r.isOff).length;
  const offStaffCount = results.filter(r => r.isOff).length;

  ask(`
    <div class="pbig">🤵🌟🎖️</div>
    <h2 style="color:#059669;font-weight:900;">QUẢN GIA QUYẾT TOÁN KPI CÔNG TÂM (XUẤT SẮC)!</h2>
    <p style="font-size:0.88rem;color:#334155;margin-bottom:8px;line-height:1.5;">
      Quản gia đã tự động xét duyệt KPI kỳ 7 ngày: Thưởng cho <b>${activeStaffCount} nhân viên đi làm</b> theo đúng ngày công thực tế (tổng chi: <b style="color:#059669;">${fmt(totalPayout)}</b>).<br>
      ${offStaffCount > 0 ? `<i>(Đã miễn thưởng 0đ cho <b>${offStaffCount} nhân viên</b> không đi làm ca nào)</i>` : ''}
    </p>
    <div style="background:#f0fdf4;border:1.5px solid #86efac;border-radius:12px;padding:10px 12px;margin:8px 0;max-height:36vh;overflow-y:auto;text-align:left;font-size:0.83rem;">
      ${results.map(r => r.isOff ? `
        <div style="padding:4px 0;border-bottom:1px dashed #e2e8f0;color:#64748b;">
          <b>💤 ${esc(r.name)}:</b> Nghỉ ca (0/7 ca) — <b>0đ</b> thưởng KPI.
        </div>
      ` : `
        <div style="padding:4px 0;border-bottom:1px dashed #bbf7d0;color:#166534;">
          <b>🌟 ${esc(r.name)}${r.trainLv > 0 ? ` (🎓 Lv.${r.trainLv})` : ''}:</b> Đi làm ${r.daysWorked}/7 ca | Thưởng nóng + chia ${r.ratePct}% DT = <b>+${fmt(r.paid)}</b> | Giảm <b>3% tốc độ pha &amp; +5 đánh giá 5★</b>!
        </div>
      `).join('')}
    </div>
    <div style="font-size:0.82rem;color:#047857;font-weight:600;margin-top:6px;">
      ✨ Nhân viên vô cùng hài lòng, tính lương chuẩn xác công tâm, không phát tiền oan!
    </div>
  `, [
    ['Tuyệt vời, tiếp tục kinh doanh!', () => {
      if(typeof R !== 'undefined' && R && R.mode === 'sell' && R.running){
        if(typeof resumeGame === 'function') resumeGame();
      } else {
        if(typeof renderPrep === 'function') renderPrep();
      }
    }, 1]
  ]);
}

function staffButlerPerformDuties(isStartOfDay = false){
  if(!isStaffActive('staffButler')) return;
  if(isStartOfDay){
    const butlerTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv('staffButler') : 0;
    if(butlerTrainLv > 0){
      const mornCash = butlerTrainLv >= 5 ? 15000000 : (butlerTrainLv * 3000000);
      const mornStar = butlerTrainLv >= 5 ? 5 : butlerTrainLv;
      S.money = (S.money || 0) + mornCash;
      S.star5Count = (S.star5Count || 0) + mornStar;
      if(S.cur && S.cur.gift != null) S.cur.gift = (S.cur.gift || 0) + mornCash;
      toast(`🤵 Quản gia Hoàng Gia (Cấp ${butlerTrainLv}): Quản trị chuỗi mang về +${fmt(mornCash)} vào két & +${mornStar}⭐ Danh vọng sáng nay! 👑✨`, 4500);
    }
  }
  try { staffButlerAutoCallStaff(isStartOfDay); } catch(e) { console.error('staffButlerAutoCallStaff error:', e); }
  try { staffButlerAutoGarden(); } catch(e) { console.error('staffButlerAutoGarden error:', e); }
  try { staffButlerAutoPetCare(); } catch(e) { console.error('staffButlerAutoPetCare error:', e); }
  try { staffButlerAutoRepairEquip(); } catch(e) { console.error('staffButlerAutoRepairEquip error:', e); }
  try { staffButlerAutoBestSellerPricing(); } catch(e) { console.error('staffButlerAutoBestSellerPricing error:', e); }
  if((S.staffSalesDays || 0) >= 7 && (!R || R.mode !== 'sell')){
    try { staffButlerAutoPayMaxKpi(); } catch(e) { console.error('staffButlerAutoPayMaxKpi error:', e); }
  }
}

function checkStaffExcuses(onProceed){
  try {
    R.staffDayOff = R.staffDayOff || {};
    R.staffLate = R.staffLate || {};
    R.staffDramaBuff = R.staffDramaBuff || {};
    R.staffOnTempCover = R.staffOnTempCover || false;
    R.onlineTempClosed = R.onlineTempClosed || false;
    if(!S || !S.upg) return onProceed();
    S.staffQuitNotices = S.staffQuitNotices || {};
    if(typeof getStaffTrainLv === 'function'){
      if(S.staffOnLeaveNotice && getStaffTrainLv('staffOn') >= 4){
        delete S.staffOnLeaveNotice;
      }
      Object.keys(S.staffQuitNotices).forEach(stId => {
        if(getStaffTrainLv(stId) >= 4){
          delete S.staffQuitNotices[stId];
        }
      });
    }

  // 1. Kiểm tra đơn xin nghỉ phép báo trước của nhân viên đơn online (staffOn)
  if(S.staffOnLeaveNotice && S.day >= S.staffOnLeaveNotice.leaveDay){
    const notice = S.staffOnLeaveNotice;
    const staffName = (S.staffNames && S.staffNames.staffOn) || 'Hoàng Minh';

    const onLeaveConfirm = (method) => {
      if(method === 'temp_cover'){
        const fee = 100000;
        if(S.money >= fee){
          S.money -= fee;
          S.cur.wage = (S.cur.wage || 0) + fee;
        }
        R.staffOnTempCover = true;
        save(); head();
        toast('🛵 Đã thuê Cộng tác viên trực thay ca hôm nay! Các đơn online sẽ được xử lý mượt mà.', 4000);
      } else if(method === 'close_online'){
        R.onlineTempClosed = true;
        toast('⏸️ Đã tạm đóng nhận đơn online hôm nay! Các app giao hàng sẽ tạm nghỉ.', 4000);
      } else {
        toast('🧋 Chủ tiệm & nhân viên quầy sẽ tự tay xử lý đơn online hôm nay!', 4000);
      }
      delete S.staffOnLeaveNotice;
      save();
      checkStaffExcuses(onProceed);
    };

    ask(`
      <div class="pbig">🏖️</div>
      <h2 style="color:#0284c7;margin:4px 0 8px;">HÔM NAY NHÂN VIÊN ONLINE NGHỈ PHÉP!</h2>
      <div style="background:#f0f9ff;border-left:4px solid #0284c7;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        👤 <b>${staffName}</b> (Nhân viên đơn online) hôm nay nghỉ phép theo đơn đã báo trước hôm qua.<br>
        <i>Lý do: "${notice.txt || notice.reason}"</i><br>
        <span style="color:#0369a1;font-size:0.82rem;font-weight:700;">Hôm qua bạn ấy đã hoàn thành xuất sắc toàn bộ ca làm. Hôm nay bạn ấy được nghỉ phép 1 ca.</span>
      </div>
      <div style="font-size:0.84rem;color:#475569;margin-bottom:8px;text-align:left;">
        Để các đơn online hôm nay không bị gián đoạn hay trễ đơn, chủ tiệm hãy chọn giải pháp:
      </div>
    `, [
      [`🛵 Thuê CTV trực thay ca (-100k)`, () => onLeaveConfirm('temp_cover'), 1],
      [`⏸️ Tạm tắt nhận đơn online hôm nay`, () => onLeaveConfirm('close_online')],
      [`🧋 Chủ quán & quầy tự làm`, () => onLeaveConfirm('manual')]
    ]);
    return;
  }

  // 2. Kiểm tra xem có nhân viên nào ĐÃ ĐẾN HẠN NGHỈ VIỆC CHÍNH THỨC hôm nay (S.day >= quitDay)
  const dueStaffIds = Object.keys(S.staffQuitNotices).filter(id => {
    const notice = S.staffQuitNotices[id];
    return notice && S.day >= notice.quitDay;
  });

  if(dueStaffIds.length > 0){
    const dueId = dueStaffIds[0];
    const notice = S.staffQuitNotices[dueId];
    const st = STAFF.find(x => x.id === dueId);
    const staffName = (S.staffNames && S.staffNames[dueId]) || (st ? st.n : 'Nhân viên');

    // Chính thức nghỉ việc: gỡ khỏi quầy
    S.upg[dueId] = false;
    delete S.hired[dueId];
    delete S.staffQuitNotices[dueId];
    if(dueId === 'staffGz'){
      R.gzWork = null;
      R.gzSulking = false;
      clearStaffPouring();
      if(cup && cup.used && cup.staff) cup = newCup();
    }
    save();

    if(dueId === 'staffOn'){
      ask(`
        <div class="pbig">📦</div>
        <h2 style="color:#dc2626;margin:4px 0 8px;">NHÂN VIÊN ONLINE CHÍNH THỨC NGHỈ VIỆC!</h2>
        <div style="background:#fef2f2;border-left:4px solid #ef4444;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
          👤 <b>${staffName}</b> (Nhân viên đơn online):<br>
          <i>"Hôm nay là Ngày ${notice.quitDay}, em đã làm việc đủ ca hôm qua theo đơn báo trước. Hôm nay em xin phép bàn giao lại toàn bộ công việc và chính thức rời quán ạ! Cảm ơn sếp và tiệm trà thời gian qua."</i>
        </div>
        <div style="font-size:0.84rem;color:#475569;margin-bottom:8px;text-align:left;">
          Để tránh việc các đơn online đổ về mà không có người xử lý, chủ tiệm chọn:
        </div>
      `, [
        [S.money >= 2000000 ? 'Tuyển ngay Nhân Viên Online mới (-2tr)' : 'Tạm tắt nhận đơn online hôm nay', () => {
          if(S.money >= 2000000){
            S.money -= 2000000;
            S.upg.staffOn = true;
            S.hired.staffOn = true;
            if(S.staffNames) delete S.staffNames.staffOn;
            save(); head();
            toast('🎉 Đã tuyển ngay Nhân Viên Đơn Online mới! Đơn online sẽ được xử lý liên tục.', 4000);
          } else {
            R.onlineTempClosed = true;
            toast('⏸️ Đã tạm tắt nhận đơn online hôm nay vì chưa có nhân viên online!', 4000);
          }
          checkStaffExcuses(onProceed);
        }, 1],
        ['Để quán tự xoay sở & mở bán', () => {
          checkStaffExcuses(onProceed);
        }]
      ]);
      return;
    }

    const hireCost = (typeof getStaffHireCost === 'function') ? getStaffHireCost(st || dueId) : (st ? st.cost : 0);
    const isSpecialStaff = (dueId === 'staffGuard' || dueId === 'staffRacer' || dueId === 'staffButler' || dueId === 'staffCleaner' || dueId === 'staffShipper');
    const roleCostTxt = isSpecialStaff ? `tiền lương ngày kèm % doanh thu quán (<b>${fmt(hireCost)}</b>)` : `<b>${fmt(hireCost)}</b>`;
    const canRehire = S.money >= hireCost;

    const askButtons = [];
    askButtons.push([`🤝 Ký hợp đồng thuê lại ngay (-${fmt(hireCost)})`, () => {
      if(S.money < hireCost){
        toast('Két quán không đủ tiền thuê lại! Cần ' + fmt(hireCost));
        checkStaffExcuses(onProceed);
        return;
      }
      S.money -= hireCost;
      if(hireCost > 0) S.cur.equip.push({n: 'Thuê lại ' + (st ? st.n : dueId) + ' (' + staffName + ')', v: hireCost});
      S.upg[dueId] = true;
      S.hired[dueId] = true;
      if(typeof enforceStaffExclusivity === 'function') enforceStaffExclusivity(dueId);
      save(); head();
      if(dueId === 'staffButler') staffButlerPerformDuties(true);
      toast(`🎉 Đã ký hợp đồng thuê lại thành công ${staffName} (${st ? st.n : dueId})!`, 5000);
      checkStaffExcuses(onProceed);
    }, canRehire ? 1 : 0]);
    askButtons.push(['Để nhân viên rời tiệm & mở quán', () => {
      checkStaffExcuses(onProceed);
    }]);

    ask(`
      <div class="pbig">📦</div>
      <h2 style="color:#dc2626;margin:4px 0 8px;">ĐÃ ĐẾN NGÀY CHÍNH THỨC NGHỈ VIỆC!</h2>
      <div style="background:#fef2f2;border-left:4px solid #ef4444;padding:12px 14px;border-radius:8px;margin:10px 0;font-size:0.88rem;line-height:1.55;color:#1e293b;text-align:left;">
        👤 <b>${staffName}</b> ${st ? `(${st.n})` : ''}:<br>
        <i>"Hôm nay là Ngày ${notice.quitDay}, tôi đã làm việc đủ ${notice.noticeDays} ngày báo trước theo đơn xin nghỉ việc. Tôi xin phép bàn giao lại toàn bộ công việc và chính thức rời quán ạ! Cảm ơn sếp và tiệm trà thời gian qua."</i>
      </div>
      <div style="font-size:0.84rem;color:#475569;margin-bottom:8px;text-align:left;">
        ${isSpecialStaff ?
          `Để giữ chân nhân sự đặc biệt này, chủ tiệm có thể ký hợp đồng mới thuê lại ngay bằng ${roleCostTxt}!` :
          `⚠️ Nhân viên này đã chính thức rời tiệm! Bạn có thể vào mục Nâng cấp hoặc KPI để tuyển lại.`}
      </div>
    `, askButtons);
    return;
  }

  // 3. Tiếp tục kiểm tra drama ngẫu nhiên trong ngày (Nhân viên đạt Lv.4-5 đã xóa 100% tật xấu vặt/nghỉ ngang)
  const activeStaff = STAFF.filter(u => {
    const isHiredOrWorking = (S.upg && S.upg[u.id]) || (S.hired && S.hired[u.id]);
    if(!isHiredOrWorking) return false;
    const trainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv(u.id) : 0;
    return trainLv < 4;
  });
  if(activeStaff.length < 1) return onProceed();

  // Cơ chế drama nhân sự: Nền 10%, mỗi nhân viên đã tuyển thêm +2%, tối đa 20% (min 10%, max 20%)
  const totalActiveStaff = typeof getTotalActiveStaffCount === 'function' ? getTotalActiveStaffCount() : activeStaff.length;
  const dramaRate = Math.min(0.20, Math.max(0.10, 0.10 + Math.max(0, totalActiveStaff - 1) * 0.02));
  if(Math.random() >= dramaRate) return onProceed();

  const shuffled = [...activeStaff].sort(() => Math.random() - 0.5);
  const st = shuffled[0];
  const stTrainLv = typeof getStaffTrainLv === 'function' ? getStaffTrainLv(st.id) : 0;
  if(stTrainLv > 0 && Math.random() < stTrainLv * 0.25) return onProceed();
  const staffName = (S.staffNames && S.staffNames[st.id]) || (typeof staffPersonName === 'function' ? staffPersonName(st.id) : null) || st.n;
  const hasQuitNotice = !!(S.staffQuitNotices && S.staffQuitNotices[st.id]);
  const hasLeaveNotice = !!(st.id === 'staffOn' && S.staffOnLeaveNotice);

  let availableExcuses = [...STAFF_EXCUSES];
  if(st.id === 'staffButler'){
    availableExcuses = availableExcuses.concat([
      {
        type: 'quit',
        reason: 'Được gia tộc lớn mời về quản lý trang viên',
        icon: '🤵',
        txt: 'Thưa chủ tiệm, tôi vừa nhận được lời mời từ một gia tộc lớn về phụ trách quản lý toàn bộ dinh thự và khu vườn sinh thái của họ. Tôi xin gửi đơn báo trước để chủ tiệm kịp sắp xếp nhân sự quản xuyến quán trà nhé!'
      },
      {
        type: 'quit',
        reason: 'Xin nghỉ dưỡng lão & vui vầy cùng con cháu',
        icon: '🏡',
        txt: 'Thưa chủ tiệm, tuổi tác tôi cũng đã cao, con cháu phương xa tha thiết mời tôi về quê an dưỡng tuổi già và chăm sóc vườn tược gia đình. Tôi xin gửi đơn trước vài ngày để bàn giao lại toàn bộ công việc quản gia chu đáo cho tiệm.'
      },
      {
        type: 'quit',
        reason: 'Thừa kế chuỗi trà đạo hoàng gia bên Anh Quốc',
        icon: '👑',
        txt: 'Luật sư vừa gửi thông báo tôi được thừa kế một chuỗi tiệm trà cổ điển bên Anh Quốc từ người bác họ xa. Tôi xin gửi đơn báo trước để chủ tiệm sắp xếp nhân sự thay thế ạ!'
      },
      {
        type: 'demand_wage',
        amt: 150000,
        reason: 'Phụ cấp quản lý đa nhiệm vườn tược & thú cưng',
        icon: '🤵',
        txt: 'Thưa chủ tiệm, mấy ngày qua tôi đã quán xuyến từ chăm thú cưng, tưới vườn cây đến bảo trì toàn bộ máy móc không ngơi tay. Tôi kính đề nghị chủ tiệm thưởng nóng 150k phụ cấp điều hành để tăng thêm nhuệ khí phục vụ tiệm!',
        acceptMsg: 'Chủ tiệm duyệt thưởng nóng 150k! Quản gia cung kính cảm tạ, phong độ phục vụ đỉnh cao! ✨',
        rejectMsg: 'Chủ tiệm từ chối, Quản gia giữ vẻ mặt lạnh lùng đúng chuẩn quý tộc, giảm 20% tốc độ! 🧐'
      },
      {
        type: 'demand_wage',
        amt: 200000,
        reason: 'Doanh thu tiệm đạt mốc kỷ lục đòi thưởng nóng',
        icon: '📈',
        txt: 'Nhờ chiến lược định giá kịch trần Best Seller tài tình của tôi mà quán ăn nên làm ra, tôi xin đề xuất thưởng nóng 200k chia sẻ niềm vui thắng lợi cùng chủ tiệm!',
        acceptMsg: 'Chủ tiệm duyệt thưởng 200k! Quản gia mỉm cười thanh lịch, phục vụ tăng 25% tốc độ! 🥂',
        rejectMsg: 'Chủ tiệm từ chối, Quản gia nhấp chén trà thở dài giảm 20% năng suất! ☕'
      },
      {
        type: 'borrow',
        amt: 200000,
        reason: 'Sắm bộ ấm chén trà đạo quý tộc cổ',
        icon: '🍵',
        txt: 'Tôi vừa tìm thấy một bộ ấm chén gốm cổ cực kỳ tao nhã thích hợp trưng bày phòng khách của tiệm. Xin phép chủ tiệm cho tạm ứng 200k tiền quỹ để rước về nâng tầm đẳng cấp quán!',
        acceptMsg: 'Chủ tiệm duyệt ứng 200k! Tiệm trà toát lên vẻ quý phái sang trọng! 🏆',
        rejectMsg: 'Chủ tiệm từ chối, Quản gia thở dài tiếc nuối cho một tác phẩm nghệ thuật! ☕'
      },
      {
        type: 'off',
        reason: 'Dự hội thảo Hiệp hội Quản gia Hoàng gia',
        icon: '🎩',
        txt: 'Hôm nay tôi có lịch tham dự Hội nghị thượng đỉnh Hiệp hội Quản gia Hoàng gia chia sẻ kinh nghiệm vận hành trang viên. Tôi xin phép vắng mặt 1 ca hôm nay, chủ tiệm tự tay pha chế nhé!'
      },
      {
        type: 'off',
        reason: 'Chăm sóc vườn trà cổ thụ gia đình',
        icon: '🪴',
        txt: 'Cây trà cổ thụ gia truyền của tôi đang vào mùa trổ búp non quý hiếm, tôi cần túc trực thu hoạch đúng giờ hoàng đạo. Xin phép chủ tiệm nghỉ 1 ca hôm nay!'
      },
      {
        type: 'late',
        reason: 'Chỉnh trang âu phục & là phẳng cà vạt nghi lễ',
        icon: '👔',
        txt: 'Bộ âu phục nghi lễ của tôi bị thợ giặt ủi làm nhăn, tôi phải đích thân là phẳng từng nếp gấp chuẩn phong thái quý tộc nên xin phép tới quán trễ nửa ca thưa chủ tiệm!'
      },
      {
        type: 'late',
        reason: 'Tham gia đấu giá hạt giống hoa quý hiếm',
        icon: '🌸',
        txt: 'Sáng nay diễn ra phiên đấu giá kín một giống hoa trà đột biến tuyệt đẹp, tôi nán lại đấu giá cho bằng được nên xin đến trễ nửa ca thưa chủ tiệm!'
      }
    ]);
  } else if(st.id === 'staffGuard'){
    availableExcuses = availableExcuses.concat([
      {
        type: 'quit',
        reason: 'Về quê an dưỡng tuổi già & làm nhà vườn',
        icon: '👮‍♂️',
