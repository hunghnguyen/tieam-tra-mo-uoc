];

function applyMktAutoReplies(){
  if(!window.S || !S.upg || !S.upg.staffMkt || !Array.isArray(S.reviews) || !S.reviews.length) return;
  const pName = staffPersonName('staffMkt') || 'Me két tinh';
  let hasChange = false;
  // Chăm sóc chu đáo toàn bộ nhận xét chưa được phản hồi trong bộ nhớ
  const targetReviews = S.reviews;
  targetReviews.forEach(x => {
    if(!x) return;
    const isReset = !!(x.isMilestoneReset || (x.k && String(x.k).startsWith('cycle0s_')) || x.tg === '⭐ Cán Mốc 5 Sao' || (x.t && (x.t.includes('Đạt đỉnh 5 sao hoàn hảo') || x.t.includes('Đặt lại vạch xuất phát 0 sao') || x.t.includes('Cán Mốc 5 Sao'))));
    if(isReset) return; // Phản hồi đánh giá của việc reset là không cần thiết, bỏ qua hoàn toàn

    const isPoliceFail = (x.k && String(x.k).startsWith('police_fail')) || (x.why === 'police_blunder') || (x.t && /vu khống|chụp mũ|công an|tiền giả/i.test(x.t));
    
    // Tự động sửa lại nếu trước đó bị lỗi me két tinh khen ngon lạc quẻ trong review công an / vu khống
    if(x.mktRep && isPoliceFail && /ngon mê ly|năng lượng tích cực|tinh hoa hội tụ|chữa lành|10 điểm|check var độ ngọt/i.test(x.mktRep)){
      x.mktRep = rnd(MKT_POLICE_CALM_QUOTES);
      x.mktIsToxic = false;
      hasChange = true;
    }

    if(!x.mktRep){
      x.mktName = pName;
      // Giảm tối đa tỉ lệ cãi tay đôi, ưu tiên dỗ dành làm dịu lòng khách
      const moodRoll = Math.random();
      let isToxic = false;

      if(isPoliceFail){
        isToxic = moodRoll < 0.04;
        x.mktRep = isToxic ? rnd(MKT_POLICE_TOXIC_QUOTES) : rnd(MKT_POLICE_CALM_QUOTES);
      } else if(x.s <= 2){
        // 96% dỗ dành xin lỗi ngọt ngào, chỉ 4% trả treo
        isToxic = moodRoll < 0.04;
        x.mktRep = isToxic ? rnd(MKT_TOXIC_QUOTES) : rnd(MKT_BAD_CALM_QUOTES);
      } else if(x.s === 3){
        // Chỉ 2% bắt bẻ vì sao cho 3 sao
        const isArgue = moodRoll < 0.02;
        isToxic = isArgue;
        x.mktRep = isArgue ? rnd(MKT_AVG_ARGUE_QUOTES) : rnd(MKT_AVG_QUOTES);
      } else {
        // Luôn xu nịnh thả thính khách 4-5 sao
        x.mktRep = rnd(MKT_TREND_QUOTES);
        isToxic = false;
      }
      x.mktIsToxic = isToxic;

      // Giảm tối đa tỉ lệ nóng giận phản hồi xấu làm tụt sao (chỉ 3% nếu lỡ toxic)
      if(isToxic && x.s > 1 && Math.random() < 0.03){
        const oldS = x.s;
        if(x.origS == null) x.origS = oldS;
        x.s = Math.max(1, oldS - 1);
        x.mktStarDown = oldS - x.s;
        if(S.revDist && S.revDist[oldS] != null && S.revDist[x.s] != null){
          S.revDist[oldS] = Math.max(0, S.revDist[oldS] - 1);
          S.revDist[x.s] = (S.revDist[x.s] || 0) + 1;
        }
        toast(`⚠️ Me két tinh cãi khách làm tụt -${x.mktStarDown}★! 😤`, 3000, 1);
      }

      // TĂNG MẠNH TỈ LỆ NÂNG SAO: 70% tỉ lệ khách cảm động quay xe buff thêm sao
      if(!isToxic && x.s < 5 && Math.random() < 0.70){
        const oldS = x.s;
        if(x.origS == null) x.origS = oldS;
        // Sao thấp (<=2★) có 65% nâng vọt +2★, khách 3-4★ dễ dàng lên 5★
        const up = (oldS <= 2) ? (Math.random() < 0.65 ? 2 : 1) : 1;
        const maxCap = (Math.random() < 0.60 || oldS >= 4) ? 5 : 4;
        const targetS = Math.min(maxCap, oldS + up);
        if(targetS > oldS){
          x.s = targetS;
          x.mktStarUp = x.s - oldS;
          x.mktCustHappy = rnd(MKT_CUST_HAPPY_QUOTES);
          if(S.revDist && S.revDist[oldS] != null && S.revDist[x.s] != null){
            S.revDist[oldS] = Math.max(0, S.revDist[oldS] - 1);
            S.revDist[x.s] = (S.revDist[x.s] || 0) + 1;
          }
          toast(`✨ Me két tinh phản hồi ngọt ngào, khách quay xe nâng +${x.mktStarUp}★! ⭐`, 2500);
        }
      }

      hasChange = true;
    } else if(!x.mktIsToxic && !x.mktStarUp && !x.mktCheckedStar && x.s < 5){
      // Quét các đánh giá cũ chưa từng xét nâng sao (tăng tỉ lệ lên 55%)
      x.mktCheckedStar = true;
      if(Math.random() < 0.55){
        const oldS = x.s;
        if(x.origS == null) x.origS = oldS;
        const up = (oldS <= 2) ? (Math.random() < 0.65 ? 2 : 1) : 1;
        const maxCap = (Math.random() < 0.60 || oldS >= 4) ? 5 : 4;
        const targetS = Math.min(maxCap, oldS + up);
        if(targetS > oldS){
          x.s = targetS;
          x.mktStarUp = x.s - oldS;
          x.mktCustHappy = rnd(MKT_CUST_HAPPY_QUOTES);
          if(S.revDist && S.revDist[oldS] != null && S.revDist[x.s] != null){
            S.revDist[oldS] = Math.max(0, S.revDist[oldS] - 1);
            S.revDist[x.s] = (S.revDist[x.s] || 0) + 1;
          }
          hasChange = true;
        }
      }
    }

    // Dọn dẹp mktCustRep cũ nếu chủ tiệm chưa phản hồi (để lượt 4 là khách phản hồi sau khi chủ tiệm phản hồi ở lượt 3)
    if(x.mktCustRep && !x.rp){
      delete x.mktCustRep;
      hasChange = true;
    }
  });
  if(hasChange){
    save();
    head();
  }
}

/* ---------- HEADER ---------- */
const esc=t=>String(t).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
try{window.esc=esc;}catch(e){}
const shopName=()=>(!S.shopName||S.shopName==='Tiệm Trà Nhỏ')?'Tiệm Trà Mơ Ước':S.shopName;
function setName(v){v=String(v||'').replace(/\s+/g,' ').trim().slice(0,30);S.shopName=v;document.title=shopName();save()}

function getShopLogoSrc(){
  if(S && S.shopLogo) return S.shopLogo;
  if(S && S.brand && S.brand.customLogo) return S.brand.customLogo;
  if(S && S.brand && S.brand.i) return (typeof brandLogoSrc === 'function') ? brandLogoSrc(S.brand.i) : `${IMG}brand/${S.brand.i}.png`;
  return `${IMG}brand/b21.png`;
}

function processCustomLogoFile(file, onDone){
  if(!file) return;
  const isImg = (file.type && file.type.startsWith('image/')) || /\.(jpe?g|png|webp|gif|bmp|svg)$/i.test(file.name || '');
  if(!isImg){
    toast('Vui lòng chọn file hình ảnh (PNG, JPG, WebP)!', 3000);
    return;
  }
  const reader = new FileReader();
  reader.onload = (e) => {
    const img = new Image();
    img.onload = () => {
      try {
        const maxDim = 160;
        let w = img.naturalWidth || img.width || 1;
        let h = img.naturalHeight || img.height || 1;
        const scale = Math.min(maxDim / w, maxDim / h, 1);
        const targetW = Math.max(1, Math.round(w * scale));
        const targetH = Math.max(1, Math.round(h * scale));

        const canvas = document.createElement('canvas');
        canvas.width = targetW;
        canvas.height = targetH;
        const ctx = canvas.getContext('2d');
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(img, 0, 0, targetW, targetH);

        const dataUrl = canvas.toDataURL('image/png');
        if(!S.brand){
          S.brand = { bg: '#fffaf0', i: 'b21', frame: 'round', slogan: '' };
        }
        S.brand.i = dataUrl;
        S.brand.customLogo = dataUrl;
        S.shopLogo = dataUrl;
        save();
        toast('✨ Đã cập nhật logo quán và đồng bộ lên ly trà của bạn! 🎉', 3000);
        if(typeof renderPrep === 'function' && R.mode === 'prep') renderPrep();
        if(onDone) onDone(dataUrl);
      } catch(err) {
        console.error(err);
        toast('Lỗi khi xử lý ảnh logo: ' + (err.message || err), 3000);
      }
    };
    img.onerror = () => {
      toast('Không thể mở file ảnh, vui lòng thử ảnh khác!', 3000);
    };
    img.src = e.target.result;
  };
  reader.onerror = () => {
    toast('Lỗi đọc file từ thiết bị!', 3000);
  };
  reader.readAsDataURL(file);
}

function openShopLogoModal(){
  const curLogo = getShopLogoSrc();
  ask(`
    <div style="text-align:center;padding:4px 0;">
      <h2 style="margin:0 0 6px;font-size:1.15rem;color:var(--ink);">🎨 Logo Quán &amp; Nhận Diện Thương Hiệu</h2>
      <p style="font-size:0.84rem;color:var(--soft);margin:0 0 14px;line-height:1.4;">Logo này hiển thị trước tên tiệm, trên trang Mạng Xã Hội và in trên tem ly trà của bạn!</p>
      
      <div style="display:flex;align-items:center;justify-content:center;gap:14px;background:var(--panel);border:1.5px solid var(--line);border-radius:14px;padding:12px;margin-bottom:14px;">
        <div style="width:68px;height:68px;border-radius:50%;border:2.5px solid var(--pink,#ef6f8e);overflow:hidden;background:#fff;box-shadow:0 3px 10px rgba(0,0,0,0.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
          <img id="previewCurrentLogo" src="${curLogo}" alt="Logo" style="width:100%;height:100%;object-fit:cover;">
        </div>
        <div style="text-align:left;">
          <div style="font-weight:900;font-size:1rem;color:var(--ink);">${esc(shopName())}</div>
          <div style="font-size:0.78rem;color:var(--soft);margin-top:2px;">Biển hiệu · Mạng Xã Hội · Tem in ly</div>
        </div>
      </div>

      <div style="display:flex;flex-direction:column;gap:9px;margin-top:10px;">
        <input type="file" id="shopLogoFileInput" accept="image/*" style="display:none;">
        <button type="button" class="sbtn pri" id="btnUploadPersonalPhoto" style="padding:10px 14px;font-size:0.88rem;font-weight:800;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:8px;">
          📷 Tải ảnh cá nhân từ máy lên làm Logo
        </button>
        <button type="button" class="sbtn" id="btnChooseBrandKit" style="padding:9px 14px;font-size:0.85rem;border-radius:12px;display:flex;align-items:center;justify-content:center;gap:8px;">
          🎨 Thiết kế tem &amp; Chọn mẫu logo ly
        </button>
      </div>
    </div>
  `, [
    ['Đóng', ()=>{}]
  ]);

  setTimeout(()=>{
    const fileIn = $('shopLogoFileInput');
    const btnUp = $('btnUploadPersonalPhoto');
    const btnKit = $('btnChooseBrandKit');

    if(btnUp && fileIn){
      btnUp.onclick = () => fileIn.click();
      fileIn.onchange = (e) => {
        const file = e.target.files && e.target.files[0];
        if(file){
          processCustomLogoFile(file, (newUrl)=>{
            const prev = $('previewCurrentLogo');
            if(prev) prev.src = newUrl;
            $('modal').hidden = true;
            if(R.mode === 'prep' && typeof renderPrep === 'function') renderPrep();
            if(document.querySelector('.mxh-pane-wrap') && typeof paneMxh === 'function'){
              paneMxh();
            }
          });
        }
      };
    }
    if(btnKit){
      btnKit.onclick = () => {
        $('modal').hidden = true;
        if(typeof brandDlg === 'function') brandDlg();
      };
    }
  }, 50);
}

function renameDlg(){
  ask(`<h2>Đặt tên quán</h2><p>Tối đa 30 ký tự. Tên sẽ hiện trên biển hiệu, đánh giá và tổng kết.</p><input id="nameIn" class="pinbox nm" maxlength="30" value="${esc(shopName())}" placeholder="Ví dụ: Tiệm Trà Mơ Ước" aria-label="Tên quán"><div style="margin-top:10px;text-align:center;"><button type="button" class="sbtn ghost" id="btnDlgOpenLogo" style="font-size:0.82rem;padding:4px 10px;border-radius:8px;">🎨 Đổi logo quán / Tải ảnh cá nhân</button></div>`,
    [['Huỷ',()=>{}],['Lưu tên',()=>{setName($('nameIn').value);toast('Đã đổi tên quán');renderPrep()},1]]);
  setTimeout(()=>{
    const i=$('nameIn');if(i){i.focus();i.select()}
    const lgBtn = $('btnDlgOpenLogo');
    if(lgBtn) lgBtn.onclick = () => { $('modal').hidden = true; openShopLogoModal(); };
