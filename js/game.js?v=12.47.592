function spawn(){
  const i=R.slots.findIndex(s=>!s);if(i<0||bigOrder())return;
  if(R.starPend){R.starPend=false;spawnStar(i);return}
  const bMul = typeof getStartupBuffMul === 'function' ? getStartupBuffMul() : 1.0;
  const dMul = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
  if(S && S.startupLocation === 'phuquoc' && !R.vipPending && !R.today.starVisited && S.day >= 2 && Math.random() < Math.min(0.15, 0.045 * bMul)){
    R.today.starVisited = true; // Phú Quốc: Khách ngôi sao quốc tế x1,5 tần suất (nhân theo cấp Đế Chế)
    spawnStar(i);
    return;
  }
  if(!R.vipPending && window.BanBe && window.BanBe.checkSpawnVIPFriend && window.BanBe.checkSpawnVIPFriend(i)){ R.firstDone=true; return; }
  if(!R.vipPending && typeof checkSpawnSpecialRecipeGuest === 'function' && checkSpawnSpecialRecipeGuest(i)){ R.firstDone=true; return; }
  const hasDieuHongBuff = !!(S && S.collection && S.collection.craftedRecipes && S.collection.craftedRecipes['rec_vutru_dieuhong']);
  if(!hasDieuHongBuff){
    const pi=pricyItems();if(pi.length&&Math.random()<.8){R.today.priceLost++;if(Math.random()<.25)addReview(rnd([1,2,2]),'pricey',false,null);if(!R.pricyT||performance.now()-R.pricyT>8000){R.pricyT=performance.now();toast('Khách xem menu chê '+(pi[0]==='L'?'size L':low(ITEMS[pi[0]].n))+' mắc quá, bỏ đi')}return}
  }
  
  // Khách vãng lai gọi Đồ Uống Đặc Biệt (Công thức độc bản đã chế tạo trong Sổ Tay VÀ ĐỦ NGUYÊN LIỆU TRONG KHO): Tỉ lệ 1.5% (Đà Lạt: Gen Z +3% * bMul món đặc biệt)
  const craftedKeys = (S && S.collection && S.collection.craftedRecipes) ? Object.keys(S.collection.craftedRecipes) : [];
  let isSpecialDrinkOrder = false;
  let specialRecipeInfo = null;
  const specialRate = (S && S.startupLocation === 'dalat') ? Math.min(0.15, 0.015 + 0.030 * bMul) : 0.015;
  if(craftedKeys.length > 0 && !R.vipPending && Math.random() < specialRate){
    const allRecipes = getAllRecipes();
    const craftedRecipesList = allRecipes.filter(r => craftedKeys.includes(r.id) && canMakeRecipe(r, true));
    if(craftedRecipesList.length > 0){
      specialRecipeInfo = rnd(craftedRecipesList);
      if(specialRecipeInfo && specialRecipeInfo.gameOrder){
        isSpecialDrinkOrder = true;
      }
    }
  }

  const hasAds = !!(S.mxh && S.mxh.activeAds && S.mxh.activeAds.length > 0) || !!(S.ads && S.ads.days > 0);
  // Cap cups/customer tối đa 3 ly chuẩn F&B (bỏ mức 4-5 ly gây ảo sản lượng)
  let nc = hasAds
    ? (level() >= 3 ? wpick([1, 2, 3], [.35, .45, .20]) : wpick([1, 2, 3], [.50, .35, .15]))
    : (level() >= 3 ? wpick([1, 2, 3], [.50, .35, .15]) : (evIs('weekend') || evIs('holiday')) && level() >= 2 && Math.random() < .3 ? 2 : 1);
  if(S && S.startupLocation === 'danang' && Math.random() < Math.min(0.80, 0.35 * bMul)){
    nc = wpick([2, 3], [.65, .35]); // Đà Nẵng: Khách mua nhiều ly
  }
  let isCamauCombo = false;
  if(S && S.startupLocation === 'camau' && Math.random() < Math.min(0.70, 0.28 * bMul)){
    nc = wpick([2, 3], [.55, .45]); // Cà Mau: 28% đơn gia đình 2-3 ly
    isCamauCombo = true;
  }
  nc = Math.min(3, Math.max(1, nc));
  let isTrendDrinkOrder = false;
  let trendCupInfo = null;
  if(!isSpecialDrinkOrder && typeof window.TrendSystem !== 'undefined' && window.TrendSystem.checkGenerateTrendCup){
    trendCupInfo = window.TrendSystem.checkGenerateTrendCup();
    if(trendCupInfo){
      isTrendDrinkOrder = true;
    }
  }
  const cups=isSpecialDrinkOrder ? [fixOrder(JSON.parse(JSON.stringify(specialRecipeInfo.gameOrder)))] : (isTrendDrinkOrder ? [trendCupInfo] : Array.from({length:nc},genOrder));
  if(isCamauCombo){
    cups.forEach(cup => { cup.isCombo = true; });
  }
  const o=cups[0],idx=cups.reduce((a,x)=>a+priceIdx(x),0)/cups.length;
  const soList = cups.filter(x => x.so);
  if(soList.length > 0){
    if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
      soList.forEach(x => staffBuyerTriggerInstant(x.so));
    }
    if(typeof isStaffActive === 'function' && isStaffActive('staffRacer')){
      // Chiến thần xa lộ đã mua bổ sung siêu tốc 0s! Khách không bỏ về mà order được thực hiện tiếp
      cups.forEach(cup => { if(cup.so) cup.so = null; });
    } else {
      R.today.soldLost=(R.today.soldLost||0)+1;
      R.today.lost++;
      const soName = (ITEMS[soList[0].so] && ITEMS[soList[0].so].n) || soList[0].so;
      fl($('lane'),'🚫 Hết '+low(soName)+', khách bỏ về!',true);
      toast(`🚫 Hết ${low(soName)}, khách không muốn chờ NV đi chợ mua về nên đã bỏ về!`, 3000);
      return;
    }
  }
  const allNeededLane = cups.flatMap(c => (typeof needs === 'function') ? needs(c) : []);
  const missingLane = allNeededLane.filter(k => qty(k) === 0);
  if(missingLane.length > 0 && S.upg && (S.upg.staffBuyer || S.upg.staffRacer)){
    missingLane.forEach(k => staffBuyerTriggerInstant(k));
  }
  const over=cups.some(overCap);
  let priceyChance = cups.some(orderPricey) ? 0.4 : 0;
  if(S && (S.startupLocation === 'danang' || S.startupLocation === 'cantho')){
    // Đà Nẵng & Cần Thơ: Khách nhạy giá: tăng giá bán cao làm -10% tỷ lệ mua (+10% * dMul tỷ lệ chê đắt bỏ đi)
    const isHigherPrice = cups.some(c => priceIdx(c) > 1.05 || orderPricey(c));
    if(isHigherPrice) priceyChance = Math.min(0.95, priceyChance + 0.10 * dMul);
  }
  if((over&&Math.random()<.6)||(priceyChance > 0 && Math.random() < priceyChance)){
    R.today.priceLost++;
    if(Math.random() < 0.25) addReview(rnd([1,2,2]), 'pricey', false, null);
    toast('Có khách chê đắt, bỏ đi');
    return;
  }
  const huongMul=1+((S.upgLv&&S.upgLv.huong)||0)*0.003;
  const spacePatienceMul = S.upg.floor2 ? 1.35 : (S.upg.slot4 ? 1.18 : 1.0);
  const dogPatienceMul = (S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50) ? 1.20 : 1.0;
  const max=(40+(level()>=2?4:0))*(S.upg.seats?1.12:1)*(S.upg.mascot?1.12:1)*(1+.25*(nc-1))*(1+.15*cups.reduce((a,x)=>a+slowN(x)+Math.max(0,x.tops.length-1),0)/cups.length)*huongMul*spacePatienceMul*dogPatienceMul;
  const useSet2=Math.random()<0.65;
  const faceSet=useSet2?2:1;
  const who=useSet2?Math.floor(Math.random()*20):Math.floor(Math.random()*9),pp=PERSONA[who%PERSONA.length];
  const vip=R.vipPending;if(vip){R.vipPending=false;toast('Food reviewer vừa tới quán!')}
  let isTiktoker = false;
  let tiktokerInfo = null;
  if(!vip && !R.tiktokerTodayDone && window.TiktokerSystem && window.TiktokerSystem.checkShouldSpawn(S.day) && R.t < (S.dayLen||CFG.dayMin)*60*0.75){
    R.tiktokerTodayDone = true;
    isTiktoker = true;
    tiktokerInfo = window.TiktokerSystem.getRandomTiktoker();
    toast(`🎬 Food Tiktoker ${tiktokerInfo.name} (${tiktokerInfo.followers}) ghé quán quay livestream! Hãy pha chế chuẩn 5★! ✨`, 5500);
  }

  // Khách hàng đặc biệt (5% tỉ lệ xuất hiện, avatar từ thư mục img/customers, buff/debuff ngẫu nhiên)
  let isSpecialCust = false;
  let specialCustProfile = null;
  let specialEffect = null;
  if(!vip && !isTiktoker && !isSpecialDrinkOrder && Math.random() < 0.05){
    isSpecialCust = true;
    specialCustProfile = rnd(SPECIAL_CUSTOMERS);
    const isBuff = Math.random() < 0.50;
    specialEffect = isBuff ? rnd(SPECIAL_BUFFS) : rnd(SPECIAL_DEBUFFS);
  }

  if(isSpecialCust && specialCustProfile && specialEffect){
    // Nếu có debuff thích nhiều topping, đảm bảo mỗi ly order có tối thiểu 3 topping
    if(specialEffect.id === 'debuff_fussy'){
      const unTops = TOP_KEYS.filter(k => S.unlocked[k] && addOk(k));
      cups.forEach(cOrder => {
        if(!cOrder.tops) cOrder.tops = [];
        const availTops = unTops.filter(k => !cOrder.tops.includes(k));
        while(cOrder.tops.length < 3 && availTops.length > 0){
          const nextTop = availTops.shift();
          cOrder.tops.push(nextTop);
        }
      });
    }
  }

  const brat=(vip||isTiktoker||isSpecialCust)?null:pickBrat();
  let vipFace=isTiktoker?'🎬':(vip?'🎙️':rnd(FACES));
  let cName = PNAME[who % PNAME.length]?PNAME[who % PNAME.length]():genName();

  if(isSpecialCust && specialCustProfile){
    cName = specialCustProfile.name;
  } else if(isTiktoker && tiktokerInfo){
    cName = tiktokerInfo.name;
  } else if(vip){
    const reviewerNames = [
      'Foodie Sài Gòn 🛵',
      'Thánh Ăn Vặt Hà Nội 🥢',
      'Reviewer Mỏ Khoét',
      'Food Blogger Ninh Tito',
      'Bé Bụng Bự Review',
      'KOL Ẩm Thực Đà Nẵng',
      'Kênh Món Ngon Phố',
      'Chuyên Gia Ẩm Thực 5★'
    ];
    cName = rnd(reviewerNames);
  }

  let isFreeDrink = false;
  if(!vip && !isTiktoker && !isSpecialCust && S.freeDrinkQueue && S.freeDrinkQueue.length > 0 && Math.random() < 0.65){
    const fd = S.freeDrinkQueue.shift();
    if(fd && fd.name){
      cName = fd.name;
      isFreeDrink = true;
    }
  } else if(!vip && !isTiktoker && !isSpecialCust && (S.reviews || []).some(r => (r.freeDrinkActive || (r.freeDrinkNext && !r.freeDrinkDelivered))) && Math.random() < 0.60){
    const pendingR = (S.reviews || []).find(r => (r.freeDrinkActive || (r.freeDrinkNext && !r.freeDrinkDelivered)));
    if(pendingR){
      cName = pendingR.n || cName;
      isFreeDrink = true;
    }
  }

  const fromBranch = null;

  if(isFreeDrink){
    setTimeout(()=>{
      toast(`🎁 Khách ${cName} ghé quán: "Em đến nhận ly nước FREE đúng như quán đã hứa hẹn nè! 🥰"`, 4500, 1);
    }, 400);
  } else if(isSpecialCust && specialCustProfile && specialEffect){
    const effTypeStr = specialEffect.type === 'buff' ? '🟢 BUFF' : '🔴 DEBUFF';
    setTimeout(()=>{
      toast(`✨ Khách đặc biệt ${specialCustProfile.name} ghé quán! [${effTypeStr}] ${specialEffect.icon} ${specialEffect.name}: ${specialEffect.desc}`, 6500, specialEffect.type === 'buff' ? 0 : 1);
      sfx(specialEffect.type === 'buff' ? 'star' : 'ding');
    }, 400);
  }

  const reviewerSays = [
    'Chào quán, mình bên Review Ẩm Thực ghé thẩm món, cho mình',
    'Food reviewer ghé test món theo lời đồn nè, cho mình',
    'Lên clip review cho quán nè, cho mình'
  ];
  const reviewerEnds = [
    ' nha! Làm chuẩn để mình chấm điểm nha!',
    ' nha! Chờ xem tay nghề chủ quán thế nào!',
    ' nhé quán!'
  ];

  let sayLine = isSpecialCust ? `Chào quán! Mình là ${specialCustProfile.title}, cho mình` : (isTiktoker ? (tiktokerInfo.quote + ' Cho mình') : (isSpecialDrinkOrder ? `Quán ơi cho em 1 ly ${specialRecipeInfo.name} nha!` : (isTrendDrinkOrder && trendCupInfo ? trendCupInfo.trendQuote : (isFreeDrink ? 'Cho em nhận ly' : (vip ? rnd(reviewerSays) : rnd(pp.o))))));
  let endLine = isSpecialCust ? ` nha! [${specialEffect.type === 'buff' ? 'BUFF' : 'DEBUFF'} ${specialEffect.icon} ${specialEffect.name}]` : (isTiktoker ? ' nha! Clip đang livestream triệu view đó!' : (isSpecialDrinkOrder ? ' Nghe đồn món đặc biệt này ngon nức tiếng! 🧋✨' : (isTrendDrinkOrder ? ' nha quán! 🔥' : (isFreeDrink ? ' free nhen quán! 🥰' : (vip ? rnd(reviewerEnds) : rnd(pp.e))))));
  if(!isFreeDrink && !vip && !isTiktoker && !isSpecialDrinkOrder && !isSpecialCust && !isTrendDrinkOrder){
    if(brat === 'mac'){
      endLine = rnd([
        ' nha, bớt em ít tiền lẻ nhen! 💸',
        ' nha, tính giá sinh viên bớt chút nha chủ quán!',
        ' nha, tròn giá bớt tiền lẻ nhen chị!',
        ' nha, bớt em xíu lấy thảo nha quán!'
      ]);
    } else if(brat === 'thieu'){
      endLine = rnd([
        ' nha, lát em gửi thiếu mấy ngàn lẻ sau nhen! 🪙',
        ' nhen, em còn đúng chừng này tiền à thông cảm nhen!',
        ' nha, em quên mang đủ tiền lẻ xíu em ghé gửi bù!',
        ' nha quán!'
      ]);
    }
  }

  R.firstDone=true;
  R.slots[i]={
    isSpecialDrinkCustomer: isSpecialDrinkOrder,
    specialRecipe: specialRecipeInfo,
    isTrendDrink: isTrendDrinkOrder,
    trendInfo: trendCupInfo ? trendCupInfo.trendInfo : null,
    isSpecialCust: isSpecialCust,
    specialCustProfile: specialCustProfile,
    specialEffect: specialEffect,
    customAvatar: isSpecialCust && specialCustProfile ? `${IMG}customers/${specialCustProfile.file}` : null,
    brat: isFreeDrink ? null : brat,
    born: performance.now(),
    vip: !!(vip || isTiktoker),
    isTiktoker,
    tiktokerInfo,
    isFreeDrink,
    fromBranch: false,
    branchName: null,
    id: ++uid,
    who,
    faceSet,
    face: vipFace,
    name: cName,
    say: sayLine,
    end: endLine,
    cups,
    done: cups.map(()=>false),
    order: o,
    pat: max*(isFreeDrink?1.2:1),
    max: max*(isFreeDrink?1.2:1),
    wrong: 0,
    paid: 0
  };
  {
    const c=R.slots[i];
    if(c&&(c.brat==='hoi'||c.brat==='voi')){c.max*=.82;c.pat=c.max}
    else if(c&&(c.brat==='checkin'||c.brat==='chuyen')){c.max*=1.25;c.pat=c.max}
    if(c && c.isSpecialCust && c.specialEffect && c.specialEffect.id === 'buff_zen'){
      c.max *= 1.50;
      c.pat = c.max;
    }
    if(c && S && S.startupLocation === 'sapa'){ c.max *= (1 + 0.20 * bMul); c.pat = c.max; }
    else if(c && S && S.startupLocation === 'hue'){ c.max *= (1 + 0.25 * bMul); c.pat = c.max; }
    if(c && typeof isStaffActive === 'function' && isStaffActive('staff0') && typeof getStaffTrainLv === 'function' && getStaffTrainLv('staff0') >= 5){
      c.max *= 1.15; c.pat = c.max;
    }
    if(c && typeof isStaffActive === 'function' && isStaffActive('staff1') && typeof getStaffTrainLv === 'function' && getStaffTrainLv('staff1') >= 5){
      c.max *= 1.20; c.pat = c.max;
    }
  }
  renderStreet();sfx('bell');
}
/* đơn online: tối đa 6 đến 12+ đơn tương xứng 2 hàng avatar; Shipper Thần Tốc nâng lên tối thiểu 10 đơn; Chiến thần xa lộ tăng thêm +3 đơn */
const onCap=()=>{
  const baseCap = (typeof isStaffActive === 'function' && isStaffActive('staffShipper'))
    ? Math.max(10, (R && R.slots ? R.slots.length : 3) + 3)
    : Math.max(6, (R && R.slots ? R.slots.length : 3) + 3);
  return baseCap + ((typeof isStaffActive === 'function' && isStaffActive('staffRacer')) ? 3 : 0);
};
const onMul=()=>{const n=appsOn().length;return n?(1+(n-1)*0.45):0;};
function pickApp(){const on=appsOn();return on.length?wpick(on,on.map(a=>a.w)):null}
function mkOnline(app,cups){
  const huongMul=1+((S.upgLv&&S.upgLv.huong)||0)*0.003,n=cups.length;
  const dogPatienceMul = (S.pet && S.pet.unlocked && S.pet.type === 'dog' && (S.pet.happiness || 0) >= 50) ? 1.20 : 1.0;
  // Shipper có độ kiên nhẫn kém: giảm từ 65s xuống 38s để tăng độ khó và áp lực giao hàng
  const max=38*(n>1?1+.20*(n-1):1)*huongMul*dogPatienceMul;
  const name = genName();
  const fromBranch = false;
  return {id:++uid,app:app.id,ship:rnd(app.rows),born:performance.now(),name,fromBranch,face:rnd(FACES),cups,done:cups.map(()=>false),order:cups[0],pat:max,max,wrong:0,big:n>1};
}
function spawnStar(i){const last=S.starLast,pool=STARS.map((x,k)=>k).filter(k=>k!==last),k=rnd(pool),st=STARS[k];S.starLast=k;if(S.starSch)S.starSch.done=true;
  let o=genOrder();for(let t=0;t<8&&o.so;t++)o=genOrder();if(o.so)o.so=null;
  const huongMul=1+((S.upgLv&&S.upgLv.huong)||0)*0.003;
  const s0PatMul = (typeof isStaffActive === 'function' && isStaffActive('staff0') && typeof getStaffTrainLv === 'function' && getStaffTrainLv('staff0') >= 5) ? 1.15 : 1;
  const s1PatMul = (typeof isStaffActive === 'function' && isStaffActive('staff1') && typeof getStaffTrainLv === 'function' && getStaffTrainLv('staff1') >= 5) ? 1.20 : 1;
  const hi=starLine(st,'hi'),max=(36+(level()>=2?4:0))*1.3*(S.upg.seats?1.15:1)*(S.upg.mascot?1.15:1)*(1+.2*(slowN(o)+Math.max(0,o.tops.length-1)))*huongMul*s0PatMul*s1PatMul;
  R.slots[i]={star:k,hi:hi[0],born:performance.now(),id:++uid,name:st.n,face:'⭐',say:st.m?'Cho anh':'Cho chị',end:rnd([' nha!',' nhé, cảm ơn nha!',' nha em!']),cups:[o],done:[false],order:o,pat:max,max,wrong:0,paid:0};
  renderStreet();sfx('star');setTimeout(()=>{const q=$('q3say');if(q)q._t=null;renderLane()},3600)}
function spawnOnline(){
  if(R && R.onlineTempClosed) return;
  const dMul = typeof getStartupDebuffMul === 'function' ? getStartupDebuffMul() : 1.0;
  if(S && S.startupLocation === 'phuquoc' && Math.random() < Math.min(0.60, 0.15 * dMul)) return; // Phú Quốc: Đơn trực tuyến -15% * dMul
  if(R.online.length>=onCap()||bigOrder())return;
  const rejectPricyChance = (typeof isStaffActive === 'function' && isStaffActive('staffShipper')) ? 0.20 : ((typeof isStaffActive === 'function' && isStaffActive('staffRacer')) ? 0.35 : 0.8);
  if(pricyItems().length&&Math.random()<rejectPricyChance)return;
  const app=pickApp();if(!app)return;
  let o = genOrder();
  if(o.so){
    for(let retry=0;retry<3;retry++){
      const oTry = genOrder();
      if(!oTry.so){ o = oTry; break; }
    }
  }
  if(o.so){
    if(S.upg && (S.upg.staffBuyer || S.upg.staffRacer || S.upg.staffShipper)) staffBuyerTriggerInstant(o.so);
    if(typeof isStaffActive === 'function' && (isStaffActive('staffRacer') || isStaffActive('staffShipper'))){
      o.so = null;
    } else {
      return;
    }
  }
  const cups = [o];
  const shipperTrainLv = (typeof isStaffActive === 'function' && isStaffActive('staffShipper') && typeof getStaffTrainLv === 'function') ? getStaffTrainLv('staffShipper') : 0;
  const baseExtraChance = (typeof isStaffActive === 'function' && isStaffActive('staffShipper')) ? 0.65 : ((typeof isStaffActive === 'function' && isStaffActive('staffRacer')) ? 0.55 : 0.35);
  const extraChance = Math.min(0.95, baseExtraChance + shipperTrainLv * 0.05);
  if(Math.random() < extraChance){
    let o2 = genOrder();
    if(o2.so){
      for(let retry2=0;retry2<2;retry2++){
        const o2Try = genOrder();
        if(!o2Try.so){ o2 = o2Try; break; }
      }
    }
    if(o2.so && S.upg && (S.upg.staffBuyer || S.upg.staffRacer || S.upg.staffShipper)) staffBuyerTriggerInstant(o2.so);
    if(!o2.so || (typeof isStaffActive === 'function' && (isStaffActive('staffRacer') || isStaffActive('staffShipper')))){
      o2.so = null;
      cups.push(o2);
    }
    if(shipperTrainLv > 0 && Math.random() < (shipperTrainLv * 0.05)){
      let o3 = genOrder();
      if(!o3.so || (typeof isStaffActive === 'function' && (isStaffActive('staffRacer') || isStaffActive('staffShipper')))){
        o3.so = null;
        cups.push(o3);
      }
    }
  }
  const allNeededOnl = cups.flatMap(c => (typeof needs === 'function') ? needs(c) : []);
  const missingOnl = allNeededOnl.filter(k => qty(k) === 0);
  if(missingOnl.length > 0 && S.upg && (S.upg.staffBuyer || S.upg.staffRacer || S.upg.staffShipper)){
    missingOnl.forEach(k => staffBuyerTriggerInstant(k));
  }
  R.online.push(mkOnline(app,cups));
  renderOnline();
}
/* đơn lớn: mỗi 30 ngày các app giao hàng có 1 đơn lớn, rơi vào ngày ngẫu nhiên */
const BIG={
  sp:{n:()=>1,min:5,max:10},
  tt:{n:()=>1,min:6,max:12},
  be:{n:()=>1,min:5,max:10},
  gr:{n:()=>1,min:6,max:12}
};
function planBig(){R.bigQ=[];const sc=S.bigSched=S.bigSched||{};
  appsOn().forEach(a=>{let x=sc[a.id];if(!x||S.day>x.end){const n=BIG[a.id].n(),d=[];while(d.length<n){const v=S.day+Math.floor(Math.random()*30);if(!d.includes(v))d.push(v)}x=sc[a.id]={end:S.day+29,days:d}}
    x.days.filter(v=>v===S.day).forEach(()=>R.bigQ.push({app:a.id,at:.2+Math.random()*.5}))})}
function spawnBig(q){
  if(R && R.onlineTempClosed) return true;
  const a=APPS.find(x=>x.id===q.app);if(!a||!appsOn().includes(a))return true;if(R.online.length>=onCap())return false;
  const B=BIG[a.id],n=B.min+Math.floor(Math.random()*(B.max-B.min+1)),cups=[];
  for(let k=0;k<n;k++){let o=genOrder();for(let t=0;t<6&&o.so;t++)o=genOrder();if(!o.so)cups.push(o)}
  if(cups.length<2)return true;R.online.push(mkOnline(a,cups));sfx('bell');toast('Đơn lớn '+a.n+': '+cups.length+' ly!',4000,1);renderOnline();return true}
const normSug=s=>(s==null||s==='')?null:parseInt(String(s),10);
const normIce=v=>(!v||v==='Không đá')?'none':(v==='Bình thường'?'Đá thường':v);
const hasCh=x=>!x?false:!!(x.cheese||(x.tops&&x.tops.map(normIngKey).includes('cheese')));
const pureTops=x=>(!x||!x.tops)?[]:x.tops.map(normIngKey).filter(t=>t&&t!=='cheese');
const matchTops=(a,b)=>{
  if(hasCh(a)!==hasCh(b))return false;
  const at=pureTops(a),bt=pureTops(b);
  if(at.length!==bt.length)return false;
  return at.every(t=>bt.includes(t));
};
const matches=(a,b)=>{
  if(!a||!b)return false;
  if(a.mixed)return false;
  const aBase = normIngKey(a.base)||a.base;
  const bBase = normIngKey(b.base)||b.base;
  if(aBase!==bBase)return false;
  const aFlav = (normIngKey(a.flav)||a.flav)||'none';
  const bFlav = (normIngKey(b.flav)||b.flav)||'none';
  if(aFlav!==bFlav)return false;
  if(a.size!==b.size && !a._svWrongAccept && !b._svWrongAccept)return false;
  if(b.sugar!=null&&normSug(a.sugar)!==normSug(b.sugar))return false;
  if(b.ice!=null&&normIce(a.ice)!==normIce(b.ice))return false;
  if(!matchTops(a,b))return false;
  return true;
};
/* giá "đắt" đúng như cảnh báo trong tab Giá bán: trà >115% giá gợi ý, hương/topping/size >130%, hoặc cả ly vượt mức tối đa */
const itemPricey=k=>{
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler')) return false; // Quản gia bảo chứng: 100% không bao giờ chê đắt!
  const curP = (k === 'L' ? S.sell.L : S.sell[k]);
  const defP = (k === 'L' ? (DEF_SELL.L || 7000) : (DEF_SELL[k] || 0));
  if(curP <= defP) return false;
  return curP > safeMax(k);
};
const orderPricey=o=>{
  if(typeof isStaffActive === 'function' && isStaffActive('staffButler')) return false; // Quản gia bảo chứng: 100% không bao giờ chê đắt!
  return overCap(o)||[o.base,...(o.flav?[o.flav]:[]),...o.tops,...(o.size==='L'?['L']:[])].some(itemPricey);
};
function wrongKinds(c,o){if(!o)return;const k=c.wk=c.wk||{};
  if(cup.base!==o.base||(cup.flav||null)!==(o.flav||null))k.mon=1;if(cup.size!==o.size&&!cup._svWrongAccept)k.size=1;
  if(o.sugar!=null&&normSug(cup.sugar)!==normSug(o.sugar))k.sugar=1;if(o.ice!=null&&normIce(cup.ice)!==normIce(o.ice))k.ice=1;
  if(!matchTops(cup,o))k.tops=1}
function stars(c,online){
  const hoardCash = typeof getEffectiveHoardCash === 'function' ? getEffectiveHoardCash(S && S.money) : (Number(S && S.money) || 0);
  const starTiers = typeof getSafeCashTiers === 'function' ? getSafeCashTiers(S && S.day) : { lowCap: 3000000000, midCap: 6000000000, highCap: 12000000000, megaCap: 30000000000 };
  const verdictStars = typeof getInGameCheatVerdict === 'function' ? getInGameCheatVerdict(hoardCash) : { isCheater: false, tier: 0 };
  const isCheaterStars = !!(verdictStars.isCheater || (typeof isVerifiedHoardCheater === 'function' && isVerifiedHoardCheater(hoardCash)));
  const starCheatTier = isCheaterStars ? Math.max(verdictStars.tier || 0, hoardCash >= starTiers.megaCap ? 4 : (hoardCash >= starTiers.highCap ? 3 : (hoardCash >= starTiers.midCap ? 2 : (hoardCash >= starTiers.lowCap ? 1 : 0)))) : 0;
  // Chỉ khi có căn cứ gian lận (Ngưỡng Phán Quyết SHADOWBAN/BAN hoặc Vượt Két Tầng 3-4) mới khóa đặc quyền 5★
  if(!(isCheaterStars && starCheatTier >= 3)){
    if(c&&c.isSpecialRecipeGuest)return {s:5,why:'special_recipe'};
    if(c&&c.star!=null&&!c.deliveredWrong)return {s:5,why:'star'};
    if(c&&c._svWrongSize==='up')return {s:5,why:'sv_upsize'};
  }
  if(c&&c._svWrongSize==='down')return {s:3,why:'sv_downsize'};

  // Đặc quyền Star Mastery 4★ - 5★ của món độc bản: Đảm bảo 100% đánh giá 5★ cho người chơi hợp lệ
  if(!(isCheaterStars && starCheatTier >= 3) && c && c.specialRecipe && c.specialRecipe.id){
    const recStar = (S.collection && S.collection.recipeStars && S.collection.recipeStars[c.specialRecipe.id]) || 1;
    if(recStar >= 4) return {s:5, why:'special_mastery'};
  }

  // Chỉ ép đánh giá xuống 1★ - 2★ / 1★ - 3★ khi có căn cứ gian lận (isCheaterStars)
  if(isCheaterStars && starCheatTier >= 4){
    return { s: Math.random() < 0.70 ? 1 : 2, why: 'meh' };
  }
  if(isCheaterStars && starCheatTier >= 3){
    const rRoll = Math.random();
    return { s: rRoll < 0.40 ? 1 : (rRoll < 0.85 ? 2 : 3), why: 'meh' };
  }

  const w=1-c.pat/c.max,idx=c.cups.reduce((a,x)=>a+priceIdx(x),0)/c.cups.length,pricey=c.cups.some(orderPricey);

  // Cơ chế đánh giá sao mới: 5★ là thứ hiếm và giá trị cao!
  // Đa số khách hàng hài lòng sẽ chấm 4★ (ổn áp, trà ngon, dịch vụ tốt).
  // Chỉ khi phục vụ siêu tốc (w < 0.20), quán decor đẹp, tâm trạng vui, hoặc may mắn mới đạt 5★!
  let s = 4;
  let why = 'ok';

  if(w <= 0.45){
    // Phục vụ chuẩn giờ: tính xác suất đạt 5★
    let chance5 = 0.15; // Tỉ lệ 5★ cơ bản: 15% (còn lại 85% là 4★)
    if(w < 0.18) chance5 += 0.25; // Siêu tốc (< 18% thanh kiên nhẫn): +25%
    else if(w < 0.32) chance5 += 0.10; // Nhanh (< 32% thanh kiên nhẫn): +10%

    // Món độc bản 1★-3★: vị lạ độc đáo tăng nhẹ cơ hội 5★ (+15%)
    if(c && (c.isSpecialDrinkCustomer || c.specialRecipe)) chance5 += 0.15;

    // Decor & Thiết bị quán tạo ấn tượng tốt (+0.8% mỗi món, tối đa +12%)
    const decorBoost = Math.min(0.12, (typeof upgCount === 'function' ? upgCount() : 0) * 0.008);
    chance5 += decorBoost;

    const md = S.evDay === S.day ? S.mood : null;
    if(md === 'vui') chance5 += 0.15; // Ngày vui vẻ
    const cupBuffStar = (typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
    if(cupBuffStar && cupBuffStar.star5Bonus > 0) chance5 += cupBuffStar.star5Bonus;

    // Chỉ phạt giảm mạnh tỉ lệ 5★ khi có căn cứ gian lận (isCheaterStars)
    const starTiers = getSafeCashTiers(S && S.day);
    if(isCheaterStars){
      if(hoardCash >= starTiers.midCap) chance5 *= 0.15;
      else if(hoardCash >= starTiers.lowCap) chance5 *= 0.45;
    }

    if(Math.random() < chance5){
      s = 5;
      why = 'great';
    } else {
      s = 4;
      why = 'ok';
      if(isCheaterStars && hoardCash >= starTiers.midCap && Math.random() < 0.55){
        s = Math.random() < 0.45 ? 2 : 3;
        why = 'meh';
      } else if(isCheaterStars && hoardCash >= starTiers.lowCap && Math.random() < 0.30){
        s = 3;
        why = 'meh';
      }
    }
  } else {
    // Trễ hạn phục vụ: Giảm sao theo thời gian chờ
    s = 3;
    why = online ? 'late' : 'wait';
    if(w > (S.upg && S.upg.ac ? 0.88 : 0.78)){
      s = 2;
    }
    if(w > 0.92){
      s = 1;
    }
  }

  c.rf={wait:w>.45,pricey,wrong:!!c.wrong,spill:!!c.spilled,cheap:!pricey&&idx<.9};

  if(c.fillPen){
    s = Math.max(1, s - 1);
    if(why === 'great') why = 'ok';
    else if(why === 'ok') why = 'meh';
  }

  if(c.brat==='kho'){
    if(c.fillPen||w>.30) s = Math.max(1, s - 1);
    if(s>=5&&Math.random()<0.75) s = 4;
    else if(s===4&&Math.random()<0.30) s = 3;
  }

  if(pricey){
    s = Math.min(s, rnd([1, 2, 2, 3]));
    why = 'pricey';
  }

  if(c.wrong){
    if(c.deliveredWrong){
      s = Math.min(s, c.wrong > 1 ? 1 : rnd([1, 2]));
      why = 'wrong';
    } else {
      // Khách nhận ly nước mới tinh chuẩn món sau khi pha lại:
      // Tỉ lệ 5 sao an ủi là 15%, 4 sao là 70%, 3 sao là 15%
      const rComfort = Math.random();
      s = rComfort < 0.15 ? 5 : (rComfort < 0.85 ? 4 : 3);
      why = 'comfort';
      if(c.rf) c.rf.wrong = false;
    }
  }

  const md=S.evDay===S.day?S.mood:null;
  if(!c.wrong&&md!=='vui'&&md!=='kho'&&Math.random()<0.03&&s>1) s -= 1;
  if(md==='kho'&&why!=='comfort') s = Math.min(s, Math.random()<0.40 ? 3 : 4); /* ngày khó ở: phục vụ tốt cũng chỉ 3–4 sao */

  if(c.rf.cheap&&s<5&&!c.wrong&&Math.random()<0.35){
    s++;
    if(why==='ok') why = 'cheap';
  }

  // Giảm tỉ lệ đánh giá kém theo cấp độ Topping (0.5%/level)
  const topLv=(S.upgLv&&S.upgLv.top)||0;
  if(s<4&&topLv>0&&Math.random()<topLv*0.005){
    s=Math.min(4,s+1);
    if(why==='bad'||why==='wrong'||why==='timeout'||why==='late'||why==='meh'){
      why='ok';
    }
  }

  // Buff Ly Thu Lá Vàng (Top 1 Cáp Pi): Giữ tối thiểu 4★ khi pha chuẩn không bị chê đắt & tăng cơ hội 5★
  const activeCupStarBuff = (typeof getActiveCupSkinBuff === 'function') ? getActiveCupSkinBuff() : null;
  if(activeCupStarBuff && !c.wrong && !pricey){
    if(activeCupStarBuff.minStarFloor && s < activeCupStarBuff.minStarFloor){
      s = activeCupStarBuff.minStarFloor;
      why = 'ok';
    }
    if(s === 4 && activeCupStarBuff.star5Bonus > 0 && Math.random() < (activeCupStarBuff.star5Bonus * 0.5)){
      s = 5;
      why = 'great';
    }
  }

  // Hoàng Sa – Trường Sa: Tình quân dân: đánh giá +100% 5★
  if(S && S.startupLocation === 'hoangsa'){
    s = 5;
    why = 'great';
  }

  s=Math.max(1,Math.min(5,s));
  if(why==='great'||why==='ok'||(why==='cheap'&&s<4)) why=s>=5?'great':(s===4?'ok':(s===3?'meh':'bad'));
  return {s,why};
}

/* ---------- HỆ THỐNG ĐIỀU TRA TIỀN GIẢ & TỐ CÁO CÔNG AN ---------- */
const FAKE_SUSPECT_DESCS = [
  'Đưa tờ tiền mệnh giá lớn mua ly nước, mắt liên tục nhìn quanh quầy rồi vội vã nhận tiền thối rời đi.',
  'Thanh toán bằng tiền mặt gấp mép rút vội từ túi áo khoác, giục thu ngân nhanh tay vì đang có người đợi.',
  'Đội nón bảo hiểm trùm kín, đưa tiền mặt phẳng phiu nhưng né tránh nhìn vào camera an ninh của quầy.',
  'Trả tờ tiền mặt mới cứng kẹp trong ví tay, đứng che chắn một phần quầy thu ngân trong lúc nhận tiền thối.',
  'Thanh toán tiền mặt rất nhanh, tay hơi run khi cầm ly trà rồi lập tức quay lưng bước thẳng ra xe.'
];

