    dialogue: [
      { speaker: '{leader} (Lích Đờ)', text: 'Tưởng đâu làm clip ASMR rót trà sữa đá kêu róc rách triệu view, ai dè quên bật mic thành video câm nín! Lẹt đẹt 10 view! 🤦‍♂️' },
      { speaker: 'Nhân viên', text: 'Thảo nào em thấy Lích Đờ diễn sâu quá trời mà clip không có một chút tiếng động nào!' },
      { speaker: '{leader} (Lích Đờ)', text: 'Bẽ bàng quá! Nỗi xấu hổ này ai thấu! Sếp ơi mau vào thả tim với cmt cứu em với, không là em xin từ chức về quê nuôi cá đây! 😢🐟' }
    ],
    sound: 'Âm Thanh Im Lặng Khó Xử - Awkward Silence Sound 🦗',
    tags: ['#asmrthatbai', '#lichdodoi', '#cuutuongtac', '#trasua']
  }
];

function getAvailableLeader(){
  const used = new Set();
  if(S && S.branches){
    Object.values(S.branches).forEach(b => {
      if(b && b.leader && b.leader.name) used.add(b.leader.name);
    });
  }
  if(S && S.franchise && S.franchise.partners){
    S.franchise.partners.forEach(p => {
      if(p && p.leader && p.leader.name) used.add(p.leader.name);
    });
  }
  const available = LEADER_CANDIDATE_POOL.filter(l => !used.has(l.name));
  return available.length ? rnd(available) : rnd(LEADER_CANDIDATE_POOL);
}

function hireLeaderForBranch(bid, isFranchise){
  if(S.money < LEADER_HIRE_COST){
    toast('Két không đủ 1.000.000đ để thuê nhân viên Lích Đờ!');
    return false;
  }
  const cand = getAvailableLeader();
  S.money -= LEADER_HIRE_COST;

  if(!isFranchise){
    const bObj = BRANCH_LOCATIONS.find(x => x.id === bid);
    if(!bObj) return false;
    S.branches = S.branches || {};
    S.branches[bid] = S.branches[bid] || { bought: true, level: 1, openedDay: S.day };
    S.branches[bid].closed = false;
    S.branches[bid].leader = {
      name: cand.name,
      avatar: cand.avatar,
      trait: cand.trait,
      mood: 'happy',
      hiredDay: S.day
    };
    save(); head(); sfx('coin');
    toast(`🎉 Đã bổ nhiệm Lích Đờ ${cand.name} (${cand.avatar}) quản lý ${bObj.name}! Tự động tuyển nhân viên và nhập liệu (+25% doanh thu)!`);
  } else {
    S.franchise = S.franchise || { partners: [] };
    const pObj = (S.franchise.partners || []).find(x => x.id === bid);
    if(!pObj) return false;
    pObj.closed = false;
    pObj.leader = {
      name: cand.name,
      avatar: cand.avatar,
      trait: cand.trait,
      mood: 'happy',
      hiredDay: S.day
    };
    save(); head(); sfx('coin');
    toast(`🎉 Đã bổ nhiệm Lích Đờ ${cand.name} (${cand.avatar}) quản lý ${pObj.name}! Tự động điều phối 4 nhân viên và nhập liệu (+25% Royalty)!`);
  }
  return true;
}

function reopenBranch(bid, isFranchise){
  if(S.money < LEADER_HIRE_COST){
    toast('Két không đủ 1.000.000đ để mở lại chi nhánh và thuê Lích Đờ mới!');
    return false;
  }
  const cand = getAvailableLeader();
  S.money -= LEADER_HIRE_COST;

  if(!isFranchise){
    const bObj = BRANCH_LOCATIONS.find(x => x.id === bid);
    if(!bObj || !S.branches || !S.branches[bid]) return false;
    S.branches[bid].closed = false;
    delete S.branches[bid].bankrupt;
    S.branches[bid].leader = {
      name: cand.name,
      avatar: cand.avatar,
      trait: cand.trait,
      mood: 'happy',
      hiredDay: S.day
    };
    save(); head(); sfx('coin');
    toast(`✨ Chi nhánh ${bObj.name} đã tái thiết & mở cửa hoạt động trở lại cùng Lích Đờ mới ${cand.name}! 🎉`);
  } else {
    const pObj = (S.franchise.partners || []).find(x => x.id === bid);
    if(!pObj) return false;
    pObj.closed = false;
    delete pObj.bankrupt;
    pObj.leader = {
      name: cand.name,
      avatar: cand.avatar,
      trait: cand.trait,
      mood: 'happy',
      hiredDay: S.day
    };
    save(); head(); sfx('coin');
    toast(`✨ Chi nhánh nhượng quyền ${pObj.name} đã mở cửa hoạt động trở lại cùng Lích Đờ mới ${cand.name}! 🎉`);
  }
  return true;
}

function mktAutoRescueAllFlops(silent = false){
  const hasMkt = (typeof isStaffActive === 'function' ? isStaffActive('staffMkt') : (S && S.upg && S.upg.staffMkt));
  if(!hasMkt || !S || !S.mxh || !Array.isArray(S.mxh.posts)) return 0;
  const mktName = (typeof staffPersonName === 'function' ? staffPersonName('staffMkt') : null) || 'Mẹ Két Tinh';

  let rescuedCount = 0;
  S.mxh.posts.forEach(post => {
    if(post && post.isFlop){
      post.isFlop = false;
      post.mktRescued = true;
      post.liked = true;
      post.views = Math.floor(25000 + Math.random() * 35000);
      post.likes = Math.floor(1800 + Math.random() * 2500);
      post.replies = post.replies || [];
      post.replies.push(`💬 ${mktName} (Marketing TikTok): "Đã kích hoạt gói kéo view thần tốc cho clip của Lích Đờ ${post.leaderName || 'chi nhánh'}! Video bùng nổ ${fmtFollowers(post.views)} views! Lích Đờ xé đơn nghỉ việc và yên tâm tiếp tục công tác nhé! ✨🎉"`);
      
      if(!post.isFranchise && S.branches && S.branches[post.branchId] && S.branches[post.branchId].leader){
        S.branches[post.branchId].leader.mood = 'happy';
      } else if(post.isFranchise && S.franchise && Array.isArray(S.franchise.partners)){
        const fp = S.franchise.partners.find(x => x && x.id === post.branchId);
        if(fp && fp.leader) fp.leader.mood = 'happy';
      }
      rescuedCount++;
    }
  });

  if(rescuedCount > 0){
    S.mxh.followers = (S.mxh.followers || 120) + (rescuedCount * 800);
    save();
    if(!silent){
      sfx('win');
      toast(`✨ Mẹ Két Tinh tự động quét & giải cứu thành công ${rescuedCount} video flop! Lích Đờ hết dỗi và tiếp tục điều hành quán! 🎉`, 5000);
    }
  }
  return rescuedCount;
}

function triggerLeaderVideoPost(bid, isFranchise, isAuto){
  let bObj, bData;
  if(!isFranchise){
    bObj = BRANCH_LOCATIONS.find(x => x.id === bid);
    bData = S.branches ? S.branches[bid] : null;
  } else {
    bObj = (S.franchise && Array.isArray(S.franchise.partners)) ? S.franchise.partners.find(x => x && x.id === bid) : null;
    bData = bObj;
  }
  if(!bObj || !bData || bData.closed || !bData.leader) return;

  const hasMkt = (typeof isStaffActive === 'function' ? isStaffActive('staffMkt') : (S && S.upg && S.upg.staffMkt));
  const mktName = (typeof staffPersonName === 'function' ? staffPersonName('staffMkt') : null) || 'Mẹ Két Tinh';

  const leader = bData.leader;
  if(leader.mood === 'sulking'){
    if(hasMkt){
      leader.mood = 'happy';
      mktAutoRescueAllFlops(true);
      toast(`✨ Mẹ Két Tinh đã dỗ dành và giải cứu video cho Lích Đờ ${leader.name}! Lích Đờ hết dỗi và tiếp tục đăng video mới! 🎉`);
    } else {
      if(!isAuto) toast(`⚠️ Lích Đờ ${leader.name} đang DỖI vì video bị flop! Hãy vào Trà Sữa Feed thả tym / cmt cứu tương tác trước!`);
      return;
    }
  }

  const curShop = (typeof shopName === 'function' ? shopName() : (S && S.shopName) || 'Tiệm Trà Mơ Ước');
  const isFlop = Math.random() < 0.25; // 25% nguy cơ bị flop

  S.mxh = S.mxh || { followers: 120, posts: [], activeAds: [], totalAdsSpent: 0 };
  S.mxh.posts = S.mxh.posts || [];

  if(isFlop && hasMkt){
    // Mẹ Két Tinh tự động can thiệp cứu video flop ngay khi đăng
    leader.mood = 'happy';
    const sc = rnd(LEADER_VIRAL_SCENARIOS);
    const postTopic = sc.topic.replace('{leader}', leader.name).replace('{shop}', curShop);
    const postDialogue = sc.dialogue.map(d => ({
      speaker: d.speaker.replace('{leader}', leader.name).replace('{shop}', curShop),
      text: d.text.replace('{leader}', leader.name).replace('{shop}', curShop)
    }));
    const views = Math.floor(25000 + Math.random() * 45000);
    const likes = Math.floor(2000 + Math.random() * 3500);
    const followersGain = Math.floor(750 + Math.random() * 1500);

    const newPost = {
      id: 'mkt_rescue_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
      isFlop: false,
      mktRescued: true,
      branchId: bid,
      isFranchise: !!isFranchise,
      leaderName: leader.name,
      author: `${leader.name} ${leader.avatar || '👔'} · Lích Đờ ${bObj.name}`,
      avt: leader.avatar || '👔',
      badge: 'Lích Đờ Chi Nhánh 👔',
      time: 'Vừa xong',
      isTiktok: true,
      topic: postTopic,
      dialogue: postDialogue,
      sound: sc.sound,
      tags: [...sc.tags, '#MeKetTinhCuuFlop', '#ViralTikTok'],
      content: formatDialogueContent(postTopic, postDialogue, sc.sound, sc.tags),
      views: views,
      likes: likes,
      liked: true,
      replies: [
        `💬 ${mktName} (Marketing): "Video của Lích Đờ ${leader.name} rất hay! Team MKT đã chạy seeding, tối ưu SEO TikTok và bơm view, video đã cắn xu hướng lên ${fmtFollowers(views)} views rồi nhé! ✨🔥"`,
        `🥰 ${leader.name} (Lích Đờ): "Cảm ơn ${mktName} đã giải cứu kịp thời! Suýt nữa em dỗi nộp đơn nghỉ việc rồi, cắn đề xuất vui quá em tiếp tục cống hiến cho chi nhánh!" 🎉❤️`
      ]
    };

    S.mxh.posts.unshift(newPost);
    if(S.mxh.posts.length > 50) S.mxh.posts.length = 50;
    S.mxh.followers = (S.mxh.followers || 120) + followersGain;
    save();
    sfx('win');
    toast(`✨ Mẹ Két Tinh can thiệp kịp thời: Cứu video TikTok của Lích Đờ ${leader.name} thoát flop! Video cắn xu hướng ${fmtFollowers(views)} views & Lích Đờ vui vẻ quản lý chi nhánh! 🎉`, 5500);
  } else if(isFlop){
    leader.mood = 'sulking';
    const sc = rnd(LEADER_FLOP_SCENARIOS);
    const postTopic = sc.topic.replace('{leader}', leader.name).replace('{shop}', curShop);
    const postDialogue = sc.dialogue.map(d => ({
      speaker: d.speaker.replace('{leader}', leader.name).replace('{shop}', curShop),
      text: d.text.replace('{leader}', leader.name).replace('{shop}', curShop)
    }));

    const newPost = {
      id: 'flop_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
      isFlop: true,
      branchId: bid,
      isFranchise: !!isFranchise,
      leaderName: leader.name,
      author: `${leader.name} ${leader.avatar || '👔'} · Lích Đờ ${bObj.name}`,
      avt: leader.avatar || '👔',
      badge: 'Lích Đờ Chi Nhánh 👔',
      time: 'Vừa xong',
      isTiktok: true,
      topic: postTopic,
      dialogue: postDialogue,
      sound: sc.sound,
      tags: sc.tags,
      content: formatDialogueContent(postTopic, postDialogue, sc.sound, sc.tags),
      views: Math.floor(10 + Math.random() * 4), // ~12 views
      likes: 0,
      liked: false,
      replies: []
    };

    S.mxh.posts.unshift(newPost);
    if(S.mxh.posts.length > 50) S.mxh.posts.length = 50;
    save();
    sfx('bad');
    toast(`🚨 VIDEO CỦA LÍCH ĐỜ BỊ FLOP (12 view 0 tim)! Lích Đờ ${leader.name} đang DỖI nộp đơn nghỉ việc! Mau vào Trà Sữa Feed thả tym / cmt cứu ngay!`, 5500);
  } else {
    leader.mood = 'happy';
    const sc = rnd(LEADER_VIRAL_SCENARIOS);
    const postTopic = sc.topic.replace('{leader}', leader.name).replace('{shop}', curShop);
    const postDialogue = sc.dialogue.map(d => ({
      speaker: d.speaker.replace('{leader}', leader.name).replace('{shop}', curShop),
      text: d.text.replace('{leader}', leader.name).replace('{shop}', curShop)
    }));
    const views = Math.floor(18000 + Math.random() * 60000);
    const likes = Math.floor(1500 + Math.random() * 4500);
    const followersGain = Math.floor(600 + Math.random() * 1800);

    const newPost = {
      id: 'lead_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
      isFlop: false,
      branchId: bid,
      isFranchise: !!isFranchise,
      leaderName: leader.name,
      author: `${leader.name} ${leader.avatar || '👔'} · Lích Đờ ${bObj.name}`,
      avt: leader.avatar || '👔',
      badge: 'Lích Đờ Chi Nhánh 👔',
      time: 'Vừa xong',
      isTiktok: true,
      topic: postTopic,
      dialogue: postDialogue,
      sound: sc.sound,
      tags: sc.tags,
      content: formatDialogueContent(postTopic, postDialogue, sc.sound, sc.tags),
      views: views,
      likes: likes,
      liked: false,
      replies: []
    };

    S.mxh.posts.unshift(newPost);
    if(S.mxh.posts.length > 50) S.mxh.posts.length = 50;
    S.mxh.followers = (S.mxh.followers || 120) + followersGain;
    save();
    sfx('win');
    toast(`🎉 Video Lích Đờ ${leader.name} quảng bá ${bObj.name} đạt ${fmtFollowers(views)} views & +${fmtFollowers(followersGain)} Followers!`);
  }
}

/* ===== KỊCH BẢN VIDEO QUẢNG BÁ TIKTOK / REELS / SHORTS (VIRAL & NORMAL) ===== */
function formatDialogueContent(topic, dialogue, sound, tags){
  let str = `🎬 ${topic}\n\n`;
  if(Array.isArray(dialogue)){
    dialogue.forEach(d => {
      str += `• ${d.speaker}: "${d.text}"\n`;
    });
  }
  if(sound) str += `\n🎵 ${sound}\n`;
  if(tags && tags.length) str += tags.join(' ');
  return str;
}

