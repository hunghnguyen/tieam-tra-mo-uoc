  // Biến trạng thái Cáp Bi đi dạo trong vườn cây
  let gardenCapbiTimer = null;
  let gardenCapbiBubbleTimer = null;
  let gardenCapbiX = 66; // percent left
  let gardenCapbiY = 74; // percent top
  let gardenCapbiFacing = -1;
